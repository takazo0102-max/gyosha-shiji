! ============================================================
! 脚部詳細図 2Dシンボル（くさび緊結式足場・設置届 詳細図用）
! 2Dスクリプトに貼り付けて使用。想定縮尺 1/10〜1/20
! ------------------------------------------------------------
! パラメータリストに以下を定義してください:
!   serType  文字列  "A" or "B"          既定 "A"   (コマピッチ 450/475)
!   jackOut  長さ    ジャッキ繰り出し量    既定 0.200 (m)
!   negaLv   長さ    根がらみコマ高さ      既定 0.150 (支柱下端から)
!   texSiz   実数    文字高(mm)           既定 2.5
!   showDim  ブール  寸法・注記の表示      既定 ON
! ============================================================

! ---- 系列による定数 ----
koma = 0.450
if serType = "B" then koma = 0.475

r_sic  = 0.0486 / 2      ! 支柱 φ48.6
r_nuno = 0.0427 / 2      ! 布材 φ42.7
r_jack = 0.0381 / 2      ! ジャッキ φ38.1

y_base = 0.050           ! ジャッキ台座上端(敷板35+ベース15)
y_sic0 = y_base + jackOut ! 支柱下端レベル

! ---- スタイル ----
define style "anno" "MS Pゴシック", texSiz, 1, 0
set style "anno"
pen 1

! ---- GL・地盤ハッチ ----
line2 -0.60, 0, 0.65, 0
for gx = -0.55 to 0.60 step 0.05
    line2 gx, 0, gx - 0.03, -0.03
next gx

! ---- 敷板 (900x35) ----
rect2 -0.45, 0, 0.45, 0.035
line2 -0.45, 0.010, 0.45, 0.010   ! 板の木口線

! ---- アンダーベース (140角) ----
rect2 -0.070, 0.035, 0.070, 0.050

! ---- ジャッキベース ----
rect2 -0.070, y_base, 0.070, y_base + 0.006          ! 台座プレート
rect2 -r_jack, y_base, r_jack, y_sic0 + 0.100        ! ネジ棒(支柱内へ100挿入)
! ネジ山の表現
for ty = y_base + 0.02 to y_sic0 - 0.01 step 0.02
    line2 -r_jack, ty, r_jack, ty
next ty
! 調整ハンドル(ナット)
rect2 -0.045, y_sic0 - 0.035, 0.045, y_sic0 - 0.015

! ---- 支柱 φ48.6 ----
rect2 -r_sic, y_sic0, r_sic, 0.90
line2 -r_sic, y_sic0, r_sic, y_sic0                   ! 支柱下端線

! ---- 根がらみコマ + 根がらみ布材(右側) ----
y_koma = y_sic0 + negaLv
rect2  r_sic, y_koma - 0.015,  r_sic + 0.020, y_koma + 0.015   ! コマ
rect2 -r_sic - 0.020, y_koma - 0.015, -r_sic, y_koma + 0.015   ! コマ(反対側)
rect2  r_sic + 0.020, y_koma - r_nuno, 0.60, y_koma + r_nuno   ! 根がらみ
! クサビの表現
poly2 4, 1,
      r_sic + 0.020, y_koma + 0.015,
      r_sic + 0.038, y_koma + 0.015,
      r_sic + 0.030, y_koma - 0.020,
      r_sic + 0.020, y_koma - 0.020

! ---- ホットスポット ----
hotspot2 0, 0
hotspot2 0, y_sic0
hotspot2 0.60, y_koma

! ============================================================
! 寸法・注記
! ============================================================
if not(showDim) then end

! ---- 繰り出し量の寸法(左側) ----
dimx = -0.52
line2 dimx, y_base, dimx, y_sic0
line2 dimx - 0.015, y_base, dimx + 0.015, y_base
line2 dimx - 0.015, y_sic0, dimx + 0.015, y_sic0
text2 dimx - 0.02, (y_base + y_sic0) / 2,
      "繰出し " + str(jackOut * 1000, 4, 0) + "≦270"

! ---- 繰り出し超過の警告 ----
if jackOut > 0.270 then
    pen 6   ! 赤
    text2 -0.55, 0.95, "※ジャッキ繰出し量超過 要是正"
    pen 1
endif

! ---- 引出し注記(右側) ----
tx = 0.68
line2 r_sic, 0.80, tx - 0.02, 0.80
text2 tx, 0.80, "支柱 φ48.6"
line2 0.50, y_koma, tx - 0.02, 0.70
text2 tx, 0.70, "根がらみ φ42.7 (最下コマ)"
line2 0.03, y_sic0 - 0.025, tx - 0.02, 0.55
text2 tx, 0.55, "ジャッキベース φ38.1"
line2 0.06, 0.043, tx - 0.02, 0.45
text2 tx, 0.45, "アンダーベース 140角"
line2 0.40, 0.018, tx - 0.02, 0.35
text2 tx, 0.35, "敷板"

! ---- 系列表記 ----
text2 -0.55, 1.00, "脚部詳細 (タイプ" + serType + " コマピッチ" + str(koma * 1000, 3, 0) + ")"

end
