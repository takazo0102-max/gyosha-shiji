! ==========================================================
! 別の足場を単管でつなぐ（支柱から支柱への線1本に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_tube/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_tube.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! GLOOBE の「別の足場と接続する単管」に当たる（2026-11-02 の開発ループ）。
! 原点＝始めの足場の支柱の芯、+X＝終わりの支柱へ。zList の高さごとに長さ tbLen の単管と両端の直交クランプ、gdOn で中桟・手すり、brOn で層の間の斜め（自在クランプ）。割付と判定は tube_join.py、置くのは scripts/tube_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   tbL       長さ      支柱の芯から芯まで                                                  既定 3.0
!   tbLen     長さ      単管の長さ（規格）                                                  既定 3.5
!   zList     文字列    つなぐ高さ mm（カンマ区切り。足場の立つ面から）                     既定 "1800,3600,5400"
!   gdOn      ブール    各層の上に中桟・手すり（450・950）                                  既定 0
!   brOn      ブール    層の間に斜めの補強                                                  既定 0
!   tbName    文字列    名前（注記）                                                        既定 "つなぎ1"
!   tbNote    文字列    注記                                                                既定 "単管 3.5M×3本"
!   texSiz    実数      文字の大きさ（mm）                                                  既定 2.5
!   penBold   PenColor  外形の線（太線。置くときに線のペンと同じ色の太いペン）              既定 21
!   penThin   PenColor  細部の線（細線。同じ色の細いペン）                                  既定 1
!   penZone   PenColor  範囲の線（作業半径・後端旋回半径・立入禁止・旋回軌跡）              既定 20
!   penMask   PenColor  上に載るものの背景の塗り（下の線を隠す。0＝隠さない）               既定 19
!   drMode    整数      平面の描き分け（0 縮尺で自動・1 詳細 1/100・2 標準 1/200・3 簡略）  既定 0
!   penEquip  PenColor  線のペン                                                            既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 単管のつなぎ: 高さの並び（m）と両端の突き出し
dim zz[]
nZ = 0
rest = zList
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nZ = nZ + 1
		zz[nZ] = v / 1000
	endif
endwhile
ov = max(0, (tbLen - tbL) / 2)
rT = 0.0243

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 単管のつなぎ 2D（CAD の平面図の描き方: scripts/gdl_draft.py）: 単管（突き出しまで）は太線、両端の直交クランプは細線（詳細だけ）。
! 簡略は単管の芯の1本線。注記の行送りは縮尺に合わせる
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "tbT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "tbT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
pen pO
if drLv < 3 then
	line2 -ov, rT, tbL + ov, rT
	line2 -ov, -rT, tbL + ov, -rT
else
	line2 -ov, 0, tbL + ov, 0
endif
if drLv = 1 then
	pen pT
	for e = 0 to 1
		xe = e * tbL
		rect2 xe - 0.05, -0.07, xe + 0.05, 0.07
		circle2 xe, 0, 0.0243
	next e
endif
pen penEquip
add2 tbL / 2, 0
rot2 -SYMB_ROTANGLE
text2 0, 0.15 + dT / 2, tbName + " " + tbNote
del 2
hotspot2 0, 0
hotspot2 tbL, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 単管のつなぎ 3D: 高さごとの単管（中桟・手すり）・直交クランプ、層の間の斜めの単管と自在クランプ
define material "tb_pipe" 2, 0.72, 0.74, 0.76
define material "tb_clamp" 2, 0.35, 0.36, 0.38
resol 8
for i = 1 to nZ
	nR = 1
	if gdOn then nR = 3
	for k = 1 to nR
		zr = zz[i]
		if k = 2 then zr = zz[i] + 0.45
		if k = 3 then zr = zz[i] + 0.95
		material "tb_pipe"
		add -ov, -0.07, zr
		roty 90
		cylind tbLen, rT
		del 2
		material "tb_clamp"
		for e = 0 to 1
			add e * tbL - 0.045, -0.115, zr - 0.04
			block 0.09, 0.09, 0.08
			del 1
		next e
	next k
next i
if brOn and nZ > 1 then
	for i = 1 to nZ - 1
		! 斜めの両端は自在クランプの所（層の 0.1 上から次の層の 0.1 下）
		dz = zz[i + 1] - zz[i] - 0.2
		bl = sqr(tbL ^ 2 + dz ^ 2)
		ab = atn(dz / tbL)
		material "tb_pipe"
		if i mod 2 = 1 then
			add 0, 0.07, zz[i] + 0.1
			roty 90 - ab
		else
			add tbL, 0.07, zz[i] + 0.1
			roty -90 + ab
		endif
		add 0, 0, -ov
		cylind bl + 2 * ov, rT
		del 3
		material "tb_clamp"
		xb = 0
		if i mod 2 = 0 then xb = tbL
		add xb - 0.045, 0.025, zz[i] + 0.06
		block 0.09, 0.09, 0.08
		del 1
		add tbL - xb - 0.045, 0.025, zz[i + 1] - 0.14
		block 0.09, 0.09, 0.08
		del 1
	next i
endif

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 単管のつなぎ: 値の一覧は無い

