! ==========================================================
! 足場条件（ツールバーが読む入力条件） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_spec/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_spec.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! スラブの近くに置き、設定ダイアログ（基本／高さ・離れ／安全・表示）で条件を入れる。
! ツールバーはこの部品のパラメータを読み、デスクトップの JSON より優先する。
! パラメータと入力 JSON の対応は src/ashiba/spec_object.py の FIELDS が正。
! ----------------------------------------------------------
! パラメータリスト:
!   projName      文字列  工事名（図面・帳票の名前）                                                                          既定 "足場計画"
!   moduleKind    文字列  モジュール metric／inch                                                                             既定 "metric"
!   seriesId      文字列  系列（空ならモジュールの既定）                                                                      既定 ""
!   eavesH        長さ    軒高                                                                                                既定 15.4
!   guardExtra    長さ    手すり分（最上層作業床＝軒高＋この値）                                                              既定 0.9
!   scaffH        長さ    足場高さを直接指定（0＝軒高から）                                                                   既定 0.0
!   bldgH         長さ    建物高さ                                                                                            既定 16.0
!   scaffW        整数    足場の幅 mm（センチ 600・900・1200、インチ 610・914・1219。0＝配置の始めに選ぶ）                    既定 0
!   periodDays    整数    設置期間（日）                                                                                      既定 90
!   soTarget      長さ    離れ 目標                                                                                           既定 0.3
!   soMin         長さ    離れ 目標下限                                                                                       既定 0.25
!   soMax         長さ    離れ 目標上限                                                                                       既定 0.35
!   soHardMin     長さ    離れ 下限（これ未満は採らない）                                                                     既定 0.25
!   scaffForm     文字列  足場の形式（本足場／ブラケット足場／単管抱き足場）                                                  既定 "本足場"
!   bracketPost   文字列  ブラケット足場の建地（支柱＝くさび等の支柱／単管＝単管とクランプ式ブラケット）                      既定 "支柱"
!   railType      文字列  手すり 布材／先行手すり                                                                             既定 "布材"
!   innerRail     ブール  躯体側の手すり（布材）                                                                              既定 1
!   toeBoard      ブール  幅木を付ける                                                                                        既定 1
!   netBrackets   ブール  水平ネットをネットブラケットで受ける                                                                既定 1
!   nextGen       ブール  次世代足場                                                                                          既定 0
!   asagaoStages  整数    朝顔の段数（0＝自動判定）                                                                           既定 0
!   asagaoFaces   文字列  朝顔を付ける面（空＝全部の面。例 南面・東面）                                                       既定 ""
!   region        文字列  地域（基準風速）                                                                                    既定 "関東(内陸)"
!   roughness     文字列  地表面粗度区分                                                                                      既定 "III"
!   sheetType     文字列  養生材                                                                                              既定 "メッシュシート"
!   siteName      文字列  現場名（設置届）                                                                                    既定 ""
!   elevMode      文字列  立面図 section＝断面図→レイアウト／object＝平面の下に2D／none                                       既定 "section"
!   lineMode3d    ブール  3Dを線で表示                                                                                        既定 0
!   autoInBrk     ブール  離れ350超に内ブラケットを自動で付ける                                                               既定 1
!   hFromSlab     ブール  高さをスラブの天端から自動で（面ごと・セットバック対応）                                            既定 1
!   stairLayout   文字列  階段の付け方（足場の中／外付け（上り口・降り口つき）／自動＝幅900以上は足場の中、900未満は外付け）  既定 "自動"
!   facesOnly     文字列  足場を掛ける面（例 南面,東面。空＝全周）                                                            既定 ""
!   faceForms     文字列  面ごとの足場の切り替え（例 南面=ブラケット足場（単管）;東面=単管抱き足場。空＝全部同じ）            既定 ""
!   netLevels     文字列  水平ネットを張る層（例 2,5・全部。空＝張らない）                                                    既定 ""
!   memberEdit1   文字列  部材編集1（例 南面 2-3 2-3 踏板・幅木; 東面 1 全部 手すり→NDT09S #理由）                            既定 ""
!   memberEdit2   文字列  部材編集2（例 南面 2-3 2-3 踏板・幅木; 東面 1 全部 手すり→NDT09S #理由）                            既定 ""
!   memberEdit3   文字列  部材編集3（例 南面 2-3 2-3 踏板・幅木; 東面 1 全部 手すり→NDT09S #理由）                            既定 ""
!   memberEdit4   文字列  部材編集4（例 南面 2-3 2-3 踏板・幅木; 東面 1 全部 手すり→NDT09S #理由）                            既定 ""
!   presetName    文字列  条件の登録名（パレットの「登録」で控え、「呼び出し」で別の建物へ）                                  既定 ""
! ==========================================================

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 足場条件（ツールバーが読む条件。設定ダイアログで変えて、もう一度ツールバーを実行する）
! 平面には条件の要約を札のように出す
! ============================================================
txH = 2.5 * GLOB_SCALE / 1000
define style "specT" "ＭＳ Ｐゴシック", 2.5, 1, 0
set style "specT"
dim ln[7]
modTxt = "メートル"
if moduleKind = "inch" then modTxt = "インチ"
serTxt = seriesId
if serTxt = "" then serTxt = "既定"
hTxt = "軒高 " + str(eavesH * 1000, 1, 0) + "＋" + str(guardExtra * 1000, 1, 0)
if scaffH > 0.001 then hTxt = "足場高さ " + str(scaffH * 1000, 1, 0)
ln[1] = "足場条件　" + projName
ln[2] = "系列 " + serTxt + "（" + modTxt + "）・" + scaffForm + "・" + railType
ln[3] = hTxt + "・期間 " + str(periodDays, 1, 0) + "日"
ln[4] = "離れ " + str(soTarget * 1000, 1, 0) + "（" + str(soMin * 1000, 1, 0) + "〜" + str(soMax * 1000, 1, 0) + "、下限 " + str(soHardMin * 1000, 1, 0) + "）"
ln[5] = region + "・粗度 " + roughness + "・" + sheetType
ln[6] = "立面 " + elevMode
ln[7] = "条件は設定ダイアログで変え、ツールバーを再実行"
nL = 7
w = 0
for i = 1 to nL
	w = max(w, stw(ln[i]) * GLOB_SCALE / 1000)
next i
pad = txH * 0.6
h = nL * txH * 1.6 + pad
pen 1
rect2 0, 0, w + 2 * pad, -h
line2 0, -txH * 1.6 - pad / 2, w + 2 * pad, -txH * 1.6 - pad / 2
for i = 1 to nL
	text2 pad, -pad - (i - 0.75) * txH * 1.6, ln[i]
next i
hotspot2 0, 0
hotspot2 w + 2 * pad, -h

