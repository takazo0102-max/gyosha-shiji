! ==========================================================
! 壁つなぎ（1本＝1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_tie/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_tie.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 足場ラインから分けた部材（利用者の指定 2026-10-20）。ツールバーが壁つなぎの位置ごとに置く。
! 原点＝内側建地の芯、faceAng で面の向き、+Y が躯体側。平面は ▽ 記号、3Dはクランプ＋本体＋アンカープレート。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度    面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）  既定 0
!   zH        長さ    高さ（GLから）                                                        既定 3.6
!   lineMode  ブール  3Dを線で（軽い）                                                      既定 0
!   tieL      長さ    長さ（内側建地から躯体面まで＝離れ）                                  既定 0.3
!   wallD     長さ    建地芯から躯体面まで（0 なら長さと同じ）                              既定 0
!   tieName   文字列  品番                                                                  既定 ""
!   matTie    表面材  表面材（0＝既定）                                                     既定 0
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 足場の壁つなぎ（1本＝1部品）。原点＝内側建地の芯、+Y＝躯体側、高さ zH

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 壁つなぎ 2D（平面）: 建地から躯体への線と、実務の記号 ▽（頂点を躯体側へ）
! ============================================================
pen 1
wD = wallD
if wD <= 0 then wD = tieL
rot2 faceAng
line2 0, 0, 0, wD
ty = wD / 2
line2 -0.11, ty - 0.09, 0.11, ty - 0.09
line2 0.11, ty - 0.09, 0, ty + 0.11
line2 0, ty + 0.11, -0.11, ty - 0.09
hotspot2 0, 0
hotspot2 0, wD
del 1

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 壁つなぎ 3D（伸縮式の壁つなぎ金具。日建 KS200〜1000・信和 NK 系と同じ構成）
!   建地側: φ42.7/48.6 用のクランプで支柱を抱き、自在の継手から本体を躯体へ出す
!   本体: 外管 φ27.2 ＋ 調整ナット（六角）＋ 全ねじの内側ロッド φ16（伸縮で長さを合わせる）
!   躯体側: 先端金具（座金）を壁つなぎ用アンカーにボルトで留める
!   原点＝内側建地の芯、+Y＝躯体側、zH＝取付高さ。wallD＝建地芯から躯体面（0 なら tieL）
!   以前は支柱を箱で包み、躯体側を大きな角板にしていて、支柱が埋もれて見えた（利用者の指摘 2026-10-20）
! ============================================================
pen 1
if matTie > 0 then material matTie
rP = 0.0486 / 2
wD = wallD
if wD <= 0 then wD = tieL
yC = rP + 0.035
yJ = yC + (wD - yC) * 0.55
rotz faceAng
addz zH
if lineMode then
	lin_ 0, rP, 0, 0, wD, 0
	lin_ -0.04, wD, 0, 0.04, wD, 0
else
	resol 8
	! クランプ（支柱を抱く輪）と、継手の耳
	add 0, 0, -0.03
	cylind 0.06, rP + 0.008
	del 1
	add -0.012, rP, -0.02
	block 0.024, yC - rP, 0.04
	del 1
	! 外管 φ27.2
	add 0, yC, 0
	rotx -90
	cylind yJ - yC, 0.0272 / 2
	del 2
	! 調整ナット（六角）
	resol 6
	add 0, yJ - 0.015, 0
	rotx -90
	cylind 0.03, 0.019
	del 2
	resol 8
	! 内側ロッド φ16（全ねじ）
	add 0, yJ, 0
	rotx -90
	cylind wD - 0.008 - yJ, 0.008
	del 2
	! 先端金具（座金）とボルト頭
	add -0.03, wD - 0.008, -0.03
	block 0.06, 0.008, 0.06
	del 1
	resol 6
	add 0, wD - 0.020, 0
	rotx -90
	cylind 0.012, 0.011
	del 2
endif
hotspot 0, 0, 0
hotspot 0, wD, 0
del 2

