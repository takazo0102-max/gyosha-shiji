! ==========================================================
! ネットブラケット（内側建地に付けて水平ネットを受ける） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_netbk/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_netbk.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 水平ネットを張る層の、内側建地の位置ごとに置く。腕は躯体側へ（離れ−50）。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度    面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）  既定 0
!   zH        長さ    高さ（GLから）                                                        既定 3.6
!   lineMode  ブール  3Dを線で（軽い）                                                      既定 0
!   armL      長さ    腕の長さ（内側建地から躯体側へ）                                      既定 0.25
!   matBk     表面材  表面材（0＝既定）                                                     既定 0
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 水平ネットのネットブラケット（内側建地に付けて躯体側へ腕を出し、水平ネットを受ける）

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! ネットブラケット 2D（平面）: 建地の躯体側の受け金具と腕、先端の立ち上がり
! ============================================================
pen 1
rot2 faceAng
rP = 0.0486 / 2
yH = rP + 0.036
rect2 -0.03, rP, 0.03, yH
line2 0, yH, 0, armL
line2 -0.03, armL, 0.03, armL
hotspot2 0, 0
hotspot2 0, armL
del 1

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! ネットブラケット 3D（くさび緊結式の内側建地に付ける水平ネット受け）
!   上の金具: 建地の緊結部（コマ）にくさびで留める受け金具。ここから躯体側へ腕（φ34）を出す
!   下の金具: 1コマ下（450mm）の緊結部に留め、方杖（φ27.2）で腕の先寄りを支える
!   腕の上にネットの縁を掛けるフック、先端は立ち上げてネットが躯体側へ抜けないようにする
!   原点＝内側建地の芯、+Y＝躯体側、zH＝ネットの高さ（腕の上端）
! ============================================================
pen 1
if matBk > 0 then material matBk
resol 8
rotz faceAng
addz zH
rP = 0.0486 / 2
yH = rP + 0.036
if lineMode then
	lin_ 0, rP, 0, 0, armL, 0
	lin_ 0, yH, -0.45, 0, armL * 0.75, -0.02
else
	! 上の受け金具とくさび（建地の躯体側の面に当てる）
	add -0.03, rP, -0.08
	block 0.06, yH - rP, 0.10
	del 1
	add -0.006, rP + 0.004, -0.13
	block 0.012, 0.028, 0.20
	del 1
	! 腕（上端をネットの高さに）
	add 0, yH, -0.017
	rotx -90
	cylind armL - yH, 0.034 / 2
	del 2
	! ネットを掛けるフック（腕の中ほどと先端寄り）と、先端の立ち上がり
	for ih = 1 to 2
		add 0, yH + (armL - yH) * ih / 3, 0
		cylind 0.04, 0.005
		del 1
	next ih
	add 0, armL - 0.017, -0.017
	cylind 0.10, 0.034 / 2
	del 1
	! 下の受け金具とくさび（1コマ下）
	add -0.03, rP, -0.50
	block 0.06, yH - rP, 0.10
	del 1
	add -0.006, rP + 0.004, -0.55
	block 0.012, 0.028, 0.20
	del 1
	! 方杖（下の金具 → 腕の先寄り）
	by1 = yH
	bz1 = -0.45
	by2 = max(yH + 0.05, armL * 0.75)
	bz2 = -0.025
	bL = sqr((by2 - by1) * (by2 - by1) + (bz2 - bz1) * (bz2 - bz1))
	add 0, by1, bz1
	rotx -atn((by2 - by1) / (bz2 - bz1))
	cylind bL, 0.0272 / 2
	del 2
endif
hotspot 0, 0, 0
hotspot 0, armL, 0
del 2

