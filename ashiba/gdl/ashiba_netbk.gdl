! ==========================================================
! ネットブラケット（内側建地に付けて水平ネットを受ける） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_netbk/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_netbk.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 水平ネットを張る層の、内側建地の位置ごとに置く。腕は躯体側へ（離れ−50）。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度      面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）                                             既定 0
!   zH        長さ      高さ（GLから）                                                                                                   既定 3.6
!   lineMode  ブール    3Dを線で（軽い）                                                                                                 既定 0
!   armL      長さ      先端の位置（建地芯から躯体側へ。NL500 は 342〜512 に丸める）                                                     既定 0.25
!   matBk     表面材    表面材（0＝既定）                                                                                                既定 0
!   penNet    PenColor  ペン: 層間ネット・ネットブラケット                                                                               既定 1
!   stepH     長さ      工程の模型の足場の高さ（部品の原点から。この高さより上を 3D に描かない。0＝全部。scripts/step_run.py が入れる）  既定 0
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 水平ネットのネットブラケット（内側建地に付けて躯体側へ腕を出し、水平ネットを受ける）

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! ネットブラケット（ネット専用ブラケット NL500 の形。利用者の資料 2026-10-20）
!   φ42.7/48.6 兼用クランプで内側建地を抱き、受け板（幅75・腕芯の上70／下175）から
!   φ34 の外管と φ27.2 の内管の伸縮腕を躯体側へ出す（方杖なし）。腕の届きは受け板の
!   建地側の面（建地芯から42）から 300〜470mm。ネットは受け板・外管の端・先端のフックに掛ける
!   原点＝内側建地の芯、+Y＝躯体側、zH＝ネットの高さ（腕の上端）。armL＝建地芯から先端まで
! ============================================================
rP = 0.0486 / 2
yP = 0.042
yO = 0.29
rO = 0.034 / 2
rI = 0.0272 / 2
tip = armL
if tip < yP + 0.30 then tip = yP + 0.30
if tip > yP + 0.47 then tip = yP + 0.47
zA = -rO
pN = penNet
if pN < 1 then pN = 1
pen pN
rot2 faceAng
circle2 0, 0, rP + 0.010
rect2 -(rO + 0.006), yP, rO + 0.006, yP + 0.075
line2 0, yP + 0.075, 0, tip
for ih = 1 to 3
	yh = yP + 0.08
	if ih = 2 then yh = yO - 0.03
	if ih = 3 then yh = tip - 0.02
	line2 -0.024, yh, 0.024, yh
next ih
hotspot2 0, 0
hotspot2 0, tip
del 1

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! ネットブラケット（ネット専用ブラケット NL500 の形。利用者の資料 2026-10-20）
!   φ42.7/48.6 兼用クランプで内側建地を抱き、受け板（幅75・腕芯の上70／下175）から
!   φ34 の外管と φ27.2 の内管の伸縮腕を躯体側へ出す（方杖なし）。腕の届きは受け板の
!   建地側の面（建地芯から42）から 300〜470mm。ネットは受け板・外管の端・先端のフックに掛ける
!   原点＝内側建地の芯、+Y＝躯体側、zH＝ネットの高さ（腕の上端）。armL＝建地芯から先端まで
! ============================================================
! 工程の模型（scripts/gdl_step.py）: stepH より上はまだ組み上がっていない
if stepH > 0.001 then
	rotx 90
	cutpoly 4, -1000, stepH, 1000, stepH, 1000, 1000, -1000, 1000
	del 1
endif
rP = 0.0486 / 2
yP = 0.042
yO = 0.29
rO = 0.034 / 2
rI = 0.0272 / 2
tip = armL
if tip < yP + 0.30 then tip = yP + 0.30
if tip > yP + 0.47 then tip = yP + 0.47
zA = -rO
pen 1
if matBk > 0 then material matBk
resol 8
rotz faceAng
addz zH
if lineMode then
	lin_ 0, yP, zA, 0, tip, zA
	lin_ 0, yP, zA + 0.07, 0, yP, zA - 0.175
else
	! クランプ（建地を抱く）とボルト
	add 0, 0, zA - 0.03
	cylind 0.06, rP + 0.010
	del 1
	add rP + 0.004, -0.010, zA - 0.010
	block 0.030, 0.020, 0.020
	del 1
	! 受け板 2枚（腕を挟む）と、下端で建地に当たる当て
	for sx = -1 to 1 step 2
		add sx * (rO + 0.004) - 0.002, yP, zA - 0.175
		block 0.004, 0.075, 0.245
		del 1
	next sx
	add -(rO + 0.006), rP, zA - 0.175
	block 2 * (rO + 0.006), yP + 0.020 - rP, 0.040
	del 1
	! 外管 φ34 と内管 φ27.2（伸縮）
	add 0, yP, zA
	rotx -90
	cylind yO - yP, rO
	del 2
	add 0, yO - 0.05, zA
	rotx -90
	cylind tip - (yO - 0.05), rI
	del 2
	! 固定ボルト・抜け止めボルト（外管の下）
	for ib = 1 to 2
		add 0, yO - 0.015 - 0.03 * (ib - 1), zA - rO - 0.025
		cylind 0.025, 0.006
		del 1
	next ib
	! ネット取付フック（受け板の先・外管の端・先端）: 腕を上下に抱く U 形
	for ih = 1 to 3
		yh = yP + 0.08
		if ih = 2 then yh = yO - 0.03
		if ih = 3 then yh = tip - 0.02
		for sx = -1 to 1 step 2
			add sx * 0.020, yh, zA - 0.035
			cylind 0.090, 0.004
			del 1
		next sx
		add -0.024, yh - 0.004, zA + 0.055
		block 0.048, 0.008, 0.008
		del 1
	next ih
endif
hotspot 0, 0, 0
hotspot 0, tip, 0
del 2
if stepH > 0.001 then cutend

