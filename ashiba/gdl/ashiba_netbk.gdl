! ==========================================================
! ネットブラケット（内側建地に付けて水平ネットを受ける） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_netbk/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_netbk.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 水平ネットを張る層の、内側建地の位置ごとに置く。腕は躯体側へ（離れ−50）。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度    面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）  既定 0
!   zH        長さ    高さ（GLから）                                                        既定 3.6
!   lineMode  ブール  3Dを線で（軽い）                                                      既定 0
!   armL      長さ    腕の長さ（内側建地から躯体側へ）                                      既定 0.25
!   matBk     表面材  表面材（0＝既定）                                                     既定 0
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 水平ネットのネットブラケット（内側建地に付けて躯体側へ腕を出し、水平ネットを受ける）

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! ネットブラケット 2D（平面）: 腕の線と建地側の金具
! ============================================================
pen 1
rot2 faceAng
line2 0, 0, 0, armL
rect2 -0.04, -0.04, 0.04, 0.04
hotspot2 0, 0
hotspot2 0, armL
del 1

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! ネットブラケット 3D: 建地を抱くクランプ、躯体側への腕 φ34、先端の立ち上がり（ネットの縁を掛ける）、
! 下からの方杖（腕の6割の位置へ 45°）
! ============================================================
pen 1
if matBk > 0 then material matBk
resol 8
rotz faceAng
addz zH
if lineMode then
	lin_ 0, 0, 0, 0, armL, 0
else
	add -0.04, -0.04, -0.06
	block 0.08, 0.08, 0.12
	del 1
	rotx -90
	cylind armL, 0.034 / 2
	del 1
	add 0, armL, 0
	cylind 0.12, 0.034 / 2
	del 1
	sl = armL * 0.6
	add 0, 0, -sl
	rotx -45
	cylind sl * 1.4142, 0.0272 / 2
	del 2
endif
hotspot 0, 0, 0
hotspot 0, armL, 0
del 2

