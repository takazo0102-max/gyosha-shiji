! ==========================================================
! 屋上への渡り（足場の最上段の床から屋上へ・1箇所に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_bridge/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_bridge.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-24）: 屋上への渡りもGDL作成して 平面に表記するようにして。
! 原点＝足場の内側建地列、faceAng で面の向き。床（踏板・斜路の踏桟・段差は踏段、パラペットは天端の上を越える）と両側の手すり・中桟・幅木。平面は外形・手すり・矢印・名前。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度      面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）         既定 0
!   brW       長さ      渡りの幅（面に沿う方向。手すりの芯々）                                       既定 0.6
!   brL       長さ      渡りの長さ（内側建地列 y=0 から躯体側へ。離れ＋パラペット＋屋上側の掛かり）  既定 1.2
!   zFrom     長さ      足場の最上段の床の高さ（配置した高さから）                                   既定 9.0
!   zTo       長さ      屋上の床（渡りの降り口）の高さ（配置した高さから）                           既定 9.0
!   paraH     長さ      パラペットの天端（屋上の床から。0＝なし。渡りはパラペットを越える）          既定 0
!   paraX     長さ      パラペットの位置（内側建地列から躯体側へ。離れ）                             既定 0.3
!   brName    文字列    平面に書く名前                                                               既定 "屋上への渡り"
!   lineMode  ブール    3Dを線で（軽い）                                                             既定 0
!   matDeck   表面材    表面材（0＝既定）                                                            既定 0
!   texSiz    実数      文字高mm                                                                     既定 2.0
!   penEquip  PenColor  ペン: 付帯設備（渡り）                                                       既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 屋上への渡り（足場の最上段の床から屋上へ。手すり・中桟・幅木つきの渡り桟橋）。1箇所に1部品

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 屋上への渡り 2D（平面）: 渡りの外形・踏板の継ぎ・両側の手すり（太線）・パラペット（破線）・進む向きの矢印と名前
! 利用者の指定（2026-10-24）: 屋上への渡りもGDL作成して 平面に表記するようにして
! 原点＝足場の内側建地列（y=0）、+X＝面に沿う方向、+Y＝躯体側（屋上）。渡りは y=-0.3（足場の床に掛かる）〜 brL
! ============================================================
define style "brTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
pE = penEquip
if pE < 1 then pE = 1
pen pE
rot2 faceAng
yS = -0.30
! 外形と踏板の継ぎ（0.6 ごと）
rect2 0, yS, brW, brL
yk = yS + 0.6
while yk < brL - 0.05 do
	line2 0.02, yk, brW - 0.02, yk
	yk = yk + 0.6
endwhile
! 両側の手すり（二重線で太く見せる）
for sd = 0 to 1
	xr = sd * brW
	line2 xr, yS, xr, brL
	line2 xr + 0.03 * (1 - 2 * sd), yS, xr + 0.03 * (1 - 2 * sd), brL
	circle2 xr, yS, 0.025
	circle2 xr, brL, 0.025
next sd
! パラペット（越える所）
if paraH > 0.001 then
	line_type 3
	line2 -0.3, paraX, brW + 0.3, paraX
	line_type 1
endif
! 進む向き（足場→屋上）の矢印
line2 brW / 2, yS + 0.10, brW / 2, brL - 0.15
line2 brW / 2, brL - 0.15, brW / 2 - 0.08, brL - 0.30
line2 brW / 2, brL - 0.15, brW / 2 + 0.08, brL - 0.30
hotspot2 0, 0
hotspot2 brW, 0
hotspot2 0, brL
hotspot2 brW, brL
! 名前（幅・高低差）。北・西を向く面では上下逆になるので回して読める向きに
set style "brTx"
tx = brName + " 幅" + str(brW * 1000, 3, 0)
dz = (zTo - zFrom) * 1000
if abs(dz) > 1 then
	if dz > 0 then tx = tx + " 上り" + str(dz, 4, 0)
	if dz < 0 then tx = tx + " 下り" + str(-dz, 4, 0)
endif
if paraH > 0.001 then tx = tx + "・パラペット越え"
add2 brW + 0.15, (yS + brL) / 2
rot2 90
if SYMB_ROTANGLE + faceAng > 90.001 and SYMB_ROTANGLE + faceAng < 270.001 then rot2 180
text2 0, 0, tx
del top

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 屋上への渡り 3D: 足場の最上段の床（zFrom）から屋上（zTo）へ。踏板（足場板 t40）・斜路は踏桟、段差は踏段、
! パラペットがあれば天端の上を越える。両側に手すり（H950）・中桟（H450）・幅木（H150）
! 原点＝足場の内側建地列（y=0）、+X＝面に沿う方向、+Y＝躯体側。y=-0.3 から足場の床に掛ける
! ============================================================
pen penEquip
resol 8
rotz faceAng
if matDeck > 0 then material matDeck
yS = -0.30
! 渡りの床の折れ点（上面）
dim pY[], pZ[]
nP = 1
pY[1] = yS
pZ[1] = zFrom
zC = zFrom
if paraH > 0.001 then
	zC = max(zFrom, zTo + paraH + 0.05)
	nP = nP + 1
	pY[nP] = paraX - 0.15
	pZ[nP] = zC
	nP = nP + 1
	pY[nP] = paraX + 0.35
	pZ[nP] = zC
endif
nP = nP + 1
pY[nP] = brL
pZ[nP] = zTo
! 床: 高低差の小さい区間は踏板（斜路は踏桟つき）、大きい区間は踏段
for ip = 1 to nP - 1
	y1 = pY[ip]
	z1 = pZ[ip]
	y2 = pY[ip + 1]
	z2 = pZ[ip + 1]
	if y2 > y1 + 0.01 then
		if abs(z2 - z1) <= 0.25 then
			ag = atn((z2 - z1) / (y2 - y1))
			add 0.025, y1, z1
			rotx ag
			addz -0.04
			block brW - 0.05, sqr((y2 - y1) ^ 2 + (z2 - z1) ^ 2), 0.04
			del 3
			if abs(z2 - z1) > 0.03 then
				yc = y1 + 0.15
				while yc < y2 - 0.1 do
					add 0.04, yc, z1 + (z2 - z1) * (yc - y1) / (y2 - y1)
					block brW - 0.08, 0.025, 0.02
					del 1
					yc = yc + 0.30
				endwhile
			endif
		else
			nS = int(abs(z2 - z1) / 0.20 - 0.001) + 1
			tL = (y2 - y1) / nS
			for iS2 = 0 to nS - 1
				zs = z1 + (z2 - z1) * (iS2 + 1) / nS
				add 0.025, y1 + iS2 * tL, zs - 0.04
				block brW - 0.05, tL, 0.04
				del 1
			next iS2
			! 側桁
			for sd = 0 to 1
				add sd * (brW - 0.012), y1, min(z1, z2) - 0.15
				block 0.012, y2 - y1, abs(z2 - z1) + 0.15
				del 1
			next sd
		endif
	endif
next ip
! 手すり・中桟・幅木（両側。床の折れ点に沿って）と支柱
for sd = 0 to 1
	xr = sd * brW
	for ip = 1 to nP
		add xr, pY[ip], pZ[ip]
		cylind 0.95, 0.0243
		del 1
	next ip
	for ip = 1 to nP - 1
		dy = pY[ip + 1] - pY[ip]
		dz = pZ[ip + 1] - pZ[ip]
		if dy > 0.01 then
			ag = atn(dz / dy)
			for hk = 1 to 2
				hh = 0.95
				if hk = 2 then hh = 0.45
				add xr, pY[ip], pZ[ip] + hh
				rotx -(90 - ag)
				cylind sqr(dy * dy + dz * dz), 0.0243
				del 2
			next hk
			add xr - 0.006 + sd * 0.0, pY[ip], pZ[ip]
			rotx ag
			block 0.012, sqr(dy * dy + dz * dz), 0.15
			del 2
		endif
	next ip
next sd
del top

