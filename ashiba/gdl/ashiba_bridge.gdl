! ==========================================================
! 屋上への渡り（足場の最上段の床から屋上へ・1箇所に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_bridge/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_bridge.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-24）: 屋上への渡りもGDL作成して 平面に表記するようにして。
! 原点＝足場の内側建地列、faceAng で面の向き。床（踏板・斜路の踏桟・段差は踏段、パラペットは天端の上を越える）と両側の手すり・中桟・幅木。平面は外形・手すり・矢印・名前。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度      面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）                                                  既定 0
!   brW       長さ      渡りの幅（面に沿う方向。掛けるスパンの内側建地列の支柱の芯々）                                                        既定 1.829
!   brL       長さ      渡りの奥行き（内側建地列 y=0 から躯体側へ。布材・ブラケット・単管の長さ）                                             既定 0.914
!   brKind    整数      組み方 0＝布材＋屋上に支柱 1＝ブラケット（すき間を塞ぐ） 2＝単管＋屋上に単管の支柱 3＝単管の跳ね出し（すき間を塞ぐ）  既定 0
!   zFrom     長さ      渡りへ出る足場の床の高さ（配置した高さから）                                                                          既定 9.0
!   zDeck     長さ      渡りの床の高さ（配置した高さから）                                                                                    既定 9.0
!   zTo       長さ      屋上の床の高さ（配置した高さから）                                                                                    既定 9.0
!   postL     長さ      屋上の支柱の長さ（くさびの支柱・単管）                                                                                既定 0.9
!   jackOut   長さ      屋上の支柱のジャッキの繰出し（くさび）                                                                                既定 0.1
!   deckList  文字列    床材の幅 mm カンマ区切り（アンチ 500・240／足場板 240）                                                               既定 "500,500,500,240"
!   deckLen   長さ      床材の長さ（アンチは布材と同じ呼び、足場板は規格の長さ）                                                              既定 0.914
!   paraH     長さ      パラペットの高さ（屋上の床から。0＝なし）                                                                             既定 0
!   paraX     長さ      躯体の外面（パラペットの外面）の位置（内側建地列から躯体側へ。離れ）                                                  既定 0.3
!   paraT     長さ      パラペットの厚さ                                                                                                      既定 0
!   extL      長さ      掛けるスパンの内側の支柱2本に継ぎ足す長さ（渡りの手すりを受ける。0＝なし）                                            既定 0
!   postTop   長さ      内側の支柱の天端の高さ（配置した高さから）                                                                            既定 0
!   brName    文字列    平面に書く名前                                                                                                        既定 "屋上への渡り"
!   lineMode  ブール    3Dを線で（軽い）                                                                                                      既定 0
!   matDeck   表面材    表面材（0＝既定）                                                                                                     既定 0
!   texSiz    実数      文字高mm                                                                                                              既定 2.0
!   penEquip  PenColor  ペン: 付帯設備（渡り）                                                                                                既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 屋上への渡り（足場の部材で組む。roof_bridges）。1箇所に1部品
! 床材の幅（mm→m）
dim dW[20]
nD = 0
rest = deckList
while strlen(rest) > 0 and nD < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nD = nD + 1
		dW[nD] = v / 1000
	endif
endwhile
isTube = 0
if brKind >= 2 then isTube = 1
onPost = 0
if brKind = 0 or brKind = 2 then onPost = 1
! 足場側の踏み台・屋上側の踏段（けあげ 230 以下・踏面 250）
upH = zDeck - zFrom
nUp = 0
if upH > 0.03 then nUp = int(upH / 0.23 - 0.001) + 1
dnH = 0
if onPost = 1 then dnH = zDeck - zTo
nDn = 0
if dnH > 0.03 then nDn = int(dnH / 0.23 - 0.001) + 1
tread = 0.25
yUp = -max(0, nUp - 1) * tread
yDn = brL + max(0, nDn - 1) * tread

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 屋上への渡り 2D（平面）: 渡りの外形・床材（アンチ・足場板）の割り・両脇の手すり（太線）・屋上の支柱／ブラケット
! 先端の支柱・踏み台と踏段の段鼻・パラペット（破線）・進む向きの矢印と名前
! 利用者の指定（2026-10-24）: 屋上への渡りもGDL作成して 平面に表記するようにして
! 原点＝渡りを掛けるスパンの始めの内側建地（y=0）、+X＝面に沿う方向、+Y＝躯体側（屋上）
! ============================================================
define style "brTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
pE = penEquip
if pE < 1 then pE = 1
pen pE
rot2 faceAng
! 外形
rect2 0, 0, brW, brL
! 床材の割り（アンチ・足場板は横引き。面に沿って並べる）
y0 = 0.02
for i = 1 to nD
	rect2 0.02, y0, brW - 0.02, y0 + dW[i]
	y0 = y0 + dW[i] + 0.01
next i
! 両脇の手すり（二重線で太く見せる）
for sd = 0 to 1
	xr = sd * brW
	line2 xr, 0, xr, brL
	line2 xr + 0.03 * (1 - 2 * sd), 0, xr + 0.03 * (1 - 2 * sd), brL
	! 渡りの先の支柱（屋上の支柱・ブラケットの先端の支柱）
	circle2 xr, brL, 0.03
	if onPost = 1 then rect2 xr - 0.07, brL - 0.07, xr + 0.07, brL + 0.07
next sd
! 足場側の踏み台
if nUp > 1 then
	rect2 0.10, yUp, brW - 0.10, 0
	for iS = 1 to nUp - 2
		line2 0.10, yUp + iS * tread, brW - 0.10, yUp + iS * tread
	next iS
endif
! 屋上へ下りる踏段
if nDn > 1 then
	rect2 0.10, brL, brW - 0.10, yDn
	for iS = 1 to nDn - 2
		line2 0.10, brL + iS * tread, brW - 0.10, brL + iS * tread
	next iS
endif
! パラペット（越える所。外面と内面）
if paraH > 0.001 then
	line_type 3
	line2 -0.3, paraX, brW + 0.3, paraX
	line2 -0.3, paraX + paraT, brW + 0.3, paraX + paraT
	line_type 1
endif
! 進む向き（足場→屋上）の矢印
yE = max(brL, yDn)
line2 brW / 2, min(0, yUp) + 0.05, brW / 2, yE - 0.05
line2 brW / 2, yE - 0.05, brW / 2 - 0.08, yE - 0.20
line2 brW / 2, yE - 0.05, brW / 2 + 0.08, yE - 0.20
hotspot2 0, 0
hotspot2 brW, 0
hotspot2 0, brL
hotspot2 brW, brL
! 名前（組み方・高低差）。北・西を向く面では上下逆になるので回して読める向きに
set style "brTx"
tx = brName
if brKind = 0 then tx = tx + "（布材＋屋上に支柱）"
if brKind = 1 then tx = tx + "（ブラケット）"
if brKind = 2 then tx = tx + "（単管＋屋上に建地）"
if brKind = 3 then tx = tx + "（単管の跳ね出し）"
if nUp > 0 then tx = tx + " 踏み台" + str(upH * 1000, 4, 0)
if nDn > 0 then tx = tx + " 踏段" + str(dnH * 1000, 4, 0)
if paraH > 0.001 then tx = tx + "・パラペット越え"
add2 brW + 0.15, (min(0, yUp) + yE) / 2
rot2 90
if SYMB_ROTANGLE + faceAng > 90.001 and SYMB_ROTANGLE + faceAng < 270.001 then rot2 180
text2 0, 0, tx
del top

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 屋上への渡り 3D: 足場の部材で組む（利用者の指定 2026-10-26: 布材かブラケット出して支柱で足元つくかブラケットで
! 浮かせる、アンチ引いて手すりも布材、枠の場合は単管と足場板、パラペットは避ける）。
! 原点＝渡りを掛けるスパンの始めの内側建地（y=0）、+X＝面に沿う方向（幅 brW＝スパン）、+Y＝躯体側
!  brKind 0: 布材を内側建地から出し、屋上に支柱（ジャッキ付き）。アンチは y 方向（長さ brL）に敷く
!         1: 張出・拡幅ブラケットで躯体の外面まで出し、アンチを面に沿って（長さ brW）敷いてすき間を塞ぐ
!         2: 単管を建地にクランプで留め、屋上に単管の支柱（ベース付き）。足場板は y 方向に敷く
!         3: 単管を躯体の外面まで跳ね出し、足場板を面に沿って敷いてすき間を塞ぐ
! 手すり（床から 900）・中桟（450）・幅木は両脇。足場の床より高ければ足場側に踏み台、屋上より高ければ屋上へ踏段。
! パラペットは渡りの床（天端の 50 上より上）が越え、屋上の支柱はパラペットの内側（Python の roof_bridges）
! ============================================================
pen penEquip
resol 8
rotz faceAng
if matDeck > 0 then material matDeck
r_p = 0.0243           ! 支柱・単管 φ48.6
r_n = 0.02135          ! 布材 φ42.7
zR = zDeck + 0.90
zM = zDeck + 0.45
! ---- 屋上の支柱（0: くさびの支柱＋ジャッキ、2: 単管＋ベース） ----
if onPost = 1 then
	for sd = 0 to 1
		xs = sd * brW
		add xs, brL, zTo
		if isTube = 0 then
			add -0.075, -0.075, 0
			block 0.15, 0.15, 0.009
			del 1
			cylind jackOut, 0.017
			addz jackOut
			cylind postL, r_p
			! コマ（床・中桟・手すり）
			for kz = 0 to 2
				addz zDeck - zTo - jackOut + kz * 0.45 - 0.003
				cylind 0.006, 0.045
				del 1
			next kz
			del 1
		else
			add -0.07, -0.07, 0
			block 0.14, 0.14, 0.006
			del 1
			cylind postL, r_p
		endif
		del 1
	next sd
endif
! ---- 床を受ける材 ----
if brKind = 0 then
	! 布材: 両脇の腕木（内側建地から屋上の支柱へ。アンチを掛ける）と、屋上の支柱どうしをつなぐ布材
	for sd = 0 to 1
		add sd * brW, 0, zDeck - 0.02
		rotx -90
		cylind brL, r_n
		del 2
	next sd
	add 0, brL, zDeck - 0.02
	roty 90
	cylind brW, r_n
	del 2
endif
if brKind = 1 then
	! 張出・拡幅ブラケット（両脇）: 腕・方杖（1コマ下の支柱へ）・先端のホゾに立てる支柱（1350。手すり・中桟のコマ）
	for sd = 0 to 1
		xs = sd * brW
		add xs - 0.02, 0, zDeck - 0.09
		block 0.04, brL, 0.05
		del 1
		dyB = brL - 0.03
		dzB = 0.45 - 0.09
		add xs, 0.03, zDeck - 0.45
		rotx -(90 - atn(dzB / dyB))
		cylind sqr(dyB * dyB + dzB * dzB), 0.015
		del 2
		add xs, brL, zDeck - 0.09
		cylind 1.35, r_p
		del 1
	next sd
endif
if isTube = 1 then
	! 単管: 両脇を建地（y=0）から y 方向へ（足場板を掛ける。2 は屋上の支柱まで、3 は躯体の外面まで跳ね出し）
	zT = zDeck - 0.028 - r_p
	for sd = 0 to 1
		add sd * brW + (1 - 2 * sd) * r_p * 2, -0.10, zT
		rotx -90
		cylind brL + 0.10 + 0.10 * (brKind = 2), r_p
		del 2
	next sd
	if brKind = 2 then
		! 屋上の支柱どうしをつなぐ単管
		add -0.10, brL, zT - 2 * r_p
		roty 90
		cylind brW + 0.20, r_p
		del 2
	endif
	if brKind = 3 then
		! 先端の手すり柱（跳ね出しの単管にクランプで立てる）
		for sd = 0 to 1
			add sd * brW + (1 - 2 * sd) * r_p * 2, brL, zT - 0.05
			cylind 1.05, r_p
			del 1
		next sd
	endif
endif
! ---- 床（アンチ・足場板）: 横引き（面に沿って、両脇の腕木・ブラケット・単管に掛ける）。内側建地列から躯体側へ並べる ----
y0 = 0.02
tD = 0.04
xA = 0.02
xB = brW - 0.02
if isTube = 1 then
	tD = 0.028
	xA = brW / 2 - deckLen / 2
	xB = brW / 2 + deckLen / 2
endif
for i = 1 to nD
	add xA, y0, zDeck - tD
	block xB - xA, dW[i], tD
	del 1
	y0 = y0 + dW[i] + 0.01
next i
! ---- 手すり・中桟（両脇、y=0 の建地から渡りの先の支柱まで）と幅木 ----
rr = r_n
if isTube = 1 then rr = r_p
for sd = 0 to 1
	xs = sd * brW + isTube * (1 - 2 * sd) * r_p * 2
	for hk = 0 to 1
		add xs, 0, zM + hk * 0.45
		rotx -90
		cylind brL, rr
		del 2
	next hk
	hT = 0.15
	if isTube = 1 then hT = 0.24
	add sd * (brW - 0.012) + (1 - 2 * sd) * 0.03, 0.02, zDeck
	block 0.012, brL - 0.04, hT
	del 1
next sd
! ---- 内側の支柱の継ぎ足し（渡りの手すりが支柱の天端より上のとき。くさびは天端に差す支柱、単管は建地に重ねてクランプ） ----
if extL > 0.001 then
	for sd = 0 to 1
		if isTube = 0 then
			add sd * brW, 0, postTop
			cylind extL, r_p
		else
			add sd * brW + (1 - 2 * sd) * r_p * 2, -r_p * 2, postTop - 0.30
			cylind extL, r_p
		endif
		del 1
	next sd
endif
! ---- 足場側の踏み台（渡りの床が足場の床より高いとき） ----
if nUp > 0 then
	for iS = 1 to nUp - 1
		zs = zFrom + upH * iS / nUp
		ya = yUp + (iS - 1) * tread
		add 0.10, ya, zFrom
		block brW - 0.20, tread, zs - zFrom
		del 1
	next iS
endif
! ---- 屋上へ下りる踏段（屋上に支柱を立てた渡りで、渡りの床が屋上より高いとき） ----
if nDn > 1 then
	for iS = 1 to nDn - 1
		zs = zDeck - dnH * iS / nDn
		ya = brL + (iS - 1) * tread
		add 0.10, ya, zs - 0.04
		block brW - 0.20, tread, 0.04
		del 1
		! 側桁（踏面の下から屋上まで）
		for sd = 0 to 1
			add 0.10 + sd * (brW - 0.212), ya, zTo
			block 0.012, tread, zs - 0.04 - zTo
			del 1
		next sd
	next iS
	! 踏段の手すり（両脇。渡りの手すりから屋上の床の 900 上まで）と下の支柱
	dyS = yDn - brL
	dzS = dnH * (nDn - 1) / nDn
	for sd = 0 to 1
		xs = 0.10 + sd * (brW - 0.20)
		add xs, brL, zR
		rotx -(90 - atn(-dzS / dyS))
		cylind sqr(dyS * dyS + dzS * dzS), r_n
		del 2
		add xs, yDn, zTo
		cylind zR - dzS - zTo, r_n
		del 1
	next sd
endif
del top

