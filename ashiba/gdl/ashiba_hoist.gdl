endif
if hoModel = "HSL-900C2-5.4" then
	cageL = 4.7700
	cageD = 1.2480
	postSp = 4.8900
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 5.4m ロングスパン（ジャバラ手すり）"
	hoKind = 1
