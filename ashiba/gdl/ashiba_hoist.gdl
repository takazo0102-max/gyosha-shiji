endif
if hoModel = "HSL-900C2-3.6" then
	cageL = 2.9700
	cageD = 1.2480
	postSp = 3.0900
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 3.6m ロングスパン（ジャバラ手すり）"
	hoKind = 1
