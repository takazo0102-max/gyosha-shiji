	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 7.2m ロングスパン（ジャバラ手すり）"
	hoKind = 1
	roofMode = 1
endif
if hoModel = "HSL-900C3-5.4" then
	cageL = 4.9000
	cageD = 1.2480
	postSp = 4.9000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 800
	hoName = "HSL-900CⅢ 5.4m ロングスパン"
	hoKind = 1
	roofMode = 1
endif
if hoModel = "HSL-900C3-7.2" then
	cageL = 6.7000
	cageD = 1.2480
	postSp = 6.7000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 800
	hoName = "HSL-900CⅢ 7.2m ロングスパン"
	hoKind = 1
	roofMode = 1
endif
if hoModel = "HSL-900B-5.4" then
	cageL = 4.7700
	cageD = 1.0000
	postSp = 4.8700
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900B 5.4m ロングスパン"
	hoKind = 1
