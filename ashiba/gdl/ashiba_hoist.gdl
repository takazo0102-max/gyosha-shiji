! ==========================================================
! 昇降機（工事用エレベーター・ロングスパン・荷揚げ機・1基に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_hoist/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_hoist.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-27）: 昇降機の機種表にする・フロアーゲートを描いて数える・機種ごとの形を3Dで描く・昇降機は別オブジェクトで配置できるように。
! 機種（hoModel）を選ぶと data/hoist_models.csv の荷台・マスト・壁つなぎ間隔で描く（寸法表は scripts/gen_hoist_gdl.py が書き出す）。原点＝足場の外側建地の列の上の昇降機の中心、faceAng で面の向き。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng     角度      面の向き（度。+X＝面に沿う向き、+Y＝躯体側）                                                      既定 0
!   hoModel     文字列    機種（data/hoist_models.csv）                                                                     既定 "KSE600C"
!   zH          長さ      足場の立つ面の高さ（階の高さから。配置が入れる。高さはすべてここから）                            既定 0
!   hoReach     長さ      到達高さ（マストの頂部の目安。配置で足場の天端を入れる）                                          既定 10
!   gapOut      長さ      足場の外側建地の列から荷台までのあき                                                              既定 0.1
!   landLevels  文字列    乗り込む作業層の番号（カンマ区切り「2,5」。空は全部の層）                                         既定 ""
!   landList    文字列    乗り込む作業床の高さ m（配置が入れる。フロアーゲートを描く）                                      既定 ""
!   tieList     文字列    マスト控えを取る足場の建地（中心から面に沿って m、カンマ区切り。配置が入れる。空はマストの正面）  既定 ""
!   gateA       長さ      乗り込み口の始点（中心から面に沿って。配置が足場の手すりを外したスパンの端を入れる）              既定 0
!   gateB       長さ      乗り込み口の終点（同上。gateA と同じなら荷台の長さで描く）                                        既定 0
!   showGate    ブール    乗り込み口のフロアーゲート（機種に無ければ開閉式手すり）を描く                                    既定 1
!   showTie     ブール    マストの壁つなぎを描く                                                                            既定 1
!   showFence   ブール    地上の昇降路の囲い（高さ 1.8m・荷台から 0.3 離す）を描く                                          既定 1
!   matCage     表面材    荷台・マストの材質                                                                                既定 0
!   texSiz      実数      文字の大きさ（mm）                                                                                既定 2.5
!   penEquip    PenColor  線のペン                                                                                          既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 昇降機（工事用エレベーター・ロングスパン・荷揚げ機）. 機種の寸法表は scripts/gen_hoist_gdl.py が
! data/hoist_models.csv から書き出す（手で直さない）
cageL = 4.6
cageD = 1.3
postSp = 0
nMast = 1
gateOpen = 0
tieE = 3.6
loadKg = 0
hoName = hoModel
! 種類（1＝ロングスパン・2＝工事用エレベーター・3＝荷揚げ機）と頭上覆い（1＝両端の駆動部だけ・2＝荷台全体のヘッドガード）
hoKind = 1
roofMode = 1
if hoModel = "KSE600C" then
	cageL = 3.3000
	cageD = 1.1000
	postSp = 0.0000
	nMast = 1
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 600
	hoName = "KSE600C 型 工事用エレベーター"
	hoKind = 2
	roofMode = 1
endif
if hoModel = "KSE600L" then
	cageL = 3.3000
	cageD = 1.1000
	postSp = 0.0000
	nMast = 1
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 600
	hoName = "KSE600L 型 工事用エレベーター"
	hoKind = 2
	roofMode = 1
endif
if hoModel = "KSE900-3.6" then
	cageL = 3.0000
	cageD = 1.0300
	postSp = 3.0000
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE-900 3.6m 型 ロングスパン"
	hoKind = 1
	roofMode = 1
endif
