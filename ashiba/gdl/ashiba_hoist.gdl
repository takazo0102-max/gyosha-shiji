endif
if hoModel = "HSL-900B-7.2" then
	cageL = 6.5700
	cageD = 1.0000
	postSp = 6.6700
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900B 7.2m ロングスパン"
	hoKind = 1
