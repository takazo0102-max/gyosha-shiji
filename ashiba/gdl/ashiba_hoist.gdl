! ==========================================================
! 昇降機（工事用エレベーター・ロングスパン・荷揚げ機・1基に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_hoist/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_hoist.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-27）: 昇降機の機種表にする・フロアーゲートを描いて数える・機種ごとの形を3Dで描く・昇降機は別オブジェクトで配置できるように。
! 機種（hoModel）を選ぶと data/hoist_models.csv の荷台・マスト・壁つなぎ間隔で描く（寸法表は scripts/gen_hoist_gdl.py が書き出す）。原点＝足場の外側建地の列の上の昇降機の中心、faceAng で面の向き。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng     角度      面の向き（度。+X＝面に沿う向き、+Y＝躯体側）                                          既定 0
!   hoModel     文字列    機種（data/hoist_models.csv）                                                         既定 "KSE600C"
!   hoReach     長さ      到達高さ（マストの頂部の目安。配置で足場の天端を入れる）                              既定 10
!   gapOut      長さ      足場の外側建地の列から荷台までのあき                                                  既定 0.1
!   landLevels  文字列    乗り込む作業層の番号（カンマ区切り「2,5」。空は全部の層）                             既定 ""
!   landList    文字列    乗り込む作業床の高さ m（配置が入れる。フロアーゲートを描く）                          既定 ""
!   gateA       長さ      乗り込み口の始点（中心から面に沿って。配置が足場の手すりを外したスパンの端を入れる）  既定 0
!   gateB       長さ      乗り込み口の終点（同上。gateA と同じなら荷台の長さで描く）                            既定 0
!   showGate    ブール    乗り込み口のフロアーゲート（機種に無ければ開閉式手すり）を描く                        既定 1
!   showTie     ブール    マストの壁つなぎを描く                                                                既定 1
!   showFence   ブール    地上の昇降路の囲い（高さ 1.8m・荷台から 0.3 離す）を描く                              既定 1
!   matCage     表面材    荷台・マストの材質                                                                    既定 0
!   texSiz      実数      文字の大きさ（mm）                                                                    既定 2.5
!   penEquip    PenColor  線のペン                                                                              既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 昇降機（工事用エレベーター・ロングスパン・荷揚げ機）. 機種の寸法表は scripts/gen_hoist_gdl.py が
! data/hoist_models.csv から書き出す（手で直さない）
cageL = 4.6
cageD = 1.3
postSp = 0
nMast = 1
gateOpen = 0
tieE = 3.6
loadKg = 0
hoName = hoModel
if hoModel = "KSE600C" then
	cageL = 3.3000
	cageD = 1.1000
	postSp = 0.0000
	nMast = 1
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 600
	hoName = "KSE600C 型 工事用エレベーター"
endif
if hoModel = "KSE600L" then
	cageL = 3.3000
	cageD = 1.1000
	postSp = 0.0000
	nMast = 1
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 600
	hoName = "KSE600L 型 工事用エレベーター"
endif
if hoModel = "KSE900-3.6" then
	cageL = 3.0000
	cageD = 1.0300
	postSp = 3.0000
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE-900 3.6m 型 ロングスパン"
endif
if hoModel = "KSE900-5.4" then
	cageL = 4.8000
	cageD = 1.0300
	postSp = 4.8000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE-900 5.4m 型 ロングスパン"
endif
if hoModel = "KSE900-7.2" then
	cageL = 6.6000
	cageD = 1.1500
	postSp = 6.6000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE-900 7.2m 型 ロングスパン"
endif
if hoModel = "KSE900-3-3.6" then
	cageL = 3.0000
	cageD = 0.6800
	postSp = 3.0000
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE900-3 3.6m 型 ロングスパン（細幅）"
endif
if hoModel = "KSE900-3-5.4" then
	cageL = 4.8000
	cageD = 0.6800
	postSp = 4.8000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE900-3 5.4m 型 ロングスパン（細幅）"
endif
if hoModel = "KSE-990" then
	cageL = 4.8000
	cageD = 1.0300
	postSp = 4.8000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 990
	hoName = "KSE-990 型 ロングスパン"
endif
if hoModel = "HSL-900C2-3.6" then
	cageL = 2.9700
	cageD = 1.2480
	postSp = 3.0900
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 3.6m ロングスパン（ジャバラ手すり）"
endif
if hoModel = "HSL-900C2-4.5" then
	cageL = 3.8700
	cageD = 1.2480
	postSp = 3.9900
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 4.5m ロングスパン（ジャバラ手すり）"
endif
if hoModel = "HSL-900C2-5.4" then
	cageL = 4.7700
	cageD = 1.2480
	postSp = 4.8900
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 5.4m ロングスパン（ジャバラ手すり）"
endif
if hoModel = "HSL-900C2-6.3" then
	cageL = 5.6700
	cageD = 1.2480
	postSp = 5.7900
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 6.3m ロングスパン（ジャバラ手すり）"
endif
if hoModel = "HSL-900C2-7.2" then
	cageL = 6.5700
	cageD = 1.2480
	postSp = 6.6900
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 7.2m ロングスパン（ジャバラ手すり）"
endif
if hoModel = "HSL-900C3-5.4" then
	cageL = 4.9000
	cageD = 1.2480
	postSp = 4.9000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 800
	hoName = "HSL-900CⅢ 5.4m ロングスパン"
endif
if hoModel = "HSL-900C3-7.2" then
	cageL = 6.7000
	cageD = 1.2480
	postSp = 6.7000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 800
	hoName = "HSL-900CⅢ 7.2m ロングスパン"
endif
if hoModel = "HSL-900B-5.4" then
	cageL = 4.7700
	cageD = 1.0000
	postSp = 4.8700
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900B 5.4m ロングスパン"
endif
if hoModel = "HSL-900B-7.2" then
	cageL = 6.5700
	cageD = 1.0000
	postSp = 6.6700
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900B 7.2m ロングスパン"
endif
if hoModel = "HSL950L2" then
	cageL = 6.6980
	cageD = 1.1800
	postSp = 6.6980
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 950
	hoName = "HSL950L2 ロングスパン"
endif
if hoModel = "HSL990L2" then
	cageL = 4.8980
	cageD = 1.1800
	postSp = 4.8980
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 990
	hoName = "HSL990L2 ロングスパン"
endif
if hoModel = "KRD800-5.4" then
	cageL = 4.2000
	cageD = 0.6600
	postSp = 4.8700
	nMast = 2
	gateOpen = 6.6300
	tieE = 6.0000
	loadKg = 800
	hoName = "KRD-800 ローターデッキ 3スパン"
endif
if hoModel = "KRD800-7.2" then
	cageL = 6.2400
	cageD = 0.6600
	postSp = 6.6700
	nMast = 2
	gateOpen = 6.6300
	tieE = 6.0000
	loadKg = 800
	hoName = "KRD-800 ローターデッキ 4スパン"
endif
if hoModel = "KRD950-5.4" then
	cageL = 4.4400
	cageD = 1.0700
	postSp = 4.8700
	nMast = 2
	gateOpen = 6.6300
	tieE = 6.0000
	loadKg = 950
	hoName = "KRD-950 ローターデッキ 3スパン"
endif
if hoModel = "KRD950-7.2" then
	cageL = 6.2400
	cageD = 1.0700
	postSp = 6.6700
	nMast = 2
	gateOpen = 6.6300
	tieE = 6.0000
	loadKg = 950
	hoName = "KRD-950 ローターデッキ 4スパン"
endif
if hoModel = "NSE800" then
	cageL = 3.0200
	cageD = 1.1900
	postSp = 3.0200
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 800
	hoName = "サンラック NSE-800 ロングスパン"
endif
if hoModel = "HCE990GL" then
	cageL = 4.1600
	cageD = 1.2550
	postSp = 5.2190
	nMast = 1
	gateOpen = 3.9300
	tieE = 9.0000
	loadKg = 990
	hoName = "HCE990GL 工事用エレベーター"
endif
if hoModel = "SL-240B" then
	cageL = 1.2800
	cageD = 0.8000
	postSp = 0.0000
	nMast = 1
	gateOpen = 0.0000
	tieE = 3.0000
	loadKg = 240
	hoName = "SL-240B 荷揚げ機"
endif
if tieE < 1 then tieE = 3.6
! 乗り込む作業床の高さ（m）
dim landH[40]
nLand = 0
rest = landList
while strlen(rest) > 0 and nLand < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nLand = nLand + 1
		landH[nLand] = v
	endif
endwhile
! マストの位置（ロングスパンは荷台の両端、それ以外は荷台の外側に1本）
yC0 = -gapOut
yC1 = -gapOut - cageD
dim mx[2]
dim my[2]
if nMast = 2 then
	mx[1] = -postSp / 2
	mx[2] = postSp / 2
	my[1] = (yC0 + yC1) / 2
	my[2] = (yC0 + yC1) / 2
else
	mx[1] = 0
	my[1] = yC1 - 0.25
endif
! フロアーゲートの幅（荷台の長さとゲートの有効開口の小さい方）
gW = cageL
if gateOpen > 0.01 then gW = min(cageL, gateOpen)
! 地上の昇降路の囲い（荷台から 0.3 離す。マストの外まで）
fX = cageL / 2 + 0.3
fY = yC1 - 0.3
for im = 1 to nMast
	fX = max(fX, abs(mx[im]) + 0.4)
	fY = min(fY, my[im] - 0.4)
next im
! 乗り込み口（足場の手すりを外したスパン）。フロアーゲート・開閉式手すりはこの幅いっぱいに付けて開口を残さない
gA = -gW / 2
gB = gW / 2
if gateB - gateA > 0.1 then
	gA = gateA
	gB = gateB
endif

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 昇降機 2D（平面）: マスト・荷台の外形・頭上覆い（×）・フロアーゲート（太線）・機種名
define style "hoTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
pE = penEquip
if pE < 1 then pE = 1
pen pE
rot2 faceAng
! 荷台
rect2 -cageL / 2, yC1, cageL / 2, yC0
line2 -cageL / 2, yC1, cageL / 2, yC0
line2 -cageL / 2, yC0, cageL / 2, yC1
! マスト
for im = 1 to nMast
	rect2 mx[im] - 0.10, my[im] - 0.10, mx[im] + 0.10, my[im] + 0.10
	line2 mx[im] - 0.10, my[im] - 0.10, mx[im] + 0.10, my[im] + 0.10
next im
! フロアーゲート（機種に無ければ開閉式手すり）。足場の外側建地の列の外、乗り込み口の幅いっぱい
if showGate and nLand > 0 then
	rect2 gA, -0.06, gB, -0.02
endif
! 地上の昇降路の囲い（破線。足場側を除く3方）
if showFence then
	line_type "Dashed"
	line2 -fX, yC0, -fX, fY
	line2 -fX, fY, fX, fY
	line2 fX, fY, fX, yC0
	line_type 1
endif
hotspot2 0, 0
hotspot2 -cageL / 2, yC1
hotspot2 cageL / 2, yC1
set style "hoTx"
tx = hoName
if loadKg > 0 then tx = tx + "（" + str(loadKg, 4, 0) + "kg）"
add2 0, yC1 - 0.45
aTx = SYMB_ROTANGLE + faceAng
aTx = aTx - 360 * int(aTx / 360)
if aTx < 0 then aTx = aTx + 360
if aTx > 90.001 and aTx < 270.001 then rot2 180
text2 0, 0, tx
del top

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 昇降機 3D: マスト（ベース・壁つなぎ）・荷台（床・手すり・頭上覆い）・各階のフロアーゲート
resol 8
if matCage > 0 then material matCage
rotz faceAng
mastH = max(hoReach + 1.5, 3)
for im = 1 to nMast
	! ベース
	add mx[im] - 0.40, my[im] - 0.40, 0
	block 0.80, 0.80, 0.12
	del 1
	! マスト（ラック付きの角形。150 角）
	add mx[im] - 0.075, my[im] - 0.075, 0.12
	block 0.15, 0.15, mastH - 0.12
	del 1
	! マストの壁つなぎ（足場の外側建地の列まで）。到達高さ（足場の天端）まで tieE ごと。数量（platforms: 到達高さ÷間隔）と
	! 同じ本数（マストの頂部まで描くと足場の天端より上に繋ぐ先の無い壁つなぎが1段出ていた）
	if showTie then
		zt = tieE
		while zt < hoReach + 0.001 do
			add mx[im], my[im] + 0.075, zt
			rotx -90
			cylind max(0.05, -(my[im] + 0.075)), 0.0243
			del 2
			zt = zt + tieE
		endwhile
	endif
next im
! 荷台（いちばん下に止めた形）: 床・外側と両端の手すり（0.75・1.15）・頭上覆い
zF = 0.30
add -cageL / 2, yC1, zF
block cageL, cageD, 0.06
del 1
for hr = 1 to 2
	zr = zF + 0.35 + 0.40 * hr
	add -cageL / 2, yC1 + 0.03, zr
	roty 90
	cylind cageL, 0.0243
	del 2
	for se = 0 to 1
		add -cageL / 2 + se * cageL, yC1, zr
		rotx -90
		cylind cageD, 0.0243
		del 2
	next se
next hr
for cx = 0 to 1
	for cy = 0 to 1
		add -cageL / 2 + cx * cageL, yC1 + cy * cageD, zF
		cylind 2.1, 0.0243
		del 1
	next cy
next cx
add -cageL / 2, yC1, zF + 2.1
block cageL, cageD, 0.03
del 1
! フロアーゲート（各階の乗り込み口。単管 φ48.6 の扉: 手すり 0.9・中桟 0.45・両端の縦）。機種にフロアーゲートが
! 無ければ開閉式手すり（同じ高さの枠）。足場の線の部品は乗り込み口の固定の手すりを外すだけで、ここが防護を描く
if showGate then
	for il = 1 to nLand
		for hr = 1 to 2
			add gA, -0.04, landH[il] + 0.45 * hr
			roty 90
			cylind gB - gA, 0.0243
			del 2
		next hr
		for se = 0 to 1
			add gA + se * (gB - gA), -0.04, landH[il]
			cylind 1.0, 0.0243
			del 1
		next se
	next il
endif
! 地上の昇降路の囲い（足場側を除く3方。支柱・笠木・中桟・下桟。搬器の下への立入禁止）
if showFence then
	for ip = 1 to 3
		if ip = 1 then
			px0 = -fX
			py0 = yC0
			px1 = -fX
			py1 = fY
			fA = -90
		endif
		if ip = 2 then
			px0 = -fX
			py0 = fY
			px1 = fX
			py1 = fY
			fA = 0
		endif
		if ip = 3 then
			px0 = fX
			py0 = fY
			px1 = fX
			py1 = yC0
			fA = 90
		endif
		fLen = sqr((px1 - px0) ^ 2 + (py1 - py0) ^ 2)
		nP = max(1, int(fLen / 1.8 + 0.99))
		for k = 0 to nP
			add px0 + (px1 - px0) * k / nP, py0 + (py1 - py0) * k / nP, 0
			cylind 1.8, 0.0243
			del 1
		next k
		for hr = 1 to 3
			add px0, py0, 0.1 + 0.85 * (hr - 1)
			rotz fA
			roty 90
			cylind fLen, 0.0243
			del 3
		next hr
	next ip
endif
! 渡し板（各階の乗り込み口で足場の作業床から荷台までのすき間を塞ぐ。足場の外側建地の列から荷台の足場側の端の先 0.15 まで）
for il = 1 to nLand
	add -gW / 2, yC0 - 0.15, landH[il] + 0.02
	block gW, gapOut + 0.15, 0.03
	del 1
next il
del top

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
values "hoModel" "KSE600C", "KSE600L", "KSE900-3.6", "KSE900-5.4", "KSE900-7.2", "KSE900-3-3.6",
	"KSE900-3-5.4", "KSE-990", "HSL-900C2-3.6", "HSL-900C2-4.5", "HSL-900C2-5.4", "HSL-900C2-6.3",
	"HSL-900C2-7.2", "HSL-900C3-5.4", "HSL-900C3-7.2", "HSL-900B-5.4", "HSL-900B-7.2", "HSL950L2",
	"HSL990L2", "KRD800-5.4", "KRD800-7.2", "KRD950-5.4", "KRD950-7.2", "NSE800",
	"HCE990GL", "SL-240B"

