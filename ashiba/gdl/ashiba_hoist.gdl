	cageL = 3.8700
	cageD = 1.2480
	postSp = 3.9900
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "HSL-900CⅡ 4.5m ロングスパン（ジャバラ手すり）"
	hoKind = 1
