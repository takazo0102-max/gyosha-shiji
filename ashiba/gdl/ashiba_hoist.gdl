	cageD = 1.1500
	postSp = 6.6000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE-900 7.2m 型 ロングスパン"
	hoKind = 1
	roofMode = 1
endif
if hoModel = "KSE900-3-3.6" then
	cageL = 3.0000
	cageD = 0.6800
	postSp = 3.0000
	nMast = 2
	gateOpen = 3.9300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE900-3 3.6m 型 ロングスパン（細幅）"
	hoKind = 1
	roofMode = 1
endif
if hoModel = "KSE900-3-5.4" then
	cageL = 4.8000
	cageD = 0.6800
	postSp = 4.8000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
	loadKg = 900
	hoName = "KSE900-3 5.4m 型 ロングスパン（細幅）"
	hoKind = 1
	roofMode = 1
endif
if hoModel = "KSE-990" then
	cageL = 4.8000
	cageD = 1.0300
	postSp = 4.8000
	nMast = 2
	gateOpen = 6.6300
	tieE = 3.6000
