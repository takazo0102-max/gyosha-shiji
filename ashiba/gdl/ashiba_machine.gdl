! ==========================================================
! 重機（バックホウ・クローラクレーン・ポンプ車・生コン車・ダンプ・高所作業車。1台に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_machine/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_machine.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-11-01）: 重機の詳細度もっとあげて　種類も増やして。
! 原点＝旋回中心の地盤（生コン車・ダンプは車体の真ん中）、+X＝車体の前。mcKind で種類、slew で上部・ブームを回す。履帯・上部旋回体・くの字のブームとバケット・ラチスブーム・トラックの運転室とタイヤ・ポンプ車の折り曲げブーム・ドラム・荷台・伸縮ブームとバスケットを描く。機種と寸法は machine.py、置くのは scripts/machine_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   mcKind    整数      種類（1 バックホウ・2 クローラクレーン・3 ポンプ車・4 生コン車・5 ダンプ・6 高所作業車・7 垂直昇降・8 三点式杭打機・9 アースドリル・10 全周回転機・11 解体機・12 圧入機）  既定 1
!   mcModel   整数      機種（選ぶと寸法を書き込む。0＝手入力）                                                                                                                                    既定 3
!   mcName    文字列    機種の名前（平面の注記）                                                                                                                                                   既定 "バックホウ 0.45m³"
!   mcNote    文字列    諸元の注記                                                                                                                                                                 既定 ""
!   slew      角度      旋回角（車体の前から左回り）                                                                                                                                               既定 0.0
!   cbS       整数      運転室の側（1＝左・-1＝右）                                                                                                                                                既定 1
!   trkL      長さ      履帯の全長                                                                                                                                                                 既定 4.45
!   trkW      長さ      履帯の全幅                                                                                                                                                                 既定 2.8
!   shoeW     長さ      シュー幅                                                                                                                                                                   既定 0.6
!   trkH      長さ      履帯の高さ                                                                                                                                                                 既定 0.85
!   upF       長さ      上部旋回体の前端（旋回中心から）                                                                                                                                           既定 1.6
!   upW       長さ      上部旋回体の幅                                                                                                                                                             既定 2.7
!   tailR     長さ      後端旋回半径                                                                                                                                                               既定 2.75
!   upZ       長さ      上部旋回体の下端の高さ                                                                                                                                                     既定 1.0
!   upH       長さ      運転室の上の高さ（全高）                                                                                                                                                   既定 2.95
!   cabW      長さ      運転室の幅                                                                                                                                                                 既定 0.95
!   cabL      長さ      運転室の長さ                                                                                                                                                               既定 1.6
!   pvX       長さ      ブームの根元（旋回中心から前）                                                                                                                                             既定 0.15
!   pvH       長さ      ブームの根元の高さ                                                                                                                                                         既定 1.75
!   boomL     長さ      ブームの長さ（根元から先の弦）                                                                                                                                             既定 5.7
!   armL      長さ      アームの長さ                                                                                                                                                               既定 2.9
!   bkL       長さ      バケットの長さ（ピンから爪）                                                                                                                                               既定 1.45
!   bkW       長さ      バケットの幅                                                                                                                                                               既定 1.05
!   bmY       長さ      作業機の中心のずれ（旋回中心から左が +）                                                                                                                                   既定 0.0
!   bmA       角度      ブームの角度（弦）                                                                                                                                                         既定 35.0
!   amA       角度      アームの角度（水平から）                                                                                                                                                   既定 -70.0
!   bkA       角度      バケットの角度（水平から）                                                                                                                                                 既定 -150.0
!   maxR      長さ      最大作業半径（平面の円）                                                                                                                                                   既定 9.9
!   maxD      長さ      最大掘削深さ                                                                                                                                                               既定 6.6
!   bldW      長さ      排土板の幅（0＝無し）                                                                                                                                                      既定 0.0
!   bldH      長さ      排土板の高さ                                                                                                                                                               既定 0.45
!   lbL       長さ      ラチスブームの長さ                                                                                                                                                         既定 30.0
!   lbA       角度      ブームの起伏角                                                                                                                                                             既定 70.0
!   lbW       長さ      ブームの幅                                                                                                                                                                 既定 1.2
!   hkD       長さ      ブームの先からフックまで                                                                                                                                                   既定 6.0
!   hkH       長さ      フックの全高                                                                                                                                                               既定 1.47
!   hkW       長さ      フックの幅                                                                                                                                                                 既定 0.59
!   hkT       長さ      フックの厚み                                                                                                                                                               既定 0.435
!   gnX       長さ      ガントリ頂部（旋回中心から後ろ）                                                                                                                                           既定 3.16
!   gnH       長さ      ガントリ頂部の高さ                                                                                                                                                         既定 6.145
!   cwW       長さ      カウンタウエイトの幅（0＝上部旋回体と同じ）                                                                                                                                既定 0.0
!   cwH       長さ      カウンタウエイトの高さ（0＝上に載る薄い形）                                                                                                                                既定 0.0
!   carL      長さ      全長                                                                                                                                                                       既定 8.0
!   carW      長さ      全幅                                                                                                                                                                       既定 2.49
!   carF      長さ      原点から前端                                                                                                                                                               既定 4.0
!   cabH      長さ      運転室の上の高さ                                                                                                                                                           既定 3.0
!   frOv      長さ      前端から前の車軸                                                                                                                                                           既定 1.3
!   wb        長さ      前の車軸から後ろの車軸（1軸め）                                                                                                                                            既定 4.0
!   nFr       整数      前の車軸の数                                                                                                                                                               既定 1
!   frSp      長さ      前の車軸の間                                                                                                                                                               既定 1.7
!   nRear     整数      後ろの車軸の数                                                                                                                                                             既定 2
!   rearSp    長さ      後ろの車軸の間                                                                                                                                                             既定 1.3
!   whR       長さ      タイヤの半径                                                                                                                                                               既定 0.5
!   frZ       長さ      フレームの上の高さ                                                                                                                                                         既定 1.0
!   nSec      整数      ブームの段の数                                                                                                                                                             既定 4
!   sL1       長さ      ブーム1段の長さ                                                                                                                                                            既定 7.5
!   sL2       長さ      ブーム2段の長さ                                                                                                                                                            既定 6.5
!   sL3       長さ      ブーム3段の長さ                                                                                                                                                            既定 6.5
!   sL4       長さ      ブーム4段の長さ                                                                                                                                                            既定 6.0
!   sL5       長さ      ブーム5段の長さ                                                                                                                                                            既定 0.0
!   pA1       角度      ブーム1段の角度                                                                                                                                                            既定 70.0
!   pA2       角度      ブーム2段の角度                                                                                                                                                            既定 25.0
!   pA3       角度      ブーム3段の角度                                                                                                                                                            既定 -10.0
!   pA4       角度      ブーム4段の角度                                                                                                                                                            既定 -60.0
!   pA5       角度      ブーム5段の角度                                                                                                                                                            既定 -80.0
!   tuH       長さ      ブームの根元の高さ                                                                                                                                                         既定 3.2
!   o1x       長さ      アウトリガ1組め（原点から前が +）                                                                                                                                          既定 1.4
!   o1y       長さ      アウトリガ1組めの張出スパン                                                                                                                                                既定 5.43
!   o2x       長さ      アウトリガ2組め                                                                                                                                                            既定 -2.0
!   o2y       長さ      アウトリガ2組めの張出スパン                                                                                                                                                既定 5.43
!   o3x       長さ      アウトリガ3組め                                                                                                                                                            既定 -4.6
!   o3y       長さ      アウトリガ3組めの張出スパン（0＝無し）                                                                                                                                     既定 2.3
!   otOn      ブール    アウトリガを張る                                                                                                                                                           既定 1
!   drL       長さ      ドラムの長さ                                                                                                                                                               既定 4.3
!   drD       長さ      ドラムの径                                                                                                                                                                 既定 2.1
!   drA       角度      ドラムの傾き                                                                                                                                                               既定 14.0
!   bedL      長さ      荷台の長さ                                                                                                                                                                 既定 5.1
!   bedW      長さ      荷台の幅                                                                                                                                                                   既定 2.25
!   bedH      長さ      あおりの高さ                                                                                                                                                               既定 0.6
!   bedA      角度      荷台の上げ角                                                                                                                                                               既定 0.0
!   abL       長さ      伸縮ブームの長さ（今）                                                                                                                                                     既定 9.0
!   abA       角度      伸縮ブームの起伏角                                                                                                                                                         既定 55.0
!   pfL       長さ      バスケットの長さ                                                                                                                                                           既定 1.2
!   pfW       長さ      バスケットの幅                                                                                                                                                             既定 0.7
!   pfH       長さ      作業床の高さ（垂直昇降）                                                                                                                                                   既定 3.0
!   atK       整数      アタッチメント（0 バケット・1 圧砕機・2 鉄骨切断機・3 つかみ機・4 ブレーカ）                                                                                               既定 0
!   atL       長さ      アタッチメントの本体長さ（ピンから先端）                                                                                                                                   既定 2.0
!   atW       長さ      アタッチメントの最大開口幅（ブレーカはチゼル径）                                                                                                                           既定 1.0
!   atO       角度      爪の開き                                                                                                                                                                   既定 50.0
!   ldX       長さ      リーダの中心（旋回中心から前）                                                                                                                                             既定 3.0
!   ldL       長さ      リーダの長さ                                                                                                                                                               既定 33.0
!   ldDia     長さ      リーダの主管の径                                                                                                                                                           既定 0.66
!   ldZ       長さ      リーダの下端の高さ                                                                                                                                                         既定 0.35
!   stZ       長さ      ステーの上端の高さ                                                                                                                                                         既定 26.75
!   auOff     長さ      オーガの中心（リーダから前）                                                                                                                                               既定 1.24
!   auD       長さ      オーガの径（アースドリルはバケットの径）                                                                                                                                   既定 0.6
!   auL       長さ      スクリューの長さ                                                                                                                                                           既定 28.8
!   auZ       長さ      オーガのモータの下端の高さ                                                                                                                                                 既定 30.25
!   auN       整数      オーガの本数（SMW は 3）                                                                                                                                                   既定 1
!   auP       長さ      オーガの軸間                                                                                                                                                               既定 0.45
!   auH       長さ      モータの高さ                                                                                                                                                               既定 2.6
!   auW       長さ      モータの前後の長さ                                                                                                                                                         既定 1.2
!   fjX       長さ      フロントジャッキ（旋回中心から前）                                                                                                                                         既定 3.61
!   fjW       長さ      フロントジャッキの間                                                                                                                                                       既定 2.52
!   rjX       長さ      後ろのアウトリガ（旋回中心から後ろ）                                                                                                                                       既定 3.64
!   rjW       長さ      後ろのアウトリガの幅                                                                                                                                                       既定 4.1
!   tbL       長さ      テレスコブームの長さ                                                                                                                                                       既定 20.6
!   tbA       角度      テレスコブームの起伏角                                                                                                                                                     既定 82.5
!   kdR       長さ      掘削中心（旋回中心から前）                                                                                                                                                 既定 4.492
!   kdZ       長さ      ケリードライブの高さ                                                                                                                                                       既定 1.5
!   kyD       長さ      ケリーバの径                                                                                                                                                               既定 0.53
!   bkH       長さ      ドリリングバケットの高さ                                                                                                                                                   既定 2.089
!   bkD       長さ      バケットの下端の深さ（地面から下）                                                                                                                                         既定 0.0
!   rtL       長さ      本体の長さ                                                                                                                                                                 既定 4.148
!   rtW       長さ      本体の幅                                                                                                                                                                   既定 3.167
!   rtH       長さ      本体の高さ（手すりの上）                                                                                                                                                   既定 3.086
!   rtD       長さ      本体の通り穴の径                                                                                                                                                           既定 1.98
!   rtS       長さ      チャックの上がり（押抜ストローク）                                                                                                                                         既定 0.0
!   brL       長さ      反力ブラケットを含む長さ                                                                                                                                                   既定 8.39
!   brW       長さ      反力ブラケットを含む幅                                                                                                                                                     既定 6.98
!   csD       長さ      ケーシングの径                                                                                                                                                             既定 1.5
!   csH       長さ      ケーシングの本体の上の高さ                                                                                                                                                 既定 2.0
!   puX       長さ      油圧ユニット・パワーユニットの芯（前が +）                                                                                                                                 既定 -7.5
!   puY       長さ      油圧ユニット・パワーユニットの芯（左が +）                                                                                                                                 既定 0.0
!   puL       長さ      ユニットの長さ                                                                                                                                                             既定 4.8
!   puW       長さ      ユニットの幅                                                                                                                                                               既定 2.105
!   puH       長さ      ユニットの高さ                                                                                                                                                             既定 2.112
!   dbL1      長さ      メインブーム（＋インサート）                                                                                                                                               既定 6.0
!   dbL2      長さ      フロントブーム（＋インター）                                                                                                                                               既定 8.35
!   dbL3      長さ      アーム                                                                                                                                                                     既定 8.7
!   dA1       角度      メインブームの角度                                                                                                                                                         既定 65.0
!   dA2       角度      フロントブームの角度                                                                                                                                                       既定 85.0
!   dA3       角度      アームの角度                                                                                                                                                               既定 -30.0
!   piL       長さ      圧入機の全長                                                                                                                                                               既定 2.07
!   piW       長さ      圧入機の全幅                                                                                                                                                               既定 1.0
!   piH       長さ      圧入機の全高                                                                                                                                                               既定 2.32
!   piC       長さ      チャック投入高                                                                                                                                                             既定 0.955
!   piS       長さ      チャックの上がり                                                                                                                                                           既定 0.0
!   piP       長さ      鋼矢板の幅                                                                                                                                                                 既定 0.4
!   piN       整数      後ろの完成杭の枚数                                                                                                                                                         既定 4
!   piT       長さ      チャックの杭の天端（チャックの上）                                                                                                                                         既定 3.0
!   vbK       整数      フックの先（0 フック・1 バイブロ）                                                                                                                                         既定 0
!   vbW       長さ      バイブロの幅                                                                                                                                                               既定 1.337
!   vbT       長さ      バイブロの厚み                                                                                                                                                             既定 0.722
!   vbH       長さ      バイブロの全高（チャック込み）                                                                                                                                             既定 3.479
!   vbP       長さ      バイブロの杭の長さ                                                                                                                                                         既定 12.0
!   texSiz    実数      文字の大きさ（mm）                                                                                                                                                         既定 2.5
!   penEquip  PenColor  線のペン                                                                                                                                                                   既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 重機: 種類ごとの形（m・度）
isCr = (mcKind <= 2 or mcKind = 8 or mcKind = 9 or mcKind = 11)
isTk = (mcKind >= 3 and mcKind <= 7)
! 上部旋回体の後ろの円弧（後端旋回半径）と幅の合う所
w2 = min(upW / 2, tailR * 0.995)
xs = -sqr(tailR ^ 2 - w2 ^ 2)
aS = asn(w2 / tailR)
! カウンタウエイトの幅（クレーンは上部旋回体より広い）
w2c = min(max(cwW, upW) / 2, tailR * 0.995)
xsc = -sqr(tailR ^ 2 - w2c ^ 2)
aSc = asn(w2c / tailR)
! トラック: 前端・後端・車軸（後ろの車軸は1軸めから rearSp ずつ後ろ）
xF = carF
xR = carF - carL
axF = xF - frOv
axR1 = axF - wb
axR2 = axR1 - rearSp * (nRear >= 2)
! 車軸の位置（前 nFr 本・後ろ nRear 本）
dim axs[4]
nAx = 0
for i = 1 to max(1, min(2, nFr))
	nAx = nAx + 1
	axs[nAx] = axF - (i - 1) * frSp
next i
for i = 1 to max(1, min(2, nRear))
	nAx = nAx + 1
	axs[nAx] = axR1 - (i - 1) * rearSp
next i
! アウトリガの組（x と片側の張出）
dim ox[3], oy[3]
ox[1] = o1x
ox[2] = o2x
ox[3] = o3x
oy[1] = o1y / 2
oy[2] = o2y / 2
oy[3] = o3y / 2
nJk = 2 + (o3y > 0.01)
whW = 0.32 + 0.12 * (carW > 2.2)
! バックホウ: ブームの先（弦）・くの字の折れ・アームの先・バケットのピン
bmX1 = pvX + boomL * cos(bmA)
bmZ1 = pvH + boomL * sin(bmA)
knX = pvX + 0.55 * boomL * cos(bmA) - 0.13 * boomL * sin(bmA)
knZ = pvH + 0.55 * boomL * sin(bmA) + 0.13 * boomL * cos(bmA)
amX1 = bmX1 + armL * cos(amA)
amZ1 = bmZ1 + armL * sin(amA)
amX0 = bmX1 - 0.2 * armL * cos(amA)
amZ0 = bmZ1 - 0.2 * armL * sin(amA)
! ポンプ車のブームの段（長さと角度）
dim sl[5], sa[5]
sl[1] = sL1
sl[2] = sL2
sl[3] = sL3
sl[4] = sL4
sl[5] = sL5
sa[1] = pA1
sa[2] = pA2
sa[3] = pA3
sa[4] = pA4
sa[5] = pA5
nSc = max(1, min(5, nSec))
pmX = 0
pmZ = tuH
for i = 1 to nSc
	pmX = pmX + sl[i] * cos(sa[i])
	pmZ = pmZ + sl[i] * sin(sa[i])
next i
! 高所作業車のブームの先
abX = -0.4 + abL * cos(abA)
abZ = tuH + abL * sin(abA)
! クローラクレーンのブームの先
lbX = pvX + lbL * cos(lbA)
lbZ = pvH + lbL * sin(lbA)
! アースドリルのテレスコブームの先
tbX = pvX + tbL * cos(tbA)
tbZ = pvH + tbL * sin(tbA)
! 解体機のフロント（3段の関節とアームの先）
dmX1 = pvX + dbL1 * cos(dA1)
dmZ1 = pvH + dbL1 * sin(dA1)
dmX2 = dmX1 + dbL2 * cos(dA2)
dmZ2 = dmZ1 + dbL2 * sin(dA2)
dmX3 = dmX2 + dbL3 * cos(dA3)
dmZ3 = dmZ2 + dbL3 * sin(dA3)
! 先の長さ（バケットかアタッチメント）
tpL = bkL
if atK > 0 then tpL = atL
! 杭打機のオーガ（本数と1本めの y）
nAu = max(1, min(3, auN))
yAu0 = -(nAu - 1) * auP / 2
! 全周回転機のデッキの高さ（本体の高さから手すり 0.969 下）
zDk = max(0.5, rtH - 0.969)

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 重機 2D: 外形・上部の外形（旋回）・後端旋回半径（立入禁止）・作業半径・アウトリガ・注記
pen penEquip
define style "mcT" "ＭＳ Ｐゴシック", texSiz, 1, 0
style "mcT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
if isCr then
	! 履帯（2本）と上部旋回体（旋回で回す）
	for s = -1 to 1 step 2
		yc = s * (trkW / 2 - shoeW / 2)
		rect2 -trkL / 2, yc - shoeW / 2, trkL / 2, yc + shoeW / 2
	next s
	circle2 0, 0, tailR
	rot2 slew
	! 外形は円弧と線で（put と poly2 の多角形は平面を止めた）
	arc2 0, 0, tailR, 180 - aS, 180 + aS
	line2 xs, w2, upF, w2
	line2 upF, w2, upF, -w2
	line2 upF, -w2, xs, -w2
	if mcKind = 1 and bldW > 0.1 then
		del 1
		rect2 trkL / 2 + 0.25, -bldW / 2, trkL / 2 + 0.25 + 0.12, bldW / 2
		rot2 slew
	endif
	if mcKind = 1 then
		line2 pvX, bmY - 0.25, amX1, bmY - 0.15
		line2 pvX, bmY + 0.25, amX1, bmY + 0.15
		if atK > 0 then
			wA = max(0.3, min(atW, 1.2))
			rect2 amX1, bmY - wA / 2, amX1 + atL * max(0.2, cos(bkA)), bmY + wA / 2
		else
			rect2 amX1 - 0.1, bmY - bkW / 2, amX1 + 0.35, bmY + bkW / 2
		endif
	endif
	if mcKind = 2 then
		line2 pvX, -lbW / 2, lbX, -lbW / 2
		line2 pvX, lbW / 2, lbX, lbW / 2
		circle2 lbX, 0, 0.4
		if vbK = 1 then rect2 lbX + 0.4 - vbW / 2, -vbT / 2, lbX + 0.4 + vbW / 2, vbT / 2
	endif
	if mcKind = 8 then
		! リーダ・リーダブラケット・オーガ・ステー・ジャッキ
		circle2 ldX, 0, ldDia / 2
		rect2 upF - 0.1, -0.6, ldX, 0.6
		for i = 1 to nAu
			circle2 ldX + auOff, yAu0 + (i - 1) * auP, auD / 2
		next i
		rect2 ldX + auOff - auW / 2, yAu0 - auD / 2 - 0.1, ldX + auOff + auW / 2, -yAu0 + auD / 2 + 0.1
		for s = -1 to 1 step 2
			line2 -tailR * 0.35, s * upW * 0.35, ldX, s * ldDia * 0.3
			rect2 fjX - 0.3, s * fjW / 2 - 0.3, fjX + 0.3, s * fjW / 2 + 0.3
			rect2 -rjX - 0.3, s * rjW / 2 - 0.3, -rjX + 0.3, s * rjW / 2 + 0.3
			line2 -rjX, 0, -rjX, s * rjW / 2
		next s
	endif
	if mcKind = 9 then
		! テレスコブーム・ケリードライブ・バケット（掘削中心）
		line2 pvX, -0.45, tbX, -0.45
		line2 pvX, 0.45, tbX, 0.45
		rect2 kdR - 0.9, -0.9, kdR + 0.9, 0.9
		circle2 kdR, 0, auD / 2
		line2 kdR - auD / 2 - 0.3, 0, kdR + auD / 2 + 0.3, 0
		line2 kdR, -auD / 2 - 0.3, kdR, auD / 2 + 0.3
	endif
	if mcKind = 11 then
		! フロント（3段）と先のアタッチメント
		line2 pvX, -0.35, max(dmX1, dmX3), -0.3
		line2 pvX, 0.35, max(dmX1, dmX3), 0.3
		wA = max(0.3, min(atW, 1.2))
		if atK = 0 then wA = bkW
		rect2 dmX3, -wA / 2, dmX3 + tpL * max(0.2, abs(cos(bkA))), wA / 2
	endif
	del 1
endif
if mcKind = 10 then
	! 全周回転機: 反力ブラケット・本体・通り穴・ケーシング・水平ジャッキ・油圧ユニット
	rect2 -brL / 2, -0.3, brL / 2, 0.3
	rect2 -0.3, -brW / 2, 0.3, brW / 2
	rect2 -rtL / 2, -rtW / 2, rtL / 2, rtW / 2
	circle2 0, 0, rtD / 2
	circle2 0, 0, csD / 2
	for s = -1 to 1 step 2
		for t = -1 to 1 step 2
			circle2 s * (rtL / 2 - 0.35), t * (rtW / 2 - 0.35), 0.25
		next t
	next s
	rect2 puX - puL / 2, puY - puW / 2, puX + puL / 2, puY + puW / 2
endif
if mcKind = 12 then
	! 圧入機: 本体・チャックの杭・後ろの完成杭（つかむ反力杭）・パワーユニット
	rect2 -piL + 0.35, -piW / 2, 0.35, piW / 2
	for i = 0 to piN
		xP = -i * piP
		line2 xP - piP / 2, 0, xP - piP / 4, (1 - 2 * (i mod 2)) * 0.15
		line2 xP - piP / 4, (1 - 2 * (i mod 2)) * 0.15, xP + piP / 4, (1 - 2 * (i mod 2)) * 0.15
		line2 xP + piP / 4, (1 - 2 * (i mod 2)) * 0.15, xP + piP / 2, 0
	next i
	rect2 puX - puL / 2, puY - puW / 2, puX + puL / 2, puY + puW / 2
endif
if isTk then
	! 車体・運転室・タイヤ
	rect2 xR, -carW / 2, xF, carW / 2
	if mcKind < 7 then line2 xF - min(2.3, carL * 0.28), -carW / 2, xF - min(2.3, carL * 0.28), carW / 2
	for i = 1 to nAx
		for s = -1 to 1 step 2
			rect2 axs[i] - whR, s * carW / 2 - s * 0.05, axs[i] + whR, s * carW / 2 - s * (0.05 + whW)
		next s
	next i
	if (mcKind = 3 or mcKind = 6) and otOn then
		for j = 1 to 3
			if oy[j] > 0.01 then
				for s = -1 to 1 step 2
					line2 ox[j], s * 0.3, ox[j], s * oy[j]
					rect2 ox[j] - 0.3, s * oy[j] - 0.3, ox[j] + 0.3, s * oy[j] + 0.3
				next s
			endif
		next j
	endif
	if mcKind = 7 then rect2 -pfL / 2, -pfW / 2, pfL / 2, pfW / 2
	if mcKind = 3 then
		circle2 0, 0, 0.6
		rot2 slew
		line2 0, -0.2, pmX, -0.15
		line2 0, 0.2, pmX, 0.15
		circle2 pmX, 0, 0.15
		del 1
	endif
	if mcKind = 6 then
		circle2 0, 0, 0.5
		rot2 slew
		line2 -0.4, -0.2, abX, -0.2
		line2 -0.4, 0.2, abX, 0.2
		rect2 abX, -pfL / 2, abX + pfW, pfL / 2
		del 1
	endif
	if mcKind = 4 then
		rect2 xF - 2.2 - drL * cos(drA), -drD / 2, xF - 2.2, drD / 2
	endif
	if mcKind = 5 then
		rect2 xR + 0.1, -bedW / 2, xR + 0.1 + bedL * cos(bedA), bedW / 2
	endif
endif
! 作業半径（バックホウは最大掘削半径、クレーン・ポンプ車・高所作業車は最大作業半径）
rW = maxR
if mcKind = 2 then rW = lbX + 0.4
isR = (mcKind <= 3 or mcKind = 6 or mcKind = 11)
if rW > 0.1 and isR then circle2 0, 0, rW
! 注記（機種・諸元）
xN = -tailR - 0.6
if isTk then xN = xR - 0.6
if mcKind = 10 then xN = min(-brL / 2, puX - puL / 2) - 0.6
if mcKind = 12 then xN = min(-piL, puX - puL / 2) - 0.6
add2 xN, 0
rot2 -SYMB_ROTANGLE
text2 0, 0, mcName
if strlen(mcNote) > 0 then text2 0, -dT, mcNote
del 2
if rW > 0.1 and isR then
	add2 rW * cos(45), rW * sin(45)
	rot2 -SYMB_ROTANGLE
	text2 0, 0, "R" + str(round_int(rW * 1000), 1, 0)
	del 2
endif
! 旋回角のホットスポット
rH = max(2.0, tailR)
hotspot2 0, 0, 1, slew, 6
hotspot2 rH, 0, 2, slew, 4
hotspot2 rH * cos(slew), rH * sin(slew), 3, slew, 5
hotspot2 0, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 重機 3D
! 車体の色（バックホウ・解体機は黄、ほかは白。同じ名前の define material を2回書くと 3D が止まる）
cR = 0.95
cG = 0.72
cB = 0.08
if mcKind >= 2 and mcKind <> 11 then
	cR = 0.93
	cG = 0.94
	cB = 0.95
endif
define material "mc_body" 2, cR, cG, cB
define material "mc_dark" 2, 0.18, 0.18, 0.20
define material "mc_steel" 2, 0.55, 0.56, 0.58
define material "mc_cw" 2, 0.35, 0.36, 0.38
define material "mc_tire" 2, 0.10, 0.10, 0.10
define material "mc_rim" 2, 0.80, 0.80, 0.78
define material "mc_glass" 2, 0.30, 0.45, 0.60
define material "mc_rod" 2, 0.85, 0.86, 0.88
define material "mc_drum" 2, 0.92, 0.40, 0.12
define material "mc_bed" 2, 0.30, 0.52, 0.35
resol 12
if isCr then gosub "crawler"
if mcKind = 1 and bldW > 0.1 then gosub "blade"
if isTk and mcKind < 7 then gosub "truck"
if mcKind = 1 then
	rotz slew
	gosub "upper"
	add 0, bmY, 0
	gosub "backhoe"
	del 2
endif
if mcKind = 2 then
	rotz slew
	gosub "upper"
	gosub "lattice"
	del 1
endif
if mcKind = 3 then
	gosub "outrig"
	gosub "pumpbody"
	rotz slew
	gosub "pumpboom"
	del 1
endif
if mcKind = 4 then gosub "mixer"
if mcKind = 5 then gosub "dump"
if mcKind = 6 then
	gosub "outrig"
	rotz slew
	gosub "aerial"
	del 1
endif
if mcKind = 7 then gosub "scissor"
if mcKind = 8 then
	rotz slew
	gosub "upper"
	gosub "pileleader"
	del 1
endif
if mcKind = 9 then
	rotz slew
	gosub "upper"
	gosub "earthdrill"
	del 1
endif
if mcKind = 10 then gosub "rotator"
if mcKind = 11 then
	rotz slew
	gosub "upper"
	gosub "demolish"
	del 1
endif
if mcKind = 12 then gosub "piler"
gosub "hotspots"
end

"hotspots":
	! 動かせるホットスポット（利用者の指定 2026-11-03: 他の重機もホットスポットで動かせるように）。角度は 6＝中心・4＝基準（水平）・
	! 5＝動く点・7＝回る面の法線の点（側面の xz 面。−y）。長さは 1＝基点（+128 で見せない）・2＝動く点・3＝向きの基準
	if mcKind = 1 then
		rotz slew
		add 0, bmY, 0
		hotspot pvX, 0, pvH, 201, bmA, 6
		hotspot pvX + 1, 0, pvH, 202, bmA, 4
		hotspot bmX1, 0, bmZ1, 203, bmA, 5
		hotspot pvX, -1, pvH, 204, bmA, 7
		hotspot bmX1, 0, bmZ1, 205, amA, 6
		hotspot bmX1 + 1, 0, bmZ1, 206, amA, 4
		hotspot amX1, 0, amZ1, 207, amA, 5
		hotspot bmX1, -1, bmZ1, 208, amA, 7
		hotspot amX1, 0, amZ1, 209, bkA, 6
		hotspot amX1 + 1, 0, amZ1, 210, bkA, 4
		hotspot amX1 + tpL * cos(bkA), 0, amZ1 + tpL * sin(bkA), 211, bkA, 5
		hotspot amX1, -1, amZ1, 212, bkA, 7
		del 2
	endif
	if mcKind = 2 then
		rotz slew
		hotspot pvX, 0, pvH, 221, lbA, 6
		hotspot pvX + 1, 0, pvH, 222, lbA, 4
		hotspot lbX, 0, lbZ, 223, lbA, 5
		hotspot pvX, -1, pvH, 224, lbA, 7
		hotspot lbX + 0.4, 0, lbZ, 225, hkD, 1 + 128
		hotspot lbX + 0.4, 0, lbZ - hkD, 226, hkD, 2
		hotspot lbX + 0.4, 0, lbZ + 1, 227, hkD, 3
		del 1
	endif
	if mcKind = 3 then
		! ポンプ車のブームの段ごとの角度（水平から）。段の根元が中心
		rotz slew
		hx = 0
		hz = tuH
		for i = 1 to nSc
			qx = hx + sl[i] * cos(sa[i])
			qz = hz + sl[i] * sin(sa[i])
			hid = 230 + 4 * i
			if i = 1 then hotspot hx, 0, hz, hid, pA1, 6
			if i = 2 then hotspot hx, 0, hz, hid, pA2, 6
			if i = 3 then hotspot hx, 0, hz, hid, pA3, 6
			if i = 4 then hotspot hx, 0, hz, hid, pA4, 6
			if i = 5 then hotspot hx, 0, hz, hid, pA5, 6
			if i = 1 then hotspot hx + 1, 0, hz, hid + 1, pA1, 4
			if i = 2 then hotspot hx + 1, 0, hz, hid + 1, pA2, 4
			if i = 3 then hotspot hx + 1, 0, hz, hid + 1, pA3, 4
			if i = 4 then hotspot hx + 1, 0, hz, hid + 1, pA4, 4
			if i = 5 then hotspot hx + 1, 0, hz, hid + 1, pA5, 4
			if i = 1 then hotspot qx, 0, qz, hid + 2, pA1, 5
			if i = 2 then hotspot qx, 0, qz, hid + 2, pA2, 5
			if i = 3 then hotspot qx, 0, qz, hid + 2, pA3, 5
			if i = 4 then hotspot qx, 0, qz, hid + 2, pA4, 5
			if i = 5 then hotspot qx, 0, qz, hid + 2, pA5, 5
			if i = 1 then hotspot hx, -1, hz, hid + 3, pA1, 7
			if i = 2 then hotspot hx, -1, hz, hid + 3, pA2, 7
			if i = 3 then hotspot hx, -1, hz, hid + 3, pA3, 7
			if i = 4 then hotspot hx, -1, hz, hid + 3, pA4, 7
			if i = 5 then hotspot hx, -1, hz, hid + 3, pA5, 7
			hx = qx
			hz = qz
		next i
		del 1
	endif
	if mcKind = 5 then
		! ダンプの荷台の上げ角（後ろのヒンジが中心）
		hX = xR + 0.1
		hZ = frZ + 0.05
		hotspot hX, 0, hZ, 261, bedA, 6
		hotspot hX + 1, 0, hZ, 262, bedA, 4
		hotspot hX + bedL * cos(bedA), 0, hZ + bedL * sin(bedA), 263, bedA, 5
		hotspot hX, -1, hZ, 264, bedA, 7
	endif
	if mcKind = 6 then
		rotz slew
		hotspot -0.4, 0, tuH, 271, abA, 6
		hotspot 0.6, 0, tuH, 272, abA, 4
		hotspot abX, 0, abZ, 273, abA, 5
		hotspot -0.4, -1, tuH, 274, abA, 7
		hotspot -0.4, 0, tuH, 275, abL, 1 + 128
		hotspot abX, 0, abZ, 276, abL, 2
		hotspot -0.4 - cos(abA), 0, tuH - sin(abA), 277, abL, 3
		del 1
	endif
	if mcKind = 7 then
		hotspot 0, 0, 0, 281, pfH, 1 + 128
		hotspot 0, 0, pfH, 282, pfH, 2
		hotspot 0, 0, -1, 283, pfH, 3
	endif
	if mcKind = 8 then
		! オーガのモータの高さ（下げるとスクリューが地面に入る）とリーダの長さ
		rotz slew
		xA = ldX + auOff
		hotspot xA, 0, 0, 291, auZ, 1 + 128
		hotspot xA, 0, auZ, 292, auZ, 2
		hotspot xA, 0, -1, 293, auZ, 3
		hotspot ldX, 0, ldZ, 294, ldL, 1 + 128
		hotspot ldX, 0, ldZ + ldL, 295, ldL, 2
		hotspot ldX, 0, ldZ - 1, 296, ldL, 3
		del 1
	endif
	if mcKind = 9 then
		! テレスコブームの起伏と長さ、バケットの深さ（下へ）
		rotz slew
		hotspot pvX, 0, pvH, 301, tbA, 6
		hotspot pvX + 1, 0, pvH, 302, tbA, 4
		hotspot tbX, 0, tbZ, 303, tbA, 5
		hotspot pvX, -1, pvH, 304, tbA, 7
		hotspot pvX, 0, pvH, 305, tbL, 1 + 128
		hotspot tbX, 0, tbZ, 306, tbL, 2
		hotspot pvX - cos(tbA), 0, pvH - sin(tbA), 307, tbL, 3
		hotspot kdR, 0, 0, 308, bkD, 1 + 128
		hotspot kdR, 0, -bkD, 309, bkD, 2
		hotspot kdR, 0, 1, 310, bkD, 3
		del 1
	endif
	if mcKind = 10 then
		! チャックの上がりとケーシングの高さ
		hotspot rtL / 2, 0, zDk, 311, rtS, 1 + 128
		hotspot rtL / 2, 0, zDk + rtS, 312, rtS, 2
		hotspot rtL / 2, 0, zDk - 1, 313, rtS, 3
		hotspot 0, 0, rtH + rtS, 314, csH, 1 + 128
		hotspot 0, 0, rtH + rtS + csH, 315, csH, 2
		hotspot 0, 0, rtH + rtS - 1, 316, csH, 3
	endif
	if mcKind = 11 then
		! フロント3段と先の角度（関節が中心）
		rotz slew
		hotspot pvX, 0, pvH, 321, dA1, 6
		hotspot pvX + 1, 0, pvH, 322, dA1, 4
		hotspot dmX1, 0, dmZ1, 323, dA1, 5
		hotspot pvX, -1, pvH, 324, dA1, 7
		hotspot dmX1, 0, dmZ1, 325, dA2, 6
		hotspot dmX1 + 1, 0, dmZ1, 326, dA2, 4
		hotspot dmX2, 0, dmZ2, 327, dA2, 5
		hotspot dmX1, -1, dmZ1, 328, dA2, 7
		hotspot dmX2, 0, dmZ2, 329, dA3, 6
		hotspot dmX2 + 1, 0, dmZ2, 330, dA3, 4
		hotspot dmX3, 0, dmZ3, 331, dA3, 5
		hotspot dmX2, -1, dmZ2, 332, dA3, 7
		hotspot dmX3, 0, dmZ3, 333, bkA, 6
		hotspot dmX3 + 1, 0, dmZ3, 334, bkA, 4
		hotspot dmX3 + tpL * cos(bkA), 0, dmZ3 + tpL * sin(bkA), 335, bkA, 5
		hotspot dmX3, -1, dmZ3, 336, bkA, 7
		del 1
	endif
	if mcKind = 12 then
		! チャックの上がりと杭の天端
		hotspot 0.35, 0, piC, 341, piS, 1 + 128
		hotspot 0.35, 0, piC + piS, 342, piS, 2
		hotspot 0.35, 0, piC - 1, 343, piS, 3
		hotspot 0, 0, piC + piS, 344, piT, 1 + 128
		hotspot 0, 0, piC + piS + piT, 345, piT, 2
		hotspot 0, 0, piC + piS - 1, 346, piT, 3
	endif
return

"crawler":
	! 履帯（帯・両端の輪・グローサ・横のフレームと下転輪・遊動輪と起動輪）と下部の枠・旋回輪
	rT = trkH / 2
	for s = -1 to 1 step 2
		yc = s * (trkW / 2 - shoeW / 2)
		material "mc_dark"
		add -trkL / 2 + rT, yc - shoeW / 2, 0
		block trkL - 2 * rT, shoeW, trkH
		del 1
		for e = -1 to 1 step 2
			add e * (trkL / 2 - rT), yc + shoeW / 2, rT
			rotx 90
			cylind shoeW, rT
			del 2
		next e
		nG = int((trkL - 2 * rT) / 0.2)
		for k = 0 to nG
			add -trkL / 2 + rT + k * 0.2, yc - shoeW / 2, trkH
			block 0.05, shoeW, 0.03
			del 1
		next k
		! 外の面: 履帯のフレーム（板 0.02）と、その外に下転輪・遊動輪・起動輪（円柱は rotx 90 で -y へ伸びる）
		yP = yc + s * shoeW / 2 - (s < 0) * 0.02
		material "mc_body"
		add -trkL / 2 + rT, yP, trkH * 0.3
		block trkL - 2 * rT, 0.02, trkH * 0.4
		del 1
		yR = yP + (s > 0) * 0.05
		material "mc_steel"
		nRl = max(2, int((trkL - 2 * rT) / 0.45))
		for k = 0 to nRl
			add -trkL / 2 + rT + k * (trkL - 2 * rT) / nRl, yR, 0.13
			rotx 90
			cylind 0.03, 0.09
			del 2
		next k
		for e = -1 to 1 step 2
			add e * (trkL / 2 - rT), yR, rT
			rotx 90
			cylind 0.03, rT * 0.72
			del 2
		next e
	next s
	material "mc_body"
	lF = min(1.8, trkL * 0.55)
	add -lF / 2, -(trkW / 2 - shoeW), trkH * 0.35
	block lF, trkW - 2 * shoeW, trkH * 0.45
	del 1
	material "mc_steel"
	add 0, 0, trkH * 0.8
	cylind upZ - trkH * 0.8, min(0.85, upW * 0.3)
	del 1
	return

"blade":
	! 排土板（履帯の前。腕2本とシリンダ）
	material "mc_body"
	add trkL / 2 + 0.25, -bldW / 2, 0.02
	block 0.12, bldW, bldH
	del 1
	for s = -1 to 1 step 2
		x0q = trkL / 2 - 0.4
		z0q = trkH * 0.45
		x1q = trkL / 2 + 0.3
		z1q = bldH * 0.5
		bwq = 0.1
		bhq = 0.12
		add 0, s * bldW * 0.3, 0
		gosub "bar"
		del 1
	next s
	crq = 0.04
	cx0 = trkL / 2 - 0.25
	cy0 = 0
	cz0 = trkH * 0.7
	cx1 = trkL / 2 + 0.25
	cy1 = 0
	cz1 = bldH * 0.85
	gosub "cyl2"
	return

"upper":
	! 上部旋回体（後ろは後端旋回半径の円弧）・カウンタウエイト・エンジンカバー・運転室と窓・手すり
	hB = 0.12 * (upH - upZ) + 0.45
	material "mc_body"
	for i = 0 to 8
		aa = 180 + aS - i * aS / 4
		put tailR * cos(aa), tailR * sin(aa)
	next i
	put upF, w2, upF, -w2
	add 0, 0, upZ
	prism nsp / 2, hB, get(nsp)
	del 1
	! カウンタウエイト（cwH があれば下面 upZ から高さ cwH・幅 cwW、無ければ上に載る薄い形）
	xC = xsc + min(0.9, tailR * 0.35)
	zC0 = upZ + hB
	hC = 0.35
	if cwH > 0.01 then
		xC = xsc + 1.0
		zC0 = upZ
		hC = cwH
	endif
	material "mc_cw"
	for i = 0 to 8
		aa = 180 + aSc - i * aSc / 4
		put tailR * cos(aa), tailR * sin(aa)
	next i
	put xC, w2c, xC, -w2c
	add 0, 0, zC0
	prism nsp / 2, hC, get(nsp)
	del 1
	material "mc_body"
	yE0 = -w2 + 0.05
	yE1 = w2 - cabW - 0.1
	if cbS < 0 then
		yE0 = -w2 + cabW + 0.1
		yE1 = w2 - 0.05
	endif
	add xC, yE0, upZ + hB
	block max(0.2, upF - cabL - xC - 0.05), yE1 - yE0, 0.4
	del 1
	material "mc_dark"
	for i = 0 to 4
		add xC + 0.1 + i * 0.18, yE0 + 0.1, upZ + hB + 0.4
		block 0.09, max(0.1, yE1 - yE0 - 0.2), 0.01
		del 1
	next i
	! 運転室（cbS の側の前）
	yC0 = w2 - cabW
	if cbS < 0 then yC0 = -w2
	material "mc_body"
	add upF - cabL, yC0, upZ + hB
	block cabL, cabW, upH - upZ - hB
	del 1
	material "mc_glass"
	hW = (upH - upZ - hB) * 0.62
	add upF + 0.005, yC0 + 0.08, upH - hW - 0.08
	block 0.006, cabW - 0.16, hW
	del 1
	yG = yC0 + cabW + 0.002
	if cbS < 0 then yG = yC0 - 0.008
	add upF - cabL + 0.12, yG, upH - hW - 0.08
	block cabL - 0.24, 0.006, hW
	del 1
	material "mc_steel"
	add upF - cabL - 0.05, yE0, upZ + hB + 0.4
	block 0.04, yE1 - yE0, 0.03
	del 1
	return

"bar":
	! (x0q, z0q) から (x1q, z1q) の箱（幅 bwq・せい bhq。y は 0 を中心）
	dxq = x1q - x0q
	dzq = z1q - z0q
	lq = sqr(dxq ^ 2 + dzq ^ 2)
	anq = 90
	if dzq < 0 then anq = -90
	if abs(dxq) > 0.000001 then anq = atn(dzq / dxq)
	if dxq < 0 then anq = anq + 180
	add x0q, 0, z0q
	roty -anq
	add 0, -bwq / 2, -bhq / 2
	block lq, bwq, bhq
	del 3
	return

"seg3":
	! (x0q, y0q, z0q) から (x1q, y1q, z1q) の円柱（半径 rq）
	dxq = x1q - x0q
	dyq = y1q - y0q
	dzq = z1q - z0q
	hq = sqr(dxq ^ 2 + dyq ^ 2)
	lq = sqr(hq ^ 2 + dzq ^ 2)
	if lq > 0.001 then
		az = 0
		if hq > 0.0001 then
			if abs(dxq) < 0.0001 then
				az = 90
				if dyq < 0 then az = -90
			else
				az = atn(dyq / dxq)
				if dxq < 0 then az = az + 180
			endif
		endif
		el = 90
		if dzq < 0 then el = -90
		if hq > 0.0001 then el = atn(dzq / hq)
		add x0q, y0q, z0q
		rotz az
		roty 90 - el
		cylind lq, rq
		del 3
	endif
	return

"cyl2":
	! 油圧シリンダ（太い筒 6 割と細いロッド）: (cx0, cy0, cz0) から (cx1, cy1, cz1)
	material "mc_dark"
	x0q = cx0
	y0q = cy0
	z0q = cz0
	x1q = cx0 + 0.6 * (cx1 - cx0)
	y1q = cy0 + 0.6 * (cy1 - cy0)
	z1q = cz0 + 0.6 * (cz1 - cz0)
	rq = crq
	gosub "seg3"
	material "mc_rod"
	x0q = x1q
	y0q = y1q
	z0q = z1q
	x1q = cx1
	y1q = cy1
	z1q = cz1
	rq = crq * 0.55
	gosub "seg3"
	return

"backhoe":
	! ブーム（くの字の2本の箱）・アーム・バケット（側板の形と爪）・シリンダ3本
	bwq = 0.075 * boomL
	material "mc_body"
	add pvX - 0.2, -bwq / 2 - 0.08, upZ
	block 0.5, bwq + 0.16, pvH - upZ + 0.15
	del 1
	x0q = pvX
	z0q = pvH
	x1q = knX
	z1q = knZ
	bhq = 0.1 * boomL
	gosub "bar"
	x0q = knX
	z0q = knZ
	x1q = bmX1
	z1q = bmZ1
	bhq = 0.075 * boomL
	gosub "bar"
	bwq = 0.06 * boomL
	bhq = 0.06 * boomL
	x0q = amX0
	z0q = amZ0
	x1q = amX1
	z1q = amZ1
	gosub "bar"
	material "mc_steel"
	add bmX1, bwq / 2 + 0.03, bmZ1
	rotx 90
	cylind bwq + 0.06, 0.07
	del 2
	atX0 = amX1
	atZ0 = amZ1
	if atK > 0 then
		gosub "attach"
	else
		gosub "bucket"
	endif
	! シリンダ（ブーム2本・アーム・バケット）
	crq = 0.045 * boomL / 3.5
	for s = -1 to 1 step 2
		cx0 = pvX + 0.35
		cy0 = s * (0.075 * boomL / 2 + 0.06)
		cz0 = upZ + 0.25
		cx1 = pvX + 0.42 * boomL * cos(bmA) + 0.04 * boomL * sin(bmA)
		cy1 = cy0
		cz1 = pvH + 0.42 * boomL * sin(bmA) - 0.04 * boomL * cos(bmA)
		gosub "cyl2"
	next s
	cx0 = knX - 0.06 * boomL * sin(bmA)
	cy0 = 0
	cz0 = knZ + 0.07 * boomL
	cx1 = amX0
	cy1 = 0
	cz1 = amZ0
	gosub "cyl2"
	crq = crq * 0.8
	cx0 = bmX1 + 0.2 * armL * cos(amA) - 0.08 * sin(amA)
	cy0 = 0
	cz0 = bmZ1 + 0.2 * armL * sin(amA) + 0.08 * cos(amA)
	cx1 = amX1 - 0.12 * armL * cos(amA) - 0.12 * sin(amA)
	cy1 = 0
	cz1 = amZ1 - 0.12 * armL * sin(amA) + 0.12 * cos(amA)
	gosub "cyl2"
	return

"bucket":
	! バケット（ピン atX0, atZ0 から爪へ bkA の向き。側板の形を幅 bkW で押し出す）
	material "mc_dark"
	add atX0, bkW / 2, atZ0
	rotx 90
	rotz bkA
	prism 6, bkW, 0, 0.1 * bkL, 0.3 * bkL, 0.42 * bkL, 0.8 * bkL, 0.38 * bkL, bkL, 0, 0.85 * bkL, -0.06 * bkL, 0.12 * bkL, -0.1 * bkL
	nTh = max(3, int(bkW / 0.22))
	for k = 0 to nTh - 1
		add bkL - 0.02, -0.03, 0.06 + k * (bkW - 0.12) / max(1, nTh - 1) - 0.04
		block 0.14, 0.06, 0.08
		del 1
	next k
	del 3
	return

"attach":
	! 解体アタッチメント（ピン atX0, atZ0 から bkA の向き）: 本体（全旋回のリング）と爪2枚（atO だけ開く）、つかみ機は爪が2本ずつ、
	! ブレーカは筒とチゼル。爪はピンから 0.45×atL で開き、長さ 0.55×atL
	bWq = min(0.7, max(0.2, 0.22 * atL))
	add atX0, 0, atZ0
	roty -bkA
	if atK = 4 then
		material "mc_dark"
		roty 90
		cylind 0.75 * atL, max(0.08, 0.11 * atL)
		material "mc_steel"
		cylind atL, max(0.03, atW / 2)
		del 1
	else
		material "mc_dark"
		add 0, -bWq / 2, -bWq / 2
		block 0.45 * atL, bWq, bWq
		del 1
		material "mc_steel"
		add 0.12 * atL, 0, 0
		roty 90
		cylind 0.08, bWq * 0.75
		del 2
		jl = 0.55 * atL
		th = 0.16 * atL
		wq = bWq
		if atK = 2 then
			th = 0.1 * atL
			wq = bWq * 0.6
		endif
		material "mc_drum"
		for sj = -1 to 1 step 2
			add 0.45 * atL, 0, 0
			roty -sj * atO / 2
			if atK = 3 then
				for tj = -1 to 1 step 2
					add 0, tj * bWq * 0.32, 0
					wq = bWq * 0.25
					gosub "jawp"
					del 1
				next tj
			else
				gosub "jawp"
			endif
			del 2
		next sj
	endif
	del 2
	return

"jawp":
	! 爪1枚（xz 面の四角形を厚み wq で押し出す。sj＝1 は上、-1 は下）
	add 0, wq / 2, 0
	rotx 90
	prism 4, wq, 0, 0, jl, sj * th * 0.15, jl * 0.85, sj * th * 0.75, 0, sj * th
	del 2
	return

"demolish":
	! 解体機のフロント（メインブーム・フロントブーム・アームの3段。弦の長さ dbL1〜3・水平からの角度 dA1〜3）・関節のピン・
	! シリンダ・先のアタッチメント（atK 0 はバケット）
	bw1 = max(0.18, min(0.6, 0.06 * dbL1 + 0.12))
	material "mc_body"
	add pvX - 0.35, -bw1 / 2 - 0.1, upZ
	block 0.7, bw1 + 0.2, pvH - upZ + 0.15
	del 1
	bwq = bw1
	bhq = bw1 * 1.3
	x0q = pvX
	z0q = pvH
	x1q = dmX1
	z1q = dmZ1
	gosub "bar"
	bwq = bw1 * 0.85
	bhq = bwq * 1.2
	x0q = dmX1
	z0q = dmZ1
	x1q = dmX2
	z1q = dmZ2
	gosub "bar"
	bwq = bw1 * 0.7
	bhq = bwq * 1.2
	x0q = dmX2
	z0q = dmZ2
	x1q = dmX3
	z1q = dmZ3
	gosub "bar"
	material "mc_steel"
	add dmX1, bw1 / 2 + 0.05, dmZ1
	rotx 90
	cylind bw1 + 0.1, bw1 * 0.3
	del 2
	add dmX2, bw1 / 2 + 0.05, dmZ2
	rotx 90
	cylind bw1 + 0.1, bw1 * 0.25
	del 2
	! シリンダ（段の下側。1本ずつ。離れは段の幅 bw1 に合わせる）
	crq = max(0.02, bw1 * 0.22)
	eq = bw1 * 0.6
	cx0 = pvX + bw1
	cy0 = 0
	cz0 = upZ + bw1 * 0.8
	cx1 = pvX + 0.5 * dbL1 * cos(dA1) + eq * sin(dA1)
	cy1 = 0
	cz1 = pvH + 0.5 * dbL1 * sin(dA1) - eq * cos(dA1)
	gosub "cyl2"
	crq = crq * 0.85
	cx0 = pvX + 0.7 * dbL1 * cos(dA1) + eq * sin(dA1)
	cz0 = pvH + 0.7 * dbL1 * sin(dA1) - eq * cos(dA1)
	cx1 = dmX1 + 0.3 * dbL2 * cos(dA2) + eq * sin(dA2)
	cz1 = dmZ1 + 0.3 * dbL2 * sin(dA2) - eq * cos(dA2)
	gosub "cyl2"
	crq = crq * 0.85
	cx0 = dmX1 + 0.75 * dbL2 * cos(dA2) + eq * sin(dA2)
	cz0 = dmZ1 + 0.75 * dbL2 * sin(dA2) - eq * cos(dA2)
	cx1 = dmX2 + 0.2 * dbL3 * cos(dA3) + eq * sin(dA3)
	cz1 = dmZ2 + 0.2 * dbL3 * sin(dA3) - eq * cos(dA3)
	gosub "cyl2"
	atX0 = dmX3
	atZ0 = dmZ3
	if atK > 0 then
		gosub "attach"
	else
		gosub "bucket"
	endif
	return

"pileleader":
	! 三点式杭打機: リーダブラケット・リーダ（主管 ldDia と前のガイド管2本・頂部のシーブ）・ステー2本（上部の後ろから stZ）・
	! フロントジャッキと後ろのアウトリガ・オーガ（モータ auH×auW、スクリュー auN 本・軸間 auP・下端に先のヘッド）
	lzT = ldZ + ldL
	hBq = 0.12 * (upH - upZ) + 0.45
	material "mc_body"
	add upF - 0.1, -0.6, upZ
	block max(0.2, ldX - upF + 0.1), 1.2, 0.9
	del 1
	add ldX, 0, ldZ
	cylind ldL, ldDia / 2
	del 1
	material "mc_steel"
	for s = -1 to 1 step 2
		add ldX + ldDia * 0.67, s * ldDia * 0.38, ldZ
		cylind ldL, max(0.03, ldDia * 0.077)
		del 1
	next s
	material "mc_dark"
	add ldX - ldDia * 0.6, -ldDia * 0.6, lzT
	block ldDia * 1.6, ldDia * 1.2, ldDia * 2.7
	del 1
	material "mc_steel"
	for s = -1 to 1 step 2
		x0q = -tailR * 0.35
		y0q = s * upW * 0.35
		z0q = upZ + hBq
		x1q = ldX - ldDia / 2
		y1q = s * ldDia * 0.3
		z1q = min(stZ, lzT - 0.5)
		rq = max(0.04, 0.0045 * ldL)
		gosub "seg3"
	next s
	! ジャッキ（筒とパッド）と後ろのアウトリガの梁
	for s = -1 to 1 step 2
		material "mc_dark"
		add fjX, s * fjW / 2, 0.05
		cylind upZ + 0.4, 0.12
		del 1
		add -rjX, s * rjW / 2, 0.05
		cylind upZ + 0.4, 0.12
		del 1
		material "mc_steel"
		add fjX - 0.3, s * fjW / 2 - 0.3, 0
		block 0.6, 0.6, 0.05
		del 1
		add -rjX - 0.3, s * rjW / 2 - 0.3, 0
		block 0.6, 0.6, 0.05
		del 1
		material "mc_body"
		add -rjX - 0.15, min(0, s * rjW / 2), upZ + 0.2
		block 0.3, rjW / 2, 0.3
		del 1
	next s
	! オーガ
	xA = ldX + auOff
	material "mc_dark"
	add ldX + ldDia / 2, -0.3, auZ + auH * 0.4
	block max(0.1, auOff - auW / 2 - ldDia / 2 + 0.05), 0.6, 0.6
	del 1
	material "mc_drum"
	add xA - auW / 2, yAu0 - auD / 2 - 0.15, auZ
	block auW, -2 * yAu0 + auD + 0.3, auH
	del 1
	for i = 1 to nAu
		yA = yAu0 + (i - 1) * auP
		material "mc_steel"
		add xA, yA, auZ - auL
		cylind auL, max(0.04, auD * 0.18)
		del 1
		nF = max(2, int(auL / max(0.3, auD)))
		for k = 0 to nF - 1
			add xA, yA, auZ - auL + (k + 0.5) * auL / nF
			cylind 0.03, auD / 2
			del 1
		next k
		material "mc_dark"
		add xA, yA, auZ - auL - 0.4 * auD
		cone 0.4 * auD, 0.03, auD / 2, 90, 90
		del 1
	next i
	return

"earthdrill":
	! アースドリル: テレスコブーム（3段の箱。根元 pvX, pvH・長さ tbL・起伏 tbA）・頂部のシーブ・ケリードライブとフレーム（kdZ）・
	! ケリーバ（径 kyD。バケットの上から頂部の下まで）・ドリリングバケット（径 auD・高さ bkH・下端は地面から bkD 下）
	material "mc_steel"
	add pvX - 0.4, -0.5, upZ
	block 0.8, 1.0, pvH - upZ
	del 1
	material "mc_body"
	for i = 0 to 2
		f0 = 0.3 * i
		f1 = min(1, f0 + 0.42)
		bwq = 0.9 - 0.15 * i
		bhq = bwq
		x0q = pvX + f0 * tbL * cos(tbA)
		z0q = pvH + f0 * tbL * sin(tbA)
		x1q = pvX + f1 * tbL * cos(tbA)
		z1q = pvH + f1 * tbL * sin(tbA)
		gosub "bar"
	next i
	material "mc_dark"
	add tbX - 0.5, -0.6, tbZ - 0.4
	block 1.0, 1.2, 0.8
	del 1
	! ケリードライブ（上部の前からのフレーム）
	material "mc_body"
	add upF - 0.2, -0.4, min(kdZ, upZ + 0.3)
	block max(0.2, kdR - 0.9 - upF + 0.2), 0.8, 0.5
	del 1
	material "mc_steel"
	add kdR - 0.9, -0.9, kdZ
	block 1.8, 1.8, 1.0
	del 1
	! ケリーバとワイヤ
	zB = -bkD
	material "mc_rod"
	kz0 = zB + bkH
	kz1 = tbZ - 0.8
	add kdR, 0, kz0
	cylind max(0.1, kz1 - kz0), kyD / 2
	del 1
	! バケット（底は浅い円錐）
	material "mc_dark"
	add kdR, 0, zB + 0.25
	cylind max(0.1, bkH - 0.25), auD / 2
	del 1
	add kdR, 0, zB
	cone 0.25, auD * 0.3, auD / 2, 90, 90
	del 1
	return

"rotator":
	! 全周回転機（据置）: 反力ブラケット（十字）・本体の下の枠（通り穴 rtD を残す4つの箱）・チャック（押抜ストローク rtS で上下）・
	! 手すり・水平ジャッキ4本（底 φ500）・ケーシング（径 csD、本体の上 csH）・油圧ユニット（台 0.3）とホース
	hR = rtD / 2
	material "mc_steel"
	add -brL / 2, -0.3, 0
	block brL, 0.6, 0.5
	del 1
	add -0.3, -brW / 2, 0
	block 0.6, brW, 0.5
	del 1
	material "mc_body"
	zF = 0.2
	hF = zDk * 0.5
	add -rtL / 2, -rtW / 2, zF
	block rtL / 2 - hR, rtW, hF
	del 1
	add hR, -rtW / 2, zF
	block rtL / 2 - hR, rtW, hF
	del 1
	add -hR, -rtW / 2, zF
	block 2 * hR, rtW / 2 - hR, hF
	del 1
	add -hR, hR, zF
	block 2 * hR, rtW / 2 - hR, hF
	del 1
	! チャック（回転部）とデッキ
	material "mc_drum"
	add 0, 0, zF + hF + rtS
	cylind max(0.2, zDk - zF - hF), hR + 0.3
	del 1
	material "mc_steel"
	for s = -1 to 1 step 2
		for t = -1 to 1 step 2
			add s * (rtL / 2 - 0.05) - 0.025, t * (rtW / 2 - 0.05) - 0.025, zDk + rtS
			block 0.05, 0.05, rtH - zDk
			del 1
			add s * (rtL / 2 - 0.35), t * (rtW / 2 - 0.35), 0
			cylind zF + 0.3, 0.25
			del 1
		next t
		add -rtL / 2, s * (rtW / 2 - 0.05) - 0.025, rtH + rtS - 0.05
		block rtL, 0.05, 0.05
		del 1
		add s * (rtL / 2 - 0.05) - 0.025, -rtW / 2, rtH + rtS - 0.05
		block 0.05, rtW, 0.05
		del 1
	next s
	! ケーシング
	material "mc_rod"
	add 0, 0, 0
	cylind rtH + rtS + csH, csD / 2
	del 1
	! 油圧ユニット
	material "mc_dark"
	add puX - min(4.2, puL) / 2, puY - puW / 2 + 0.1, 0
	block min(4.2, puL), puW - 0.2, 0.3
	del 1
	material "mc_body"
	add puX - puL / 2, puY - puW / 2, 0.3
	block puL, puW, max(0.2, puH - 0.3)
	del 1
	material "mc_dark"
	x0q = puX + puL / 2
	y0q = puY
	z0q = 1.0
	x1q = -rtL / 2
	y1q = 0
	z1q = zDk * 0.5
	rq = 0.05
	gosub "seg3"
	return

"piler":
	! 圧入機: 後ろの完成杭（U形を交互に。地面の上 0.5m まで）をクランプでつかむ本体（サドル・スライドベース・リーダーマスト）と、
	! チャックの杭（チャック投入高 piC＋上がり piS、天端はその上 piT）・パワーユニット（クローラの上の箱）とホース
	material "mc_steel"
	for i = 1 to piN
		xP = -i * piP
		sg = 1 - 2 * (i mod 2)
		add xP - piP / 2, sg * 0.15 - 0.006, -2.0
		block piP, 0.012, 2.5
		del 1
	next i
	! チャックの杭
	zC = piC + piS
	add -piP / 2, -0.15 - 0.006, zC + piT - 12.0
	block piP, 0.012, 12.0
	del 1
	! 本体: クランプ（完成杭の上）・サドル・リーダーマスト・チャック
	material "mc_body"
	xB = -piL + 0.35
	add xB, -piW / 2, 0.5
	block piL - 0.6, piW, piC * 0.45
	del 1
	material "mc_dark"
	for i = 1 to min(3, piN)
		add -i * piP - 0.15, -piW * 0.3, 0.2
		block 0.3, piW * 0.6, 0.35
		del 1
	next i
	material "mc_body"
	add -0.75, -piW * 0.4, 0.5 + piC * 0.45
	block 0.6, piW * 0.8, max(0.3, piH - 0.5 - piC * 0.45)
	del 1
	material "mc_drum"
	add -0.25, -piW * 0.45, zC
	block 0.6, piW * 0.9, 0.45
	del 1
	! パワーユニット
	material "mc_dark"
	add puX - puL * 0.3, puY - puW / 2, 0
	block puL * 0.6, puW, 0.545
	del 1
	material "mc_body"
	add puX - puL / 2, puY - puW / 2, 0.545
	block puL, puW, max(0.2, puH - 0.545)
	del 1
	material "mc_dark"
	x0q = puX + puL / 2
	y0q = puY
	z0q = 1.0
	x1q = xB
	y1q = 0
	z1q = 0.8
	rq = 0.04
	gosub "seg3"
	return

"lattice":
	! ラチスブーム（主材4本・斜材は4面）・根元と先・ガントリとペンダント・ワイヤとフック
	material "mc_steel"
	add pvX - 0.4, -lbW / 2 - 0.1, upZ
	block 0.8, lbW + 0.2, pvH - upZ
	del 1
	material "mc_body"
	add pvX, 0, pvH
	roty -lbA
	resol 6
	rcq = 0.035 + 0.02 * lbW
	for sy = -1 to 1 step 2
		for sz = -1 to 1 step 2
			add 0, sy * lbW / 2, sz * lbW / 2
			roty 90
			cylind lbL, rcq
			del 2
		next sz
	next sy
	nP = max(2, int(lbL / lbW))
	pP = lbL / nP
	for i = 0 to nP - 1
		sg = 1 - 2 * (i mod 2)
		rq = rcq * 0.5
		x0q = i * pP
		x1q = x0q + pP
		y0q = -sg * lbW / 2
		y1q = sg * lbW / 2
		z0q = lbW / 2
		z1q = lbW / 2
		gosub "seg3"
		z0q = -lbW / 2
		z1q = -lbW / 2
		gosub "seg3"
		y0q = lbW / 2
		y1q = lbW / 2
		z0q = -sg * lbW / 2
		z1q = sg * lbW / 2
		gosub "seg3"
		y0q = -lbW / 2
		y1q = -lbW / 2
		gosub "seg3"
	next i
	resol 12
	material "mc_steel"
	add lbL - 0.2, -lbW / 2, -lbW / 2
	block 0.6, lbW, lbW
	del 1
	for k = -1 to 1
		add lbL + 0.4, k * 0.2 - 0.04, 0
		rotx -90
		cylind 0.08, 0.45
		del 2
	next k
	del 2
	! ガントリ（上部の後ろ）とペンダント（ガントリの頭からブームの先）
	gX = -gnX
	gZ = gnH
	material "mc_steel"
	for s = -1 to 1 step 2
		x0q = gX - 0.6
		y0q = s * 0.8
		z0q = upZ + 0.9
		x1q = gX
		y1q = s * 0.5
		z1q = gZ
		rq = 0.08
		gosub "seg3"
		x0q = gX + 1.4
		y0q = s * 0.8
		z0q = upZ + 0.9
		gosub "seg3"
		x0q = gX
		y0q = s * 0.5
		z0q = gZ
		x1q = lbX
		y1q = s * lbW / 2 * 0.6
		z1q = lbZ
		rq = 0.02
		gosub "seg3"
	next s
	! ワイヤとフック
	material "mc_steel"
	for s = -1 to 1 step 2
		add lbX + 0.4 + s * 0.12, 0, lbZ - hkD + 0.8
		cylind hkD - 0.8, 0.015
		del 1
	next s
	! フック（仕様書の全高 hkH・幅 hkW・厚み hkT。上の 7 割がブロック、下がフック）
	material "mc_drum"
	add lbX + 0.4 - hkW / 2, -hkT / 2, lbZ - hkD
	block hkW, hkT, hkH * 0.7
	del 1
	material "mc_steel"
	add lbX + 0.4, 0, lbZ - hkD - hkH * 0.3
	cone hkH * 0.3, 0.05, hkT * 0.25, 90, 90
	del 1
	if vbK = 1 then
		! バイブロ（ハンガー・起振機・チャック）と杭（vbP）
		zV = lbZ - hkD - hkH * 0.3 - vbH
		material "mc_drum"
		add lbX + 0.4 - vbW / 2, -vbT / 2, zV + vbH * 0.25
		block vbW, vbT, vbH * 0.75
		del 1
		material "mc_dark"
		add lbX + 0.4 - vbW * 0.3, -vbT * 0.4, zV
		block vbW * 0.6, vbT * 0.8, vbH * 0.25
		del 1
		material "mc_steel"
		add lbX + 0.4 - 0.2, -0.006, zV - vbP + 0.1
		block 0.4, 0.012, vbP
		del 1
	endif
	return

"truck":
	! トラックの車体: フレーム・運転室（前窓は傾ける）・タイヤとホイール・フェンダー・バンパー・サイドガード・燃料タンク・ミラー
	material "mc_dark"
	for s = -1 to 1 step 2
		add xR + 0.15, s * 0.45 - 0.05, frZ - 0.28
		block carL - 0.45, 0.1, 0.28
		del 1
	next s
	cZ0 = whR * 2 - 0.1
	cL = min(2.3, carL * 0.28)
	material "mc_body"
	add xF - cL, carW / 2, cZ0
	rotx 90
	prism 5, carW, 0, 0, cL, 0, cL, (cabH - cZ0) * 0.45, cL - 0.3, cabH - cZ0, 0, cabH - cZ0
	del 2
	material "mc_glass"
	x0q = xF + 0.012
	z0q = cZ0 + (cabH - cZ0) * 0.47
	x1q = xF - 0.3 + 0.012
	z1q = cabH - 0.06
	bwq = carW - 0.25
	bhq = 0.01
	gosub "bar"
	for s = -1 to 1 step 2
		add xF - cL + 0.25, s * (carW / 2 + 0.003) - 0.003, cZ0 + (cabH - cZ0) * 0.48
		block cL - 0.75, 0.006, (cabH - cZ0) * 0.4
		del 1
	next s
	! バンパー（運転室の下端に付ける）
	material "mc_dark"
	add xF - 0.12, -carW / 2 + 0.05, cZ0 - 0.3
	block 0.16, carW - 0.1, 0.35
	del 1
	for s = -1 to 1 step 2
		add xF - 0.2, s * (carW / 2 + 0.12) - 0.04, cabH - 0.7
		block 0.04, 0.08, 0.35
		del 1
	next s
	! タイヤ（前は1本・後ろはダブル）
	for i = 1 to nAx
		axX = axs[i]
		for s = -1 to 1 step 2
			! 円柱は rotx 90 で -y へ伸びる。ホイールは外の面に 0.015 出す
			yT = s * (carW / 2 - 0.03) + (s < 0) * whW
			material "mc_tire"
			add axX, yT, whR
			rotx 90
			cylind whW, whR
			del 2
			material "mc_rim"
			add axX, yT + (s > 0) * 0.015, whR
			rotx 90
			cylind whW + 0.015, whR * 0.55
			del 2
			material "mc_body"
			add axX - whR - 0.08, s * (carW / 2 - 0.02) - (s + 1) / 2 * (whW + 0.04), 2 * whR + 0.04
			block 2 * whR + 0.16, whW + 0.04, 0.05
			del 1
		next s
	next i
	! サイドガード（前の車軸と後ろの車軸の間）と燃料タンク
	material "mc_steel"
	for s = -1 to 1 step 2
		for k = 0 to 1
			add axR1 + whR + 0.15, s * (carW / 2 - 0.12) - 0.02, 0.45 + k * 0.25
			block max(0.2, axs[max(1, min(2, nFr))] - axR1 - 2 * whR - 0.3), 0.04, 0.06
			del 1
		next k
	next s
	add axF - whR - 0.25, carW / 2 - 0.35, 0.7
	rotx 90
	cylind 0.6, 0.25
	del 2
	return

"outrig":
	! アウトリガ（組ごとに両側。横の箱・ジャッキ・敷板。3組めは張出スパン 0 なら無し）
	if otOn then
		for s = -1 to 1 step 2
			for e = 1 to nJk
				jX = ox[e]
				jY = max(0.35, oy[e])
				material "mc_body"
				add jX - 0.15, min(s * 0.3, s * jY), frZ - 0.45
				block 0.3, abs(jY - 0.3), 0.25
				del 1
				material "mc_dark"
				add jX, s * jY, 0.08
				cylind frZ - 0.4, 0.09
				del 1
				material "mc_steel"
				add jX - 0.3, s * jY - 0.3, 0
				block 0.6, 0.6, 0.08
				del 1
			next e
		next s
	endif
	return

"pumpbody":
	! ポンプ車: 荷台の機器箱・ホッパ（後ろ）・旋回台
	material "mc_body"
	add xR + 1.2, -carW / 2 + 0.15, frZ
	block max(0.5, -0.8 - xR - 1.2), carW - 0.3, 0.9
	del 1
	material "mc_dark"
	add xR, -0.6, frZ - 0.2
	block 1.0, 1.2, 0.75
	del 1
	material "mc_steel"
	add 0, 0, frZ
	cylind tuH - frZ - 0.3, 0.55
	del 1
	return

"pumpboom":
	! 折り曲げのブーム（段ごとに細く）・関節・輸送管・先端ホース
	material "mc_body"
	add -0.5, -0.45, tuH - 0.6
	block 1.0, 0.9, 0.6
	del 1
	px = 0
	pz = tuH
	for i = 1 to nSc
		qx = px + sl[i] * cos(sa[i])
		qz = pz + sl[i] * sin(sa[i])
		material "mc_body"
		x0q = px
		z0q = pz
		x1q = qx
		z1q = qz
		bwq = 0.38 - 0.05 * i
		bhq = 0.5 - 0.06 * i
		gosub "bar"
		material "mc_steel"
		add qx, bwq / 2 + 0.04, qz
		rotx 90
		cylind bwq + 0.08, bhq * 0.45
		del 2
		material "mc_rod"
		rq = 0.06
		x0q = px - (bhq / 2 + 0.1) * sin(sa[i])
		y0q = -bwq / 2 - 0.1
		z0q = pz + (bhq / 2 + 0.1) * cos(sa[i])
		x1q = qx - (bhq / 2 + 0.1) * sin(sa[i])
		y1q = y0q
		z1q = qz + (bhq / 2 + 0.1) * cos(sa[i])
		gosub "seg3"
		px = qx
		pz = qz
	next i
	material "mc_dark"
	add pmX, 0, max(0.3, pmZ - 3.0)
	cylind min(3.0, pmZ - 0.3), 0.065
	del 1
	return

"mixer":
	! 生コン車: ドラム（前の短い円錐・後ろの長い円錐）・帯・ホッパ・シュート・水タンク・後ろの足場
	zD = frZ + drD / 2 + 0.1
	dX0 = xF - min(2.3, carL * 0.28) - 0.35
	material "mc_drum"
	add dX0, 0, zD
	roty drA - 90
	cone drL * 0.3, drD * 0.3, drD / 2, 90, 90
	addz drL * 0.3
	cone drL * 0.7, drD / 2, drD * 0.22, 90, 90
	material "mc_body"
	for k = 1 to 3
		zk = k * drL * 0.2
		addz zk - 0.04
		cylind 0.08, drD / 2 + (drD * 0.22 - drD / 2) * zk / (drL * 0.7) + 0.02
		del 1
	next k
	del 3
	dX1 = dX0 - drL * cos(drA)
	dZ1 = zD + drL * sin(drA)
	material "mc_steel"
	add dX1 - 0.3, 0, dZ1 + 0.1
	cone 0.6, 0.15, 0.45, 90, 90
	del 1
	x0q = dX1 - 0.2
	z0q = dZ1 - 0.4
	x1q = xR - 0.5
	z1q = frZ + 0.2
	bwq = 0.4
	bhq = 0.05
	gosub "bar"
	add dX0 + 0.1, -0.35, frZ
	cylind 0.7, 0.3
	del 1
	add xR, -0.4, frZ
	block 0.3, 0.8, 0.05
	del 1
	return

"dump":
	! ダンプ: 荷台（床・あおり・鳥居）を後ろのヒンジで bedA だけ上げる・ホイストシリンダ
	hX = xR + 0.1
	hZ = frZ + 0.05
	add hX, 0, hZ
	roty -bedA
	material "mc_bed"
	add 0, -bedW / 2, 0
	block bedL, bedW, 0.12
	block bedL, 0.05, bedH + 0.12
	addy bedW - 0.05
	block bedL, 0.05, bedH + 0.12
	del 2
	add bedL - 0.08, -bedW / 2, 0
	block 0.08, bedW, bedH + 0.35
	addz bedH + 0.3
	block 0.45, bedW, 0.05
	del 2
	add 0, -bedW / 2, 0
	block 0.06, bedW, bedH + 0.12
	del 1
	material "mc_dark"
	for k = 1 to 4
		add k * bedL / 5, -bedW / 2 - 0.04, 0.12
		block 0.06, 0.04, bedH
		addy bedW + 0.04
		block 0.06, 0.04, bedH
		del 2
	next k
	del 2
	if bedA > 0.5 then
		crq = 0.09
		cx0 = hX + bedL * 0.6
		cy0 = 0
		cz0 = frZ - 0.2
		cx1 = hX + bedL * 0.62 * cos(bedA)
		cy1 = 0
		cz1 = hZ + bedL * 0.62 * sin(bedA)
		gosub "cyl2"
	endif
	return

"aerial":
	! 高所作業車: 旋回台・伸縮ブーム（段ごとに細く）・起伏シリンダ・バスケット（床・手すり）
	material "mc_steel"
	add 0, 0, frZ
	cylind tuH - frZ - 0.4, 0.45
	del 1
	material "mc_body"
	add -0.8, -0.5, tuH - 0.45
	block 1.3, 1.0, 0.5
	del 1
	nAb = max(2, min(5, nSec))
	for i = 1 to nAb
		x0q = -0.4 + (i - 1) * abL / nAb * 0.9 * cos(abA)
		z0q = tuH + (i - 1) * abL / nAb * 0.9 * sin(abA)
		x1q = -0.4 + min(abL, i * abL / nAb + 0.3) * cos(abA)
		z1q = tuH + min(abL, i * abL / nAb + 0.3) * sin(abA)
		bwq = 0.36 - 0.05 * i
		bhq = 0.42 - 0.05 * i
		gosub "bar"
	next i
	crq = 0.08
	cx0 = 0.4
	cy0 = 0
	cz0 = tuH - 0.3
	cx1 = -0.4 + abL * 0.35 * cos(abA) + 0.15 * sin(abA)
	cy1 = 0
	cz1 = tuH + abL * 0.35 * sin(abA) - 0.15 * cos(abA)
	gosub "cyl2"
	material "mc_body"
	add abX, -pfL / 2, abZ - 1.2
	block pfW, pfL, 0.1
	del 1
	rx0 = abX
	ry0 = -pfL / 2
	rlx = pfW
	rly = pfL
	rz0 = abZ - 1.1
	gosub "rail"
	return

"rail":
	! 作業床の手すり（rx0, ry0 から rlx × rly、床 rz0 から上桟 1.0・中桟 0.5・隅の柱）
	material "mc_steel"
	for k = 1 to 2
		add rx0, ry0, rz0 + k * 0.5 - 0.04
		block rlx, 0.04, 0.04
		addy rly - 0.04
		block rlx, 0.04, 0.04
		del 1
		block 0.04, rly, 0.04
		addx rlx - 0.04
		block 0.04, rly, 0.04
		del 2
	next k
	for e = 0 to 1
		for s = 0 to 1
			add rx0 + e * (rlx - 0.04), ry0 + s * (rly - 0.04), rz0
			block 0.04, 0.04, 1.0
			del 1
		next s
	next e
	return

"scissor":
	! 自走式の垂直昇降（シザース）: 車台・車輪・X 字の腕（3段）・作業床と手すり
	material "mc_body"
	add xR, -carW / 2, 0.08
	block carL, carW, 0.42
	del 1
	material "mc_tire"
	for e = -1 to 1 step 2
		for s = -1 to 1 step 2
			add e * (carL / 2 - 0.3), s * (carW / 2 - 0.02) + (s < 0) * 0.12, 0.15
			rotx 90
			cylind 0.12, 0.15
			del 2
		next s
	next e
	zA = 0.5
	zB = max(zA + 0.3, pfH - 0.15)
	hS = (zB - zA) / 3
	xa = -carL / 2 + 0.2
	xb = carL / 2 - 0.2
	material "mc_cw"
	bwq = 0.06
	bhq = 0.08
	for s = -1 to 1 step 2
		for k = 0 to 2
			add 0, s * (carW / 2 - 0.08), 0
			x0q = xa
			z0q = zA + k * hS
			x1q = xb
			z1q = zA + (k + 1) * hS
			gosub "bar"
			x0q = xb
			x1q = xa
			gosub "bar"
			del 1
		next k
	next s
	material "mc_body"
	add -pfL / 2, -pfW / 2, zB
	block pfL, pfW, 0.15
	del 1
	rx0 = -pfL / 2
	ry0 = -pfW / 2
	rlx = pfL
	rly = pfW
	rz0 = zB + 0.15
	gosub "rail"
	return

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 重機: 種類の一覧
dim kdV[], kdS[]
kdV[1] = 1
kdS[1] = "バックホウ"
kdV[2] = 2
kdS[2] = "クローラクレーン"
kdV[3] = 3
kdS[3] = "コンクリートポンプ車"
kdV[4] = 4
kdS[4] = "生コン車"
kdV[5] = 5
kdS[5] = "ダンプ"
kdV[6] = 6
kdS[6] = "高所作業車"
kdV[7] = 7
kdS[7] = "垂直昇降"
kdV[8] = 8
kdS[8] = "三点式杭打機"
kdV[9] = 9
kdS[9] = "アースドリル"
kdV[10] = 10
kdS[10] = "全周回転機"
kdV[11] = 11
kdS[11] = "解体機"
kdV[12] = 12
kdS[12] = "圧入機"
values{2} "mcKind" kdV, kdS
values{2} "atK" 0, "バケット", 1, "圧砕機", 2, "鉄骨切断機", 3, "つかみ機", 4, "ブレーカ"
values "auN" 1, 3
values{2} "vbK" 0, "フック", 1, "バイブロ"
values "nFr" 1, 2
values{2} "cbS" 1, "左", -1, "右"
values "nRear" 1, 2
values "nSec" 3, 4, 5
! 機種を選ぶと、src/ashiba/machine.py の寸法を書き込む（gen_machine_gdl.py が書き出す）
dim mdV[], mdS[]
mdV[1] = 0
mdS[1] = "手入力"
mdV[2] = 1
mdS[2] = "バックホウ 0.1m³"
mdV[3] = 2
mdS[3] = "バックホウ 0.25m³"
mdV[4] = 3
mdS[4] = "バックホウ 0.45m³"
mdV[5] = 4
mdS[5] = "バックホウ 0.8m³"
mdV[6] = 5
mdS[6] = "クローラクレーン 50t"
mdV[7] = 6
mdS[7] = "クローラクレーン 70t"
mdV[8] = 7
mdS[8] = "クローラクレーン 90t"
mdV[9] = 8
mdS[9] = "クローラクレーン 55t（日立住友）"
mdV[10] = 9
mdS[10] = "クローラクレーン 90t（日立住友）"
mdV[11] = 10
mdS[11] = "ポンプ車 26m"
mdV[12] = 11
mdS[12] = "ポンプ車 36m"
mdV[13] = 12
mdS[13] = "生コン車 4.4m³"
mdV[14] = 13
mdS[14] = "生コン車 3.2m³"
mdV[15] = 14
mdS[15] = "ダンプ 10t"
mdV[16] = 15
mdS[16] = "ダンプ 4t"
mdV[17] = 16
mdS[17] = "高所作業車 12m"
mdV[18] = 17
mdS[18] = "高所作業車 17m（タダノ）"
mdV[19] = 18
mdS[19] = "垂直昇降 5.7m"
mdV[20] = 19
mdS[20] = "三点式杭打機 110t"
mdV[21] = 20
mdS[21] = "三点式杭打機 135t"
mdV[22] = 21
mdS[22] = "小型杭打機 10t（地盤改良）"
mdV[23] = 22
mdS[23] = "SMW 3軸オーガ機"
mdV[24] = 23
mdS[24] = "アースドリル 20.6m"
mdV[25] = 24
mdS[25] = "全周回転機 φ2,000"
mdV[26] = 25
mdS[26] = "解体機 40t（超ロング 25m）"
mdV[27] = 26
mdS[27] = "解体機 40t（セパレートブーム）"
mdV[28] = 27
mdS[28] = "解体機 35t（ロングフロント）"
mdV[29] = 28
mdS[29] = "内装解体機 1.9t"
mdV[30] = 29
mdS[30] = "圧入機 U形 400（ST400SX）"
mdV[31] = 30
mdS[31] = "圧入機 U形 600（F201）"
mdV[32] = 31
mdS[32] = "バイブロ（50t クレーン）"
values{2} "mcModel" mdV, mdS
if GLOB_MODPAR_NAME = "mcModel" then
