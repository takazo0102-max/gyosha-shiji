! ==========================================================
! タワークレーン（建築用のクライミングクレーン。1基に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_tower/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_tower.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-11-01）: タワークレーンも追加してちょ。
! 原点＝マストの芯の基礎の上面、+X＝旋回の 0°。tcType 1 起伏ジブ・2 水平ジブ。マスト（主材4本と斜材）・基礎・壁つなぎ・旋回体・カウンタウエイト・Aフレームか塔頭・ジブ・フック。機種と寸法は tower.py、置くのは scripts/tower_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   tcModel   整数      機種（選ぶと寸法を書き込む。0＝手入力）                                  既定 0
!   tcType    整数      形式（1 起伏ジブ・2 水平ジブ）                                           既定 1
!   tcName    文字列    機種の名前（平面の注記）                                                 既定 "タワークレーン"
!   tcNote    文字列    諸元の注記                                                               既定 ""
!   slew      角度      旋回角（+X から左回り）                                                  既定 30.0
!   msW       長さ      マストの断面（主材の芯々）                                               既定 2.0
!   msH       長さ      マストの高さ（基礎の上面から旋回輪の下まで）                             既定 40.0
!   msSeg     長さ      マスト1本の長さ                                                          既定 4.0
!   baseW     長さ      基礎の一辺                                                               既定 7.0
!   baseD     長さ      基礎の厚さ（上面から下へ）                                               既定 1.5
!   tailR     長さ      後端旋回半径（カウンタウエイトの後端）                                   既定 8.0
!   cwW       長さ      カウンタウエイトの幅                                                     既定 2.5
!   cwH       長さ      カウンタウエイトの高さ                                                   既定 2.0
!   cwL       長さ      カウンタウエイトの奥行                                                   既定 1.5
!   dkW       長さ      機械台の幅                                                               既定 3.0
!   dkY       長さ      機械台の中心のずれ（左が +）                                             既定 0.0
!   cbL       長さ      運転室の前後                                                             既定 1.8
!   cbW       長さ      運転室の幅                                                               既定 1.1
!   cbZ       長さ      運転室の上面の高さ（旋回体を受ける面から）                               既定 3.2
!   cbH       長さ      運転室の高さ                                                             既定 2.1
!   frH       長さ      Aフレーム・塔頭の高さ（旋回輪から）                                      既定 9.0
!   frX       長さ      Aフレーム頂部（旋回中心から後ろ）                                        既定 3.0
!   upF       長さ      旋回体の前端（旋回中心から前）                                           既定 2.0
!   pvX       長さ      ジブの根元（旋回中心から前）                                             既定 1.0
!   pvH       長さ      ジブの根元の高さ（旋回輪から）                                           既定 2.5
!   jbL       長さ      ジブの長さ                                                               既定 40.0
!   jbA       角度      ジブの起伏角（起伏ジブ）                                                 既定 45.0
!   jbW       長さ      ジブの断面                                                               既定 1.4
!   trR       長さ      トロリの作業半径（水平ジブ）                                             既定 25.0
!   hkD       長さ      ジブの先（トロリ）からフックまで                                         既定 10.0
!   maxR      長さ      最大作業半径（平面の円）                                                 既定 40.0
!   tieZ      文字列    壁つなぎの高さ（mm・カンマ区切り）                                       既定 ""
!   tieA      角度      壁つなぎの向き（建物の側）                                               既定 180.0
!   tieL      長さ      壁つなぎの長さ（マストの面から建物まで）                                 既定 2.0
!   hfX       長さ      フックの位置 X（平面のホットスポット）                                   既定 30.0
!   hfY       長さ      フックの位置 Y                                                           既定 0.0
!   rtR       文字列    定格荷重の作業半径（mm。据え付けたジブの表）                             既定 ""
!   rtT       文字列    定格荷重（10kg 単位）                                                    既定 ""
!   loadT     実数      吊荷 t                                                                   既定 0.0
!   tcClr     整数      色の組（1 黄・2 赤白）                                                   既定 1
!   tcBase    ブール    ベース（クロスベース）を描く                                             既定 1
!   clOn      ブール    クライミング枠を描く                                                     既定 1
!   msStep    ブール    マストの高さを節の長さに吸い付ける（段階マスト）                         既定 0
!   hkLim     ブール    フックを規定の揚程の範囲に制限する（最大揚程）                           既定 0
!   hkMax     長さ      最大揚程（地盤からフックの上限）                                         既定 0.0
!   wiNum     整数      作業半径の表示数（0〜5）                                                 既定 1
!   wiPen     PenColor  作業半径の文字色（0＝線のペン）                                          既定 0
!   wiR1      長さ      1. 作業半径                                                              既定 10.0
!   wiA1      角度      1. 角度範囲の始め（0°＝車体の前）                                        既定 -10.0
!   wiB1      角度      1. 角度範囲の終わり                                                      既定 10.0
!   wiM1      角度      1. 範囲の中央（ホットスポット）                                          既定 0.0
!   wiF1      ブール    1. 文字反転                                                              既定 0
!   wiR2      長さ      2. 作業半径                                                              既定 15.0
!   wiA2      角度      2. 角度範囲の始め（0°＝車体の前）                                        既定 -10.0
!   wiB2      角度      2. 角度範囲の終わり                                                      既定 10.0
!   wiM2      角度      2. 範囲の中央（ホットスポット）                                          既定 0.0
!   wiF2      ブール    2. 文字反転                                                              既定 0
!   wiR3      長さ      3. 作業半径                                                              既定 20.0
!   wiA3      角度      3. 角度範囲の始め（0°＝車体の前）                                        既定 -30.0
!   wiB3      角度      3. 角度範囲の終わり                                                      既定 30.0
!   wiM3      角度      3. 範囲の中央（ホットスポット）                                          既定 0.0
!   wiF3      ブール    3. 文字反転                                                              既定 0
!   wiR4      長さ      4. 作業半径                                                              既定 25.0
!   wiA4      角度      4. 角度範囲の始め（0°＝車体の前）                                        既定 -30.0
!   wiB4      角度      4. 角度範囲の終わり                                                      既定 30.0
!   wiM4      角度      4. 範囲の中央（ホットスポット）                                          既定 0.0
!   wiF4      ブール    4. 文字反転                                                              既定 0
!   wiR5      長さ      5. 作業半径                                                              既定 30.0
!   wiA5      角度      5. 角度範囲の始め（0°＝車体の前）                                        既定 -30.0
!   wiB5      角度      5. 角度範囲の終わり                                                      既定 30.0
!   wiM5      角度      5. 範囲の中央（ホットスポット）                                          既定 0.0
!   wiF5      ブール    5. 文字反転                                                              既定 0
!   slgOn     ブール    吊り点の印と Max の表示                                                  既定 1
!   slgH      長さ      吊りしろ（フックから吊り点）                                             既定 6.0
!   mkZ       長さ      吊り点の高さ（ホットスポット）                                           既定 0.0
!   texZ      実数      吊り点の文字の高さ（m）                                                  既定 0.6
!   avN       整数      航空障害灯（0＝無し・1＝塔頂とジブ先端・2 以上＝ジブの途中に avN−1 個）  既定 0
!   texSiz    実数      文字の大きさ（mm）                                                       既定 2.5
!   penEquip  PenColor  線のペン                                                                 既定 1
!   penBold   PenColor  外形の線（太線。置くときに線のペンと同じ色の太いペン）                   既定 21
!   penThin   PenColor  細部の線（細線。同じ色の細いペン）                                       既定 1
!   penZone   PenColor  範囲の線（作業半径・後端旋回半径・立入禁止・旋回軌跡）                   既定 20
!   penMask   PenColor  上に載るものの背景の塗り（下の線を隠す。0＝隠さない）                    既定 19
!   drMode    整数      平面の描き分け（0 縮尺で自動・1 詳細 1/100・2 標準 1/200・3 簡略）       既定 0
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! タワークレーン: マストの本数・ジブの先・フックの位置・壁つなぎの高さ（m・度）
nSg = max(1, int(msH / max(0.5, msSeg) + 0.5))
sgL = msH / nSg
zR = msH
! ジブの先（起伏ジブは起こした先、水平ジブはジブの先）と今の作業半径（フックの位置）
if tcType = 2 then
	jX = pvX + jbL
	jZ = zR + pvH
	hX = max(pvX + 2, min(jX - 0.5, trR))
else
	jX = pvX + jbL * cos(jbA)
	jZ = zR + pvH + jbL * sin(jbA)
	hX = jX
endif
hZ = max(0.5, jZ - hkD)
if hkLim and hkMax > 0.1 then hZ = min(hZ, hkMax)
dim qR[]
nQr = 0
rest = rtR
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nQr = nQr + 1
		qR[nQr] = v / 1000
	endif
endwhile
dim qT[]
nQt = 0
rest = rtT
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nQt = nQt + 1
		qT[nQt] = v / 1
	endif
endwhile
capT = 0
for i = nQr to 1 step -1
	if qR[i] >= hX - 0.001 and i <= nQt then capT = qT[i] / 100
next i
! 作業半径の表示（scripts/gdl_radii.py）
nWi = max(0, min(5, wiNum)) * (1)
dim wiRq[5], wiAq[5], wiBq[5], wiSq[5], wiMq[5], wiFq[5], wiTq[5]
wiRq[1] = wiR1
wiAq[1] = wiA1
wiBq[1] = wiB1
wiFq[1] = wiF1
wiRq[2] = wiR2
wiAq[2] = wiA2
wiBq[2] = wiB2
wiFq[2] = wiF2
wiRq[3] = wiR3
wiAq[3] = wiA3
wiBq[3] = wiB3
wiFq[3] = wiF3
wiRq[4] = wiR4
wiAq[4] = wiA4
wiBq[4] = wiB4
wiFq[4] = wiF4
wiRq[5] = wiR5
wiAq[5] = wiA5
wiBq[5] = wiB5
wiFq[5] = wiF5
for wq = 1 to 5
	wS0 = wiBq[wq] - wiAq[wq] + 720
	wS0 = wS0 - int(wS0 / 360) * 360
	if wS0 < 0.01 then wS0 = 360
	wiSq[wq] = wS0
	wiMq[wq] = wiAq[wq] + wS0 / 2
next wq
for wq = 1 to nWi
	vq = 0
	for k = nQr to 1 step -1
		if qR[k] >= wiRq[wq] - 0.001 and k <= nQt then vq = qT[k] / 100
	next k
	wiTq[wq] = vq
next wq
! 壁つなぎの高さ（mm の文字 → m）
dim tz[]
nTz = 0
rest = tieZ
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTz = nTz + 1
		tz[nTz] = v / 1000
	endif
endwhile

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! タワークレーン 2D: 基礎・マスト・壁つなぎ・ジブとカウンタウエイト（旋回）・後端旋回半径・作業半径・注記・ホットスポット
! CAD の平面図の描き方（scripts/gdl_draft.py）: 外形は太線・細部は細線、地中の基礎は破線、作業半径は一点鎖線、後端旋回半径は
! 二点鎖線。旋回体（カウンタウエイト・デッキ）は背景の色で塗って下のマストを隠す。縮尺で描き分ける
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
pen penEquip
define style "tcT" "ＭＳ Ｐゴシック", texSiz, 1, 0
style "tcT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
! 基礎（地中なので破線）・マスト（詳細はラチスの斜材）
drawindex 10
pen pT
if drLv < 3 then
	line_type ltH
	rect2 -baseW / 2, -baseW / 2, baseW / 2, baseW / 2
	line_type ltS
endif
drawindex 12
pen pO
rect2 -msW / 2, -msW / 2, msW / 2, msW / 2
pen pT
if drLv < 3 then
	line2 -msW / 2, -msW / 2, msW / 2, msW / 2
	line2 -msW / 2, msW / 2, msW / 2, -msW / 2
endif
! 壁つなぎ（建物の側へ2本。詳細はつなぎの間の斜材）
if nTz > 0 then
	rot2 tieA
	pen pO
	line2 msW / 2, -msW / 2, msW / 2 + tieL, -msW / 2 - 0.3
	line2 msW / 2, msW / 2, msW / 2 + tieL, msW / 2 + 0.3
	if drLv = 1 then
		pen pT
		line2 msW / 2, -msW / 2, msW / 2 + tieL, msW / 2 + 0.3
	endif
	del 1
endif
! 後端旋回半径（立入禁止の目安。二点鎖線）・今の作業半径・最大作業半径（一点鎖線）
drawindex 45
pen pZ
line_type ltZ
circle2 0, 0, tailR
line_type ltC
circle2 0, 0, hX
if maxR > hX + 0.1 then circle2 0, 0, maxR
line_type ltS
! ジブとカウンタウエイト（旋回で回す）
rot2 slew
if mk then
	drawindex 20
	fill fiS
	poly2_b 5, 6, pM, pM,
		-tailR, dkY - cwW / 2, 1,
		-tailR + cwL, dkY - cwW / 2, 1,
		-tailR + cwL, dkY + cwW / 2, 1,
		-tailR, dkY + cwW / 2, 1,
		-tailR, dkY - cwW / 2, -1
	fill fiS
	poly2_b 5, 6, pM, pM,
		-tailR + cwL, dkY - dkW / 2, 1,
		upF, dkY - dkW / 2, 1,
		upF, dkY + dkW / 2, 1,
		-tailR + cwL, dkY + dkW / 2, 1,
		-tailR + cwL, dkY - dkW / 2, -1
endif
drawindex 30
pen pO
line2 pvX, -jbW / 2, jX, -jbW / 4
line2 pvX, jbW / 2, jX, jbW / 4
line2 jX, -jbW / 4, jX, jbW / 4
rect2 -tailR, dkY - cwW / 2, -tailR + cwL, dkY + cwW / 2
rect2 -tailR + cwL, dkY - dkW / 2, upF, dkY + dkW / 2
pen pT
if drLv < 3 then rect2 upF - cbL, dkY - dkW / 2, upF, dkY - dkW / 2 + cbW
if drLv = 1 then
	! ジブのラチス（上下の弦材の間に斜材）とカウンタウエイトの目地
	nLc = max(2, int((jX - pvX) / max(jbW, 1.0)))
	for k = 0 to nLc - 1
		xa = pvX + k * (jX - pvX) / nLc
		xb = pvX + (k + 1) * (jX - pvX) / nLc
		wa = jbW / 2 - (jbW / 4) * k / nLc
		wb = jbW / 2 - (jbW / 4) * (k + 1) / nLc
		sg = 1 - 2 * (k mod 2)
		line2 xa, sg * wa, xb, -sg * wb
	next k
	for k = 1 to 3
		line2 -tailR + k * cwL / 4, dkY - cwW / 2, -tailR + k * cwL / 4, dkY + cwW / 2
	next k
endif
if drLv < 3 then
	line_type ltC
	line2 -tailR - 0.5, 0, jX + 0.8, 0
	line_type ltS
endif
circle2 hX, 0, 0.4
del 1
! 旋回の中心（一点鎖線の十字）
drawindex 45
pen pT
line_type ltC
line2 -msW, 0, msW, 0
line2 0, -msW, 0, msW
line_type ltS
! 注記
drawindex 50
pen penEquip
add2 -baseW / 2 - 0.5, -max(baseW, dkW) / 2 - 0.8          ! 基礎と機械台の外（下）に書く（1/200 で台の線に重ならないように）
rot2 -SYMB_ROTANGLE
text2 0, 0, tcName
if strlen(tcNote) > 0 and drLv < 3 then text2 0, -dT, tcNote
text2 0, -2 * dT, "R" + str(round_int(hX * 1000), 1, 0) + "・マスト " + str(round_int(msH * 1000), 1, 0)
del 2
! フックのホットスポット（X と Y の組を同じ点に置いて、どの向きにも引ける）と定格荷重の注記
xF = hX * cos(slew)
yF = hX * sin(slew)
hotspot2 0, yF, 61, hfX, 1 + 128
hotspot2 xF, yF, 62, hfX, 2
hotspot2 -1, yF, 63, hfX, 3
hotspot2 xF, 0, 64, hfY, 1 + 128
hotspot2 xF, yF, 65, hfY, 2
hotspot2 xF, -1, 66, hfY, 3
! 吊り点の印（scripts/gdl_mark.py）
if slgOn and (1) then
	pen penEquip
	line_type 1
	mkR = texSiz * GLOB_SCALE / 1000 * 0.7
	circle2 xF, yF, mkR
	line2 xF - mkR, yF, xF + mkR, yF
	line2 xF, yF - mkR, xF, yF + mkR
endif
add2 xF, yF
rot2 -SYMB_ROTANGLE
if capT > 0 then text2 0.6, dT, "定格 " + str(capT, 5, 2) + "t"
text2 0.6, 0, "R" + str(round_int(hX * 1000), 1, 0)
del 2
! 作業半径の表示（弧と線と文字。scripts/gdl_radii.py）
if nWi > 0 then
	define style "wiS" "ＭＳ Ｐゴシック", texSiz, 8, 0
	drawindex 50
	line_type ltS
endif
for wq = 1 to nWi
	wRr = wiRq[wq]
	wAm = wiMq[wq]
	pen pT
	if wiSq[wq] >= 359.9 then
		circle2 0, 0, wRr
	else
		arc2 0, 0, wRr, wiAq[wq], wiAq[wq] + wiSq[wq]
	endif
	line2 0, 0, wRr * cos(wAm), wRr * sin(wAm)
	wVr = wRr
	wVt = wiTq[wq]
	wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × 定格なし"
	if wVt > 0 then wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × " + str(wVt, 4 + (wVt >= 10) + (wVt >= 100), 2) + "ton"
	! 読める向き（図面の上で左へ倒れない）に向け、文字反転でさらに 180°
	wAt = wAm + SYMB_ROTANGLE + 1080
	wAt = wAt - int(wAt / 360) * 360
	wFl = (wAt > 90 and wAt <= 270)
	if wiFq[wq] then wFl = 1 - wFl
	pen penEquip
	if wiPen > 0 then pen wiPen
	style "wiS"
	add2 wRr * 0.5 * cos(wAm), wRr * 0.5 * sin(wAm)
	rot2 wAm + 180 * wFl
	text2 0, texSiz * GLOB_SCALE / 1000 * 0.3, wTx
	del 2
next wq
if nWi > 0 then
	style "tcT"
	pen pT
endif
if nWi >= 1 then
	wRr = wiRq[1]
	wAm = wiMq[1]
	hotspot2 0, 0, 900, wiR1, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 901, wiR1, 2
	hotspot2 -cos(wAm), -sin(wAm), 902, wiR1, 3 + 128
	hotspot2 0, 0, 903, wiA1, 6
	hotspot2 wRr, 0, 904, wiA1, 4 + 128
	hotspot2 wRr * cos(wiA1), wRr * sin(wiA1), 905, wiA1, 5
	hotspot2 0, 0, 906, wiB1, 6
	hotspot2 wRr, 0, 907, wiB1, 4 + 128
	hotspot2 wRr * cos(wiB1), wRr * sin(wiB1), 908, wiB1, 5
	hotspot2 0, 0, 909, wiM1, 6
	hotspot2 wRr * 0.75, 0, 910, wiM1, 4 + 128
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 911, wiM1, 5
endif
if nWi >= 2 then
	wRr = wiRq[2]
	wAm = wiMq[2]
	hotspot2 0, 0, 912, wiR2, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 913, wiR2, 2
	hotspot2 -cos(wAm), -sin(wAm), 914, wiR2, 3 + 128
	hotspot2 0, 0, 915, wiA2, 6
	hotspot2 wRr, 0, 916, wiA2, 4 + 128
	hotspot2 wRr * cos(wiA2), wRr * sin(wiA2), 917, wiA2, 5
	hotspot2 0, 0, 918, wiB2, 6
	hotspot2 wRr, 0, 919, wiB2, 4 + 128
	hotspot2 wRr * cos(wiB2), wRr * sin(wiB2), 920, wiB2, 5
	hotspot2 0, 0, 921, wiM2, 6
	hotspot2 wRr * 0.75, 0, 922, wiM2, 4 + 128
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 923, wiM2, 5
endif
if nWi >= 3 then
	wRr = wiRq[3]
	wAm = wiMq[3]
	hotspot2 0, 0, 924, wiR3, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 925, wiR3, 2
	hotspot2 -cos(wAm), -sin(wAm), 926, wiR3, 3 + 128
	hotspot2 0, 0, 927, wiA3, 6
	hotspot2 wRr, 0, 928, wiA3, 4 + 128
	hotspot2 wRr * cos(wiA3), wRr * sin(wiA3), 929, wiA3, 5
	hotspot2 0, 0, 930, wiB3, 6
	hotspot2 wRr, 0, 931, wiB3, 4 + 128
	hotspot2 wRr * cos(wiB3), wRr * sin(wiB3), 932, wiB3, 5
	hotspot2 0, 0, 933, wiM3, 6
	hotspot2 wRr * 0.75, 0, 934, wiM3, 4 + 128
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 935, wiM3, 5
endif
if nWi >= 4 then
	wRr = wiRq[4]
	wAm = wiMq[4]
	hotspot2 0, 0, 936, wiR4, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 937, wiR4, 2
	hotspot2 -cos(wAm), -sin(wAm), 938, wiR4, 3 + 128
	hotspot2 0, 0, 939, wiA4, 6
	hotspot2 wRr, 0, 940, wiA4, 4 + 128
	hotspot2 wRr * cos(wiA4), wRr * sin(wiA4), 941, wiA4, 5
	hotspot2 0, 0, 942, wiB4, 6
	hotspot2 wRr, 0, 943, wiB4, 4 + 128
	hotspot2 wRr * cos(wiB4), wRr * sin(wiB4), 944, wiB4, 5
	hotspot2 0, 0, 945, wiM4, 6
	hotspot2 wRr * 0.75, 0, 946, wiM4, 4 + 128
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 947, wiM4, 5
endif
if nWi >= 5 then
	wRr = wiRq[5]
	wAm = wiMq[5]
	hotspot2 0, 0, 948, wiR5, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 949, wiR5, 2
	hotspot2 -cos(wAm), -sin(wAm), 950, wiR5, 3 + 128
	hotspot2 0, 0, 951, wiA5, 6
	hotspot2 wRr, 0, 952, wiA5, 4 + 128
	hotspot2 wRr * cos(wiA5), wRr * sin(wiA5), 953, wiA5, 5
	hotspot2 0, 0, 954, wiB5, 6
	hotspot2 wRr, 0, 955, wiB5, 4 + 128
	hotspot2 wRr * cos(wiB5), wRr * sin(wiB5), 956, wiB5, 5
	hotspot2 0, 0, 957, wiM5, 6
	hotspot2 wRr * 0.75, 0, 958, wiM5, 4 + 128
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 959, wiM5, 5
endif
! 旋回角のホットスポット
rH = max(3.0, tailR)
hotspot2 0, 0, 1, slew, 6
hotspot2 rH, 0, 2, slew, 4
hotspot2 rH * cos(slew), rH * sin(slew), 3, slew, 5
hotspot2 0, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! タワークレーン 3D
! 色の組（1 黄・2 赤白。航空障害標識の塗り分け。同じ名前の define material は 1回だけ）
cR = 0.95
cG = 0.75
cB = 0.10
wR = cR
wG = cG
wB = cB
if tcClr = 2 then
	cR = 0.80
	cG = 0.12
	cB = 0.10
	wR = 0.94
	wG = 0.94
	wB = 0.94
endif
define material "tc_body" 2, cR, cG, cB
define material "tc_band" 2, wR, wG, wB
define material "tc_steel" 2, 0.55, 0.56, 0.58
define material "tc_dark" 2, 0.20, 0.20, 0.22
define material "tc_cw" 2, 0.62, 0.63, 0.64
define material "tc_conc" 2, 0.75, 0.74, 0.70
define material "tc_glass" 2, 0.30, 0.45, 0.60
define material "tc_hook" 2, 0.92, 0.40, 0.12
define material "tc_light" 2, 0.95, 0.10, 0.08
resol 8
! 基礎
material "tc_conc"
add -baseW * 0.55, -baseW * 0.55, -baseD
block baseW * 1.1, baseW * 1.1, baseD
del 1
if tcBase then
	! ベース（クロスベースの2本の梁）
	material "tc_steel"
	for s = -1 to 1 step 2
		add 0, 0, 0
		rotz 45 * s
		add -baseW * 0.7, -0.25, 0
		block baseW * 1.4, 0.5, 0.5
		del 3
	next s
	add -msW / 2 - 0.3, -msW / 2 - 0.3, 0.5
	block msW + 0.6, msW + 0.6, 0.15
	del 1
endif
gosub "mast"
gosub "ties"
gosub "climb"
add 0, 0, zR
rotz slew
gosub "slewing"
if tcType = 2 then
	gosub "flatjib"
else
	gosub "luffjib"
endif
if avN > 0 then gosub "lights"
del 2
gosub "hook"
! 吊り点の印（丸十字）と Max（scripts/gdl_mark.py）
if slgOn and (1) then
	define material "mk_red" 2, 0.90, 0.10, 0.10
	define style "mkI" "Arial", 900 * texZ, 4, 0
	mkX = hX * cos(slew)
	mkY = hX * sin(slew)
	mkH = hZ
	mkQ = mkH - slgH
	mkR = texZ
	mkV = capT
	material "mk_red"
	lin_ mkX, mkY, mkH, mkX, mkY, mkQ
	aV = 0
	dxV = GLOB_EYEPOS_X - SYMB_POS_X
	dyV = GLOB_EYEPOS_Y - SYMB_POS_Y
	if abs(dxV) > 0.01 then aV = atn(dyV / dxV) + 180 * (dxV < 0)
	aV = aV - SYMB_ROTANGLE + 90
	add mkX, mkY, mkQ
	! 丸十字は水平に寝かせる（利用者の指定 2026-11-07）。文字だけ視点へ向ける
	for k = 0 to 24
		put mkR * cos(15 * k), mkR * sin(15 * k), 15 - 16 * (k = 24)
	next k
	for k = 0 to 24
		put mkR * 0.82 * cos(15 * k), mkR * 0.82 * sin(15 * k), 15 - 16 * (k = 24)
	next k
	prism_ nsp / 3, 0.03, get(nsp)
	add -mkR, -mkR * 0.05, 0
	block mkR * 2, mkR * 0.1, 0.03
	del 1
	add -mkR * 0.05, -mkR, 0
	block mkR * 0.1, mkR * 2, 0.03
	del 1
	rotz aV
	rotx 90
	style "mkI"
	add mkR * 1.3, 0, 0
	if mkV > 0 then
		text 0.02, 0, "Max " + str(mkV, 4 + (mkV >= 10) + (mkV >= 100), 2) + "t"
	else
		text 0.02, 0, "Max -"
	endif
	del 4
	hotspot 0, mkY, mkQ, 960, hfX, 1 + 128
	hotspot mkX, mkY, mkQ, 961, hfX, 2
	hotspot -1, mkY, mkQ, 962, hfX, 3 + 128
	hotspot mkX, 0, mkQ, 963, hfY, 1 + 128
	hotspot mkX, mkY, mkQ, 964, hfY, 2
	hotspot mkX, -1, mkQ, 965, hfY, 3 + 128
	! 上下は丸十字の少し上の点で（同じ点に重ねると X・Y と一緒に編集になり、高さが書き戻された。実機 2026-11-07）
	hotspot mkX, mkY, mkR * 1.5, 966, mkZ, 1 + 128
	hotspot mkX, mkY, mkQ + mkR * 1.5, 967, mkZ, 2
	hotspot mkX, mkY, mkR * 1.5 - 1, 968, mkZ, 3 + 128
endif
end

"seg3":
	! (x0q, y0q, z0q) から (x1q, y1q, z1q) の円柱（半径 rq）
	dxq = x1q - x0q
	dyq = y1q - y0q
	dzq = z1q - z0q
	hq = sqr(dxq ^ 2 + dyq ^ 2)
	lq = sqr(hq ^ 2 + dzq ^ 2)
	if lq > 0.001 then
		az = 0
		if hq > 0.0001 then
			if abs(dxq) < 0.0001 then
				az = 90
				if dyq < 0 then az = -90
			else
				az = atn(dyq / dxq)
				if dxq < 0 then az = az + 180
			endif
		endif
		el = 90
		if dzq < 0 then el = -90
		if hq > 0.0001 then el = atn(dzq / hq)
		add x0q, y0q, z0q
		rotz az
		roty 90 - el
		cylind lq, rq
		del 3
	endif
	return

"mast":
	! マスト: 箱の主材 4 本・節ごとの X の斜材と水平材・継ぎの板・はしごと休憩台
	wC = msW * 0.13
	material "tc_body"
	for sx = -1 to 1 step 2
		for sy = -1 to 1 step 2
			add sx * msW / 2 - wC / 2, sy * msW / 2 - wC / 2, 0
			block wC, wC, msH
			del 1
		next sy
	next sx
	rq = msW * 0.028
	for k = 0 to nSg - 1
		za = k * sgL
		zb = min(msH, za + sgL)
		for f = 1 to 4
			ca = cos(f * 90)
			sa = sin(f * 90)
			cb = cos(f * 90 + 90)
			sb = sin(f * 90 + 90)
			x0q = msW / 2 * (ca - sa)
			y0q = msW / 2 * (sa + ca)
			x1q = msW / 2 * (cb - sb)
			y1q = msW / 2 * (sb + cb)
			z0q = za
			z1q = za
			gosub "seg3"
			z1q = zb
			gosub "seg3"
			xq = x0q
			yq = y0q
			x0q = x1q
			y0q = y1q
			x1q = xq
			y1q = yq
			z0q = za
			gosub "seg3"
			x1q = (x0q + xq) / 2
			y1q = (y0q + yq) / 2
		next f
		! 継ぎの板
		material "tc_dark"
		for sx = -1 to 1 step 2
			for sy = -1 to 1 step 2
				add sx * msW / 2 - wC * 0.7, sy * msW / 2 - wC * 0.7, za - 0.06
				block wC * 1.4, wC * 1.4, 0.12
				del 1
			next sy
		next sx
		! 休憩台
		material "tc_steel"
		add -msW * 0.42, -msW * 0.42, za + 0.04
		block msW * 0.84, msW * 0.84, 0.04
		del 1
		material "tc_body"
	next k
	! はしご（マストの中）
	material "tc_steel"
	rq = 0.02
	for s = -1 to 1 step 2
		add msW * 0.3, s * 0.2, 0
		cylind msH, 0.02
		del 1
	next s
	for k = 0 to int(msH / 0.9)
		add msW * 0.3 - 0.015, -0.2, k * 0.9
		block 0.03, 0.4, 0.03
		del 1
	next k
	return

"climb":
	! クライミング枠（マストを抱く四角の枠。上の 2 段。機種の外形は調査のメモ）
	if clOn then
		for k = 1 to 2
			zK = msH - k * 3.4
			if zK > 1 then
				material "tc_dark"
				hK = msW / 2 + 0.3
				for s = -1 to 1 step 2
					add -hK - 0.5, s * hK - 0.2, zK
					block 2 * hK + 1.0, 0.4, 0.6
					del 1
					add s * hK - 0.2, -hK - 0.5, zK
					block 0.4, 2 * hK + 1.0, 0.6
					del 1
				next s
				! 昇降のシリンダ
				material "tc_steel"
				for s = -1 to 1 step 2
					add s * (msW / 2 + 0.16), 0, zK + 0.6
					cylind 1.6, 0.09
					del 1
				next s
			endif
		next k
	endif
	return

"ties":
	! 壁つなぎ: 高さごとにマストを囲むカラーと、建物の側（tieA）へ2本の控え
	if nTz > 0 then
		for i = 1 to nTz
			material "tc_dark"
			add -msW / 2 - 0.15, -msW / 2 - 0.15, tz[i] - 0.15
			block msW + 0.3, msW + 0.3, 0.3
			del 1
			material "tc_steel"
			rq = 0.08
			for s = -1 to 1 step 2
				x0q = (msW / 2 + 0.15) * cos(tieA) - s * msW / 2 * sin(tieA)
				y0q = (msW / 2 + 0.15) * sin(tieA) + s * msW / 2 * cos(tieA)
				x1q = (msW / 2 + tieL) * cos(tieA) - s * (msW / 2 + 0.3) * sin(tieA)
				y1q = (msW / 2 + tieL) * sin(tieA) + s * (msW / 2 + 0.3) * cos(tieA)
				z0q = tz[i]
				z1q = tz[i]
				gosub "seg3"
			next s
		next i
	endif
	return

"slewing":
	! 旋回体: ポスト・旋回輪・機械台の梁・通路と手すり・機械室のドラム・カウンタウエイト・運転室
	material "tc_dark"
	cylind 0.25, msW * 0.68
	add 0, 0, 0.25
	cylind 0.35, msW * 0.6
	del 1
	xD0 = -tailR + cwL
	lD = tailR - cwL + upF
	material "tc_body"
	for s = -1 to 1 step 2
		add xD0, dkY + s * (dkW / 2 - 0.2) - 0.2, 0.6
		block lD, 0.4, 0.5
		del 1
	next s
	for k = 0 to 4
		add xD0 + k * (lD - 0.3) / 4, dkY - dkW / 2 + 0.2, 0.68
		block 0.3, dkW - 0.4, 0.34
		del 1
	next k
	! 通路の板と手すり
	material "tc_steel"
	add xD0, dkY - dkW / 2, 1.1
	block lD, dkW, 0.03
	del 1
	rq = 0.02
	for s = -1 to 1 step 2
		yH = dkY + s * dkW / 2
		for k = 0 to 4
			x0q = xD0 + k * lD / 4
			y0q = yH
			z0q = 1.13
			x1q = x0q
			y1q = yH
			z1q = 2.2
			gosub "seg3"
		next k
		for k = 0 to 1
			x0q = xD0
			x1q = xD0 + lD
			y0q = yH
			y1q = yH
			z0q = 1.65 + k * 0.55
			z1q = z0q
			gosub "seg3"
		next k
	next s
	! 機械室（箱）と巻上・起伏のドラム
	material "tc_band"
	add xD0 + 0.2, dkY - dkW * 0.3, 1.13
	block min(2.4, lD * 0.35), dkW * 0.6, 1.5
	del 1
	for k = 0 to 1
		xW = xD0 + min(2.4, lD * 0.35) + 0.7 + k * 1.1
		material "tc_dark"
		add xW, dkY - dkW * 0.28, 1.65
		rotx -90
		cylind dkW * 0.56, 0.42
		del 2
		material "tc_steel"
		for s = -1 to 1 step 2
			add xW, dkY + s * dkW * 0.3 - 0.03, 1.65
			rotx -90
			cylind 0.06, 0.55
			del 2
		next s
	next k
	! カウンタウエイト（塊を並べる）
	material "tc_cw"
	nCw = max(2, int(cwW / 0.8))
	for k = 0 to nCw - 1
		add -tailR, dkY - cwW / 2 + k * cwW / nCw + 0.01, 0.6
		block cwL, cwW / nCw - 0.02, cwH
		del 1
	next k
	! 運転室（旋回体の前の右。前面が斜めに傾く。前後 cbL・幅 cbW・上面 cbZ・高さ cbH）
	yR = dkY - dkW / 2
	zC = cbZ - cbH
	material "tc_band"
	add 0, yR + cbW, 0
	rotx 90
	prism 5, cbW, upF - cbL, zC, upF - 0.35, zC, upF, zC + cbH * 0.45, upF - 0.2, cbZ, upF - cbL, cbZ
	del 2
	material "tc_glass"
	add 0, yR + cbW - 0.06, 0
	rotx 90
	prism 4, cbW - 0.12, upF - 0.33, zC + 0.03, upF + 0.01, zC + cbH * 0.45, upF - 0.19, cbZ - 0.06, upF - 0.22, cbZ - 0.08
	del 2
	add 0, yR + 0.004, 0
	rotx 90
	prism 4, 0.008, upF - cbL + 0.12, zC + cbH * 0.35, upF - 0.22, zC + cbH * 0.35, upF - 0.26, cbZ - 0.12, upF - cbL + 0.12, cbZ - 0.12
	del 2
	return

"luffjib":
	! 起伏ジブ: Aフレーム（2 本の柱・後ろの控え・はしご・頂部のシーブ）・ラチスジブ（根元を絞る）・ペンダントと継ぎ金具
	material "tc_body"
	for s = -1 to 1 step 2
		rq = 0.14
		x0q = pvX - 0.6
		y0q = s * dkW * 0.4
		z0q = 1.1
		x1q = -frX
		y1q = s * 0.4
		z1q = frH
		gosub "seg3"
		rq = 0.09
		x0q = -tailR + cwL + 0.3
		gosub "seg3"
	next s
	! はしご
	material "tc_steel"
	nL = int((frH - 1.2) / 0.5)
	for k = 1 to nL
		tL = k / (nL + 1)
		add pvX - 0.6 + (-frX - pvX + 0.6) * tL, -0.3, 1.1 + (frH - 1.1) * tL
		block 0.03, 0.6, 0.03
		del 1
	next k
	add -frX, -0.3, frH
	rotx -90
	cylind 0.6, 0.35
	del 2
	add pvX, 0, pvH
	roty -jbA
	resol 6
	lRt = min(jbL * 0.35, 8.9)
	rcj = jbW * 0.045
	! 主弦材（根元は 2 本の耳へ絞る）
	material "tc_body"
	for sy = -1 to 1 step 2
		for sz = -1 to 1 step 2
			x0q = 0
			y0q = sy * jbW * 0.32
			z0q = sz * jbW * 0.12
			x1q = lRt
			y1q = sy * jbW / 2
			z1q = sz * jbW / 2
			rq = rcj
			gosub "seg3"
			x0q = lRt
			y0q = y1q
			z0q = z1q
			x1q = jbL
			gosub "seg3"
		next sz
	next sy
	nP = max(4, int(jbL / (jbW * 0.95)))
	pP = jbL / nP
	rq = rcj * 0.55
	for i = 0 to nP - 1
		sg = 1 - 2 * (i mod 2)
		! 3 節ごとの塗り分け
		if int(i / 3) mod 2 = 0 then
			material "tc_body"
		else
			material "tc_band"
		endif
		hA = jbW / 2
		zA = jbW / 2
		xq = i * pP
		if xq < lRt then
			hA = jbW * (0.32 + 0.18 * xq / lRt)
			zA = jbW * (0.12 + 0.38 * xq / lRt)
		endif
		hBq = jbW / 2
		zBq = jbW / 2
		xq = (i + 1) * pP
		if xq < lRt then
			hBq = jbW * (0.32 + 0.18 * xq / lRt)
			zBq = jbW * (0.12 + 0.38 * xq / lRt)
		endif
		x0q = i * pP
		x1q = x0q + pP
		y0q = -sg * hA
		y1q = sg * hBq
		z0q = zA
		z1q = zBq
		gosub "seg3"
		z0q = -zA
		z1q = -zBq
		gosub "seg3"
		y0q = hA
		y1q = hBq
		z0q = -sg * zA
		z1q = sg * zBq
		gosub "seg3"
		y0q = -hA
		y1q = -hBq
		gosub "seg3"
	next i
	resol 8
	! ジブの先（側板とシーブ）
	material "tc_steel"
	for s = -1 to 1 step 2
		add jbL - 0.3, s * jbW * 0.4 - 0.03, -jbW / 2
		block 1.0, 0.06, jbW
		del 1
	next s
	add jbL + 0.4, -0.2, 0
	rotx -90
	cylind 0.4, 0.45
	del 2
	del 2
	! ペンダント 2 本と継ぎ金具
	material "tc_steel"
	xM = -frX + (jX + frX) * 0.45
	zM = frH + (jZ - zR - frH) * 0.45
	add xM - 0.3, -0.45, zM - 0.1
	block 0.6, 0.9, 0.2
	del 1
	for s = -1 to 1 step 2
		rq = 0.025
		x0q = -frX
		y0q = s * 0.2
		z0q = frH
		x1q = xM
		y1q = s * 0.4
		z1q = zM
		gosub "seg3"
		x0q = xM
		y0q = s * 0.4
		z0q = zM
		x1q = jX
		y1q = s * jbW / 4
		z1q = jZ - zR
		gosub "seg3"
	next s
	return

"flatjib":
	! 水平ジブ: 塔頭・三角断面のジブ（下弦2本・上弦1本と斜材）・カウンタジブ・タイバー・トロリ
	jbHt = jbW * 0.9
	material "tc_body"
	for s = -1 to 1 step 2
		rq = 0.1
		x0q = s * msW / 2
		y0q = -msW / 2
		z0q = 0.6
		x1q = 0
		y1q = 0
		z1q = frH
		gosub "seg3"
		y0q = msW / 2
		gosub "seg3"
	next s
	resol 6
	rcj = 0.035 + 0.02 * jbW
	rq = rcj
	for s = -1 to 1 step 2
		x0q = pvX
		y0q = s * jbW / 2
		z0q = pvH
		x1q = jX
		y1q = y0q
		z1q = pvH
		gosub "seg3"
		x0q = -tailR + cwL
		x1q = 0
		gosub "seg3"
	next s
	x0q = pvX
	y0q = 0
	z0q = pvH + jbHt
	x1q = jX
	y1q = 0
	z1q = pvH + jbHt
	gosub "seg3"
	nP = max(2, int(jbL / jbW))
	pP = jbL / nP
	rq = rcj * 0.5
	for i = 0 to nP - 1
		for s = -1 to 1 step 2
			x0q = pvX + i * pP
			y0q = s * jbW / 2
			z0q = pvH
			x1q = x0q + pP / 2
			y1q = 0
			z1q = pvH + jbHt
			gosub "seg3"
			x0q = x1q + pP / 2
			gosub "seg3"
		next s
	next i
	resol 8
	material "tc_steel"
	for s = -1 to 1 step 2
		rq = 0.03
		x0q = 0
		y0q = 0
		z0q = frH
		x1q = pvX + jbL * 0.6
		y1q = 0
		z1q = pvH + jbHt
		gosub "seg3"
		x1q = -tailR + cwL + 0.5
		y1q = s * jbW / 2
		z1q = pvH
		gosub "seg3"
	next s
	material "tc_dark"
	add hX - 0.6, -jbW / 2 - 0.1, pvH - 0.5
	block 1.2, jbW + 0.2, 0.4
	del 1
	return

"lights":
	! 航空障害灯（60m 以上。塔頂＝Aフレーム頂部とジブ先端、ジブが長ければ途中にも）
	material "tc_light"
	add -frX, 0, frH + 0.3
	sphere 0.25
	del 1
	add jX, 0, jZ - zR + 0.4
	sphere 0.25
	del 1
	nMid = avN - 1
	for i = 1 to nMid
		fq = i / (nMid + 1)
		add pvX + (jX - pvX) * fq, 0, pvH + (jZ - zR - pvH) * fq + jbW / 2 + 0.25
		sphere 0.2
		del 1
	next i
	return

"hook":
	! ワイヤ（2本）とフック（旋回の向きに作業半径 hX）
	cS = cos(slew)
	sS = sin(slew)
	zT = jZ
	if tcType = 2 then zT = zR + pvH - 0.5
	material "tc_steel"
	for s = -1 to 1 step 2
		add hX * cS - s * 0.12 * sS, hX * sS + s * 0.12 * cS, hZ + 0.8
		cylind max(0.1, zT - hZ - 0.8), 0.015
		del 1
	next s
	add hX * cS, hX * sS, hZ
	rotz slew
	material "tc_hook"
	for s = -1 to 1 step 2
		add 0, s * 0.2 - 0.02, 0.5
		rotx -90
		cylind 0.04, 0.36
		del 2
	next s
	material "tc_steel"
	add 0, -0.18, 0.5
	rotx -90
	cylind 0.36, 0.3
	del 2
	add 0, 0, -0.1
	cylind 0.25, 0.07
	del 1
	material "tc_hook"
	add 0, 0.04, -0.62
	mul 1.2, 1, 1.2
	rotx 90
	prism 15, 0.08, -0.04, 0.45, 0.04, 0.45, 0.05, 0.32, 0.17, 0.2, 0.19, 0.09, 0.12, 0.01, 0, 0, -0.13, 0.05, -0.19, 0.14, -0.13, 0.2, -0.1, 0.13, -0.03, 0.08, 0.07, 0.09, 0.1, 0.15, -0.03, 0.26
	del 3
	del 2
	return

