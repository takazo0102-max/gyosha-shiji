! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! タワークレーン: 形式の一覧
values{2} "tcType" 1, "起伏ジブ", 2, "水平ジブ"
mq = GLOB_MODPAR_NAME
if msStep and mq = "msH" then parameters msH = max(1, int(msH / max(0.5, msSeg) + 0.5)) * msSeg
if (mq = "hfX" or mq = "hfY") and abs(hfX) + abs(hfY) > 0.1 then
	! 平面のフックを引いた: 横は旋回、前後は起伏ジブの角度かトロリの半径
	if abs(hfX) < 0.0001 then
		aF = 90 + 180 * (hfY < 0)
	else
		aF = atn(hfY / hfX) + 180 * (hfX < 0)
		if aF < 0 then aF = aF + 360
	endif
	rF = sqr(hfX * hfX + hfY * hfY)
	if tcType = 2 then
		parameters slew = aF, trR = rF
	else
		parameters slew = aF, jbA = acs(max(-1, min(1, (rF - pvX) / jbL)))
	endif
else
	if abs(hfX - hX * cos(slew)) + abs(hfY - hX * sin(slew)) > 0.001 then parameters hfX = hX * cos(slew), hfY = hX * sin(slew)
endif
! 作業半径の表示（scripts/gdl_radii.py）
values "wiNum" range [0, 5]
wMp = GLOB_MODPAR_NAME
values "wiR1" range [0.5, ]
if wMp = "wiM1" then
	parameters wiA1 = wiM1 - wiSq[1] / 2, wiB1 = wiM1 + wiSq[1] / 2
else
	if abs(wiM1 - wiMq[1]) > 0.001 then parameters wiM1 = wiMq[1]
endif
hideparameter "wiM1"
if nWi < 1 then
	hideparameter "wiR1", "wiA1", "wiB1", "wiF1"
endif
values "wiR2" range [0.5, ]
if wMp = "wiM2" then
	parameters wiA2 = wiM2 - wiSq[2] / 2, wiB2 = wiM2 + wiSq[2] / 2
else
	if abs(wiM2 - wiMq[2]) > 0.001 then parameters wiM2 = wiMq[2]
endif
hideparameter "wiM2"
if nWi < 2 then
	hideparameter "wiR2", "wiA2", "wiB2", "wiF2"
endif
values "wiR3" range [0.5, ]
if wMp = "wiM3" then
	parameters wiA3 = wiM3 - wiSq[3] / 2, wiB3 = wiM3 + wiSq[3] / 2
else
	if abs(wiM3 - wiMq[3]) > 0.001 then parameters wiM3 = wiMq[3]
endif
hideparameter "wiM3"
if nWi < 3 then
	hideparameter "wiR3", "wiA3", "wiB3", "wiF3"
endif
values "wiR4" range [0.5, ]
if wMp = "wiM4" then
	parameters wiA4 = wiM4 - wiSq[4] / 2, wiB4 = wiM4 + wiSq[4] / 2
else
	if abs(wiM4 - wiMq[4]) > 0.001 then parameters wiM4 = wiMq[4]
endif
hideparameter "wiM4"
if nWi < 4 then
	hideparameter "wiR4", "wiA4", "wiB4", "wiF4"
endif
values "wiR5" range [0.5, ]
if wMp = "wiM5" then
	parameters wiA5 = wiM5 - wiSq[5] / 2, wiB5 = wiM5 + wiSq[5] / 2
else
	if abs(wiM5 - wiMq[5]) > 0.001 then parameters wiM5 = wiMq[5]
endif
hideparameter "wiM5"
if nWi < 5 then
	hideparameter "wiR5", "wiA5", "wiB5", "wiF5"
endif
if (1) = 0 then
	hideparameter "wiNum", "wiPen"
endif
! 吊り点の印（scripts/gdl_mark.py）
hideparameter "mkZ"
if 1 then
	if GLOB_MODPAR_NAME = "mkZ" then
		parameters hkD = max(0.5, jZ - mkZ - slgH)
	else
		if abs(mkZ - (hZ - slgH)) > 0.001 then parameters mkZ = hZ - slgH
	endif
else
	hideparameter "slgOn", "slgH"
endif
values "slgH" range [0, ]
! 機種を選ぶと、src/ashiba/tower.py の寸法を書き込む（gen_tower_gdl.py が書き出す）
dim mdV[], mdS[]
mdV[1] = 0
mdS[1] = "手入力"
mdV[2] = 1
mdS[2] = "タワークレーン 27.5t"
mdV[3] = 2
mdS[3] = "タワークレーン 25t"
mdV[4] = 3
mdS[4] = "タワークレーン 14t"
mdV[5] = 4
mdS[5] = "タワークレーン 14t（中型）"
mdV[6] = 5
mdS[6] = "タワークレーン 2.8t"
mdV[7] = 6
mdS[7] = "タワークレーン 2.8t（小川）"
values{2} "tcModel" mdV, mdS
if GLOB_MODPAR_NAME = "tcModel" then
	if tcModel = 1 then
		parameters tcName = "タワークレーン 27.5t", tcNote = "北川鉄工所 JCL730NKD・ジブ 32m"
		parameters rtR = "3000,5000,26500,28000,30000,32000"
		parameters rtT = "2200,2750,2750,2570,2350,2150"
		parameters tcClr = 1, tcType = 1, msW = 1.9, msH = 51.455, msSeg = 6, baseW = 4.6, baseD = 1.5, tailR = 6.6
		parameters cwW = 4.32, cwH = 2, cwL = 1.5, dkW = 6.8, dkY = -0.7, upF = 2.26, frH = 13.151, frX = 4.1
		parameters cbL = 1.2, cbW = 1.1, cbZ = 2.72, cbH = 2.3, pvX = -2.49, pvH = 1.02, jbL = 35.72, jbA = 52.61
		parameters jbW = 2.3, hkD = 10, maxR = 32, tieA = 180, tieL = 2, avN = 1
	endif
	if tcModel = 2 then
		parameters tcName = "タワークレーン 25t", tcNote = "タダノ（旧IHI運搬機械）JCC-V600S・ジブ 32m"
		parameters rtR = "0,3500,27000,28000,30000,32000"
		parameters rtT = "1000,2500,2500,2384,2180,2000"
		parameters tcClr = 2, tcType = 1, msW = 1.9, msH = 38.954, msSeg = 6, baseW = 4.313, baseD = 1.5, tailR = 8.1
		parameters cwW = 3.938, cwH = 2, cwL = 1.5, dkW = 6.717, dkY = -0.898, upF = 2.77, frH = 12.15, frX = 5.1
		parameters cbL = 1.8, cbW = 1.1, cbZ = 3.2, cbH = 2.1, pvX = -3.1, pvH = 0.1, jbL = 41.6, jbA = 57.58
		parameters jbW = 2.39, hkD = 10, maxR = 32, tieA = 180, tieL = 2, avN = 1
	endif
	if tcModel = 3 then
		parameters tcName = "タワークレーン 14t", tcNote = "タダノ（旧IHI運搬機械）JCC-TS300S・ジブ 23m"
		parameters rtR = "3000,22000,23000"
		parameters rtT = "1400,1400,1300"
		parameters tcClr = 2, tcType = 1, msW = 1.35, msH = 47.794, msSeg = 7.2, baseW = 4.25, baseD = 1.5, tailR = 6.6
		parameters cwW = 3.968, cwH = 2, cwL = 1.5, dkW = 5.866, dkY = -0.453, upF = 2.243, frH = 11.5, frX = 3.25
		parameters cbL = 1.8, cbW = 1.1, cbZ = 3.2, cbH = 2.1, pvX = -2.8, pvH = 1.3, jbL = 27.05, jbA = 52.14
		parameters jbW = 1.74, hkD = 10, maxR = 23, tieA = 180, tieL = 2, avN = 1
	endif
	if tcModel = 4 then
		parameters tcName = "タワークレーン 14t（中型）", tcNote = "北川鉄工所 JCL280GK（4本掛け）・ジブ 24m"
		parameters rtR = "3000,20000,22000,24000"
		parameters rtT = "1400,1400,1280,1150"
		parameters tcClr = 1, tcType = 1, msW = 1.35, msH = 46.755, msSeg = 7.2, baseW = 4.118, baseD = 1.5, tailR = 5
		parameters cwW = 4.57, cwH = 1.49, cwL = 0.79, dkW = 4.58, dkY = -0.56, upF = 1.7475, frH = 10.16, frX = 4
		parameters cbL = 1.81, cbW = 1.5, cbZ = 2.06, cbH = 1.56, pvX = 0.3, pvH = 1.706, jbL = 24.536, jbA = 54.92
		parameters jbW = 1.3, hkD = 10, maxR = 24, tieA = 180, tieL = 2, avN = 1
	endif
	if tcModel = 5 then
		parameters tcName = "タワークレーン 2.8t", tcNote = "北川鉄工所 JCL080SKA・ジブ 24m"
		parameters rtR = "3000,24000"
		parameters rtT = "280,280"
		parameters tcClr = 1, tcType = 1, msW = 1.17, msH = 41.663, msSeg = 7, baseW = 2.2, baseD = 1.5, tailR = 3.8
		parameters cwW = 2.4, cwH = 2, cwL = 1.5, dkW = 3.5, dkY = -0.25, upF = 1.359, frH = 9.719, frX = 3.1
		parameters cbL = 2, cbW = 1, cbZ = 2.27, cbH = 2.27, pvX = 0.8, pvH = 1.046, jbL = 24.018, jbA = 55.51
		parameters jbW = 1.33, hkD = 10, maxR = 24, tieA = 180, tieL = 2, avN = 1
	endif
	if tcModel = 6 then
		parameters tcName = "タワークレーン 2.8t（小川）", tcNote = "小川製作所 OTS-90NH・ジブ 20m"
		parameters rtR = "3000,20000"
		parameters rtT = "280,280"
		parameters tcClr = 1, tcType = 1, msW = 1.25, msH = 41.04, msSeg = 6, baseW = 4.073, baseD = 1.5, tailR = 3.967
		parameters cwW = 3.152, cwH = 2, cwL = 1.5, dkW = 4.07, dkY = -0.065, upF = 1.53, frH = 7.5, frX = 2.9
		parameters cbL = 1.8, cbW = 1.1, cbZ = 3.2, cbH = 2.1, pvX = -2.1, pvH = 0, jbL = 23, jbA = 52.19
		parameters jbW = 1.176, hkD = 10, maxR = 20, tieA = 180, tieL = 2, avN = 0
	endif
endif
values{2} "drMode" 0, "縮尺で自動", 1, "詳細（1/100）", 2, "標準（1/200）", 3, "簡略"

