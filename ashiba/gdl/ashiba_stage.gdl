! ==========================================================
! 内部ステージ足場（室内に格子に支柱を立て、最上段に全面の作業床・1つの範囲に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_stage/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_stage.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-24）: 内部足場の内部ステージ足場の機能追加して検証して。
! 原点＝外周の支柱の始めの角、faceAng で長手の向き。支柱の格子・各段の布材（両方向）・全面の作業床・外周の手すり・幅木・筋かい・はしご。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度      長手の向き（度。配置時に Python が入れる。+X＝長手、+Y＝短手）                     既定 0
!   spanU     文字列    長手のスパン mm カンマ区切り                                                       既定 "1829,1829,1829"
!   spanV     文字列    短手のスパン mm カンマ区切り                                                       既定 "1829,1829"
!   lvList    文字列    根がらみと各段の高さ mm（配置した高さから。最後が作業床）                          既定 "375,2175,3975"
!   deckH     長さ      作業床の高さ（配置した高さから）                                                   既定 3.975
!   deckList  文字列    ほかの段の作業床の高さ mm（配置した高さから。カンマ区切り。EVシャフトの各階など）  既定 ""
!   guardOn   ブール    最上段の外周の手すり・中桟・幅木（EVシャフトは壁が近いので無し）                   既定 1
!   postTop   長さ      支柱の天端（配置した高さから。0＝作業床の手すりの高さ。支保工は大引の下）          既定 0
!   footAxis  整数      階段の上: 段が変わる向き（0＝長手の支柱の列ごと、1＝短手）                         既定 0
!   footZ     文字列    階段の上: 支柱の列ごとの足元の高さ mm（zBase から。カンマ区切り。空＝平ら）        既定 ""
!   footNeg   文字列    階段の上: 列ごとの根がらみの高さ mm（配置した高さから。0＝共通の根がらみ）         既定 ""
!   zBase     長さ      足場の立つ高さ（配置した高さから。ジャッキの下端）                                 既定 0
!   stName    文字列    名前                                                                               既定 "内部ステージ足場"
!   lineMode  ブール    3Dを線で（軽い）                                                                   既定 0
!   matScaf   表面材    表面材（0＝既定）                                                                  既定 0
!   matDeck   表面材    床の表面材（0＝既定）                                                              既定 0
!   texSiz    実数      文字高mm                                                                           既定 2.5
!   penPost   PenColor  ペン: 支柱                                                                         既定 1
!   penLine   PenColor  ペン: 足場の線                                                                     既定 1
!   penDeck   PenColor  ペン: 床                                                                           既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 内部ステージ足場（室内に格子に支柱を立て、最上段に全面の作業床。利用者の指定 2026-10-24）。1つの範囲に1部品

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 内部ステージ足場 2D（平面）: 外形（太線）・支柱の格子（細線と小円）・全面の作業床の範囲・はしご・名前
! 利用者の指定（2026-10-24）: 内部足場の内部ステージ足場の機能追加して検証して
! 原点＝外周の支柱の始めの角、+X＝長手、+Y＝短手
! ============================================================
define style "stTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
rot2 faceAng
! リストを読む（mm→m）
dim su[], sv[], lv[]
nU = 0
s = spanU
while strlen(s) > 0 and nU < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nU = nU + 1
		su[nU] = v / 1000
	endif
endwhile
nV = 0
s = spanV
while strlen(s) > 0 and nV < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nV = nV + 1
		sv[nV] = v / 1000
	endif
endwhile
nL = 0
s = lvList
while strlen(s) > 0 and nL < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nL = nL + 1
		lv[nL] = v / 1000
	endif
endwhile
dim xu[], yv[]
xu[1] = 0
for i = 1 to nU
	xu[i + 1] = xu[i] + su[i]
next i
yv[1] = 0
for j = 1 to nV
	yv[j + 1] = yv[j] + sv[j]
next j
stLU = xu[nU + 1]
stLV = yv[nV + 1]
pen penLine
for i = 1 to nU + 1
	line2 xu[i], 0, xu[i], stLV
next i
for j = 1 to nV + 1
	line2 0, yv[j], stLU, yv[j]
next j
pen penDeck
! 全面の作業床（外周の手すりの内側）と斜めの網掛け
rect2 0.02, 0.02, stLU - 0.02, stLV - 0.02
xh = 0.6
while xh < stLU + stLV do
	x1 = max(0, xh - stLV)
	y1 = xh - x1
	x2 = min(stLU, xh)
	y2 = xh - x2
	if y1 > stLV then
		x1 = xh - stLV
		y1 = stLV
	endif
	line_type 3
	line2 x1, y1, x2, y2
	line_type 1
	xh = xh + 0.6
endwhile
pen penPost
for i = 1 to nU + 1
	for j = 1 to nV + 1
		circle2 xu[i], yv[j], 0.025
	next j
next i
! 外周の手すり（二重線。EVシャフトは壁が近いので無し）
if guardOn then rect2 -0.03, -0.03, stLU + 0.03, stLV + 0.03
! はしご（始めの角の外。外周の手すりが無いとき＝EVシャフトは内側のはしご口）
if guardOn then
	rect2 0.15, -0.45, 0.60, -0.10
	line2 0.15, -0.28, 0.60, -0.28
else
	rect2 0.15, 0.10, 0.60, 0.45
	line2 0.15, 0.10, 0.60, 0.45
	line2 0.15, 0.45, 0.60, 0.10
endif
hotspot2 0, 0
hotspot2 stLU, 0
hotspot2 stLU, stLV
hotspot2 0, stLV
set style "stTx"
add2 stLU / 2, stLV / 2
! 文字の向き（置いた角度＋面の向き）を 0〜360 に直して、左へ傾く（90〜270）なら返す
aTx = SYMB_ROTANGLE + faceAng
aTx = aTx - 360 * int(aTx / 360)
if aTx < 0 then aTx = aTx + 360
if aTx > 90.001 and aTx < 270.001 then rot2 180
text2 0, 0.15, stName
tDk = ""
if strlen(deckList) > 0 then tDk = "・ほかに床 " + deckList
text2 0, -0.25, "床高" + str((deckH - zBase) * 1000, 5, 0) + tDk + "（" + str(stLU * 1000, 5, 0) + "×" + str(stLV * 1000, 5, 0) + "）"
del top

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 内部ステージ足場 3D: 支柱の格子・根がらみと各段の布材（両方向）・最上段の全面の作業床・外周の手すり・中桟・幅木・
! 外周の構面の筋かい（5スパンごと）・はしご。原点＝外周の支柱の始めの角、+X＝長手、+Y＝短手
! ============================================================
pen penPost
resol 8
rotz faceAng
if matScaf > 0 then material matScaf
! リストを読む（mm→m）
dim su[], sv[], lv[]
nU = 0
s = spanU
while strlen(s) > 0 and nU < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nU = nU + 1
		su[nU] = v / 1000
	endif
endwhile
nV = 0
s = spanV
while strlen(s) > 0 and nV < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nV = nV + 1
		sv[nV] = v / 1000
	endif
endwhile
nL = 0
s = lvList
while strlen(s) > 0 and nL < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nL = nL + 1
		lv[nL] = v / 1000
	endif
endwhile
! ほかの段の作業床（EVシャフトの各階など。利用者の指定 2026-10-28: 内部足場はステージとEV部分）
dim dk[]
nD = 0
s = deckList
while strlen(s) > 0 and nD < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nD = nD + 1
		dk[nD] = v / 1000
	endif
endwhile
nD = nD + 1
dk[nD] = deckH
dim xu[], yv[]
xu[1] = 0
for i = 1 to nU
	xu[i + 1] = xu[i] + su[i]
next i
yv[1] = 0
for j = 1 to nV
	yv[j + 1] = yv[j] + sv[j]
next j
stLU = xu[nU + 1]
stLV = yv[nV + 1]
! 階段の上（利用者の指定 2026-10-28: 内部足場は階段でよく使う）: 支柱の列ごとの足元の高さ。fu[i]＋fv[j] が支柱 (i, j) の足元
dim fu[], fv[]
for i = 1 to nU + 1
	fu[i] = 0
next i
for j = 1 to nV + 1
	fv[j] = 0
next j
nF = 0
s = footZ
while strlen(s) > 0 and nF < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nF = nF + 1
		if footAxis = 0 and nF <= nU + 1 then fu[nF] = v / 1000
		if footAxis = 1 and nF <= nV + 1 then fv[nF] = v / 1000
	endif
endwhile
! 列ごとの根がらみ（段の上の支柱の最初のコマ。0＝共通）
dim fn[]
for i = 1 to 60
	fn[i] = 0
next i
nN = 0
s = footNeg
while strlen(s) > 0 and nN < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nN = nN + 1
		fn[nN] = v / 1000
	endif
endwhile
rP = 0.0243
topZ = deckH + 0.95
if postTop > 0 then topZ = postTop
if lineMode then
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			lin_ xu[i], yv[j], zBase + fu[i] + fv[j], xu[i], yv[j], topZ
		next j
	next i
else
	! 支柱とジャッキ
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			zf = zBase + fu[i] + fv[j]
			add xu[i], yv[j], zf
			cylind topZ - zf, rP
			del 1
			add xu[i] - 0.07, yv[j] - 0.07, zf - 0.01
			block 0.14, 0.14, 0.01
			del 1
		next j
	next i
	! 根がらみと各段の布材（両方向）
	! スパンごとに描き、両端の支柱の足元より下の布材は描かない（階段の上は段ごとに根がらみが上がる）
	for il = 1 to nL
		z = lv[il]
		for j = 1 to nV + 1
			for i = 1 to nU
				if z > zBase + max(fu[i], fu[i + 1]) + fv[j] + 0.05 then
					add xu[i], yv[j], z
					roty 90
					cylind su[i], 0.0214
					del 2
				endif
			next i
		next j
		for i = 1 to nU + 1
			for j = 1 to nV
				if z > zBase + fu[i] + max(fv[j], fv[j + 1]) + 0.05 then
					add xu[i], yv[j], z
					rotx -90
					cylind sv[j], 0.0214
					del 2
				endif
			next j
		next i
	next il
	! 階段の上の列ごとの根がらみ: 列の中（直角方向）と、足元の低い隣の列へ1スパン
	for k = 1 to nN
		if fn[k] > 0 then
			z = fn[k]
			if footAxis = 0 and k <= nU + 1 then
				add xu[k], 0, z
				rotx -90
				cylind stLV, 0.0214
				del 2
				for j = 1 to nV + 1
					if k > 1 then
						if fu[k - 1] < fu[k] then
							add xu[k - 1], yv[j], z
							roty 90
							cylind su[k - 1], 0.0214
							del 2
						endif
					endif
					if k <= nU then
						if fu[k + 1] < fu[k] then
							add xu[k], yv[j], z
							roty 90
							cylind su[k], 0.0214
							del 2
						endif
					endif
				next j
			endif
			if footAxis = 1 and k <= nV + 1 then
				add 0, yv[k], z
				roty 90
				cylind stLU, 0.0214
				del 2
				for i = 1 to nU + 1
					if k > 1 then
						if fv[k - 1] < fv[k] then
							add xu[i], yv[k - 1], z
							rotx -90
							cylind sv[k - 1], 0.0214
							del 2
						endif
					endif
					if k <= nV then
						if fv[k + 1] < fv[k] then
							add xu[i], yv[k], z
							rotx -90
							cylind sv[k], 0.0214
							del 2
						endif
					endif
				next i
			endif
		endif
	next k
	! 全面の作業床（スパンごとの踏板。隙間 5mm）。最上段と deckList の段
	if matDeck > 0 then material matDeck
	for id = 1 to nD
		for i = 1 to nU
			for j = 1 to nV
				add xu[i] + 0.0025, yv[j] + 0.0025, dk[id] + 0.021
				block su[i] - 0.005, sv[j] - 0.005, 0.045
				del 1
			next j
		next i
	next id
	if matScaf > 0 then material matScaf
	! 外周の手すり・中桟と幅木
	if guardOn then
	for hk = 1 to 2
		hh = 0.95
		if hk = 2 then hh = 0.45
		for sd = 0 to 1
			add 0, sd * stLV, deckH + hh
			roty 90
			cylind stLU, 0.0214
			del 2
			add sd * stLU, 0, deckH + hh
			rotx -90
			cylind stLV, 0.0214
			del 2
		next sd
	next hk
	for sd = 0 to 1
		add 0, sd * stLV - 0.006, deckH + 0.066
		block stLU, 0.012, 0.15
		del 1
		add sd * stLU - 0.006, 0, deckH + 0.066
		block 0.012, stLV, 0.15
		del 1
	next sd
	endif
	! 外周の構面の筋かい（5スパンごと、各段のあいだ）
	for il = 1 to nL - 1
		z1 = lv[il] + 0.1
		z2 = lv[il + 1] - 0.1
		for i = 1 to nU
			if i - 1 - 5 * int((i - 1) / 5) = 0 and z1 > zBase + max(fu[i], fu[i + 1]) + max(fv[1], fv[nV + 1]) then
				for sd = 0 to 1
					ag = atn((z2 - z1) / su[i])
					add xu[i], sd * stLV, z1
					roty 90 - ag
					cylind sqr(su[i] ^ 2 + (z2 - z1) ^ 2), 0.0214
					del 2
				next sd
			endif
		next i
		for j = 1 to nV
			if j - 1 - 5 * int((j - 1) / 5) = 0 and z1 > zBase + max(fu[1], fu[nU + 1]) + max(fv[j], fv[j + 1]) then
				for sd = 0 to 1
					ag = atn((z2 - z1) / sv[j])
					add sd * stLU, yv[j], z1
					rotx -(90 - ag)
					cylind sqr(sv[j] ^ 2 + (z2 - z1) ^ 2), 0.0214
					del 2
				next sd
			endif
		next j
	next il
	! はしご（始めの角の外、作業床の上 0.9 まで）。外周の手すりが無いとき（EVシャフト）は壁が近いので内側に入れ、
	! 作業床ははしご口（ハッチ付きの踏板）で抜ける
	yLad = -0.25
	if not(guardOn) then yLad = 0.25
	for sd = 0 to 1
		add 0.20 + sd * 0.35, yLad, zBase + fu[1] + fv[1]
		cylind topZ - zBase - fu[1] - fv[1], 0.0175
		del 1
	next sd
	zr = zBase + fu[1] + fv[1] + 0.30
	while zr < topZ - 0.1 do
		add 0.20, yLad, zr
		roty 90
		cylind 0.35, 0.011
		del 2
		zr = zr + 0.30
	endwhile
endif
del top

