	k = split(item, "%n", v)
	if k > 0 then
		nSbL = nSbL + 1
		sbLs[nSbL] = v / 1000
	endif
endwhile
if nSbL < nSb then nSb = nSbL
if not(wlOn) then nWl = 0
yW = -faceY - wlGap
if nBayB < nBay then nBay = nBayB
if nPfY < nPf then nPf = nPfY
nBoard = 0
for i = 1 to nBn
	nBoard = nBoard + bdN[i]
next i
yF = -hH / 2 + hT2 + lagGap
hgt = zTop - zBot

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 山留め壁 2D（GL で切った平面。CAD の平面図の描き方: scripts/gdl_draft.py）: 鋼材の断面は塗り、矢板・パネルは外形、根切りの中の
! 切梁は隠れ線。詳細（1/100 まで）は桟木・継手の爪・管の厚さ、簡略（1/250 より小さい縮尺）は線と注記だけ
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "ywT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "ywT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
! 重なり: 10 矢板・パネル、30 鋼材の断面（塗り）、40 桟木・爪・線、50 文字
if drLv = 1 then
	drawindex 40
	pen pT
	if ywKind = 1 or ywKind >= 7 then
		line_type ltC
		line2 0, 0, ywL, 0
	endif
	line_type ltZ
	line2 0, -faceY, ywL, -faceY
	line_type ltS
endif
pen pO
if ywKind = 1 then
	! 親杭（H形鋼）と横矢板（掘削側のフランジの裏）・矢板止めの桟木
	drawindex 30
	if drLv < 3 then
		for i = 1 to nPile
			add2 pileX[i], 0
			fill fiS
			poly2_b 13, 7, pO, pO,
				-hB / 2, -hH / 2, 1,
				hB / 2, -hH / 2, 1,
				hB / 2, -hH / 2 + hT2, 1,
				hT1 / 2, -hH / 2 + hT2, 1,
				hT1 / 2, hH / 2 - hT2, 1,
				hB / 2, hH / 2 - hT2, 1,
				hB / 2, hH / 2, 1,
				-hB / 2, hH / 2, 1,
				-hB / 2, hH / 2 - hT2, 1,
				-hT1 / 2, hH / 2 - hT2, 1,
				-hT1 / 2, -hH / 2 + hT2, 1,
				-hB / 2, -hH / 2 + hT2, 1,
				-hB / 2, -hH / 2, -1
			del 1
		next i
	else
		for i = 1 to nPile
			line2 pileX[i] - hB / 2, 0, pileX[i] + hB / 2, 0
		next i
	endif
	pen pT
	for i = 1 to nBay
		drawindex 10
		rect2 bdA[i], yF, bdB[i], yF + lagT
		drawindex 40
		if drLv = 1 then
			rect2 bdA[i] + kak + 0.005, yF - skT, bdA[i] + kak + 0.005 + skW, yF
			rect2 bdB[i] - kak - 0.005 - skW, yF - skT, bdB[i] - kak - 0.005, yF
		endif
	next i
	yTx = hH / 2
endif
if ywKind >= 2 and ywKind <= 5 then
	! 鋼矢板: 1枚ずつの断面（U形は1枚おきに裏返す）。継手の爪は詳細だけ
	drawindex 30
	yB = 0
	if ywKind = 3 then yB = -(spH / 2 - spT / 2)
	for i = 1 to nU
		sgy = 1
		if spAlt and (i - 2 * int(i / 2)) = 0 then sgy = -1
		add2 (i - 1) * spW, 0
		mul2 1, sgy
		if drLv < 3 then
			for k = 1 to nPf
				k2 = k + 1
				if k2 > nPf then k2 = 1
				line2 pfX[k], pfY[k], pfX[k2], pfY[k2]
			next k
		else
			line2 0, 0, spW, 0
		endif
		del 2
		if drLv = 1 then circle2 (i - 1) * spW, yB, spT * 1.1
	next i
	yTx = spH / 2
endif
if ywKind = 6 then
	! たて込み簡易土留め: パネル（線の根切りの側）・スライドレール・切梁（隠れ線）
	drawindex 10
	for i = 1 to nPile - 1
		rect2 pileX[i], -pnT, pileX[i + 1], 0
	next i
	drawindex 30
	for i = 1 to nPile
		if drLv < 3 then
			fill fiS
			poly2_b 5, 7, pO, pO,
				pileX[i] - rlW / 2, -rlD, 1,
				pileX[i] + rlW / 2, -rlD, 1,
				pileX[i] + rlW / 2, 0, 1,
				pileX[i] - rlW / 2, 0, 1,
				pileX[i] - rlW / 2, -rlD, -1
		endif
	next i
	drawindex 40
	pen pT
	line_type ltH
	for i = 1 to min(nPile, nStr)
		if strL[i] > 0.01 then
			line2 pileX[i] - stDia / 2, -rlD, pileX[i] - stDia / 2, -rlD - strL[i]
			line2 pileX[i] + stDia / 2, -rlD, pileX[i] + stDia / 2, -rlD - strL[i]
		endif
	next i
	line_type ltS
	yTx = 0.05
endif
if ywKind = 7 then
	! SMW: 削孔の円（重なり）と芯材
	drawindex 10
	pen pT
	for i = 1 to nPile
		circle2 pileX[i], 0, smD / 2
	next i
	drawindex 30
	pen pO
	for i = 1 to nCore
		add2 coreP[i], 0
		if drLv < 3 then
			fill fiS
			poly2_b 13, 7, pO, pO,
				-hB / 2, -hH / 2, 1,
				hB / 2, -hH / 2, 1,
				hB / 2, -hH / 2 + hT2, 1,
				hT1 / 2, -hH / 2 + hT2, 1,
				hT1 / 2, hH / 2 - hT2, 1,
				hB / 2, hH / 2 - hT2, 1,
				hB / 2, hH / 2, 1,
				-hB / 2, hH / 2, 1,
				-hB / 2, hH / 2 - hT2, 1,
				-hT1 / 2, hH / 2 - hT2, 1,
				-hT1 / 2, -hH / 2 + hT2, 1,
				-hB / 2, -hH / 2 + hT2, 1,
				-hB / 2, -hH / 2, -1
		endif
		del 1
	next i
	yTx = smD / 2
endif
if ywKind = 8 then
	! 鋼管矢板と P-P 継手
	drawindex 30
	for i = 1 to nPile
		circle2 pileX[i], 0, tbD / 2
		if drLv = 1 then circle2 pileX[i], 0, tbD / 2 - tbT
		if i < nPile then circle2 (pileX[i] + pileX[i + 1]) / 2, 0, jD / 2
	next i
	yTx = tbD / 2
endif
if capOn and drLv < 3 then
	! 頭つなぎ（杭頭の溝形鋼）
	drawindex 30
	pen pO
	rect2 0, -faceY - capB, ywL, -faceY
endif
if nWl > 0 and drLv < 3 then
	! 腹起し・切梁・隅火打ち（GL の下なので隠れ線）
	drawindex 40
	pen pT
	line_type ltH
	line2 wlX0, yW, wlX1, yW
	line2 wlX0, yW - wlH, wlX1, yW - wlH
	for j = 1 to nSb
		line2 sbP[j] - wlB / 2, yW - wlH, sbP[j] - wlB / 2, yW - wlH - sbLs[j]
		line2 sbP[j] + wlB / 2, yW - wlH, sbP[j] + wlB / 2, yW - wlH - sbLs[j]
	next j
	if hiA > 0.01 then
		fw = -(yW - wlH)
		line2 fw, -fw - hiA, fw + hiA, -fw
		line2 fw + wlH * 0.707, -fw - hiA - wlH * 0.707, fw + hiA + wlH * 0.707, -fw - wlH * 0.707
	endif
	line_type ltS
endif
drawindex 50
pen penEquip
text2 ywL / 2, yTx + 0.15 + dT / 2, ywInfo
if drLv = 1 then text2 ywL / 2, yTx + 0.15 + dT * 1.5, ywName
hotspot2 0, 0
hotspot2 ywL, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 山留め壁 3D（規格の寸法。親杭 JIS G 3192・鋼矢板 日本製鉄 1-1・1-2・軽量鋼矢板 1-12・アルミ矢板 ホーシン・たて込み TSパネル・
! 鋼管矢板 JIS A 5530。横矢板は 1枚ずつ・くさび・矢板止めの桟木。根切りの段ごとに矢板の色を変える（stgCol））
define material "yw_steel" 2, 0.48, 0.30, 0.22
define material "yw_sheet" 2, 0.42, 0.40, 0.38
define material "yw_alu" 2, 0.80, 0.82, 0.85
define material "yw_lag1" 2, 0.82, 0.66, 0.42
define material "yw_lag2" 2, 0.66, 0.50, 0.30
define material "yw_lag3" 2, 0.74, 0.58, 0.36
define material "yw_sanki" 2, 0.90, 0.80, 0.58
define material "yw_wedge" 2, 0.55, 0.40, 0.22
define material "yw_smw" 2, 0.66, 0.66, 0.62
define material "yw_panel" 2, 0.30, 0.45, 0.62
define material "yw_rail" 2, 0.90, 0.62, 0.12
define material "yw_strut" 2, 0.20, 0.38, 0.72
define material "yw_wale" 2, 0.72, 0.16, 0.12
resol 16
if ywKind = 1 then
	! ---- 親杭（H形鋼。フランジが山留めの線に平行） ----
	material "yw_steel"
	for i = 1 to nPile
		add pileX[i], 0, zBot
		prism_ 12, hgt,
			-hB / 2, -hH / 2, 15,
			hB / 2, -hH / 2, 15,
			hB / 2, -hH / 2 + hT2, 15,
			hT1 / 2, -hH / 2 + hT2, 15,
			hT1 / 2, hH / 2 - hT2, 15,
			hB / 2, hH / 2 - hT2, 15,
			hB / 2, hH / 2, 15,
			-hB / 2, hH / 2, 15,
			-hB / 2, hH / 2 - hT2, 15,
			-hT1 / 2, hH / 2 - hT2, 15,
			-hT1 / 2, -hH / 2 + hT2, 15,
			-hB / 2, -hH / 2 + hT2, 15
		del 1
	next i
	! ---- 横矢板（掘削側のフランジの裏。上から1枚ずつ、根切りの段ごとに色）・くさび ----
	kb = 0
	for s = 1 to nBn
		mt = 1
		if stgCol then mt = s - 3 * int((s - 1) / 3)
		for j = 1 to bdN[s]
			kb = kb + 1
			zb = -kb * lagW
			for i = 1 to nBay
				if mt = 1 then material "yw_lag1"
				if mt = 2 then material "yw_lag2"
				if mt = 3 then material "yw_lag3"
				add bdA[i], yF, zb
				block bdB[i] - bdA[i], lagT, lagW - 0.003
				del 1
				material "yw_wedge"
				for sd = 1 to 2
					xw = bdA[i] + kak / 2 - 0.02
					if sd = 2 then xw = bdB[i] - kak / 2 - 0.02
					add xw, yF - lagGap, zb + lagW * 0.1
					block 0.04, lagGap, lagW * 0.35
					addz lagW * 0.45
					block 0.04, lagGap, lagW * 0.35
					del 2
				next sd
			next i
		next j
	next s
	! ---- 矢板止めの桟木（バイの両端・フランジの脇に縦に。根切りの段ごと） ----
	material "yw_sanki"
	kb = 0
	for s = 1 to nBn
		z1 = -kb * lagW
		kb = kb + bdN[s]
		z2 = -kb * lagW
		if z1 - z2 > 0.01 then
			for i = 1 to nBay
				add bdA[i] + kak + 0.005, yF - skT, z2 + 0.005
				block skW, skT, z1 - z2 - 0.01
				del 1
				add bdB[i] - kak - 0.005 - skW, yF - skT, z2 + 0.005
				block skW, skT, z1 - z2 - 0.01
				del 1
			next i
		endif
	next s
endif
if ywKind >= 2 and ywKind <= 5 then
	! ---- 鋼矢板: 1枚ずつ断面を押し出す（U形は1枚おきに裏返す）・継手の爪 ----
	material "yw_sheet"
	if ywKind = 5 then material "yw_alu"
	yB = 0
	if ywKind = 3 then yB = -(spH / 2 - spT / 2)
	for i = 1 to nU
		sgy = 1
		if spAlt and (i - 2 * int(i / 2)) = 0 then sgy = -1
		add (i - 1) * spW, 0, zBot
		mul 1, sgy, 1
		for k = 1 to nPf
			put pfX[k], pfY[k]
		next k
		prism nPf, hgt, get(nsp)
		del 2
		add (i - 1) * spW, yB, zBot
		cylind hgt, spT * 1.1
		del 1
	next i
endif
if ywKind = 6 then
	! ---- たて込み簡易土留め: スライドレール（頭は GL の上）・パネルの積み（リブ付き）・切梁（サポートジャッキ） ----
	material "yw_rail"
	for i = 1 to nPile
		add pileX[i] - rlW / 2, -rlD, zBot
		block rlW, rlD, hgt
		del 1
	next i
	material "yw_panel"
	for i = 1 to nPile - 1
		zp = zBot
		for k = 1 to nPn
			add pileX[i] + rlW / 2, -pnT, zp
			block pileX[i + 1] - pileX[i] - rlW, pnT, pnHs[k] - 0.005
			addz pnHs[k] * 0.33
			addy -0.03
			block pileX[i + 1] - pileX[i] - rlW, 0.03, 0.012
			addz pnHs[k] * 0.33
			block pileX[i + 1] - pileX[i] - rlW, 0.03, 0.012
			del 4
			zp = zp + pnHs[k]
		next k
	next i
	material "yw_strut"
	for i = 1 to min(nPile, nStr)
		if strL[i] > 0.01 then
			for k = 1 to nStz
				add pileX[i], -rlD, zBot + strZ[k]
				rotx 90
				cylind strL[i], stDia / 2
				cylind 0.35, stDia * 0.75
				del 2
			next k
		endif
	next i
endif
if ywKind = 7 then
	! ---- SMW: 削孔の円柱（重なり）と芯材（H形鋼） ----
	material "yw_smw"
	for i = 1 to nPile
		add pileX[i], 0, zBot
		cylind hgt, smD / 2
		del 1
	next i
	material "yw_steel"
	for i = 1 to nCore
		add coreP[i], 0, zBot
		prism_ 12, hgt,
			-hB / 2, -hH / 2, 15,
			hB / 2, -hH / 2, 15,
			hB / 2, -hH / 2 + hT2, 15,
			hT1 / 2, -hH / 2 + hT2, 15,
			hT1 / 2, hH / 2 - hT2, 15,
			hB / 2, hH / 2 - hT2, 15,
			hB / 2, hH / 2, 15,
			-hB / 2, hH / 2, 15,
			-hB / 2, hH / 2 - hT2, 15,
			-hT1 / 2, hH / 2 - hT2, 15,
			-hT1 / 2, -hH / 2 + hT2, 15,
			-hB / 2, -hH / 2 + hT2, 15
		del 1
	next i
endif
if ywKind = 8 then
	! ---- 鋼管矢板（管の厚さ）と P-P 継手 ----
	material "yw_steel"
	for i = 1 to nPile
		add pileX[i], 0, zBot
		roty -90
		revolve 4, 360, 0, 0, tbD / 2 - tbT, 0, hgt, tbD / 2 - tbT, 0, hgt, tbD / 2, 0, 0, tbD / 2, 0
		del 2
		if i < nPile then
			add (pileX[i] + pileX[i + 1]) / 2, 0, zBot
			cylind hgt, jD / 2
			del 1
		endif
	next i
endif
! ---- 腹起し（H形鋼を寝かせて壁から wlGap 離す）・ブラケット・切梁（向かいの辺の部品と合わせて1本） ----
for k = 1 to nWl
	zc = -wlv[k] + wlTier * wlH
	material "yw_wale"
	add wlX0, yW - wlH / 2, zc
	roty 90
	prism_ 12, wlX1 - wlX0,
		-wlB / 2, -wlH / 2, 15,
		wlB / 2, -wlH / 2, 15,
		wlB / 2, -wlH / 2 + wlT2, 15,
		wlT1 / 2, -wlH / 2 + wlT2, 15,
		wlT1 / 2, wlH / 2 - wlT2, 15,
		wlB / 2, wlH / 2 - wlT2, 15,
		wlB / 2, wlH / 2, 15,
		-wlB / 2, wlH / 2, 15,
		-wlB / 2, wlH / 2 - wlT2, 15,
		-wlT1 / 2, wlH / 2 - wlT2, 15,
		-wlT1 / 2, -wlH / 2 + wlT2, 15,
		-wlB / 2, -wlH / 2 + wlT2, 15
	del 2
	material "yw_steel"
	for i = 1 to nBr
		add brP[i] - 0.075, yW - wlH, zc - wlB / 2 - 0.016
		block 0.15, wlH + wlGap, 0.016
		del 1
		add brP[i] - 0.006, yW - wlH * 0.6, zc - wlB / 2 - 0.2
		block 0.012, wlH * 0.6 + wlGap, 0.184
		del 1
	next i
	material "yw_wale"
	for j = 1 to nSb
		if sbLs[j] > 0.01 then
			add sbP[j], yW - wlH, zc
			rotx 90
			prism_ 12, sbLs[j],
				-wlB / 2, -wlH / 2, 15,
				wlB / 2, -wlH / 2, 15,
				wlB / 2, -wlH / 2 + wlT2, 15,
				wlT1 / 2, -wlH / 2 + wlT2, 15,
				wlT1 / 2, wlH / 2 - wlT2, 15,
				wlB / 2, wlH / 2 - wlT2, 15,
				wlB / 2, wlH / 2, 15,
				-wlB / 2, wlH / 2, 15,
				-wlB / 2, wlH / 2 - wlT2, 15,
				-wlT1 / 2, wlH / 2 - wlT2, 15,
				-wlT1 / 2, -wlH / 2 + wlT2, 15,
				-wlB / 2, -wlH / 2 + wlT2, 15
			del 2
			! キリンジャッキ（切梁1本に1台、千鳥に: 向かいの辺の部品と交互）
			if (j + k - 2 * int((j + k) / 2)) = jkPar then
				material "yw_strut"
				add sbP[j] - jkW / 2, yW - wlH - jkL - 0.05, zc - jkW / 2
				block jkW, 0.028, jkW
				addy jkL - 0.028
				block jkW, 0.028, jkW
				del 2
				add sbP[j], yW - wlH - 0.05, zc
				rotx 90
				cylind jkL, 0.09
				del 2
				material "yw_wale"
			endif
		endif
	next j
	! 隅火打ち（始めの角・45°）と火打受ピース
	if hiA > 0.01 then
		fw = -(yW - wlH)
		add fw + wlH * 0.354, -fw - hiA - wlH * 0.354, zc
		rotz 45
		roty 90
		prism_ 12, hiA * 1.4142,
			-wlB / 2, -wlH / 2, 15,
			wlB / 2, -wlH / 2, 15,
			wlB / 2, -wlH / 2 + wlT2, 15,
			wlT1 / 2, -wlH / 2 + wlT2, 15,
			wlT1 / 2, wlH / 2 - wlT2, 15,
			wlB / 2, wlH / 2 - wlT2, 15,
			wlB / 2, wlH / 2, 15,
			-wlB / 2, wlH / 2, 15,
			-wlB / 2, wlH / 2 - wlT2, 15,
			-wlT1 / 2, wlH / 2 - wlT2, 15,
			-wlT1 / 2, -wlH / 2 + wlT2, 15,
			-wlB / 2, -wlH / 2 + wlT2, 15
		del 3
		material "yw_steel"
		add fw, -fw - hiA - 0.45, zc - 0.13
		block 0.18, 0.45, 0.26
		del 1
		add fw + hiA, -fw - 0.18, zc - 0.13
		block 0.45, 0.18, 0.26
		del 1
		material "yw_wale"
		if hiStub then
			! 前の辺の腹起しは別の段なので、火打ちの当たる所にこの段の短い受け材（H形鋼のフランジ2枚とウェブ）
			ys = -fw - hiA - 0.6
			add fw - wlH, ys, zc - wlB / 2
			block wlT2, hiA + 0.6, wlB
			addx wlH - wlT2
			block wlT2, hiA + 0.6, wlB
			del 2
			add fw - wlH, ys, zc - wlT1 / 2
			block wlH, hiA + 0.6, wlT1
			del 1
		endif
	endif
	if cnOn then
		! 隅部ピース（上下段の腹起しの角をつなぐ箱。30CN 445×400×260: ヒロセ p.15）
		material "yw_steel"
		fw = -(yW - wlH)
		add fw, -fw - 0.26, -wlv[k] + wlH / 2 - 0.2
		block 0.445, 0.26, 0.4
		del 1
		material "yw_wale"
	endif
next k
! ---- 頭つなぎ（自立の杭頭の溝形鋼。掘削側の面に） ----
if capOn then
	material "yw_wale"
	add 0, -faceY - 0.0065, zTop - capH
	block ywL, 0.0065, capH
	del 1
	add 0, -faceY - capB, zTop - 0.01
	block ywL, capB, 0.01
	del 1
	add 0, -faceY - capB, zTop - capH
	block ywL, capB, 0.01
	del 1
endif
end

