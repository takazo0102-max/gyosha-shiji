! ==========================================================
! 山留め壁（親杭横矢板・鋼矢板 U形/ハット形・軽量鋼矢板・アルミ矢板・たて込み簡易土留め・SMW・鋼管矢板。山留めの線の1辺に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_ywall/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_ywall.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-11-05）: 山留めの種類も増やして シートパイルや簡易山留めなど LOD高めて Hこう横やいたは矢板の平米拾えるようにしてかかりしろは厚みの分だけにして１次ねぎりと2次ねぎりで分けれるようにあと矢板を止めるさんぎも。
! 原点＝辺の始めの山留めの線の GL、+X＝辺の向き、−Y＝根切りの側。ywKind 1 親杭横矢板（H形鋼・横矢板1枚ずつ・くさび・矢板止めの桟木、根切りの段ごとに矢板の色）、2〜5 鋼矢板（1枚ずつの断面・継手）、6 たて込み簡易土留め（スライドレール・パネル・切梁）、7 SMW、8 鋼管矢板。割付・数量・検定は retaining.py、置くのは scripts/ywall_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   ywKind    整数      種類（1 親杭横矢板・2 U形鋼矢板・3 ハット形・4 軽量鋼矢板・5 アルミ矢板・6 たて込み簡易土留め・7 SMW・8 鋼管矢板）  既定 1
!   ywL       長さ      辺の長さ                                                                                                            既定 6
!   zTop      長さ      天端（GL から上。たて込みはレールの頭）                                                                             既定 0
!   zBot      長さ      先端（GL から。負。根入れを含む）                                                                                   既定 -5.5
!   digD      長さ      根切りの深さ（GL から下。正）                                                                                       既定 4
!   stD       文字列    根切りの段の底の深さ（mm。1次,2次…。最後は根切りの深さ）                                                            既定 "2000,4000"
!   pX        文字列    親杭・鋼矢板・SMW の孔・鋼管・レールの位置（mm。辺の始めから）                                                      既定 "0,1500,3000,4500"
!   ywName    文字列    名前                                                                                                                既定 "山留め1-1"
!   ywInfo    文字列    平面の注記（種類・型式・ピッチ・長さ）                                                                              既定 "親杭 H-300 @1500 L=5.5m・横矢板 t40"
!   texSiz    実数      文字の大きさ（mm）                                                                                                  既定 2.5
!   hH        長さ      H形鋼の高さ H（山留めの線に直角）                                                                                   既定 0.3
!   hB        長さ      H形鋼のフランジ幅 B（山留めの線に沿う）                                                                             既定 0.3
!   hT1       長さ      H形鋼のウェブの厚さ t1                                                                                              既定 0.01
!   hT2       長さ      H形鋼のフランジの厚さ t2                                                                                            既定 0.015
!   lagT      長さ      横矢板の厚さ                                                                                                        既定 0.04
!   lagW      長さ      横矢板の幅（高さの向き）                                                                                            既定 0.2
!   kak       長さ      掛かり代（矢板の厚さ）                                                                                              既定 0.04
!   lagGap    長さ      フランジと矢板のすき間（くさび）                                                                                    既定 0.015
!   lgA       文字列    バイごとの矢板の始め（mm）                                                                                          既定 "110,1610,3110"
!   lgB       文字列    バイごとの矢板の終わり（mm）                                                                                        既定 "1390,2890,4390"
!   lgN       文字列    根切りの段ごとの矢板の枚数（1次,2次…）                                                                              既定 "10,10"
!   skW       長さ      矢板止めの桟木の幅                                                                                                  既定 0.04
!   skT       長さ      矢板止めの桟木の厚さ                                                                                                既定 0.016
!   spW       長さ      鋼矢板の有効幅                                                                                                      既定 0.4
!   spT       長さ      鋼矢板の板厚                                                                                                        既定 0.013
!   spH       長さ      鋼矢板の有効高さ                                                                                                    既定 0.125
!   nU        整数      鋼矢板の枚数                                                                                                        既定 15
!   spAlt     ブール    1枚おきに裏返す（U形）                                                                                              既定 1
!   prX       文字列    鋼矢板1枚の断面の外形 x（mm）                                                                                       既定 "0,112,288,400,400,288,112,0"
!   prY       文字列    鋼矢板1枚の断面の外形 y（mm）                                                                                       既定 "6,62,62,6,-6,50,50,-6"
!   smD       長さ      SMW の削孔径                                                                                                        既定 0.55
!   coreX     文字列    SMW の芯材の位置（mm）                                                                                              既定 "0,450,900"
!   tbD       長さ      鋼管矢板の外径                                                                                                      既定 0.8
!   tbT       長さ      鋼管矢板の板厚                                                                                                      既定 0.012
!   jD        長さ      鋼管矢板の継手の管の外径（P-P）                                                                                     既定 0.1652
!   pnT       長さ      パネルの厚さ                                                                                                        既定 0.104
!   pnH       文字列    パネルの積み（下から高さ mm）                                                                                       既定 "2000,1000"
!   rlW       長さ      スライドレールの幅（線に沿う）                                                                                      既定 0.191
!   rlD       長さ      スライドレールの奥行き（根切りの側へ）                                                                              既定 0.204
!   stY       文字列    レールごとの切梁の長さ（根切りの中心まで。mm。0＝無し）                                                             既定 "1192,1192"
!   stZ       文字列    切梁の段の高さ（底から mm）                                                                                         既定 "700,2300"
!   stDia     長さ      切梁の太さ                                                                                                          既定 0.1143
!   stgCol    ブール    3D で根切りの段ごとに矢板の色を変える                                                                               既定 1
!   wlOn      ブール    腹起し・切梁を描く                                                                                                  既定 0
!   wlZ       文字列    腹起しの段（GL からの深さ mm。腹起しの芯）                                                                          既定 "1000"
!   wlH       長さ      腹起し・切梁の H形鋼の高さ                                                                                          既定 0.3
!   wlB       長さ      腹起し・切梁の H形鋼のフランジ幅                                                                                    既定 0.3
!   wlT1      長さ      腹起し・切梁の H形鋼のウェブの厚さ                                                                                  既定 0.01
!   wlT2      長さ      腹起し・切梁の H形鋼のフランジの厚さ                                                                                既定 0.015
!   wlGap     長さ      山留め壁と腹起しのすき間（裏込め）                                                                                  既定 0.1
!   wlX0      長さ      腹起しの始め（辺の始めから）                                                                                        既定 0.55
!   wlX1      長さ      腹起しの終わり                                                                                                      既定 4
!   brX       文字列    腹起しのブラケットの位置（mm）                                                                                      既定 "700,2500"
!   sbX       文字列    切梁の位置（mm）                                                                                                    既定 ""
!   sbL       文字列    切梁の長さ（腹起しの前の面から根切りの中心まで mm）                                                                 既定 ""
!   jkPar     整数      キリンジャッキを千鳥に（切梁 j・段 k の j+k が偶数で 0＝この辺の側・1＝向かい）                                     既定 0
!   jkL       長さ      キリンジャッキの長さ                                                                                                既定 0.5
!   jkW       長さ      キリンジャッキの端板の角                                                                                            既定 0.298
!   hiA       長さ      始めの角の隅火打ちの脚（腹起しの前の面から。0＝無し）                                                               既定 0
!   wlTier    整数      縦横の切梁: この辺の腹起しの段（0 下段・1 上段＝H 1本分上）                                                         既定 0
!   cnOn      ブール    縦横の切梁: 始めの角に隅部ピース（上下段の腹起しをつなぐ）                                                          既定 0
!   hiStub    ブール    縦横の切梁: 隅火打ちの前の辺の側に受けの短い腹起し（前の辺の腹起しが別の段）                                        既定 0
!   capOn     ブール    頭つなぎ（溝形鋼）を描く                                                                                            既定 0
!   capH      長さ      頭つなぎの溝形鋼の高さ                                                                                              既定 0.15
!   capB      長さ      頭つなぎの溝形鋼の幅                                                                                                既定 0.075
!   faceY     長さ      根切りの側の面（山留めの線から。平面に根切りの縁を二点鎖線で）                                                      既定 0.15
!   penBold   PenColor  外形の線（太線。置くときに線のペンと同じ色の太いペン）                                                              既定 21
!   penThin   PenColor  細部の線（細線。同じ色の細いペン）                                                                                  既定 1
!   penZone   PenColor  範囲の線（作業半径・後端旋回半径・立入禁止・旋回軌跡）                                                              既定 20
!   penMask   PenColor  上に載るものの背景の塗り（下の線を隠す。0＝隠さない）                                                               既定 19
!   drMode    整数      平面の描き分け（0 縮尺で自動・1 詳細 1/100・2 標準 1/200・3 簡略）                                                  既定 0
!   penEquip  PenColor  線のペン                                                                                                            既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 山留め壁: 並びを読む（m）
dim pileX[]
nPile = 0
rest = pX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPile = nPile + 1
		pileX[nPile] = v / 1000
	endif
endwhile
dim stgD[]
nStg = 0
rest = stD
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nStg = nStg + 1
		stgD[nStg] = v / 1000
