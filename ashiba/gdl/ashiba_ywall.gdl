		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nBn = nBn + 1
		bdN[nBn] = v / 1
	endif
endwhile
dim pfX[]
nPf = 0
rest = prX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
