! ==========================================================
! 足場ライン オブジェクト（くさび緊結式・1辺=1オブジェクト） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_line/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_line.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! アーキテクチャ決定（開発指示書2.1）:
!   部材1本ごとにオブジェクトを置かず、1つの辺を1つのGDLオブジェクトとし
!   内部で支柱・布材・踏板・手すり・幅木・ブレスをパラメトリック生成する。
!   Python側は割付を解いてこのオブジェクトを辺の数だけ置くのみ。
! ----------------------------------------------------------
! パラメータリスト:
!   spanList        文字列  スパン構成 mm カンマ区切り                                                                                既定 "1800,1800,1800"
!   spanList2       文字列  スパン構成（続き2）                                                                                       既定 ""
!   postList        文字列  支柱構成 mm 下から                                                                                        既定 "3600,3600,1800"
!   jackOut         長さ    ジャッキ繰り出し量                                                                                        既定 0.1
!   footStep        長さ    継ぎ足しの刻み m（コマピッチ／調整枠。0で継ぎ足し根がらみを描かない）                                     既定 0
!   komaPitch       長さ    コマピッチ                                                                                                既定 0.45
!   floorH          長さ    階高                                                                                                      既定 1.8
!   rowW            長さ    内外建地間隔                                                                                              既定 0.6
!   standoff        長さ    壁離れ                                                                                                    既定 0.3
!   deckW1          長さ    踏板1幅                                                                                                   既定 0.4
!   deckW2          長さ    踏板2幅 0で無し                                                                                           既定 0.25
!   showDeck        ブール  踏板表示                                                                                                  既定 1
!   showBrace       ブール  ブレス表示                                                                                                既定 1
!   showDim         ブール  2D寸法・注記表示                                                                                          既定 1
!   lineMode        ブール  3D線表示（計画初期・大規模向けの軽い表現）                                                                既定 0
!   planSimple      ブール  平面を単線で（建地列・支柱位置・床の対角線だけ）                                                          既定 0
!   mvoName         文字列  表示設定を読むライブラリグローバル部品名                                                                  既定 "ashiba_mvo"
!   serType         文字列  系列 A/B/W（Wは枠組）                                                                                     既定 "A"
!   viewMode        文字列  2D表現 plan=平面 / elev=立面                                                                              既定 "plan"
!   tieList         文字列  壁つなぎ位置 mm カンマ区切り（辺始点から）                                                                既定 ""
!   tieList2        文字列  壁つなぎ位置（続き2）                                                                                     既定 ""
!   tieList3        文字列  壁つなぎ位置（続き3）                                                                                     既定 ""
!   tieList4        文字列  壁つなぎ位置（続き4）                                                                                     既定 ""
!   tieList5        文字列  壁つなぎ位置（続き5）                                                                                     既定 ""
!   tieHeightList   文字列  壁つなぎ高さ mm カンマ区切り（GLから）                                                                    既定 ""
!   tieHeightList2  文字列  壁つなぎ高さ（続き2）                                                                                     既定 ""
!   tieHeightList3  文字列  壁つなぎ高さ（続き3）                                                                                     既定 ""
!   tieHeightList4  文字列  壁つなぎ高さ（続き4）                                                                                     既定 ""
!   tieHeightList5  文字列  壁つなぎ高さ（続き5）                                                                                     既定 ""
!   glList          文字列  支柱位置ごとの地盤高 mm（基準GLからの差、下がりは負）                                                     既定 ""
!   glList2         文字列  支柱位置ごとの地盤高（続き2）                                                                             既定 ""
!   jackList        文字列  支柱位置ごとのジャッキ繰出し mm（敷板調整含む）                                                           既定 ""
!   jackList2       文字列  支柱位置ごとのジャッキ繰出し（続き2）                                                                     既定 ""
!   shimList        文字列  支柱位置ごとの敷板調整 mm（ジャッキ繰出しの内数。敷板を重ねて描く）                                       既定 ""
!   shimList2       文字列  支柱位置ごとの敷板調整（続き2）                                                                           既定 ""
!   flList          文字列  各階FL高さ mm カンマ区切り（立面の参照線）                                                                既定 ""
!   faceName        文字列  面の名称（立面図の図面名）                                                                                既定 ""
!   levelList       文字列  作業床高さ mm カンマ区切り（GLから・立面ソルバの結果）                                                    既定 ""
!   negaH           長さ    根がらみ高さ GLから 0で自動                                                                               既定 0
!   railH           長さ    手すり高さ 作業床から 0で自動                                                                             既定 0
!   midH            長さ    中桟高さ 作業床から 0で自動                                                                               既定 0
!   railAdv         整数    手すり方式 0=布材（手すり＋中桟） 1=先行手すり（斜材が中桟を兼ねる）                                      既定 0
!   cornerS         整数    始点の出隅コーナー（外側建地・布材・踏板・幅木）をこの面が描く 0/1                                        既定 0
!   railIn          整数    躯体側（内側建地列）の手すり＋中桟を布材で組む 0/1                                                        既定 1
!   brktList        文字列  ブラケット区間 「開始,終了,幅,向き(1=内 -1=張出),高さ」の繰り返し mm                                      既定 ""
!   brktList2       文字列  ブラケット区間（続き2）                                                                                   既定 ""
!   brktList3       文字列  ブラケット区間（続き3）                                                                                   既定 ""
!   brktList4       文字列  ブラケット区間（続き4）                                                                                   既定 ""
!   stageList       文字列  荷受けステージ mm 「開始,長さ,出,設置高さ,方杖(0/1)」の繰り返し                                           既定 ""
!   hoistList       文字列  昇降機 mm 「位置,到達高さ」の繰り返し                                                                     既定 ""
!   landingList     文字列  昇降機の乗り込み口 mm 「位置,作業床高さ」の繰り返し                                                       既定 ""
!   beamList        文字列  梁枠 mm 「開始,スパン,梁下高さ」の繰り返し                                                                既定 ""
!   bridgeList      文字列  渡した凹み・張り出し・斜辺「開始,長さ,増える離れ,種別0凹み/1張り出し/2斜辺終点側深い/3斜辺始点側深い」mm  既定 ""
!   stairList       文字列  階段室の区間 mm 「開始,長さ」の繰り返し（辺の始点から）                                                   既定 ""
!   asagaoList      文字列  朝顔の設置高さ mm カンマ区切り（GLから）                                                                  既定 ""
!   asaCutList      文字列  朝顔を切り欠く区間 mm 「開始,終了」の繰り返し（昇降機の通る位置）                                         既定 ""
!   asagaoProj      長さ    朝顔の水平突出                                                                                            既定 2
!   asagaoAngle     実数    朝顔の傾斜 度                                                                                             既定 25
!   braceEveryS     整数    斜材の設置間隔 スパン 1=全構面                                                                            既定 1
!   braceEveryL     整数    斜材の設置間隔 層 1=全層                                                                                  既定 1
!   nRows           整数    建地列数 2=本足場 1=一側足場                                                                              既定 2
!   warnPen         整数    注記強調のペン番号 ペンテーブル依存                                                                       既定 20
!   texSiz          実数    文字高mm                                                                                                  既定 2.5
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! ============================================================
! 足場ライン マスタースクリプト（くさび緊結式・1辺=1オブジェクト）
! 配置規約: 原点=始点コーナー支柱（内側建地列）、+X=辺方向、+Y=躯体側
! 2D表現は viewMode で切替: plan=平面 / elev=立面
!
! 文字列リストのパースは gosub にせずインラインで展開している。
! マスタースクリプトでの gosub は動作しない環境があり、失敗すると
! 2D/3Dとも一切描画されない（実機で確認済み）。
! ============================================================
dim spans[60]
dim posts[40]
dim ties[200]
dim tieH[200]
dim gl[61]
dim jk[61]
dim sh[61]
dim fls[20]
dim lv[42]
dim levIn[40]
dim asa[8]
dim cutS[8]
dim cutE[8]
dim asgA[9]
dim asgB[9]
dim stS[8]
dim stL[8]
dim bmS[8]
dim bmL[8]
dim bmH[8]
dim brS[8]
dim brL[8]
dim brD[8]
dim brK[8]
dim sgS[8]
dim sgL[8]
dim sgP[8]
dim sgH[8]
dim sgZ[8]
dim hoP[4]
dim hoR[4]
dim hoW[4]
dim hoD[4]
dim hoTp[4]
dim laP[40]
dim laH[40]
dim bkS[24]
dim bkE[24]
dim bkW[24]
dim bkD[24]
dim bkH[24]
dim bkDW[24]

! ---- spanList をパース (mm→m) ----
nSpan = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! spanList2〜spanList2 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 2
	rest = spanList
	if tc = 2 then rest = spanList2
	while strlen(rest) > 0 and nSpan < 60 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nSpan = nSpan + 1
			spans[nSpan] = v / 1000
		endif
	endwhile
next tc
if nSpan = 0 then
	nSpan = 1
	spans[1] = 1.8
endif

! ---- postList をパース (mm→m) ----
nPost = 0
rest = postList
while strlen(rest) > 0 and nPost < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPost = nPost + 1
		posts[nPost] = v / 1000
	endif
endwhile
if nPost = 0 then
	nPost = 1
	posts[1] = 3.6
endif

! ---- tieList をパース (mm→m) ----
nTie = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! tieList2〜tieList5 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 5
	rest = tieList
	if tc = 2 then rest = tieList2
	if tc = 3 then rest = tieList3
	if tc = 4 then rest = tieList4
	if tc = 5 then rest = tieList5
	while strlen(rest) > 0 and nTie < 200 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nTie = nTie + 1
			ties[nTie] = v / 1000
		endif
	endwhile
next tc

! ---- tieHeightList をパース (mm→m) ----
nTieH = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! tieHeightList2〜tieHeightList5 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 5
	rest = tieHeightList
	if tc = 2 then rest = tieHeightList2
	if tc = 3 then rest = tieHeightList3
	if tc = 4 then rest = tieHeightList4
	if tc = 5 then rest = tieHeightList5
	while strlen(rest) > 0 and nTieH < 200 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nTieH = nTieH + 1
			tieH[nTieH] = v / 1000
		endif
	endwhile
next tc

! ---- glList をパース (mm→m) ----
! 敷地高低差: 支柱位置ごとの値。空なら平坦（従来どおり）。続きは glList2
nGl = 0
for tc = 1 to 2
	rest = glList
	if tc = 2 then rest = glList2
	while strlen(rest) > 0 and nGl < 61 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nGl = nGl + 1
			gl[nGl] = v / 1000
		endif
	endwhile
next tc

! ---- jackList をパース (mm→m) ----
! 敷地高低差: 支柱位置ごとの値。空なら平坦（従来どおり）。続きは jackList2
nJk = 0
for tc = 1 to 2
	rest = jackList
	if tc = 2 then rest = jackList2
	while strlen(rest) > 0 and nJk < 61 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nJk = nJk + 1
			jk[nJk] = v / 1000
		endif
	endwhile
next tc

! ---- shimList をパース (mm→m): 敷板で持ち上げた分（ジャッキ繰出しの内数） ----
nSh = 0
for tc = 1 to 2
	rest = shimList
	if tc = 2 then rest = shimList2
	while strlen(rest) > 0 and nSh < 61 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nSh = nSh + 1
			sh[nSh] = v / 1000
		endif
	endwhile
next tc

! ---- flList をパース (mm→m) ----
nFL = 0
rest = flList
while strlen(rest) > 0 and nFL < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nFL = nFL + 1
		fls[nFL] = v / 1000
	endif
endwhile

! ---- levelList をパース (mm→m) ----
! 作業床の高さはPython側の立面ソルバが決めた値をそのまま受け取る。
! GDLで komaPitch から再計算すると、コマの概念が無い枠組（komaPitch=0）で
! 破綻するうえ、ソルバの結果と図面がずれる。
nLevIn = 0
rest = levelList
while strlen(rest) > 0 and nLevIn < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nLevIn = nLevIn + 1
		levIn[nLevIn] = v / 1000
	endif
endwhile

! ---- brktList をパース「開始,終了,幅,向き,高さ」の繰り返し (mm→m) ----
! ブラケット区間は作業床の幅を局所的に変える。図面に出ないと、
! 実際より狭い（または広い）床を描いたままになる
nBk = 0
bkIdx = 0
bkA = 0
bkB = 0
bkC = 0
bkE0 = 0
bkF = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! brktList2〜brktList4 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 4
	rest = brktList
	if tc = 2 then rest = brktList2
	if tc = 3 then rest = brktList3
	if tc = 4 then rest = brktList4
	while strlen(rest) > 0 and nBk < 24 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			bkIdx = bkIdx + 1
			md = bkIdx - 6 * int(bkIdx / 6)   ! 1,2,3,4,5,0 の繰り返し
			if md = 1 then bkA = v / 1000
			if md = 2 then bkB = v / 1000
			if md = 3 then bkC = v / 1000
			if md = 4 then bkE0 = v
			if md = 5 then bkF = v / 1000
			if md = 0 then
				nBk = nBk + 1
				bkS[nBk] = bkA
				bkE[nBk] = bkB
				bkW[nBk] = bkC
				bkD[nBk] = bkE0
				bkH[nBk] = bkF
				bkDW[nBk] = v / 1000        ! 区間の床幅（0で変更なし）
			endif
		endif
	endwhile
next tc

! ---- bridgeList をパース「開始,長さ,増える離れ,種別(0=凹み/1=張り出し/2=斜辺 終点側深い/3=斜辺 始点側深い)」の繰り返し (mm→m) ----
! 最小スパン未満の凹み・張り出しは直線で渡す。実際の躯体線は離れが増えるので
! 平面に破線で示す（数量の要確認と同じ区間）
nBr = 0
brIdx = 0
brT1 = 0
brT2 = 0
brT3 = 0
rest = bridgeList
while strlen(rest) > 0 and nBr < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		brIdx = brIdx + 1
		md = brIdx - 4 * int(brIdx / 4)   ! 1,2,3,0 の繰り返し
		if md = 1 then brT1 = v / 1000
		if md = 2 then brT2 = v / 1000
		if md = 3 then brT3 = v / 1000
		if md = 0 then
			nBr = nBr + 1
			brS[nBr] = brT1
			brL[nBr] = brT2
			brD[nBr] = brT3
			brK[nBr] = v
		endif
	endif
endwhile

! ---- stageList をパース「開始,長さ,出,設置高さ,方杖」の繰り返し (mm→m) ----
! 方杖は0/1（数量拾いと同じ指定を使う。図だけ勝手に方杖を付けない）
! 荷受けステージは出1.5mの張り出し床。構造計算では直下の建地を個別に
! 検定しているのに、図面にも3Dにも出ていなかった
nSg = 0
sgIdx = 0
sgA = 0
sgB = 0
sgC = 0
sgD = 0
rest = stageList
while strlen(rest) > 0 and nSg < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		sgIdx = sgIdx + 1
		md = sgIdx - 5 * int(sgIdx / 5)   ! 1,2,3,4,0 の繰り返し
		if md = 1 then sgA = v / 1000
		if md = 2 then sgB = v / 1000
		if md = 3 then sgC = v / 1000
		if md = 4 then sgD = v / 1000
		if md = 0 then
			nSg = nSg + 1
			sgS[nSg] = sgA
			sgL[nSg] = sgB
			sgP[nSg] = sgC
			sgH[nSg] = sgD
			sgZ[nSg] = v                  ! 方杖 0/1（mm換算しない）
		endif
	endif
endwhile

! ---- hoistList をパース「位置,到達高さ,搬器幅,搬器奥行,控えピッチ」の繰り返し (mm→m) ----
! 昇降機は数量（乗り込み口の開閉式手すり）と構造（マストの局所荷重）には
! 出ていたのに、図面には現れていなかった。マストは足場の外に立つ大物なので
! 平面・立面・3Dに出して干渉を確認できるようにする
nHo = 0
hoIdx = 0
hoT = 0
rest = hoistList
while strlen(rest) > 0 and nHo < 4 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		hoIdx = hoIdx + 1
		hoM = hoIdx - 5 * int((hoIdx - 1) / 5)     ! 1..5
		if hoM = 1 then
			hoT = v / 1000
		endif
		if hoM = 2 then
			nHo = nHo + 1
			hoP[nHo] = hoT
			hoR[nHo] = v / 1000
			hoW[nHo] = 2.0
			hoD[nHo] = 2.0
			hoTp[nHo] = 3.6
		endif
		if hoM = 3 and nHo > 0 then hoW[nHo] = v / 1000
		if hoM = 4 and nHo > 0 then hoD[nHo] = v / 1000
		if hoM = 5 and nHo > 0 and v > 0 then hoTp[nHo] = v / 1000
	endif
endwhile

! ---- landingList をパース「位置,作業床高さ」の繰り返し (mm→m) ----
nLa = 0
laIdx = 0
laT = 0
rest = landingList
while strlen(rest) > 0 and nLa < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		laIdx = laIdx + 1
		if laIdx - 2 * int(laIdx / 2) = 1 then
			laT = v / 1000
		else
			nLa = nLa + 1
			laP[nLa] = laT
			laH[nLa] = v / 1000
		endif
	endif
endwhile

! 昇降機の見付け幅（ケージ＋マストの目安）。実機は機種で違うので図示用
HOIST_W = 2.0
HOIST_D = 2.0

! ---- beamList をパース「開始,スパン,梁下高さ」の繰り返し (mm→m) ----
! 梁枠は支柱を抜いて通路にする箇所。図面が抜いた支柱を描いたままだと、
! 実際には無い建地を図面が示すことになる
nBm = 0
bmIdx = 0
bmT1 = 0
bmT2 = 0
rest = beamList
while strlen(rest) > 0 and nBm < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		bmIdx = bmIdx + 1
		md = bmIdx - 3 * int(bmIdx / 3)   ! 1,2,0 の繰り返し
		if md = 1 then
			bmT1 = v / 1000
		endif
		if md = 2 then
			bmT2 = v / 1000
		endif
		if md = 0 then
			nBm = nBm + 1
			bmS[nBm] = bmT1
			bmL[nBm] = bmT2
			bmH[nBm] = v / 1000
		endif
	endif
endwhile

! ---- stairList をパース「開始,長さ」の繰り返し (mm→m) ----
! 階段室は数量（踏板の差引）にも帳票にも出るのに、図面に位置が
! 出ていなかった。昇降設備の位置は計画図の主要情報
nSt = 0
stTmp = 0
stIdx = 0
rest = stairList
while strlen(rest) > 0 and nSt < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		stIdx = stIdx + 1
		if stIdx - 2 * int(stIdx / 2) = 1 then
			stTmp = v / 1000
		else
			nSt = nSt + 1
			stS[nSt] = stTmp
			stL[nSt] = v / 1000
		endif
	endif
endwhile

! ---- asagaoList をパース (mm→m) ----
! 朝顔は数量にも法規チェックにも出るのに、図面にも3Dにも現れていなかった。
! 突出2mの部材なので、干渉確認のためにモデルへ出す
nAsa = 0
rest = asagaoList
while strlen(rest) > 0 and nAsa < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nAsa = nAsa + 1
		asa[nAsa] = v / 1000
	endif
endwhile

! ---- asaCutList をパース「開始,終了」の繰り返し (mm→m) ----
! 配列名に acS を使うと GDL 組込み関数 ACS()（逆余弦）と衝突して部品ごと壊れる
! （パラメータ設定が全部失敗する。半日の切り分けで判明）。cut〜 で統一
! 昇降機のマスト・搬器が通るスパンは朝顔を切り欠く。衝突検査が切り欠きを
! 指示するのに、図面と3Dは全長の板のままだった
nCut = 0
cutIdx = 0
cutT = 0
rest = asaCutList
while strlen(rest) > 0 and nCut < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		cutIdx = cutIdx + 1
		if cutIdx - 2 * int(cutIdx / 2) = 1 then
			cutT = v / 1000
		else
			nCut = nCut + 1
			cutS[nCut] = cutT
			cutE[nCut] = v / 1000
		endif
	endif
endwhile

! ---- 派生値 ----
lineLen = 0
for i = 1 to nSpan
	lineLen = lineLen + spans[i]
next i

! 朝顔の連続区間（切り欠きを除いた asgA〜asgB）。区間は Python 側で昇順・非重複
nAsg = 0
cutX = 0
for ic = 1 to nCut
	if cutS[ic] > cutX + 0.001 then
		nAsg = nAsg + 1
		asgA[nAsg] = cutX
		asgB[nAsg] = cutS[ic]
	endif
	cutX = cutE[ic]
next ic
if lineLen > cutX + 0.001 then
	nAsg = nAsg + 1
	asgA[nAsg] = cutX
	asgB[nAsg] = lineLen
endif
postTop = jackOut
for i = 1 to nPost
	postTop = postTop + posts[i]
next i
! 根がらみ高さ。negaH が渡されていればそれを使う（枠組は建枠脚部が相当）
firstLedger = negaH
if firstLedger <= 0 then firstLedger = jackOut + komaPitch

! レベル列: lv[1]=根がらみ、lv[2..nLv]=作業床（下から昇順）
lv[1] = firstLedger
if nLevIn > 0 then
	! Python側の立面ソルバが決めた作業床高さをそのまま使う
	nLevels = nLevIn
	for il = 1 to nLevels
		lv[il + 1] = levIn[il]
	next il
	topFloor = levIn[nLevels]
else
	! 単体で置いた場合のフォールバック（くさび式の積み方から推定）
	topFloor = postTop - 2 * komaPitch
	nLevels = 0
	h = topFloor
	while h > firstLedger + komaPitch do
		nLevels = nLevels + 1
		h = h - floorH
	endwhile
	for il = 1 to nLevels
		lv[il + 1] = topFloor - (nLevels - il) * floorH
	next il
endif
nLv = nLevels + 1

! 手すり・中桟の高さ（作業床から）。komaPitch の倍数で決め打ちすると
! コマの概念が無い枠組で 0 になり、手すりが作業床に重なって消える
railTop = railH
if railTop <= 0 then railTop = 2 * komaPitch
railMid = midH
if railMid <= 0 then railMid = komaPitch

! 壁つなぎは位置と高さの対。短い方に合わせる
nTiePair = nTie
if nTieH < nTiePair then nTiePair = nTieH

! 斜材の設置間隔。数量は「6層6スパン以下毎に交さ2方向」で拾っているので、
! 図面を全構面に描くと部材表と食い違う（発注40本に対し図面896本）
bEvS = braceEveryS
if bEvS < 1 then bEvS = 1
bEvL = braceEveryL
if bEvL < 1 then bEvL = 1

! 建地列。一側足場は1列で、建地は外側1列だけ立ち、床は躯体側へ張り出す。
! 列数を見ないと、一側足場の計画でも図面は本足場（2列）で描かれる
rowStart = 0
if nRows < 2 then rowStart = 1

r_sic  = 0.0486 / 2	! 支柱 φ48.6
r_nuno = 0.0427 / 2	! 布材 φ42.7
r_tie  = 0.0273 / 2	! 壁つなぎ φ27.2

! ---- 注記のレイアウト用（文字高は縮尺依存なので実寸を求めて行送りに使う）----
! GLOB_SCALE = 縮尺の分母（1/20なら20）。texSiz は用紙上のmm
txtH = texSiz * GLOB_SCALE / 1000
txtLine = txtH * 1.8

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 足場ライン 2Dスクリプト（viewMode で平面／立面を切替）
!   plan: 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体面 y=+standoff
!   elev: X=面に沿った距離 / Y=GLからの高さ
! ============================================================
define style "anno" "ＭＳ Ｐゴシック", texSiz, 1, 0
! 中央揃え。スパン寸法や部位名は基準点が中心でないと位置がずれて見える
define style "annoC" "ＭＳ Ｐゴシック", texSiz, 5, 0
set style "anno"
pen 1

! モデル表示オプション（ashiba_mvo）があればそちらが優先。無ければ部品の設定
! （planSimple / showDim）。図面の用途ごとに部品を1つずつ触らなくてよい
mvPlan = 0
mvNotes = 1
mvOk = LIBRARYGLOBAL(mvoName, "planMode", mvPlan)
if mvOk and mvPlan = 2 then planSimple = 1
if mvOk and mvPlan = 1 then planSimple = 0
if LIBRARYGLOBAL(mvoName, "planNotes", mvNotes) then showDim = mvNotes

if viewMode = "elev" then
	gosub 200
else
	if planSimple then
		gosub 950
	else
		gosub 100
	endif
endif
end

! ============================================================
950: ! ---- 平面 単線（割付検討用: 建地列・支柱位置・床の対角線・付帯設備の占有範囲） ----
line2 0, 0, lineLen, 0
line2 0, -rowW, lineLen, -rowW
x = 0
for ip = 1 to nSpan
	line2 x, 0, x, -rowW
	inStair = 0
	for it2 = 1 to nSt
		if x >= stS[it2] - 0.001 and x + spans[ip] <= stS[it2] + stL[it2] + 0.001 then inStair = 1
	next it2
	for ib3 = 1 to nBm
		if x >= bmS[ib3] - 0.001 and x + spans[ip] <= bmS[ib3] + bmL[ib3] + 0.001 then inStair = 1
	next ib3
	if inStair = 0 then line2 x, 0, x + spans[ip], -rowW
	x = x + spans[ip]
next ip
line2 lineLen, 0, lineLen, -rowW
! 階段室: 区間の中心線と矢印（始点側から上る）
for it2 = 1 to nSt
	line2 stS[it2], -rowW / 2, stS[it2] + stL[it2], -rowW / 2
	line2 stS[it2] + stL[it2], -rowW / 2, stS[it2] + stL[it2] - 0.15, -rowW / 2 - 0.10
	line2 stS[it2] + stL[it2], -rowW / 2, stS[it2] + stL[it2] - 0.15, -rowW / 2 + 0.10
next it2
! 付帯設備の占有範囲は破線（ステージ・張出しブラケット・昇降機）
line_type 3
for ig = 1 to nSg
	rect2 sgS[ig], -rowW, sgS[ig] + sgL[ig], -rowW - sgP[ig]
next ig
for ik = 1 to nBk
	if bkD[ik] > 0 then
		rect2 bkS[ik], 0, bkE[ik], bkW[ik]
	else
		rect2 bkS[ik], -rowW, bkE[ik], -rowW - bkW[ik]
	endif
next ik
for ih = 1 to nHo
	hx = hoP[ih]
	rect2 hx - hoW[ih] / 2, -rowW - 0.10, hx + hoW[ih] / 2, -rowW - 0.10 - hoD[ih]
next ih
line_type 1
hotspot2 0, 0
hotspot2 lineLen, 0
return

! ============================================================
100: ! ---- 平面図 ----
line2 0, 0, lineLen, 0
line2 0, -rowW, lineLen, -rowW

! スパン区切り線と布板の対角線。平面図で「作業床が敷いてある区画」を表す
! 慣用表記で、実務の足場平面図はこの見え方になる。対角線の向きは全スパン
! 揃える（向きを交互にするとブレスの表記と紛らわしい）。
x = 0
for ip = 1 to nSpan
	line2 x, 0, x, -rowW
	! 階段室の区間には踏板を敷かない（数量でも差し引いている）。
	! ここに対角線を引くと、敷いていない床を描くことになる
	inStair = 0
	for it2 = 1 to nSt
		if x >= stS[it2] - 0.001 and x + spans[ip] <= stS[it2] + stL[it2] + 0.001 then inStair = 1
	next it2
	! 開口部（梁枠の区間）も同じ。この平面は支柱を抜いた状態を描いているので、
	! 床だけ上層の状態を描くと1枚の図の中で辻褄が合わなくなる
	for ib3 = 1 to nBm
		if x >= bmS[ib3] - 0.001 and x + spans[ip] <= bmS[ib3] + bmL[ib3] + 0.001 then inStair = 1
	next ib3
	if showDeck and inStair = 0 then line2 x, -rowW, x + spans[ip], 0
	x = x + spans[ip]
next ip
line2 x, 0, x, -rowW

x = 0
for ip = 1 to nSpan + 1
	! 梁枠の内側の支柱は抜いてある。描くと実際には無い建地を示すことになる
	removed = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then removed = 1
	next ib
	if removed = 0 then
		! 一側足場は建地1列。躯体側の建地は無い（受けブラケットの腕は
		! スパン区切り線と重なるので平面には現れない。3Dには出している）
		if nRows >= 2 then circle2 x, 0, r_sic
		circle2 x, -rowW, r_sic
	endif
	hotspot2 x, 0
	if ip <= nSpan then x = x + spans[ip]
next ip

! 梁枠の区間（平面では太い二重線と文字）
for ib = 1 to nBm
	bs = bmS[ib]
	be = bs + bmL[ib]
	line2 bs, -rowW, be, -rowW
	line2 bs, -rowW - 0.06, be, -rowW - 0.06
	line2 bs, -rowW, bs, -rowW - 0.06
	line2 be, -rowW, be, -rowW - 0.06
	set style "annoC"
	if showDim then text2 (bs + be) / 2, -rowW - 0.20, "梁枠 " + str(bmL[ib] * 1000, 5, 0)
	set style "anno"
next ib
hotspot2 0, -rowW
hotspot2 lineLen, -rowW

! 始点の出隅コーナー（外側の升目。3Dと同じ規則でこの面が描く）
if cornerS = 1 then
	line2 -rowW, 0, -rowW, -rowW
	line2 -rowW, -rowW, 0, -rowW
	circle2 -rowW, -rowW, r_sic
	if showDeck then line2 -rowW, -rowW, 0, 0
endif

! 階段室（平面では区間を囲ってタスキと文字で示す）
for it2 = 1 to nSt
	sx = stS[it2]
	ex = sx + stL[it2]
	line2 sx, 0, sx, -rowW
	line2 ex, 0, ex, -rowW
	line2 sx, 0, ex, -rowW
	line2 sx, -rowW, ex, 0
	set style "annoC"
	if showDim then text2 (sx + ex) / 2, -rowW / 2, "階段"
	set style "anno"
next it2

! ブラケット区間（平面では拡幅ぶんの帯。層が複数でも平面では1本）
for ik = 1 to nBk
	drawn = 0
	for ij = 1 to ik - 1
		if bkS[ij] = bkS[ik] and bkE[ij] = bkE[ik] and bkD[ij] = bkD[ik] then drawn = 1
	next ij
	if drawn = 0 then
		if bkD[ik] > 0 then
			by1 = 0
			by2 = bkW[ik]
		else
			by1 = -rowW
			by2 = -rowW - bkW[ik]
		endif
		line2 bkS[ik], by2, bkE[ik], by2
		line2 bkS[ik], by1, bkS[ik], by2
		line2 bkE[ik], by1, bkE[ik], by2
		if showDim then
			bkTxt = "BR" + str(bkW[ik] * 1000, 4, 0)
			if bkDW[ik] > 0 then bkTxt = bkTxt + " 床" + str(bkDW[ik] * 1000, 4, 0)
			set style "annoC"
			text2 (bkS[ik] + bkE[ik]) / 2, by2 + (by2 - by1) * 0.25, bkTxt
			set style "anno"
		endif
	endif
next ik

! 荷受けステージ（平面では外側への張り出し外形）
for ig = 1 to nSg
	gs = sgS[ig]
	ge = gs + sgL[ig]
	gy = -rowW - sgP[ig]
	line2 gs, -rowW, gs, gy
	line2 ge, -rowW, ge, gy
	line2 gs, gy, ge, gy
	line2 gs, -rowW, ge, gy
	line2 gs, gy, ge, -rowW
	set style "annoC"
	if showDim then text2 (gs + ge) / 2, gy - 0.15, "荷受けステージ 出" + str(sgP[ig] * 1000, 4, 0)
	set style "anno"
next ig

! 昇降機（平面では搬器の占有範囲を破線で、その外側のマストを実線の0.30角で。
! 足場の外に立つ大物なので干渉と搬入経路の検討に要る。詳細図と同じく
! 外側建地から隙間0.10mを空ける）
for ih = 1 to nHo
	hx = hoP[ih]
	line_type 3
	rect2 hx - hoW[ih] / 2, -rowW - 0.10, hx + hoW[ih] / 2, -rowW - 0.10 - hoD[ih]
	line_type 1
	rect2 hx - 0.15, -rowW - 0.10 - hoD[ih], hx + 0.15, -rowW - 0.40 - hoD[ih]
	set style "annoC"
	if showDim then text2 hx, -rowW - hoD[ih] - 0.55, "昇降機"
	set style "anno"
next ih
line_type 1

! 朝顔の突出範囲（平面では外側への張り出し外形を破線で示す）
! 昇降機が通る区間（asaCutList）は切り欠いて描く
if nAsa > 0 then
	line_type 3
	for isg = 1 to nAsg
		line2 asgA[isg], -rowW - asagaoProj, asgB[isg], -rowW - asagaoProj
		line2 asgA[isg], -rowW, asgA[isg], -rowW - asagaoProj
		line2 asgB[isg], -rowW, asgB[isg], -rowW - asagaoProj
	next isg
	line_type 1
	set style "annoC"
	if showDim then text2 lineLen / 2, -rowW - asagaoProj - 0.15, "朝顔 突出" + str(asagaoProj * 1000, 4, 0) + " " + str(nAsa, 1, 0) + "段"
	for ic = 1 to nCut
		set style "annoC"
		if showDim then text2 (cutS[ic] + cutE[ic]) / 2, -rowW - asagaoProj / 2, "朝顔切欠"
	next ic
	set style "anno"
endif

! 躯体面の参照線（離れ表示）
line_type 3
line2 0, standoff, lineLen, standoff
! 渡した区間: 実際の躯体線は離れが増える。破線で示す
! （凹み＝区間内が奥へ、張り出し＝区間外（両隣）が奥へ）
for ibr = 1 to nBr
	line_type 3
	if brK[ibr] > 1.5 then
		! 斜辺: 実際の躯体線は区間の一端で離れ0、他端で最大（種別2＝終点側、3＝始点側）
		if brK[ibr] > 2.5 then
			line2 brS[ibr], standoff + brD[ibr], brS[ibr] + brL[ibr], standoff
		else
			line2 brS[ibr], standoff, brS[ibr] + brL[ibr], standoff + brD[ibr]
		endif
		line_type 1
		set style "annoC"
		text2 brS[ibr] + brL[ibr] / 2, standoff + brD[ibr] / 2 + 0.18, \
			"斜辺 渡し 離れ+最大" + str(brD[ibr] * 1000, 5, 0)
		set style "anno"
	else
	if brK[ibr] < 0.5 then
		line2 brS[ibr], standoff, brS[ibr], standoff + brD[ibr]
		line2 brS[ibr], standoff + brD[ibr], brS[ibr] + brL[ibr], standoff + brD[ibr]
		line2 brS[ibr] + brL[ibr], standoff + brD[ibr], brS[ibr] + brL[ibr], standoff
		line_type 1
		set style "annoC"
		text2 brS[ibr] + brL[ibr] / 2, standoff + brD[ibr] + 0.18, \
			"凹み 渡し 離れ+" + str(brD[ibr] * 1000, 4, 0)
		set style "anno"
	else
		line2 0, standoff + brD[ibr], brS[ibr], standoff + brD[ibr]
		line2 brS[ibr], standoff + brD[ibr], brS[ibr], standoff
		line2 brS[ibr] + brL[ibr], standoff, brS[ibr] + brL[ibr], standoff + brD[ibr]
		line2 brS[ibr] + brL[ibr], standoff + brD[ibr], lineLen, standoff + brD[ibr]
		line_type 1
		set style "annoC"
		text2 brS[ibr] + brL[ibr] / 2, standoff + brD[ibr] + 0.18, \
			"張り出し 渡し 両隣の離れ+" + str(brD[ibr] * 1000, 4, 0)
		set style "anno"
	endif
	endif
next ibr
line_type 1

! 壁つなぎ位置（平面でも位置が分かるよう大きめの丸で示す）
for it = 1 to nTie
	circle2 ties[it], standoff / 2, 0.09
	line2 ties[it], 0, ties[it], standoff
next it

if not(showDim) then return

! 寸法線は外側に張り出すもの（昇降機の搬器・マスト、荷受けステージ）の外へ置く。
! 面の中央に昇降機があると「L= 離れ」の文字が搬器の破線に重なって読めなかった
dOff = 0
for ih = 1 to nHo
	if 0.10 + hoD[ih] + 0.55 > dOff then dOff = 0.10 + hoD[ih] + 0.55
next ih
for ig = 1 to nSg
	if sgP[ig] + 0.10 > dOff then dOff = sgP[ig] + 0.10
next ig
x = 0
for ip = 1 to nSpan
	set style "annoC"
	text2 x + spans[ip] / 2, -rowW - dOff - 0.25, str(spans[ip] * 1000, 5, 0)
	set style "anno"
	line2 x, -rowW - dOff - 0.15, x, -rowW - dOff - 0.35
	x = x + spans[ip]
next ip
line2 x, -rowW - dOff - 0.15, x, -rowW - dOff - 0.35
set style "annoC"
text2 lineLen / 2, -rowW - dOff - 0.55, "L=" + str(lineLen * 1000, 6, 0) + " 離れ" + str(standoff * 1000, 4, 0)
set style "anno"
return

! ============================================================
200: ! ---- 立面図 ----
! 作図順（実務）: GL・ジャッキ → 1段目 → 上へ積上げ → 壁つなぎ → 寸法・特記

! GL と地盤ハッチ。敷地高低差があれば支柱位置ごとの地盤高（glList）を結ぶ
! （平坦のまま描くと、継ぎ足した支柱もジャッキの差も図に出ない）
if nGl >= 2 then
	gx = -0.5
	gy = gl[1]
	xp = 0
	for ip = 1 to nSpan + 1
		gv = 0
		if ip <= nGl then gv = gl[ip]
		line2 gx, gy, xp, gv
		gx = xp
		gy = gv
		if ip <= nSpan then xp = xp + spans[ip]
	next ip
	line2 gx, gy, lineLen + 0.5, gy
	! ハッチは各区間の地盤線に沿って打つ
	xp = 0
	for ip = 1 to nSpan
		g0 = 0
		g1 = 0
		if ip <= nGl then g0 = gl[ip]
		if ip + 1 <= nGl then g1 = gl[ip + 1]
		nh = int(spans[ip] / 0.12)
		for ih = 0 to nh
			hx = xp + ih * 0.12
			hy = g0 + (g1 - g0) * (ih * 0.12 / spans[ip])
			line2 hx, hy, hx - 0.08, hy - 0.08
		next ih
		xp = xp + spans[ip]
	next ip
	text2 -0.5, gl[1] - 0.22, "GL"
else
	line2 -0.5, 0, lineLen + 0.5, 0
	gx = -0.45
	while gx < lineLen + 0.45 do
		line2 gx, 0, gx - 0.08, -0.08
		gx = gx + 0.12
	endwhile
	text2 -0.5, -0.22, "GL"
endif

! 各階FLの参照線（躯体との対応を見るため）
line_type 3
for ifl = 1 to nFL
	line2 -0.3, fls[ifl], lineLen + 0.3, fls[ifl]
	text2 lineLen + 0.35, fls[ifl], str(ifl, 1, 0) + "FL"
next ifl
line_type 1

! 支柱（ジャッキ＋積上げ）と ジョイント位置
x = 0
for ip = 1 to nSpan + 1
	! 梁枠の内側は支柱を抜き、梁下から上だけ描く
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	! この支柱位置の地盤高とジャッキ（敷地高低差があれば脚ごと、無ければ共通）
	gv = 0
	jo = jackOut
	sv = 0
	if ip <= nGl then gv = gl[ip]
	if ip <= nJk then jo = jk[ip]
	if ip <= nSh then sv = sh[ip]
	! ジャッキベース: 敷板（あれば）＋アンダーベース（140角）＋ねじ棒φ38.1＋ハンドル付きナット（3Dと同じ形）
	if bBase = 0 then
		if sv > 0.001 then rect2 x - 0.15, gv, x + 0.15, gv + sv
		rect2 x - 0.07, gv + sv, x + 0.07, gv + sv + 0.006
		rect2 x - 0.019, gv + sv + 0.006, x + 0.019, gv + jo
		rect2 x - 0.045, gv + jo - 0.03, x + 0.045, gv + jo
		line2 x - 0.09, gv + jo - 0.015, x + 0.09, gv + jo - 0.015
	endif
	! 支柱（継ぎ足した脚は下へ伸びる）
	if bBase = 0 then
		rect2 x - r_sic, gv + jo, x + r_sic, postTop
	else
		rect2 x - r_sic, bBase, x + r_sic, postTop
	endif
	! 縦継ぎ（ジョイント）位置に短い横線。継ぎ足しは下側なので天端から数える
	jh = postTop
	for jp = nPost to 2 step -1
		jh = jh - posts[jp]
		line2 x - 0.05, jh, x + 0.05, jh
	next jp
	hotspot2 x, gv
	hotspot2 x, postTop
	if ip <= nSpan then x = x + spans[ip]
next ip

! 根がらみ（最下コマ）＝ lv[1]
! 開口部はGLから梁枠までの通路なので、その区間には根がらみも入らない
! （足元に横材が通っていたら通れない）。数量でも同じ区間を引いている
x = 0
for ip = 1 to nSpan
	inOpen = 0
	for ib5 = 1 to nBm
		if x >= bmS[ib5] - 0.001 and x + spans[ip] <= bmS[ib5] + bmL[ib5] + 0.001 then inOpen = 1
	next ib5
	if inOpen = 0 then
		line2 x, lv[1], x + spans[ip], lv[1]
		line2 x, lv[1] + 0.02, x + spans[ip], lv[1] + 0.02
	endif
	x = x + spans[ip]
next ip

! 継ぎ足した脚の区間の根がらみ（敷地高低差）。基準の根がらみは低い脚の地盤から
! 離れるので、区間両端の脚のうち下げ段数の少ない方に合わせて1段入れる
! （数量と同じ規則。下げ段数は支柱下端の基準からの差÷刻みで求める）
if nGl >= 2 and footStep > 0.001 then
	x = 0
	for ip = 1 to nSpan
		inOpen = 0
		for ib5 = 1 to nBm
			if x >= bmS[ib5] - 0.001 and x + spans[ip] <= bmS[ib5] + bmL[ib5] + 0.001 then inOpen = 1
		next ib5
		ma = 0
		mb = 0
		if ip <= nGl and ip <= nJk then ma = round_int((jackOut - (gl[ip] + jk[ip])) / footStep)
		if ip + 1 <= nGl and ip + 1 <= nJk then mb = round_int((jackOut - (gl[ip + 1] + jk[ip + 1])) / footStep)
		mlo = ma
		if mb < mlo then mlo = mb
		if mlo >= 1 and inOpen = 0 then
			zz = lv[1] - mlo * footStep
			line2 x, zz, x + spans[ip], zz
			line2 x, zz + 0.02, x + spans[ip], zz + 0.02
		endif
		x = x + spans[ip]
	next ip
endif

! 各作業層: 布板・手すり・中桟・幅木
! 全長に通して描くと、階段室や開口部（梁枠より下＝通路）にも床があることに
! なってしまう。数量の差し引きと同じ区間を空ける
for il = 2 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		xs = x
		xe = x + spans[ip]
		noDeck = 0
		noAll = 0
		for it3 = 1 to nSt
			if xs >= stS[it3] - 0.001 and xe <= stS[it3] + stL[it3] + 0.001 then noDeck = 1
		next it3
		for ib2 = 1 to nBm
			if xs >= bmS[ib2] - 0.001 and xe <= bmS[ib2] + bmL[ib2] + 0.001 and \
					z < bmH[ib2] - 0.001 then noAll = 1
		next ib2
		! 荷受けステージの間口は設置層で外側の手すり・中桟・幅木を外す（3D・数量と同じ）
		inSg = 0
		for ig2 = 1 to nSg
			if xs >= sgS[ig2] - 0.001 and xe <= sgS[ig2] + sgL[ig2] + 0.001 and \
					abs(z - sgH[ig2]) < 0.001 then inSg = 1
		next ig2
		! 昇降機の乗り込み口（開閉式手すりは別に描く）
		for il4 = 1 to nLa
			if laP[il4] >= xs - 0.001 and laP[il4] < xe - 0.001 and abs(z - laH[il4]) < 0.001 then inSg = 2
		next il4
		! 内ブラケットで拡幅した層・スパンは躯体側の手すり・中桟を付けない（3D・数量と同じ）。
		! 張出しブラケットの層・スパンは建地位置の外側手すり・幅木を外す（新しい縁の手すりに任せる）
		inBk = 0
		for ik2 = 1 to nBk
			if bkD[ik2] > 0 and xs >= bkS[ik2] - 0.001 and xe <= bkE[ik2] + 0.001 and \
					abs(z - bkH[ik2]) < 0.001 then inBk = 1
			if bkD[ik2] < 0 and xs >= bkS[ik2] - 0.001 and xe <= bkE[ik2] + 0.001 and \
					abs(z - bkH[ik2]) < 0.001 then inSg = 1
		next ik2
		! 枠組の中間層は布材の手すり・中桟を描かない（交差筋交＋幅木。数量と同じ）
		frMid = 0
		if serType = "W" and il < nLv then frMid = 1
		if noAll = 0 then
			! 布板（作業床）。階段室は段板で上がるので敷かない
			if noDeck = 0 then rect2 xs, z, xe, z + 0.05
			! 幅木は階段室にも残る（階段側の落下防止）。数量もそう拾っている
			! 先行手すり方式では幅木を付けない（落下物防止はメッシュシート等）
			if railAdv = 0 and inSg = 0 then rect2 xs, z + 0.05, xe, z + 0.05 + 0.157
			! 手すり・中桟は階段室にも要る
			if inSg = 0 and frMid = 0 then line2 xs, z + railTop, xe, z + railTop
			if inSg >= 1 or frMid = 1 then
				! ステージの間口・乗り込み口: 躯体側の手すり・中桟だけ
				if railIn = 1 and nRows >= 2 and inBk = 0 then
					line2 xs, z + railTop, xe, z + railTop
					line2 xs, z + railMid, xe, z + railMid
				endif
			else
			if railAdv = 1 then
				! 先行手すりは手すり1本＋X形の斜材2本が一体（手すり・中桟・筋交を兼ねる）
				line2 xs, z + railTop, xe, z + 0.02
				line2 xe, z + railTop, xs, z + 0.02
				! 躯体側の中桟（布材）は先行手すりの奥に見える
				if railIn = 1 and nRows >= 2 and inBk = 0 then
					line2 xs, z + railMid, xe, z + railMid
				endif
			else
				line2 xs, z + railMid, xe, z + railMid
			endif
			endif
		endif
		x = xe
	next ip
next il

! ブレス（交さ2方向＝X）。1箇所に2本入る前提で数量を拾っているので、
! 図も両方向を描く（片方向だけ描くと部材表の本数と図が食い違う）。
! 枠組の交差筋交も同じくX。設置間隔は数量拾いと揃える
x = 0
for ip = 1 to nSpan
	for il = 1 to nLv - 1
		if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 and il - 1 - bEvL * int((il - 1) / bEvL) = 0 then
			line2 x, lv[il], x + spans[ip], lv[il + 1]
			line2 x + spans[ip], lv[il], x, lv[il + 1]
		endif
	next il
	x = x + spans[ip]
next ip

! 始点の出隅コーナー（外側コーナー支柱と、そこまでの布材・手すり・踏板・幅木）
if cornerS = 1 then
	gv = 0
	if nGl >= 1 then gv = gl[1]
	line2 -rowW, gv, -rowW, postTop
	for il = 1 to nLv
		z = lv[il]
		line2 -rowW, z, 0, z
		if il > 1 then
			line2 -rowW, z + railTop, 0, z + railTop
			line2 -rowW, z + railMid, 0, z + railMid
			rect2 -rowW, z, 0, z + 0.05
			if railAdv = 0 then rect2 -rowW, z + 0.05, 0, z + 0.05 + 0.157
		endif
	next il
endif

! 階段室（立面では区間の各層に斜めの段板を示す）
for it2 = 1 to nSt
	sx = stS[it2]
	ex = sx + stL[it2]
	line2 sx, lv[1], sx, postTop
	line2 ex, lv[1], ex, postTop
	! 3Dと同じ折り返し（踏面1スパン＋踊り場1スパン）。段の刻みと階段手すりも描く
	sl = ex - sx
	for il = 1 to nLv - 1
		rise = lv[il + 1] - lv[il]
		fl = sl
		if sl > 2.7 and rise / (sl / 2) <= 1.15 then fl = sl / 2
		nStep = int(rise / 0.225 + 0.5)
		if nStep < 1 then nStep = 1
		td = fl / nStep
		th = rise / nStep
		if il - 2 * int(il / 2) = 1 then
			x0 = sx
			dx = 1
			lx = sx + fl
		else
			x0 = ex
			dx = -1
			lx = sx
		endif
		for is2 = 1 to nStep
			line2 x0 + (is2 - 1) * td * dx, lv[il] + (is2 - 1) * th, x0 + (is2 - 1) * td * dx, lv[il] + is2 * th
			line2 x0 + (is2 - 1) * td * dx, lv[il] + is2 * th, x0 + is2 * td * dx, lv[il] + is2 * th
		next is2
		line2 x0, lv[il] + 0.95, x0 + fl * dx, lv[il + 1] + 0.95
		line2 x0, lv[il], x0, lv[il] + 0.95
		line2 x0 + fl * dx, lv[il + 1], x0 + fl * dx, lv[il + 1] + 0.95
		if fl < sl - 0.001 then
			line2 lx, lv[il + 1], lx + sl - fl, lv[il + 1]
		endif
	next il
	set style "annoC"
	if showDim then text2 (sx + ex) / 2, lv[1] - 0.2, "階段"
	set style "anno"
next it2

! ブラケット区間（立面では該当層の床を太線にして幅を注記する）
! 平面と3Dには出ているのに立面だけ描いておらず、区間指定が図から消えていた
for ik2 = 1 to nBk
	kx1 = bkS[ik2]
	kx2 = bkE[ik2]
	kz = bkH[ik2]
	line2 kx1, kz - 0.02, kx2, kz - 0.02
	line2 kx1, kz + 0.07, kx2, kz + 0.07
	line2 kx1, kz - 0.02, kx1, kz + 0.07
	line2 kx2, kz - 0.02, kx2, kz + 0.07
	if showDim then
		if bkD[ik2] > 0 then
			kTxt = "BR" + str(bkW[ik2] * 1000, 4, 0) + "内"
		else
			kTxt = "BR" + str(bkW[ik2] * 1000, 4, 0) + "張出"
		endif
		if bkDW[ik2] > 0 then kTxt = kTxt + " 床" + str(bkDW[ik2] * 1000, 4, 0)
		set style "annoC"
		text2 (kx1 + kx2) / 2, kz + 0.12, kTxt
		set style "anno"
	endif
next ik2

! 荷受けステージ（立面では設置高さの区間を太線と文字で）
for ig = 1 to nSg
	gs = sgS[ig]
	ge = gs + sgL[ig]
	gh = sgH[ig]
	rect2 gs, gh, ge, gh + 0.05
	line2 gs, gh, gs, gh + 0.9
	line2 ge, gh, ge, gh + 0.9
	line2 gs, gh + 0.9, ge, gh + 0.9
	set style "annoC"
	if showDim then text2 (gs + ge) / 2, gh + 1.05, "荷受けステージ 出" + str(sgP[ig] * 1000, 4, 0)
	set style "anno"
next ig

! 昇降機（立面では搬器の通る範囲を破線で、マスト（0.30角・到達高さ+1m）と
! 最下の乗り込み口の高さに置いた搬器（高さ2.2m）を実線で。控えピッチごとに
! マスト控えの印。3D・詳細図と同じ取合い）
for ih = 1 to nHo
	hx = hoP[ih]
	line_type 3
	rect2 hx - hoW[ih] / 2, 0, hx + hoW[ih] / 2, hoR[ih]
	line_type 1
	rect2 hx - 0.15, 0, hx + 0.15, hoR[ih] + 1.0
	cz2 = 0.20
	for il6 = 1 to nLa
		if abs(laP[il6] - hx) < 0.001 then
			if cz2 = 0.20 or laH[il6] < cz2 then cz2 = laH[il6]
		endif
	next il6
	rect2 hx - hoW[ih] / 2, cz2, hx + hoW[ih] / 2, cz2 + 2.2
	line2 hx - hoW[ih] / 2, cz2, hx + hoW[ih] / 2, cz2 + 2.2
	line2 hx - hoW[ih] / 2, cz2 + 2.2, hx + hoW[ih] / 2, cz2
	tp2 = hoTp[ih]
	if tp2 < 0.5 then tp2 = 3.6
	for it2 = 1 to int(hoR[ih] / tp2)
		rect2 hx - 0.06, it2 * tp2 - 0.03, hx + 0.06, it2 * tp2 + 0.03
	next it2
	set style "annoC"
	if showDim then text2 hx, hoR[ih] + 1.12, "昇降機 到達" + str(hoR[ih] * 1000, 5, 0)
	set style "anno"
next ih
line_type 1
! 乗り込み口（開閉式手すり）。足場側の開口なので、どの層かを図に出す
for il2 = 1 to nLa
	lx = laP[il2]
	lz = laH[il2]
	! 乗り込み口の幅はその昇降機の搬器幅
	lw = HOIST_W
	for ih2 = 1 to nHo
		if abs(hoP[ih2] - lx) < 0.001 then lw = hoW[ih2]
	next ih2
	rect2 lx - lw / 2, lz, lx + lw / 2, lz + railH
	if showDim then
		set style "annoC"
		text2 lx, lz + railH + 0.10, "乗込口"
		set style "anno"
	endif
next il2

! 梁枠（立面ではトラス）
for ib = 1 to nBm
	bs = bmS[ib]
	be = bs + bmL[ib]
	bh = bmH[ib]
	line2 bs, bh, be, bh
	line2 bs, bh - 0.45, be, bh - 0.45
	line2 bs, bh - 0.45, bs, bh
	line2 be, bh - 0.45, be, bh
	nd = 4
	for id = 0 to nd - 1
		dx1 = bs + bmL[ib] * id / nd
		dx2 = bs + bmL[ib] * (id + 1) / nd
		if id - 2 * int(id / 2) = 0 then
			line2 dx1, bh - 0.45, dx2, bh
		else
			line2 dx1, bh, dx2, bh - 0.45
		endif
	next id
	set style "annoC"
	if showDim then text2 (bs + be) / 2, bh - 0.65, "梁枠 " + str(bmL[ib] * 1000, 5, 0)
	set style "anno"
next ib

! 朝顔（立面では設置高さに太線と注記）
for ia = 1 to nAsa
	za = asa[ia]
	for isg = 1 to nAsg
		line2 asgA[isg], za, asgB[isg], za
		line2 asgA[isg], za + 0.02, asgB[isg], za + 0.02
	next isg
	if showDim then text2 lineLen + 0.1, za, "朝顔" + str(ia, 1, 0) + "段目 GL+" + str(za * 1000, 5, 0)
	for ic = 1 to nCut
		set style "annoC"
		if showDim then text2 (cutS[ic] + cutE[ic]) / 2, za + 0.12, "朝顔切欠（昇降機）"
	next ic
	set style "anno"
next ia

! 壁つなぎ: 形状を描いても判別できないので大きな丸印で示す（実務の作図法）
pen warnPen
! tieList と tieHeightList は同じ長さの対（i番目の位置とi番目の高さが1組）
for it = 1 to nTiePair
	circle2 ties[it], tieH[it], 0.12
	line2 ties[it] - 0.08, tieH[it], ties[it] + 0.08, tieH[it]
	line2 ties[it], tieH[it] - 0.08, ties[it], tieH[it] + 0.08
next it
pen 1

if not(showDim) then return

! ---- 高さ寸法（左側）: 各層と全高 ----
dx = -0.35
line2 dx, 0, dx, postTop
! 数字は右詰め。左詰めのまま文字1つ分だけ左に置くと、桁数が増えたときに
! 寸法線と足場の中へ数字がはみ出して読めなくなる（実機で確認）
for il = 1 to nLv
	line2 dx - 0.06, lv[il], dx + 0.06, lv[il]
	dimTxt = str(lv[il] * 1000, 6, 0)
	text2 dx - 0.12 - stw(dimTxt) * GLOB_SCALE / 1000, lv[il], dimTxt
next il
line2 dx - 0.06, postTop, dx + 0.06, postTop
dimTxt = "H=" + str(postTop * 1000, 6, 0)
text2 dx - 0.12 - stw(dimTxt) * GLOB_SCALE / 1000, postTop, dimTxt

! ---- スパン寸法（下側） ----
dy = -0.45
x = 0
for ip = 1 to nSpan
	set style "annoC"
	text2 x + spans[ip] / 2, dy - txtLine, str(spans[ip] * 1000, 5, 0)
	set style "anno"
	line2 x, dy, x, dy - 0.06
	x = x + spans[ip]
next ip
line2 x, dy, x, dy - 0.06
line2 0, dy, lineLen, dy
set style "annoC"
text2 lineLen / 2, dy - txtLine * 2.2, "L=" + str(lineLen * 1000, 6, 0)
set style "anno"
! ジャッキ繰出しは高さ寸法の列に入れると最下段（GL+100等）の寸法と
! 文字が重なって両方読めなくなる。GL下の空きに別記する
! 短い面では L= の文字と横に並ぶので、行を分ける
if nJk >= 2 then
	jmin = jk[1]
	jmax = jk[1]
	for ij = 2 to nJk
		if jk[ij] < jmin then jmin = jk[ij]
		if jk[ij] > jmax then jmax = jk[ij]
	next ij
	! 脚ごとの値がほぼ同じ（差5mm未満）なら範囲で書かない（「265〜265（高低差あり）」は誤解を招く）
	if jmax - jmin < 0.005 then
		text2 dx - txtH, dy - txtLine * 3.4, "ジャッキ繰出 " + str(jmin * 1000, 4, 0)
	else
		text2 dx - txtH, dy - txtLine * 3.4, "ジャッキ繰出 " + str(jmin * 1000, 4, 0) + "〜" + str(jmax * 1000, 4, 0) + "（高低差あり・脚ごと）"
	endif
else
	text2 dx - txtH, dy - txtLine * 3.4, "ジャッキ繰出 " + str(jackOut * 1000, 4, 0)
endif

! ---- 特記（形状では判別できないものは文字で書く。実務の作図法） ----
! 特記の列。FL参照（+0.35）や朝顔の高さ表示（+0.1・文字幅が2m超）と
! 同じ帯に置くと、階数や段数によっては行が重なる。文字幅の分だけ右に離す
tx = lineLen + 2.8
ny = postTop
text2 tx, ny, "立面図 " + faceName
ny = ny - txtLine * 1.4
if serType = "W" then
	text2 tx, ny, "本図は建枠を支柱・布材で表現しています（建枠の形状は別途）"
	ny = ny - txtLine
	text2 tx, ny, "根がらみ: 建枠脚部（布板と区別がつかないため特記）"
else
	text2 tx, ny, "根がらみ: 最下コマ（布板と区別がつかないため特記）"
endif
ny = ny - txtLine
text2 tx, ny, "頭つなぎ: 最上段（同上）"
ny = ny - txtLine
! 一側足場は建地1列。本足場の「内側／外側」の注記を出すと、無い建地列の
! 部材を書くことになる（実機の立面で確認）
if nRows = 1 then
	text2 tx, ny, "一側足場: 建地1列・作業床はブラケット受け"
	ny = ny - txtLine
	if railAdv = 1 then
		text2 tx, ny, "外側: ブレース＋先行手すり（手すり＋X斜材一体・幅木なし）"
	else
		text2 tx, ny, "外側: ブレース＋手すり＋中桟＋幅木"
	endif
else
	if railIn = 1 then
		text2 tx, ny, "内側: 手すり＋中桟（布材）"
	else
		text2 tx, ny, "内側: ブレース＋幅木"
	endif
	ny = ny - txtLine
	if railAdv = 1 then
		text2 tx, ny, "外側: ブレース＋先行手すり（手すり＋X斜材一体・幅木なし）"
	else
		text2 tx, ny, "外側: ブレース＋手すり＋中桟＋幅木"
	endif
endif
ny = ny - txtLine
text2 tx, ny, "作業層 " + str(nLevels, 2, 0) + "層 / 階高 " + str(floorH * 1000, 5, 0)
ny = ny - txtLine
text2 tx, ny, "壁つなぎ " + str(nTiePair, 3, 0) + "箇所（○印）"
ny = ny - txtLine
text2 tx, ny, "壁離れ " + str(standoff * 1000, 4, 0)
return

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 足場ライン 3Dスクリプト
! 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体側 +Y
! ============================================================
pen 1
! 円柱の分割数。既定36だと30m面1つの3D生成に約40秒（支柱・布材・コマで数千本）。
! 12にすると見た目は保ったまま面数が1/3になる。コマ・ナットは6
resol 12

! 線表示: 計画初期や40m級の建物一周で、部材の立体を描かずに支柱・水平材・階段・
! 付帯設備の占有範囲を線だけで出す（bim-arekore の足場計画.gsm の「線表示」と同じ考え方）。
! 立体表現（既定）は干渉確認用、線表示は割付検討用
mv3d = 0
if LIBRARYGLOBAL(mvoName, "mode3d", mv3d) then
	if mv3d = 1 then lineMode = 0
	if mv3d = 2 then lineMode = 1
endif
if lineMode then
	gosub 900
	end
endif

! ---- 支柱（各スパン境界に内外1対） ----
! 梁枠の内側は支柱を抜く（平面・立面と同じ）。3Dだけ建てたままだと、
! 実際には無い建地を干渉確認に使うことになる
x = 0
for ip = 1 to nSpan + 1
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	! この支柱位置の地盤高とジャッキ（敷地高低差があれば脚ごと）
	gv = 0
	jo = jackOut
	sv = 0
	if ip <= nGl then gv = gl[ip]
	if ip <= nJk then jo = jk[ip]
	if ip <= nSh then sv = sh[ip]
	for row = rowStart to 1
		if bBase = 0 then
			add x, -row * rowW, gv
			! ジャッキ（敷板があればその上から）
			gosub 820
			addz jo
			if nGl >= 2 then
				! 継ぎ足した脚は長さが脚ごとに違う。天端まで1本で描く
				cylind postTop - gv - jo, r_sic
				del 2
			else
				! 支柱積み上げ
				for j = 1 to nPost
					cylind posts[j], r_sic
					addz posts[j]
				next j
				del nPost + 2
			endif
		else
			! 梁枠上に乗る支柱（梁下から天端まで1本で描く）
			add x, -row * rowW, bBase
			cylind postTop - bBase, r_sic
			del 1
		endif
	next row
	if ip <= nSpan then x = x + spans[ip]
next ip

! ---- 出隅コーナー（始点側。x∈[-rowW,0], y∈[-rowW,0]） ----
! 内側建地列は隣の面と同じコーナー支柱で繋がるが、外側建地列は面ごとに躯体コーナー
! で終わるので、四隅の外側の升目（外側コーナー支柱・布材・踏板・幅木）が抜けていた。
! 各面は始点の出隅を描く（終点は次の面が描く）。一側足場も同じ（建地列は1列でも
! 躯体コーナーで終わる）。枠組には無い
if cornerS = 1 then
	gv = 0
	jo = jackOut
	sv = 0
	if nGl >= 1 then gv = gl[1]
	if nJk >= 1 then jo = jk[1]
	if nSh >= 1 then sv = sh[1]
	add -rowW, -rowW, gv
	gosub 820
	addz jo
	if nGl >= 2 then
		cylind postTop - gv - jo, r_sic
		del 2
	else
		for j = 1 to nPost
			cylind posts[j], r_sic
			addz posts[j]
		next j
		del nPost + 2
	endif
	if komaPitch > 0 then
		resol 6
		zk = lv[1]
		while zk < postTop - 0.01 do
			add -rowW, -rowW, zk - 0.005
			cylind 0.01, 0.055
			del 1
			zk = zk + komaPitch
		endwhile
		resol 12
	endif
	for il = 1 to nLv
		z = lv[il]
		! 前の面の外側列の延長（y方向）と、この面の外側列の手前（x方向）
		add -rowW, 0, z
		rotx 90
		cylind rowW, r_nuno
		del 2
		add -rowW, -rowW, z
		roty 90
		cylind rowW, r_nuno
		del 2
		if il > 1 then
			add -rowW, 0, z + railTop
			rotx 90
			cylind rowW, r_nuno
			del 2
			add -rowW, -rowW, z + railTop
			roty 90
			cylind rowW, r_nuno
			del 2
			add -rowW, 0, z + railMid
			rotx 90
			cylind rowW, r_nuno
			del 2
			add -rowW, -rowW, z + railMid
			roty 90
			cylind rowW, r_nuno
			del 2
			if showDeck then
				! コーナー踏板と、外側2辺の幅木
				add -rowW + 0.05, -rowW + 0.05, z
				block rowW - 0.05, rowW - 0.05, 0.045
				del 1
				if railAdv = 0 then
					add -rowW - 0.02, -rowW - 0.02, z + 0.045
					block rowW + 0.02, 0.02, 0.157
					del 1
					add -rowW - 0.02, -rowW - 0.02, z + 0.045
					block 0.02, rowW + 0.02, 0.157
					del 1
				endif
			endif
		endif
	next il
endif

! ---- コマ（緊結部）: 布材・腕木のくさびを掛ける座。支柱に komaPitch ごとに付く ----
! 根がらみのレベルに合わせて並べるので、布材・腕木は必ずコマの位置に付く。
! 枠組（komaPitch=0）には無い。梁枠で抜いた支柱の下には付けない
if komaPitch > 0 then
	resol 6
	x = 0
	for ip = 1 to nSpan + 1
		bBase = 0
		for ib = 1 to nBm
			if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
		next ib
		for row = rowStart to 1
			zk = lv[1]
			while zk < postTop - 0.01 do
				if zk > bBase + 0.001 then
					add x, -row * rowW, zk - 0.005
					cylind 0.01, 0.055
					del 1
				endif
				zk = zk + komaPitch
			endwhile
		next row
		if ip <= nSpan then x = x + spans[ip]
	next ip
	resol 12
endif

! ---- 水平材（根がらみ＋各作業層） ----
for il = 1 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		! 開口部（梁枠より下）は支柱を抜いた通路。布材も手すりも入らない。
		! 立面は空けているのに3Dだけ通していた（根がらみが足元を横切っていた）
		skipH = 0
		for ib6 = 1 to nBm
			if x >= bmS[ib6] - 0.001 and x + spans[ip] <= bmS[ib6] + bmL[ib6] + 0.001 and \
					z < bmH[ib6] - 0.001 then skipH = 1
		next ib6
		! 内外の布材（床レベル）
		if skipH = 0 then
			for row = rowStart to 1
				add x, -row * rowW, z
				roty 90
				cylind spans[ip], r_nuno
				del 2
			next row
		endif
		! 荷受けステージの間口は設置層で外側の手すり・中桟を外す（荷を通す。
		! ステージ側の先端・妻側の手すりで防護）。数量も同じ区間を引いている
		inSg = 0
		for ig2 = 1 to nSg
			if x >= sgS[ig2] - 0.001 and x + spans[ip] <= sgS[ig2] + sgL[ig2] + 0.001 and \
					abs(z - sgH[ig2]) < 0.001 then inSg = 1
		next ig2
		! 昇降機の乗り込み口（位置を含むスパン・乗り込む層）は固定手すりの代わりに開閉式手すり
		for il4 = 1 to nLa
			if laP[il4] >= x - 0.001 and laP[il4] < x + spans[ip] - 0.001 and \
					abs(z - laH[il4]) < 0.001 then inSg = 2
		next il4
		! 張出しブラケットで床を広げた層・スパンは、建地位置の手すりは外し、新しい縁の手すりに任せる
		for ik3 = 1 to nBk
			if bkD[ik3] < 0 and x >= bkS[ik3] - 0.001 and x + spans[ip] <= bkE[ik3] + 0.001 and \
					abs(z - bkH[ik3]) < 0.001 then inSg = 1
		next ik3
		if il > 1 and skipH = 0 and inSg = 2 then
			! 開閉式手すり（枠: 両端の縦材＋手すり＋中桟。数量は「開閉式手すり」で拾う）
			add x + 0.05, -rowW, z + 0.10
			cylind railTop - 0.10, 0.015
			del 1
			add x + spans[ip] - 0.05, -rowW, z + 0.10
			cylind railTop - 0.10, 0.015
			del 1
			add x + 0.05, -rowW, z + railTop
			roty 90
			cylind spans[ip] - 0.10, 0.015
			del 2
			add x + 0.05, -rowW, z + railMid
			roty 90
			cylind spans[ip] - 0.10, 0.015
			del 2
		endif
		! 枠組の中間層は交差筋交＋幅木（＋上の建枠）で防護し、布材の手すり・中桟は
		! 最上層だけ（数量と同じ）。全層に描くと部材表に無い手すりが図に出る
		frMid = 0
		if serType = "W" and il < nLv then frMid = 1
		! 外側手すり・中桟（作業層のみ）
		if il > 1 and skipH = 0 and inSg = 0 and frMid = 0 then
			add x, -rowW, z + railTop
			roty 90
			cylind spans[ip], r_nuno
			del 2
			if railAdv = 1 then
				! 先行手すり（信和セーフハンガー SXII 等）: 手すり1本＋X形の斜材2本が一体で
				! 手すり・中桟・筋交の3機能を兼ねる（カタログ p19）。斜材は両上端から
				! 対角の支柱の床際（下部クサビ）へ。以前は片方の斜材1本だけで形が違った
				advDz = railTop - 0.02
				advL = sqr(spans[ip] * spans[ip] + advDz * advDz)
				add x, -rowW, z + railTop
				roty 90 + atn(advDz / spans[ip])
				cylind advL, 0.0217 / 2
				del 2
				add x + spans[ip], -rowW, z + railTop
				roty -(90 + atn(advDz / spans[ip]))
				cylind advL, 0.0217 / 2
				del 2
			else
				add x, -rowW, z + railMid
				roty 90
				cylind spans[ip], r_nuno
				del 2
			endif
		endif
		! 躯体側（内側建地列）の手すり・中桟は布材で組む（先行手すりは外側だけ。
		! ステージの間口でも残る）。内ブラケットで床を拡幅した層・スパンは隙間が
		! 小さいので付けない（数量も同じセルを引いている）
		inBk = 0
		for ik2 = 1 to nBk
			if bkD[ik2] > 0 and x >= bkS[ik2] - 0.001 and x + spans[ip] <= bkE[ik2] + 0.001 and \
					abs(z - bkH[ik2]) < 0.001 then inBk = 1
		next ik2
		if il > 1 and skipH = 0 and railIn = 1 and nRows >= 2 and inBk = 0 then
			add x, 0, z + railTop
			roty 90
			cylind spans[ip], r_nuno
			del 2
			add x, 0, z + railMid
			roty 90
			cylind spans[ip], r_nuno
			del 2
		endif
		! 腕木（内外連結、-Y向き）。一側足場は内側建地が無いので入らない。
		! 開口部の内側は支柱を抜いてあるので、そこにも入らない
		noPost = 0
		for ib7 = 1 to nBm
			if x > bmS[ib7] + 0.001 and x < bmS[ib7] + bmL[ib7] - 0.001 and \
					z < bmH[ib7] - 0.001 then noPost = 1
		next ib7
		if noPost = 0 then
			if nRows >= 2 then
				add x, 0, z
				rotz -90
				roty 90
				cylind rowW, r_nuno
				del 3
			else
				gosub 800
			endif
		endif
		x = x + spans[ip]
	next ip
	! 終端の腕木（一側足場は床受けブラケット）
	if nRows >= 2 then
		add x, 0, z
		rotz -90
		roty 90
		cylind rowW, r_nuno
		del 3
	else
		gosub 800
	endif
next il

! ---- 継ぎ足した脚の区間の根がらみ（敷地高低差。立面・数量と同じ規則） ----
if nGl >= 2 and footStep > 0.001 then
	x = 0
	for ip = 1 to nSpan
		inOpen = 0
		for ib8 = 1 to nBm
			if x >= bmS[ib8] - 0.001 and x + spans[ip] <= bmS[ib8] + bmL[ib8] + 0.001 then inOpen = 1
		next ib8
		ma = 0
		mb = 0
		if ip <= nGl and ip <= nJk then ma = round_int((jackOut - (gl[ip] + jk[ip])) / footStep)
		if ip + 1 <= nGl and ip + 1 <= nJk then mb = round_int((jackOut - (gl[ip + 1] + jk[ip + 1])) / footStep)
		mlo = ma
		if mb < mlo then mlo = mb
		if mlo >= 1 and inOpen = 0 then
			zz = lv[1] - mlo * footStep
			for row = rowStart to 1
				add x, -row * rowW, zz
				roty 90
				cylind spans[ip], r_nuno
				del 2
			next row
		endif
		x = x + spans[ip]
	next ip
endif

! ---- 踏板・幅木 ----
if showDeck then
	for il = 2 to nLv
		z = lv[il]
		x = 0
		for ip = 1 to nSpan
			! 階段室は段板で上がるので床を敷かない。ただし外構面の幅木は残る
			! （階段側の落下防止）。開口部（梁枠より下）は通路なので床も幅木も無い。
			! 数量もこの区別で拾っている（階段室は幅木を引かない）
			skipDeck = 0
			for it4 = 1 to nSt
				if x >= stS[it4] - 0.001 and x + spans[ip] <= stS[it4] + stL[it4] + 0.001 then skipDeck = 1
			next it4
			skipAll = 0
			for ib4 = 1 to nBm
				if x >= bmS[ib4] - 0.001 and x + spans[ip] <= bmS[ib4] + bmL[ib4] + 0.001 and \
						z < bmH[ib4] - 0.001 then skipAll = 1
			next ib4
			if skipAll = 0 then
				if skipDeck = 0 then
					add x, -rowW + 0.05, z
					block spans[ip], deckW1, 0.045
					del 1
					if deckW2 > 0 then
						add x, -rowW + 0.05 + deckW1 + 0.02, z
						block spans[ip], deckW2, 0.045
						del 1
					endif
				endif
				! 幅木（外側）。先行手すり方式では付けない（落下物防止はメッシュシート等）。
				! 荷受けステージの間口は設置層で外す
				inSg = 0
				for ig3 = 1 to nSg
					if x >= sgS[ig3] - 0.001 and x + spans[ip] <= sgS[ig3] + sgL[ig3] + 0.001 and \
							abs(z - sgH[ig3]) < 0.001 then inSg = 1
				next ig3
				for il5 = 1 to nLa
					if laP[il5] >= x - 0.001 and laP[il5] < x + spans[ip] - 0.001 and \
							abs(z - laH[il5]) < 0.001 then inSg = 2
				next il5
				for ik4 = 1 to nBk
					if bkD[ik4] < 0 and x >= bkS[ik4] - 0.001 and x + spans[ip] <= bkE[ik4] + 0.001 and \
							abs(z - bkH[ik4]) < 0.001 then inSg = 1
				next ik4
				if railAdv = 0 and inSg = 0 then
					add x, -rowW - 0.02, z + 0.045
					block spans[ip], 0.02, 0.157
					del 1
				endif
			endif
			x = x + spans[ip]
		next ip
	next il
endif

! ---- ブレス（外側構面、交さ2方向＝X） ----
! 設置間隔は bEvS スパン・bEvL 層ごと（1なら全構面）。数量拾いと
! 同じ間隔・同じ本数（1箇所2本）で描かないと、部材表と図面が食い違う
if showBrace then
	for il = 1 to nLv - 1
		if il - 1 - bEvL * int((il - 1) / bEvL) = 0 then
			z1 = lv[il]
			z2 = lv[il + 1]
			x = 0
			for ip = 1 to nSpan
				if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 then
					bl = sqr(spans[ip] ^ 2 + (z2 - z1) ^ 2)
					ang = atn((z2 - z1) / spans[ip])
					add x, -rowW - 0.05, z1
					roty 90 - ang
					cylind bl, 0.0213 / 2
					del 2
					add x + spans[ip], -rowW - 0.05, z1
					mulx -1
					roty 90 - ang
					cylind bl, 0.0213 / 2
					del 3
				endif
				x = x + spans[ip]
			next ip
		endif
	next il
endif

! ---- 朝顔（防護棚）: 外側へ突出する傾斜板と受けブラケット ----
! 突出2m・傾斜25度。数量にも法規チェックにも出るのに図面・3Dに
! 現れていなかった。突出2mの部材なので干渉確認のため実寸で出す
! 外側は -Y なので muly -1 でローカル+Yを外向きにしてから傾ける。
! そのまま block を置くと躯体側（+Y）へ張り出してしまう
! 昇降機のマスト・搬器が通る区間（asaCutList）は切り欠く（asgA〜asgB の連続区間だけ描く）
for ia = 1 to nAsa
	za = asa[ia]
	! 板（外側へ張り出し、先端が上がる）
	for isg = 1 to nAsg
		add asgA[isg], -rowW, za
		muly -1
		rotx asagaoAngle
		block asgB[isg] - asgA[isg], asagaoProj, 0.02
		del 3
	next isg
	! 受けブラケット（支柱位置ごと。切り欠きの内側の支柱には付けない）
	x = 0
	for ip = 1 to nSpan + 1
		inCut = 0
		for ic = 1 to nCut
			if x > cutS[ic] + 0.001 and x < cutE[ic] - 0.001 then inCut = 1
		next ic
		if inCut = 0 then
			add x, -rowW, za
			muly -1
			rotx asagaoAngle - 90
			cylind asagaoProj, 0.0213 / 2
			del 3
		endif
		if ip <= nSpan then x = x + spans[ip]
	next ip
next ia

! ---- 壁つなぎ（内側建地から躯体側へ +Y 方向） ----
! 構造計算でも法規チェックでも見ているのに3Dに無く、躯体との
! 取り合いが確認できなかった
! 壁つなぎ用金具: 支柱側のクランプ（自在クランプ相当の塊）、伸縮する本体パイプ、
! 躯体側のアンカープレート（ボルトで躯体に固定する座）。棒1本だと取り合いが見えない
for it = 1 to nTiePair
	add ties[it], 0, tieH[it]
	rotx -90
	cylind standoff, r_tie
	del 2
	add ties[it] - 0.035, -0.035, tieH[it] - 0.035
	block 0.07, 0.07, 0.07
	del 1
	add ties[it] - 0.05, standoff - 0.012, tieH[it] - 0.05
	block 0.10, 0.012, 0.10
	del 1
next it

! ---- 荷受けステージ（外側へ張り出す床・手すり） ----
for ig = 1 to nSg
	add sgS[ig], -rowW, sgH[ig]
	muly -1
	block sgL[ig], sgP[ig], 0.05
	del 2
	! 手すり・中桟（張り出し先端）
	for ir = 1 to 2
		if ir = 1 then hgt = railH else hgt = midH
		add sgS[ig], -rowW - sgP[ig], sgH[ig] + hgt
		roty 90
		cylind sgL[ig], r_nuno
		del 2
	next ir
	! 妻側（左右）も開放端。前面だけ手すりを立てても横から落ちる
	for ie = 0 to 1
		xg = sgS[ig] + sgL[ig] * ie
		for ir = 1 to 2
			if ir = 1 then hgt = railH else hgt = midH
			add xg, -rowW, sgH[ig] + hgt
			rotx 90
			cylind sgP[ig], r_nuno
			del 2
		next ir
		! 妻側の幅木
		add xg, -rowW - sgP[ig], sgH[ig] + 0.05
		block 0.02, sgP[ig], 0.157
		del 1
	next ie
	! 先端の幅木
	add sgS[ig], -rowW - sgP[ig], sgH[ig] + 0.05
	block sgL[ig], 0.02, 0.157
	del 1
	! 張出ブラケットと方杖。床だけ描くとステージが宙に浮いて見えるうえ、
	! 数量では建地位置ぶん拾っている（張出ブラケット・方杖）
	xb = 0
	for ipb = 1 to nSpan + 1
		if xb >= sgS[ig] - 0.001 and xb <= sgS[ig] + sgL[ig] + 0.001 then
			add xb, -rowW, sgH[ig]
			rotz -90
			roty 90
			cylind sgP[ig], r_nuno
			del 3
			! 先端の手すり支柱（ブラケット先端の建地受けに立て、手すり・中桟を受ける。
			! 無いと手すりが宙に浮く。数量は「先端手すり支柱」）
			add xb, -rowW - sgP[ig], sgH[ig]
			cylind railH + 0.10, r_sic
			del 1
			if sgZ[ig] > 0 then
				add xb, -rowW, sgH[ig] - sgP[ig]
				rotx 45
				cylind sgP[ig] * 1.4142, r_nuno
				del 2
			endif
		endif
		if ipb <= nSpan then xb = xb + spans[ipb]
	next ipb
next ig

! ---- ロングスパンエレベーター（マスト＋搬器＋渡し板＋マスト控え） ----
! 詳細図と同じ取合い: 外側建地から隙間0.10mを空けて搬器（hoW×hoD、手すり枠高さ2.2m）、
! その外側に0.30角のラック付きマスト（0.5mごとの横材）。搬器は最下の乗り込み口の
! 高さに置く。以前は4隅の細い柱と床板だけでマストが無く、干渉確認に使えなかった
for ih = 1 to nHo
	hx = hoP[ih]
	hg = 0.10
	cy = -rowW - hg              ! 搬器の足場側端
	cyo = cy - hoD[ih]           ! 搬器の外側端
	myc = cyo - 0.15             ! マスト中心（y）
	mh = hoR[ih] + 1.0           ! マスト頂部（到達高さ＋余長）
	! マスト: 4隅の主材＋0.5mごとの横材
	for icx = -1 to 1 step 2
		for icy = -1 to 1 step 2
			add hx + 0.15 * icx, myc + 0.15 * icy, 0
			cylind mh, 0.02
			del 1
		next icy
	next icx
	nm3 = int(mh / 0.5)
	for im3 = 1 to nm3
		add hx - 0.15, myc - 0.165, im3 * 0.5 - 0.015
		block 0.30, 0.03, 0.03
		del 1
		add hx - 0.15, myc + 0.135, im3 * 0.5 - 0.015
		block 0.30, 0.03, 0.03
		del 1
		add hx - 0.165, myc - 0.15, im3 * 0.5 - 0.015
		block 0.03, 0.30, 0.03
		del 1
		add hx + 0.135, myc - 0.15, im3 * 0.5 - 0.015
		block 0.03, 0.30, 0.03
		del 1
	next im3
	! 搬器: 床＋4隅の枠柱＋上枠（4辺）＋中桟（外側・妻側。足場側は乗降口）
	cz = 0.20
	cz0 = 0
	for il3 = 1 to nLa
		if abs(laP[il3] - hx) < 0.001 then
			if cz0 = 0 or laH[il3] < cz0 then cz0 = laH[il3]
		endif
	next il3
	if cz0 > 0 then cz = cz0
	add hx - hoW[ih] / 2, cyo, cz
	block hoW[ih], hoD[ih], 0.05
	del 1
	for icx = 0 to 1
		for icy = 0 to 1
			add hx - hoW[ih] / 2 + hoW[ih] * icx, cyo + hoD[ih] * icy, cz
			cylind 2.2, 0.02
			del 1
		next icy
	next icx
	for icy = 0 to 1
		add hx - hoW[ih] / 2, cyo + hoD[ih] * icy, cz + 2.2
		roty 90
		cylind hoW[ih], 0.015
		del 2
	next icy
	for icx = 0 to 1
		add hx - hoW[ih] / 2 + hoW[ih] * icx, cyo, cz + 2.2
		rotx -90
		cylind hoD[ih], 0.015
		del 2
		add hx - hoW[ih] / 2 + hoW[ih] * icx, cyo, cz + 1.1
		rotx -90
		cylind hoD[ih], 0.015
		del 2
	next icx
	add hx - hoW[ih] / 2, cyo, cz + 1.1
	roty 90
	cylind hoW[ih], 0.015
	del 2
	! 各乗り込み口: 渡し板（搬器の床から作業床へ、隙間を塞ぐ）
	for il3 = 1 to nLa
		if abs(laP[il3] - hx) < 0.001 then
			add hx - hoW[ih] / 2, cy - 0.10, laH[il3] + 0.045
			block hoW[ih], hg + 0.25, 0.03
			del 1
		endif
	next il3
	! マスト控え（控えピッチごとにマストから足場の外側建地へ。足場側は壁つなぎで躯体へ）
	tp3 = hoTp[ih]
	if tp3 < 0.5 then tp3 = 3.6
	nt3 = int(hoR[ih] / tp3)
	for it3 = 1 to nt3
		add hx, myc + 0.15, it3 * tp3
		rotx -90
		cylind -rowW - myc - 0.15, r_tie
		del 2
	next it3
next ih

! ---- 梁枠（開口部）: 上下弦材と斜材 ----
! 平面・立面には出ているのに3Dに無く、開口部の通り抜けを確認できなかった
for ib2 = 1 to nBm
	bs = bmS[ib2]
	bl = bmL[ib2]
	bh = bmH[ib2]
	for row2 = rowStart to 1
		add bs, -row2 * rowW - 0.02, bh - 0.45
		block bl, 0.04, 0.04
		del 1
		add bs, -row2 * rowW - 0.02, bh - 0.04
		block bl, 0.04, 0.04
		del 1
		! 斜材（4分割の折れ線をブロックで近似）
		nd2 = 4
		for id2 = 0 to nd2 - 1
			dlen = bl / nd2
			ang = atn(0.41 / dlen)
			add bs + dlen * id2, -row2 * rowW - 0.015, bh - 0.45
			if id2 - 2 * int(id2 / 2) = 0 then
				roty -ang
				block sqr(dlen * dlen + 0.41 * 0.41), 0.03, 0.03
				del 2
			else
				addz 0.41
				roty ang
				block sqr(dlen * dlen + 0.41 * 0.41), 0.03, 0.03
				del 3
			endif
		next id2
	next row2
next ib2

! ---- 階段室（段板・側桁・階段手すり） ----
! 2スパン以上の階段室は折り返し（踏面1スパン＋踊り場1スパン）。奇数層は始点側から
! 上り、偶数層は終点側から戻る。以前は区間全長の傾いた板1枚で、滑り台に見えた
stairW = rowW - 0.10
for it5 = 1 to nSt
	sx = stS[it5]
	sl = stL[it5]
	for il5 = 1 to nLv - 1
		rise = lv[il5 + 1] - lv[il5]
		! 踏面は1スパン＋踊り場が基本。上がりが大きい層（根がらみ→1層目など）で
		! 勾配が約49度を超えるなら踏面を区間全長にして踊り場を省く
		fl = sl
		if sl > 2.7 and rise / (sl / 2) <= 1.15 then fl = sl / 2
		nStep = int(rise / 0.225 + 0.5)
		if nStep < 1 then nStep = 1
		td = fl / nStep
		th = rise / nStep
		ang5 = atn(rise / fl)
		fLen = sqr(fl * fl + rise * rise)
		dirR = 1
		if il5 - 2 * int(il5 / 2) = 0 then dirR = 0
		if dirR = 1 then
			x0 = sx
			lx = sx + fl
		else
			x0 = sx + sl
			lx = sx
		endif
		nd = 3 - dirR
		! 段板
		for is5 = 1 to nStep
			if dirR = 1 then
				add x0 + (is5 - 1) * td, -rowW + 0.05, lv[il5] + is5 * th - 0.03
			else
				add x0 - is5 * td, -rowW + 0.05, lv[il5] + is5 * th - 0.03
			endif
			block td, stairW, 0.03
			del 1
		next is5
		! 踊り場（折り返しのとき。上の層の高さで残りの区間に敷く）
		if fl < sl - 0.001 then
			add lx, -rowW + 0.05, lv[il5 + 1] - 0.03
			block sl - fl, stairW, 0.03
			del 1
		endif
		! 側桁と階段手すり（両側）。終点側から戻る層は x を反転して描く
		for sd = 0 to 1
			ys = -rowW + 0.05 + sd * (stairW - 0.03)
			add x0, ys, lv[il5]
			if dirR = 0 then
				mulx -1
			endif
			roty -ang5
			block fLen, 0.03, 0.12
			del nd
			add x0, ys + 0.015, lv[il5] + 0.95
			if dirR = 0 then
				mulx -1
			endif
			roty 90 - ang5
			cylind fLen, r_nuno
			del nd
			! 手すり支柱（踏面の上下端）
			add x0, ys + 0.015, lv[il5]
			cylind 0.95, r_nuno
			del 1
			if dirR = 1 then
				add x0 + fl, ys + 0.015, lv[il5 + 1]
			else
				add x0 - fl, ys + 0.015, lv[il5 + 1]
			endif
			cylind 0.95, r_nuno
			del 1
		next sd
	next il5
next it5

! ---- ブラケット区間（拡幅ぶんの作業床＋支柱位置ごとのブラケット腕・方杖） ----
! 床だけ描くと宙に浮いて見えるうえ、数量では支柱位置ごとにブラケットを拾っている
for ik = 1 to nBk
	xb = 0
	for ipk = 1 to nSpan + 1
		if xb >= bkS[ik] - 0.001 and xb <= bkE[ik] + 0.001 then
			if bkD[ik] > 0 then
				add xb, 0, bkH[ik]
				rotx -90
				cylind bkW[ik], r_nuno
				del 2
				add xb, 0, bkH[ik] - bkW[ik]
				rotx -45
				cylind bkW[ik] * 1.4142, r_nuno
				del 2
			else
				add xb, -rowW, bkH[ik]
				rotx 90
				cylind bkW[ik], r_nuno
				del 2
				add xb, -rowW, bkH[ik] - bkW[ik]
				rotx 45
				cylind bkW[ik] * 1.4142, r_nuno
				del 2
			endif
		endif
		if ipk <= nSpan then xb = xb + spans[ipk]
	next ipk
	if bkD[ik] > 0 then
		add bkS[ik], 0, bkH[ik]
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 1
	else
		add bkS[ik], -rowW, bkH[ik]
		muly -1
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 2
		! 張出すと作業床の外縁が建地より外に出る。その縁は開放端なので
		! 手すり・中桟・幅木が要る（数量にも計上している）
		bkLen = bkE[ik] - bkS[ik]
		add bkS[ik], -rowW - bkW[ik], bkH[ik] + 0.045
		block bkLen, 0.02, 0.157
		del 1
		add bkS[ik], -rowW - bkW[ik] - 0.02, bkH[ik] + railH
		block bkLen, 0.0427, 0.0427
		del 1
		add bkS[ik], -rowW - bkW[ik] - 0.02, bkH[ik] + midH
		block bkLen, 0.0427, 0.0427
		del 1
		! 妻側（両端）も開放端。手すり・中桟・幅木（数量の「張出し妻側」と同じ）
		for ie2 = 0 to 1
			xk = bkS[ik] + bkLen * ie2
			for ir2 = 1 to 2
				if ir2 = 1 then hgt = railH else hgt = midH
				add xk, -rowW, bkH[ik] + hgt
				rotx 90
				cylind bkW[ik], r_nuno
				del 2
			next ir2
			if railAdv = 0 then
				add xk - 0.01, -rowW - bkW[ik], bkH[ik] + 0.045
				block 0.02, bkW[ik], 0.157
				del 1
			endif
		next ie2
	endif
next ik

end

end

! ============================================================
820: ! ---- ジャッキベース（敷板＋アンダーベース＋ねじ棒＋ハンドル付きナット） ----
! 原点は脚の下端（地盤）。呼び出し側の変換は増減しない。以前は細い棒1本で
! 敷板もナットも無く、ジャッキに見えなかった（ユーザー指摘）。
! 寸法: アンダーベース140角（SPB-24S）、ねじ棒φ38.1（SE-6）、ナットはハンドル付き。
! jo はジャッキ繰出し（敷板 sv を含む）。敷板があれば杉敷板300×210を sv の厚さに重ね、
! アンダーベースとねじ棒はその上から（ねじ棒の長さは jo - sv）
if sv > 0.001 then
	add -0.15, -0.105, 0
	block 0.30, 0.21, sv
	del 1
endif
add -0.07, -0.07, sv
block 0.14, 0.14, 0.006
del 1
add 0, 0, sv
cylind jo - sv, 0.0381 / 2
del 1
add 0, 0, jo - 0.03
resol 6
cylind 0.03, 0.045
resol 12
addz 0.015
roty 90
add 0, 0, -0.09
cylind 0.18, 0.006
del 4
return

800: ! ---- 一側足場の床受けブラケット（建地1列＋腕＋方杖） ----
! 作業床は建地から躯体側へ持ち出す。数量では「一側足場の床受けブラケット」
! として拾っているので、3Dにも出さないと図と部材表が食い違う
if il >= 2 then
	add x, -rowW, z
	rotz 90
	roty 90
	cylind rowW, r_nuno
	del 3
	add x, -rowW, z - rowW
	rotx -45
	cylind rowW * 1.4142, r_nuno
	del 2
endif
return

! ============================================================
900:	! ---- 線表示 ----
! 支柱（脚ごとの地盤高。開口部の梁枠より下は抜く）とジャッキベース板（140角）
x = 0
for ip = 1 to nSpan + 1
	gv = 0
	if ip <= nGl then gv = gl[ip]
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	for row = rowStart to 1
		yr = -row * rowW
		if bBase = 0 then
			lin_ x, yr, gv, x, yr, postTop
			lin_ x - 0.07, yr - 0.07, gv, x + 0.07, yr - 0.07, gv
			lin_ x + 0.07, yr - 0.07, gv, x + 0.07, yr + 0.07, gv
			lin_ x + 0.07, yr + 0.07, gv, x - 0.07, yr + 0.07, gv
			lin_ x - 0.07, yr + 0.07, gv, x - 0.07, yr - 0.07, gv
		else
			lin_ x, yr, bBase, x, yr, postTop
		endif
	next row
	if ip <= nSpan then x = x + spans[ip]
next ip
! 出隅コーナー: 外側コーナー支柱と各層の升目の輪郭
if cornerS = 1 then
	gv = 0
	if nGl >= 1 then gv = gl[1]
	lin_ -rowW, -rowW, gv, -rowW, -rowW, postTop
	for il = 1 to nLv
		z = lv[il]
		lin_ 0, 0, z, -rowW, 0, z
		lin_ -rowW, 0, z, -rowW, -rowW, z
		lin_ -rowW, -rowW, z, 0, -rowW, z
		if il > 1 then
			lin_ -rowW, 0, z + railTop, -rowW, -rowW, z + railTop
			lin_ -rowW, -rowW, z + railTop, 0, -rowW, z + railTop
		endif
	next il
endif
! 水平材: 根がらみ・各層の床レベル（内外）と外側の手すり、支柱位置の腕木。
! 開口部の梁枠より下は空ける（立体表現と同じ規則）
for il = 1 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		skipH = 0
		for ib6 = 1 to nBm
			if x >= bmS[ib6] - 0.001 and x + spans[ip] <= bmS[ib6] + bmL[ib6] + 0.001 and \
					z < bmH[ib6] - 0.001 then skipH = 1
		next ib6
		if skipH = 0 then
			for row = rowStart to 1
				lin_ x, -row * rowW, z, x + spans[ip], -row * rowW, z
			next row
			if il > 1 then
				lin_ x, -rowW, z + railTop, x + spans[ip], -rowW, z + railTop
				if railIn = 1 and nRows >= 2 then
					lin_ x, 0, z + railTop, x + spans[ip], 0, z + railTop
				endif
			endif
			lin_ x, 0, z, x, -rowW, z
			if ip = nSpan then lin_ x + spans[ip], 0, z, x + spans[ip], -rowW, z
		endif
		x = x + spans[ip]
	next ip
next il
! 階段室: 層ごとに折り返す斜線（踏面の両端）
for it5 = 1 to nSt
	sx = stS[it5]
	sl = stL[it5]
	for il5 = 1 to nLv - 1
		if il5 - 2 * int(il5 / 2) = 1 then
			xa = sx
			xb = sx + sl
		else
			xa = sx + sl
			xb = sx
		endif
		lin_ xa, -0.05, lv[il5], xb, -0.05, lv[il5 + 1]
		lin_ xa, -rowW + 0.05, lv[il5], xb, -rowW + 0.05, lv[il5 + 1]
	next il5
next it5
! 梁枠（開口部）: 上下弦材と両端の縦材
for ib2 = 1 to nBm
	bs = bmS[ib2]
	bl = bmL[ib2]
	bh = bmH[ib2]
	for row2 = rowStart to 1
		yr = -row2 * rowW
		lin_ bs, yr, bh - 0.45, bs + bl, yr, bh - 0.45
		lin_ bs, yr, bh - 0.45, bs, yr, bh
		lin_ bs + bl, yr, bh - 0.45, bs + bl, yr, bh
	next row2
next ib2
! 荷受けステージ: 張出し床の輪郭と先端の手すり
for ig = 1 to nSg
	lin_ sgS[ig], -rowW, sgH[ig], sgS[ig], -rowW - sgP[ig], sgH[ig]
	lin_ sgS[ig], -rowW - sgP[ig], sgH[ig], sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig]
	lin_ sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig], sgS[ig] + sgL[ig], -rowW, sgH[ig]
	lin_ sgS[ig], -rowW - sgP[ig], sgH[ig] + railTop, sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig] + railTop
	lin_ sgS[ig], -rowW - sgP[ig], sgH[ig], sgS[ig], -rowW - sgP[ig], sgH[ig] + railTop
	lin_ sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig], sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig] + railTop
next ig
! ブラケット区間: 拡幅した床の輪郭（内＝躯体側 +Y、張出＝外側 -Y）
for ik = 1 to nBk
	if bkD[ik] > 0 then
		y0 = 0
		y1 = bkW[ik]
	else
		y0 = -rowW
		y1 = -rowW - bkW[ik]
	endif
	lin_ bkS[ik], y0, bkH[ik], bkS[ik], y1, bkH[ik]
	lin_ bkS[ik], y1, bkH[ik], bkE[ik], y1, bkH[ik]
	lin_ bkE[ik], y1, bkH[ik], bkE[ik], y0, bkH[ik]
	if bkD[ik] < 0 then
		lin_ bkS[ik], y1, bkH[ik] + railTop, bkE[ik], y1, bkH[ik] + railTop
	endif
next ik
! 昇降機: マストの芯線と搬器の占有範囲（足場側に隙間0.10）
for ih = 1 to nHo
	hx = hoP[ih]
	cy = -rowW - 0.10
	cyo = cy - hoD[ih]
	lin_ hx, cyo - 0.15, 0, hx, cyo - 0.15, hoR[ih] + 1.0
	lin_ hx - hoW[ih] / 2, cy, 0, hx + hoW[ih] / 2, cy, 0
	lin_ hx + hoW[ih] / 2, cy, 0, hx + hoW[ih] / 2, cyo, 0
	lin_ hx + hoW[ih] / 2, cyo, 0, hx - hoW[ih] / 2, cyo, 0
	lin_ hx - hoW[ih] / 2, cyo, 0, hx - hoW[ih] / 2, cy, 0
	lin_ hx - hoW[ih] / 2, cy, 0, hx - hoW[ih] / 2, cy, hoR[ih]
	lin_ hx + hoW[ih] / 2, cy, 0, hx + hoW[ih] / 2, cy, hoR[ih]
next ih
! 壁つなぎ: 内側建地から躯体へ
for it = 1 to nTiePair
	lin_ ties[it], 0, tieH[it], ties[it], standoff, tieH[it]
next it
return

