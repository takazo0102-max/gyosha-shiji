! ==========================================================
! 足場ライン オブジェクト（くさび緊結式・1辺=1オブジェクト） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_line/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_line.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! アーキテクチャ決定（開発指示書2.1）:
!   部材1本ごとにオブジェクトを置かず、1つの辺を1つのGDLオブジェクトとし
!   内部で支柱・布材・踏板・手すり・幅木・ブレスをパラメトリック生成する。
!   Python側は割付を解いてこのオブジェクトを辺の数だけ置くのみ。
! ----------------------------------------------------------
! パラメータリスト:
!   spanList       文字列  スパン構成 mm カンマ区切り                               既定 "1800,1800,1800"
!   postList       文字列  支柱構成 mm 下から                                       既定 "3600,3600,1800"
!   jackOut        長さ    ジャッキ繰り出し量                                       既定 0.1
!   komaPitch      長さ    コマピッチ                                               既定 0.45
!   floorH         長さ    階高                                                     既定 1.8
!   rowW           長さ    内外建地間隔                                             既定 0.6
!   standoff       長さ    壁離れ                                                   既定 0.3
!   deckW1         長さ    踏板1幅                                                  既定 0.4
!   deckW2         長さ    踏板2幅 0で無し                                          既定 0.25
!   showDeck       ブール  踏板表示                                                 既定 1
!   showBrace      ブール  ブレス表示                                               既定 1
!   showDim        ブール  2D寸法・注記表示                                         既定 1
!   serType        文字列  系列 A/B                                                 既定 "A"
!   viewMode       文字列  2D表現 plan=平面 / elev=立面                             既定 "plan"
!   tieList        文字列  壁つなぎ位置 mm カンマ区切り（辺始点から）               既定 ""
!   tieHeightList  文字列  壁つなぎ高さ mm カンマ区切り（GLから）                   既定 ""
!   flList         文字列  各階FL高さ mm カンマ区切り（立面の参照線）               既定 ""
!   faceName       文字列  面の名称（立面図の図面名）                               既定 ""
!   levelList      文字列  作業床高さ mm カンマ区切り（GLから・立面ソルバの結果）   既定 ""
!   negaH          長さ    根がらみ高さ GLから 0で自動                              既定 0
!   railH          長さ    手すり高さ 作業床から 0で自動                            既定 0
!   midH           長さ    中桟高さ 作業床から 0で自動                              既定 0
!   stageList      文字列  荷受けステージ mm 「開始,長さ,出,設置高さ」の繰り返し    既定 ""
!   beamList       文字列  梁枠 mm 「開始,スパン,梁下高さ」の繰り返し               既定 ""
!   stairList      文字列  階段室の区間 mm 「開始,長さ」の繰り返し（辺の始点から）  既定 ""
!   asagaoList     文字列  朝顔の設置高さ mm カンマ区切り（GLから）                 既定 ""
!   asagaoProj     長さ    朝顔の水平突出                                           既定 2
!   asagaoAngle    実数    朝顔の傾斜 度                                            既定 25
!   braceEveryS    整数    斜材の設置間隔 スパン 1=全構面                           既定 1
!   braceEveryL    整数    斜材の設置間隔 層 1=全層                                 既定 1
!   nRows          整数    建地列数 2=本足場 1=一側足場                             既定 2
!   warnPen        整数    注記強調のペン番号 ペンテーブル依存                      既定 20
!   texSiz         実数    文字高mm                                                 既定 2.5
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! ============================================================
! 足場ライン マスタースクリプト（くさび緊結式・1辺=1オブジェクト）
! 配置規約: 原点=始点コーナー支柱（内側建地列）、+X=辺方向、+Y=躯体側
! 2D表現は viewMode で切替: plan=平面 / elev=立面
!
! 文字列リストのパースは gosub にせずインラインで展開している。
! マスタースクリプトでの gosub は動作しない環境があり、失敗すると
! 2D/3Dとも一切描画されない（実機で確認済み）。
! ============================================================
dim spans[30]
dim posts[20]
dim ties[80]
dim tieH[80]
dim fls[20]
dim lv[42]
dim levIn[40]
dim asa[8]
dim stS[8]
dim stL[8]
dim bmS[8]
dim bmL[8]
dim bmH[8]
dim sgS[8]
dim sgL[8]
dim sgP[8]
dim sgH[8]

! ---- spanList をパース (mm→m) ----
nSpan = 0
rest = spanList
while strlen(rest) > 0 and nSpan < 30 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSpan = nSpan + 1
		spans[nSpan] = v / 1000
	endif
endwhile
if nSpan = 0 then
	nSpan = 1
	spans[1] = 1.8
endif

! ---- postList をパース (mm→m) ----
nPost = 0
rest = postList
while strlen(rest) > 0 and nPost < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPost = nPost + 1
		posts[nPost] = v / 1000
	endif
endwhile
if nPost = 0 then
	nPost = 1
	posts[1] = 3.6
endif

! ---- tieList をパース (mm→m) ----
nTie = 0
rest = tieList
while strlen(rest) > 0 and nTie < 80 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTie = nTie + 1
		ties[nTie] = v / 1000
	endif
endwhile

! ---- tieHeightList をパース (mm→m) ----
nTieH = 0
rest = tieHeightList
while strlen(rest) > 0 and nTieH < 80 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTieH = nTieH + 1
		tieH[nTieH] = v / 1000
	endif
endwhile

! ---- flList をパース (mm→m) ----
nFL = 0
rest = flList
while strlen(rest) > 0 and nFL < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nFL = nFL + 1
		fls[nFL] = v / 1000
	endif
endwhile

! ---- levelList をパース (mm→m) ----
! 作業床の高さはPython側の立面ソルバが決めた値をそのまま受け取る。
! GDLで komaPitch から再計算すると、コマの概念が無い枠組（komaPitch=0）で
! 破綻するうえ、ソルバの結果と図面がずれる。
nLevIn = 0
rest = levelList
while strlen(rest) > 0 and nLevIn < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nLevIn = nLevIn + 1
		levIn[nLevIn] = v / 1000
	endif
endwhile

! ---- stageList をパース「開始,長さ,出,設置高さ」の繰り返し (mm→m) ----
! 荷受けステージは出1.5mの張り出し床。構造計算では直下の建地を個別に
! 検定しているのに、図面にも3Dにも出ていなかった
nSg = 0
sgIdx = 0
sgA = 0
sgB = 0
sgC = 0
rest = stageList
while strlen(rest) > 0 and nSg < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		sgIdx = sgIdx + 1
		md = sgIdx - 4 * int(sgIdx / 4)   ! 1,2,3,0 の繰り返し
		if md = 1 then sgA = v / 1000
		if md = 2 then sgB = v / 1000
		if md = 3 then sgC = v / 1000
		if md = 0 then
			nSg = nSg + 1
			sgS[nSg] = sgA
			sgL[nSg] = sgB
			sgP[nSg] = sgC
			sgH[nSg] = v / 1000
		endif
	endif
endwhile

! ---- beamList をパース「開始,スパン,梁下高さ」の繰り返し (mm→m) ----
! 梁枠は支柱を抜いて通路にする箇所。図面が抜いた支柱を描いたままだと、
! 実際には無い建地を図面が示すことになる
nBm = 0
bmIdx = 0
bmT1 = 0
bmT2 = 0
rest = beamList
while strlen(rest) > 0 and nBm < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		bmIdx = bmIdx + 1
		md = bmIdx - 3 * int(bmIdx / 3)   ! 1,2,0 の繰り返し
		if md = 1 then
			bmT1 = v / 1000
		endif
		if md = 2 then
			bmT2 = v / 1000
		endif
		if md = 0 then
			nBm = nBm + 1
			bmS[nBm] = bmT1
			bmL[nBm] = bmT2
			bmH[nBm] = v / 1000
		endif
	endif
endwhile

! ---- stairList をパース「開始,長さ」の繰り返し (mm→m) ----
! 階段室は数量（踏板の差引）にも帳票にも出るのに、図面に位置が
! 出ていなかった。昇降設備の位置は計画図の主要情報
nSt = 0
stTmp = 0
stIdx = 0
rest = stairList
while strlen(rest) > 0 and nSt < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		stIdx = stIdx + 1
		if stIdx - 2 * int(stIdx / 2) = 1 then
			stTmp = v / 1000
		else
			nSt = nSt + 1
			stS[nSt] = stTmp
			stL[nSt] = v / 1000
		endif
	endif
endwhile

! ---- asagaoList をパース (mm→m) ----
! 朝顔は数量にも法規チェックにも出るのに、図面にも3Dにも現れていなかった。
! 突出2mの部材なので、干渉確認のためにモデルへ出す
nAsa = 0
rest = asagaoList
while strlen(rest) > 0 and nAsa < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nAsa = nAsa + 1
		asa[nAsa] = v / 1000
	endif
endwhile

! ---- 派生値 ----
lineLen = 0
for i = 1 to nSpan
	lineLen = lineLen + spans[i]
next i
postTop = jackOut
for i = 1 to nPost
	postTop = postTop + posts[i]
next i
! 根がらみ高さ。negaH が渡されていればそれを使う（枠組は建枠脚部が相当）
firstLedger = negaH
if firstLedger <= 0 then firstLedger = jackOut + komaPitch

! レベル列: lv[1]=根がらみ、lv[2..nLv]=作業床（下から昇順）
lv[1] = firstLedger
if nLevIn > 0 then
	! Python側の立面ソルバが決めた作業床高さをそのまま使う
	nLevels = nLevIn
	for il = 1 to nLevels
		lv[il + 1] = levIn[il]
	next il
	topFloor = levIn[nLevels]
else
	! 単体で置いた場合のフォールバック（くさび式の積み方から推定）
	topFloor = postTop - 2 * komaPitch
	nLevels = 0
	h = topFloor
	while h > firstLedger + komaPitch do
		nLevels = nLevels + 1
		h = h - floorH
	endwhile
	for il = 1 to nLevels
		lv[il + 1] = topFloor - (nLevels - il) * floorH
	next il
endif
nLv = nLevels + 1

! 手すり・中桟の高さ（作業床から）。komaPitch の倍数で決め打ちすると
! コマの概念が無い枠組で 0 になり、手すりが作業床に重なって消える
railTop = railH
if railTop <= 0 then railTop = 2 * komaPitch
railMid = midH
if railMid <= 0 then railMid = komaPitch

! 壁つなぎは位置と高さの対。短い方に合わせる
nTiePair = nTie
if nTieH < nTiePair then nTiePair = nTieH

! 斜材の設置間隔。数量は「6層6スパン以下毎に交さ2方向」で拾っているので、
! 図面を全構面に描くと部材表と食い違う（発注40本に対し図面896本）
bEvS = braceEveryS
if bEvS < 1 then bEvS = 1
bEvL = braceEveryL
if bEvL < 1 then bEvL = 1

! 建地列。一側足場は1列で、建地は外側1列だけ立ち、床は躯体側へ張り出す。
! 列数を見ないと、一側足場の計画でも図面は本足場（2列）で描かれる
rowStart = 0
if nRows < 2 then rowStart = 1

r_sic  = 0.0486 / 2	! 支柱 φ48.6
r_nuno = 0.0427 / 2	! 布材 φ42.7
r_tie  = 0.0273 / 2	! 壁つなぎ φ27.2

! ---- 注記のレイアウト用（文字高は縮尺依存なので実寸を求めて行送りに使う）----
! GLOB_SCALE = 縮尺の分母（1/20なら20）。texSiz は用紙上のmm
txtH = texSiz * GLOB_SCALE / 1000
txtLine = txtH * 1.8

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 足場ライン 2Dスクリプト（viewMode で平面／立面を切替）
!   plan: 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体面 y=+standoff
!   elev: X=面に沿った距離 / Y=GLからの高さ
! ============================================================
define style "anno" "ＭＳ Ｐゴシック", texSiz, 1, 0
set style "anno"
pen 1

if viewMode = "elev" then
	gosub 200
else
	gosub 100
endif
end

! ============================================================
100: ! ---- 平面図 ----
line2 0, 0, lineLen, 0
line2 0, -rowW, lineLen, -rowW

! スパン区切り線と布板の対角線。平面図で「作業床が敷いてある区画」を表す
! 慣用表記で、実務の足場平面図はこの見え方になる。対角線の向きは全スパン
! 揃える（向きを交互にするとブレスの表記と紛らわしい）。
x = 0
for ip = 1 to nSpan
	line2 x, 0, x, -rowW
	! 階段室の区間には踏板を敷かない（数量でも差し引いている）。
	! ここに対角線を引くと、敷いていない床を描くことになる
	inStair = 0
	for it2 = 1 to nSt
		if x >= stS[it2] - 0.001 and x + spans[ip] <= stS[it2] + stL[it2] + 0.001 then inStair = 1
	next it2
	if showDeck and inStair = 0 then line2 x, -rowW, x + spans[ip], 0
	x = x + spans[ip]
next ip
line2 x, 0, x, -rowW

x = 0
for ip = 1 to nSpan + 1
	! 梁枠の内側の支柱は抜いてある。描くと実際には無い建地を示すことになる
	removed = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then removed = 1
	next ib
	if removed = 0 then
		if nRows >= 2 then circle2 x, 0, r_sic
		circle2 x, -rowW, r_sic
	endif
	hotspot2 x, 0
	if ip <= nSpan then x = x + spans[ip]
next ip

! 梁枠の区間（平面では太い二重線と文字）
for ib = 1 to nBm
	bs = bmS[ib]
	be = bs + bmL[ib]
	line2 bs, -rowW, be, -rowW
	line2 bs, -rowW - 0.06, be, -rowW - 0.06
	line2 bs, -rowW, bs, -rowW - 0.06
	line2 be, -rowW, be, -rowW - 0.06
	if showDim then text2 (bs + be) / 2, -rowW - 0.20, "梁枠 " + str(bmL[ib] * 1000, 5, 0)
next ib
hotspot2 0, -rowW
hotspot2 lineLen, -rowW

! 階段室（平面では区間を囲ってタスキと文字で示す）
for it2 = 1 to nSt
	sx = stS[it2]
	ex = sx + stL[it2]
	line2 sx, 0, sx, -rowW
	line2 ex, 0, ex, -rowW
	line2 sx, 0, ex, -rowW
	line2 sx, -rowW, ex, 0
	if showDim then text2 (sx + ex) / 2, -rowW / 2, "階段"
next it2

! 荷受けステージ（平面では外側への張り出し外形）
for ig = 1 to nSg
	gs = sgS[ig]
	ge = gs + sgL[ig]
	gy = -rowW - sgP[ig]
	line2 gs, -rowW, gs, gy
	line2 ge, -rowW, ge, gy
	line2 gs, gy, ge, gy
	line2 gs, -rowW, ge, gy
	line2 gs, gy, ge, -rowW
	if showDim then text2 (gs + ge) / 2, gy - 0.15, "荷受けステージ 出" + str(sgP[ig] * 1000, 4, 0)
next ig

! 朝顔の突出範囲（平面では外側への張り出し外形を破線で示す）
if nAsa > 0 then
	line_type 3
	line2 0, -rowW - asagaoProj, lineLen, -rowW - asagaoProj
	line2 0, -rowW, 0, -rowW - asagaoProj
	line2 lineLen, -rowW, lineLen, -rowW - asagaoProj
	line_type 1
	if showDim then text2 lineLen / 2, -rowW - asagaoProj - 0.15, "朝顔 突出" + str(asagaoProj * 1000, 4, 0) + " " + str(nAsa, 1, 0) + "段"
endif

! 躯体面の参照線（離れ表示）
line_type 3
line2 0, standoff, lineLen, standoff
line_type 1

! 壁つなぎ位置（平面でも位置が分かるよう大きめの丸で示す）
for it = 1 to nTie
	circle2 ties[it], standoff / 2, 0.09
	line2 ties[it], 0, ties[it], standoff
next it

if not(showDim) then return

x = 0
for ip = 1 to nSpan
	text2 x + spans[ip] / 2, -rowW - 0.25, str(spans[ip] * 1000, 5, 0)
	line2 x, -rowW - 0.15, x, -rowW - 0.35
	x = x + spans[ip]
next ip
line2 x, -rowW - 0.15, x, -rowW - 0.35
text2 lineLen / 2, -rowW - 0.55, "L=" + str(lineLen * 1000, 6, 0) + " 離れ" + str(standoff * 1000, 4, 0)
return

! ============================================================
200: ! ---- 立面図 ----
! 作図順（実務）: GL・ジャッキ → 1段目 → 上へ積上げ → 壁つなぎ → 寸法・特記

! GL と地盤ハッチ
line2 -0.5, 0, lineLen + 0.5, 0
gx = -0.45
while gx < lineLen + 0.45 do
	line2 gx, 0, gx - 0.08, -0.08
	gx = gx + 0.12
endwhile
text2 -0.5, -0.22, "GL"

! 各階FLの参照線（躯体との対応を見るため）
line_type 3
for ifl = 1 to nFL
	line2 -0.3, fls[ifl], lineLen + 0.3, fls[ifl]
	text2 lineLen + 0.35, fls[ifl], str(ifl, 1, 0) + "FL"
next ifl
line_type 1

! 支柱（ジャッキ＋積上げ）と ジョイント位置
x = 0
for ip = 1 to nSpan + 1
	! 梁枠の内側は支柱を抜き、梁下から上だけ描く
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	! ジャッキ（敷板含む脚部）
	if bBase = 0 then
		rect2 x - 0.02, 0, x + 0.02, jackOut
		line2 x - 0.06, 0, x + 0.06, 0
	endif
	! 支柱
	if bBase = 0 then
		rect2 x - r_sic, jackOut, x + r_sic, postTop
	else
		rect2 x - r_sic, bBase, x + r_sic, postTop
	endif
	! 縦継ぎ（ジョイント）位置に短い横線
	jh = jackOut
	for jp = 1 to nPost - 1
		jh = jh + posts[jp]
		line2 x - 0.05, jh, x + 0.05, jh
	next jp
	hotspot2 x, 0
	hotspot2 x, postTop
	if ip <= nSpan then x = x + spans[ip]
next ip

! 根がらみ（最下コマ）＝ lv[1]
line2 0, lv[1], lineLen, lv[1]
line2 0, lv[1] + 0.02, lineLen, lv[1] + 0.02

! 各作業層: 布板・手すり・中桟・幅木
for il = 2 to nLv
	z = lv[il]
	! 布板（作業床）
	rect2 0, z, lineLen, z + 0.05
	! 幅木
	rect2 0, z + 0.05, lineLen, z + 0.05 + 0.157
	! 手すり・中桟
	line2 0, z + railMid, lineLen, z + railMid
	line2 0, z + railTop, lineLen, z + railTop
next il

! ブレス（交互向き）。設置間隔は数量拾いと揃える
x = 0
for ip = 1 to nSpan
	for il = 1 to nLv - 1
		if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 and il - 1 - bEvL * int((il - 1) / bEvL) = 0 then
			if ip - 2 * int(ip / 2) = 0 then
				line2 x, lv[il], x + spans[ip], lv[il + 1]
			else
				line2 x + spans[ip], lv[il], x, lv[il + 1]
			endif
		endif
	next il
	x = x + spans[ip]
next ip

! 階段室（立面では区間の各層に斜めの段板を示す）
for it2 = 1 to nSt
	sx = stS[it2]
	ex = sx + stL[it2]
	line2 sx, lv[1], sx, postTop
	line2 ex, lv[1], ex, postTop
	for il = 1 to nLv - 1
		if il - 2 * int(il / 2) = 0 then
			line2 sx, lv[il], ex, lv[il + 1]
		else
			line2 ex, lv[il], sx, lv[il + 1]
		endif
	next il
	if showDim then text2 (sx + ex) / 2, lv[1] - 0.2, "階段"
next it2

! 荷受けステージ（立面では設置高さの区間を太線と文字で）
for ig = 1 to nSg
	gs = sgS[ig]
	ge = gs + sgL[ig]
	gh = sgH[ig]
	rect2 gs, gh, ge, gh + 0.05
	line2 gs, gh, gs, gh + 0.9
	line2 ge, gh, ge, gh + 0.9
	line2 gs, gh + 0.9, ge, gh + 0.9
	if showDim then text2 (gs + ge) / 2, gh + 1.05, "荷受けステージ 出" + str(sgP[ig] * 1000, 4, 0)
next ig

! 梁枠（立面ではトラス）
for ib = 1 to nBm
	bs = bmS[ib]
	be = bs + bmL[ib]
	bh = bmH[ib]
	line2 bs, bh, be, bh
	line2 bs, bh - 0.45, be, bh - 0.45
	line2 bs, bh - 0.45, bs, bh
	line2 be, bh - 0.45, be, bh
	nd = 4
	for id = 0 to nd - 1
		dx1 = bs + bmL[ib] * id / nd
		dx2 = bs + bmL[ib] * (id + 1) / nd
		if id - 2 * int(id / 2) = 0 then
			line2 dx1, bh - 0.45, dx2, bh
		else
			line2 dx1, bh, dx2, bh - 0.45
		endif
	next id
	if showDim then text2 (bs + be) / 2, bh - 0.65, "梁枠 " + str(bmL[ib] * 1000, 5, 0)
next ib

! 朝顔（立面では設置高さに太線と注記）
for ia = 1 to nAsa
	za = asa[ia]
	line2 0, za, lineLen, za
	line2 0, za + 0.02, lineLen, za + 0.02
	if showDim then text2 lineLen + 0.1, za, "朝顔" + str(ia, 1, 0) + "段目 GL+" + str(za * 1000, 5, 0)
next ia

! 壁つなぎ: 形状を描いても判別できないので大きな丸印で示す（実務の作図法）
pen warnPen
! tieList と tieHeightList は同じ長さの対（i番目の位置とi番目の高さが1組）
for it = 1 to nTiePair
	circle2 ties[it], tieH[it], 0.12
	line2 ties[it] - 0.08, tieH[it], ties[it] + 0.08, tieH[it]
	line2 ties[it], tieH[it] - 0.08, ties[it], tieH[it] + 0.08
next it
pen 1

if not(showDim) then return

! ---- 高さ寸法（左側）: 各層と全高 ----
dx = -0.35
line2 dx, 0, dx, postTop
for il = 1 to nLv
	line2 dx - 0.06, lv[il], dx + 0.06, lv[il]
	text2 dx - txtH, lv[il], str(lv[il] * 1000, 6, 0)
next il
line2 dx - 0.06, postTop, dx + 0.06, postTop
text2 dx - txtH, postTop, "H=" + str(postTop * 1000, 6, 0)
text2 dx - txtH, jackOut / 2, "ジャッキ" + str(jackOut * 1000, 4, 0)

! ---- スパン寸法（下側） ----
dy = -0.45
x = 0
for ip = 1 to nSpan
	text2 x + spans[ip] / 2, dy - txtLine, str(spans[ip] * 1000, 5, 0)
	line2 x, dy, x, dy - 0.06
	x = x + spans[ip]
next ip
line2 x, dy, x, dy - 0.06
line2 0, dy, lineLen, dy
text2 lineLen / 2, dy - txtLine * 2.2, "L=" + str(lineLen * 1000, 6, 0)

! ---- 特記（形状では判別できないものは文字で書く。実務の作図法） ----
tx = lineLen + 0.5
ny = postTop
text2 tx, ny, "立面図 " + faceName
ny = ny - txtLine * 1.4
text2 tx, ny, "根がらみ: 最下コマ（布板と区別がつかないため特記）"
ny = ny - txtLine
text2 tx, ny, "頭つなぎ: 最上段（同上）"
ny = ny - txtLine
text2 tx, ny, "内側: ブレース＋幅木"
ny = ny - txtLine
text2 tx, ny, "外側: ブレース＋手すり＋中桟"
ny = ny - txtLine
text2 tx, ny, "作業層 " + str(nLevels, 2, 0) + "層 / 階高 " + str(floorH * 1000, 5, 0)
ny = ny - txtLine
text2 tx, ny, "壁つなぎ " + str(nTiePair, 3, 0) + "箇所（○印）"
ny = ny - txtLine
text2 tx, ny, "壁離れ " + str(standoff * 1000, 4, 0)
return

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 足場ライン 3Dスクリプト
! 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体側 +Y
! ============================================================
pen 1

! ---- 支柱（各スパン境界に内外1対） ----
x = 0
for ip = 1 to nSpan + 1
	for row = rowStart to 1
		add x, -row * rowW, 0
		! ジャッキ
		cylind jackOut, 0.0381 / 2
		addz jackOut
		! 支柱積み上げ
		for j = 1 to nPost
			cylind posts[j], r_sic
			addz posts[j]
		next j
		del nPost + 2
	next row
	if ip <= nSpan then x = x + spans[ip]
next ip

! ---- 水平材（根がらみ＋各作業層） ----
for il = 1 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		! 内外の布材（床レベル）
		for row = rowStart to 1
			add x, -row * rowW, z
			roty 90
			cylind spans[ip], r_nuno
			del 2
		next row
		! 外側手すり・中桟（作業層のみ）
		if il > 1 then
			add x, -rowW, z + railTop
			roty 90
			cylind spans[ip], r_nuno
			del 2
			add x, -rowW, z + railMid
			roty 90
			cylind spans[ip], r_nuno
			del 2
		endif
		! 腕木（内外連結、-Y向き）。一側足場は内側建地が無いので入らない
		if nRows >= 2 then
			add x, 0, z
			rotz -90
			roty 90
			cylind rowW, r_nuno
			del 3
		endif
		x = x + spans[ip]
	next ip
	! 終端の腕木
	if nRows >= 2 then
		add x, 0, z
		rotz -90
		roty 90
		cylind rowW, r_nuno
		del 3
	endif
next il

! ---- 踏板・幅木 ----
if showDeck then
	for il = 2 to nLv
		z = lv[il]
		x = 0
		for ip = 1 to nSpan
			add x, -rowW + 0.05, z
			block spans[ip], deckW1, 0.045
			del 1
			if deckW2 > 0 then
				add x, -rowW + 0.05 + deckW1 + 0.02, z
				block spans[ip], deckW2, 0.045
				del 1
			endif
			! 幅木（外側）
			add x, -rowW - 0.02, z + 0.045
			block spans[ip], 0.02, 0.157
			del 1
			x = x + spans[ip]
		next ip
	next il
endif

! ---- ブレス（外側構面、スパンごとに交互方向） ----
! 設置間隔は bEvS スパン・bEvL 層ごと（1なら全構面）。数量拾いと
! 同じ間隔で描かないと、部材表と図面の本数が食い違う
if showBrace then
	for il = 1 to nLv - 1
		if il - 1 - bEvL * int((il - 1) / bEvL) = 0 then
			z1 = lv[il]
			z2 = lv[il + 1]
			x = 0
			for ip = 1 to nSpan
				if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 then
					bl = sqr(spans[ip] ^ 2 + (z2 - z1) ^ 2)
					ang = atn((z2 - z1) / spans[ip])
					if ip - 2 * int(ip / 2) = 0 then
						add x, -rowW - 0.05, z1
						roty 90 - ang
						cylind bl, 0.0213 / 2
						del 2
					else
						add x + spans[ip], -rowW - 0.05, z1
						mulx -1
						roty 90 - ang
						cylind bl, 0.0213 / 2
						del 3
					endif
				endif
				x = x + spans[ip]
			next ip
		endif
	next il
endif

! ---- 朝顔（防護棚）: 外側へ突出する傾斜板と受けブラケット ----
! 突出2m・傾斜25度。数量にも法規チェックにも出るのに図面・3Dに
! 現れていなかった。突出2mの部材なので干渉確認のため実寸で出す
! 外側は -Y なので muly -1 でローカル+Yを外向きにしてから傾ける。
! そのまま block を置くと躯体側（+Y）へ張り出してしまう
for ia = 1 to nAsa
	za = asa[ia]
	! 板（外側へ張り出し、先端が上がる）
	add 0, -rowW, za
	muly -1
	rotx asagaoAngle
	block lineLen, asagaoProj, 0.02
	del 3
	! 受けブラケット（支柱位置ごと）
	x = 0
	for ip = 1 to nSpan + 1
		add x, -rowW, za
		muly -1
		rotx asagaoAngle - 90
		cylind asagaoProj, 0.0213 / 2
		del 3
		if ip <= nSpan then x = x + spans[ip]
	next ip
next ia

! ---- 壁つなぎ（内側建地から躯体側へ +Y 方向） ----
! 構造計算でも法規チェックでも見ているのに3Dに無く、躯体との
! 取り合いが確認できなかった
for it = 1 to nTiePair
	add ties[it], 0, tieH[it]
	rotx -90
	cylind standoff, r_tie
	del 2
next it

! ---- 荷受けステージ（外側へ張り出す床・手すり） ----
for ig = 1 to nSg
	add sgS[ig], -rowW, sgH[ig]
	muly -1
	block sgL[ig], sgP[ig], 0.05
	del 2
	! 手すり（張り出し先端と両側）
	add sgS[ig], -rowW - sgP[ig], sgH[ig] + 0.9
	roty 90
	cylind sgL[ig], r_nuno
	del 2
next ig

end

