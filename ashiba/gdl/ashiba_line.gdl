!   nRows           整数      建地列数 2=本足場 1=一側足場                                                                                    既定 2
!   warnPen         整数      注記強調のペン番号 ペンテーブル依存                                                                             既定 20
!   texSiz          実数      文字高mm                                                                                                        既定 2.5
!   penPost         PenColor  ペン: 支柱                                                                                                      既定 1
!   penLine         PenColor  ペン: 足場の線（建地列・布材・手すり）                                                                          既定 1
!   penDeck         PenColor  ペン: 床（対角線・踏板）                                                                                        既定 1
!   penStair        PenColor  ペン: 階段                                                                                                      既定 1
!   penEquip        PenColor  ペン: 付帯設備（ステージ・昇降機・朝顔・ブラケット・梁枠）                                                      既定 1
!   penTie          PenColor  ペン: 壁つなぎ                                                                                                  既定 1
!   penDim          PenColor  ペン: 寸法・文字                                                                                                既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! ============================================================
! 足場ライン マスタースクリプト（くさび緊結式・1辺=1オブジェクト）
! 配置規約: 原点=始点コーナー支柱（内側建地列）、+X=辺方向、+Y=躯体側
! 2D表現は viewMode で切替: plan=平面 / elev=立面
!
! 文字列リストのパースは gosub にせずインラインで展開している。
! マスタースクリプトでの gosub は動作しない環境があり、失敗すると
! 2D/3Dとも一切描画されない（実機で確認済み）。
! ============================================================
dim spans[60]
dim posts[40]
dim postsA[40]
dim rl[2][20]
dim bdLen[2][30]
dim nBd[2]
dim nRl[2]
dim runE[2]
dim ties[200]
dim brOn[60]
dim slL[8]
dim slV[36]
dim tieH[200]
dim gl[61]
dim jk[61]
dim sh[61]
dim glO[61]
dim jkO[61]
dim shO[61]
dim fls[20]
dim lv[42]
dim levIn[40]
dim htI[16]
dim asa[8]
dim cutS[8]
dim cutE[8]
dim asgA[9]
dim asgB[9]
dim stS[8]
dim stL[8]
dim bmS[8]
dim bmL[8]
dim bmH[8]
dim brS[8]
dim brL[8]
dim brD[8]
dim brK[8]
dim sgS[8]
dim sgL[8]
dim sgP[8]
dim sgH[8]
dim sgZ[8]
dim sgF[8]
dim hoP[4]
dim hoR[4]
dim hoW[4]
dim hoD[4]
dim hoTp[4]
dim laP[40]
dim ikA[8]
dim ikB[8]
dim ikL1[8]
dim ikL2[8]
dim laH[40]
dim bkS[24]
dim bkE[24]
dim bkW[24]
dim bkD[24]
dim bkH[24]
dim edA[16]
dim edB[16]
dim edC[16]
dim edD[16]
dim edE[16]
dim bkDW[24]

! ---- spanList をパース (mm→m) ----
nSpan = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! spanList2〜spanList2 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 2
	rest = spanList
	if tc = 2 then rest = spanList2
	while strlen(rest) > 0 and nSpan < 60 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nSpan = nSpan + 1
			spans[nSpan] = v / 1000
		endif
	endwhile
next tc
if nSpan = 0 then
	nSpan = 1
	spans[1] = 1.8
endif

! ---- スパンのホットスポット編集（足場計画.gsm のスパン制御と同じ考え方） ----
! 平面の支柱位置を引くと xEdit[i] が変わる。動かした境界の手前のスパンを規格寸法
! （sizeList＝系列の布材）に吸着し、後ろのスパンに残りを渡して面の長さを保つ。
! 直した spanList は Python が読み戻して span_overrides にする（read_back_spans.py）。
! Python から置き直したとき（GLOB_MODPAR_NAME が xEdit でない）は spanList が正で、
! xEdit は spanList から作り直す
dim szL[20]
nSz = 0
rest = sizeList
while strlen(rest) > 0 and nSz < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSz = nSz + 1
		szL[nSz] = v / 1000
	endif
endwhile
szMin = 0.3
if nSz > 0 then
	szMin = szL[1]
	for k = 2 to nSz
		if szL[k] < szMin then szMin = szL[k]
	next k
endif
! 診断: 直前に変わったパラメータ名（空のときは上書きしない。再描画のたびに消えて切り分けにならなかった）
if GLOB_MODPAR_NAME <> "" then
	parameters lastMod = "1D:" + GLOB_MODPAR_NAME + "|" + str(vardim1(xEdit), 1, 0) + "|" + str(nSpan, 1, 0)
endif
! xEdit（支柱位置）の作り直しはパラメータスクリプト（vl.gdl）で行う。マスタースクリプトで
! 要素数が変わる配列（xEdit）を parameters 文で書き戻すと、2D・3Dが何も描かなくなる
! （実機で切り分け: このブロックを外すと描ける）

! ---- postList をパース (mm→m) ----
nPost = 0
rest = postList
while strlen(rest) > 0 and nPost < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPost = nPost + 1
		posts[nPost] = v / 1000
	endif
endwhile
if nPost = 0 then
	nPost = 1
	posts[1] = 3.6
endif

! ---- postListAlt（単管の千鳥。偶数番目の建地の支柱構成）をパース ----
nPostA = 0
rest = postListAlt
while strlen(rest) > 0 and nPostA < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPostA = nPostA + 1
		postsA[nPostA] = v / 1000
	endif
endwhile

! ---- tubeRunA・tubeRunB（単管の通しの割付。規定の長さの単管を直線ジョイントで継ぐ）をパース ----
runS = tubeRunS
for p832 = 1 to 2
	nRl[p832] = 0
	runE[p832] = runS
	rest = tubeRunA
	if p832 = 2 then rest = tubeRunB
	while strlen(rest) > 0 and nRl[p832] < 20 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nRl[p832] = nRl[p832] + 1
			rl[p832][nRl[p832]] = v / 1000
			runE[p832] = runE[p832] + v / 1000
		endif
	endwhile
next p832
! ---- deckRunA・deckRunB（単管のブラケット足場の足場板の割付。継ぎは bdLap 重ねる）をパース ----
bdS = deckRunS
bdLap = 0.3
for p870 = 1 to 2
	nBd[p870] = 0
	rest = deckRunA
	if p870 = 2 then rest = deckRunB
	while strlen(rest) > 0 and nBd[p870] < 30 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nBd[p870] = nBd[p870] + 1
			bdLen[p870][nBd[p870]] = v / 1000
		endif
	endwhile
next p870
! 3D の布・手すりの呼び出し側が、この区間の通しの割付（runP: 0=通さない 1=A 2=B）と区間の始め（runX）を渡す
runP = 0
runX = 0

! ---- tieList をパース (mm→m) ----
nTie = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! tieList2〜tieList5 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 5
	rest = tieList
	if tc = 2 then rest = tieList2
	if tc = 3 then rest = tieList3
	if tc = 4 then rest = tieList4
	if tc = 5 then rest = tieList5
	while strlen(rest) > 0 and nTie < 200 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nTie = nTie + 1
			ties[nTie] = v / 1000
		endif
	endwhile
next tc

! ---- tieHeightList をパース (mm→m) ----
nTieH = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! tieHeightList2〜tieHeightList5 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 5
	rest = tieHeightList
	if tc = 2 then rest = tieHeightList2
	if tc = 3 then rest = tieHeightList3
	if tc = 4 then rest = tieHeightList4
	if tc = 5 then rest = tieHeightList5
	while strlen(rest) > 0 and nTieH < 200 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nTieH = nTieH + 1
			tieH[nTieH] = v / 1000
		endif
	endwhile
next tc

! ---- glList をパース (mm→m) ----
! 敷地高低差: 支柱位置ごとの値。空なら平坦（従来どおり）。続きは glList2
nGl = 0
for tc = 1 to 2
	rest = glList
	if tc = 2 then rest = glList2
	while strlen(rest) > 0 and nGl < 61 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nGl = nGl + 1
			gl[nGl] = v / 1000
		endif
	endwhile
next tc

! ---- jackList をパース (mm→m) ----
! 敷地高低差: 支柱位置ごとの値。空なら平坦（従来どおり）。続きは jackList2
nJk = 0
for tc = 1 to 2
	rest = jackList
	if tc = 2 then rest = jackList2
	while strlen(rest) > 0 and nJk < 61 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nJk = nJk + 1
			jk[nJk] = v / 1000
		endif
	endwhile
next tc

! ---- shimList をパース (mm→m): 敷板で持ち上げた分（ジャッキ繰出しの内数） ----
nSh = 0
for tc = 1 to 2
	rest = shimList
	if tc = 2 then rest = shimList2
	while strlen(rest) > 0 and nSh < 61 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nSh = nSh + 1
			sh[nSh] = v / 1000
		endif
	endwhile
next tc

! ---- 外側の建地列の glListO・jackListO・shimListO（本足場で地盤を内外別に解いたとき。空なら内側の列と同じ） ----
! 外側の列は躯体から建地列の間隔だけ外に立つので、斜面では内側の列と地盤高が違う（利用者の指定 2026-10-21）
nGlO = 0
nJkO = 0
nShO = 0
for lo = 1 to 3
	for tc = 1 to 2
		if lo = 1 then
			rest = glListO
			if tc = 2 then rest = glListO2
		endif
		if lo = 2 then
			rest = jackListO
			if tc = 2 then rest = jackListO2
		endif
		if lo = 3 then
			rest = shimListO
			if tc = 2 then rest = shimListO2
		endif
		while strlen(rest) > 0 do
			pc = strstr(rest, ",")
			if pc > 0 then
				item = strsub(rest, 1, pc - 1)
				rest = strsub(rest, pc + 1, strlen(rest) - pc)
			else
				item = rest
				rest = ""
			endif
			k = split(item, "%n", v)
			if k > 0 then
				if lo = 1 and nGlO < 61 then
					nGlO = nGlO + 1
					glO[nGlO] = v / 1000
				endif
				if lo = 2 and nJkO < 61 then
					nJkO = nJkO + 1
					jkO[nJkO] = v / 1000
				endif
				if lo = 3 and nShO < 61 then
					nShO = nShO + 1
					shO[nShO] = v / 1000
				endif
			endif
		endwhile
	next tc
next lo
! 立面図は外側の列を見る。外側の列の値があればそれで描く
if viewMode = "elev" and nGlO >= 2 then
	for i = 1 to nGlO
		gl[i] = glO[i]
	next i
	nGl = nGlO
	for i = 1 to nJkO
		jk[i] = jkO[i]
	next i
	nJk = nJkO
	for i = 1 to nShO
		sh[i] = shO[i]
	next i
	nSh = nShO
endif

! ---- flList をパース (mm→m) ----
nFL = 0
rest = flList
while strlen(rest) > 0 and nFL < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nFL = nFL + 1
		fls[nFL] = v / 1000
	endif
endwhile

! ---- levelList をパース (mm→m) ----
! 作業床の高さはPython側の立面ソルバが決めた値をそのまま受け取る。
! GDLで komaPitch から再計算すると、コマの概念が無い枠組（komaPitch=0）で
! 破綻するうえ、ソルバの結果と図面がずれる。
nLevIn = 0
rest = levelList
while strlen(rest) > 0 and nLevIn < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nLevIn = nLevIn + 1
		levIn[nLevIn] = v / 1000
	endif
endwhile

! ---- hatchList をパース（ハッチ付布板の昇降口のスパン番号） ----
nHt = 0
rest = hatchList
while strlen(rest) > 0 and nHt < 16 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nHt = nHt + 1
		htI[nHt] = v
	endif
endwhile

! ---- brktList をパース「開始,終了,幅,向き,高さ」の繰り返し (mm→m) ----
! ブラケット区間は作業床の幅を局所的に変える。図面に出ないと、
! 実際より狭い（または広い）床を描いたままになる
nBk = 0
bkIdx = 0
bkA = 0
bkB = 0
bkC = 0
bkE0 = 0
bkF = 0
! 文字列パラメータは255文字で切れる（実機で確認）。長い面は Python 側が
! brktList2〜brktList4 に分けて渡すので、続けて同じ配列に読む
for tc = 1 to 4
	rest = brktList
	if tc = 2 then rest = brktList2
	if tc = 3 then rest = brktList3
	if tc = 4 then rest = brktList4
	while strlen(rest) > 0 and nBk < 24 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			bkIdx = bkIdx + 1
			md = bkIdx - 6 * int(bkIdx / 6)   ! 1,2,3,4,5,0 の繰り返し
			if md = 1 then bkA = v / 1000
			if md = 2 then bkB = v / 1000
			if md = 3 then bkC = v / 1000
			if md = 4 then bkE0 = v
			if md = 5 then bkF = v / 1000
			if md = 0 then
				nBk = nBk + 1
				bkS[nBk] = bkA
				bkE[nBk] = bkB
				bkW[nBk] = bkC
				bkD[nBk] = bkE0
				bkH[nBk] = bkF
				bkDW[nBk] = v / 1000        ! 区間の床幅（0で変更なし）
			endif
		endif
	endwhile
next tc

! ---- editList をパース「スパン始,スパン終,層始,層終,ビット」の繰り返し（範囲を指定して外した部材） ----
! ビット: 1踏板 2外側手すり 4幅木 8筋かい 16内側手すり。スパンは面の始点から1始まり、層は作業床の層（1＝最下段）。
! 数量表（Python の member_edits）と同じ升目を3D・図示本数から外す
nEd = 0
edIdx = 0
edT1 = 0
edT2 = 0
edT3 = 0
edT4 = 0
rest = editList
while strlen(rest) > 0 and nEd < 16 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		edIdx = edIdx + 1
		md = edIdx - 5 * int(edIdx / 5)   ! 1,2,3,4,0 の繰り返し
		if md = 1 then edT1 = v
		if md = 2 then edT2 = v
		if md = 3 then edT3 = v
		if md = 4 then edT4 = v
		if md = 0 then
			nEd = nEd + 1
			edA[nEd] = edT1
			edB[nEd] = edT2
			edC[nEd] = edT3
			edD[nEd] = edT4
			edE[nEd] = v
		endif
	endif
endwhile

! ---- bridgeList をパース「開始,長さ,増える離れ,種別(0=凹み/1=張り出し/2=斜辺 終点側深い/3=斜辺 始点側深い)」の繰り返し (mm→m) ----
! 最小スパン未満の凹み・張り出しは直線で渡す。実際の躯体線は離れが増えるので
! 平面に破線で示す（数量の要確認と同じ区間）
nBr = 0
brIdx = 0
brT1 = 0
brT2 = 0
brT3 = 0
rest = bridgeList
while strlen(rest) > 0 and nBr < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		brIdx = brIdx + 1
		md = brIdx - 4 * int(brIdx / 4)   ! 1,2,3,0 の繰り返し
		if md = 1 then brT1 = v / 1000
		if md = 2 then brT2 = v / 1000
		if md = 3 then brT3 = v / 1000
		if md = 0 then
			nBr = nBr + 1
			brS[nBr] = brT1
			brL[nBr] = brT2
			brD[nBr] = brT3
			brK[nBr] = v
		endif
	endif
endwhile

! ---- stageList をパース「開始,長さ,出,設置高さ,方杖」の繰り返し (mm→m) ----
! 方杖は0/1（数量拾いと同じ指定を使う。図だけ勝手に方杖を付けない）
! 荷受けステージは出1.5mの張り出し床。構造計算では直下の建地を個別に
! 検定しているのに、図面にも3Dにも出ていなかった
nSg = 0
sgIdx = 0
sgA = 0
sgB = 0
sgC = 0
sgD = 0
rest = stageList
while strlen(rest) > 0 and nSg < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		sgIdx = sgIdx + 1
		md = sgIdx - 5 * int(sgIdx / 5)   ! 1,2,3,4,0 の繰り返し
		if md = 1 then sgA = v / 1000
		if md = 2 then sgB = v / 1000
		if md = 3 then sgC = v / 1000
		if md = 4 then sgD = v / 1000
		if md = 0 then
			nSg = nSg + 1
			sgS[nSg] = sgA
			sgL[nSg] = sgB
			sgP[nSg] = sgC
			sgH[nSg] = sgD
			! 5つ目は 方杖 0/1 ＋ 侵入落下防止柵 2（mm換算しない。2 で割った余りが方杖、商が柵）
			sgZ[nSg] = v - 2 * int(v / 2)
			sgF[nSg] = int(v / 2)
		endif
	endif
endwhile

! ---- hoistList をパース「位置,到達高さ,搬器幅,搬器奥行,控えピッチ」の繰り返し (mm→m) ----
! 昇降機は数量（乗り込み口の開閉式手すり）と構造（マストの局所荷重）には
! 出ていたのに、図面には現れていなかった。マストは足場の外に立つ大物なので
! 平面・立面・3Dに出して干渉を確認できるようにする
nHo = 0
hoIdx = 0
hoT = 0
rest = hoistList
while strlen(rest) > 0 and nHo < 4 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		hoIdx = hoIdx + 1
		hoM = hoIdx - 5 * int((hoIdx - 1) / 5)     ! 1..5
		if hoM = 1 then
			hoT = v / 1000
		endif
		if hoM = 2 then
			nHo = nHo + 1
			hoP[nHo] = hoT
			hoR[nHo] = v / 1000
			hoW[nHo] = 2.0
			hoD[nHo] = 2.0
			hoTp[nHo] = 3.6
		endif
		if hoM = 3 and nHo > 0 then hoW[nHo] = v / 1000
		if hoM = 4 and nHo > 0 then hoD[nHo] = v / 1000
		if hoM = 5 and nHo > 0 and v > 0 then hoTp[nHo] = v / 1000
	endif
endwhile

! ---- intkList をパース「始め,終わり,層始め,層終わり」の繰り返し（取り入れ口。mm→m・層番号） ----
nIk = 0
ikIdx = 0
rest = intkList
while strlen(rest) > 0 and nIk < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		ikIdx = ikIdx + 1
		ikM = ikIdx - 4 * int((ikIdx - 1) / 4)
		if ikM = 1 then ikT1 = v / 1000
		if ikM = 2 then ikT2 = v / 1000
		if ikM = 3 then ikT3 = v
		if ikM = 4 then
			nIk = nIk + 1
			ikA[nIk] = ikT1
			ikB[nIk] = ikT2
			ikL1[nIk] = ikT3
			ikL2[nIk] = v
		endif
	endif
endwhile

! ---- landingList をパース「位置,作業床高さ」の繰り返し (mm→m) ----
nLa = 0
laIdx = 0
laT = 0
rest = landingList
while strlen(rest) > 0 and nLa < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		laIdx = laIdx + 1
		if laIdx - 2 * int(laIdx / 2) = 1 then
			laT = v / 1000
		else
			nLa = nLa + 1
			laP[nLa] = laT
			laH[nLa] = v / 1000
		endif
	endif
endwhile

! 昇降機の見付け幅（ケージ＋マストの目安）。実機は機種で違うので図示用
HOIST_W = 2.0
HOIST_D = 2.0

! ---- beamList をパース「開始,スパン,梁下高さ」の繰り返し (mm→m) ----
! 梁枠は支柱を抜いて通路にする箇所。図面が抜いた支柱を描いたままだと、
! 実際には無い建地を図面が示すことになる
nBm = 0
bmIdx = 0
bmT1 = 0
bmT2 = 0
rest = beamList
while strlen(rest) > 0 and nBm < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		bmIdx = bmIdx + 1
		md = bmIdx - 3 * int(bmIdx / 3)   ! 1,2,0 の繰り返し
		if md = 1 then
			bmT1 = v / 1000
		endif
		if md = 2 then
			bmT2 = v / 1000
		endif
		if md = 0 then
			nBm = nBm + 1
			bmS[nBm] = bmT1
			bmL[nBm] = bmT2
			bmH[nBm] = v / 1000
		endif
	endif
endwhile

! ---- advInList をパース「開始,終点,高さ」の繰り返し (mm→m) ----
! 梁枠の網掛け部（開口の両隣1スパンの全高と梁枠の上）は前踏み側にも先行手すり筋交い（ミレニューム Q16。利用者の資料 2026-10-24）
dim aiS[24], aiE[24], aiZ[24]
nAi = 0
aiIdx = 0
aiT1 = 0
aiT2 = 0
rest = advInList
while strlen(rest) > 0 and nAi < 24 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		aiIdx = aiIdx + 1
		md = aiIdx - 3 * int(aiIdx / 3)
		if md = 1 then aiT1 = v / 1000
		if md = 2 then aiT2 = v / 1000
		if md = 0 then
			nAi = nAi + 1
			aiS[nAi] = aiT1
			aiE[nAi] = aiT2
			aiZ[nAi] = v / 1000
		endif
	endif
endwhile

! ---- stairList をパース「開始,長さ」の繰り返し (mm→m) ----
! 階段室は数量（踏板の差引）にも帳票にも出るのに、図面に位置が
! 出ていなかった。昇降設備の位置は計画図の主要情報
nSt = 0
stTmp = 0
stIdx = 0
rest = stairList
while strlen(rest) > 0 and nSt < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		stIdx = stIdx + 1
		if stIdx - 2 * int(stIdx / 2) = 1 then
			stTmp = v / 1000
		else
			nSt = nSt + 1
			stS[nSt] = stTmp
			stL[nSt] = v / 1000
		endif
	endif
endwhile

! ---- asagaoList をパース (mm→m) ----
! 朝顔は数量にも法規チェックにも出るのに、図面にも3Dにも現れていなかった。
! 突出2mの部材なので、干渉確認のためにモデルへ出す
nAsa = 0
rest = asagaoList
while strlen(rest) > 0 and nAsa < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nAsa = nAsa + 1
		asa[nAsa] = v / 1000
	endif
endwhile

! ---- asaCutList をパース「開始,終了」の繰り返し (mm→m) ----
! 配列名に acS を使うと GDL 組込み関数 ACS()（逆余弦）と衝突して部品ごと壊れる
! （パラメータ設定が全部失敗する。半日の切り分けで判明）。cut〜 で統一
! 昇降機のマスト・搬器が通るスパンは朝顔を切り欠く。衝突検査が切り欠きを
! 指示するのに、図面と3Dは全長の板のままだった
nCut = 0
cutIdx = 0
cutT = 0
rest = asaCutList
while strlen(rest) > 0 and nCut < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		cutIdx = cutIdx + 1
		if cutIdx - 2 * int(cutIdx / 2) = 1 then
			cutT = v / 1000
		else
			nCut = nCut + 1
			cutS[nCut] = cutT
			cutE[nCut] = v / 1000
		endif
	endif
endwhile

! ---- 派生値 ----
lineLen = 0
for i = 1 to nSpan
	lineLen = lineLen + spans[i]
next i

! 朝顔の連続区間（切り欠きを除いた asgA〜asgB）。区間は Python 側で昇順・非重複
! 最初の切り欠きが 0 から始まる（長さ 0 の「0,0」も）ときは始点の隅のコーナー部を付けない（面の一部だけの朝顔・
! 前の面の朝顔が隅まで来ない）
asaCrnOff = 0
if nCut > 0 then
	if cutS[1] < 0.001 then asaCrnOff = 1
endif
nAsg = 0
cutX = 0
for ic = 1 to nCut
	if cutS[ic] > cutX + 0.001 then
		nAsg = nAsg + 1
		asgA[nAsg] = cutX
		asgB[nAsg] = cutS[ic]
	endif
	cutX = cutE[ic]
next ic
if lineLen > cutX + 0.001 then
	nAsg = nAsg + 1
	asgA[nAsg] = cutX
	asgB[nAsg] = lineLen
endif
postTop = jackOut
for i = 1 to nPost
	postTop = postTop + posts[i]
next i
! 根がらみ高さ。negaH が渡されていればそれを使う（枠組は建枠脚部が相当）
firstLedger = negaH
if firstLedger <= 0 then firstLedger = jackOut + komaPitch

! レベル列: lv[1]=根がらみ、lv[2..nLv]=作業床（下から昇順）
lv[1] = firstLedger
if nLevIn > 0 then
	! Python側の立面ソルバが決めた作業床高さをそのまま使う
	nLevels = nLevIn
	for il = 1 to nLevels
		lv[il + 1] = levIn[il]
	next il
	topFloor = levIn[nLevels]
else
	! 単体で置いた場合のフォールバック（くさび式の積み方から推定）
	topFloor = postTop - 2 * komaPitch
	nLevels = 0
	h = topFloor
	while h > firstLedger + komaPitch do
		nLevels = nLevels + 1
		h = h - floorH
	endwhile
	for il = 1 to nLevels
		lv[il + 1] = topFloor - (nLevels - il) * floorH
	next il
endif
nLv = nLevels + 1

! 手すり・中桟の高さ（作業床から）。komaPitch の倍数で決め打ちすると
! コマの概念が無い枠組で 0 になり、手すりが作業床に重なって消える
railTop = railH
if railTop <= 0 then railTop = 2 * komaPitch
railMid = midH
if railMid <= 0 then railMid = komaPitch

! ---- 区切った足場ライン（利用者の指定 2026-10-21「垂直と水平で区切れるように」） ----
! 1つの面を、スパン segSpanA〜segSpanB・作業層 segLevA〜segLevB の部品に分ける（0＝端まで）。
! 縦の区切りは支柱の芯、横の区切りは作業床の 100 下。3D はその箱の外を切り取り、平面・数量は範囲の中だけ。
! 範囲の持ち主: 位置 x は [gxA, gxB)（始点側の支柱は自分、終点側は隣の部品）、高さ z は [gzA, gzB)
sA = segSpanA
if sA < 1 or sA > nSpan then sA = 1
sB = segSpanB
if sB < sA or sB > nSpan then sB = nSpan
lA = segLevA
if lA < 1 or lA > nLevels then lA = 1
lB = segLevB
if lB < lA or lB > nLevels then lB = nLevels
pxA = 0
pxB = 0
for i = 1 to sB
	if i < sA then pxA = pxA + spans[i]
	pxB = pxB + spans[i]
next i
gxA = -1000
gxB = 1000
gzA = -1000
gzB = 1000
if sA > 1 then gxA = pxA
if sB < nSpan then gxB = pxB
if lA > 1 then gzA = lv[lA + 1] - 0.1
if lB < nLevels then gzB = lv[lB + 2] - 0.1
segOn = 0
if sA > 1 or sB < nSpan or lA > 1 or lB < nLevels then segOn = 1
! 下の端の部品（根がらみ・ジャッキ・平面の本体を持つ）
segBase = 0
if lA = 1 then segBase = 1

! 壁つなぎは位置と高さの対。短い方に合わせる
nTiePair = nTie
if nTieH < nTiePair then nTiePair = nTieH

! 斜材の設置間隔。数量は「6層6スパン以下毎に交さ2方向」で拾っているので、
! 図面を全構面に描くと部材表と食い違う（発注40本に対し図面896本）
bEvS = braceEveryS
if bEvS < 1 then bEvS = 1
bEvL = braceEveryL
if bEvL < 1 then bEvL = 1
! 斜材を入れる層 brOn[il]（層 il は lv[il]〜lv[il+1]）: bEvL 層ごと。根がらみ〜1段目の床のように低い層（1.0m 未満）には
! ブレスが掛からない（平べったい山形になっていた。利用者の指摘 2026-10-24: 前も言ったけど1段目に変なブレス）ので、その層の
! 分は1つ上の層に入れる（本数は同じ。数量の quantity と合わせる）
for il = 1 to nLv - 1
	brOn[il] = 0
next il
for il = 1 to nLv - 1
	if il - 1 - bEvL * int((il - 1) / bEvL) = 0 then
		if lv[il + 1] - lv[il] > 0.999 then
			brOn[il] = 1
		else
			if il + 1 <= nLv - 1 then brOn[il + 1] = 1
		endif
	endif
next il

! 建地列。一側足場は1列で、建地は外側1列だけ立ち、床は躯体側へ張り出す。
! 列数を見ないと、一側足場の計画でも図面は本足場（2列）で描かれる
rowStart = 0
if nRows < 2 then rowStart = 1

! ---- 敷板の列 sillList（続きは sillList2）「y,始め,終わり」の繰り返し (mm→m)。3D で規格の長さに割って並べる ----
nSv = 0
for tc = 1 to 2
	rest = sillList
	if tc = 2 then rest = sillList2
	while strlen(rest) > 0 and nSv < 36 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nSv = nSv + 1
			slV[nSv] = v / 1000
		endif
	endwhile
next tc

r_sic  = 0.0486 / 2	! 支柱 φ48.6
! 足場の種類ごとの支柱の径（日建ND は φ42.7、ストロング・信和は φ48.6）
if postDia > 0.01 then r_sic = postDia / 2
r_nuno = 0.0427 / 2	! 布材 φ42.7
! 単管の布・手すりを建地の脇に直交クランプで留めたときの芯々（管の半径2つ＋口の帯4.5と背板4を2つずつ）
tubeOff = r_sic + 0.0486 / 2 + 0.017
r_tie  = 0.0273 / 2	! 壁つなぎ φ27.2

! ---- 注記のレイアウト用（文字高は縮尺依存なので実寸を求めて行送りに使う）----
! GLOB_SCALE = 縮尺の分母（1/20なら20）。texSiz は用紙上のmm
txtH = texSiz * GLOB_SCALE / 1000
txtLine = txtH * 1.8

! ---- 図示本数（この面のオブジェクトが描いている本数）を書き戻す ----
! Archicad の一覧表（スケジュール）で面ごと・建物ごとに集計できる（bim-arekore の
! 次世代足場.gsm が部材本数をパラメータに持つのと同じ）。発注数量の正は Python の
! 数量表（ステージ・ブラケット区間・高低差の継ぎ足し・コーナー部材まで入る）で、
! ここは図面との照合用。支柱は 3D と同じく両端を含めて数え、隅で共有する内側建地（skipInS・skipInE）と
! セットバックの上段の端（skipPS・skipPE）は除く（利用者の指摘 2026-10-25: 支柱の本数の数え漏れも直して。各面の
! 外側の列の終点の支柱が抜けていた）。単管抱き足場は終点を次の面に任せる
! 区切った部品は自分の範囲（スパン sA〜sB・作業層 lA〜lB）だけを数える。支柱は下端が範囲の高さにある1本ずつ、
! 支柱の位置数・根がらみは下の端の部品（segBase）が持つ
qPos0 = (sB - sA + 1) * nRows
qIn = 0
if nRows >= 2 then qIn = 1
if sA = 1 then qPos0 = qPos0 + cornerS + cornerSP
if sA = 1 and hugMode = 0 then qPos0 = qPos0 - skipPS * nRows - skipInS * qIn
if sB >= nSpan and hugMode = 0 then qPos0 = qPos0 + nRows - skipPE * nRows - skipInE * qIn
qSeg = 0
zq = jackOut
for j = 1 to nPost
	if zq >= gzA - 0.001 and zq < gzB - 0.001 then qSeg = qSeg + 1
	zq = zq + posts[j]
next j
qPostPos = qPos0 * segBase
qPost = qPos0 * qSeg
nIn = lB - lA + 1
nOddIn = int((lB + 1) / 2) - int(lA / 2)
qOuter = 2
if railAdv = 1 then qOuter = 0
qInner = 0
if railIn = 1 and nRows >= 2 then qInner = 2
qNuno = 0
qDeck = 0
qToe = 0
qAdv = 0
x = 0
for ip = 1 to nSpan
	if ip >= sA and ip <= sB then
	! 開口部（梁枠より下）: その層の布材・床・幅木・先行手すりは無い
	qOpenLv = 0
	qOpenNega = 0
	for ib = 1 to nBm
		if x >= bmS[ib] - 0.001 and x + spans[ip] <= bmS[ib] + bmL[ib] + 0.001 then
			if lv[1] < bmH[ib] - 0.001 then qOpenNega = 1
			for il = lA + 1 to lB + 1
				if lv[il] < bmH[ib] - 0.001 then qOpenLv = qOpenLv + 1
			next il
		endif
	next ib
	! 階段室: 各層で階段が上がってくる1スパンだけ開口（奇数層は始点側、偶数層は終点側）。外側の幅木も付けない、手すりは残る
	qStairOpen = 0
	for it = 1 to nSt
		! 外付け（stOut）の階段は外の升目なので、本体の床は切らない
		if stOut = 0 and x >= stS[it] - 0.001 and x + spans[ip] <= stS[it] + stL[it] + 0.001 then
			qPos = 0
			xx = 0
			for jp = 1 to ip - 1
				if xx >= stS[it] - 0.001 then qPos = qPos + 1
				xx = xx + spans[jp]
			next jp
			if stL[it] <= spans[ip] + 0.001 then
				qStairOpen = nIn
			else
				if qPos = 0 then qStairOpen = nOddIn
				if qPos = 1 then qStairOpen = nIn - nOddIn
			endif
		endif
	next it
	! 作業床の高さにスパン方向の布材は付けない（アンチは腕木に掛ける）。根がらみ＋手すり・中桟だけ
	qNuno = qNuno + nRows * (1 - qOpenNega) * segBase + (nIn - qOpenLv) * (qOuter + qInner)
	qDeck = qDeck + max(0, nIn - qOpenLv - qStairOpen)
	! 階段が上がってくるスパンは外側の幅木も付けない（載せる布板が無い。3d.gdl・gdl_params.face_drawn_counts と同じ）
	if railAdv = 0 and toeOn = 1 then qToe = qToe + max(0, nIn - qOpenLv - qStairOpen * (serType <> "T"))
	if railAdv = 1 then qAdv = qAdv + nIn - qOpenLv
	! 範囲を指定して外した部材（editList）。開口部の升目はもともと無い。足場の中の階段室の区間の床は対象外
	if nEd > 0 then
		qInStair = 0
		for it = 1 to nSt
			if stOut = 0 and x >= stS[it] - 0.001 and x + spans[ip] <= stS[it] + stL[it] + 0.001 then qInStair = 1
		next it
		for il = lA + 1 to lB + 1
			qBlk = 0
			for ib = 1 to nBm
				if x >= bmS[ib] - 0.001 and x + spans[ip] <= bmS[ib] + bmL[ib] + 0.001 and \
						lv[il] < bmH[ib] - 0.001 then qBlk = 1
			next ib
			eoD = 0
			eoR = 0
			eoT = 0
			eoI = 0
			eoD1 = 0
			eoD2 = 0
			if deckW2 <= 0 then eoD2 = 1   ! 1枚敷きは外側の踏板だけで床が無くなる
			for ie = 1 to nEd
				if ip >= edA[ie] and ip <= edB[ie] and il - 1 >= edC[ie] and il - 1 <= edD[ie] then
					if bittest(edE[ie], 0) then eoD = 1
					if bittest(edE[ie], 5) then eoD1 = 1
					if bittest(edE[ie], 6) then eoD2 = 1
					if bittest(edE[ie], 1) then eoR = 1
					if bittest(edE[ie], 2) then eoT = 1
					if bittest(edE[ie], 4) then eoI = 1
				endif
			next ie
			if eoD1 = 1 and eoD2 = 1 then eoD = 1
			if qBlk = 0 then
				if eoD = 1 and qInStair = 0 then qDeck = qDeck - 1
				if eoT = 1 and railAdv = 0 and toeOn = 1 then qToe = qToe - 1
				if eoR = 1 and railAdv = 1 then qAdv = qAdv - 1
				if eoR = 1 and railAdv = 0 and serType <> "W" then qNuno = qNuno - 2
				if eoI = 1 then qNuno = qNuno - qInner
			endif
		next il
	endif
	endif   ! sA〜sB
	x = x + spans[ip]
next ip
! 斜材: 3D と同じ間隔（bEvL 層・bEvS スパンごと、1箇所2本）。下端の高さの部品が持つ
qBrace = 0
for il = 1 to nLv - 1
	if brOn[il] = 1 and lv[il] >= gzA - 0.001 and lv[il] < gzB - 0.001 then
		for ip = sA to sB
			if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 then
				! 開口の通路（梁枠より下）に掛かる筋かいは描かない（3D と同じ）。1本ずつ数える
				xq9 = 0
				for jq9 = 1 to ip - 1
					xq9 = xq9 + spans[jq9]
				next jq9
				for bf9 = 0 to 1
					qa9 = xq9
					qb9 = xq9 + spans[ip]
					if bf9 = 1 and serType <> "W" then
						if ip < nSpan then
							qa9 = xq9 + spans[ip]
							qb9 = qa9 + spans[ip + 1]
						else
							qb9 = xq9
							qa9 = xq9 - spans[max(1, ip - 1)]
						endif
					endif
					qs9 = 0
					for ib9 = 1 to nBm
						if lv[il] < bmH[ib9] - 0.001 and min(qb9, bmS[ib9] + bmL[ib9]) - max(qa9, bmS[ib9]) > 0.001 then qs9 = 1
					next ib9
					if qs9 = 0 then qBrace = qBrace + 1
				next bf9
			endif
		next ip
	endif
next il
! 壁つなぎ・階段も範囲の中だけ
qTie = 0
for it = 1 to nTiePair
	if ties[it] >= gxA - 0.001 and ties[it] < gxB - 0.001 and tieH[it] >= gzA - 0.001 and tieH[it] < gzB - 0.001 then qTie = qTie + 1
next it
qStair = 0
for it = 1 to nSt
	if stS[it] >= gxA - 0.001 and stS[it] < gxB - 0.001 then qStair = qStair + nIn
next it
! 支柱だけ分解した足場ライン（explodeMask）は、支柱（枠組は建枠）を分解した部材（ashiba_member）が1本ずつ持つ。
! 一覧表で二重に数えないよう 0 にする（布材・踏板・手すりなどは足場ラインのまま）
if explodeMask > 0 then
	qPostPos = 0
	qPost = 0
endif
parameters qtyPostPos = qPostPos, qtyPost = qPost, qtyNuno = qNuno, qtyDeck = qDeck, \
	qtyToe = qToe, qtyAdv = qAdv, qtyTie = qTie, qtyBrace = qBrace, qtyStair = qStair

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 足場ライン 2Dスクリプト（viewMode で平面／立面を切替）
!   plan: 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体面 y=+standoff
!   elev: X=面に沿った距離 / Y=GLからの高さ
! ============================================================
define style "anno" "ＭＳ Ｐゴシック", texSiz, 1, 0
! 中央揃え。スパン寸法や部位名は基準点が中心でないと位置がずれて見える
define style "annoC" "ＭＳ Ｐゴシック", texSiz, 5, 0
set style "anno"
! ペン（利用者の指定 2026-10-24: ペンカラーを選べるコマンド作って）: 区分ごとにパレットの「ペン」で選ぶ。0 は 1 と同じ
if penPost < 1 then penPost = 1
if penLine < 1 then penLine = 1
if penDeck < 1 then penDeck = 1
if penStair < 1 then penStair = 1
if penEquip < 1 then penEquip = 1
if penTie < 1 then penTie = 1
if penDim < 1 then penDim = 1
pen penLine
! 出隅の外側の升目の辺（前の面・次の面の幅の向き）。幅の違う本足場の組と出会う隅は長方形（2026-10-24）
cSW = cornerSW
if cSW < 0.001 then cSW = rowW
cEW = cornerEW
if cEW < 0.001 then cEW = rowW

! モデル表示オプション（ashiba_mvo）があればそちらが優先。無ければ部品の設定
! （planSimple / showDim）。図面の用途ごとに部品を1つずつ触らなくてよい
mvPlan = 0
mvNotes = 1
mvOk = LIBRARYGLOBAL(mvoName, "planMode", mvPlan)
! 1＝詳細（部品の設定に従う。パレットの「平面表示」で部品ごとに 詳細／精細／単線）、2＝単線、3＝精細（実寸）
! 精細（実寸）: 利用者の指定 2026-10-23「平面も詳細モード機能追加して」
if mvOk and mvPlan = 2 then
	planSimple = 1
	planReal = 0
endif
if mvOk and mvPlan = 3 then
	planSimple = 0
	planReal = 1
endif
if LIBRARYGLOBAL(mvoName, "planNotes", mvNotes) then showDim = mvNotes

! 寸法ツールの寸法が付く点（外側建地列の支柱位置）。平面では最初に出すので、ホットスポットの番号＝
! 始点からの支柱の番号（1〜nSpan+1）。Python が CreateAssociativeDimensions でこの番号を指す
if viewMode <> "elev" and sA = 1 and segBase = 1 then
	xh = 0
	for ip = 1 to nSpan + 1
		hotspot2 xh, -rowW
		if ip <= nSpan then xh = xh + spans[ip]
	next ip
	! nSpan+2・nSpan+3: 両端の出隅コーナーの外側の支柱（寸法を両端まで張る。出隅でなければ端の支柱と同じ点）
	! 隅に隙間（コーナーステップ）がある面は、隙間の先の隅から外側の角の支柱まで（gapS・gapE）
	hotspot2 -gapS - cSW * cornerS, -rowW
	hotspot2 xh + gapE + cEW * cornerE, -rowW
	! nSpan+4〜nSpan+7: 離れ寸法の点（両端のスパン中央の 内側建地列・躯体面）。利用者の指定 2026-10-23:
	! 躯体と足場の隙間も寸法ツールに
	! 位置は躯体に面した端のスパン中央（Python が soDimX1・soDimX2 で渡す。延長の端のスパンは躯体の外）
	sdx1 = spans[1] / 2
	sdx2 = xh - spans[nSpan] / 2
	if soDimX1 > 0.001 then sdx1 = soDimX1
	if soDimX2 > 0.001 then sdx2 = soDimX2
	hotspot2 sdx1, 0
	hotspot2 sdx1, standoff
	hotspot2 sdx2, 0
	hotspot2 sdx2, standoff
	! nSpan+8・nSpan+9: 隅の隙間の端（終点の隙間の先・始点の隙間の手前。隙間が無ければ端の支柱と同じ点）。
	! 利用者の指定 2026-10-24: 隙間部分も寸法入れて
	hotspot2 xh + gapE, -rowW
	hotspot2 -gapS, -rowW
endif

if viewMode = "elev" then
	gosub 200
else
	if segBase = 0 then
		gosub 970
	else
		if planSimple then
			gosub 950
		else
			gosub 100
		endif
	endif
endif
end

! ============================================================
940: ! ---- 平面 実寸: 布材（φ42.7）を建地列ごとに二重線、腕木を支柱ごとに二重線、コマ（緊結部）を支柱のまわりに ----
rNuno = 0.0427 / 2	! 名前は rl（1d の配列 rl[][]）と別に。GDL の変数名は大文字小文字を区別しない
! 一側足場は躯体側の建地列が無い
for rr = 0 to 1
	if rr = 1 or nRows >= 2 then
		yy = -rr * rowW
		line2 pxA, yy + rNuno, pxB, yy + rNuno
		line2 pxA, yy - rNuno, pxB, yy - rNuno
	endif
next rr
xq = 0
for iq = 1 to nSpan + 1
	if xq >= pxA - 0.001 and xq <= pxB + 0.001 then
		line2 xq - rNuno, -rNuno, xq - rNuno, -rowW + rNuno
		line2 xq + rNuno, -rNuno, xq + rNuno, -rowW + rNuno
		! コマ（緊結部の受け。8 方向の爪を受ける円盤）
		pen penPost
		if nRows >= 2 then circle2 xq, 0, r_sic + 0.025
		circle2 xq, -rowW, r_sic + 0.025
		pen penLine
	endif
	if iq <= nSpan then xq = xq + spans[iq]
next iq
! 幅木（外側、t=12）
if railAdv = 0 and hugMode = 0 and toeOn = 1 then
	line2 pxA, -rowW - rNuno - 0.005, pxB, -rowW - rNuno - 0.005
	line2 pxA, -rowW - rNuno - 0.017, pxB, -rowW - rNuno - 0.017
endif
return

945: ! ---- 平面 実寸: 1スパンの踏板（幅どおり。外側建地列から並べ、継ぎ目に爪の線） ----
pen penDeck
yq = -rowW + rNuno + 0.005
for kw = 1 to 2
	wq = deckW1
	if kw = 2 then wq = deckW2
	if wq > 0.001 then
		rect2 x + rNuno, yq, x + spans[ip] - rNuno, yq + wq
		! 滑り止めの縞（長手方向の細線）
		for kr = 1 to 3
			line2 x + rNuno + 0.05, yq + wq * kr / 4, x + spans[ip] - rNuno - 0.05, yq + wq * kr / 4
		next kr
		yq = yq + wq + 0.01
	endif
next kw
pen penLine
return

! ============================================================
950: ! ---- 平面 単線（割付検討用: 建地列・支柱位置・床の対角線・付帯設備の占有範囲） ----
! 区切った部品は自分のスパン（pxA〜pxB）だけ。付帯設備は始まりが範囲にある部品が描く
line2 pxA, 0, pxB, 0
line2 pxA, -rowW, pxB, -rowW
x = 0
for ip = 1 to nSpan
	inSeg = 0
	if ip >= sA and ip <= sB then inSeg = 1
	if inSeg then line2 x, 0, x, -rowW
	inStair = 0
	for it2 = 1 to nSt
		if stOut = 0 and x >= stS[it2] - 0.001 and x + spans[ip] <= stS[it2] + stL[it2] + 0.001 then inStair = 1
	next it2
	for ib3 = 1 to nBm
		if x >= bmS[ib3] - 0.001 and x + spans[ip] <= bmS[ib3] + bmL[ib3] + 0.001 then inStair = 1
	next ib3
	if inStair = 0 and inSeg then line2 x, 0, x + spans[ip], -rowW
	x = x + spans[ip]
next ip
line2 pxB, 0, pxB, -rowW
! 階段室: 区間の中心線と矢印（始点側から上る）
yc = -rowW / 2 - stOut * rowW
for it2 = 1 to nSt
	if stS[it2] >= gxA - 0.001 and stS[it2] < gxB - 0.001 then
	if stOut = 1 then
		! 外付け: 外側建地列の外の升目（上り口＋階段＋降り口）
		line2 stS[it2], -rowW, stS[it2], -2 * rowW
		line2 stS[it2], -2 * rowW, stS[it2] + stL[it2], -2 * rowW
		line2 stS[it2] + stL[it2], -2 * rowW, stS[it2] + stL[it2], -rowW
	endif
	line2 stS[it2], yc, stS[it2] + stL[it2], yc
	line2 stS[it2] + stL[it2], yc, stS[it2] + stL[it2] - 0.15, yc - 0.10
	line2 stS[it2] + stL[it2], yc, stS[it2] + stL[it2] - 0.15, yc + 0.10
	endif
next it2
! 付帯設備の占有範囲は破線（ステージ・張出しブラケット・昇降機）
line_type 3
for ig = 1 to nSg
	if sgS[ig] >= gxA - 0.001 and sgS[ig] < gxB - 0.001 then rect2 sgS[ig], -rowW, sgS[ig] + sgL[ig], -rowW - sgP[ig]
next ig
for ik = 1 to nBk
	if bkS[ik] < gxA - 0.001 or bkS[ik] >= gxB - 0.001 then
		! 隣の部品が描く
	else
	if bkD[ik] > 0 then
		rect2 bkS[ik], 0, bkE[ik], bkW[ik]
	else
		rect2 bkS[ik], -rowW, bkE[ik], -rowW - bkW[ik]
	endif
	endif
next ik
for ih = 1 to nHo
	hx = hoP[ih]
	if hx >= gxA - 0.001 and hx < gxB - 0.001 then rect2 hx - hoW[ih] / 2, -rowW - 0.10, hx + hoW[ih] / 2, -rowW - 0.10 - hoD[ih]
next ih
line_type 1
hotspot2 pxA, 0
hotspot2 pxB, 0
return

! ============================================================
970: ! ---- 区切った上の部品（平面）: 下の部品と重なるので、範囲を破線で囲み、層を書く ----
line_type 3
rect2 pxA + 0.05, -rowW + 0.05, pxB - 0.05, -0.05
line_type 1
if showDim then
	set style "annoC"
	tdx = (pxA + pxB) / 2
	tdy = -rowW / 2
	tdt = "上部 " + str(lA, 1, 0) + "〜" + str(lB, 1, 0) + "層"
	gosub 985
	set style "anno"
endif
hotspot2 pxA, 0
hotspot2 pxB, 0
hotspot2 pxA, -rowW
hotspot2 pxB, -rowW
return

! ============================================================
960:	! ---- 壁つなぎの記号（平面）: 逆三角 ▽、頂点が躯体側（+y）。塗りつぶす（利用者の指定 2026-10-24: 壁繋ぎの逆三角を
	! 塗りつぶして）。塗りは壁つなぎのペン、塗りつぶし「100 %」が無いプロジェクトは輪郭だけ ----
tx3 = ties[it]
ty3 = standoff / 2
fiTie = IND(FILL, "100 %")
if fiTie > 0 then
	fill fiTie
	poly2_b 4, 7, penTie, 0,
		tx3 - 0.11, ty3 - 0.09, 1,
		tx3 + 0.11, ty3 - 0.09, 1,
		tx3, ty3 + 0.11, 1,
		tx3 - 0.11, ty3 - 0.09, -1
else
	line2 tx3 - 0.11, ty3 - 0.09, tx3 + 0.11, ty3 - 0.09
	line2 tx3 + 0.11, ty3 - 0.09, tx3, ty3 + 0.11
	line2 tx3, ty3 + 0.11, tx3 - 0.11, ty3 - 0.09
endif
return

! ============================================================
100: ! ---- 平面図 ----
! 区切った部品は自分のスパン（pxA〜pxB）だけ描く。付帯設備・壁つなぎは始まりが範囲 [gxA, gxB) にある部品が描く
if planReal then
	gosub 940
else
line2 pxA, 0, pxB, 0
line2 pxA, -rowW, pxB, -rowW
endif

! スパン区切り線と布板の対角線。平面図で「作業床が敷いてある区画」を表す
! 慣用表記で、実務の足場平面図はこの見え方になる。対角線の向きは全スパン
! 揃える（向きを交互にするとブレスの表記と紛らわしい）。
x = 0
for ip = 1 to nSpan
	inSeg = 0
	if ip >= sA and ip <= sB then inSeg = 1
	if inSeg and planReal = 0 then line2 x, 0, x, -rowW
	! 階段室は最上層で階段が上がってくる1スパンだけ床が無い（奇数層は始点側、偶数層は終点側。
	! 3D・数量と同じ）。平面は最上層を上から見た状態なので、もう一方のスパンには対角線を引く
	inStair = 0
	kOdd = nLevels - 2 * int(nLevels / 2)
	for it2 = 1 to nSt
		if stOut = 0 and x >= stS[it2] - 0.001 and x + spans[ip] <= stS[it2] + stL[it2] + 0.001 then
			if stL[it2] <= spans[ip] + 0.001 then
				inStair = 1
			else
				if abs(x - stS[it2]) < 0.001 then
					if kOdd = 1 then inStair = 1
				else
					if ip > 1 then
						if kOdd = 0 and abs(x - spans[ip - 1] - stS[it2]) < 0.001 then inStair = 1
					endif
				endif
			endif
		endif
	next it2
	! 開口部（梁枠の区間）も同じ。この平面は支柱を抜いた状態を描いているので、
	! 床だけ上層の状態を描くと1枚の図の中で辻褄が合わなくなる
	for ib3 = 1 to nBm
		if x >= bmS[ib3] - 0.001 and x + spans[ip] <= bmS[ib3] + bmL[ib3] + 0.001 then inStair = 1
	next ib3
	if showDeck and hugMode = 0 and inStair = 0 and inSeg then
		if planReal then
			gosub 945
		else
			pen penDeck
			line2 x, -rowW, x + spans[ip], 0
			pen penLine
		endif
	endif
	x = x + spans[ip]
next ip
line2 pxB, 0, pxB, -rowW

pen penPost
x = 0
for ip = 1 to nSpan + 1
	! 梁枠の内側の支柱は抜いてある。描くと実際には無い建地を示すことになる
	removed = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then removed = 1
	next ib
	if x < pxA - 0.001 or x > pxB + 0.001 then removed = 1
	if removed = 0 then
		! 一側足場は建地1列。躯体側の建地は無い（受けブラケットの腕は
		! スパン区切り線と重なるので平面には現れない。3Dには出している）
		if nRows >= 2 then circle2 x, 0, r_sic
		circle2 x, -rowW, r_sic
		! 異形断面の支柱（NDストロング）は十字を添える
		if postShape = 1 then
			for rr2 = rowStart to 1
				line2 x - 0.0275, -rr2 * rowW, x + 0.0275, -rr2 * rowW
				line2 x, -rr2 * rowW - 0.0275, x, -rr2 * rowW + 0.0275
			next rr2
		endif
	endif
	if x >= pxA - 0.001 and x <= pxB + 0.001 then hotspot2 x, 0
	if ip <= nSpan then x = x + spans[ip]
next ip

pen penEquip
! 梁枠の区間（平面では内外の建地列から足場の帯の中へすぼまる台形と文字）。利用者の指定 2026-10-24（線で描いた形を整えて）:
! 両端の建地から斜めに入り、建地列と平行に通して、もう一方の端の建地へ斜めに戻る。深さは建地列の間隔の 0.38 倍（内外とも）、
! 斜めの横幅は立面の梁枠の端の区画（1スパンの 1/4）と同じで左右対称。区切った部品は範囲の中だけ（途中で切れる側は斜めを描かない）
for ib = 1 to nBm
	bs = max(bmS[ib], pxA)
	be = min(bmS[ib] + bmL[ib], pxB)
	if be > bs + 0.001 then
	bDp = rowW * 0.38
	bCh = 1.829 / 4
	if bCh > (be - bs) / 3 then bCh = (be - bs) / 3
	for rr = rowStart to 1
		yR = -rr * rowW
		sgY = 1 - 2 * rr                 ! 内側の列（0）は外へ（-Y）、外側の列（-rowW）は内へ（+Y）
		yIn = yR - sgY * bDp
		cL = bCh
		cR = bCh
		if bs > bmS[ib] + 0.001 then cL = 0
		if be < bmS[ib] + bmL[ib] - 0.001 then cR = 0
		if cL > 0 then line2 bs, yR, bs + cL, yIn
		line2 bs + cL, yIn, be - cR, yIn
		if cR > 0 then line2 be - cR, yIn, be, yR
	next rr
	set style "annoC"
	if showDim then
		tdx = (bs + be) / 2
		tdy = -rowW - 0.20
		tdt = "梁枠 " + str(bmL[ib] * 1000, 5, 0)
		gosub 985
	endif
	set style "anno"
	endif
next ib
pen penLine
hotspot2 pxA, -rowW
hotspot2 pxB, -rowW
! スパン境界の編集ホットスポット（外側建地列の支柱位置。引くとパラメータスクリプトが
! 規格寸法に吸着して書き戻す）。固定のホットスポットを同じ位置に重ねると、そちらを
! 掴んでオブジェクト全体が動くので、外側列の支柱位置は編集用だけにする
if editSpan and segOn = 0 and vardim1(xEdit) = nSpan + 1 then
	for i = 2 to nSpan
		hotspot2 0, -rowW, 500 + 3 * i, xEdit[i], 1 + 128
		hotspot2 xEdit[i], -rowW, 501 + 3 * i, xEdit[i], 2
		hotspot2 -1, -rowW, 502 + 3 * i, xEdit[i], 3
	next i
endif
! 荷受けステージの開始位置（張り出し床の中央の高さ。同じステージの別の層は同じ位置なので最初の組だけ）
if editSpan and segOn = 0 and nSg > 0 and vardim1(sgEdit) = nSg then
	for ig = 1 to nSg
		dupSg = 0
		for jg = 1 to ig - 1
			if abs(sgS[jg] - sgS[ig]) < 0.001 then dupSg = 1
		next jg
		if dupSg = 0 then
			hotspot2 0, -rowW - sgP[ig] / 2, 800 + 3 * ig, sgEdit[ig], 1 + 128
			hotspot2 sgEdit[ig], -rowW - sgP[ig] / 2, 801 + 3 * ig, sgEdit[ig], 2
			hotspot2 -1, -rowW - sgP[ig] / 2, 802 + 3 * ig, sgEdit[ig], 3
		endif
	next ig
endif
! 昇降機の位置（搬器の中央）
if editSpan and segOn = 0 and nHo > 0 and vardim1(hoEdit) = nHo then
	for ih = 1 to nHo
		hotspot2 0, -rowW - 0.10 - hoD[ih] / 2, 900 + 3 * ih, hoEdit[ih], 1 + 128
		hotspot2 hoEdit[ih], -rowW - 0.10 - hoD[ih] / 2, 901 + 3 * ih, hoEdit[ih], 2
		hotspot2 -1, -rowW - 0.10 - hoD[ih] / 2, 902 + 3 * ih, hoEdit[ih], 3
	next ih
endif
! 階段室の開始位置（建地列の中央。引くとパラメータスクリプトがスパン境界へ吸着して stairList を書き戻す）
if editSpan and segOn = 0 and nSt > 0 and vardim1(stEdit) = nSt then
	for it = 1 to nSt
		hotspot2 0, -rowW / 2, 700 + 3 * it, stEdit[it], 1 + 128
		hotspot2 stEdit[it], -rowW / 2, 701 + 3 * it, stEdit[it], 2
		hotspot2 -1, -rowW / 2, 702 + 3 * it, stEdit[it], 3
	next it
endif

! 始点の出隅コーナー（外側の升目。3Dと同じ規則でこの面が描く）
if cornerS = 1 and sA = 1 then
	line2 -cSW, 0, -cSW, -rowW
	line2 -cSW, -rowW, 0, -rowW
	! 前の面が隅の隙間の手前で止まる出隅: 升目の前の面の側の建地と布材（3D と同じ）
	if cornerSP = 1 then line2 -cSW, 0, 0, 0
	pen penPost
	circle2 -cSW, -rowW, r_sic
	if cornerSP = 1 then circle2 -cSW, 0, r_sic
	pen penDeck
	if showDeck and hugMode = 0 then
		if planReal then
			! 精細: 出隅の升目の踏板も幅どおり（長さ＝前の面の建地列の間隔）
			yq = -rowW + rNuno + 0.005
			for kw = 1 to 2
				wq = deckW1
				if kw = 2 then wq = deckW2
				if wq > 0.001 then
					rect2 -cSW + rNuno, yq, -rNuno, yq + wq
					yq = yq + wq + 0.01
				endif
			next kw
		else
			line2 -cSW, -rowW, 0, 0
		endif
	endif
endif

pen penDeck
! ハッチ付布板（梯子内蔵）の昇降口: 外側の板の位置に蓋（600×450）と梯子の踏ざん
for ih = 1 to nHt
	kq = htI[ih]
	if kq >= 1 and kq <= nSpan then
		hx0 = 0
		for iq = 1 to kq - 1
			hx0 = hx0 + spans[iq]
		next iq
		if hx0 >= gxA - 0.001 and hx0 < gxB - 0.001 then
			hxm = hx0 + spans[kq] / 2
			hym = -rowW + 0.05 + deckW1 / 2
			rect2 hxm - 0.30, hym - 0.225, hxm + 0.30, hym + 0.225
			line2 hxm - 0.25, hym - 0.17, hxm - 0.25, hym + 0.17
			line2 hxm - 0.15, hym - 0.17, hxm - 0.15, hym + 0.17
			for rg = 0 to 3
				line2 hxm - 0.25, hym - 0.15 + rg * 0.10, hxm - 0.15, hym - 0.15 + rg * 0.10
			next rg
			! 名前（昇降口 ハッチ付布板 NDN6TA）は平面図のラベル（Python が置く）が引出線で書く。記号に文字を重ねない
		endif
	endif
next ih

pen penStair
! 階段室（平面では区間を囲ってタスキと文字で示す）
for it2 = 1 to nSt
	if stS[it2] >= gxA - 0.001 and stS[it2] < gxB - 0.001 then
	sx = stS[it2]
	ex = sx + stL[it2]
	! 外付けは外側建地列の外の升目に描き、3列目の建地を足す。階段のタスキは中の階段のスパンだけ
	! （両端は上り口・降り口の床）
	y0 = -stOut * rowW
	y1 = y0 - rowW
	fx0 = sx
	fx1 = ex
	if stOut = 1 then
		xq = 0
		for iq = 1 to nSpan
			if abs(xq - sx) < 0.001 then fx0 = sx + spans[iq]
			if abs(xq + spans[iq] - ex) < 0.001 then fx1 = ex - spans[iq]
			xq = xq + spans[iq]
		next iq
		if fx1 - fx0 < 0.5 then
			fx0 = sx
			fx1 = ex
		endif
		line2 sx, y0, sx, y1
		line2 ex, y0, ex, y1
		line2 sx, y1, ex, y1
		xq = 0
		for iq = 1 to nSpan + 1
			if xq >= sx - 0.001 and xq <= ex + 0.001 then circle2 xq, y1, r_sic
			if iq <= nSpan then xq = xq + spans[iq]
		next iq
	endif
	! 階段を外側の板の位置に寄せる床（stHalf）は、外側の板の幅だけタスキ（内側はハーフアンチの床）
	if stHalf = 1 and stOut = 0 then
		y0 = -rowW + 0.05 + deckW1 - 0.01
		y1 = -rowW + 0.05
		line2 fx0, y0, fx1, y0
	endif
	line2 fx0, y0, fx0, y1
	line2 fx1, y0, fx1, y1
	! 階段の平面表示（利用者の指定 2026-10-23: 画面のような感じに）: タスキをやめ、階段枠（幅 450）の外形と
	! 踏面の線（約 250 ピッチ）、上る向きの矢印。スパンの継ぎ目（支柱）ごとに階段枠を分ける
	stWd = 0.45
	if stWd > abs(y1 - y0) - 0.06 then stWd = abs(y1 - y0) - 0.06
	yc2 = (y0 + y1) / 2
	ya = yc2 + stWd / 2
	yb = yc2 - stWd / 2
	xq = 0
	for iq = 1 to nSpan
		qa = xq
		qb = xq + spans[iq]
		if qa >= fx0 - 0.001 and qb <= fx1 + 0.001 then
			rect2 qa + 0.05, yb, qb - 0.05, ya
			nT = int((qb - qa - 0.10) / 0.25)
			if nT < 1 then nT = 1
			pT = (qb - qa - 0.10) / nT
			for itr = 1 to nT - 1
				line2 qa + 0.05 + itr * pT, yb, qa + 0.05 + itr * pT, ya
			next itr
		endif
		xq = qb
	next iq
	! 上る向き（始点→終点）の矢印
	line2 fx0 + 0.15, yc2, fx1 - 0.15, yc2
	line2 fx1 - 0.15, yc2, fx1 - 0.35, yc2 + 0.10
	line2 fx1 - 0.15, yc2, fx1 - 0.35, yc2 - 0.10
	circle2 fx0 + 0.15, yc2, 0.04
	! 名前（昇降階段・品番）は平面図のラベル（Python が置く GDL ラベル）が引出線で書く。踏面の線に文字を重ねない
	endif
next it2

pen penLine
! 範囲を指定して外した部材（editList）: 区間を破線で囲み、層と部材を書く（平面は1枚なので層は文字で示す）
for ie = 1 to nEd
	exs = 0
	exe = 0
	xq = 0
	for iq = 1 to nSpan
		if iq = edA[ie] then exs = xq
		xq = xq + spans[iq]
		if iq = edB[ie] then exe = xq
	next iq
	if exe > exs and exs >= gxA - 0.001 and exs < gxB - 0.001 then
		line_type 3
		rect2 exs + 0.03, -rowW + 0.03, exe - 0.03, -0.03
		line_type 1
		if showDim then
			edTxt = ""
			if bittest(edE[ie], 0) then edTxt = edTxt + "床"
			if bittest(edE[ie], 1) then edTxt = edTxt + "手"
			if bittest(edE[ie], 2) then edTxt = edTxt + "幅"
			if bittest(edE[ie], 3) then edTxt = edTxt + "筋"
			if bittest(edE[ie], 4) then edTxt = edTxt + "内"
			if bittest(edE[ie], 5) then edTxt = edTxt + "外床"
			if bittest(edE[ie], 6) then edTxt = edTxt + "内床"
			set style "annoC"
			tdx = (exs + exe) / 2
			tdy = -rowW / 2
			tdt = "外す " + edTxt + " " + str(edC[ie], 1, 0) + "-" + str(edD[ie], 1, 0) + "層"
			gosub 985
			set style "anno"
		endif
	endif
next ie

pen penEquip
! ブラケット区間（平面では拡幅ぶんの帯。層が複数でも平面では1本）
for ik = 1 to nBk
	drawn = 0
	for ij = 1 to ik - 1
		if bkS[ij] = bkS[ik] and bkE[ij] = bkE[ik] and bkD[ij] = bkD[ik] then drawn = 1
	next ij
	if bkS[ik] < gxA - 0.001 or bkS[ik] >= gxB - 0.001 then drawn = 1
	if drawn = 0 then
		if bkD[ik] > 0 then
			by1 = 0
			by2 = bkW[ik]
		else
			by1 = -rowW
			by2 = -rowW - bkW[ik]
		endif
		line2 bkS[ik], by2, bkE[ik], by2
		line2 bkS[ik], by1, bkS[ik], by2
		line2 bkE[ik], by1, bkE[ik], by2
		if showDim then
			bkTxt = "BR" + str(bkW[ik] * 1000, 4, 0)
			if bkDW[ik] > 0 then bkTxt = bkTxt + " 床" + str(bkDW[ik] * 1000, 4, 0)
			set style "annoC"
			tdx = (bkS[ik] + bkE[ik]) / 2
			tdy = by2 + (by2 - by1) * 0.25
			tdt = bkTxt
			gosub 985
			set style "anno"
		endif
	endif
next ik

! 荷受けステージ（平面では外側への張り出し外形）
for ig = 1 to nSg
	gs = sgS[ig]
	ge = gs + sgL[ig]
	gy = -rowW - sgP[ig]
	if gs >= gxA - 0.001 and gs < gxB - 0.001 then
	line2 gs, -rowW, gs, gy
	line2 ge, -rowW, ge, gy
	line2 gs, gy, ge, gy
	line2 gs, -rowW, ge, gy
	line2 gs, gy, ge, -rowW
	if sgF[ig] = 1 then
		! 侵入落下防止柵: 先端・妻側の落下防止柵は線と内向きの短い目盛り（柵の記号）、足場側の開閉式の侵入防止柵は
		! スパンごとの扉（開く向きの円弧。足場の床の側へ開く）。3D と同じ位置
		line2 gs + 0.04, gy + 0.04, ge - 0.04, gy + 0.04
		line2 gs + 0.04, gy + 0.04, gs + 0.04, -rowW
		line2 ge - 0.04, gy + 0.04, ge - 0.04, -rowW
		nTk = int((ge - gs - 0.08) / 0.3)
		for itk = 0 to nTk
			line2 gs + 0.04 + itk * 0.3, gy + 0.04, gs + 0.04 + itk * 0.3, gy + 0.10
		next itk
		nTk = int((sgP[ig] - 0.04) / 0.3)
		for itk = 0 to nTk
			line2 gs + 0.04, gy + 0.04 + itk * 0.3, gs + 0.10, gy + 0.04 + itk * 0.3
			line2 ge - 0.04, gy + 0.04 + itk * 0.3, ge - 0.10, gy + 0.04 + itk * 0.3
		next itk
		xq = 0
		for ipq = 1 to nSpan
			if xq >= gs - 0.001 and xq + spans[ipq] <= ge + 0.001 then
				! 扉（1枚の幅は建地列の間隔−0.12 以下。足場の床の中へ開く）: 閉じた線と、吊り元から開いた扉・軌跡の円弧
				nLf = int((spans[ipq] - 0.10) / (rowW - 0.12) - 0.001) + 1
				fWq = (spans[ipq] - 0.10) / nLf
				line2 xq + 0.05, -rowW + 0.06, xq + spans[ipq] - 0.05, -rowW + 0.06
				for ilf = 0 to nLf - 1
					xa = xq + 0.05 + ilf * fWq
					line2 xa, -rowW + 0.06, xa, -rowW + 0.06 + fWq
					arc2 xa, -rowW + 0.06, fWq, 0, 90
				next ilf
			endif
			xq = xq + spans[ipq]
		next ipq
	endif
	set style "annoC"
	if showDim then
		tdx = (gs + ge) / 2
		tdy = gy - 0.15
		tdt = "荷受けステージ 出" + str(sgP[ig] * 1000, 4, 0)
		if sgF[ig] = 1 then tdt = tdt + "・侵入落下防止柵 H1800"
		gosub 985
	endif
	set style "anno"
	endif
next ig

! 昇降機（平面では搬器の占有範囲を破線で、その外側のマストを実線の0.30角で。
! 足場の外に立つ大物なので干渉と搬入経路の検討に要る。詳細図と同じく
! 外側建地から隙間0.10mを空ける）
for ih = 1 to nHo
	hx = hoP[ih]
	if hx >= gxA - 0.001 and hx < gxB - 0.001 then
	line_type 3
	rect2 hx - hoW[ih] / 2, -rowW - 0.10, hx + hoW[ih] / 2, -rowW - 0.10 - hoD[ih]
	line_type 1
	rect2 hx - 0.15, -rowW - 0.10 - hoD[ih], hx + 0.15, -rowW - 0.40 - hoD[ih]
	set style "annoC"
	if showDim then
		tdx = hx
		tdy = -rowW - hoD[ih] - 0.55
		tdt = "昇降機"
		gosub 985
	endif
	set style "anno"
	endif
next ih
line_type 1

! 取り入れ口: 外側建地列の外に範囲の破線と「取り入れ口（3〜5層）」（3D の可動手すりと同じ範囲）
for ik = 1 to nIk
	qA = max(ikA[ik], pxA)
	qB = min(ikB[ik], pxB)
	if qB > qA + 0.001 then
		pen penEquip
		! 範囲は実線（線種3 は縮尺で点にしか見えない。実機 2026-10-24）
		rect2 qA, -rowW - 0.05, qB, -rowW - 0.35
		line2 qA, -rowW - 0.35, qB, -rowW - 0.05
		line2 qA, -rowW - 0.05, qB, -rowW - 0.35
		set style "annoC"
		if showDim then
			tdx = (qA + qB) / 2
			tdy = -rowW - 0.55
			tdt = "取り入れ口（" + str(ikL1[ik], 1, 0) + "〜" + str(ikL2[ik], 1, 0) + "層・可動手すり）"
			gosub 985
		endif
		set style "anno"
		pen penLine
	endif
next ik

! 跳ね出しブラケット（張り出した上の階の上段。3D と同じ支柱の位置ごと、躯体の面から外側の建地列の外まで。二重線
! で水平材の幅を見せる。線種3 は縮尺で点にしか見えない。実機 2026-10-24）
if haneD > 0.001 then
	pen penEquip
	xh7 = 0
	for ih7 = 1 to nSpan + 1
		if xh7 >= gxA - 0.001 and xh7 < gxB - 0.001 then
			line2 xh7 - 0.03, standoff, xh7 - 0.03, -rowW - 0.10
			line2 xh7 + 0.03, standoff, xh7 + 0.03, -rowW - 0.10
		endif
		if ih7 <= nSpan then xh7 = xh7 + spans[ih7]
	next ih7
	set style "annoC"
	if showDim and sA = 1 then
		tdx = (pxA + pxB) / 2
		tdy = standoff / 2 + 0.25
		tdt = "跳ね出しブラケットの上に建てる（床スラブの縁から）"
		gosub 985
	endif
	set style "anno"
	pen penLine
endif

! 枠組の終点の出隅: 建枠どうしの隙間を繋ぐ単管（内外の建地列。3D と同じ。利用者の指定 2026-10-24）
if frGapE > 0.001 and serType = "W" and pxB > lineLen - 0.001 then
	pen penLine
	for fgR = 0 to 1
		line2 lineLen - 0.10, -fgR * rowW - 0.045, lineLen + frGapE + 0.10, -fgR * rowW - 0.045
	next fgR
	set style "annoC"
	if showDim then
		tdx = lineLen + frGapE / 2
		tdy = -rowW - 0.35
		tdt = "単管連結 隙間" + str(frGapE * 1000, 3, 0)
		gosub 985
	endif
	set style "anno"
endif

! 朝顔の突出範囲（平面では外側への張り出し外形を破線で示す）
! 昇降機が通る区間（asaCutList）は切り欠いて描く
if nAsa > 0 then
	! 輪郭は実線の二重線（利用者の指摘 2026-10-24: 朝顔の平面図の輪郭が見にくい。線種3 は縮尺で点にしか見えなかった）
	line_type 1
	! 外付けの階段室の区間は階段室の外側（3列目）から張り出す（3D と同じ）。出隅はコーナー部で隅まで
	for isg = 1 to nAsg
		pA = asgA[isg]
		while pA < asgB[isg] - 0.001 do
			ybA = -rowW
			pB = asgB[isg]
			if stOut = 1 then
				for it8 = 1 to nSt
					if pA > stS[it8] - 0.001 and pA < stS[it8] + stL[it8] - 0.001 then
						ybA = -2 * rowW
						pB = min(pB, stS[it8] + stL[it8])
					endif
				next it8
				if ybA > -1.5 * rowW then
					for it8 = 1 to nSt
						if stS[it8] > pA + 0.001 then pB = min(pB, stS[it8])
					next it8
				endif
			endif
			if pB <= pA + 0.001 then pB = asgB[isg]
			qA = max(pA, pxA)
			qB = min(pB, pxB)
			if qB > qA + 0.001 then
				line2 qA, ybA - asagaoProj, qB, ybA - asagaoProj
				line2 qA, ybA - asagaoProj + 0.04, qB, ybA - asagaoProj + 0.04
				line2 qA, ybA, qA, ybA - asagaoProj
				line2 qB, ybA, qB, ybA - asagaoProj
				line2 qA + 0.04, ybA, qA + 0.04, ybA - asagaoProj + 0.04
				line2 qB - 0.04, ybA, qB - 0.04, ybA - asagaoProj + 0.04
				! 張り出しの中は 45° の斜線（実線・0.8m ごと。輪郭より目立たないよう間を広く）。朝顔の付く範囲が平面でひと目で分かるように
				! （利用者の指定 2026-10-24: 朝顔の平面図に表記して）。塗りつぶしの名前に頼らず線で引く
				line_type 1
				ahT = qA + 0.8
				while ahT < qB + asagaoProj - 0.001 do
					ahX0 = ahT
					ahY0 = ybA
					if ahX0 > qB then
						ahY0 = ybA - (ahX0 - qB)
						ahX0 = qB
					endif
					ahX1 = ahT - asagaoProj
					ahY1 = ybA - asagaoProj
					if ahX1 < qA then
						ahY1 = ybA - (ahT - qA)
						ahX1 = qA
					endif
					if ahX0 > ahX1 + 0.001 and ahY0 > ahY1 + 0.001 then line2 ahX0, ahY0, ahX1, ahY1
					ahT = ahT + 0.8
				endwhile
			endif
			pA = pB
		endwhile
		! 範囲ごとの文字（張り出しの外側。この部品に見える長さが 1.2m 以上の範囲だけ）: 朝顔 突出・角度・段数と高さ
		qA = max(asgA[isg], pxA)
		qB = min(asgB[isg], pxB)
		if showDim and qB > qA + 1.2 then
			set style "annoC"
			tdx = (qA + qB) / 2
			tdy = -rowW - asagaoProj - 0.15
			tdt = "朝顔 突出" + str(asagaoProj * 1000, 4, 0) + " " + str(asagaoAngle, 1, 0) + "° " + str(nAsa, 1, 0) + "段 GL+"
			for ia = 1 to nAsa
				if ia > 1 then tdt = tdt + "・"
				tdt = tdt + str(asa[ia] * 1000, 4, 0)
			next ia
			if qA > 0.001 or qB < lineLen - 0.001 then tdt = tdt + "（範囲 " + str(qA * 1000, 4, 0) + "〜" + str(qB * 1000, 4, 0) + "）"
			gosub 985
			set style "anno"
		endif
	next isg
	if (cornerS = 1 or cornerG = 1) and sA = 1 and asaCrnOff = 0 then
		aY = -rowW
		if stOut = 1 then
			for it8 = 1 to nSt
				if stS[it8] < 0.001 then aY = -2 * rowW
			next it8
		endif
		line2 -cSW - asagaoProj, aY - asagaoProj, 0, aY - asagaoProj
		line2 -cSW - asagaoProj, aY - asagaoProj, -cSW - asagaoProj, 0
		line2 -cSW, -rowW, -cSW - asagaoProj, aY - asagaoProj
	endif
	line_type 1
	! 「朝顔切欠」は昇降機が通る切り欠きだけ（面の一部だけの朝顔の範囲の外は切欠ではない）
	for ic = 1 to nCut
		set style "annoC"
		hoIn = 0
		for ihc = 1 to nHo
			if hoP[ihc] > cutS[ic] - 0.001 and hoP[ihc] < cutE[ic] + 0.001 then hoIn = 1
		next ihc
		if showDim and hoIn = 1 and cutS[ic] >= gxA - 0.001 and cutS[ic] < gxB - 0.001 then
			tdx = (cutS[ic] + cutE[ic]) / 2
			tdy = -rowW - asagaoProj / 2
			tdt = "朝顔切欠"
			gosub 985
		endif
	next ic
	set style "anno"
endif

pen penLine
! 躯体面の参照線（離れ表示）。線種 3 は縮尺で点にしか見えないので、一点鎖線を図面上の長さで描く
! （利用者の指摘 2026-10-23: 足場平面の下に変の線がある）
line_type 1
dl = 0.006 * GLOB_SCALE
dg = 0.0015 * GLOB_SCALE
xs = pxA
while xs < pxB - 0.001 do
	xe = xs + dl
	if xe > pxB then xe = pxB
	line2 xs, standoff, xe, standoff
	xc = xe + dg
	if xc < pxB then line2 xc, standoff, xc + 0.0004 * GLOB_SCALE, standoff
	xs = xe + 2 * dg
endwhile
line_type 3
! 渡した区間: 実際の躯体線は離れが増える。破線で示す
! （凹み＝区間内が奥へ、張り出し＝区間外（両隣）が奥へ）
for ibr = 1 to nBr
	if brS[ibr] < gxA - 0.001 or brS[ibr] >= gxB - 0.001 then
		! 隣の部品が描く
	else
	line_type 3
	if brK[ibr] > 1.5 then
		! 斜辺: 実際の躯体線は区間の一端で離れ0、他端で最大（種別2＝終点側、3＝始点側）
		if brK[ibr] > 2.5 then
			line2 brS[ibr], standoff + brD[ibr], brS[ibr] + brL[ibr], standoff
		else
			line2 brS[ibr], standoff, brS[ibr] + brL[ibr], standoff + brD[ibr]
		endif
		line_type 1
		set style "annoC"
		tdx = brS[ibr] + brL[ibr] / 2
		tdy = standoff + brD[ibr] / 2 + 0.18
		tdt = "斜辺 渡し 離れ+最大" + str(brD[ibr] * 1000, 5, 0)
		gosub 985
		set style "anno"
	else
	if brK[ibr] < 0.5 then
		line2 brS[ibr], standoff, brS[ibr], standoff + brD[ibr]
		line2 brS[ibr], standoff + brD[ibr], brS[ibr] + brL[ibr], standoff + brD[ibr]
		line2 brS[ibr] + brL[ibr], standoff + brD[ibr], brS[ibr] + brL[ibr], standoff
		line_type 1
		set style "annoC"
		tdx = brS[ibr] + brL[ibr] / 2
		tdy = standoff + brD[ibr] + 0.18
		tdt = "凹み 渡し 離れ+" + str(brD[ibr] * 1000, 4, 0)
		gosub 985
		set style "anno"
	else
		line2 0, standoff + brD[ibr], brS[ibr], standoff + brD[ibr]
		line2 brS[ibr], standoff + brD[ibr], brS[ibr], standoff
		line2 brS[ibr] + brL[ibr], standoff, brS[ibr] + brL[ibr], standoff + brD[ibr]
		line2 brS[ibr] + brL[ibr], standoff + brD[ibr], lineLen, standoff + brD[ibr]
		line_type 1
		set style "annoC"
		tdx = brS[ibr] + brL[ibr] / 2
		tdy = standoff + brD[ibr] + 0.18
		tdt = "張り出し 渡し 両隣の離れ+" + str(brD[ibr] * 1000, 4, 0)
		gosub 985
		set style "anno"
	endif
	endif
	endif
next ibr
line_type 1

pen penTie
! 壁つなぎ位置（実務の記号は逆三角 ▽。頂点を躯体側に向けて、足場と躯体の間に置く）
! 壁つなぎを別の部品（ashiba_tie）で置いたとき（tieObj）は、その部品が ▽ を描く
nTieDraw = nTie
if tieObj then nTieDraw = 0
for it = 1 to nTieDraw
	if ties[it] >= gxA - 0.001 and ties[it] < gxB - 0.001 then
		gosub 960
		line2 ties[it], 0, ties[it], standoff
	endif
next it

if not(showDim) then return

pen penDim
! ---- 部材の名前（GDL のラベル。利用者の指定 2026-10-23: 必要なものは GDL ラベルで）----
! 部品の値（typeTxt・deckTxt・sheetTxt と壁つなぎの位置）から描くので、幅や種類を変えると名前も変わる。
! 例の仮設計画図に倣い、引出線の先に下線つきの文字。躯体の側（+Y）に並べる（外側は寸法で埋まる）
if lblOn and strlen(typeTxt) > 0 and pxB - pxA > 3.0 then
	set style "anno"
	! 北・西を向く面では文字が上下逆になる → 棚を逆向きに出して文字を 180° 回す（gosub 986）
	lbF = (SYMB_ROTANGLE > 90.001 and SYMB_ROTANGLE < 270.001)
	lbS = 1 - 2 * lbF
	lbY = standoff + 0.9
	! 足場の種類と幅（1行目）・作業床（2行目）
	! 位置は Python が断面図の切断線の端・階段を避けて選ぶ（lblAt。-1 か、この部品の範囲の外なら面の 25%）
	lbAx = pxA + (pxB - pxA) * 0.25
	if lblAt >= 0 and lblAt / 1000 >= pxA and lblAt / 1000 <= pxB then lbAx = lblAt / 1000
	lbAy = -rowW / 2
	lbT1 = typeTxt
	lbT2 = deckTxt
	! lblAt = -2: 短い面で空きが無い（隅・ほかの面のラベルに重なる）。同じ種類はほかの面に書くので、この面は書かない
	if lblAt > -1.5 then
		gosub 986
		lbEnd = max(lbAx, lbAx + lbS * (0.4 + lbW))
	else
		lbEnd = pxA
	endif
	! 壁つなぎ（この部品の範囲で、種類の名前より右の最初の壁つなぎ）
	lbT1 = tieTxt
	if strlen(lbT1) = 0 then lbT1 = "壁つなぎ"
	tkW = stw(lbT1) * GLOB_SCALE / 1000 + 0.15
	tkX = -1
	if lblTieAt >= 0 and lblTieAt / 1000 >= pxA and lblTieAt / 1000 < gxB - 0.001 then
		tkX = lblTieAt / 1000
	else
		for it = 1 to nTie
			if tkX < 0 and min(ties[it], ties[it] + lbS * (0.4 + tkW)) > lbEnd + 0.3 and ties[it] < gxB - 0.001 then tkX = ties[it]
		next it
	endif
	if tkX > 0 then
		lbAx = tkX
		lbAy = standoff / 2
		lbT2 = ""
		gosub 986
		lbEnd = max(lbAx, lbAx + lbS * (0.4 + lbW))
	endif
	! 外部養生（外側建地の外）
	if strlen(sheetTxt) > 0 then
		lbT1 = sheetTxt
		shW = stw(sheetTxt) * GLOB_SCALE / 1000 + 0.15
		lbAx = max(lbEnd + 0.5 + lbF * (0.4 + shW), pxA + (pxB - pxA) * 0.70)
		if lblShAt >= 0 and lblShAt / 1000 >= pxA and lblShAt / 1000 <= pxB then lbAx = lblShAt / 1000
		if max(lbAx, lbAx + lbS * (0.4 + shW)) < pxB - 0.3 then
			lbAy = -rowW - 0.05
			lbT2 = ""
			gosub 986
		endif
	endif
endif

! 離れ寸法: 躯体面と内側建地列の間（面の両端のスパン中央に1本ずつ。端数スパンや渡しで
! 面の途中の離れが違っても、両端を見れば分かる）。寸法線は面に直交、値は線の脇に
for kd = 1 to 2 * (1 - dimSoTool)
	if kd = 1 then xd = pxA + spans[sA] / 2 else xd = pxB - spans[sB] / 2
	if kd = 1 and segBase = 1 and sA = 1 and soDimX1 > 0.001 then xd = soDimX1
	if kd = 2 and soDimX2 > 0.001 and soDimX2 > pxA and soDimX2 < pxB then xd = soDimX2
	line2 xd, 0, xd, standoff
	line2 xd - 0.05, 0.05, xd + 0.05, -0.05
	line2 xd - 0.05, standoff + 0.05, xd + 0.05, standoff - 0.05
	line2 xd - 0.12, 0, xd + 0.12, 0
	line2 xd - 0.12, standoff, xd + 0.12, standoff
	set style "anno"
	tdt = str(standoff * 1000, 4, 0)
	tdx = xd + 0.08 + stw(tdt) * GLOB_SCALE / 2000
	tdy = standoff / 2
	gosub 985
next kd

! 寸法線は外側に張り出すもの（昇降機の搬器・マスト、荷受けステージ）の外へ置く。
! 面の中央に昇降機があると「L= 離れ」の文字が搬器の破線に重なって読めなかった
dOff = 0
for ih = 1 to nHo
	if 0.10 + hoD[ih] + 0.55 > dOff then dOff = 0.10 + hoD[ih] + 0.55
next ih
for ig = 1 to nSg
	if sgP[ig] + 0.10 > dOff then dOff = sgP[ig] + 0.10
next ig
if nAsa > 0 and asagaoProj + 0.35 > dOff then dOff = asagaoProj + 0.35
! 外付けの階段室は外側建地列の外にもう1升
if stOut = 1 and nSt > 0 and rowW + 0.10 > dOff then dOff = rowW + 0.10
! スパン寸法: 足場から離した寸法線（参考: 足場平面図は寸法を外へ離して読みやすく）。各支柱に補助線と
! 目盛り（斜線）、数字は線の上。その外に全長の寸法線
yd = -rowW - dOff - 0.90
yt = yd - 0.70
! 寸法ツールで寸法を付けたとき（dimTool）は部品ではスパン・全長の寸法を描かない（二重になる）
if dimTool then return
! 両端の出隅コーナー（外側の角の支柱）まで寸法を張る
cS = cornerS
if sA > 1 then cS = 0
cE = cornerE
if sB < nSpan then cE = 0
xs = pxA - cSW * cS
xe = pxB + cEW * cE
line2 xs, yd, xe, yd
line2 xs, yt, xe, yt
if cS then
	line2 xs, -rowW - 0.10, xs, yd - 0.10
	line2 xs - 0.07, yd - 0.07, xs + 0.07, yd + 0.07
	tdx = xs / 2
	tdy = yd + 0.16
	tdt = str(cSW * 1000, 5, 0)
	gosub 985
endif
if cE then
	line2 xe, -rowW - 0.10, xe, yd - 0.10
	line2 xe - 0.07, yd - 0.07, xe + 0.07, yd + 0.07
	tdx = pxB + cEW / 2
	tdy = yd + 0.16
	tdt = str(cEW * 1000, 5, 0)
	gosub 985
endif
x = 0
for ip = 1 to nSpan + 1
	if x >= pxA - 0.001 and x <= pxB + 0.001 then
		line2 x, -rowW - 0.10, x, yd - 0.10
		line2 x - 0.07, yd - 0.07, x + 0.07, yd + 0.07
	endif
	if ip <= nSpan then
		if ip >= sA and ip <= sB then
			tdx = x + spans[ip] / 2
			tdy = yd + 0.16
			tdt = str(spans[ip] * 1000, 5, 0)
			gosub 985
		endif
		x = x + spans[ip]
	endif
next ip
line2 xs, yd - 0.10, xs, yt - 0.10
line2 xe, yd - 0.10, xe, yt - 0.10
line2 xs - 0.07, yt - 0.07, xs + 0.07, yt + 0.07
line2 xe - 0.07, yt - 0.07, xe + 0.07, yt + 0.07
tdx = (xs + xe) / 2
tdy = yt + 0.16
tdt = "L=" + str((xe - xs) * 1000, 6, 0) + "  離れ" + str(standoff * 1000, 4, 0)
gosub 985
set style "anno"
return

! ============================================================
200: ! ---- 立面図 ----
! 作図順（実務）: GL・ジャッキ → 1段目 → 上へ積上げ → 壁つなぎ → 寸法・特記

pen penLine
! GL と地盤ハッチ。敷地高低差があれば支柱位置ごとの地盤高（glList）を結ぶ
! （平坦のまま描くと、継ぎ足した支柱もジャッキの差も図に出ない）
if nGl >= 2 then
	gx = -0.5
	gy = gl[1]
	xp = 0
	for ip = 1 to nSpan + 1
		gv = 0
		if ip <= nGl then gv = gl[ip]
		line2 gx, gy, xp, gv
		gx = xp
		gy = gv
		if ip <= nSpan then xp = xp + spans[ip]
	next ip
	line2 gx, gy, lineLen + 0.5, gy
	! ハッチは各区間の地盤線に沿って打つ
	xp = 0
	for ip = 1 to nSpan
		g0 = 0
		g1 = 0
		if ip <= nGl then g0 = gl[ip]
		if ip + 1 <= nGl then g1 = gl[ip + 1]
		nh = int(spans[ip] / 0.12)
		for ih = 0 to nh
			hx = xp + ih * 0.12
			hy = g0 + (g1 - g0) * (ih * 0.12 / spans[ip])
			line2 hx, hy, hx - 0.08, hy - 0.08
		next ih
		xp = xp + spans[ip]
	next ip
	text2 -0.5, gl[1] - 0.22, "GL"
else
	line2 -0.5, 0, lineLen + 0.5, 0
	gx = -0.45
	while gx < lineLen + 0.45 do
		line2 gx, 0, gx - 0.08, -0.08
		gx = gx + 0.12
	endwhile
	text2 -0.5, -0.22, "GL"
endif

! 各階FLの参照線（躯体との対応を見るため）
line_type 3
for ifl = 1 to nFL
	line2 -0.3, fls[ifl], lineLen + 0.3, fls[ifl]
	text2 lineLen + 0.35, fls[ifl], str(ifl, 1, 0) + "FL"
next ifl
line_type 1

pen penPost
! 支柱（ジャッキ＋積上げ）と ジョイント位置
x = 0
for ip = 1 to nSpan + 1
	! 梁枠の内側は支柱を抜き、梁下から上だけ描く
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	! この支柱位置の地盤高とジャッキ（敷地高低差があれば脚ごと、無ければ共通）
	gv = 0
	jo = jackOut
	sv = shimAll
	if ip <= nGl then gv = gl[ip]
	if ip <= nJk then jo = jk[ip]
	if ip <= nSh then sv = sh[ip]
	! ジャッキベース: 敷板（あれば）＋アンダーベース（140角）＋ねじ棒φ38.1＋ハンドル付きナット（3Dと同じ形）
	if bBase = 0 then
		if sv > 0.001 then rect2 x - 0.15, gv, x + 0.15, gv + sv
		rect2 x - 0.07, gv + sv, x + 0.07, gv + sv + 0.006
		rect2 x - 0.019, gv + sv + 0.006, x + 0.019, gv + jo
		rect2 x - 0.045, gv + jo - 0.03, x + 0.045, gv + jo
		line2 x - 0.09, gv + jo - 0.015, x + 0.09, gv + jo - 0.015
	endif
	! 支柱（継ぎ足した脚は下へ伸びる）
	if bBase = 0 then
		rect2 x - r_sic, gv + jo, x + r_sic, postTop
	else
		! 梁枠の上の建地は梁渡しの上（上弦材＝作業床の1段下のコマ）から（3D と同じ）
		bDrP = 0.06
		if komaPitch > 0.001 then bDrP = komaPitch
		rect2 x - r_sic, bBase - bDrP + 0.07, x + r_sic, postTop
	endif
	! 縦継ぎ（ジョイント）位置に短い横線。継ぎ足しは下側なので天端から数える
	jh = postTop
	for jp = nPost to 2 step -1
		jh = jh - posts[jp]
		line2 x - 0.05, jh, x + 0.05, jh
	next jp
	hotspot2 x, gv
	hotspot2 x, postTop
	if ip <= nSpan then x = x + spans[ip]
next ip

pen penLine
! 根がらみ（最下コマ）＝ lv[1]
! 開口部はGLから梁枠までの通路なので、その区間には根がらみも入らない
! （足元に横材が通っていたら通れない）。数量でも同じ区間を引いている
x = 0
for ip = 1 to nSpan
	inOpen = 0
	for ib5 = 1 to nBm
		if x >= bmS[ib5] - 0.001 and x + spans[ip] <= bmS[ib5] + bmL[ib5] + 0.001 then inOpen = 1
	next ib5
	if inOpen = 0 then
		line2 x, lv[1], x + spans[ip], lv[1]
		line2 x, lv[1] + 0.02, x + spans[ip], lv[1] + 0.02
	endif
	x = x + spans[ip]
next ip

! 継ぎ足した脚の区間の根がらみ（敷地高低差）。基準の根がらみは低い脚の地盤から
! 離れるので、区間両端の脚のうち下げ段数の少ない方に合わせて1段入れる
! （数量と同じ規則。下げ段数は支柱下端の基準からの差÷刻みで求める）
if nGl >= 2 and footStep > 0.001 then
	x = 0
	for ip = 1 to nSpan
		inOpen = 0
		for ib5 = 1 to nBm
			if x >= bmS[ib5] - 0.001 and x + spans[ip] <= bmS[ib5] + bmL[ib5] + 0.001 then inOpen = 1
		next ib5
		ma = 0
		mb = 0
		if ip <= nGl and ip <= nJk then ma = round_int((jackOut - (gl[ip] + jk[ip])) / footStep)
		if ip + 1 <= nGl and ip + 1 <= nJk then mb = round_int((jackOut - (gl[ip + 1] + jk[ip + 1])) / footStep)
		mlo = ma
		if mb < mlo then mlo = mb
		if mlo >= 1 and inOpen = 0 then
			zz = lv[1] - mlo * footStep
			line2 x, zz, x + spans[ip], zz
			line2 x, zz + 0.02, x + spans[ip], zz + 0.02
		endif
		x = x + spans[ip]
	next ip
endif

! 各作業層: 布板・手すり・中桟・幅木
! 全長に通して描くと、階段室や開口部（梁枠より下＝通路）にも床があることに
! なってしまう。数量の差し引きと同じ区間を空ける
for il = 2 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		xs = x
		xe = x + spans[ip]
		noDeck = 0
		noAll = 0
		! 階段室は各層で階段が上がってくる1スパンだけ床が無い（奇数層は始点側、偶数層は終点側。3D と同じ）
		for it3 = 1 to nSt
			if xs >= stS[it3] - 0.001 and xe <= stS[it3] + stL[it3] + 0.001 then
				if stL[it3] <= spans[ip] + 0.001 then
					noDeck = 1
				else
					kOdd = il - 1 - 2 * int((il - 1) / 2)
					if abs(xs - stS[it3]) < 0.001 then
						if kOdd = 1 then noDeck = 1
					else
						if ip > 1 then
							if kOdd = 0 and abs(xs - spans[ip - 1] - stS[it3]) < 0.001 then noDeck = 1
						endif
					endif
				endif
			endif
		next it3
		for ib2 = 1 to nBm
			if xs >= bmS[ib2] - 0.001 and xe <= bmS[ib2] + bmL[ib2] + 0.001 and \
					z < bmH[ib2] - 0.001 then noAll = 1
		next ib2
		! 荷受けステージの間口は設置層で外側の手すり・中桟・幅木を外す（3D・数量と同じ）
		inSg = 0
		for ig2 = 1 to nSg
			if xs >= sgS[ig2] - 0.001 and xe <= sgS[ig2] + sgL[ig2] + 0.001 and \
					abs(z - sgH[ig2]) < 0.001 then inSg = 1
		next ig2
		! 昇降機の乗り込み口（開閉式手すりは別に描く）
		for il4 = 1 to nLa
			if laP[il4] >= xs - 0.001 and laP[il4] < xe - 0.001 and abs(z - laH[il4]) < 0.001 then inSg = 2
		next il4
		! 内ブラケットで拡幅した層・スパンは躯体側の手すり・中桟を付けない（3D・数量と同じ）。
		! 張出しブラケットの層・スパンは建地位置の外側手すり・幅木を外す（新しい縁の手すりに任せる）
		inBk = 0
		for ik2 = 1 to nBk
			if bkD[ik2] > 0 and xs >= bkS[ik2] - 0.001 and xe <= bkE[ik2] + 0.001 and \
					abs(z - bkH[ik2]) < 0.001 then inBk = 1
			if bkD[ik2] < 0 and xs >= bkS[ik2] - 0.001 and xe <= bkE[ik2] + 0.001 and \
					abs(z - bkH[ik2]) < 0.001 then inSg = 1
		next ik2
		! 枠組の中間層は布材の手すり・中桟を描かない（交差筋交＋幅木。数量と同じ）
		frMid = 0
		if serType = "W" and il < nLv then frMid = 1
		! 足場の中の階段室: 上がってくる・上がっていく階段のスパンは外側の手すり（上の段）を付けず、中桟だけ
		! （階段手すり 2段が沿う。利用者の指定 2026-10-24: 階段の1段目の布材だけある。3D・数量と同じセル）
		stRl = 0
		if stOut = 0 and railAdv = 0 then
			kk = il - 1
			for it7 = 1 to nSt
				if xs >= stS[it7] - 0.001 and xe <= stS[it7] + stL[it7] + 0.001 then
					jj = 0
					if abs(xs - stS[it7]) > 0.001 then jj = 1
					ja = 0
					jb = 0
					if stL[it7] > spans[ip] + 0.001 then
						ja = 1 - (kk - 2 * int(kk / 2))
						jb = 1 - ((kk + 1) - 2 * int((kk + 1) / 2))
					endif
					if jj = ja then stRl = 1
					if kk < nLv - 1 and jj = jb then stRl = 1
				endif
			next it7
		endif
		if stRl = 1 and inSg = 0 then inSg = 3
		if noAll = 0 then
			! 布板（作業床）。階段室は段板で上がるので敷かない
			if noDeck = 0 then rect2 xs, z, xe, z + 0.05
			! 幅木は床のある升目だけ（階段が上がってくる升目は床が無いので付けない。3D・数量と同じ）
			! 先行手すり方式では幅木を付けない（落下物防止はメッシュシート等）
			if railAdv = 0 and toeOn = 1 and (inSg = 0 or inSg = 3) and noDeck = 0 then rect2 xs, z + 0.05, xe, z + 0.05 + 0.157
			! 幅木を付けないときは下さん（床から300の桟）
			if railAdv = 0 and toeOn = 0 and shitaSan = 1 and (inSg = 0 or inSg = 3) and noDeck = 0 then line2 xs, z + 0.30, xe, z + 0.30
			if inSg = 0 and frMid = 0 then line2 xs, z + railTop, xe, z + railTop
			if inSg >= 1 or frMid = 1 then
				! ステージの間口・乗り込み口: 躯体側の手すり・中桟だけ。階段室は外側の中桟（と躯体側）
				if inSg = 3 then line2 xs, z + railMid, xe, z + railMid
				if railIn = 1 and nRows >= 2 and inBk = 0 then
					line2 xs, z + railTop, xe, z + railTop
					line2 xs, z + railMid, xe, z + railMid
				endif
			else
			if railAdv = 1 then
				! 先行手すりは手すり1本＋X形の斜材2本が一体（手すり・中桟・筋交を兼ねる）
				line2 xs, z + railTop, xe, z + 0.02
				line2 xe, z + railTop, xs, z + 0.02
				! 躯体側の中桟（布材）は先行手すりの奥に見える
				if railIn = 1 and nRows >= 2 and inBk = 0 then
					line2 xs, z + railMid, xe, z + railMid
				endif
			else
				line2 xs, z + railMid, xe, z + railMid
			endif
			endif
		endif
		x = xe
	next ip
next il

! ブレス（交さ2方向）。1箇所に2本入る前提で数量を拾っているので、図も両方向を描く（片方向だけ描くと
! 部材表の本数と図が食い違う）。くさび・単管はこのスパンに「／」・隣のスパンに「＼」の山形（3D と同じ。
! 同じスパンの X は先行手すりと紛らわしい）。枠組の交差筋交は X。設置間隔は数量拾いと揃える
x = 0
for ip = 1 to nSpan
	for il = 1 to nLv - 1
		if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 and brOn[il] = 1 then
			! 開口の通路（梁枠より下）に掛かる筋かいは描かない（3D と同じ。利用者の指摘 2026-10-24）
			bk1 = x
			bk2 = x + spans[ip]
			if serType <> "W" then
				if ip < nSpan then
					bk3 = x + spans[ip]
					bk4 = x + spans[ip] + spans[ip + 1]
				else
					spb = spans[ip]
					if ip > 1 then spb = spans[ip - 1]
					bk3 = x - spb
					bk4 = x
				endif
			else
				bk3 = x
				bk4 = x + spans[ip]
			endif
			bS1 = 0
			bS2 = 0
			for ib9 = 1 to nBm
				if lv[il] < bmH[ib9] - 0.001 then
					if min(bk2, bmS[ib9] + bmL[ib9]) - max(bk1, bmS[ib9]) > 0.001 then bS1 = 1
					if min(bk4, bmS[ib9] + bmL[ib9]) - max(bk3, bmS[ib9]) > 0.001 then bS2 = 1
				endif
			next ib9
			if bS1 = 0 then line2 x, lv[il], x + spans[ip], lv[il + 1]
			if bS2 = 0 then
			if serType = "W" then
				line2 x + spans[ip], lv[il], x, lv[il + 1]
			else
				if ip < nSpan then
					line2 x + spans[ip] + spans[ip + 1], lv[il], x + spans[ip], lv[il + 1]
				else
					line2 x, lv[il], x - spb, lv[il + 1]
				endif
			endif
			endif
		endif
	next il
	x = x + spans[ip]
next ip

! 始点の出隅コーナー（外側コーナー支柱と、そこまでの布材・手すり・踏板・幅木）
if cornerS = 1 then
	gv = 0
	if nGl >= 1 then gv = gl[1]
	line2 -cSW, gv, -cSW, postTop
	for il = 1 to nLv
		z = lv[il]
		line2 -cSW, z, 0, z
		if il > 1 then
			line2 -cSW, z + railTop, 0, z + railTop
			line2 -cSW, z + railMid, 0, z + railMid
			rect2 -cSW, z, 0, z + 0.05
			if railAdv = 0 and toeOn = 1 then rect2 -cSW, z + 0.05, 0, z + 0.05 + 0.157
		endif
	next il
endif

pen penStair
! 階段室（立面では区間の各層に斜めの段板を示す）
for it2 = 1 to nSt
	sx = stS[it2]
	ex = sx + stL[it2]
	line2 sx, lv[1], sx, postTop
	line2 ex, lv[1], ex, postTop
	! 3Dと同じ: 同じ向き（始点→終点）で2層ずつ（奇数層は始点側、偶数層は終点側のスパン）。段の刻みと階段手すりも描く
	sl = ex - sx
	for il5 = 1 to nLv - 1
		rise = lv[il5 + 1] - lv[il5]
		! 階段室のスパン（1つ目＝始点側、2つ目＝終点側。1スパンの階段室は2つ目なし）
		stA = sl
		stB = 0
		xa = 0
		for ipx = 1 to nSpan
			if abs(xa - sx) < 0.001 then
				stA = spans[ipx]
				if ipx < nSpan then
					if xa + spans[ipx] + spans[ipx + 1] <= sx + sl + 0.001 then stB = spans[ipx + 1]
				endif
			endif
			xa = xa + spans[ipx]
		next ipx
		! 同じ向き（始点→終点）で2層ずつ: 奇数層は始点側のスパン、偶数層は終点側のスパンに1スパン分の階段。
		! 2層登ったら階段室を出て外の作業床を回って戻る（階段室の中に踊り場の床は無い）
		x0 = sx
		fl = stA
		if il5 - 2 * int(il5 / 2) = 0 and stB > 0 then
			x0 = sx + stA
			fl = stB
		endif
		nStep = int(rise / 0.225 + 0.5)
		if nStep < 1 then nStep = 1
		td = fl / nStep
		th = rise / nStep
		for is2 = 1 to nStep
			line2 x0 + (is2 - 1) * td, lv[il5] + (is2 - 1) * th, x0 + (is2 - 1) * td, lv[il5] + is2 * th
			line2 x0 + (is2 - 1) * td, lv[il5] + is2 * th, x0 + is2 * td, lv[il5] + is2 * th
		next is2
		! 階段手すり 2段（手すりと中桟、階段と平行。3D と同じ高さ: 床の手すり・中桟と同じ railTop・railMid）。
		! 手すり用の支柱は立てない（利用者の指定 2026-10-24: 足場の手すりはこのかたち 2段、高さを下げる）
		for tk = 0 to 1
			hT = railTop
			if tk = 1 then hT = railMid
			line2 x0, lv[il5] + hT, x0 + fl, lv[il5 + 1] + hT
		next tk
	next il5
	set style "annoC"
	if showDim then text2 (sx + ex) / 2, lv[1] - 0.2, "階段"
	set style "anno"
next it2

pen penEquip
! ブラケット区間（立面では該当層の床を太線にして幅を注記する）
! 平面と3Dには出ているのに立面だけ描いておらず、区間指定が図から消えていた
for ik2 = 1 to nBk
	kx1 = bkS[ik2]
	kx2 = bkE[ik2]
	kz = bkH[ik2]
	line2 kx1, kz - 0.02, kx2, kz - 0.02
	line2 kx1, kz + 0.07, kx2, kz + 0.07
	line2 kx1, kz - 0.02, kx1, kz + 0.07
	line2 kx2, kz - 0.02, kx2, kz + 0.07
	if showDim then
		if bkD[ik2] > 0 then
			kTxt = "BR" + str(bkW[ik2] * 1000, 4, 0) + "内"
		else
			kTxt = "BR" + str(bkW[ik2] * 1000, 4, 0) + "張出"
		endif
		if bkDW[ik2] > 0 then kTxt = kTxt + " 床" + str(bkDW[ik2] * 1000, 4, 0)
		set style "annoC"
		text2 (kx1 + kx2) / 2, kz + 0.12, kTxt
		set style "anno"
	endif
next ik2

! 荷受けステージ（立面では設置高さの区間を太線と文字で）
for ig = 1 to nSg
	gs = sgS[ig]
	ge = gs + sgL[ig]
	gh = sgH[ig]
	rect2 gs, gh, ge, gh + 0.05
	line2 gs, gh, gs, gh + 0.9
	line2 ge, gh, ge, gh + 0.9
	line2 gs, gh + 0.9, ge, gh + 0.9
	set style "annoC"
	if showDim then text2 (gs + ge) / 2, gh + 1.05, "荷受けステージ 出" + str(sgP[ig] * 1000, 4, 0)
	set style "anno"
next ig

! 昇降機（立面では搬器の通る範囲を破線で、マスト（0.30角・到達高さ+1m）と
! 最下の乗り込み口の高さに置いた搬器（高さ2.2m）を実線で。控えピッチごとに
! マスト控えの印。3D・詳細図と同じ取合い）
for ih = 1 to nHo
	hx = hoP[ih]
	line_type 3
	rect2 hx - hoW[ih] / 2, 0, hx + hoW[ih] / 2, hoR[ih]
	line_type 1
	rect2 hx - 0.15, 0, hx + 0.15, hoR[ih] + 1.0
	cz2 = 0.20
	for il6 = 1 to nLa
		if abs(laP[il6] - hx) < 0.001 then
			if cz2 = 0.20 or laH[il6] < cz2 then cz2 = laH[il6]
		endif
	next il6
	rect2 hx - hoW[ih] / 2, cz2, hx + hoW[ih] / 2, cz2 + 2.2
	line2 hx - hoW[ih] / 2, cz2, hx + hoW[ih] / 2, cz2 + 2.2
	line2 hx - hoW[ih] / 2, cz2 + 2.2, hx + hoW[ih] / 2, cz2
	tp2 = hoTp[ih]
	if tp2 < 0.5 then tp2 = 3.6
	for it2 = 1 to int(hoR[ih] / tp2)
		rect2 hx - 0.06, it2 * tp2 - 0.03, hx + 0.06, it2 * tp2 + 0.03
	next it2
	set style "annoC"
	if showDim then text2 hx, hoR[ih] + 1.12, "昇降機 到達" + str(hoR[ih] * 1000, 5, 0)
	set style "anno"
next ih
line_type 1
! 乗り込み口（開閉式手すり）。足場側の開口なので、どの層かを図に出す
for il2 = 1 to nLa
	lx = laP[il2]
	lz = laH[il2]
	! 乗り込み口の幅はその昇降機の搬器幅
	lw = HOIST_W
	for ih2 = 1 to nHo
		if abs(hoP[ih2] - lx) < 0.001 then lw = hoW[ih2]
	next ih2
	rect2 lx - lw / 2, lz, lx + lw / 2, lz + railH
	if showDim then
		set style "annoC"
		text2 lx, lz + railH + 0.10, "乗込口"
		set style "anno"
	endif
next il2

! 梁枠（立面ではトラス）
for ib = 1 to nBm
	bs = bmS[ib]
	be = bs + bmL[ib]
	! 上弦材は作業床の1段下のコマ、せい 370（3D と同じ。日建 カタログ p011）。斜材は1スパン4区画、束材は 1829 ごと
	bDr = 0.06
	if komaPitch > 0.001 then bDr = komaPitch
	bt = bmH[ib] - bDr
	bb = bt - 0.37
	nPn = max(1, int(bmL[ib] / 1.829 + 0.5))
	nd = 4 * nPn
	dW = bmL[ib] / nd
	! 上弦材は通し、下弦材は両端の1区画ずつ短い（両端がすぼまる。カタログ p010 の図）
	line2 bs, bt, be, bt
	line2 bs + dW, bb, be - dW, bb
	for iv = 1 to nPn - 1
		line2 bs + bmL[ib] * iv / nPn, bb, bs + bmL[ib] * iv / nPn, bt
	next iv
	for id = 0 to nd - 1
		dx1 = bs + dW * id
		dx2 = dx1 + dW
		if id - 2 * int(id / 2) = 1 then
			line2 dx1, bb, dx2, bt
		else
			line2 dx1, bt, dx2, bb
		endif
	next id
	! 補強のつなぎ材（梁枠の高さで両隣のスパン、床の高さで開口の上）
	xq = 0
	for iq = 1 to nSpan
		if abs(xq + spans[iq] - bs) < 0.001 or abs(xq - be) < 0.001 then line2 xq, bt, xq + spans[iq], bt
		if xq >= bs - 0.001 and xq + spans[iq] <= be + 0.001 then line2 xq, bmH[ib], xq + spans[iq], bmH[ib]
		xq = xq + spans[iq]
	next iq
	set style "annoC"
	if showDim then text2 (bs + be) / 2, bb - 0.20, "梁枠 " + str(bmL[ib] * 1000, 5, 0)
	set style "anno"
next ib

! 朝顔（立面では設置高さに太線と注記）
for ia = 1 to nAsa
	za = asa[ia]
	for isg = 1 to nAsg
		line2 asgA[isg], za, asgB[isg], za
		line2 asgA[isg], za + 0.02, asgB[isg], za + 0.02
	next isg
	if showDim then text2 lineLen + 0.1, za, "朝顔" + str(ia, 1, 0) + "段目 GL+" + str(za * 1000, 5, 0)
	for ic = 1 to nCut
		set style "annoC"
		if showDim then text2 (cutS[ic] + cutE[ic]) / 2, za + 0.12, "朝顔切欠（昇降機）"
	next ic
	set style "anno"
next ia

! 壁つなぎ: 形状を描いても判別できないので記号で示す。立面の記号は◎（中心が取付点）。平面は▽
! 立面の壁つなぎは注記強調のペン（warnPen）。壁つなぎのペンを選んだら（1 以外）そのペン
if penTie > 1 then pen penTie else pen warnPen
! tieList と tieHeightList は同じ長さの対（i番目の位置とi番目の高さが1組）
for it = 1 to nTiePair
	circle2 ties[it], tieH[it], 0.12
	circle2 ties[it], tieH[it], 0.065
next it
pen penDim

if not(showDim) then return

! ---- 高さ寸法（左側）: 段の高さ・支柱の高さ・足場の高さの3本（断面図方式の立面と同じ） ----
! 利用者の指定（2026-10-23）: 立面図・断面図は寸法に、層の高さは不要、段の高さ・支柱の高さ・全体の足場の高さ。
! 区間の数は寸法線の左（右詰め。桁が増えても寸法線と足場に掛からない）、見出しは天端の上
chGap = 1.2
for ch = 1 to 3
	dx = -0.35 - (ch - 1) * chGap
	line2 dx, 0, dx, postTop
	line2 dx - 0.06, 0, dx + 0.06, 0
	line2 dx - 0.06, postTop, dx + 0.06, postTop
	if ch = 1 then
		chTxt = "段の高さ"
		zA = 0
		for il = 1 to nLv
			if lv[il] > 0.001 and lv[il] < postTop - 0.001 then
				line2 dx - 0.06, lv[il], dx + 0.06, lv[il]
				dimTxt = str((lv[il] - zA) * 1000, 6, 0)
				text2 dx - 0.12 - stw(dimTxt) * GLOB_SCALE / 1000, (zA + lv[il]) / 2, dimTxt
				zA = lv[il]
			endif
		next il
		dimTxt = str((postTop - zA) * 1000, 6, 0)
		text2 dx - 0.12 - stw(dimTxt) * GLOB_SCALE / 1000, (zA + postTop) / 2, dimTxt
	endif
	if ch = 2 then
		chTxt = "支柱の高さ"
		if jackOut > 0.001 then
			line2 dx - 0.06, jackOut, dx + 0.06, jackOut
			dimTxt = "ジャッキ" + str(jackOut * 1000, 4, 0)
			text2 dx - stw(dimTxt) * GLOB_SCALE / 2000, -0.12 - txtLine, dimTxt
		endif
		zA = jackOut
		for i = 1 to nPost
			line2 dx - 0.06, zA + posts[i], dx + 0.06, zA + posts[i]
			dimTxt = str(posts[i] * 1000, 6, 0)
			text2 dx - 0.12 - stw(dimTxt) * GLOB_SCALE / 1000, zA + posts[i] / 2, dimTxt
			zA = zA + posts[i]
		next i
	endif
	if ch = 3 then
		chTxt = "足場の高さ"
		dimTxt = str(postTop * 1000, 6, 0)
		text2 dx - 0.12 - stw(dimTxt) * GLOB_SCALE / 1000, postTop / 2, dimTxt
	endif
	text2 dx - stw(chTxt) * GLOB_SCALE / 2000, postTop + 0.15, chTxt
next ch

! ---- スパン寸法（下側） ----
dy = -0.45
x = 0
for ip = 1 to nSpan
	set style "annoC"
	text2 x + spans[ip] / 2, dy - txtLine, str(spans[ip] * 1000, 5, 0)
	set style "anno"
	line2 x, dy, x, dy - 0.06
	x = x + spans[ip]
next ip
line2 x, dy, x, dy - 0.06
line2 0, dy, lineLen, dy
set style "annoC"
text2 lineLen / 2, dy - txtLine * 2.2, "L=" + str(lineLen * 1000, 6, 0)
set style "anno"
! ジャッキ繰出しは高さ寸法の列に入れると最下段（GL+100等）の寸法と
! 文字が重なって両方読めなくなる。GL下の空きに別記する
! 短い面では L= の文字と横に並ぶので、行を分ける
if nJk >= 2 then
	jmin = jk[1]
	jmax = jk[1]
	for ij = 2 to nJk
		if jk[ij] < jmin then jmin = jk[ij]
		if jk[ij] > jmax then jmax = jk[ij]
	next ij
	! 脚ごとの値がほぼ同じ（差5mm未満）なら範囲で書かない（「265〜265（高低差あり）」は誤解を招く）
	if jmax - jmin < 0.005 then
		text2 dx - txtH, dy - txtLine * 3.4, "ジャッキ繰出 " + str(jmin * 1000, 4, 0)
	else
		text2 dx - txtH, dy - txtLine * 3.4, "ジャッキ繰出 " + str(jmin * 1000, 4, 0) + "〜" + str(jmax * 1000, 4, 0) + "（高低差あり・脚ごと）"
	endif
else
	text2 dx - txtH, dy - txtLine * 3.4, "ジャッキ繰出 " + str(jackOut * 1000, 4, 0)
endif

! ---- 特記（形状では判別できないものは文字で書く。実務の作図法） ----
! 特記の列。FL参照（+0.35）や朝顔の高さ表示（+0.1・文字幅が2m超）と
! 同じ帯に置くと、階数や段数によっては行が重なる。文字幅の分だけ右に離す
tx = lineLen + 2.8
ny = postTop
text2 tx, ny, "立面図 " + faceName
ny = ny - txtLine * 1.4
if serType = "W" then
	text2 tx, ny, "本図は建枠を支柱・布材で表現しています（建枠の形状は別途）"
	ny = ny - txtLine
	text2 tx, ny, "根がらみ: 建枠脚部（布板と区別がつかないため特記）"
else
	text2 tx, ny, "根がらみ: 最下コマ（布板と区別がつかないため特記）"
endif
ny = ny - txtLine
text2 tx, ny, "頭つなぎ: 最上段（同上）"
ny = ny - txtLine
! 一側足場は建地1列。本足場の「内側／外側」の注記を出すと、無い建地列の
! 部材を書くことになる（実機の立面で確認）
if nRows = 1 then
	text2 tx, ny, "一側足場: 建地1列・作業床はブラケット受け"
	ny = ny - txtLine
	if railAdv = 1 then
		text2 tx, ny, "外側: ブレース＋先行手すり（手すり＋X斜材一体・幅木なし）"
	else
		text2 tx, ny, "外側: ブレース＋手すり＋中桟＋幅木"
	endif
else
	if railIn = 1 then
		text2 tx, ny, "内側: 手すり＋中桟（布材）"
	else
		text2 tx, ny, "内側: ブレース＋幅木"
	endif
	ny = ny - txtLine
	if railAdv = 1 then
		text2 tx, ny, "外側: ブレース＋先行手すり（手すり＋X斜材一体・幅木なし）"
	else
		text2 tx, ny, "外側: ブレース＋手すり＋中桟＋幅木"
	endif
endif
ny = ny - txtLine
text2 tx, ny, "作業層 " + str(nLevels, 2, 0) + "層 / 階高 " + str(floorH * 1000, 5, 0)
ny = ny - txtLine
text2 tx, ny, "壁つなぎ " + str(nTiePair, 3, 0) + "箇所（平面▽・立面◎）"
ny = ny - txtLine
text2 tx, ny, "壁離れ " + str(standoff * 1000, 4, 0)
return

! ============================================================
985:	! ---- 平面の文字（中央揃え。寸法の数字・部位名・離れ）。北・西を向く面では上下逆になるので 180° 回して読める向きに ----
set style "annoC"
add2 tdx, tdy
if SYMB_ROTANGLE > 90.001 and SYMB_ROTANGLE < 270.001 then rot2 180 else rot2 0
text2 0, 0, tdt
del 2
set style "anno"
return

! ============================================================
986:	! ---- 引出線のラベル: 矢先 (lbAx, lbAy) → 肘 (lbAx ± 0.4, lbY) → 棚。文字は棚の上（lbT1）と下（lbT2）。
	! 上下逆になる向き（lbF）では棚を逆に出し、文字を 180° 回して読める向きに ----
lbW = max(stw(lbT1), stw(lbT2)) * GLOB_SCALE / 1000 + 0.15
line2 lbAx, lbAy, lbAx + lbS * 0.4, lbY
add2 lbAx + lbS * 0.4, lbY
if lbF then rot2 180 else rot2 0
line2 0, 0, lbW, 0
text2 0.05, txtH * 1.15, lbT1
if strlen(lbT2) > 0 then text2 0.05, -txtH * 0.25, lbT2
del 2
return

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 足場ライン 3Dスクリプト
! 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体側 +Y
! ============================================================
pen 1
! 表面材: 配置時に Python がプロジェクトのアルミ（金属 - アルミニウム）を入れる。0 は既定のまま
if matScaf > 0 then material matScaf
! 出隅の外側の升目の辺（前の面・次の面の幅の向き）。幅の違う本足場の組と出会う隅は長方形（2026-10-24）
cSW = cornerSW
if cSW < 0.001 then cSW = rowW
cEW = cornerEW
if cEW < 0.001 then cEW = rowW
! 梁枠の上弦材は作業床の1段下のコマ（日建 NDH、カタログ p011「取付位置は布板の1段下（450）のディスク」）。梁枠の上の
! 建地は内外の梁枠に渡した梁渡し（NDHW）の上に立つ。コマの無い枠組は床のすぐ下（利用者の指定 2026-10-24: 梁枠の詳細上げて）
bmDrop = 0.06
if komaPitch > 0.001 then bmDrop = komaPitch
bmDep = 0.37
! 単管のクランプは金色（利用者の指定 2026-10-22: クランプは金色にして）。本体・ふた・T ボルト・ナットとも。
! 直線ジョイント（PCJ）の帯は亜鉛めっきの銀。
! 足場の表面材（matScaf）が入っている部品だけ色を替える（0 の部品では描いたあと戻す材質が無い）
define material "ashiba_clamp_zinc" 2, 0.80, 0.81, 0.83
! 侵入落下防止柵（荷受けステージ）: 枠は塗装の灰、金網は向こうが透ける膜
define material "ashiba_fence_frame" 2, 0.50, 0.55, 0.58
define material "ashiba_fence_mesh" 0, 0.62, 0.66, 0.68, 0.6, 0.6, 0.1, 0.8, 5, 0, 1, 1, 1, 0, 0, 0, 0
define material "ashiba_clamp_gold" 2, 0.86, 0.68, 0.22
! ジャッキベースの識別色（日建 ND752P はベース板の底面が青）
define material "ashiba_jack_blue" 2, 0.10, 0.36, 0.78
! ジャッキベース（支柱の灰と見分ける青みの鋼色。利用者の指定 2026-10-25: ジャッキベースは少し色変えて）
define material "ashiba_jack_steel" 2, 0.36, 0.42, 0.52
! 敷板（杉の足場板）
define material "ashiba_sill_wood" 2, 0.60, 0.47, 0.34
! 支柱の継ぎ目の帯は支柱の長さごとの色（利用者の指定 2026-10-25: 支柱の繋ぎの色は長さごとに変えて）。継ぎ目の下の帯は
! 下の支柱、上の帯は上の支柱の長さの色: 3600級 赤・2700級 青・1800級 黄・1350級 緑・1125 水色・900級 橙・675 紫・450級 白
define material "ashiba_post_joint" 2, 0.86, 0.36, 0.16
define material "ashiba_pj_36" 2, 0.85, 0.15, 0.12
define material "ashiba_pj_27" 2, 0.12, 0.32, 0.80
define material "ashiba_pj_18" 2, 0.95, 0.82, 0.10
define material "ashiba_pj_135" 2, 0.15, 0.62, 0.25
define material "ashiba_pj_1125" 2, 0.40, 0.78, 0.92
define material "ashiba_pj_09" 2, 0.95, 0.50, 0.10
define material "ashiba_pj_0675" 2, 0.55, 0.30, 0.70
define material "ashiba_pj_045" 2, 0.95, 0.95, 0.95
! 単管の識別色（日建リース カタログVol.10 p372 の長さ別一覧表。単管の両端に塗る。利用者の指定 2026-10-22: 単管の種類）
define material "ashiba_tc_60" 3, 0.45, 0.78, 0.92	! 6.0M 水色
define material "ashiba_tc_55" 3, 0.85, 0.12, 0.12	! 5.5M 赤
define material "ashiba_tc_50" 3, 0.50, 0.50, 0.52	! 5.0M グレー
define material "ashiba_tc_45" 3, 0.50, 0.30, 0.15	! 4.5M 茶
define material "ashiba_tc_40" 3, 0.10, 0.30, 0.80	! 4.0M 青
define material "ashiba_tc_35" 3, 0.95, 0.55, 0.70	! 3.5M ピンク
define material "ashiba_tc_30" 3, 0.95, 0.85, 0.10	! 3.0M 黄
define material "ashiba_tc_25" 3, 0.08, 0.08, 0.08	! 2.5M 黒
define material "ashiba_tc_20" 3, 0.95, 0.50, 0.10	! 2.0M オレンジ
define material "ashiba_tc_15" 3, 0.15, 0.60, 0.25	! 1.5M 緑
define material "ashiba_tc_10" 3, 0.50, 0.25, 0.65	! 1.0M 紫
! 幅木の表面材: 黄色にしない（利用者の指定 2026-10-22）。踏板と少し違う色（利用者の指定 2026-10-24: はばきは少し違う
! 色にしてみようか）。踏板の鉄の色より少し濃い青みの鋼板色。前に黄の matToe で置いた部品もこの色で描く
define material "ashiba_toe_steel" 2, 0.40, 0.47, 0.56
mToe = IND(MATERIAL, "ashiba_toe_steel")
clW = 0.040		! クランプの口の幅
clT = 0.0045	! 口の帯の厚み
! 3Dの細かさ（detail3d）: 0=自動 1=精細 2=軽量 3=線 4=ブロック。足場は支柱・布材・コマで数千の部材になり、
! 建物一周を精細で出すと Archicad の3D・断面の生成が重く、操作しづらかった（利用者の指摘 2026-10-19）。
! 軽量は布材の爪・支柱の継手のカラー・ジャッキのハンドルと、フックを掛けない高さのコマを省き、円柱を6角にする
! （部材の位置・本数・寸法は精細と同じなので、干渉確認と図面には足りる）。自動は面の大きさで決める
d3 = detail3d
! モデル表示オプション（ashiba_mvo）の 3Dの表現: 1=精細 3=軽量 2=線 が部品の設定より優先
mvD = 0
if LIBRARYGLOBAL(mvoName, "mode3d", mvD) then
	if mvD = 1 then d3 = 1
	if mvD = 3 then d3 = 2
	if mvD = 2 then d3 = 3
	if mvD = 4 then d3 = 4
endif
if d3 < 1 or d3 > 4 then
	d3 = 1
	if nSpan * (nLv - 1) > 40 then d3 = 2
endif
if d3 = 3 then lineMode = 1
isLite = 0
if d3 = 2 then isLite = 1
! 断面図・立面図（GLOB_CONTEXT 4・24、GLOB_VIEW_TYPE 4〜6）では図面向きの形で描く（利用者の指定 2026-10-23:
! 断面図は2Dで書くときの形に。案2）。爪・カラー・ハンドル・クランプの細部は軽量と同じく省き、コマ（緊結部の座）は
! 描かない（2Dの断面図・立面図には描かない）。切り口の手すり・支柱が丸く見えるよう円柱は12角のまま。
! 3Dウィンドウ・平面はこれまでどおり
isDwg = 0
if GLOB_VIEW_TYPE = 4 or GLOB_VIEW_TYPE = 5 or GLOB_VIEW_TYPE = 6 then isDwg = 1
if GLOB_CONTEXT = 4 or GLOB_CONTEXT = 24 then isDwg = 1
if isDwg = 1 and d3 <> 3 and d3 <> 4 then isLite = 1
! 円柱の分割数。既定36だと30m面1つの3D生成に約40秒（支柱・布材・コマで数千本）。
! 精細は12（見た目は保ったまま面数が1/3）、軽量は6。コマ・ナットは6
rN = 12
jkSill = 0
if isLite and isDwg = 0 then rN = 6
resol rN

! 足場の高さの編集: 外側建地列の始点の天端を上下に引くと、作業層単位で層と支柱を足し引きする
! （パラメータスクリプト）。全面・帳票はパレットの「解き直し」で追従する。
! 3D にホットスポットを1つでも置くと外接箱の自動ホットスポットが消えるので、四隅も置く
if editSpan and serType <> "W" and nLevIn > 0 and segOn = 0 then
	hotspot 0, -rowW, 0, 1000, topEdit, 1 + 128
	hotspot 0, -rowW, topEdit, 1001, topEdit, 2
	hotspot 0, -rowW, -1, 1002, topEdit, 3
endif
! 区切った部品は自分の範囲の箱の四隅
hzA = 0
if gzA > 0 then hzA = gzA
hzB = postTop
if gzB < postTop then hzB = gzB
hotspot pxA, 0, hzA
hotspot pxB, 0, hzA
hotspot pxB, -rowW, hzA
hotspot pxA, 0, hzB
hotspot pxB, 0, hzB
hotspot pxB, -rowW, hzB

! ---- 区切る位置のつまみ（利用者の指定 2026-10-21「クリックした次のところから区切る、3Dで」） ----
! 選ぶと、上端（外側建地列の外）に縦の区切りのつまみ、始点の支柱の外に横の区切りのつまみが出る。
! 引いた位置の次の支柱の芯・次の作業床に吸着し（パラメータスクリプト）、そこに赤い面で区切り目を出す（990。
! 材質を替えるので描き終わりに）。
! パレットの「区切る」で、そこから先を別の部品にする
cyH = -rowW - 0.25
hotspot pxA, cyH, hzB, 1010, cutAtX, 1 + 128
hotspot pxA + cutAtX, cyH, hzB, 1011, cutAtX, 2
hotspot pxA - 1, cyH, hzB, 1012, cutAtX, 3
hotspot pxA - 0.25, cyH, hzA, 1013, cutAtZ, 1 + 128
hotspot pxA - 0.25, cyH, hzA + cutAtZ, 1014, cutAtZ, 2
hotspot pxA - 0.25, cyH, hzA - 1, 1015, cutAtZ, 3
! ---- 区切った部品: 範囲の箱の外を切り取る（縦は支柱の芯、横は作業床の 100 下） ----
! 切る形は無限に長い角筒（CUTPOLY）。範囲の外の側を大きな四角で囲んで消す。高さは x 軸まわりに回して角筒を水平に
nClip = 0
if gxA > -999 then
	cutpoly 4, -1000, -1000, gxA, -1000, gxA, 1000, -1000, 1000
	nClip = nClip + 1
endif
if gxB < 999 then
	cutpoly 4, gxB, -1000, 1000, -1000, 1000, 1000, gxB, 1000
	nClip = nClip + 1
endif
if gzA > -999 then
	rotx 90
	cutpoly 4, -1000, -1000, 1000, -1000, 1000, gzA, -1000, gzA
	del 1
	nClip = nClip + 1
endif
if gzB < 999 then
	rotx 90
	cutpoly 4, -1000, gzB, 1000, gzB, 1000, 1000, -1000, 1000
	del 1
	nClip = nClip + 1
endif

! ---- 向こう側の面を隠す幕（断面・立面だけ） ----
! 立面図は建物の外に置いた断面で描く。Tapir の断面は奥行きが無限（水平範囲を「制限」にできない）で、
! 壁の無い躯体だと向こう側の面の足場が透けて二重に描かれた（2026-10-18 実機）。GDL からは断面の向きが
! 分からないので、各面が自分の躯体面の 1m 奥に、辺の無い不透明な幕を立てる。手前の面を見る立面では
! その面の幕が向こう側を隠し、向こう側の面の幕は手前の足場の後ろにあって何も隠さない。
! 平面・3D には出さない
if GLOB_VIEW_TYPE = 4 or GLOB_VIEW_TYPE = 5 then
	add -rowW - 0.05, standoff + 1.0, -3.0
	! 側面だけ（状態 8: 面あり・辺なし）。上下の面の辺も出さない
	prism_ 4, postTop + 5.0, \
		0, 0, 8, \
		lineLen + 2 * rowW + 0.1, 0, 8, \
		lineLen + 2 * rowW + 0.1, 0.002, 8, \
		0, 0.002, 8
	del 1
endif

! ブロック表示（d3=4。参考: smartCON Planner の3D「ブロック」）: 部材を描かず、スパン×層ごとの半透明の箱で
! 足場の占める空間を出す。躯体・庇・隣地との取り合いを、部材の数に埋もれずに一目で見るため（いちばん軽い）。
! 開口部（梁枠より下）の升目は通路なので空ける。外付けの階段室は3列目の箱で出す
if d3 = 4 then
	define material "ashiba_block" 0, 0.95, 0.62, 0.20, 0.6, 0.6, 0.1, 0.55, 5, 0, 1, 1, 1, 0, 0, 0, 0
	material "ashiba_block"
	x = 0
	for ip = 1 to nSpan
		for il = 0 to nLv
			zb = 0
			if il > 0 then zb = lv[il]
			zt = postTop
			if il < nLv then zt = lv[il + 1]
			skB = 0
			for ib = 1 to nBm
				if x >= bmS[ib] - 0.001 and x + spans[ip] <= bmS[ib] + bmL[ib] + 0.001 and \
						zb < bmH[ib] - 0.001 then skB = 1
			next ib
			if zt > zb + 0.001 and skB = 0 then
				add x, -rowW, zb
				block spans[ip], rowW, zt - zb
				del 1
			endif
		next il
		x = x + spans[ip]
	next ip
	if stOut = 1 then
		for it = 1 to nSt
			add stS[it], -2 * rowW, 0
			block stL[it], rowW, postTop
			del 1
		next it
	endif
	gosub 990
	for ic9 = 1 to nClip
		cutend
	next ic9
	end
endif

! 線表示: 計画初期や40m級の建物一周で、部材の立体を描かずに支柱・水平材・階段・
! 付帯設備の占有範囲を線だけで出す（bim-arekore の足場計画.gsm の「線表示」と同じ考え方）。
! 立体表現（既定）は干渉確認用、線表示は割付検討用
mv3d = 0
if LIBRARYGLOBAL(mvoName, "mode3d", mv3d) then
	if mv3d = 1 then lineMode = 0
	if mv3d = 3 then lineMode = 0
	if mv3d = 2 then lineMode = 1
endif
if lineMode then
	gosub 900
	gosub 990
	for ic9 = 1 to nClip
		cutend
	next ic9
	end
endif

! ---- コマ（緊結部）の高さ kz[1..nKz] ----
! カタログの支柱図（master.post_koma_offsets と同じ規則）: 支柱1本ごとに、上端から komaGap 下を起点に
! komaPitch で下へ。negaLens の長さの支柱（ND1800 の 2700 など）は下端から komaNega に根がらみ用のコマ
! （そのすぐ上に無ければ komaPitch−komaGap にも）。利用者の指摘（2026-10-21）: 支柱のフックの高さは
! 450ピッチ、2700は根がらみ用のフックがある。以前は根がらみの高さから450ごとに並べ、継ぎ目にコマが来ていた。
! 軽量では、布材・腕木・踏板・手すりのフックを掛ける高さ（根がらみ・各作業床・中桟・手すり）のコマだけ描く
dim kz[]
dim kzAll[]
dim pj[40]
dim kzSeg[]
dim kzSegA[]
nKz = 0
nKzA = 0
if komaPitch > 0 then
	zb = jackOut
	for j = 1 to nPost
		pl = posts[j]
		zz = pl - komaGap
		while zz >= 0.1 - 0.0001 do
			nKzA = nKzA + 1
			kzAll[nKzA] = zb + zz
			kzSegA[nKzA] = zb
			zz = zz - komaPitch
		endwhile
		! 根がらみ用のコマ
		isNg = 0
		rest = negaLens
		while strlen(rest) > 0 do
			pc = strstr(rest, ",")
			if pc > 0 then
				item = strsub(rest, 1, pc - 1)
				rest = strsub(rest, pc + 1, strlen(rest) - pc)
			else
				item = rest
				rest = ""
			endif
			k = split(item, "%n", v)
			if k > 0 then
				if abs(v / 1000 - pl) < 0.0005 then isNg = 1
			endif
		endwhile
		if isNg = 1 and komaNega > 0.001 then
			nKzA = nKzA + 1
			kzAll[nKzA] = zb + komaNega
			kzSegA[nKzA] = zb
			! すぐ上（3/4 ピッチ以内）にコマが無ければ komaPitch−komaGap にも
			zm = pl - komaGap
			while zm - komaPitch > komaNega + 0.001 do
				zm = zm - komaPitch
			endwhile
			if zm > komaNega + 0.75 * komaPitch + 0.001 and komaPitch - komaGap < pl then
				nKzA = nKzA + 1
				kzAll[nKzA] = zb + komaPitch - komaGap
				kzSegA[nKzA] = zb
			endif
		endif
		zb = zb + pl
	next j
	for ik = 1 to nKzA
		keep = 1
		if isLite = 1 then
			keep = 0
			for il = 1 to nLv
				if abs(kzAll[ik] - lv[il]) < 0.005 then keep = 1
				if il > 1 then
					if abs(kzAll[ik] - lv[il] - railMid) < 0.005 then keep = 1
					if abs(kzAll[ik] - lv[il] - railTop) < 0.005 then keep = 1
				endif
			next il
		endif
		if keep = 1 then
			nKz = nKz + 1
			kz[nKz] = kzAll[ik]
			kzSeg[nKz] = kzSegA[ik]
		endif
	next ik
	! 断面図・立面図ではコマを描かない（isDwg）
	if isDwg = 1 then nKz = 0
endif

! ---- 支柱（各スパン境界に内外1対） ----
! 梁枠の内側は支柱を抜く（平面・立面と同じ）。3Dだけ建てたままだと、
! 実際には無い建地を干渉確認に使うことになる。
! 支柱だけ分解した部品（explodeMask）は、自分の持つ支柱（位置 x が [gxA, gxB)、下端が [gzA, gzB)）を分解した部材
! （ashiba_member）が描くので描かない。持たない支柱（隣の部品の区切り目の支柱など）は切り取った範囲の分だけ描く。
! ジャッキは足場ラインのまま。区切った部品の範囲の外の支柱は描かない（切り取られるので、描く手間だけ省く）
! ---- 敷板（支柱の列に沿って、ジャッキベースの下に規格の長さの敷板を通す。利用者の指定 2026-10-25: ジャッキベースの下に
! 敷板規格の長さ…を配置して）----
! 平らな地盤は sillList の列（「y,始め,終わり」。端は脚のベース板の少し先まで、隅で直交する列と重なるところは除いて
! ある。sill_boards）に、長いものから詰め、最後は残りの長さに切って並べる（残りが最短の規格に満たないときは1つ手前を
! 短い規格に。利用者の指摘 2026-10-25: 敷板が飛び出ている 繋がるようにして 規格の大きさを基本でカット）。
! 高低差のある地盤は脚ごとにいちばん短い規格を1枚（地盤の高さに合わせる）。幅 sillW・厚 sillT
if sillT > 0.001 and isLite = 0 then
	material "ashiba_sill_wood"
	nSl = 0
	rest = sillLens
	while strlen(rest) > 0 and nSl < 8 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		k = split(item, "%n", v)
		if k > 0 then
			nSl = nSl + 1
			slL[nSl] = v / 1000
		endif
	endwhile
	if nGl >= 2 then
		for row = rowStart to 1
			slY = -row * rowW - sillW / 2
			slX = 0
			for ip = 1 to nSpan + 1
				slG = 0
				if row = 1 and nGlO >= 2 then
					if ip <= nGlO then slG = glO[ip]
				else
					if ip <= nGl then slG = gl[ip]
				endif
				add slX - slL[nSl] / 2, slY, slG
				block slL[nSl], sillW, sillT
				del 1
				if ip <= nSpan then slX = slX + spans[ip]
			next ip
		next row
	else
		! sillList（続きは sillList2）はマスタースクリプトで slV・nSv に読んである
		for iSr = 1 to int(nSv / 3)
			slY = slV[3 * iSr - 2] - sillW / 2
			slX = slV[3 * iSr - 1]
			slRest = slV[3 * iSr] - slX
			while slRest > slL[1] + 0.001 do
				slLen = slL[1]
				if slRest - slL[1] < slL[nSl] then
					slLen = slL[nSl]
					for slI = nSl to 1 step -1
						if slRest - slL[slI] >= slL[nSl] then slLen = slL[slI]
					next slI
				endif
				add slX, slY, 0
				block slLen - 0.005, sillW, sillT
				del 1
				slX = slX + slLen
				slRest = slRest - slLen
			endwhile
			if slRest > 0.001 then
				add slX, slY, 0
				block slRest, sillW, sillT
				del 1
			endif
		next iSr
	endif
	if matScaf > 0 then material matScaf
endif

x = 0
for ip = 1 to nSpan + 1
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	! この支柱位置の地盤高とジャッキ（敷地高低差があれば脚ごと）
	gv = 0
	jo = jackOut
	sv = shimAll
	if ip <= nGl then gv = gl[ip]
	if ip <= nJk then jo = jk[ip]
	if ip <= nSh then sv = sh[ip]
	ownX = 0
	if x >= gxA - 0.001 and x < gxB - 0.001 then ownX = 1
	for row = rowStart to 1
		! 外側の列は外側の地盤（glListO）。斜面では内側の列と地盤高が違う
		if row = 1 and nGlO >= 2 then
			gv = 0
			jo = jackOut
			sv = shimAll
			if ip <= nGlO then gv = glO[ip]
			if ip <= nJkO then jo = jkO[ip]
			if ip <= nShO then sv = shO[ip]
		endif
		! 隅の内側建地は隣の面と同じ1本。高い方の面（同じなら次の面）だけが描く（両方の面が描いて重なっていた）
		skipP = 0
		if (row = 0 or hugMode = 1) and ((ip = 1 and skipInS = 1) or (ip = nSpan + 1 and skipInE = 1)) then skipP = 1
		! セットバックの上段の端は本体の支柱に乗る（支柱もジャッキベースも描かない。利用者の指定 2026-10-25）
		if (ip = 1 and skipPS = 1) or (ip = nSpan + 1 and skipPE = 1) then skipP = 1
		if x < gxA - 0.1 or x > gxB + 0.1 then skipP = 1
		if skipP = 1 then
			! 隣の面・隣の部品が描く
		else
		if bBase = 0 then
			add x, -row * rowW, gv
			! ジャッキ（敷板があればその上から）
			gosub 820
			addz jo
			if nGl >= 2 then
				! 継ぎ足した脚は長さが脚ごとに違う。天端まで1本で描く
				if not(explodeMask > 0 and ownX = 1 and gv + jo >= gzA - 0.001 and gv + jo < gzB - 0.001) then
					cylind postTop - gv - jo, r_sic
				endif
				del 2
			else
				! 支柱積み上げ（部材ごと）。継ぎ目には継手のカラーを描いて部材の切れ目を見せる
				! （同じ太さの円柱を積むだけだと1本の柱に見え、3600・1800 の割付が読めない）。
				! 単管は偶数番目の建地を千鳥の構成（postListAlt）で積む（継ぎ目の高さを隣とずらす）
				nPj = nPost
				for j = 1 to nPost
					pj[j] = posts[j]
				next j
				if nPostA > 0 and ip - 2 * int(ip / 2) = 0 then
					nPj = nPostA
					for j = 1 to nPostA
						pj[j] = postsA[j]
					next j
				endif
				zs = gv + jo
				for j = 1 to nPj
					if not(explodeMask > 0 and ownX = 1 and zs >= gzA - 0.001 and zs < gzB - 0.001) then
						cylind pj[j], r_sic
						! 単管の建地は両端に識別色
						if serType = "T" and isLite = 0 and matScaf > 0 then
							! （継ぎの側は直線ジョイントの帯 25 の半分をよける）
							cL = pj[j]
							gosub 846
							addz 0.0125 * (j > 1)
							cylind 0.03, r_sic + 0.0004
							del 1
							addz pj[j] - 0.03 - 0.0125 * (j < nPj)
							cylind 0.03, r_sic + 0.0004
							del 1
							material matScaf
						endif
						! 日建 NDストロングの支柱は異形断面（φ42.7・φ48.6 の十字形）。4方向のリブで見せる
						if postShape = 1 and isLite = 0 then
							add -0.0275, -0.003, 0
							block 0.055, 0.006, pj[j]
							del 1
							add -0.003, -0.0275, 0
							block 0.006, 0.055, pj[j]
							del 1
						endif
						addz pj[j]
						if j < nPj then
							jLo = pj[j]
							jUp = pj[j + 1]
							gosub 840
						endif
					else
						addz pj[j]
					endif
					zs = zs + pj[j]
				next j
				del nPj + 2
			endif
		else
			! 梁枠上に乗る支柱（梁渡しの上から天端まで1本で描く）
			if not(explodeMask > 0 and ownX = 1 and bBase >= gzA - 0.001 and bBase < gzB - 0.001) then
				zPb = bBase - bmDrop + r_nuno + 0.05
				add x, -row * rowW, zPb
				cylind postTop - zPb, r_sic
				del 1
			endif
		endif
		endif
	next row
	if ip <= nSpan then x = x + spans[ip]
next ip

! スパン寸法の立体の文字は出さない（利用者の指定 2026-10-18。3Dが読みにくくなる）。
! スパン寸法は平面・立面の2Dで読む

! ---- 出隅コーナー（始点側。x∈[-rowW,0], y∈[-rowW,0]） ----
! 内側建地列は隣の面と同じコーナー支柱で繋がるが、外側建地列は面ごとに躯体コーナー
! で終わるので、四隅の外側の升目（外側コーナー支柱・布材・踏板・幅木）が抜けていた。
! 各面は始点の出隅を描く（終点は次の面が描く）。一側足場も同じ（建地列は1列でも
! 躯体コーナーで終わる）。枠組には無い
if cornerS = 1 then
	gv = 0
	jo = jackOut
	sv = shimAll
	if nGl >= 1 then gv = gl[1]
	if nJk >= 1 then jo = jk[1]
	if nSh >= 1 then sv = sh[1]
	! 外側コーナー支柱は外側の列の始点の地盤
	if nGlO >= 1 then gv = glO[1]
	if nJkO >= 1 then jo = jkO[1]
	if nShO >= 1 then sv = shO[1]
	! 外側コーナー支柱も、支柱だけ分解した部品では下端が範囲の高さにあるものを分解した部材が描く。
	! 前の面が隅の隙間（コーナーステップ）の手前で止まる出隅は、前の面の外側列の延長の根元（-cSW, 0）にも建地が要る
	! （前の面の終点の建地は隙間の向こう。布材・手すりの緊結部が宙に浮いていた。利用者の指摘 2026-10-24: コーナー部分の
	! 支柱がない部分がある）。この升目は4本の建地で独り立ちする
	for iq = 1 to 1 + cornerSP
	yq = -rowW
	if iq = 2 then yq = 0
	add -cSW, yq, gv
	jkSill = 1
	gosub 820
	jkSill = 0
	addz jo
	if nGl >= 2 then
		if not(explodeMask > 0 and gv + jo >= gzA - 0.001 and gv + jo < gzB - 0.001) then
			cylind postTop - gv - jo, r_sic
		endif
		del 2
	else
		zs = gv + jo
		for j = 1 to nPost
			if not(explodeMask > 0 and zs >= gzA - 0.001 and zs < gzB - 0.001) then
				cylind posts[j], r_sic
				addz posts[j]
				if j < nPost then
					jLo = posts[j]
					jUp = posts[j + 1]
					gosub 840
				endif
			else
				addz posts[j]
			endif
			zs = zs + posts[j]
		next j
		del nPost + 2
	endif
	if nKz > 0 then
		resol 6
		for ik = 1 to nKz
			if not(explodeMask > 0 and kzSeg[ik] >= gzA - 0.001 and kzSeg[ik] < gzB - 0.001) then
				add -cSW, yq, kz[ik] - 0.003
				cylind 0.006, 0.053
				del 1
			endif
		next ik
		resol rN
	endif
	next iq
	for il = 1 to nLv
		z = lv[il]
		! 隙間のある出隅: 升目の前の面の側（y=0）の布材。床と、隙間に掛けるコーナーステップの先を受ける
		if cornerSP = 1 then
			add -cSW, 0, z
			nL = cSW
			gosub 830
			del 1
		endif
		! 前の面の外側列の延長（y方向）と、この面の外側列の手前（x方向）
		add -cSW, 0, z
		rotz -90
		nL = rowW
		gosub 830
		del 2
		add -cSW, -rowW, z
		nL = cSW
		gosub 830
		del 1
		if il > 1 then
			add -cSW, 0, z + railTop
			rotz -90
			nL = rowW
			gosub 830
			del 2
			add -cSW, -rowW, z + railTop
			nL = cSW
			gosub 830
			del 1
			add -cSW, 0, z + railMid
			rotz -90
			nL = rowW
			gosub 830
			del 2
			add -cSW, -rowW, z + railMid
			nL = cSW
			gosub 830
			del 1
			if showDeck and hugMode = 0 and serType = "T" then
				! 単管の足場の出隅（ブラケット足場・本足場。利用者の指摘 2026-10-22: コーナー部分の巾木がおかしい、
				! 単管の本足場の出隅も単管の板に揃えて）。くさび用のコーナー踏板・L形の幅木は描かない。足場板を床の列ごとに
				! 1枚、コーナーの単管（建地列の外）からこの面の最初の板の上に重ねて渡す。前の面の最後の板はさらにその上に
				! 載る（足場板の deck で1枚分上げる）。幅木は足場板を2枚、外側2辺それぞれ面の幅木の内側に重ねて立てる。
				! 板の長さは コーナーの単管から最初の建地の先まで届く 1.0M・1.5M・2.0M（数量の tube_runs.corner_board_mm と同じ）
				cbL = 1.0
				if cSW + tubeOff + 0.2 > 1.0 then cbL = 1.5
				if cSW + tubeOff + 0.2 > 1.5 then cbL = 2.0
				if matDeck > 0 then material matDeck
				add -cSW - tubeOff - 0.05, -rowW + 0.05, z + 0.0243 + 0.028
				block cbL, deckW1 - 0.01, 0.028
				del 1
				if deckW2 > 0 then
					add -cSW - tubeOff - 0.05, -rowW + 0.05 + deckW1 + 0.02, z + 0.0243 + 0.028
					block cbL, deckW2 - 0.01, 0.028
					del 1
				endif
				for cbw = 3 to deckN
					add -cSW - tubeOff - 0.05, -rowW + 0.05 + (cbw - 1) * (deckW1 + 0.02), z + 0.0243 + 0.028
					block cbL, deckW1 - 0.01, 0.028
					del 1
				next cbw
				if railAdv = 0 and toeOn = 1 then
					add -cSW + r_sic + 0.004, -rowW + r_sic + 0.032, z + 0.0243 + 0.056
					block cbL, 0.028, 0.24
					del 1
					add -cSW + r_sic + 0.032, -rowW + r_sic + 0.060, z + 0.0243 + 0.084
					block 0.028, cbL, 0.24
					del 1
				endif
				if matScaf > 0 then material matScaf
			endif
			if showDeck and hugMode = 0 and serType <> "T" then
				! コーナー踏板と、外側2辺の幅木（単管抱き足場は床材・幅木が無い）。表面材は本体の踏板（亜鉛）・幅木（黄）と同じにする
				! （支柱のアルミのまま描いて、隅だけ色が違っていた。利用者の指摘 2026-10-20）
				if matDeck > 0 then material matDeck
				add -cSW + 0.05, -rowW + 0.05, z + r_nuno
				block cSW - 0.05, rowW - 0.05, 0.045
				del 1
				if railAdv = 0 and toeOn = 1 then
					if mToe > 0 then material mToe
					add -cSW + r_sic + 0.004, -rowW + r_sic + 0.004, z + r_nuno + 0.045
					block cSW - r_sic, 0.008, 0.150
					block 0.008, rowW - r_sic, 0.150
					del 1
				endif
				if matScaf > 0 then material matScaf
			endif
		endif
	next il
endif

! ---- 開放端（一部の面だけの足場で隣の面を掛けない端）: 妻側の手すり・中桟・幅木 ----
! 参考: smartCON Planner「墜落の危険箇所に手すり（つま先板つき）」「エンドストッパー」
for ie9 = 0 to 1
	isOpen9 = endOpenS
	xe9 = 0
	if ie9 = 1 then
		isOpen9 = endOpenE
		xe9 = lineLen
	endif
	if isOpen9 = 1 then
		zOp9 = endOpenZS
		if ie9 = 1 then zOp9 = endOpenZE
		for il = 2 to nLv
			z = lv[il]
			! 下段に続く区間の切れ目は、途中の屋根より上の層だけ妻側を塞ぐ（下の層は下段の床に続く）
			if z >= zOp9 - 0.001 then
			if endBrace = 1 then
				! 妻側をブレス材（先行手すり。手すり＋X の斜材）で塞ぐ（利用者の指定 2026-10-24: 妻側を布材かブレス材か選択）
				add xe9, 0, z
				rotz -90
				nL = rowW
				gosub 850
				del 2
			else
				add xe9, 0, z + railTop
				rotz -90
				nL = rowW
				gosub 830
				del 2
				add xe9, 0, z + railMid
				rotz -90
				nL = rowW
				gosub 830
				del 2
			endif
			if showDeck and hugMode = 0 and toeOn = 1 then
				if mToe > 0 then material mToe
				add xe9 - 0.01, -rowW, z + r_nuno + 0.045
				block 0.008, rowW, 0.150
				del 1
				if matScaf > 0 then material matScaf
			endif
			endif
		next il
	endif
next ie9

! ---- 取り入れ口の可動手すり（利用者の指定 2026-10-24: 取り入れ口を作る仕組み）----
! 固定の手すり・中桟・幅木は editList で外してある。外側建地列の外（-rowW-0.06）に単管2本（手すり・中桟）を
! 範囲の両端の支柱へ自在クランプで留める（取り込むときだけ外す）
for ik = 1 to nIk
	for il = 2 to nLv
		if il - 1 >= ikL1[ik] and il - 1 <= ikL2[ik] then
			z = lv[il]
			for hk = 1 to 2
				hh = railTop
				if hk = 2 then hh = railMid
				add ikA[ik] - 0.10, -rowW - 0.06, z + hh
				roty 90
				cylind ikB[ik] - ikA[ik] + 0.20, 0.0243
				del 2
				for ce = 0 to 1
					add ikA[ik] + ce * (ikB[ik] - ikA[ik]) - 0.03, -rowW - 0.09, z + hh - 0.03
					block 0.06, 0.07, 0.06
					del 1
				next ce
			next hk
		endif
	next il
next ik

! ---- 跳ね出しブラケット（張り出した上の階の上段。利用者の指定 2026-10-24: 上階で拡張する仕組み）----
! 足場の立つ高さ（z=0）が床スラブの天端。支柱の位置ごとに、躯体の面（y=standoff）の受け金物から外側の建地列の外まで
! 水平材（角 60）、躯体の面の haneD 下から水平材の先へ方杖。支柱はその上に立つ（ジャッキは水平材に載る）
if haneD > 0.001 then
	xh = 0
	for ih7 = 1 to nSpan + 1
		if xh >= gxA - 0.001 and xh < gxB - 0.001 then
			add xh - 0.03, -rowW - 0.10, -0.06
			block 0.06, rowW + 0.10 + standoff, 0.06
			del 1
			add xh - 0.10, standoff, -haneD - 0.05
			block 0.20, 0.012, haneD + 0.05
			del 1
			! 方杖（φ48.6）: 躯体の面の haneD 下から水平材の先（外側の建地列の外）へ
			hdY = standoff + rowW + 0.05
			hdZ = haneD - 0.06
			add xh, standoff, -haneD
			rotx atn(hdY / hdZ)
			cylind sqr(hdY ^ 2 + hdZ ^ 2), 0.0243
			del 2
		endif
		if ih7 <= nSpan then xh = xh + spans[ih7]
	next ih7
endif

! ---- 枠組の終点の出隅: 建枠どうしは繋がらないので 70mm 以上離し、単管（φ48.6）を直交クランプで留めて繋ぐ ----
! 内外の建地列（y=0・-rowW）ごと、根がらみと各層の床の高さに、終点の建枠の脚から隣の面の建枠（隙間の向こう）まで
! （利用者の指定 2026-10-24: 枠足場は繋がらないから70mm離して単管で繋げけるようにして）
if frGapE > 0.001 and serType = "W" then
	for il = 1 to nLv
		fgZ = lv[il] - 0.08
		if il = 1 then fgZ = lv[1] + 0.10
		for fgR = 0 to 1
			fgY = -fgR * rowW - 0.0243 - 0.0214
			add lineLen - 0.10, fgY, fgZ
			roty 90
			cylind frGapE + 0.20, 0.0243
			del 2
			for fgC = 0 to 1
				add lineLen - 0.05 + fgC * (frGapE + 0.10) - 0.03, fgY - 0.03, fgZ - 0.03
				block 0.06, 0.06, 0.06
				del 1
			next fgC
		next fgR
	next il
endif

! ---- 枠組の出隅コーナー（始点側。x∈[-rowW,0], y∈[-rowW,0]）: ギャプレス（コーナー布受け） ----
! 日建カタログ p104〜105: 躯体からはみ出す側の建枠の横架材にギャプレスを掛け渡し、ギャプレスクランプで留め、
! その上に布板を敷く。外周2辺は手すり（アルミスカイガード）。以前は枠組のコーナーを何も描かず隙間が空いていた
if cornerG = 1 then
	for il = 2 to nLv
		z = lv[il]
		! ギャプレス（φ42.7、升目の外側の辺に沿って隣の面の建枠から渡す）
		add -rowW, 0, z - 0.03
		rotx 90
		cylind rowW, 0.0214
		del 2
		! ギャプレスクランプ（横架材との取付け）
		add -rowW - 0.03, -0.03, z - 0.06
		block 0.06, 0.06, 0.06
		del 1
		if showDeck then
			if matDeck > 0 then material matDeck
			add -rowW + 0.03, -rowW + 0.03, z
			block rowW - 0.06, rowW - 0.06, 0.045
			del 1
			if matScaf > 0 then material matScaf
		endif
		! 外周2辺の手すり・中桟
		add -rowW, 0, z + railTop
		rotz -90
		nL = rowW
		gosub 830
		del 2
		add -rowW, -rowW, z + railTop
		nL = rowW
		gosub 830
		del 1
		add -rowW, 0, z + railMid
		rotz -90
		nL = rowW
		gosub 830
		del 2
		add -rowW, -rowW, z + railMid
		nL = rowW
		gosub 830
		del 1
		add -rowW, -rowW, z
		cylind railTop, r_nuno
		del 1
	next il
endif

! ---- コマ（緊結部）: 布材・腕木のくさびを掛ける座。支柱に komaPitch ごとに付く ----
! 実寸はフランジ φ106 t6（bim-arekore 次世代足場.gsm の寸法。以前は φ110 t10 で厚く見えた）
! 根がらみのレベルに合わせて並べるので、布材・腕木は必ずコマの位置に付く。
! 枠組（komaPitch=0）には無い。梁枠で抜いた支柱の下には付けない
if nKz > 0 then
	resol 6
	x = 0
	for ip = 1 to nSpan + 1
		bBase = 0
		for ib = 1 to nBm
			if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
		next ib
		! 支柱だけ分解した部品の持つ支柱のコマは、分解した部材が描く（コマの付く支柱の下端で判定）
		ownX = 0
		if x >= gxA - 0.001 and x < gxB - 0.001 then ownX = 1
		for row = rowStart to 1
			! 隅の内側建地は隣の面が支柱もコマも描く
			if not((row = 0 or hugMode = 1) and ((ip = 1 and skipInS = 1) or (ip = nSpan + 1 and skipInE = 1))) and \
					not((ip = 1 and skipPS = 1) or (ip = nSpan + 1 and skipPE = 1)) and \
					x >= gxA - 0.1 and x <= gxB + 0.1 then
				for ik = 1 to nKz
					if kz[ik] > bBase + 0.001 and not(explodeMask > 0 and ownX = 1 and \
							kzSeg[ik] >= gzA - 0.001 and kzSeg[ik] < gzB - 0.001) then
						add x, -row * rowW, kz[ik] - 0.003
						cylind 0.006, 0.053
						del 1
					endif
				next ik
			endif
		next row
		if ip <= nSpan then x = x + spans[ip]
	next ip
	resol rN
endif

! ---- 水平材（根がらみ＋各作業層） ----
for il = 1 to nLv
	z = lv[il]
	! 単管抱き足場: 南北に走る面は布・手すりをクランプ1つ分上で留める（隅の建地で直交する面の管と交わらない）
	if hugMode = 1 then z = z + hugDz
	! 枠組の支柱だけ分解した部品: この高さの横架材の建枠（下端が範囲の高さ）は、建枠ごと分解した部材が描く
	frZ = 0
	if serType = "W" and explodeMask > 0 then
		zq = jackOut
		for j = 1 to nPost
			if abs(zq + posts[j] - z) < 0.05 and zq >= gzA - 0.001 and zq < gzB - 0.001 then frZ = 1
			zq = zq + posts[j]
		next j
	endif
	x = 0
	for ip = 1 to nSpan
		! 区切った部品の範囲の外のスパンは描かない（切り取られるので、描く手間だけ省く）
		if x + spans[ip] > gxA - 0.1 and x < gxB + 0.1 then
			! 開口部（梁枠より下）は支柱を抜いた通路。布材も手すりも入らない。
			! 立面は空けているのに3Dだけ通していた（根がらみが足元を横切っていた）
			skipH = 0
			for ib6 = 1 to nBm
				if x >= bmS[ib6] - 0.001 and x + spans[ip] <= bmS[ib6] + bmL[ib6] + 0.001 and \
						z < bmH[ib6] - 0.001 then skipH = 1
			next ib6
			! 単管抱き足場: 各層の床の高さに、建地を両側から抱く布を2本（その上に足場板）
			if skipH = 0 and il > 1 and hugMode = 1 then
				r_t = 0.0486 / 2
				for sd = 0 to 1
					! 規定の長さの単管の通し（継ぎは隣の布・上下の層とずらす）
					add x, -rowW + (2 * sd - 1) * tubeOff, z
					runX = x
					runP = 1 + (sd + il) - 2 * int((sd + il) / 2)
					nL = spans[ip]
					gosub 832
					runP = 0
					del 1
				next sd
				! 3連クランプ（日建 P3CR、カタログ p384）: 建地と両側の布2本を1個で抱く。建地ごと（終点の建地も）
				if isLite = 0 then
					clDy = tubeOff
					clR2 = r_t
					for ce = 0 to 1
						if ce = 0 or ip = nSpan then
							add x + ce * spans[ip], -rowW, z
							gosub 836
							del 1
						endif
					next ce
				endif
			endif
			! 内外の布材は根がらみだけ。作業床の高さにはスパン方向の布材を付けない（アンチは腕木に掛ける）
			if skipH = 0 and il = 1 then
				for row = rowStart to 1
					add x, -row * rowW, z
					nL = spans[ip]
					runX = x
					runP = 2 - row
					gosub 830
					runP = 0
					del 1
				next row
			endif
			! 荷受けステージの間口は設置層で外側の手すり・中桟を外す（荷を通す。
			! ステージ側の先端・妻側の手すりで防護）。数量も同じ区間を引いている
			inSg = 0
			for ig2 = 1 to nSg
				if x >= sgS[ig2] - 0.001 and x + spans[ip] <= sgS[ig2] + sgL[ig2] + 0.001 and \
						abs(z - sgH[ig2]) < 0.001 then inSg = 1
			next ig2
			! 昇降機の乗り込み口（位置を含むスパン・乗り込む層）は固定手すりの代わりに開閉式手すり
			for il4 = 1 to nLa
				if laP[il4] >= x - 0.001 and laP[il4] < x + spans[ip] - 0.001 and \
						abs(z - laH[il4]) < 0.001 then inSg = 2
			next il4
			! 張出しブラケットで床を広げた層・スパンは、建地位置の手すりは外し、新しい縁の手すりに任せる
			for ik3 = 1 to nBk
				if bkD[ik3] < 0 and x >= bkS[ik3] - 0.001 and x + spans[ip] <= bkE[ik3] + 0.001 and \
						abs(z - bkH[ik3]) < 0.001 then inSg = 1
			next ik3
			! 外付けの階段: 区間の両端のスパン（上り口・降り口）は、本体の外側の手すり・幅木を外して乗り移る
			if stOut = 1 then
				for it6 = 1 to nSt
					if abs(x - stS[it6]) < 0.001 or abs(x + spans[ip] - stS[it6] - stL[it6]) < 0.001 then inSg = 1
				next it6
			endif
			if il > 1 and skipH = 0 and inSg = 2 then
				! 開閉式手すり（枠: 両端の縦材＋手すり＋中桟。数量は「開閉式手すり」で拾う）
				add x + 0.05, -rowW, z + 0.10
				cylind railTop - 0.10, 0.015
				del 1
				add x + spans[ip] - 0.05, -rowW, z + 0.10
				cylind railTop - 0.10, 0.015
				del 1
				add x + 0.05, -rowW, z + railTop
				roty 90
				cylind spans[ip] - 0.10, 0.015
				del 2
				add x + 0.05, -rowW, z + railMid
				roty 90
				cylind spans[ip] - 0.10, 0.015
				del 2
			endif
			! 枠組の中間層は交差筋交＋幅木（＋上の建枠）で防護し、布材の手すり・中桟は
			! 最上層だけ（数量と同じ）。全層に描くと部材表に無い手すりが図に出る
			frMid = 0
			if serType = "W" and il < nLv then frMid = 1
			! 範囲を指定して外した部材（editList。数量表と同じ升目）: 外側手すり（ビット1）・内側手すり（ビット4）
			eoR = 0
			eoI = 0
			for ie = 1 to nEd
				if ip >= edA[ie] and ip <= edB[ie] and il - 1 >= edC[ie] and il - 1 <= edD[ie] then
					if bittest(edE[ie], 1) then eoR = 1
					if bittest(edE[ie], 4) then eoI = 1
				endif
			next ie
			! 足場の中の階段室: その層へ上がってくる階段・その層から上がる階段のスパンは、外側の手すり（上の段の布材）を
			! 付けず、中桟（下の段）だけ残す（階段手すり 2段が外側に沿う。利用者の指定 2026-10-24: 階段のところは布材不要、
			! 階段の1段目の布材だけある）。数量と同じセル
			stRl = 0
			if stOut = 0 and il > 1 then
				kk = il - 1
				for it7 = 1 to nSt
					if x >= stS[it7] - 0.001 and x + spans[ip] <= stS[it7] + stL[it7] + 0.001 then
						jj = 0
						if abs(x - stS[it7]) > 0.001 then jj = 1
						if jj <= 1 then
							ja = 0
							jb = 0
							if stL[it7] > spans[ip] + 0.001 then
								ja = 1 - (kk - 2 * int(kk / 2))
								jb = 1 - ((kk + 1) - 2 * int((kk + 1) / 2))
							endif
							if jj = ja then stRl = 1
							if kk < nLv - 1 and jj = jb then stRl = 1
						endif
					endif
				next it7
			endif
			! 外側手すり・中桟（作業層のみ）
			if il > 1 and skipH = 0 and inSg = 0 and frMid = 0 and eoR = 0 then
				if railAdv = 1 then
					! 先行手すり（日建 NDX18 等、カタログ p006）: 手すり φ27.2＋X形の斜材 φ21.7 が一体で、
					! 手すり・中桟・筋交を兼ねる。上の金具は手すりの高さのコマ、下の金具は床際のコマに掛ける
					add x, -rowW, z
					nL = spans[ip]
					gosub 850
					del 1
				else
					runX = x
					runP = 1 + il - 2 * int(il / 2)
					if stRl = 0 then
						add x, -rowW, z + railTop
						nL = spans[ip]
						gosub 830
						del 1
					endif
					add x, -rowW, z + railMid
					nL = spans[ip]
					runP = 3 - runP
					gosub 830
					runP = 0
					del 1
				endif
			endif
			! 躯体側（内側建地列）の手すり・中桟は布材で組む（先行手すりは外側だけ。
			! ステージの間口でも残る）。内ブラケットで床を拡幅した層・スパンは隙間が
			! 小さいので付けない（数量も同じセルを引いている）
			inBk = 0
			for ik2 = 1 to nBk
				if bkD[ik2] > 0 and x >= bkS[ik2] - 0.001 and x + spans[ip] <= bkE[ik2] + 0.001 and \
						abs(z - bkH[ik2]) < 0.001 then inBk = 1
			next ik2
			! 梁枠の網掛け部は前踏み側にも先行手すり筋交い（手すり・中桟の代わり。ミレニューム Q16）
			advIn = 0
			for iai = 1 to nAi
				if x >= aiS[iai] - 0.001 and x + spans[ip] <= aiE[iai] + 0.001 and z >= aiZ[iai] - 0.001 then advIn = 1
			next iai
			if il > 1 and skipH = 0 and nRows >= 2 and advIn = 1 then
				add x, 0, z
				nL = spans[ip]
				gosub 850
				del 1
			endif
			if il > 1 and skipH = 0 and railIn = 1 and nRows >= 2 and inBk = 0 and eoI = 0 and advIn = 0 then
				runX = x
				add x, 0, z + railTop
				nL = spans[ip]
				runP = 2 - il + 2 * int(il / 2)
				gosub 830
				del 1
				add x, 0, z + railMid
				nL = spans[ip]
				runP = 3 - runP
				gosub 830
				runP = 0
				del 1
			endif
			! 腕木（内外連結、-Y向き）。一側足場は内側建地が無いので入らない。
			! 開口部の内側は支柱を抜いてあるので、そこにも入らない
			noPost = 0
			for ib7 = 1 to nBm
				if x > bmS[ib7] + 0.001 and x < bmS[ib7] + bmL[ib7] - 0.001 and \
						z < bmH[ib7] - 0.001 then noPost = 1
			next ib7
			if frZ = 1 and x >= gxA - 0.001 and x < gxB - 0.001 then noPost = 1
			if noPost = 0 then
				if nRows >= 2 then
					add x, 0, z
					rotz -90
					if serType = "W" then
						! 枠組は建枠の横架材（脚に溶接。緊結部は無い）
						roty 90
						cylind rowW, r_nuno
						del 1
					else
						nL = rowW
						gosub 830
					endif
					del 2
					gosub 860
				else
					gosub 800
				endif
			endif
		endif
		x = x + spans[ip]
	next ip
	! 終端の腕木（一側足場は床受けブラケット）。区切った部品の範囲の外、枠組の分解した建枠は描かない
	noPost = 0
	if frZ = 1 and x >= gxA - 0.001 and x < gxB - 0.001 then noPost = 1
	if x > gxB + 0.1 then noPost = 1
	if noPost = 0 then
		if nRows >= 2 then
			add x, 0, z
			rotz -90
			if serType = "W" then
				! 枠組は建枠の横架材（脚に溶接。緊結部は無い）
				roty 90
				cylind rowW, r_nuno
				del 1
			else
				nL = rowW
				gosub 830
			endif
			del 2
			gosub 860
		else
			gosub 800
		endif
	endif
next il

! ---- 継ぎ足した脚の区間の根がらみ（敷地高低差。立面・数量と同じ規則） ----
if nGl >= 2 and footStep > 0.001 then
	x = 0
	for ip = 1 to nSpan
		inOpen = 0
		for ib8 = 1 to nBm
			if x >= bmS[ib8] - 0.001 and x + spans[ip] <= bmS[ib8] + bmL[ib8] + 0.001 then inOpen = 1
		next ib8
		! 列ごとに、その列の脚の下げ段数で（外側の列は外側の地盤 glListO）
		for row = rowStart to 1
			ma = 0
			mb = 0
			if row = 1 and nGlO >= 2 then
				if ip <= nGlO and ip <= nJkO then ma = round_int((jackOut - (glO[ip] + jkO[ip])) / footStep)
				if ip + 1 <= nGlO and ip + 1 <= nJkO then mb = round_int((jackOut - (glO[ip + 1] + jkO[ip + 1])) / footStep)
			else
				if ip <= nGl and ip <= nJk then ma = round_int((jackOut - (gl[ip] + jk[ip])) / footStep)
				if ip + 1 <= nGl and ip + 1 <= nJk then mb = round_int((jackOut - (gl[ip + 1] + jk[ip + 1])) / footStep)
			endif
			mlo = ma
			if mb < mlo then mlo = mb
			if mlo >= 1 and inOpen = 0 then
				add x, -row * rowW, lv[1] - mlo * footStep
				nL = spans[ip]
				gosub 830
				del 1
			endif
		next row
		x = x + spans[ip]
	next ip
endif

! ---- 踏板・幅木 ----
if showDeck then
	for il = 2 to nLv
		z = lv[il]
		x = 0
		for ip = 1 to nSpan
			! 区切った部品の範囲の外のスパンは描かない（切り取られるので、描く手間だけ省く）
			if x + spans[ip] > gxA - 0.1 and x < gxB + 0.1 then
				! 階段室は各層で階段が上がってくる1スパンだけ床を敷かない（奇数層は始点側、偶数層は終点側。
				! もう一方のスパンには床を敷く）。外側の幅木も付けない（載せる布板が無く宙に浮く。利用者の指摘 2026-10-22）。
				! 開口部（梁枠より下）は通路なので床も幅木も無い。数量もこの区別で拾っている
				skipDeck = 0
				for it4 = 1 to nSt
					! 外付け（stOut）の階段は外の升目に通すので、本体の床は切らない
					if stOut = 0 and x >= stS[it4] - 0.001 and x + spans[ip] <= stS[it4] + stL[it4] + 0.001 then
						if stL[it4] <= spans[ip] + 0.001 then
							skipDeck = 1
						else
							kOdd = il - 1 - 2 * int((il - 1) / 2)
							if abs(x - stS[it4]) < 0.001 then
								if kOdd = 1 then skipDeck = 1
							else
								if ip > 1 then
									if kOdd = 0 and abs(x - spans[ip - 1] - stS[it4]) < 0.001 then skipDeck = 1
								endif
							endif
						endif
					endif
				next it4
				stCut = skipDeck
				skipAll = 0
				for ib4 = 1 to nBm
					if x >= bmS[ib4] - 0.001 and x + spans[ip] <= bmS[ib4] + bmL[ib4] + 0.001 and \
							z < bmH[ib4] - 0.001 then skipAll = 1
				next ib4
				! 範囲を指定して外した部材（editList）: 踏板（ビット0）・幅木（ビット2）
				! 外側の踏板（ビット5）・内側の踏板（ビット6）だけ外して床を狭めることもできる（上の層だけ幅を変える）
				eoD = 0
				eoT = 0
				eoD1 = 0
				eoD2 = 0
				for ie = 1 to nEd
					if ip >= edA[ie] and ip <= edB[ie] and il - 1 >= edC[ie] and il - 1 <= edD[ie] then
						if bittest(edE[ie], 0) then eoD = 1
						if bittest(edE[ie], 2) then eoT = 1
						if bittest(edE[ie], 5) then eoD1 = 1
						if bittest(edE[ie], 6) then eoD2 = 1
					endif
				next ie
				! 足場の中の階段室の区間は、踏板の編集を効かせない（数量の member_edits と同じ。階段の床の扱いは層ごとに違う）
				for it4 = 1 to nSt
					if stOut = 0 and x >= stS[it4] - 0.001 and x + spans[ip] <= stS[it4] + stL[it4] + 0.001 then
						eoD = 0
						eoD1 = 0
						eoD2 = 0
					endif
				next it4
				! 階段を外側に寄せる床（幅914 の 500＋240 など。stHalf）は、階段が上がってくる層も内側の板（ハーフアンチ）を
				! 敷いて通れるようにする（外側の板だけ外す。利用者の指摘 2026-10-22: 階段外側に寄せて、上にハーフアンチいるよ）
				if skipDeck = 1 and stHalf = 1 and stOut = 0 then
					skipDeck = 0
					eoD1 = 1
				endif
				if eoD = 1 then skipDeck = 1
				if skipAll = 0 then
					if skipDeck = 0 then
						if matDeck > 0 then material matDeck
						! 布板（日建 アップロック式鋼製布板 NDN6 等、カタログ p007）: 長さ＝スパン。両端のつかみ金具で
						! 支柱位置の腕木（φ42.7）を掴み、腕木の上に載る。端のペロ板が腕木の上を覆う。
						! 以前は腕木の高さに埋まり、支柱芯から 70 離した板だけだった（利用者の指摘: 他の部材も見直して）
						if serType = "T" then
							! 単管の足場板（杉 厚28。日建カタログに品番なし）: 腕木・ブラケットの管の上に載せる。
							! 抱き足場は建地の真上（布2本の上）で、建地の間に1枚ずつ
							r_t = 0.0486 / 2
							if hugMode = 1 then
								! 単管抱き足場は布板を敷かない（抱き合わせた単管2本が床。利用者の指定 2026-10-22）
							else
								! 足場板は規定の長さで面に沿って敷き、継ぎは300重ねてブラケットの上に掛ける（利用者の指定
								! 2026-10-22）。板はこの区間で始まるもの（最初の区間は手前から出るものも）を1枚まるごと描く。
								! 重ねた側の板は1枚分（28）上に載る。色は鉄の色（踏板と同じ表面材。利用者の指定 2026-10-22: 黄色はやめて）
								if matDeck > 0 then material matDeck
								! 板の列（幅900で3列・1200で4列。奇数列は割付A、偶数列はB）
								for bw = 1 to max(2, deckN)
									bOk = (bw = 1 and eoD1 = 0) or (bw = 2 and deckW2 > 0 and eoD2 = 0) or (bw >= 3 and bw <= deckN)
									pb = 2 - bw + 2 * int(bw / 2)
									if bOk and nBd[pb] > 0 then
										bY = -rowW + 0.05
										bWd = deckW1 - 0.01
										if bw = 2 then
											bY = -rowW + 0.05 + deckW1 + 0.02
											bWd = deckW2 - 0.01
										endif
										if bw >= 3 then bY = -rowW + 0.05 + (bw - 1) * (deckW1 + 0.02)
										bs = bdS
										for kb = 1 to nBd[pb]
											if (bs >= x - 0.001 or ip = 1) and (bs < x + spans[ip] - 0.001 or ip = nSpan) and \
													not(ip > 1 and bs < x - 0.001) and not(ip < nSpan and bs >= x + spans[ip] - 0.001) then
												bRz = 0.028 * (kb - 2 * int(kb / 2) = 0)
												! 終点が出隅（単管の足場）: 最後の板は次の面のコーナーの板（1枚分上）のさらに上
												if kb = nBd[pb] and cornerE = 1 then bRz = 0.056
												add bs, bY, z + r_t + bRz
												block bdLen[pb][kb], bWd, 0.028
												del 1
											endif
											bs = bs + bdLen[pb][kb] - bdLap
										next kb
									endif
									if bOk and nBd[pb] = 0 then
										add x, bY, z + r_t
										block spans[ip], bWd, 0.028
										del 1
									endif
								next bw
							endif
						else
						if eoD1 = 0 then
							add x, -rowW + 0.05, z
							dkL = spans[ip]
							dkW = deckW1 - 0.01
							gosub 870
							del 1
						endif
						if deckW2 > 0 and eoD2 = 0 then
							add x, -rowW + 0.05 + deckW1 + 0.02, z
							dkL = spans[ip]
							dkW = deckW2 - 0.01
							gosub 870
							del 1
						endif
						endif
					endif
					! 幅木（外側）。先行手すり方式では付けない（落下物防止はメッシュシート等）。
					! 荷受けステージの間口は設置層で外す
					inSg = 0
					for ig3 = 1 to nSg
						if x >= sgS[ig3] - 0.001 and x + spans[ip] <= sgS[ig3] + sgL[ig3] + 0.001 and \
								abs(z - sgH[ig3]) < 0.001 then inSg = 1
					next ig3
					for il5 = 1 to nLa
						if laP[il5] >= x - 0.001 and laP[il5] < x + spans[ip] - 0.001 and \
								abs(z - laH[il5]) < 0.001 then inSg = 2
					next il5
					for ik4 = 1 to nBk
						if bkD[ik4] < 0 and x >= bkS[ik4] - 0.001 and x + spans[ip] <= bkE[ik4] + 0.001 and \
								abs(z - bkH[ik4]) < 0.001 then inSg = 1
					next ik4
					! 外付けの階段: 区間の両端のスパン（上り口・降り口）は、本体の外側の手すり・幅木を外して乗り移る
					if stOut = 1 then
						for it6 = 1 to nSt
							if abs(x - stS[it6]) < 0.001 or abs(x + spans[ip] - stS[it6] - stL[it6]) < 0.001 then inSg = 1
						next it6
					endif
					if stCut = 1 and serType <> "T" then inSg = 1
					if railAdv = 0 and toeOn = 1 and inSg = 0 and eoT = 0 then
						if mToe > 0 then material mToe
						! 幅木: 外側の支柱の内側で布板の上に立てる平らな板（高さ150、長さ＝スパン＋70）。L形（底140）にしない
						! （利用者の指定 2026-10-24: はばきL型にしないで）。以前は外側の支柱の外に板を立てていた
						if serType = "T" then
							! 単管は足場板を立てて幅木にする（高さ240）。抱き足場は足場板の外の縁。色は床の足場板と同じ鉄の色
							if hugMode = 0 then
								if matDeck > 0 then material matDeck
								! 単管抱き足場は幅木を付けない（利用者の指定 2026-10-22）
								if nBd[1] > 0 then
									! 幅木も規定の長さの足場板を通し、継ぎは300重ねる（利用者の指定 2026-10-22）。床の足場板と
									! 同じ割付で、重ねは建地の位置。重ねた側の板は1枚分（28）内側に立つ
									bs = bdS
									for kb = 1 to nBd[1]
										if (bs >= x - 0.001 or ip = 1) and (bs < x + spans[ip] - 0.001 or ip = nSpan) then
											add bs, -rowW + r_sic + 0.004 + 0.028 * (kb - 2 * int(kb / 2) = 0), z + 0.0243 + 0.028
											block bdLen[1][kb], 0.028, 0.24
											del 1
										endif
										bs = bs + bdLen[1][kb] - bdLap
									next kb
								else
									add x, -rowW + r_sic + 0.004, z + 0.0243 + 0.028
									block spans[ip], 0.028, 0.24
									del 1
								endif
							endif
						else
						add x - 0.035, -rowW + r_sic + 0.004, z + r_nuno + 0.045
						block spans[ip] + 0.07, 0.008, 0.150
						del 1
						endif
					endif
					if matScaf > 0 then material matScaf
					! 下さん: 幅木を付けないときの作業床の外側の桟（高さ15〜40cm。床から300に φ48.6。利用者の資料 2026-10-24:
					! 幅木を使用しない場合は下さんが必要）
					if railAdv = 0 and toeOn = 0 and shitaSan = 1 and inSg = 0 and eoT = 0 and hugMode = 0 then
						add x + r_sic, -rowW, z + 0.30
						roty 90
						cylind spans[ip] - 2 * r_sic, 0.0243
						del 2
					endif
				endif
			endif
			x = x + spans[ip]
		next ip
	next il
endif

! ---- ハッチ付布板（梯子内蔵。日建 NDN6TA）の昇降口: 階段室が入らない小さい足場（利用者の指摘 2026-10-24 の続き）----
! 外側の板（幅 deckW1）の位置で、各層の床にハッチの蓋（600×450）、その下に下の層まで梯子
if showDeck and nHt > 0 then
	define material "ashiba_hatch_alu" 2, 0.78, 0.80, 0.82
	for ih = 1 to nHt
		kq = htI[ih]
		if kq >= 1 and kq <= nSpan then
			hx0 = 0
			for iq = 1 to kq - 1
				hx0 = hx0 + spans[iq]
			next iq
			if hx0 >= gxA - 0.001 and hx0 < gxB - 0.001 then
				hxm = hx0 + spans[kq] / 2
				hym = -rowW + 0.05 + deckW1 / 2
				for il = 2 to nLv
					z = lv[il]
					zt = z + r_nuno + 0.045
					material "ashiba_hatch_alu"
					add hxm - 0.30, hym - 0.225, zt
					block 0.60, 0.45, 0.006
					del 1
					! 梯子（ハッチの下から下の層の床まで。踏ざん 300 ピッチ）
					zb = lv[il - 1] + r_nuno + 0.045
					if il = 2 then zb = 0
					for sr = -1 to 1 step 2
						add hxm - 0.20, hym + sr * 0.17, zb
						cylind zt - zb, 0.012
						del 1
					next sr
					zr = zb + 0.30
					while zr < zt - 0.05 do
						add hxm - 0.20, hym - 0.17, zr
						rotx -90
						cylind 0.34, 0.010
						del 2
						zr = zr + 0.30
					endwhile
				next il
				if matScaf > 0 then material matScaf
			endif
		endif
	next ih
endif

! ---- ブレス（外側構面、交さ2方向＝X） ----
! 設置間隔は bEvS スパン・bEvL 層ごと（1なら全構面）。数量拾いと
! 同じ間隔・同じ本数（1箇所2本）で描かないと、部材表と図面が食い違う
if showBrace then
	for il = 1 to nLv - 1
		if brOn[il] = 1 then
			z1 = lv[il]
			z2 = lv[il + 1]
			x = 0
			! 枠組は交差筋違を両面（外構面・内構面）に入れる（カタログ「筋違（両面）」。数量も両面）
			nbf = 0
			if serType = "W" then nbf = 1
			for ip = 1 to nSpan
				! 区切った部品の範囲の外のスパンは描かない（切り取られるので、描く手間だけ省く）
				if x + spans[ip] > gxA - 0.1 and x < gxB + 0.1 then
					! 範囲を指定して外した筋かい（editList ビット3。層 il の床の下の構面）
					eoB = 0
					for ie = 1 to nEd
						if ip >= edA[ie] and ip <= edB[ie] and il >= edC[ie] and il <= edD[ie] then
							if bittest(edE[ie], 3) then eoB = 1
						endif
					next ie
					if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 and eoB = 0 and serType <> "W" then
						! くさび式のブレース（日建 NDBR、カタログ p023）: φ42.7 の管の両端のクサビクランプで支柱を掴む。
						! 交さ2方向の2本は、このスパンに「／」、隣のスパンに「＼」（山形）。同じスパンに重ねて X にすると
						! 先行手すり（X の斜材）と見分けがつかなかった（利用者の指摘 2026-10-22: 1段目の端部が先行手すりに
						! なっている）。終点のスパンでは手前のスパンに「＼」。単管は同じ形の単管の筋かい
						brZ = 0.10
						for bf = 0 to 1
							yb2 = -rowW - r_sic - 0.0214 - 0.004 - bf * 0.046
							! 単管の筋かい（φ48.6）は布・手すりの単管（建地の脇 tubeOff）の外の面に通し、両端を自在クランプ
							! （日建 ARC2、金）で建地に留める（くさびのクサビクランプの塊は描かない）
							if serType = "T" then yb2 = -rowW - tubeOff - 0.0496 - bf * 0.0496
							xa = x
							sg = 1
							spb = spans[ip]
							if bf = 1 then
								if ip < nSpan then
									spb = spans[ip + 1]
									xa = x + spans[ip] + spb
								else
									xa = x
									if ip > 1 then spb = spans[ip - 1]
								endif
								sg = -1
							endif
							! 開口の通路（梁枠より下）に掛かる筋かいは描かない。建地を抜いてあり、通路へ飛び出していた
							! （利用者の指摘 2026-10-24: 1層目の両サイドに謎のブレス）。数量は隣の構面へ移す扱いで同じ
							bSkip = 0
							for ib9 = 1 to nBm
								if z1 < bmH[ib9] - 0.001 and min(max(xa, xa + sg * spb), bmS[ib9] + bmL[ib9]) - \
										max(min(xa, xa + sg * spb), bmS[ib9]) > 0.001 then bSkip = 1
							next ib9
							if bSkip = 0 then
							bl = sqr(spb ^ 2 + (z2 - z1 - 2 * brZ) ^ 2)
							ang = atn((z2 - z1 - 2 * brZ) / spb)
							rBr = 0.0427 / 2
							if serType = "T" then rBr = 0.0486 / 2
							add xa, yb2, z1 + brZ
							if sg < 0 then mulx -1
							roty 90 - ang
							cylind bl, rBr
							del 2
							if sg < 0 then del 1
							! クサビクランプ（下端は手前の支柱、上端は対角の支柱）。単管は自在クランプ（839）
							for ce = 0 to 1
								cx = xa
								cz = z1 + brZ
								if ce = 1 then
									cx = xa + sg * spb
									cz = z2 - brZ
								endif
								if serType = "T" then
									if isLite = 0 then gosub 839
								else
									add cx - 0.035, yb2 - 0.025, cz - 0.035
									block 0.070, -rowW - yb2 + 0.025 + r_sic, 0.070
									del 1
								endif
							next ce
							endif
						next bf
					endif
					bSkipW = 0
					for ib9 = 1 to nBm
						if z1 < bmH[ib9] - 0.001 and min(x + spans[ip], bmS[ib9] + bmL[ib9]) - max(x, bmS[ib9]) > 0.001 then bSkipW = 1
					next ib9
					if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 and eoB = 0 and serType = "W" and bSkipW = 0 then
						! 交差筋違（日建 A14 等、カタログ p081）: 平鋼2本を中央のピンで留めた X。両端の穴を建枠の脚の
						! 筋違ピン（ロックピン）に掛ける。ピンは建枠の上下から 0.24（1700枠で A寸法 1219）。以前は丸棒で
						! 建枠の天端から天端へ掛けていた
						bpz = 0.24
						if z2 - z1 < 0.9 then bpz = 0.10
						bA = z2 - z1 - 2 * bpz
						bl = sqr(spans[ip] ^ 2 + bA ^ 2)
						ang = atn(bA / spans[ip])
						for bf = 0 to nbf
							yb2 = -rowW - 0.035
							if bf = 1 then yb2 = 0.035
							for bd = 0 to 1
								add x + bd * spans[ip], yb2 + (1 - 2 * bf) * bd * 0.006, z1 + bpz
								if bd = 1 then mulx -1
								roty -ang
								add 0, -0.003, -0.0125
								block bl, 0.006, 0.025
								del 2
								if bd = 1 then del 1
								del 1
							next bd
							if isLite = 0 then
								! 中央のピンと、脚の筋違ピン（上下・両端）
								add x + spans[ip] / 2, yb2 - 0.012, z1 + bpz + bA / 2
								rotx -90
								cylind 0.03, 0.006
								del 2
								for pe = 0 to 3
									px = x
									if pe = 1 or pe = 3 then px = x + spans[ip]
									pz = z1 + bpz
									if pe >= 2 then pz = z2 - bpz
									yl0 = -rowW
									if bf = 1 then yl0 = 0
									add px, min(yl0, yb2) - 0.01, pz
									rotx -90
									cylind abs(yb2 - yl0) + 0.02, 0.007
									del 2
								next pe
							endif
						next bf
					endif
				endif
				x = x + spans[ip]
			next ip
		endif
	next il
endif

! ---- 壁つなぎ（内側建地から躯体側へ +Y 方向） ----
! 構造計算でも法規チェックでも見ているのに3Dに無く、躯体との
! 取り合いが確認できなかった
! 壁つなぎ用金具: 支柱側のクランプ（自在クランプ相当の塊）、伸縮する本体パイプ、
! 躯体側のアンカープレート（ボルトで躯体に固定する座）。棒1本だと取り合いが見えない
! 壁つなぎを別の部品（ashiba_tie）で置いたとき（tieObj）は、ここでは描かない（二重になる）
! 建地1列（一側・ブラケット足場）は建地が外側の列（-rowW）にあるので、そこから取る（線の上から描いて浮いていた。
! 利用者の指摘 2026-10-22: 壁繋ぎは単管支柱から取るように）
nTieDraw = nTiePair
if tieObj then nTieDraw = 0
yTie = 0
if nRows < 2 then yTie = -rowW
for it = 1 to nTieDraw
	add ties[it], yTie, tieH[it]
	rotx -90
	cylind standoff - yTie, r_tie
	del 2
	add ties[it] - 0.035, yTie - 0.035, tieH[it] - 0.035
	block 0.07, 0.07, 0.07
	del 1
	add ties[it] - 0.05, standoff - 0.012, tieH[it] - 0.05
	block 0.10, 0.012, 0.10
	del 1
	! 壁つなぎの記号 ◎ は3Dに持たせない（立面図は断面の注記として2Dで描く: elevation_sections.tie_marks）
next it

! ---- 荷受けステージ（外側へ張り出す床・手すり） ----
! 日建 荷取りブラケット NDBS15（カタログ p018）: 外側の支柱から張り出す腕 φ42.7 と、下の支柱から腕を支える方杖
! φ42.7、先端の手すり支柱。床は布板3枚敷き、腕どうしを先端と中ほどのつなぎ材でつなぐ。支柱補剛材 NDPSF
for ig = 1 to nSg
	! 布板（3枚。腕の上に載る）
	sgW3 = sgP[ig] / 3
	for ipk = 0 to 2
		add sgS[ig] + 0.025, -rowW - 0.03 - ipk * sgW3, sgH[ig] + r_nuno
		muly -1
		block sgL[ig] - 0.05, sgW3 - 0.01, 0.045
		del 2
	next ipk
	! つなぎ材（腕の先端と中ほど、腕どうしを結ぶ）
	for itn = 1 to 2
		add sgS[ig], -rowW - sgP[ig] * itn / 2, sgH[ig] - 0.05
		roty 90
		cylind sgL[ig], r_nuno
		del 2
	next itn
	! 手すり・中桟（張り出し先端）
	for ir = 1 to 2
		if ir = 1 then hgt = railH else hgt = midH
		add sgS[ig], -rowW - sgP[ig], sgH[ig] + hgt
		roty 90
		cylind sgL[ig], r_nuno
		del 2
	next ir
	! 妻側（左右）も開放端。前面だけ手すりを立てても横から落ちる
	for ie = 0 to 1
		xg = sgS[ig] + sgL[ig] * ie
		for ir = 1 to 2
			if ir = 1 then hgt = railH else hgt = midH
			add xg, -rowW, sgH[ig] + hgt
			rotx 90
			cylind sgP[ig], r_nuno
			del 2
		next ir
		! 妻側の幅木
		add xg, -rowW - sgP[ig], sgH[ig] + 0.05
		block 0.02, sgP[ig], 0.157
		del 1
	next ie
	! 先端の幅木
	add sgS[ig], -rowW - sgP[ig], sgH[ig] + 0.05
	block sgL[ig], 0.02, 0.157
	del 1
	! 侵入落下防止柵（利用者の指定 2026-10-24。GLOOBE の「荷受けステージと侵入落下防止柵」）: 先端・妻側の手すりの内側に
	! 金網の落下防止柵（荷が手すりの間から落ちない。1枚の幅 1.8 以下に割る）、足場側の間口にスパンごとの開閉式の侵入防止柵
	! （荷の取り込み中は閉めて人をステージへ出さない。閉めた形で描く）。高さ 1.8。数量 platforms.stage_fence_panels と同じ枚数
	if sgF[ig] = 1 then
		fH = 1.8
		zf = sgH[ig] + r_nuno + 0.045
		nfF = int(sgL[ig] / 1.8 - 0.001) + 1
		fW = sgL[ig] / nfF - 0.01
		for ifc = 1 to nfF
			add sgS[ig] + (ifc - 1) * (fW + 0.01) + 0.005, -rowW - sgP[ig] + 0.04, zf
			gosub 865
			del 1
		next ifc
		nfS = int(sgP[ig] / 1.8 - 0.001) + 1
		fW = (sgP[ig] - 0.04) / nfS - 0.01
		for ie = 0 to 1
			for ifc = 1 to nfS
				add sgS[ig] + 0.04 + ie * (sgL[ig] - 0.08), -rowW - 0.005 - (ifc - 1) * (fW + 0.01), zf
				rotz -90
				gosub 865
				del 2
			next ifc
		next ie
		xb = 0
		for ipb = 1 to nSpan
			if xb >= sgS[ig] - 0.001 and xb + spans[ipb] <= sgS[ig] + sgL[ig] + 0.001 then
				! 扉は足場の床の中へ開くので、1枚の幅は建地列の間隔−0.12 以下に割る（610 幅の足場で 1829 のスパンは4枚）
				nLf = int((spans[ipb] - 0.10) / (rowW - 0.12) - 0.001) + 1
				fW = (spans[ipb] - 0.10) / nLf - 0.01
				for ilf = 0 to nLf - 1
					add xb + 0.05 + ilf * (fW + 0.01), -rowW + 0.06, zf
					gosub 865
					del 1
				next ilf
			endif
			xb = xb + spans[ipb]
		next ipb
		if matScaf > 0 then material matScaf
	endif
	! 張出ブラケットと方杖。床だけ描くとステージが宙に浮いて見えるうえ、
	! 数量では建地位置ぶん拾っている（張出ブラケット・方杖）
	xb = 0
	for ipb = 1 to nSpan + 1
		if xb >= sgS[ig] - 0.001 and xb <= sgS[ig] + sgL[ig] + 0.001 then
			! 腕（支柱の緊結部から外へ）
			add xb, -rowW, sgH[ig]
			rotz -90
			nL = sgP[ig] + r_sic
			if isLite = 0 then
				add r_sic, -0.020, -0.040
				block 0.045, 0.040, 0.085
				del 1
			endif
			roty 90
			cylind sgP[ig], r_nuno
			del 3
			! 先端の手すり支柱（ブラケット先端の建地受けに立て、手すり・中桟を受ける。
			! 無いと手すりが宙に浮く。数量は「先端手すり支柱」）
			add xb, -rowW - sgP[ig], sgH[ig] - 0.12
			cylind railH + 0.22, r_sic
			del 1
			if sgZ[ig] > 0 then
				! 方杖（下の支柱 1.45 下から腕の先端寄り 0.85 へ）
				sgD = 1.45
				sgX = sgP[ig] * 0.85
				add xb, -rowW, sgH[ig] - sgD
				rotx atn(sgX / sgD)
				cylind sqr(sgX * sgX + sgD * sgD), r_nuno
				del 2
				if isLite = 0 then
					add xb - 0.025, -rowW - 0.05, sgH[ig] - sgD - 0.04
					block 0.05, 0.05, 0.08
					del 1
					! 支柱補剛材（支柱の両脇 118、床の1段上から 1350 下まで）
					for ihs = -1 to 1 step 2
						add xb + ihs * 0.118, -rowW, sgH[ig] - 1.35
						cylind 1.35, 0.017
						del 1
					next ihs
				endif
			endif
		endif
		if ipb <= nSpan then xb = xb + spans[ipb]
	next ipb
next ig

! ---- ロングスパンエレベーター（マスト＋搬器＋渡し板＋マスト控え） ----
! 詳細図と同じ取合い: 外側建地から隙間0.10mを空けて搬器（hoW×hoD、手すり枠高さ2.2m）、
! その外側に0.30角のラック付きマスト（0.5mごとの横材）。搬器は最下の乗り込み口の
! 高さに置く。以前は4隅の細い柱と床板だけでマストが無く、干渉確認に使えなかった
for ih = 1 to nHo
	hx = hoP[ih]
	hg = 0.10
	cy = -rowW - hg              ! 搬器の足場側端
	cyo = cy - hoD[ih]           ! 搬器の外側端
	myc = cyo - 0.15             ! マスト中心（y）
	mh = hoR[ih] + 1.0           ! マスト頂部（到達高さ＋余長）
	! マスト: 4隅の主材＋0.5mごとの横材
	for icx = -1 to 1 step 2
		for icy = -1 to 1 step 2
			add hx + 0.15 * icx, myc + 0.15 * icy, 0
			cylind mh, 0.02
			del 1
		next icy
	next icx
	nm3 = int(mh / 0.5)
	for im3 = 1 to nm3
		add hx - 0.15, myc - 0.165, im3 * 0.5 - 0.015
		block 0.30, 0.03, 0.03
		del 1
		add hx - 0.15, myc + 0.135, im3 * 0.5 - 0.015
		block 0.30, 0.03, 0.03
		del 1
		add hx - 0.165, myc - 0.15, im3 * 0.5 - 0.015
		block 0.03, 0.30, 0.03
		del 1
		add hx + 0.135, myc - 0.15, im3 * 0.5 - 0.015
		block 0.03, 0.30, 0.03
		del 1
	next im3
	! 搬器: 床＋4隅の枠柱＋上枠（4辺）＋中桟（外側・妻側。足場側は乗降口）
	cz = 0.20
	cz0 = 0
	for il3 = 1 to nLa
		if abs(laP[il3] - hx) < 0.001 then
			if cz0 = 0 or laH[il3] < cz0 then cz0 = laH[il3]
		endif
	next il3
	if cz0 > 0 then cz = cz0
	add hx - hoW[ih] / 2, cyo, cz
	block hoW[ih], hoD[ih], 0.05
	del 1
	for icx = 0 to 1
		for icy = 0 to 1
			add hx - hoW[ih] / 2 + hoW[ih] * icx, cyo + hoD[ih] * icy, cz
			cylind 2.2, 0.02
			del 1
		next icy
	next icx
	for icy = 0 to 1
		add hx - hoW[ih] / 2, cyo + hoD[ih] * icy, cz + 2.2
		roty 90
		cylind hoW[ih], 0.015
		del 2
	next icy
	for icx = 0 to 1
		add hx - hoW[ih] / 2 + hoW[ih] * icx, cyo, cz + 2.2
		rotx -90
		cylind hoD[ih], 0.015
		del 2
		add hx - hoW[ih] / 2 + hoW[ih] * icx, cyo, cz + 1.1
		rotx -90
		cylind hoD[ih], 0.015
		del 2
	next icx
	add hx - hoW[ih] / 2, cyo, cz + 1.1
	roty 90
	cylind hoW[ih], 0.015
	del 2
	! 各乗り込み口: 渡し板（搬器の床から作業床へ、隙間を塞ぐ）
	for il3 = 1 to nLa
		if abs(laP[il3] - hx) < 0.001 then
			add hx - hoW[ih] / 2, cy - 0.10, laH[il3] + 0.045
			block hoW[ih], hg + 0.25, 0.03
			del 1
		endif
	next il3
	! マスト控え（控えピッチごとにマストから足場の外側建地へ。足場側は壁つなぎで躯体へ）
	tp3 = hoTp[ih]
	if tp3 < 0.5 then tp3 = 3.6
	nt3 = int(hoR[ih] / tp3)
	for it3 = 1 to nt3
		add hx, myc + 0.15, it3 * tp3
		rotx -90
		cylind -rowW - myc - 0.15, r_tie
		del 2
	next it3
next ih

! ---- 梁枠（開口部）: 上下弦材・束材・斜材・両端の緊結部・ホゾ、梁渡し、補強のつなぎ材 ----
! 日建 梁枠 NDH36（2スパン）・NDH54（3スパン）・NDH72（4スパン）、カタログ p010–011 の図: せい 370、上下弦材 φ42.7、
! 下弦材は上弦材より1区画ずつ短く両端がすぼまる（端の斜材が上弦材の端の緊結部へ上がる）、ワーレンの斜材 φ27.2（1スパン
! 4区画）、1829 ごとの束材と、その上の上弦材に上の建地を受けるホゾ。上弦材の両端の緊結部を作業床の1段下のコマ（bmDrop）に
! 掛ける。梁枠の上の建地は内外の梁枠に渡した梁渡し（NDHW）のほぞに立ち、コマが両隣と同じ床の高さに来る。
! 補強のつなぎ材（カタログ「梁枠の両サイドには、つなぎ材（補強）」、組立の標準例の図）: 梁枠の高さで開口の両隣のスパンに、
! 床の高さで開口の上（梁枠の上の建地の間）に、内外とも入れる。両端の建地を上下2段で押さえる（利用者の指定 2026-10-24:
! 梁枠の詳細上げて／つなぎ材も数量に入れて、モデルもこのようにして）
for ib2 = 1 to nBm
	bs = bmS[ib2]
	bl = bmL[ib2]
	bh = bmH[ib2]
	bzt = bh - bmDrop
	bzb = bzt - bmDep
	bx0 = bs + r_sic + 0.05
	bLn = bl - 2 * (r_sic + 0.05)
	nPn2 = max(1, int(bl / 1.829 + 0.5))
	nDg = max(2, 4 * nPn2)
	dgW = bLn / nDg
	for row2 = rowStart to 1
		yb3 = -row2 * rowW
		! 上弦材（通し）と下弦材（両端の1区画ずつ短い）
		add bx0, yb3, bzt
		roty 90
		cylind bLn, r_nuno
		del 2
		add bx0 + dgW, yb3, bzb
		roty 90
		cylind bLn - 2 * dgW, r_nuno
		del 2
		if isLite = 0 then
			for be = 0 to 1
				xe = bs + be * bl
				sgE = 1 - 2 * be
				! 上弦材の端の緊結部（コマを上下から挟む受け）とクサビ
				add xe + sgE * r_sic - (1 - sgE) / 2 * 0.05, yb3 - 0.021, bzt - 0.04
				block 0.05, 0.042, 0.08
				del 1
				add xe + sgE * (r_sic + 0.025), yb3, bzt + 0.04
				cylind 0.05, 0.006
				del 1
			next be
		endif
		! 束材と、その上の上弦材のホゾ（上の建地を受ける。1829 ごと）
		for iv = 1 to nPn2 - 1
			xv = bx0 + iv * bLn / nPn2
			add xv, yb3, bzb
			cylind bmDep, 0.0136
			del 1
			if isLite = 0 then
				add xv, yb3, bzt + r_nuno
				cylind 0.12, r_sic - 0.006
				del 1
			endif
		next iv
		! 斜材（ワーレン。1スパンを4区画）。両端の区画は上弦材の端から下弦材の端へ下りる
		for id2 = 0 to nDg - 1
			x1 = bx0 + id2 * dgW
			! 偶数の区画は上弦材から下弦材へ下り、奇数の区画は上がる（両端の区画が上弦材の端の緊結部に付く）
			z1d = bzt
			z2d = bzb
			if id2 - 2 * int(id2 / 2) = 1 then
				z1d = bzb
				z2d = bzt
			endif
			dgL = sqr(dgW * dgW + bmDep * bmDep)
			add x1, yb3, z1d
			roty 90 - atn((z2d - z1d) / dgW)
			cylind dgL, 0.0136
			del 2
			if isLite = 0 and id2 > 0 then
				add x1 - 0.03, yb3 - 0.0025, z1d - 0.02
				block 0.06, 0.005, 0.04
				del 1
			endif
		next id2
	next row2
	! 梁渡し（NDHW）: 梁枠の上の建地ごとに、内外の上弦材の上に渡す溝形の材と、建地を受けるほぞ
	if nRows >= 2 and hugMode = 0 then
		xq = 0
		for iq = 1 to nSpan + 1
			if xq > bs + 0.001 and xq < bs + bl - 0.001 then
				add xq - 0.03, -rowW - 0.04, bzt + r_nuno
				block 0.06, rowW + 0.08, 0.05
				del 1
				for row3 = 0 to 1
					add xq, -row3 * rowW, bzt + r_nuno + 0.05
					cylind 0.10, r_sic - 0.006
					del 1
				next row3
			endif
			if iq <= nSpan then xq = xq + spans[iq]
		next iq
	endif
	! 妻面のブレス材と妻面幅木（日建 カタログ p010「ブレス材（先行手すり）は梁枠下の妻面全段に取付る事」「ブレス材（先行
	! 手すり）の下には妻面幅木を取付る事」。利用者の指定 2026-10-24）: 開口の両端の建地の内外をつなぐ面に、梁枠より下の各段
	! （根がらみの段と作業床の段）の先行手すりを入れ、作業床の段はその下（両隣の床の縁）に幅木を立てる
	if nRows >= 2 and hugMode = 0 and serType <> "W" and serType <> "T" then
		for be = 0 to 1
			xe = bs + be * bl
			for il8 = 1 to nLv
				z8 = lv[il8]
				if z8 < bh - 0.001 then
					add xe, 0, z8
					rotz -90
					nL = rowW
					gosub 850
					del 2
					if il8 > 1 then
						if mToe > 0 then material mToe
						add xe - 0.03 + be * 0.048, -rowW + r_sic, z8 + r_nuno + 0.045
						block 0.012, rowW - 2 * r_sic, 0.157
						del 1
						if matScaf > 0 then material matScaf
					endif
				endif
			next il8
		next be
	endif
	! 補強のつなぎ材: 梁枠の高さで両隣のスパン、床の高さで開口の上のスパン（内外）
	xq = 0
	for iq = 1 to nSpan
		zTn = -1
		if abs(xq + spans[iq] - bs) < 0.001 or abs(xq - bs - bl) < 0.001 then zTn = bzt
		if xq >= bs - 0.001 and xq + spans[iq] <= bs + bl + 0.001 then zTn = bh
		if zTn >= 0 then
			for row3 = rowStart to 1
				add xq, -row3 * rowW, zTn
				nL = spans[iq]
				gosub 830
				del 1
			next row3
		endif
		xq = xq + spans[iq]
	next iq
next ib2

! ---- 階段室（段板・側桁・階段手すり） ----
! 同じ向き（始点→終点）で2層ずつ登る: 2スパンの階段室なら奇数層は始点側、偶数層は終点側のスパンに
! 1スパン分の階段（階段枠 1829×H1800 と同じ形）。2層登ったら外の作業床を回って始点側へ戻る。
! 以前は折り返し（踏面1スパン＋踊り場1スパン、層ごとに向きが逆）で描いていた
stairW = rowW - 0.10
! 階段を通す升目の外側の線（外付けは外側建地列の外の升目）
yb = -rowW - stOut * rowW
for it5 = 1 to nSt
	sx = stS[it5]
	sl = stL[it5]
	! 外付けの区間は 上り口＋階段2スパン＋降り口。階段は両端のスパンを除いた中に掛ける
	if stOut = 1 then
		xa = 0
		fFirst = 0
		fLast = 0
		for ipx = 1 to nSpan
			if abs(xa - sx) < 0.001 then fFirst = spans[ipx]
			if abs(xa + spans[ipx] - sx - sl) < 0.001 then fLast = spans[ipx]
			xa = xa + spans[ipx]
		next ipx
		if sl - fFirst - fLast > 0.5 then
			sx = sx + fFirst
			sl = sl - fFirst - fLast
		endif
	endif
	for il5 = 1 to nLv - 1
		rise = lv[il5 + 1] - lv[il5]
		! 階段室のスパン（1つ目＝始点側、2つ目＝終点側。1スパンの階段室は2つ目なし）
		stA = sl
		stB = 0
		xa = 0
		for ipx = 1 to nSpan
			if abs(xa - sx) < 0.001 then
				stA = spans[ipx]
				if ipx < nSpan then
					if xa + spans[ipx] + spans[ipx + 1] <= sx + sl + 0.001 then stB = spans[ipx + 1]
				endif
			endif
			xa = xa + spans[ipx]
		next ipx
		! 同じ向き（始点→終点）で2層ずつ: 奇数層は始点側のスパン、偶数層は終点側のスパンに1スパン分の階段。
		! 2層登ったら階段室を出て外の作業床を回って戻る（階段室の中に踊り場の床は無い）
		x0 = sx
		fl = stA
		if il5 - 2 * int(il5 / 2) = 0 and stB > 0 then
			x0 = sx + stA
			fl = stB
		endif
		nStep = int(rise / 0.225 + 0.5)
		if nStep < 1 then nStep = 1
		td = fl / nStep
		th = rise / nStep
		ang5 = atn(rise / fl)
		fLen = sqr(fl * fl + rise * rise)
		! アルミ階段枠（日建 NDAL4518K・信和 AL3055SW: 長さ1829×高さ1800、外幅481・内幅470）。
		! 両側の側桁（アルミの溝形、せい100）の間に踏面（縞板、奥行150）を並べ、上下端のフック（横棒）で
		! 下の層と上の層の腕木に掛ける。最上段は上の層の床。以前は板を階段状に並べただけだった（利用者の指摘 2026-10-20）
		fw = 0.481
		if fw > rowW - 0.06 then fw = rowW - 0.06
		fy0 = yb + (rowW - fw) / 2
		! 外側の板の位置に寄せる（内側の板＝ハーフアンチは各層に敷く）
		if stHalf = 1 and stOut = 0 then fy0 = -rowW + 0.05 + (deckW1 - 0.01 - fw) / 2
		for sd = 0 to 1
			add x0, fy0 + sd * (fw - 0.006), lv[il5] - 0.06
			roty -ang5
			block fLen, 0.006, 0.10
			del 2
		next sd
		for is5 = 1 to nStep - 1
			add x0 + is5 * td - 0.075, fy0 + 0.006, lv[il5] + is5 * th - 0.03
			block 0.15, fw - 0.012, 0.03
			del 1
		next is5
		! 階段受け（日建 NDKH、カタログ p010）: 上下端の支柱の間（内外の建地列）に渡す受け材。両端のフックで
		! 支柱のコマに掛け、階段枠の上下端のフックをこれに掛ける。以前は階段枠の幅だけの細い棒だった
		for hk = 0 to 1
			add x0 + hk * fl, yb + r_sic, lv[il5 + hk] - 0.05
			rotx -90
			cylind rowW - 2 * r_sic, 0.017
			del 2
			for he = 0 to 1
				add x0 + hk * fl - 0.02, yb + r_sic + he * (rowW - 2 * r_sic - 0.04), lv[il5 + hk] - 0.07
				block 0.04, 0.04, 0.10
				del 1
			next he
		next hk
		! 階段手すり（日建 ND1800専用階段手摺 NDKT φ21.7、カタログ p010）: 階段側の建地列（本体の中の階段は外側の列
		! だけ。もう一方は開口部手摺。外付けは両側）で、下の支柱の床から 1350 の高さ（固定クサビ）から上の支柱の
		! 上の床から 1350（固定爪）へ、階段と平行に渡す。手すり用の支柱は立てない
		! （利用者の指摘 2026-10-22: 階段手すりは今より450上、階段側だけでいい。以前は両側の 900 だった）。
		! 最上層へ上がる階段は、上端の支柱が床から 900（コマ2つ）までしか無いので 1350 では支柱の上に浮く。
		! 支柱のある高さ（コマ1つ下）に下げる（利用者の指摘 2026-10-22: 手すり浮いてる）
		! 手すりは 2 段（手すりと中桟）を階段と平行に（利用者の指定 2026-10-24: 足場の手すりはこのかたち 2段）。
		! 高さは床の手すり・中桟と同じ（段鼻の線から 900・450。利用者の指定 2026-10-24: 高さを下げる。以前は 1350・900）
		for sd = 0 to stOut
			ys = yb + r_sic + 0.03 + sd * (rowW - 2 * r_sic - 0.06)
			for tk = 0 to 1
				hT = railTop
				if tk = 1 then hT = railMid
				add x0 + r_sic, ys, lv[il5] + hT
				roty 90 - atn(rise / (fl - 2 * r_sic))
				cylind sqr((fl - 2 * r_sic) ^ 2 + rise ^ 2), 0.0217 / 2
				del 2
				add x0 + r_sic, ys - 0.02, lv[il5] + hT - 0.03
				block 0.04, 0.04, 0.06
				del 1
				add x0 + fl - r_sic - 0.04, ys - 0.02, lv[il5 + 1] + hT - 0.03
				block 0.04, 0.04, 0.06
				del 1
			next tk
		next sd
		! 上の層の開口（x0〜x0+fl）。床と開口の境の線: 階段を外側に寄せる床（stHalf）は外側の板とハーフアンチの間、
		! 全幅の開口は内側の建地列の内
		zg = lv[il5 + 1]
		gyS = -r_sic - 0.03
		if stHalf = 1 then gyS = -rowW + 0.05 + deckW1 - 0.005
		! 外付けは開口と本体の床の間を本体の外側の手すりで仕切るので、開口部手摺・幅木は付けない
		if stOut = 0 then
		! 階段開口部手摺（日建 SG918SW・信和 SG918SW、長さ1829・高さ922、カタログ p010）と階段開口部幅木（NFG918）:
		! 出入口1か所に1組（数量と同じ）。開口の長手に沿って、上がり口側（x0）の端は支柱にフックで掛け、上り切る側
		! （x0+fl）の端は曲げて階段枠の上端へ下ろす。以前は上がり口に床幅いっぱいの枠を横に立てていた（利用者の指摘 2026-10-22）
		gR = 0.0272 / 2
		gx0 = x0 + r_sic + 0.03
		gx1 = x0 + fl - 0.06
		gRb = 0.10
		gzT = zg + 0.922
		add gx0, gyS, gzT
		roty 90
		cylind gx1 - gRb - gx0, gR
		del 2
		add gx0, gyS, zg + 0.46
		roty 90
		cylind gx1 - gx0, gR
		del 2
		! 上がり口側の角の縦管（床から上桟まで）。上桟・中桟はここで直角に折れて開口の端を横切り、外側の建地に
		! フックで掛かる（開口のまわりを回す。利用者の指摘 2026-10-22: 端にも手すりいるよ、繋がっている／
		! 2026-10-24: 階段開口部手すりが回ってない）。幅木は付けない（2026-10-24: 階段上の幅木不要）
		add gx0, gyS, zg + 0.03
		cylind gzT - zg - 0.03, gR
		del 1
		gyO = -rowW + r_sic + 0.005
		for gk = 0 to 1
			gzk = gzT - gk * (gzT - zg - 0.46)
			add gx0, gyS, gzk
			sphere gR
			rotx 90
			cylind gyS - gyO - 0.02, gR
			del 2
			add gx0 - 0.02, gyO - 0.005, gzk - 0.02
			block 0.04, 0.03, 0.04
			del 1
		next gk
		! 上り切る側: 上桟を半径100で曲げて下ろし、床を抜けて階段枠の上端まで
		gcx = gx1 - gRb
		gcz = gzT - gRb
		for gb = 0 to 2
			ga0 = 90 - gb * 30
			ga1 = ga0 - 30
			gxa = gcx + gRb * cos(ga0)
			gza = gcz + gRb * sin(ga0)
			gdx = gcx + gRb * cos(ga1) - gxa
			gdz = gcz + gRb * sin(ga1) - gza
			add gxa, gyS, gza
			roty 180 + atn(gdx / gdz)
			cylind sqr(gdx * gdx + gdz * gdz), gR
			del 2
		next gb
		add gx1, gyS, zg - 0.10
		cylind gcz - zg + 0.10, gR
		del 1
		! 開口部幅木は付けない（利用者の指定 2026-10-24: 階段上の幅木と布材不要）
		endif
	next il5
next it5

! ---- 外付けの階段室: 外側建地列の外に建地1列（3列目）、区間は 上り口＋階段2スパン＋降り口 ----
! 利用者の指摘（2026-10-20）: 階段は回れるように4スパン要る。上り口と降り口に横のスパンが必要。
! 両端のスパンは各層に床（乗り降りの踊り場）、中の2スパンは各層で下から階段が上がってくるスパン以外に床。
! 階段の開口と本体の床の間は本体の外側の手すり（開口のスパンでは外さない）で仕切るので、開口部手摺・幅木は付けない
dim tsp[]
if stOut = 1 then
	yo = -2 * rowW
	for it7 = 1 to nSt
		sx = stS[it7]
		sl = stL[it7]
		xa = 0
		ns7 = 0
		for ipx = 1 to nSpan
			if xa >= sx - 0.001 and xa < sx + sl - 0.001 then
				ns7 = ns7 + 1
				tsp[ns7] = spans[ipx]
			endif
			xa = xa + spans[ipx]
		next ipx
		! 建地（3列目）と各層の腕木（外側建地列〜3列目）。本体の支柱と同じ積み上げ・継手・コマで描く
		! （1本の棒で描いてコマが無かった。利用者の指摘 2026-10-21）
		xp = sx
		for ip7 = 1 to ns7 + 1
			gv = 0
			jo = jackOut
			sv = shimAll
			add xp, yo, gv
			jkSill = 1
			gosub 820
			jkSill = 0
			addz jo
			for j = 1 to nPost
				cylind posts[j], r_sic
				if postShape = 1 and isLite = 0 then
					add -0.0275, -0.003, 0
					block 0.055, 0.006, posts[j]
					del 1
					add -0.003, -0.0275, 0
					block 0.006, 0.055, posts[j]
					del 1
				endif
				addz posts[j]
				if j < nPost then
					jLo = posts[j]
					jUp = posts[j + 1]
					gosub 840
				endif
			next j
			del nPost + 2
			if nKz > 0 then
				resol 6
				for ik = 1 to nKz
					add xp, yo, kz[ik] - 0.003
					cylind 0.006, 0.053
					del 1
				next ik
				resol rN
			endif
			for il7 = 1 to nLv
				add xp, -rowW, lv[il7]
				rotz -90
				nL = rowW
				gosub 830
				del 2
			next il7
			if ip7 <= ns7 then xp = xp + tsp[ip7]
		next ip7
		! 3列目のスパン方向: 根がらみ、各層の手すり・中桟（先行手すりなら手すり＋X斜材）・幅木、床
		xp = sx
		for ip7 = 1 to ns7
			sp7 = tsp[ip7]
			add xp, yo, lv[1]
			nL = sp7
			gosub 830
			del 1
			for il7 = 2 to nLv
				z = lv[il7]
				add xp, yo, z + railTop
				nL = sp7
				gosub 830
				del 1
				if railAdv = 1 then
					advDz = railTop - 0.02
					advL = sqr(sp7 * sp7 + advDz * advDz)
					add xp, yo, z + railTop
					roty 90 + atn(advDz / sp7)
					cylind advL, 0.0217 / 2
					del 2
					add xp + sp7, yo, z + railTop
					roty -(90 + atn(advDz / sp7))
					cylind advL, 0.0217 / 2
					del 2
				else
					add xp, yo, z + railMid
					nL = sp7
					gosub 830
					del 1
					if toeOn = 1 then
						if mToe > 0 then material mToe
						add xp, yo - 0.02, z + 0.045
						block sp7, 0.02, 0.157
						del 1
						if matScaf > 0 then material matScaf
					endif
				endif
				! 床: 両端（上り口・降り口）は各層。中の階段のスパンは、下から階段が上がってくるスパン
				! （奇数層は中の1つ目、偶数層は中の2つ目）以外
				kOdd7 = il7 - 1 - 2 * int((il7 - 1) / 2)
				fIdx = 2
				if kOdd7 = 0 and ns7 > 3 then fIdx = 3
				if ns7 < 3 then fIdx = 1
				if showDeck and ip7 <> fIdx then
					if matDeck > 0 then material matDeck
					add xp + 0.07, yo + 0.05, z
					block sp7 - 0.14, rowW - 0.10, 0.045
					del 1
					if matScaf > 0 then material matScaf
				endif
			next il7
			xp = xp + sp7
		next ip7
		! 妻側（区間の両端）の手すり・中桟
		for ie7 = 0 to 1
			xe = sx + ie7 * sl
			for il7 = 2 to nLv
				add xe, -rowW, lv[il7] + railTop
				rotz -90
				nL = rowW
				gosub 830
				del 2
				add xe, -rowW, lv[il7] + railMid
				rotz -90
				nL = rowW
				gosub 830
				del 2
			next il7
		next ie7
	next it7
endif

! ---- ブラケット区間（拡幅ぶんの作業床＋支柱位置ごとのブラケット腕・方杖） ----
! 床だけ描くと宙に浮いて見えるうえ、数量では支柱位置ごとにブラケットを拾っている
for ik = 1 to nBk
	xb = 0
	for ipk = 1 to nSpan + 1
		if xb >= bkS[ik] - 0.001 and xb <= bkE[ik] + 0.001 then
			! ブラケット（日建 NDBK03C・06C・03H・06H、カタログ p014）: 支柱のコマに緊結部で掛ける腕 φ42.7、
			! 先端の受け、下の支柱から腕の先へ方杖（腕の長さで 209・253・450・900 下から）
			bkDr = 1
			bkY0 = 0
			if bkD[ik] < 0 then
				bkDr = -1
				bkY0 = -rowW
			endif
			add xb, bkY0, bkH[ik]
			if bkDr < 0 then rotz 180
			rotz 90
			nL = bkW[ik] + r_sic
			bkArm = bkW[ik]
			gosub 875
			if bkDr < 0 then del 1
			del 2
		endif
		if ipk <= nSpan then xb = xb + spans[ipk]
	next ipk
	if bkD[ik] > 0 then
		add bkS[ik], 0, bkH[ik] + r_nuno
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 1
	else
		add bkS[ik], -rowW, bkH[ik] + r_nuno
		muly -1
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 2
		! 張出すと作業床の外縁が建地より外に出る。その縁は開放端なので
		! 手すり・中桟・幅木が要る（数量にも計上している）
		bkLen = bkE[ik] - bkS[ik]
		! 外縁の幅木（平らな板。L形にしない）と手すり・中桟（φ42.7）
		if toeOn = 1 then
			if mToe > 0 then material mToe
			add bkS[ik], -rowW - bkW[ik] + 0.004, bkH[ik] + r_nuno + 0.045
			block bkLen, 0.008, 0.150
			del 1
			if matScaf > 0 then material matScaf
		endif
		for ir3 = 1 to 2
			hgt = railH
			if ir3 = 2 then hgt = midH
			add bkS[ik], -rowW - bkW[ik] - 0.02, bkH[ik] + hgt
			roty 90
			cylind bkLen, r_nuno
			del 2
		next ir3
		! 妻側（両端）も開放端。手すり・中桟・幅木（数量の「張出し妻側」と同じ）
		for ie2 = 0 to 1
			xk = bkS[ik] + bkLen * ie2
			for ir2 = 1 to 2
				if ir2 = 1 then hgt = railH else hgt = midH
				add xk, -rowW, bkH[ik] + hgt
				rotx 90
				cylind bkW[ik], r_nuno
				del 2
			next ir2
			if railAdv = 0 and toeOn = 1 then
				add xk - 0.01, -rowW - bkW[ik], bkH[ik] + 0.045
				block 0.02, bkW[ik], 0.157
				del 1
			endif
		next ie2
	endif
next ik

! ---- 朝顔（防護棚）: 外側へ突出する傾斜板と受けブラケット ----
! 万能板の色（FRP の空色）を material で替えるので、本体の最後に描く（後に描く部材に色が移らないように。
! 表面材 matScaf が 0 の部品では戻す材質が無い）
! 突出2m・傾斜25度。数量にも法規チェックにも出るのに図面・3Dに
! 現れていなかった。突出2mの部材なので干渉確認のため実寸で出す
! 外側は -Y なので muly -1 でローカル+Yを外向きにしてから傾ける。
! そのまま block を置くと躯体側（+Y）へ張り出してしまう
! 昇降機のマスト・搬器が通る区間（asaCutList）は切り欠く（asgA〜asgB の連続区間だけ描く）
! アルミ軽量アサガオ（日建 ALA、カタログ p120〜125。利用者の指摘 2026-10-21: カタログ見て直して）:
! 支柱ごとに 主材（せい80のアルミ。上の主材受金具から外へ asagaoAngle 上向き）と、1層下（floorH）の
! 主材受金具から主材を下から支える 斜材。主材の根元と先端に 万能板受（上・下）、その上に FRP万能板
! （幅310×長さ2350 の波板。1スパンに6枚）、スパンごとにフレ止め2本（X）。
! 外付けの階段室の区間は、階段室の外側（3列目）の支柱から張り出す（本体の外側の支柱から出すと階段室に
! 食い込む）。本体の朝顔との段差は妻側の板で塞ぐ。出隅はコーナー部（センター材＋扇形の FRP 万能板）で塞ぐ
define material "ashiba_frp" 0, 0.45, 0.70, 0.90, 0.6, 0.6, 0.1, 0.0, 5, 0, 1, 1, 1, 0, 0, 0, 0
asL = asagaoProj / cos(asagaoAngle)
asC = asL * cos(asagaoAngle)
asH = asL * sin(asagaoAngle)
asD = 0.32 * asL          ! 斜材が主材に取り付く位置（根元から。ALA の主材2510・斜材2253・高さ1.8 の三角形）
for ia = 1 to nAsa
	za = asa[ia]
	! 主材・斜材・主材受金具（支柱位置ごと。切り欠きの内側の支柱には付けない。外付けの階段室の区間は3列目）
	x = 0
	for ip = 1 to nSpan + 1
		inCut = 0
		for ic = 1 to nCut
			if x > cutS[ic] + 0.001 and x < cutE[ic] - 0.001 then inCut = 1
		next ic
		inTw = 0
		onTw = 0
		if stOut = 1 then
			for it8 = 1 to nSt
				if x > stS[it8] + 0.001 and x < stS[it8] + stL[it8] - 0.001 then inTw = 1
				if x > stS[it8] - 0.001 and x < stS[it8] + stL[it8] + 0.001 then onTw = 1
			next it8
		endif
		! 開口部（梁枠）の内側で支柱を抜いた位置は、斜材を受ける下の主材受金具の支柱が無い（主材も付けない）
		for ib9 = 1 to nBm
			if x > bmS[ib9] + 0.001 and x < bmS[ib9] + bmL[ib9] - 0.001 and za - floorH < bmH[ib9] - 0.001 then inCut = 1
		next ib9
		if inCut = 0 then
			if inTw = 0 then
				ybA = -rowW
				gosub 880
			endif
			if onTw = 1 then
				ybA = -2 * rowW
				gosub 880
			endif
		endif
		! フレ止め（スパンごとに2本、主材の下で X）
		if isLite = 0 and ip <= nSpan then
			inCut2 = 0
			for ic = 1 to nCut
				if x + spans[ip] > cutS[ic] + 0.001 and x < cutE[ic] - 0.001 then inCut2 = 1
			next ic
			if inCut2 = 0 then
				ybA = -rowW
				if stOut = 1 then
					for it8 = 1 to nSt
						if x > stS[it8] - 0.001 and x + spans[ip] < stS[it8] + stL[it8] + 0.001 then ybA = -2 * rowW
					next it8
				endif
				spL = spans[ip]
				gosub 887
			endif
		endif
		if ip <= nSpan then x = x + spans[ip]
	next ip
	! 万能板（スパンの区間ごと、外付けの階段室の区間は3列目から）と万能板受・押え、段差の妻側の板
	for isg = 1 to nAsg
		pA = asgA[isg]
		while pA < asgB[isg] - 0.001 do
			ybA = -rowW
			pB = asgB[isg]
			if stOut = 1 then
				for it8 = 1 to nSt
					if pA > stS[it8] - 0.001 and pA < stS[it8] + stL[it8] - 0.001 then
						ybA = -2 * rowW
						pB = min(pB, stS[it8] + stL[it8])
					endif
				next it8
				if ybA > -1.5 * rowW then
					for it8 = 1 to nSt
						if stS[it8] > pA + 0.001 then pB = min(pB, stS[it8])
					next it8
				endif
			endif
			if pB <= pA + 0.001 then pB = asgB[isg]
			p0 = pA
			p1 = pB
			gosub 885
			! 段差（本体の外側の支柱と3列目）の妻側の板
			if pB < asgB[isg] - 0.001 or pA > asgA[isg] + 0.001 then
				material "ashiba_frp"
				for ie8 = 1 to 1
					bx = pB
					isStep = 0
					for it8 = 1 to nSt
						if stOut = 1 and (abs(bx - stS[it8]) < 0.001 or abs(bx - stS[it8] - stL[it8]) < 0.001) then isStep = 1
					next it8
					if isStep = 1 and bx > asgA[isg] + 0.001 and bx < asgB[isg] - 0.001 then
						plane 4, bx, -rowW - r_sic, za, bx, -rowW - r_sic - asC, za + asH, \
							bx, -2 * rowW - r_sic - asC, za + asH, bx, -2 * rowW - r_sic, za
					endif
				next ie8
				if matScaf > 0 then material matScaf
			endif
			pA = pB
		endwhile
	next isg
	! 出隅のコーナー部（始点側。外側コーナー支柱から斜め45°のセンター材と扇形の万能板）
	if (cornerS = 1 or cornerG = 1) and asaCrnOff = 0 then gosub 890
next ia

gosub 990
for ic9 = 1 to nClip
	cutend
next ic9
end

gosub 990
for ic9 = 1 to nClip
	cutend
next ic9
end

! ============================================================
990:	! ---- 区切る位置の印（赤い面）。区切り目は部品の範囲の中なので、範囲の箱の切り取りの中で描いてよい ----
if cutAtX > 0.0005 or cutAtZ > 0.0005 then
	define material "ashiba_cut" 0, 0.9, 0.1, 0.1, 0.5, 0.5, 0.1, 0.5, 5, 0, 1, 1, 1, 0, 0, 0, 0
	material "ashiba_cut"
	if cutAtX > 0.0005 then
		add pxA + cutAtX - 0.005, cyH, hzA
		block 0.01, rowW + 0.5, hzB - hzA
		del 1
	endif
	if cutAtZ > 0.0005 then
		add pxA - 0.25, cyH, hzA + cutAtZ - 0.005
		block pxB - pxA + 0.5, rowW + 0.5, 0.01
		del 1
	endif
endif
return

! ============================================================
820: ! ---- ジャッキベース（敷板＋ベース板＋ねじ棒＋ハンドル付きナット） ----
! 原点は脚の下端（地盤）。呼び出し側の変換は増減しない。
! 日建 カタログ（パイプジャッキベース ND752P・ジャッキベース A752。利用者の指定 2026-10-25: ジャッキベースの詳細どあげて）:
!   ベース板 140角 t6・取付穴 4-φ14（ピッチ 85）・中央の受け（高さ 38）、ねじ棒 φ35、ハンドル付きナット（羽根2枚）、
!   ナットの上は支柱の中へ 120。ND752P はベース板の底面が青（識別色）
! jo はジャッキ繰出し（敷板 sv と通しの敷板 sillT を含む）。通しの敷板は 3d の別の箇所で支柱の列に沿って敷く。
! 継ぎ足しの敷板（sv）は杉敷板300×210を重ね、ベース板とねじ棒はその上から（ねじ棒の長さは jo - sv - sillT）
jb0 = sillT
if sv > 0.001 then
	add -0.15, -0.105, jb0
	block 0.30, 0.21, sv
	del 1
endif
jb0 = jb0 + sv
jsL = jo - jb0
if jsL < 0.02 then jsL = 0.02
! 高低差のある地盤で、列の脚ごとの敷板が無い脚（出隅の外側・外付け階段の3列目）は、この脚だけ 1m の敷板を敷く
! （平らな地盤はこれらの脚も sillList の列に入っている）
if jkSill = 1 and sillT > 0.001 and nGl >= 2 then
	material "ashiba_sill_wood"
	add -0.50, -sillW / 2, 0
	block 1.0, sillW, sillT
	del 1
endif
material "ashiba_jack_steel"
if jkBlue = 1 then material "ashiba_jack_blue"
if isLite = 1 then
	add -0.07, -0.07, jb0
	block 0.14, 0.14, 0.006
	del 1
else
	! ベース板（穴4つ）
	addz jb0
	prism_ 41, 0.006,
		-0.07, -0.07, 15, 0.07, -0.07, 15, 0.07, 0.07, 15, -0.07, 0.07, 15, -0.07, -0.07, -1,
		-0.0355, -0.0425, 15, -0.0375, -0.0375, 15, -0.0425, -0.0355, 15, -0.0475, -0.0375, 15, -0.0495, -0.0425, 15, -0.0475, -0.0475, 15, -0.0425, -0.0495, 15, -0.0375, -0.0475, 15, -0.0355, -0.0425, -1,
		0.0495, -0.0425, 15, 0.0475, -0.0375, 15, 0.0425, -0.0355, 15, 0.0375, -0.0375, 15, 0.0355, -0.0425, 15, 0.0375, -0.0475, 15, 0.0425, -0.0495, 15, 0.0475, -0.0475, 15, 0.0495, -0.0425, -1,
		0.0495, 0.0425, 15, 0.0475, 0.0475, 15, 0.0425, 0.0495, 15, 0.0375, 0.0475, 15, 0.0355, 0.0425, 15, 0.0375, 0.0375, 15, 0.0425, 0.0355, 15, 0.0475, 0.0375, 15, 0.0495, 0.0425, -1,
		-0.0355, 0.0425, 15, -0.0375, 0.0475, 15, -0.0425, 0.0495, 15, -0.0475, 0.0475, 15, -0.0495, 0.0425, 15, -0.0475, 0.0375, 15, -0.0425, 0.0355, 15, -0.0375, 0.0375, 15, -0.0355, 0.0425, -1
	del 1
endif
material "ashiba_jack_steel"
! 中央の受け（ねじ棒の根元）
add 0, 0, jb0 + 0.006
cylind 0.032, 0.024
del 1
! ねじ棒 φ35（ナットの上は支柱の中へ 120）。ねじ山は細い輪を並べて見せる
add 0, 0, jb0 + 0.006
cylind jsL + 0.12 - 0.006, 0.035 / 2
del 1
if isLite = 0 then
	jzt = jb0 + 0.05
	while jzt < jb0 + jsL - 0.05 do
		add 0, 0, jzt
		cylind 0.004, 0.0185
		del 1
		jzt = jzt + 0.025
	endwhile
endif
! ハンドル付きナット（六角＋座金）と羽根2枚
add 0, 0, jb0 + jsL - 0.035
resol 6
cylind 0.035, 0.034
resol rN
addz 0.035
cylind 0.004, 0.040
del 1
if isLite = 0 then
	for hw = 0 to 1
		if hw = 1 then rotz 180
		add 0.030, -0.006, 0.010
		block 0.090, 0.012, 0.010
		del 1
		add 0.115, 0, 0.010
		cylind 0.028, 0.008
		del 1
		if hw = 1 then del 1
	next hw
endif
del 1
if matScaf > 0 then material matScaf
return

812:	! ---- 単管のブラケット: C付伸縮ブラケット フリー（日建リース TWL500F・TWL750F・TWL1000F、カタログ p108。
	! 利用者の指定 2026-10-22: ブラケットも詳細度あげて、規定としてカタログ見て）----
	! 建地の脇の縦材（束材 φ42.7、建地芯から 58.7）を、上のスーパークランプ（兼用。腕の上端から 128.5 下、金）と
	! 下端の受け（B-B: 建地を半分抱く）で建地に留める。縦材の上から躯体側へ腕（外管 φ42.7 に内管 φ34 が伸縮して入る。
	! 外管の先にスリーブと単クランプ用のナット）、縦材の下から腕を支える方杖 φ27.2、腕の先に鍔と、腕と直角に立つ涙形の穴あきの板。
	! 腕の長さ（建地芯から）は rowW で、品番も腕の長さで決まる（数量と同じ）:
	! TWL500F 430〜585（縦材378.5・外管361）、TWL750F 600〜830（393.5・531）、TWL1000F 890〜1120（518.5・821）。
	! 腕の上端に足場板が載る。先端には建地が無いのでクランプは付かない（利用者の指摘 2026-10-22）
	bkOut = 0.361		! 外管の長さ（建地芯から）
	bkV = 0.3785		! 縦材の長さ
	if rowW > 0.586 then bkOut = 0.531
	if rowW > 0.586 then bkV = 0.3935
	if rowW > 0.831 then bkOut = 0.821
	if rowW > 0.831 then bkV = 0.5185
	if bkOut > rowW - 0.05 then bkOut = rowW - 0.05
	xb = r_sic + 0.0045 + 0.008 + 0.02135		! 腕・方杖の面（建地の脇。クランプの口の外）
	zA = z + 0.0243 - 0.02135					! 腕の芯（上端が足場板の下端）
	zT = zA + 0.02135							! 腕の上端
	add x + xb, -rowW, 0
	! 縦材（束材）: 建地芯から 58.7 躯体側、腕の上端から下へ bkV
	add 0, 0.0587, zT - bkV
	cylind bkV - 0.02135, 0.02135
	del 1
	! 外管（建地芯から bkOut まで）・内管（先端 rowW まで伸ばす）・スリーブ
	add 0, 0, zA
	rotx -90
	cylind bkOut, 0.02135
	del 2
	add 0, bkOut - 0.14, zA
	rotx -90
	cylind rowW - bkOut + 0.14, 0.017
	del 2
	if isLite = 0 then
		add 0, bkOut - 0.14, zA
		rotx -90
		cylind 0.14, 0.0255
		del 2
		! 単クランプ用のナット（スリーブの下）
		add 0, bkOut - 0.07, zA - 0.0255 - 0.018
		resol 6
		cylind 0.018, 0.012
		resol rN
		del 1
		! 腕の先（カタログ p108 の先端図・利用者の図 2026-10-22）: 内管の端の鍔と、腕の先に直角に立つ涙形の板
		! （下が丸く上が尖る。丸の中心に穴＝手すり柱・単クランプを留める。板の面は腕と直角＝利用者の指摘 2026-10-22:
		! 90度向きがおかしい）。丸の中心は腕の芯の高さ
		add 0, rowW - 0.016, zA
		rotx -90
		cylind 0.008, 0.024
		del 2
		! 丸い部分（穴のあいた輪。REVOLVE の軸を rotz 90 で腕の向き＝Y に）と、上に尖る三角（輪の接点から頂点へ）
		add 0, rowW + 0.003, zA + 0.006
		rotz 90
		revolve 4, 360, 63, -0.003, 0.011, 0, 0.003, 0.011, 0, 0.003, 0.030, 0, -0.003, 0.030, 0
		del 1
		add 0, 0.003, 0
		rotx 90
		prism_ 3, 0.006, 0, 0.0750, 15, 0.0246, 0.0172, 15, -0.0246, 0.0172, 15
		del 3
	endif
	! 方杖（縦材の下端から外管の先の手前へ）
	zd0 = zT - bkV + 0.04
	yd0 = 0.0587
	yd = bkOut - 0.03 - yd0
	dzd = zA - zd0
	add 0, yd0, zd0
	rotx -atn(yd / dzd)
	cylind sqr(yd * yd + dzd * dzd), 0.0136
	del 2
	del 1
	! 建地に留める: 上のスーパークランプ（金。腕の上端から 128.5 下、口の相手は +X）と、下端の受け（建地を半分抱く）
	if isLite = 0 then
		add x, -rowW, zT - 0.1285
		rotz 90
		roty -90
		jR = r_sic
		gosub 838
		del 3
		gosub 837
		add x, -rowW, zT - bkV + 0.02
		rotz 90
		roty -90
		rotx 90
		revolve 4, 180, 63, -0.026, r_sic, 0, 0.026, r_sic, 0, 0.026, r_sic + 0.004, 0, -0.026, r_sic + 0.004, 0
		del 4
	endif
	! 受け・クランプと縦材をつなぐ板（建地の脇から縦材まで）
	add x + r_sic, -rowW - 0.015, zT - bkV
	block xb - r_sic, 0.0587 + 0.03, 0.05
	del 1
	add x + r_sic, -rowW - 0.015, zT - 0.1285 - 0.025
	block xb - r_sic, 0.0587 + 0.03, 0.05
	del 1
	return

800: ! ---- 一側足場の床受けブラケット（建地1列＋腕＋方杖） ----
! 作業床は建地から躯体側へ持ち出す。数量では「一側足場の床受けブラケット」
! として拾っているので、3Dにも出さないと図と部材表が食い違う。単管抱き足場は布2本で受けるので無い。
! 単管のブラケットは C付伸縮ブラケット（812）
if il >= 2 and hugMode = 0 and serType = "T" then
	gosub 812
endif
if il >= 2 and hugMode = 0 and serType <> "T" then
	add x, -rowW, z
	rotz 90
	nL = rowW
	gosub 830
	del 2
	add x, -rowW, z - rowW
	rotx -45
	cylind rowW * 1.4142, r_nuno
	del 2
endif
return

! ============================================================
860:	! ---- 建枠（枠組）: 鳥居型建枠の形。脚の内側 175（610幅系は 110）に縦材を立て、横桟3段で梯子にし、
! 下端を円弧（ここでは斜材）で脚へ戻す（日建カタログ p068・070 A4055B・A3055A）。くさび式には無い。
! 呼び出し時の z は建枠の天端（作業床の高さ）、zb はその下の建枠の天端
if serType = "W" and il > 1 and isLite = 0 then
	zt = z
	zb = lv[il - 1]
	! 建枠の継ぎ目（下の建枠の天端 zb、2段目から）: 連結ピン（カタログ p081 A20）の帯と、上下の建枠の脚を
	! つなぐアームロック（p080 A126 等、長さ 739）を両脚の内側に
	if il > 2 then
		for sk2 = 0 to 1
			yl2 = -sk2 * rowW
			add x, yl2, zb - 0.10
			cylind 0.20, r_sic + 0.004
			del 1
			yi2 = yl2 - 0.045
			if sk2 = 1 then yi2 = yl2 + 0.045
			add x, yi2, zb - 0.37
			cylind 0.739, 0.009
			del 1
			add x - 0.006, min(yl2, yi2), zb - 0.37
			block 0.012, abs(yi2 - yl2), 0.03
			del 1
			add x - 0.006, min(yl2, yi2), zb + 0.34
			block 0.012, abs(yi2 - yl2), 0.03
			del 1
		next sk2
	endif
	fd = 0.175
	if rowW < 0.8 then fd = 0.11
	zv = zt - min(1.219, 0.72 * (zt - zb))
	for sk = 0 to 1
		yl = -sk * rowW
		yv = yl - fd
		if sk = 1 then yv = yl + fd
		! 内側の縦材
		add x, yv, zv
		cylind zt - 0.02 - zv, 0.0136
		del 1
		! 横桟（脚〜縦材）
		for ir = 1 to 3
			zr = zt - 0.15 - (ir - 1) * 0.40
			if zr > zv + 0.05 then
				add x, min(yl, yv), zr
				rotx -90
				cylind fd, 0.0109
				del 2
			endif
		next ir
		! 下端の円弧（縦材の下から脚へ）
		ad = sqr(fd * fd + 0.25 * 0.25)
		add x, yv, zv
		rotx 180 + atn((yl - yv) / 0.25)
		cylind ad, 0.0136
		del 2
	next sk
endif
return

840:	! ---- 支柱の継ぎ目（利用者の指摘 2026-10-21: 支柱の継ぎ目が分かるように）: 継手の帯（上下の支柱の
	! 突き合わせ。コマ φ106 の円盤とは形を変え、縦長の帯にする）と、継ぎ目の線（帯の中央の細い溝）。
	! 軽量でも描く（積んだ支柱の長さ 2700・3600 が3Dと立面で読めるように）
	! 単管の建地は直線ジョイント（PCJ、カタログ p377）: 管の中に差し込み、外に見えるのは中央の帯 25（φ48.6）
	if serType = "T" then
		if matScaf > 0 then material "ashiba_clamp_zinc"
		addz -0.0125
		cylind 0.025, r_sic + 0.0008
		del 1
		if matScaf > 0 then material matScaf
		return
	endif
	jLen = jLo
	gosub 847
	addz -0.04
	cylind 0.035, r_sic + 0.008
	jLen = jUp
	gosub 847
	addz 0.045
	cylind 0.035, r_sic + 0.008
	del 2
	if matScaf > 0 then material matScaf
	return

847:	! 支柱の長さ jLen（m）の識別色（継ぎ目の帯）
	material "ashiba_post_joint"
	if jLen > 0.001 then material "ashiba_pj_045"
	if jLen >= 0.60 then material "ashiba_pj_0675"
	if jLen >= 0.85 then material "ashiba_pj_09"
	if jLen >= 1.00 then material "ashiba_pj_1125"
	if jLen >= 1.30 then material "ashiba_pj_135"
	if jLen >= 1.70 then material "ashiba_pj_18"
	if jLen >= 2.60 then material "ashiba_pj_27"
	if jLen >= 3.50 then material "ashiba_pj_36"
	return

865:	! ---- 侵入落下防止柵の1枚（金網のフェンスパネル）: 原点＝パネルの下端の始点、+X へ幅 fW、高さ fH、枠 φ27.2 ----
	material "ashiba_fence_frame"
	resol 8
	for fe = 0 to 1
		add fe * fW, 0, 0
		cylind fH, 0.0136
		del 1
	next fe
	for fz = 0 to 2
		add 0, 0, fz * fH / 2
		roty 90
		cylind fW, 0.0136
		del 2
	next fz
	material "ashiba_fence_mesh"
	add 0.0136, -0.001, 0.0136
	block fW - 0.0272, 0.002, fH - 0.0272
	del 1
	return

870:	! ---- 布板（アップロック式鋼製布板）: 原点＝支柱芯の床の高さ・板の外側の端、+X へ dkL、+Y へ幅 dkW。
	! 板は腕木（φ42.7、芯が床の高さ）の上に載る。両端のつかみ金具で腕木を掴み、ペロ板が腕木の上を覆う
	add 0.025, 0, r_nuno
	block dkL - 0.05, dkW, 0.045
	del 1
	if isLite = 0 then
		for hd870 = 0 to 1
			if hd870 = 0 then
				add 0, 0, 0
			else
				add dkL, 0, 0
				mulx -1
			endif
			! ペロ板（腕木の上を覆う薄板）
			add 0.002, 0.04, r_nuno + 0.040
			block 0.024, dkW - 0.08, 0.005
			del 1
			! つかみ金具（板の両側、腕木を下から抱える）
			for hk870 = 0 to 1
				add 0.004, 0.015 + hk870 * (dkW - 0.065), -r_nuno - 0.012
				block 0.030, 0.035, 2 * r_nuno + 0.012
				del 1
			next hk870
			if hd870 = 0 then
				del 1
			else
				del 2
			endif
		next hd870
	endif
	return

875:	! ---- ブラケット（腕＋方杖）: 原点＝支柱芯の腕の高さ、+X が腕の向き、腕の長さ bkArm（支柱の外面から） ----
	! 緊結部（支柱の外面からコマを挟む）・腕 φ42.7・先端の受け（立ち上がり）・方杖（下の支柱から腕の先の手前へ）
	bkDp = 0.209
	if bkArm > 0.40 then bkDp = 0.253
	if bkArm > 0.30 and bkArm < 0.33 then bkDp = 0.45
	if bkArm > 0.60 then bkDp = 0.90
	add r_sic, -0.020, 0.003
	block 0.042, 0.040, 0.042
	del 1
	add r_sic, -0.020, -0.040
	block 0.042, 0.040, 0.037
	del 1
	add r_sic + 0.042, 0, 0
	roty 90
	cylind bkArm - 0.042, r_nuno
	del 2
	! 先端の受け（ブラケットの縁。張出しは先端にホゾ φ36.4）
	add r_sic + bkArm - 0.02, -0.02, -0.03
	block 0.02, 0.04, 0.10
	del 1
	if isLite = 0 then
		add r_sic, -0.020, -bkDp - 0.03
		block 0.042, 0.040, 0.06
		del 1
	endif
	bsX = bkArm - 0.04
	bsL = sqr(bsX * bsX + bkDp * bkDp)
	add r_sic + 0.02, 0, -bkDp
	roty 90 - atn(bkDp / bsX)
	cylind bsL, 0.0136
	del 2
	return

850:	! ---- 先行手すり（日建 NDX、カタログ p006）: 原点＝支柱芯の床の高さ、+X へ次の支柱芯まで nL。
	! 手すり φ27.2 は H900（railTop）、斜材 φ21.7 は上の金具から対角の支柱の床際の金具へ（X形）。
	! 以前は手すりを布材（φ42.7・緊結部）で描き、金具も無かった（利用者の指摘 2026-10-21: 他の部材も見直して）
	fitL = 0.045
	add r_sic + fitL, 0, railTop
	roty 90
	cylind nL - 2 * (r_sic + fitL), 0.0272 / 2
	del 2
	for hd850 = 0 to 1
		if hd850 = 0 then
			add r_sic, 0, 0
		else
			add nL - r_sic, 0, 0
			mulx -1
		endif
		! 上の金具（手すりの高さのコマに掛ける）と下の金具（床際のコマに掛ける）
		add 0, -0.020, railTop - 0.030
		block fitL, 0.040, 0.060
		del 1
		add 0, -0.020, 0.005
		block fitL, 0.040, 0.045
		del 1
		if hd850 = 0 then
			del 1
		else
			del 2
		endif
	next hd850
	advX = nL - 2 * (r_sic + fitL / 2)
	advDz = railTop - 0.04
	advL = sqr(advX * advX + advDz * advDz)
	add r_sic + fitL / 2, 0.012, railTop - 0.01
	roty 90 + atn(advDz / advX)
	cylind advL, 0.0217 / 2
	del 2
	add nL - r_sic - fitL / 2, -0.012, railTop - 0.01
	roty -(90 + atn(advDz / advX))
	cylind advL, 0.0217 / 2
	del 2
	return

880:	! ---- 朝顔の主材・斜材・主材受金具（支柱 x、建地列 ybA、高さ za） ----
	add x, ybA - r_sic, za
	muly -1
	add -0.025, 0, -0.10
	block 0.05, 0.10, 0.25
	del 1
	add -0.025, 0, -floorH - 0.10
	block 0.05, 0.10, 0.25
	del 1
	rotx asagaoAngle
	add -0.02, 0, 0
	block 0.04, asL, 0.08
	del 2
	asY = asD * cos(asagaoAngle)
	asZ = asD * sin(asagaoAngle) + floorH
	add 0, 0, -floorH
	rotx -atn(asY / asZ)
	cylind sqr(asY * asY + asZ * asZ), 0.0272 / 2
	del 2
	del 2
	return

885:	! ---- 朝顔の万能板受・押えと FRP 万能板（区間 p0〜p1、建地列 ybA、高さ za） ----
	sgL5 = p1 - p0
	add p0, ybA - r_sic, za
	muly -1
	rotx asagaoAngle
	add 0, 0.04, 0.0
	block sgL5, 0.04, 0.08
	del 1
	add 0, asL - 0.08, -0.02
	block sgL5, 0.04, 0.10
	del 1
	if isLite = 0 then
		add 0, asL * 0.5, 0.108
		block sgL5, 0.036, 0.020
		del 1
	endif
	material "ashiba_frp"
	if isLite = 0 then
		nPn = int(sgL5 / 0.31 + 0.999)
		pnW = sgL5 / nPn
		for ipn = 1 to nPn
			add (ipn - 1) * pnW + 0.003, 0.05, 0.08
			block pnW - 0.006, asL - 0.10, 0.028
			del 1
		next ipn
	else
		add 0, 0.05, 0.08
		block sgL5, asL - 0.10, 0.028
		del 1
	endif
	if matScaf > 0 then material matScaf
	del 3
	return

887:	! ---- 朝顔のフレ止め（スパン x〜x+spL、建地列 ybA） ----
	add x, ybA - r_sic, za
	muly -1
	rotx asagaoAngle
	frAng = atn((asL * 0.55) / spL)
	frL = sqr(spL ^ 2 + (asL * 0.55) ^ 2)
	add 0, asL * 0.2, -0.01
	rotz frAng
	roty 90
	cylind frL, 0.012
	del 3
	add spL, asL * 0.2, -0.01
	rotz 180 - frAng
	roty 90
	cylind frL, 0.012
	del 3
	del 3
	return

890:	! ---- 朝顔の出隅コーナー部（カタログ p125: センター材＋斜材、主材受金具、扇形の FRP 万能板 小・中・大） ----
	! 前の面の朝顔は -X へ（この面の始点 y≧0 の側）、この面の朝顔は -Y へ出る。その間の外側の隅を塞ぐ
	cx0 = -rowW - r_sic
	cy0 = -rowW - r_sic
	! この面の始点が外付けの階段室なら、この面の朝顔は3列目から出ている
	aY = cy0
	if stOut = 1 then
		for it8 = 1 to nSt
			if stS[it8] < 0.001 then aY = -2 * rowW - r_sic
		next it8
	endif
	cLen = sqr(2 * asC * asC + asH * asH)
	! センター材（外側コーナー支柱から 45° 外へ、先端は直線部の先端と同じ高さ）
	add cx0, cy0, za
	rotz 225
	roty -atn(asH / (asC * sqr(2)))
	add 0, -0.02, 0
	block cLen, 0.04, 0.08
	del 4
	! 主材受金具（上・下）と斜材
	add cx0 - 0.05, cy0 - 0.05, za - 0.10
	block 0.10, 0.10, 0.25
	del 1
	add cx0 - 0.05, cy0 - 0.05, za - floorH - 0.10
	block 0.10, 0.10, 0.25
	del 1
	cdh = 0.32 * asC * sqr(2)
	cdz = 0.32 * asH + floorH
	add cx0, cy0, za - floorH
	rotz 225
	roty atn(cdh / cdz)
	cylind sqr(cdh * cdh + cdz * cdz), 0.0272 / 2
	del 3
	! 扇形の FRP 万能板: センター材の両側に 小・中・大 の3枚ずつ（ALAF21S・22S・23S、計6枚）。板の継ぎ目は
	! 根元の辺（外側コーナー支柱〜面の端の主材の根元）と先端の辺を3等分した線。両側の上に万能板上押え（ALAC4N）、
	! 下に振れ止め 横（ALAC5）・縦（ALAC6）を、面の端の主材とセンター材の間に渡す
	ctX = cx0 - asC
	ctY = aY - asC
	for hb = 0 to 1
		if hb = 0 then
			! この面の側: 根元の端は面の始点の主材の根元、先端の端はその主材の先端
			rX = 0
			rY = aY
			tX = 0
			tY = aY - asC
		else
			! 前の面の側
			rX = cx0
			rY = 0
			tX = cx0 - asC
			tY = 0
		endif
		! 片側の万能板は1枚の面で描く（板ごとの三角形に分けると、面の境目の線と隙間で割れて見えた。
		! 利用者の指摘 2026-10-21）。外付けの階段室が隅から始まる面だけは平面にならないので三角形2つ
		material "ashiba_frp"
		if abs(rY - cy0) < 0.001 or abs(rX - cx0) < 0.001 then
			plane 4, cx0, cy0, za + 0.08, rX, rY, za + 0.08, tX, tY, za + asH + 0.08, ctX, ctY, za + asH + 0.08
		else
			plane 3, cx0, cy0, za + 0.08, rX, rY, za + 0.08, tX, tY, za + asH + 0.08
			plane 3, cx0, cy0, za + 0.08, tX, tY, za + asH + 0.08, ctX, ctY, za + asH + 0.08
		endif
		if matScaf > 0 then material matScaf
		! 小・中・大 3枚の継ぎ目（根元の辺と先端の辺を3等分した線。板の上の細い線材で示す）
		if isLite = 0 then
			for kp = 1 to 2
				tk = kp / 3
				bx1 = cx0 + tk * (rX - cx0)
				by1 = cy0 + tk * (rY - cy0)
				bz1 = za + 0.085
				bx2 = ctX + tk * (tX - ctX)
				by2 = ctY + tk * (tY - ctY)
				bz2 = za + asH + 0.085
				brR = 0.006
				gosub 895
			next kp
		endif
		if matScaf > 0 then material matScaf
		! 万能板上押え（板の中ほどを根元から先端へ）
		bx1 = cx0 + 0.5 * (rX - cx0)
		by1 = cy0 + 0.5 * (rY - cy0)
		bz1 = za + 0.11
		bx2 = ctX + 0.5 * (tX - ctX)
		by2 = ctY + 0.5 * (tY - ctY)
		bz2 = za + asH + 0.11
		brR = 0.015
		gosub 895
		if isLite = 0 then
			! 振れ止め 横（面の端の主材の 0.55 の点〜センター材の 0.55 の点）
			bx1 = rX + 0.55 * (tX - rX)
			by1 = rY + 0.55 * (tY - rY)
			bz1 = za + 0.55 * asH - 0.04
			bx2 = cx0 + 0.55 * (ctX - cx0)
			by2 = cy0 + 0.55 * (ctY - cy0)
			bz2 = za + 0.55 * asH - 0.04
			brR = 0.012
			gosub 895
			! 振れ止め 縦（面の端の主材の根元寄り 0.25〜センター材の先端寄り 0.8）
			bx1 = rX + 0.25 * (tX - rX)
			by1 = rY + 0.25 * (tY - rY)
			bz1 = za + 0.25 * asH - 0.04
			bx2 = cx0 + 0.8 * (ctX - cx0)
			by2 = cy0 + 0.8 * (ctY - cy0)
			bz2 = za + 0.8 * asH - 0.04
			gosub 895
		endif
	next hb
	return

895:	! ---- 2点 (bx1,by1,bz1)〜(bx2,by2,bz2) を結ぶ丸棒（半径 brR） ----
	bdx = bx2 - bx1
	bdy = by2 - by1
	bdz = bz2 - bz1
	bLn = sqr(bdx * bdx + bdy * bdy + bdz * bdz)
	if bLn > 0.001 then
		if abs(bdx) < 0.000001 then
			bAz = 90
			if bdy < 0 then bAz = -90
		else
			bAz = atn(bdy / bdx)
			if bdx < 0 then bAz = bAz + 180
		endif
		bTl = acs(bdz / bLn)
		add bx1, by1, bz1
		rotz bAz
		roty bTl
		cylind bLn, brR
		del 3
	endif
	return

832:	! ---- 単管の通しのこの区間の分（利用者の指定 2026-10-22: 規定の長さの単管を直線ジョイントで継ぐ）----
	! 原点＝この区間の始点の建地の位置の管の芯、+X へ nL。runX＝面の始点からこの区間の始め、runP＝割付（1=A 2=B、
	! 0 は通さない短い管）。面の最初と最後の区間は通しの始め（runS）・終わり（runE）まで出す
	r_t = 0.0486 / 2
	if runP = 0 or nRl[max(runP, 1)] = 0 then
		add -0.05, 0, 0
		roty 90
		cylind nL + 0.10, r_t
		del 2
		return
	endif
	xs = 0
	xe = nL
	if runX < 0.001 then xs = runS - runX
	if runX + nL > lineLen - 0.001 then xe = runE[runP] - runX
	add xs, 0, 0
	roty 90
	cylind xe - xs, r_t
	del 2
	if isLite = 0 and matScaf > 0 then
		! 単管の両端の識別色と、継ぎの直線ジョイント（PCJ: 管の中に差し込み、外に見えるのは中央の帯 25）
		pa = runS
		for k = 1 to nRl[runP]
			pb = pa + rl[runP][k]
			cL = rl[runP][k]
			ga = 0
			if k > 1 then ga = 0.0125
			gb = 0
			if k < nRl[runP] then gb = 0.0125
			for e832 = 0 to 1
				bx = pa + ga - runX
				if e832 = 1 then bx = pb - gb - 0.03 - runX
				if bx >= xs - 0.001 and bx < xe - 0.001 then
					gosub 846
					add bx, 0, 0
					roty 90
					cylind 0.03, r_t + 0.0004
					del 2
				endif
			next e832
			if k < nRl[runP] then
				jx = pb - runX
				if jx >= xs and jx < xe then
					material "ashiba_clamp_zinc"
					add jx - 0.0125, 0, 0
					roty 90
					cylind 0.025, r_t + 0.0008
					del 2
				endif
			endif
			pa = pb
		next k
		material matScaf
	endif
	return

846:	! 単管の識別色（カタログ p372）。cL＝単管の長さ m
	cK = int(cL * 10 + 0.5)
	if cK = 60 then material "ashiba_tc_60"
	if cK = 55 then material "ashiba_tc_55"
	if cK = 50 then material "ashiba_tc_50"
	if cK = 45 then material "ashiba_tc_45"
	if cK = 40 then material "ashiba_tc_40"
	if cK = 35 then material "ashiba_tc_35"
	if cK = 30 then material "ashiba_tc_30"
	if cK = 25 then material "ashiba_tc_25"
	if cK = 20 then material "ashiba_tc_20"
	if cK = 15 then material "ashiba_tc_15"
	if cK = 10 then material "ashiba_tc_10"
	return

839:	! ---- 自在クランプ（日建 兼用自在クランプ ARC2、カタログ p378。金）: 単管の筋かいの端を建地に留める ----
	! 建地（cx, -rowW、芯の高さ cz）を掴む口と、筋かい（芯 y = yb2、x-z 面で傾き ang、向き sg）を掴む口を、
	! 背中合わせの軸で回して留める形。2つの口の背板のあいだは軸（金の短い円柱）でつなぐ
	add cx, -rowW, cz
	roty -90
	jR = r_sic
	gosub 838
	del 2
	add cx, yb2, cz
	if sg < 0 then mulx -1
	roty -ang
	rotx 180
	jR = 0.0486 / 2
	gosub 838
	del 3
	if sg < 0 then del 1
	! 軸（2つの口の背板のあいだ）
	if matScaf > 0 then material "ashiba_clamp_gold"
	ySA = -rowW - (r_sic + clT + 0.004)
	ySB = yb2 + (0.0486 / 2 + clT + 0.004)
	add cx, ySA, cz
	rotx 90
	cylind ySA - ySB, 0.010
	del 2
	gosub 837
	return

834:	! ---- 直交クランプ（日建 兼用直交クランプ ARC1、カタログ p378）----
	! 原点＝建地の芯（Z 向き）の留める高さ。布は +X 向きで芯は y = -clDy、半径 clR2。建地を掴む口と布を掴む口を
	! 背中合わせにリベットで留めた形。口は本体の半割と、蝶番で開くふたを、T ボルトとナットで締める
	! （利用者の写真 2026-10-22: クランプの形を変えて。色は金色）
	! 建地の口（管は Z 向き。蝶番は -X、ボルトは +X）
	roty -90
	jR = r_sic
	gosub 838
	del 1
	! 布の口（管は X 向き。蝶番は上、ボルトは下＝足場板に当たらない）
	add 0, -clDy, 0
	rotz 180
	jR = clR2
	gosub 838
	del 2
	gosub 837
	return

836:	! ---- 3連クランプ（日建 P3CR 直交、カタログ p384）: 建地と、建地を両側から抱いた布2本を1個で留める ----
	! 原点＝建地の芯の留める高さ。布は +X 向きで芯は y = ±clDy、半径 clR2。建地の口の両側に布の口を背中合わせ
	roty -90
	jR = r_sic
	gosub 838
	! 建地の口のふた側（+Y）にも、もう1つの布の口と背中合わせにする板
	if matScaf > 0 then material "ashiba_clamp_gold"
	add -clW / 2, jR + clT, -clW / 2
	block clW, 0.004, clW
	del 1
	del 1
	add 0, clDy, 0
	jR = clR2
	gosub 838
	del 1
	add 0, -clDy, 0
	rotz 180
	jR = clR2
	gosub 838
	del 2
	gosub 837
	return

837:	! クランプを描いたあと、足場の表面材に戻す
	resol rN
	if matScaf > 0 then material matScaf
	return

838:	! ---- クランプの口1つ: 管は X 向きで芯が原点、半径 jR。相手の口は -Y 側（そちらに本体と背板）----
	! 本体: -Y 側の半割。REVOLVE は +Y から +Z へ回るので、rotx 90 で +Z から -Y を通って -Z まで
	if matScaf > 0 then material "ashiba_clamp_gold"
	resol rN
	rotx 90
	revolve 4, 180, 63, -clW / 2, jR, 0, clW / 2, jR, 0, clW / 2, jR + clT, 0, -clW / 2, jR + clT, 0
	del 1
	! 背板（相手の口とリベットで留める）
	add -clW / 2, -(jR + clT + 0.004), -clW / 2
	block clW, 0.004, clW
	del 1
	! 蝶番（+Z）とボルトの軸受け（-Z）
	add -clW / 2, 0, jR + clT + 0.0035
	roty 90
	cylind clW, 0.0045
	del 2
	add -clW / 2, -0.014, -(jR + clT + 0.014)
	block clW, 0.012, clT + 0.014
	del 1
	! ふた: +Y 側の半割。-Z から +Y を通って +Z まで。中央に補強の帯、-Z の端はボルトを受ける舌
	if matScaf > 0 then material "ashiba_clamp_gold"
	rotx -90
	revolve 4, 180, 63, -clW / 2, jR, 0, clW / 2, jR, 0, clW / 2, jR + clT, 0, -clW / 2, jR + clT, 0
	revolve 4, 180, 63, -0.006, jR + clT, 0, 0.006, jR + clT, 0, 0.006, jR + clT + 0.003, 0, -0.006, jR + clT + 0.003, 0
	del 1
	add -clW * 0.35, 0, -(jR + clT + 0.016)
	block clW * 0.7, 0.007, 0.018
	del 1
	! T ボルト: 軸受けから +Y へ、ふたの舌を通す。ナット（六角）で舌を締める
	if matScaf > 0 then material "ashiba_clamp_gold"
	add 0, -0.012, -(jR + clT + 0.008)
	rotx -90
	cylind 0.044, 0.005
	if matScaf > 0 then material "ashiba_clamp_gold"
	addz 0.019
	resol 6
	cylind 0.010, 0.0095
	resol rN
	del 3
	return


830:	! ---- 布材（つなぎ材）: 原点（支柱芯）から +X へ長さ nL（次の支柱芯まで）。日建カタログ p005 の形:
	! 両端の緊結部（クサビ受け）が支柱の外面からコマ（円盤）を上下に挟み、クサビが緊結部を縦に貫いて
	! 上（クビレ）と下に出る。管 φ42.7 は緊結部の間だけ（L1＝L−42.7）。利用者の指摘（2026-10-21）:
	! 布材も変。以前は管を支柱芯から 78 で止め、小さな爪の箱だけで、コマに掛かって見えなかった
	! 単管（serType "T"）: 布・腕木・手すりは φ48.6 の管を建地の脇（-Y 側）に直交クランプ（日建 ARC1、カタログ
	! p378）で留める。管は建地の外まで少し出す（次の管と重ねて留めるので）
	if serType = "T" then
		r_t = 0.0486 / 2
		add 0, -tubeOff, 0
		gosub 832
		del 1
		if isLite = 0 then
			clDy = tubeOff
			clR2 = r_t
			for hd830 = 0 to 1
				! 通しは建地ごとに1個（終点の建地はこの面の最後の区間が留める）。短い管は両端
				if hd830 = 0 or runP = 0 or runX + nL > lineLen - 0.001 then
					add hd830 * nL, 0, 0
					gosub 834
					del 1
				endif
			next hd830
		endif
		return
	endif
	hdL = 0.050          ! 緊結部の長さ（支柱の外面から）
	hx0 = r_sic          ! 緊結部は支柱の外面から
	add hx0 + hdL, 0, 0
	roty 90
	cylind nL - 2 * (hx0 + hdL), r_nuno
	del 2
	for hd830 = 0 to 1
		if hd830 = 0 then
			add hx0, 0, 0
		else
			add nL - hx0, 0, 0
			mulx -1
		endif
		! 緊結部: コマの上（厚み6の円盤の上）と下に分かれ、外側でつながる
		add 0, -0.020, 0.003
		block hdL, 0.040, 0.042
		del 1
		add 0, -0.020, -0.040
		block hdL, 0.040, 0.037
		del 1
		add hdL - 0.012, -0.020, -0.003
		block 0.012, 0.040, 0.006
		del 1
		if isLite = 0 then
			! クサビ（縦の板。上にクビレ、下に固定装置）
			add 0.010, -0.006, -0.075
			block 0.010, 0.012, 0.150
			del 1
		endif
		if hd830 = 0 then
			del 1
		else
			del 2
		endif
	next hd830
	return

! ============================================================
900:	! ---- 線表示 ----
! 支柱（脚ごとの地盤高。開口部の梁枠より下は抜く）とジャッキベース板（140角）
x = 0
for ip = 1 to nSpan + 1
	gv = 0
	if ip <= nGl then gv = gl[ip]
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	for row = rowStart to 1
		yr = -row * rowW
		skipP = 0
		if (row = 0 or hugMode = 1) and ((ip = 1 and skipInS = 1) or (ip = nSpan + 1 and skipInE = 1)) then skipP = 1
		! セットバックの上段の端は本体の支柱に乗る（支柱もジャッキベースも描かない。利用者の指定 2026-10-25）
		if (ip = 1 and skipPS = 1) or (ip = nSpan + 1 and skipPE = 1) then skipP = 1
		if bBase = 0 and skipP = 0 then
			lin_ x, yr, gv, x, yr, postTop
			lin_ x - 0.07, yr - 0.07, gv, x + 0.07, yr - 0.07, gv
			lin_ x + 0.07, yr - 0.07, gv, x + 0.07, yr + 0.07, gv
			lin_ x + 0.07, yr + 0.07, gv, x - 0.07, yr + 0.07, gv
			lin_ x - 0.07, yr + 0.07, gv, x - 0.07, yr - 0.07, gv
			! 支柱の継ぎ目（部材の切れ目）に短い横線。天端から数える（継ぎ足しは下側）
			jh = postTop
			for jp = nPost to 2 step -1
				jh = jh - posts[jp]
				lin_ x - 0.06, yr, jh, x + 0.06, yr, jh
			next jp
		else
			lin_ x, yr, bBase, x, yr, postTop
		endif
	next row
	if ip <= nSpan then x = x + spans[ip]
next ip
! 出隅コーナー: 外側コーナー支柱と各層の升目の輪郭
if cornerS = 1 then
	gv = 0
	if nGl >= 1 then gv = gl[1]
	lin_ -cSW, -rowW, gv, -cSW, -rowW, postTop
	if cornerSP = 1 then lin_ -cSW, 0, gv, -cSW, 0, postTop
	for il = 1 to nLv
		z = lv[il]
		lin_ 0, 0, z, -cSW, 0, z
		lin_ -cSW, 0, z, -cSW, -rowW, z
		lin_ -cSW, -rowW, z, 0, -rowW, z
		if il > 1 then
			lin_ -cSW, 0, z + railTop, -cSW, -rowW, z + railTop
			lin_ -cSW, -rowW, z + railTop, 0, -rowW, z + railTop
		endif
	next il
endif
! 水平材: 根がらみ・各層の床レベル（内外）と外側の手すり、支柱位置の腕木。
! 開口部の梁枠より下は空ける（立体表現と同じ規則）
for il = 1 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		skipH = 0
		for ib6 = 1 to nBm
			if x >= bmS[ib6] - 0.001 and x + spans[ip] <= bmS[ib6] + bmL[ib6] + 0.001 and \
					z < bmH[ib6] - 0.001 then skipH = 1
		next ib6
		if skipH = 0 then
			for row = rowStart to 1
				lin_ x, -row * rowW, z, x + spans[ip], -row * rowW, z
			next row
			if il > 1 then
				lin_ x, -rowW, z + railTop, x + spans[ip], -rowW, z + railTop
				if railIn = 1 and nRows >= 2 then
					lin_ x, 0, z + railTop, x + spans[ip], 0, z + railTop
				endif
			endif
			lin_ x, 0, z, x, -rowW, z
			if ip = nSpan then lin_ x + spans[ip], 0, z, x + spans[ip], -rowW, z
		endif
		x = x + spans[ip]
	next ip
next il
! 階段室: 同じ向きで2層ずつ（奇数層は始点側、偶数層は終点側のスパン）の斜線（踏面の両端）
for it5 = 1 to nSt
	sx = stS[it5]
	sl = stL[it5]
	if stOut = 1 then
		xa = 0
		fFirst = 0
		fLast = 0
		for ipx = 1 to nSpan
			if abs(xa - sx) < 0.001 then fFirst = spans[ipx]
			if abs(xa + spans[ipx] - sx - sl) < 0.001 then fLast = spans[ipx]
			xa = xa + spans[ipx]
		next ipx
		if sl - fFirst - fLast > 0.5 then
			sx = sx + fFirst
			sl = sl - fFirst - fLast
		endif
	endif
	for il5 = 1 to nLv - 1
		! 階段室のスパン（1つ目＝始点側、2つ目＝終点側。1スパンの階段室は2つ目なし）
		stA = sl
		stB = 0
		xa = 0
		for ipx = 1 to nSpan
			if abs(xa - sx) < 0.001 then
				stA = spans[ipx]
				if ipx < nSpan then
					if xa + spans[ipx] + spans[ipx + 1] <= sx + sl + 0.001 then stB = spans[ipx + 1]
				endif
			endif
			xa = xa + spans[ipx]
		next ipx
		! 同じ向き（始点→終点）で2層ずつ: 奇数層は始点側のスパン、偶数層は終点側のスパンに1スパン分の階段。
		! 2層登ったら階段室を出て外の作業床を回って戻る（階段室の中に踊り場の床は無い）
		x0 = sx
		fl = stA
		if il5 - 2 * int(il5 / 2) = 0 and stB > 0 then
			x0 = sx + stA
			fl = stB
		endif
		ybl = -stOut * rowW
		lin_ x0, ybl - 0.05, lv[il5], x0 + fl, ybl - 0.05, lv[il5 + 1]
		lin_ x0, ybl - rowW + 0.05, lv[il5], x0 + fl, ybl - rowW + 0.05, lv[il5 + 1]
	next il5
next it5
! 梁枠（開口部）: 上下弦材と両端の縦材
for ib2 = 1 to nBm
	bs = bmS[ib2]
	bl = bmL[ib2]
	bh = bmH[ib2]
	for row2 = rowStart to 1
		yr = -row2 * rowW
		lin_ bs, yr, bh - bmDrop, bs + bl, yr, bh - bmDrop
		lin_ bs, yr, bh - bmDrop - bmDep, bs + bl, yr, bh - bmDrop - bmDep
		lin_ bs, yr, bh - bmDrop - bmDep, bs, yr, bh - bmDrop
		lin_ bs + bl, yr, bh - bmDrop - bmDep, bs + bl, yr, bh - bmDrop
	next row2
next ib2
! 荷受けステージ: 張出し床の輪郭と先端の手すり
for ig = 1 to nSg
	lin_ sgS[ig], -rowW, sgH[ig], sgS[ig], -rowW - sgP[ig], sgH[ig]
	lin_ sgS[ig], -rowW - sgP[ig], sgH[ig], sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig]
	lin_ sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig], sgS[ig] + sgL[ig], -rowW, sgH[ig]
	lin_ sgS[ig], -rowW - sgP[ig], sgH[ig] + railTop, sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig] + railTop
	lin_ sgS[ig], -rowW - sgP[ig], sgH[ig], sgS[ig], -rowW - sgP[ig], sgH[ig] + railTop
	lin_ sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig], sgS[ig] + sgL[ig], -rowW - sgP[ig], sgH[ig] + railTop
next ig
! ブラケット区間: 拡幅した床の輪郭（内＝躯体側 +Y、張出＝外側 -Y）
for ik = 1 to nBk
	if bkD[ik] > 0 then
		y0 = 0
		y1 = bkW[ik]
	else
		y0 = -rowW
		y1 = -rowW - bkW[ik]
	endif
	lin_ bkS[ik], y0, bkH[ik], bkS[ik], y1, bkH[ik]
	lin_ bkS[ik], y1, bkH[ik], bkE[ik], y1, bkH[ik]
	lin_ bkE[ik], y1, bkH[ik], bkE[ik], y0, bkH[ik]
	if bkD[ik] < 0 then
		lin_ bkS[ik], y1, bkH[ik] + railTop, bkE[ik], y1, bkH[ik] + railTop
	endif
next ik
! 昇降機: マストの芯線と搬器の占有範囲（足場側に隙間0.10）
for ih = 1 to nHo
	hx = hoP[ih]
	cy = -rowW - 0.10
	cyo = cy - hoD[ih]
	lin_ hx, cyo - 0.15, 0, hx, cyo - 0.15, hoR[ih] + 1.0
	lin_ hx - hoW[ih] / 2, cy, 0, hx + hoW[ih] / 2, cy, 0
	lin_ hx + hoW[ih] / 2, cy, 0, hx + hoW[ih] / 2, cyo, 0
	lin_ hx + hoW[ih] / 2, cyo, 0, hx - hoW[ih] / 2, cyo, 0
	lin_ hx - hoW[ih] / 2, cyo, 0, hx - hoW[ih] / 2, cy, 0
	lin_ hx - hoW[ih] / 2, cy, 0, hx - hoW[ih] / 2, cy, hoR[ih]
	lin_ hx + hoW[ih] / 2, cy, 0, hx + hoW[ih] / 2, cy, hoR[ih]
next ih
! 壁つなぎ: 内側建地から躯体へ（別の部品で置いたときは描かない）
nTieDraw = nTiePair
if tieObj then nTieDraw = 0
for it = 1 to nTieDraw
	lin_ ties[it], 0, tieH[it], ties[it], standoff, tieH[it]
next it
return

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! ============================================================
! 足場ライン パラメータスクリプト
! 平面のホットスポットで xEdit（支柱位置）を引いたときだけ動く。マスタースクリプトが
! 解いた spans[]・規格寸法 szL[] を使って吸着し、spanList と xEdit を書き戻す。
! GLOB_MODPAR_NAME はパラメータスクリプトで確実に取れる（マスターでは効かなかった）
! ============================================================
if GLOB_MODPAR_NAME <> "" then
	parameters lastMod = "VL:" + GLOB_MODPAR_NAME + "|" + str(vardim1(xEdit), 1, 0) + "|" + str(nSpan, 1, 0)
endif
if editSpan and GLOB_MODPAR_NAME = "xEdit" and vardim1(xEdit) = nSpan + 1 and nSz > 0 then
	! 動かした境界 i を1つだけ探す（同時に動くのは1点）
	iMv = 0
	xo = 0
	for i = 2 to nSpan
		xo = xo + spans[i - 1]
		if abs(xEdit[i] - xo) > 0.0005 and iMv = 0 then
			iMv = i
			xMv = xo
		endif
	next i
	if iMv > 0 then
		i = iMv
		pair = spans[i - 1] + spans[i]
		want = xEdit[i] - (xMv - spans[i - 1])
		! 1) 隣の境界まで引いた（残り < 最小規格の半分）: 2本を1本に結合。合計が規格寸法のときだけ
		!    （900+900→1800、1200+600→1800。1800+900 は 2700 で規格に無いので結合しない）
		okPair = 0
		for k = 1 to nSz
			if abs(pair - szL[k]) < 0.0005 then okPair = 1
		next k
		if (want < szMin / 2 or want > pair - szMin / 2) and okPair and nSpan >= 2 then
			spans[i - 1] = pair
			for j = i to nSpan - 1
				spans[j] = spans[j + 1]
			next j
			nSpan = nSpan - 1
		else
			! 2) 前のスパンを規格寸法に吸着。残りが規格寸法ならそのまま、違えば規格2本に
			!    分けて1本挿入する（1800+1800 の境界を 1500 へ引くと 1500+1500+600）。
			!    どちらもできなければ動かさない（規格外を残すと Python の入力検証で止まる）
			best = 0
			bd = 1e9
			for k = 1 to nSz
				rem = pair - szL[k]
				okRest = 0
				if abs(rem) < 0.0005 then okRest = 0
				for k2 = 1 to nSz
					if abs(rem - szL[k2]) < 0.0005 then okRest = 1
					for k3 = 1 to nSz
						if abs(rem - szL[k2] - szL[k3]) < 0.0005 then okRest = 1
					next k3
				next k2
				if okRest and abs(szL[k] - want) < bd then
					bd = abs(szL[k] - want)
					best = szL[k]
				endif
			next k
			if best > 0 and abs(best - spans[i - 1]) > 0.0005 then
				rem = pair - best
				remOk = 0
				for k2 = 1 to nSz
					if abs(rem - szL[k2]) < 0.0005 then remOk = 1
				next k2
				spans[i - 1] = best
				if remOk then
					spans[i] = rem
				else
					if nSpan < 60 then
						! 残りを「大きい方＋小さい方」の規格2本に（szL は降順で渡される）
						ra = 0
						rb = 0
						for k2 = 1 to nSz
							for k3 = k2 to nSz
								if ra = 0 and abs(rem - szL[k2] - szL[k3]) < 0.0005 then
									ra = szL[k2]
									rb = szL[k3]
								endif
							next k3
						next k2
						for j = nSpan + 1 to i + 2 step -1
							spans[j] = spans[j - 1]
						next j
						spans[i] = ra
						spans[i + 1] = rb
						nSpan = nSpan + 1
					else
						spans[i - 1] = pair - spans[i]
					endif
				endif
			endif
		endif
	endif
	! spanList を書き戻す（255文字の制限があるので 40 本ごとに spanList2 へ）
	sl1 = ""
	sl2 = ""
	for i = 1 to nSpan
		item = str(spans[i] * 1000, 1, 0)
		if i <= 40 then
			if sl1 = "" then sl1 = item else sl1 = sl1 + "," + item
		else
			if sl2 = "" then sl2 = item else sl2 = sl2 + "," + item
		endif
	next i
	parameters spanList = sl1, spanList2 = sl2
endif
! xEdit をスパンから作り直す（引いたときは吸着後の spans、それ以外は spanList が正）。
! マスタースクリプトでやると要素数の変わる配列の書き戻しで 2D・3D が描けなくなるので、ここで行う
if editSpan then
	dim xe[]
	xe[1] = 0
	for i = 1 to nSpan
		xe[i + 1] = xe[i] + spans[i]
	next i
	if vardim1(xEdit) <> nSpan + 1 or GLOB_MODPAR_NAME = "xEdit" or GLOB_MODPAR_NAME = "spanList" or GLOB_MODPAR_NAME = "spanList2" then
		parameters xEdit = xe
	endif
endif

! ---- 階段室の位置（平面の建地列の中央のホットスポットで引く） ----
! 引いた先にいちばん近いスパン境界へ吸着し、同じスパン数で長さを取り直して stairList を
! 書き戻す（階段室は支柱間に納める）。Python は stairList を読み戻して stairs.positions にする。
! Python は配置時に stairList と stEdit をそろえて送るので、両者が食い違えば「引かれた」とみなす
! （API で値を変えたときは GLOB_MODPAR_NAME が stEdit にならないため、名前では判断しない）
if editSpan and nSt > 0 then
	stDiff = 0
	if vardim1(stEdit) = nSt then
		for it = 1 to nSt
			if abs(stEdit[it] - stS[it]) > 0.001 then stDiff = 1
		next it
	endif
	if stDiff and GLOB_MODPAR_NAME <> "stairList" then
		sl = ""
		for it = 1 to nSt
			! 今の階段室が覆うスパン数
			cnt = 0
			xb = 0
			for ib = 1 to nSpan
				if xb >= stS[it] - 0.001 and xb + spans[ib] <= stS[it] + stL[it] + 0.001 then cnt = cnt + 1
				xb = xb + spans[ib]
			next ib
			if cnt < 1 then cnt = 1
			! 引いた先にいちばん近い境界（cnt スパンが面に収まるもの）
			best = stS[it]
			bl = stL[it]
			bd = 1e9
			xb = 0
			for ib = 1 to nSpan - cnt + 1
				lnSt = 0
				for j = ib to ib + cnt - 1
					lnSt = lnSt + spans[j]
				next j
				if abs(xb - stEdit[it]) < bd then
					bd = abs(xb - stEdit[it])
					best = xb
					bl = lnSt
				endif
				xb = xb + spans[ib]
			next ib
			stS[it] = best
			stL[it] = bl
			item = str(best * 1000, 1, 0) + "," + str(bl * 1000, 1, 0)
			if sl = "" then sl = item else sl = sl + "," + item
		next it
		parameters stairList = sl
	endif
	dim se[]
	for it = 1 to nSt
		se[it] = stS[it]
	next it
	! 吸着した位置・stairList の手入力・要素数の違いのときは stairList から作り直す
	if vardim1(stEdit) <> nSt or stDiff then
		parameters stEdit = se
	endif
endif

! ---- 荷受けステージの位置（張り出し床の中央のホットスポットで引く） ----
! 階段室と同じく、引いた先にいちばん近いスパン境界へ吸着して同じスパン数で長さを取り直す。
! 複数の層に置いたステージは stageList に層ごとの組が並ぶので、同じ開始位置の組をまとめて動かす
if editSpan and nSg > 0 then
	sgDiff = 0
	if vardim1(sgEdit) = nSg then
		for ig = 1 to nSg
			if abs(sgEdit[ig] - sgS[ig]) > 0.001 then sgDiff = 1
		next ig
	endif
	if sgDiff and GLOB_MODPAR_NAME <> "stageList" then
		dim sgO[]
		for ig = 1 to nSg
			sgO[ig] = sgS[ig]
		next ig
		for ig = 1 to nSg
			if abs(sgEdit[ig] - sgO[ig]) > 0.001 then
				cnt = 0
				xb = 0
				for ib = 1 to nSpan
					if xb >= sgO[ig] - 0.001 and xb + spans[ib] <= sgO[ig] + sgL[ig] + 0.001 then cnt = cnt + 1
					xb = xb + spans[ib]
				next ib
				if cnt < 1 then cnt = 1
				best = sgO[ig]
				bl = sgL[ig]
				bd = 1e9
				xb = 0
				for ib = 1 to nSpan - cnt + 1
					lnSg = 0
					for j = ib to ib + cnt - 1
						lnSg = lnSg + spans[j]
					next j
					if abs(xb - sgEdit[ig]) < bd then
						bd = abs(xb - sgEdit[ig])
						best = xb
						bl = lnSg
					endif
					xb = xb + spans[ib]
				next ib
				for jg = 1 to nSg
					if abs(sgO[jg] - sgO[ig]) < 0.001 then
						sgS[jg] = best
						sgL[jg] = bl
					endif
				next jg
			endif
		next ig
		sl = ""
		for ig = 1 to nSg
			item = str(sgS[ig] * 1000, 1, 0) + "," + str(sgL[ig] * 1000, 1, 0) + "," + str(sgP[ig] * 1000, 1, 0) + "," + str(sgH[ig] * 1000, 1, 0) + "," + str(sgZ[ig] + 2 * sgF[ig], 1, 0)
			if sl = "" then sl = item else sl = sl + "," + item
		next ig
		parameters stageList = sl
	endif
	dim sge[]
	for ig = 1 to nSg
		sge[ig] = sgS[ig]
	next ig
	if vardim1(sgEdit) <> nSg or sgDiff then
		parameters sgEdit = sge
	endif
endif

! ---- 昇降機の位置（搬器の中央のホットスポットで引く） ----
! 昇降機のマストは足場の外に立つので支柱位置には吸着しない（50mm 単位に丸め、面の範囲に収める）。
! 乗り込み口（landingList）は昇降機の位置にあるので一緒に動かす
if editSpan and nHo > 0 then
	hoDiff = 0
	if vardim1(hoEdit) = nHo then
		for ih = 1 to nHo
			if abs(hoEdit[ih] - hoP[ih]) > 0.001 then hoDiff = 1
		next ih
	endif
	if hoDiff and GLOB_MODPAR_NAME <> "hoistList" then
		for ih = 1 to nHo
			if abs(hoEdit[ih] - hoP[ih]) > 0.001 then
				hNew = int(hoEdit[ih] / 0.05 + 0.5) * 0.05
				if hNew < 0 then hNew = 0
				if hNew > lineLen then hNew = lineLen
				for il = 1 to nLa
					if abs(laP[il] - hoP[ih]) < 0.001 then laP[il] = hNew
				next il
				hoP[ih] = hNew
			endif
		next ih
		sl = ""
		for ih = 1 to nHo
			item = str(hoP[ih] * 1000, 1, 0) + "," + str(hoR[ih] * 1000, 1, 0) + "," + str(hoW[ih] * 1000, 1, 0) + "," + str(hoD[ih] * 1000, 1, 0) + "," + str(hoTp[ih] * 1000, 1, 0)
			if sl = "" then sl = item else sl = sl + "," + item
		next ih
		sl2 = ""
		for il = 1 to nLa
			item = str(laP[il] * 1000, 1, 0) + "," + str(laH[il] * 1000, 1, 0)
			if sl2 = "" then sl2 = item else sl2 = sl2 + "," + item
		next il
		parameters hoistList = sl, landingList = sl2
	endif
	dim hoe[]
	for ih = 1 to nHo
		hoe[ih] = hoP[ih]
	next ih
	if vardim1(hoEdit) <> nHo or hoDiff then
		parameters hoEdit = hoe
	endif
endif


! ---- 足場の高さ（3D の天端のホットスポットで引く） ----
! 引いた量を作業層（階高 floorH）の単位に丸め、上に層を足す／上から層を外す。支柱は上に
! 2層ぶん（2×階高）と1層ぶん（階高）を積み足すか、上から外して端数を1本で埋める。
! この面だけの暫定の形で、正式な構成（ジャッキ・壁つなぎ・数量）はパレットの「解き直し」が
! levelList を読み戻して解き直す。Python は配置時に topEdit＝ジャッキ＋支柱の合計を送る
if editSpan and serType <> "W" and nLevIn > 0 then
	if topEdit < 0.01 then
		parameters topEdit = postTop
	else
		if abs(topEdit - postTop) > 0.001 and GLOB_MODPAR_NAME <> "postList" and GLOB_MODPAR_NAME <> "levelList" then
			nStep = round_int((topEdit - postTop) / floorH)
			if nLevels + nStep < 1 then nStep = 1 - nLevels
			if nLevels + nStep > 39 then nStep = 39 - nLevels
			if nStep = 0 then
				parameters topEdit = postTop
			else
				dim pp[]
				np = nPost
				for j = 1 to nPost
					pp[j] = posts[j]
				next j
				if nStep > 0 then
					k = nStep
					while k >= 2 do
						np = np + 1
						pp[np] = 2 * floorH
						k = k - 2
					endwhile
					if k = 1 then
						np = np + 1
						pp[np] = floorH
					endif
				else
					rr = -nStep * floorH
					popped = 0
					while popped < rr - 0.0005 and np > 1 do
						popped = popped + pp[np]
						np = np - 1
					endwhile
					if popped - rr > 0.0005 then
						np = np + 1
						pp[np] = popped - rr
					endif
				endif
				pl = ""
				newTop = jackOut
				for j = 1 to np
					newTop = newTop + pp[j]
					item = str(pp[j] * 1000, 1, 0)
					if pl = "" then pl = item else pl = pl + "," + item
				next j
				nNew = nLevels + nStep
				ll = ""
				for il = 1 to nNew
					if il <= nLevels then
						hv = levIn[il]
					else
						hv = levIn[nLevels] + (il - nLevels) * floorH
					endif
					item = str(hv * 1000, 1, 0)
					if ll = "" then ll = item else ll = ll + "," + item
				next il
				parameters postList = pl, levelList = ll, topEdit = newTop
			endif
		endif
	endif
endif
! ---- 区切る位置（3D のつまみで引く。利用者の指定 2026-10-21「クリックした次のところから区切る、3Dで」） ----
! 引いた位置の次の区切り目に吸着する。縦は支柱の芯（部品の始点 pxA から測る）、横は作業床の 100 下
! （部品の下端から測る）。区切り目が無ければ 0（区切らない）。区切るのはパレットの「区切る」
if GLOB_MODPAR_NAME = "cutAtX" and cutAtX > 0.0005 then
	cxSnap = 0
	xq = 0
	for i = 1 to sB - 1
		xq = xq + spans[i]
		if i >= sA and cxSnap = 0 and xq >= pxA + cutAtX - 0.001 then cxSnap = xq - pxA
	next i
	parameters cutAtX = cxSnap
endif
if GLOB_MODPAR_NAME = "cutAtZ" and cutAtZ > 0.0005 then
	zBase = 0
	if lA > 1 then zBase = gzA
	czSnap = 0
	for k = lA + 1 to lB
		zc = lv[k + 1] - 0.1
		if czSnap = 0 and zc >= zBase + cutAtZ - 0.001 then czSnap = zc - zBase
	next k
	parameters cutAtZ = czSnap
endif

