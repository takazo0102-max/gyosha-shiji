! ==========================================================
! 壁の型枠（せき板・桟木・外端太・フォームタイ。1枚の壁に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_wform/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_wform.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-31）: 型枠を作る仕組みを作成して さんぎ そとばた フォームタイを作って既存のモデルに自動配置するようにして。
! 原点＝壁の右の面の始めの下、+X＝壁の向き、壁は +Y の側（厚さ wT）。両面にせき板（合板 12）、桟木（45×60 縦・sgX）、外端太（単管2本組 横・tbZ）、フォームタイ（tiX×tbZ。Pコン・座金・ナット）。割付と計算は wall_form.py、置くのは scripts/form_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   wT        長さ      壁の厚さ                                                          既定 0.2
!   sgX       文字列    右の面（−Y の側）の桟木の位置（壁の始めから mm、カンマ区切り）    既定 "150,400,650"
!   sgX2      文字列    左の面（壁の向こう +Y の側）の桟木の位置（同）                    既定 "150,400,650"
!   f1S       長さ      右の面の型枠の始め（壁の始めから。角で延ばす・縮める）            既定 0
!   f1E       長さ      右の面の型枠の終わり                                              既定 6.0
!   f2S       長さ      左の面の型枠の始め                                                既定 0
!   f2E       長さ      左の面の型枠の終わり                                              既定 6.0
!   tbZ       文字列    外端太の高さ（壁の下から mm）                                     既定 "150,600,1050"
!   tiX       文字列    フォームタイの位置（壁の始めから mm）                             既定 "150,900"
!   plyT      長さ      せき板の厚さ                                                      既定 0.012
!   sgB       長さ      桟木の幅                                                          既定 0.045
!   sgH       長さ      桟木のせい（合板に直角）                                          既定 0.06
!   tbOut     長さ      止め型枠の押さえの単管の出（壁の厚さの外へ）                      既定 0.1
!   t1S       長さ      右の面の外端太の始め（壁の始めから。角では相手の外端太の線まで）  既定 -0.15
!   t1E       長さ      右の面の外端太の終わり                                            既定 6.15
!   t2S       長さ      左の面の外端太の始め                                              既定 -0.15
!   t2E       長さ      左の面の外端太の終わり                                            既定 6.15
!   endS      ブール    始めの端に止め型枠（ほかの壁につながらない端）                    既定 0
!   endE      ブール    終わりの端に止め型枠                                              既定 0
!   cName     文字列    名前（平面の注記）                                                既定 "壁型枠"
!   cNote     文字列    間隔の注記                                                        既定 ""
!   texSiz    実数      文字の大きさ（mm）                                                既定 2.5
!   penEquip  PenColor  線のペン                                                          既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 壁の型枠: 桟木・外端太・フォームタイの位置を読む（m）
dim sx[]
nS = 0
rest = sgX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS = nS + 1
		sx[nS] = v / 1000
	endif
endwhile
dim sx2[]
nS2 = 0
rest = sgX2
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS2 = nS2 + 1
		sx2[nS2] = v / 1000
	endif
endwhile
dim tz[]
nT = 0
rest = tbZ
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nT = nT + 1
		tz[nT] = v / 1000
	endif
endwhile
dim tx[]
nX = 0
rest = tiX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nX = nX + 1
		tx[nX] = v / 1000
	endif
endwhile
! 外端太の外の面の位置（せき板の面から）
r = 0.0243
yS = plyT + sgH
yT = yS + r

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 壁の型枠 2D: せき板（両面）、桟木、外端太、フォームタイ、名前
pE = penEquip
if pE < 1 then pE = 1
pen pE
define style "wfT" "ＭＳ Ｐゴシック", texSiz, 1, 0
! せき板（面ごとの範囲。角で延ばす・縮める）
rect2 f1S, -plyT, f1E, 0
rect2 f2S, wT, f2E, wT + plyT
! 桟木
for i = 1 to nS
	rect2 sx[i] - sgB / 2, -yS, sx[i] + sgB / 2, -plyT
next i
for i = 1 to nS2
	rect2 sx2[i] - sgB / 2, wT + plyT, sx2[i] + sgB / 2, wT + yS
next i
! 外端太（単管）
line_type "DASHED"
line2 t1S, -yT, t1E, -yT
line2 t2S, wT + yT, t2E, wT + yT
line_type 1
! 止め型枠
if endS then
	rect2 -plyT, -plyT, 0, wT + plyT
	line2 -plyT - sgH - r, -yT - tbOut, -plyT - sgH - r, wT + yT + tbOut
endif
if endE then
	rect2 A, -plyT, A + plyT, wT + plyT
	line2 A + plyT + sgH + r, -yT - tbOut, A + plyT + sgH + r, wT + yT + tbOut
endif
! フォームタイ
for i = 1 to nX
	line2 tx[i], -yT - 0.06, tx[i], wT + yT + 0.06
	rect2 tx[i] - 0.03, -yT - 0.03, tx[i] + 0.03, -yT - 0.024
	rect2 tx[i] - 0.03, wT + yT + 0.024, tx[i] + 0.03, wT + yT + 0.03
next i
style "wfT"
text2 A / 2, -yT - 0.12, cName + "  " + cNote

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 壁の型枠 3D（利用者の指定 2026-10-31: さんぎ そとばた フォームタイ）
! - せき板（合板 12mm）: 壁の両面
! - 桟木（45×60）: せき板の外に縦
! - 外端太（単管 φ48.6 の2本組）: 桟木の外に横。2本でフォームタイを上下にはさむ
! - フォームタイ: 壁を貫く。内側の両端に Pコン（せき板の内面）、外は座金とナット
! ============================================================
resol 12
define material "wf_ply" 2, 0.86, 0.66, 0.38
define material "wf_wood" 2, 0.74, 0.56, 0.36
define material "wf_steel" 2, 0.62, 0.62, 0.66
define material "wf_tie" 2, 0.35, 0.35, 0.38
define material "wf_pcon" 2, 0.85, 0.85, 0.80
H = ZZYZX
gap = 0.006
for side = 1 to 2
	if side = 1 then
		y0 = 0
		sg = -1
		fS = f1S
		fE = f1E
		tS = t1S
		tE = t1E
		nn = nS
	else
		y0 = wT
		sg = 1
		fS = f2S
		fE = f2E
		tS = t2S
		tE = t2E
		nn = nS2
	endif
	! ---- せき板 ----
	material "wf_ply"
	if sg < 0 then
		add fS, -plyT, 0
	else
		add fS, wT, 0
	endif
	block fE - fS, plyT, H
	del 1
	! ---- 桟木 ----
	material "wf_wood"
	for i = 1 to nn
		if sg < 0 then
			add sx[i] - sgB / 2, -yS, 0
		else
			add sx2[i] - sgB / 2, wT + plyT, 0
		endif
		block sgB, sgH, H
		del 1
	next i
	! ---- 外端太（2本組） ----
	material "wf_steel"
	for j = 1 to nT
		for k = -1 to 1 step 2
			add tS, y0 + sg * yT, tz[j] + k * (r + gap)
			roty 90
			cylind tE - tS, r
			del 2
		next k
	next j
next side
! ---- 止め型枠（ほかの壁につながらない端）: 合板・縦の桟木2本・段ごとに押さえの単管（両面の外端太の出に直交クランプ） ----
for ee = 1 to 2
	if (ee = 1 and endS) or (ee = 2 and endE) then
		if ee = 1 then
			xe = 0
			dx = -1
		else
			xe = A
			dx = 1
		endif
		material "wf_ply"
		add xe + (dx - 1) / 2 * plyT, -plyT, 0
		block plyT, wT + 2 * plyT, H
		del 1
		material "wf_wood"
		for q = 1 to 2
			add xe + dx * plyT + (dx - 1) / 2 * sgH, wT * q / 3 - sgB / 2, 0
			block sgH, sgB, H
			del 1
		next q
		material "wf_steel"
		for j = 1 to nT
			add xe + dx * (plyT + sgH + r), -yT - tbOut, tz[j]
			rotx -90
			cylind wT + 2 * yT + 2 * tbOut, r
			del 2
		next j
	endif
next ee
! ---- フォームタイ ----
for j = 1 to nT
	for i = 1 to nX
		add tx[i], 0, tz[j]
		! 棒（外の座金の先まで）
		material "wf_tie"
		add 0, -yT - r - 0.05, 0
		rotx -90
		cylind wT + 2 * (yT + r + 0.05), 0.00395
		del 2
		! Pコン（せき板の内面に。壁の中へ 25）
		material "wf_pcon"
		add 0, 0, 0
		rotx -90
		cone 0.025, 0.012, 0.0175, 90, 90
		del 2
		add 0, wT, 0
		rotx 90
		cone 0.025, 0.012, 0.0175, 90, 90
		del 2
		! 座金（2本の外端太にまたがる）とナット
		material "wf_tie"
		for sd = 1 to 2
			if sd = 1 then
				yy = -yT - r
				dd = -1
				yb = yy - 0.006
			else
				yy = wT + yT + r
				dd = 1
				yb = yy
			endif
			add -0.035, yb, -(2 * r + gap)
			block 0.07, 0.006, 2 * (2 * r + gap)
			del 1
			add 0, yy + dd * 0.006, 0
			if dd < 0 then
				rotx 90
			else
				rotx -90
			endif
			cylind 0.03, 0.012
			del 2
		next sd
		del 1
	next i
next j

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================


