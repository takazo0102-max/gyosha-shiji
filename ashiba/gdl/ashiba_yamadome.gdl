! ==========================================================
! 根切りの山留めまわり（切梁上の足場・山留め上の手すり。1本の切梁・1辺の山留めに1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_yamadome/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_yamadome.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-31）: https://www.seinankizai.jp/product/b_b/136/ 切張り上の足場を追加して 山留め上の手すり リサーチして追加して。
! ymKind 1＝切梁上の足場（西南機材 切梁ブラケット＋嵩上金具 W900＋伸縮手摺柱。brX の位置、床 deckW・deckZ、手すり railH・中桟 midH・幅木 toeH）、2＝山留め上の手すり（親杭の天端に単管の手すり柱をキャッチクランプで）。割付・数量・検定は excavation.py、置くのは scripts/excav_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   ymKind    整数      種類（1＝切梁上の足場・2＝山留め上の手すり）              既定 1
!   ymL       長さ      長さ（切梁・山留めの向き）                                既定 6
!   flgW      長さ      切梁の H形鋼のフランジの幅                                既定 0.3
!   brX       文字列    ブラケット・手すり柱の位置（mm。始めから、カンマ区切り）  既定 "150,1950,3750,5550"
!   postSp    長さ      切梁上: 嵩上金具・手すり柱の間（芯々。W900）              既定 0.9
!   deckZ     長さ      切梁上: 床の上端の高さ（フランジの上から。嵩上金具）      既定 0.3
!   deckW     長さ      切梁上: 床幅（鋼製布板）                                  既定 0.5
!   railH     長さ      手すりの高さ（床・天端から）                              既定 0.95
!   midH      長さ      中桟の高さ（床・天端から）                                既定 0.45
!   toeH      長さ      幅木の高さ                                                既定 0.15
!   postDn    長さ      山留め上: 手すり柱を親杭に留める深さ（天端から下へ）      既定 0.35
!   ymName    文字列    名前（平面の注記）                                        既定 "切梁上の足場"
!   texSiz    実数      文字の大きさ（mm）                                        既定 2.5
!   penEquip  PenColor  線のペン                                                  既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 根切りの山留めまわり: ブラケット・手すり柱の位置を読む（m）
dim bx[]
nB = 0
rest = brX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nB = nB + 1
		bx[nB] = v / 1000
	endif
endwhile
hp = postSp / 2
r = 0.0243

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 根切りの山留めまわり 2D
pen penEquip
define style "ymT" "ＭＳ Ｐゴシック", texSiz, 1, 0
style "ymT"
if ymKind = 1 then
	! 切梁上の足場: 床の外形・手すり柱・ブラケット
	rect2 0, -deckW / 2, ymL, deckW / 2
	line2 0, -hp, ymL, -hp
	line2 0, hp, ymL, hp
	for i = 1 to nB
		line2 bx[i], -hp - 0.05, bx[i], hp + 0.05
		circle2 bx[i], -hp, r
		circle2 bx[i], hp, r
	next i
	text2 ymL / 2, hp + 0.25, ymName
else
	! 山留め上の手すり: 手すりの線と柱
	line2 0, 0.06, ymL, 0.06
	for i = 1 to nB
		circle2 bx[i], 0, r
	next i
	text2 ymL / 2, 0.35, ymName
endif
hotspot2 0, 0
hotspot2 ymL, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 根切りの山留めまわり 3D
define material "ym_steel" 2, 0.62, 0.64, 0.68
define material "ym_deck" 2, 0.55, 0.57, 0.6
define material "ym_toe" 2, 0.85, 0.75, 0.2
material "ym_steel"
resol 12
if ymKind = 1 then
	! ---- 切梁上の足場（切梁ブラケット＋嵩上金具＋伸縮手摺柱） ----
	for i = 1 to nB
		x = bx[i]
		! 切梁ブラケット: フランジを両側から挟む受けと、両端の φ42.7 まで渡る腕
		for sd = -1 to 1 step 2
			add x - 0.04, sd * (flgW / 2 + 0.02) - 0.02, -0.03
			block 0.08, 0.04, 0.06
			del 1
		next sd
		add x - 0.03, -hp - 0.03, 0.03
		block 0.06, postSp + 0.06, 0.05
		del 1
		! 嵩上金具の柱（φ48.6）と伸縮手摺柱（φ42.7）。床の下に床受けの横材
		for sd = -1 to 1 step 2
			add x, sd * hp, 0.03
			cylind deckZ + railH - 0.03, r
			del 1
		next sd
		add x, -hp, deckZ - 0.06
		rotx -90
		cylind postSp, 0.0214
		del 2
	next i
	! 床（鋼製布板）
	material "ym_deck"
	add 0, -deckW / 2, deckZ - 0.04
	block ymL, deckW, 0.04
	del 1
	material "ym_steel"
	! 手すり・中桟（両側）
	for sd = -1 to 1 step 2
		for hh = 1 to 2
			zr = railH
			if hh = 2 then zr = midH
			add 0, sd * (hp + 0.05), deckZ + zr
			roty 90
			cylind ymL, r
			del 2
		next hh
		! 幅木（幅木クランプで柱に）
		material "ym_toe"
		add 0, sd * (hp - 0.03) - 0.005, deckZ
		block ymL, 0.01, toeH
		del 1
		material "ym_steel"
	next sd
else
	! ---- 山留め上の手すり（親杭の天端に単管の手すり柱をキャッチクランプで） ----
	for i = 1 to nB
		add bx[i], 0, -postDn
		cylind postDn + railH + 0.05, r
		del 1
		! キャッチクランプ（2個1組）
		for k = 1 to 2
			add bx[i] - 0.04, -0.06, -postDn * k / 3 - 0.02
			block 0.08, 0.12, 0.04
			del 1
		next k
	next i
	for hh = 1 to 2
		zr = railH
		if hh = 2 then zr = midH
		add 0, 0.05, zr
		roty 90
		cylind ymL, r
		del 2
	next hh
	material "ym_toe"
	add 0, 0.03, 0
	block ymL, 0.01, toeH
	del 1
endif
end

