! ==========================================================
! コーナーステップ（くさびの隅の隙間を塞ぐ踏板・1つの隅に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_cstep/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_cstep.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-23）: くさびの隅が寸法（フィート）で繋がらないところは無理に繋がず、コーナーステップで納める。
! 原点＝隙間を持つ面の最後の支柱（内側建地列）、faceAng で面の向き。平面は枠と×と「CS 隙間」、3Dは各層の踏板と外側の手すり・中桟・幅木。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度    面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）  既定 0
!   gapL      長さ    隙間の長さ（面に沿う方向。面の最後の支柱から隅まで）                  既定 0.25
!   rowW      長さ    建地列の間隔（外側建地列は -rowW）                                    既定 0.61
!   lvList    文字列  作業床の高さ mm（GLから）カンマ区切り                                 既定 "1830,3630,5430"
!   railOn    ブール  外側の手すり・中桟・幅木を描く                                        既定 1
!   railH     長さ    手すりの高さ（床から）                                                既定 0.9
!   lineMode  ブール  3Dを線で（軽い）                                                      既定 0
!   matDeck   表面材  表面材（0＝既定）                                                     既定 0
!   plW1      長さ    踏板1枚目の幅（CS05＝0.50、CS02＝0.24）                               既定 0.5
!   plW2      長さ    踏板2枚目の幅（無ければ 0）                                           既定 0
!   plL       長さ    踏板の長さ（爪の付け根から先端。CS は 460）                           既定 0.46
!   hookL     長さ    爪の出（布材に掛ける側。CS は 65）                                    既定 0.065
!   flipX     ブール  爪を隙間の +X の端に掛ける（面の始点の側の隙間）                      既定 0
!   stepName  文字列  品番（例: NDCS05＋NDCS02）                                            既定 "コーナーステップ"
!   texSiz    実数    文字高mm                                                              既定 2.0
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! コーナーステップ（くさびの隅の隙間を塞ぐ踏板。各層に1組）。1つの隅に1部品

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! コーナーステップ 2D（平面）: 隅の隙間に掛けるコーナーステップをカタログの形で描く
! 利用者の指定（2026-10-23）: 繋がらない隅はコーナーステップで納める。隙間の×は不要、ステップは詳細に
!   CS05（踏板 500）・CS02（踏板 240）: 爪 65（布材に掛ける）＋縞鋼板 460、t=3.2
! 原点＝隙間を持つ面の最後の支柱（内側建地列 y=0、外側建地列 y=-rowW）。踏板は爪を面の布材に掛け、
! 隙間をまたいで隣の面の隅の床に載る
! ============================================================
define style "csTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
pen 1
rot2 faceAng
if flipX then
	add2 gapL, 0
	mul2 -1, 1
endif
! 踏板（建地列の間に並べる。床と同じく内側から）
nPl = 1
if plW2 > 0.001 then nPl = 2
totW = plW1 + plW2
y0 = -(rowW - totW) / 2
for ip = 1 to nPl
	w = plW1
	if ip = 2 then w = plW2
	yA = y0
	yB = y0 - w
	! 縞鋼板の外形と、先端の折り曲げ（20 手前）
	rect2 0, yB, plL, yA
	line2 plL - 0.02, yB, plL - 0.02, yA
	! 縞模様（斜めの短い線を交互に。カタログの縞鋼板の見え方）
	pen 2
	dx = 0.06
	nx = int((plL - 0.04) / dx)
	ny = int(w / dx)
	for ix = 0 to nx - 1
		for iy = 0 to ny - 1
			cx = 0.03 + ix * dx + dx / 2
			cy = yA - iy * dx - dx / 2
			if ix + iy - 2 * int((ix + iy) / 2) = 0 then
				line2 cx - 0.015, cy - 0.008, cx + 0.015, cy + 0.008
			else
				line2 cx - 0.015, cy + 0.008, cx + 0.015, cy - 0.008
			endif
		next iy
	next ix
	pen 1
	! 爪（布材に掛けるフック。踏板の両端に1つずつ）
	rect2 -hookL, yA - 0.035, 0, yA
	rect2 -hookL, yB, 0, yB + 0.035
	circle2 -hookL / 2, yA - 0.0175, 0.008
	circle2 -hookL / 2, yB + 0.0175, 0.008
	y0 = yB
next ip
del top
rot2 faceAng
hotspot2 0, 0
hotspot2 gapL, 0
hotspot2 gapL, -rowW
hotspot2 0, -rowW
! 品番は足場の外側（北・西を向く面でも読める向きに）
set style "csTx"
add2 gapL / 2, -rowW - 0.25
if faceAng > 90.001 and faceAng < 270.001 then rot2 180
text2 0, 0, stepName
del top

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! コーナーステップ 3D: 各層の床の高さに踏板（隙間×建地列の間隔）、外側に手すり・中桟・幅木
! 原点＝隙間を持つ面の最後の支柱（内側建地列）、+X＝面に沿う方向、外側建地列は -rowW
! ============================================================
pen 1
resol 8
rotz faceAng
if flipX then
	addx gapL
	mulx -1
endif
dim lv[]
nLv = 0
s = lvList
while strlen(s) > 0 and nLv < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	v = 0
	nn = split(tk, "%n", v)
	if nn > 0 then
		nLv = nLv + 1
		lv[nLv] = v / 1000
	endif
endwhile
if matDeck > 0 then
	material matDeck
else
	define material "ashiba_cstep_steel" 2, 0.62, 0.64, 0.66
	material "ashiba_cstep_steel"
endif
for i = 1 to nLv
	z = lv[i]
	if lineMode then
		lin_ 0, -rowW, z, gapL, -rowW, z
		lin_ gapL, -rowW, z, gapL, 0, z
		lin_ gapL, 0, z, 0, 0, z
		lin_ 0, 0, z, 0, -rowW, z
	else
		! 縞鋼板（t=3.2）を床の上に。爪は布材に掛ける（踏板の両端）
		y0 = -(rowW - plW1 - plW2) / 2
		for ip = 1 to 2
			w = plW1
			if ip = 2 then w = plW2
			if w > 0.001 then
				add 0, y0 - w, z
				block plL, w, 0.0032
				add -hookL, 0, -0.03
				block hookL, 0.035, 0.035
				add 0, w - 0.035, 0
				block hookL, 0.035, 0.035
				del 3
				y0 = y0 - w
			endif
		next ip
		if railOn then
			! 外側の幅木（H150）と手すり・中桟（φ27.2）
			add 0, -rowW - 0.03, z
			block gapL, 0.012, 0.15
			del 1
			for h = 1 to 2
				add 0, -rowW - 0.02, z + railH * h / 2
				roty 90
				cylind gapL, 0.0136
				del 2
			next h
		endif
	endif
next i
del top

