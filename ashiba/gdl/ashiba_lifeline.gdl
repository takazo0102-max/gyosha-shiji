! ==========================================================
! 親綱と親綱支柱（鉄骨梁の上。1本の梁に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_lifeline/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_lifeline.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-11-01）: 親綱と親綱支柱も追加して。
! 原点＝梁の芯の始め（上フランジの上）、+X＝梁の向き。支柱は両端から llEnd 入れて nSpan スパンに等分、postK 1 NTP・2 ALPA12（日建リース Vol.10 p196）、親綱はスパンごとに1本と緊張器。割付と判定は lifeline.py、置くのは scripts/lifeline_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   llL       長さ      梁（線）の長さ                                                      既定 24.0
!   nSpan     整数      スパンの数（0＝張れない）                                           既定 3
!   llEnd     長さ      梁の端から支柱まで                                                  既定 0.3
!   postK     整数      親綱支柱（1 NTP H鋼取付用・2 ALPA12 アルミ）                        既定 1
!   llName    文字列    名前（注記）                                                        既定 "親綱1"
!   llDrop    文字列    落差の注記                                                          既定 "落差 8.0m"
!   texSiz    実数      文字の大きさ（mm）                                                  既定 2.5
!   penBold   PenColor  外形の線（太線。置くときに線のペンと同じ色の太いペン）              既定 21
!   penThin   PenColor  細部の線（細線。同じ色の細いペン）                                  既定 1
!   penZone   PenColor  範囲の線（作業半径・後端旋回半径・立入禁止・旋回軌跡）              既定 20
!   penMask   PenColor  上に載るものの背景の塗り（下の線を隠す。0＝隠さない）               既定 19
!   drMode    整数      平面の描き分け（0 縮尺で自動・1 詳細 1/100・2 標準 1/200・3 簡略）  既定 0
!   penEquip  PenColor  線のペン                                                            既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 親綱: 支柱の位置（両端から llEnd、nSpan に等分）と支柱の高さ
nS = max(0, nSpan)
spL = 0
if nS > 0 then spL = max(0, llL - 2 * llEnd) / nS
pH = 1.045
if postK = 2 then pH = 1.081
rpZ = pH - 0.06

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 親綱 2D（CAD の平面図の描き方: scripts/gdl_draft.py）: 梁の芯は一点鎖線（細線）、親綱支柱は太線、親綱は破線の太線。
! 縮尺で 詳細（支柱の H 形のベース）・標準（支柱は小さな箱）・簡略（親綱の線と名前だけ）。注記の行送りは縮尺に合わせる
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "llT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "llT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
if drLv < 3 then
	pen pT
	line_type ltC
	line2 0, 0, llL, 0
	line_type ltS
endif
if nS > 0 then
	if drLv < 3 then
		pen pO
		for i = 0 to nS
			px = llEnd + i * spL
			rect2 px - 0.065, -0.0975, px + 0.065, 0.0975
			if drLv = 1 then line2 px - 0.065, -0.0975, px + 0.065, 0.0975
		next i
	endif
	pen pO
	line_type ltH
	for i = 1 to nS
		line2 llEnd + (i - 1) * spL + 0.07, 0.03, llEnd + i * spL - 0.07, 0.03
	next i
	line_type ltS
endif
pen penEquip
add2 llL / 2, 0
rot2 -SYMB_ROTANGLE
tx = llName + " 親綱 " + str(nS, 1, 0) + "スパン（1スパン1人）"
if nS = 0 then tx = llName + " 親綱は張れない（水平ネット等）"
text2 0, 0.3 + 1.5 * dT, tx
if drLv < 3 then text2 0, 0.3 + 0.5 * dT, llDrop
del 2
hotspot2 0, 0
hotspot2 llL, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 親綱 3D: 親綱支柱（フランジをくわえる金具・角パイプの柱・頭の受け）、スパンごとの親綱と緊張器
define material "ll_post" 2, 0.85, 0.65, 0.10
define material "ll_alu" 2, 0.80, 0.82, 0.85
define material "ll_clamp" 2, 0.35, 0.36, 0.38
define material "ll_rope" 2, 0.80, 0.62, 0.30
resol 8
if nS > 0 then
	for i = 0 to nS
		px = llEnd + i * spL
		material "ll_clamp"
		add px - 0.065, -0.0975, -0.03
		block 0.13, 0.195, 0.22
		del 1
		material "ll_post"
		if postK = 2 then material "ll_alu"
		add px - 0.0225, -0.0375, 0.19
		block 0.045, 0.075, pH - 0.19
		del 1
		add px - 0.025, -0.115, pH - 0.012
		block 0.05, 0.23, 0.012
		del 1
	next i
	for i = 1 to nS
		x0 = llEnd + (i - 1) * spL
		material "ll_rope"
		add x0 + 0.03, 0, rpZ
		roty 90
		cylind spL - 0.06, 0.006
		del 2
		material "ll_clamp"
		add x0 + spL - 0.45, -0.03, rpZ - 0.05
		block 0.12, 0.06, 0.1
		del 1
	next i
endif

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 親綱: 支柱の一覧
values{2} "postK" 1, "親綱支柱（H鋼取付用）NTP", 2, "アルミ製親綱支柱 ALPA12"

