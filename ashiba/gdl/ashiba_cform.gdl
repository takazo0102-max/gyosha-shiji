! ==========================================================
! 柱の型枠（せき板・桟木・外端太・フォームタイ。1本の柱に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_cform/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_cform.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-31）: 型枠を作る仕組みを作成して さんぎ そとばた フォームタイを作って既存のモデルに自動配置するようにして。
! 原点＝柱の芯の下、+X＝幅 A、+Y＝奥行き B。4面にせき板（±Y の面は小口を覆う）、桟木（sgX・sgY）、外端太（単管2本組。±X の面は dzB 上げて交差を逃がす）、フォームタイ（tiX・tiY。両端は角の外、間は柱を貫いて Pコン）。割付と計算は column_form.py、置くのは scripts/form_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   ply1      文字列    +Y の面のせき板の区間（面の座標 s mm、始め,終わり の組。壁の取り付く所で分ける）  既定 "-312,312"
!   sg1       文字列    +Y の面の桟木の位置（面の座標 s mm）                                              既定 "-250,0,250"
!   tb1       文字列    +Y の面の外端太の区間（面の座標 s mm）                                            既定 "-551,551"
!   ply2      文字列    −X の面のせき板の区間（面の座標 s mm、始め,終わり の組。壁の取り付く所で分ける）  既定 "-300,300"
!   sg2       文字列    −X の面の桟木の位置（面の座標 s mm）                                              既定 "-250,0,250"
!   tb2       文字列    −X の面の外端太の区間（面の座標 s mm）                                            既定 "-551,551"
!   ply3      文字列    −Y の面のせき板の区間（面の座標 s mm、始め,終わり の組。壁の取り付く所で分ける）  既定 "-312,312"
!   sg3       文字列    −Y の面の桟木の位置（面の座標 s mm）                                              既定 "-250,0,250"
!   tb3       文字列    −Y の面の外端太の区間（面の座標 s mm）                                            既定 "-551,551"
!   ply4      文字列    +X の面のせき板の区間（面の座標 s mm、始め,終わり の組。壁の取り付く所で分ける）  既定 "-300,300"
!   sg4       文字列    +X の面の桟木の位置（面の座標 s mm）                                              既定 "-250,0,250"
!   tb4       文字列    +X の面の外端太の区間（面の座標 s mm）                                            既定 "-551,551"
!   tbZ       文字列    外端太の高さ（柱の下から mm。±X の面は dzB 上）                                   既定 "150,450,750"
!   tiX       文字列    Y の向きに締めるフォームタイの X の位置（芯から mm。両端は角の外）                既定 "-451,451"
!   tiY       文字列    X の向きに締めるフォームタイの Y の位置（芯から mm）                              既定 "-451,451"
!   dzB       長さ      ±X の面の外端太を上げる高さ                                                       既定 0.12
!   clampOn   ブール    コラムクランプで締める（外端太・フォームタイのかわり。tbZ の高さに4方の腕）       既定 0
!   clH       長さ      コラムクランプの腕のせい                                                          既定 0.075
!   clT       長さ      コラムクランプの腕の出（合板に直角）                                              既定 0.04
!   plyT      長さ      せき板の厚さ                                                                      既定 0.012
!   sgB       長さ      桟木の幅                                                                          既定 0.045
!   sgH       長さ      桟木のせい（合板に直角）                                                          既定 0.06
!   tbOver    長さ      外端太の、角の外のフォームタイからの出                                            既定 0.1
!   cName     文字列    名前（平面の注記）                                                                既定 "柱型枠"
!   cNote     文字列    間隔の注記                                                                        既定 ""
!   texSiz    実数      文字の大きさ（mm）                                                                既定 2.5
!   penEquip  PenColor  線のペン                                                                          既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 柱の型枠: 桟木・外端太・フォームタイの位置を読む（m）
dim pl1[]
nPl1 = 0
rest = ply1
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPl1 = nPl1 + 1
		pl1[nPl1] = v / 1000
	endif
endwhile
dim sg1a[]
nSg1 = 0
rest = sg1
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSg1 = nSg1 + 1
		sg1a[nSg1] = v / 1000
	endif
endwhile
dim tb1a[]
nTb1 = 0
rest = tb1
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTb1 = nTb1 + 1
		tb1a[nTb1] = v / 1000
	endif
endwhile
dim pl2[]
nPl2 = 0
rest = ply2
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPl2 = nPl2 + 1
		pl2[nPl2] = v / 1000
	endif
endwhile
dim sg2a[]
nSg2 = 0
rest = sg2
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSg2 = nSg2 + 1
		sg2a[nSg2] = v / 1000
	endif
endwhile
dim tb2a[]
nTb2 = 0
rest = tb2
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTb2 = nTb2 + 1
		tb2a[nTb2] = v / 1000
	endif
endwhile
dim pl3[]
nPl3 = 0
rest = ply3
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPl3 = nPl3 + 1
		pl3[nPl3] = v / 1000
	endif
endwhile
dim sg3a[]
nSg3 = 0
rest = sg3
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSg3 = nSg3 + 1
		sg3a[nSg3] = v / 1000
	endif
endwhile
dim tb3a[]
nTb3 = 0
rest = tb3
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTb3 = nTb3 + 1
		tb3a[nTb3] = v / 1000
	endif
endwhile
dim pl4[]
nPl4 = 0
rest = ply4
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPl4 = nPl4 + 1
		pl4[nPl4] = v / 1000
	endif
endwhile
dim sg4a[]
nSg4 = 0
rest = sg4
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSg4 = nSg4 + 1
		sg4a[nSg4] = v / 1000
	endif
endwhile
dim tb4a[]
nTb4 = 0
rest = tb4
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTb4 = nTb4 + 1
		tb4a[nTb4] = v / 1000
	endif
endwhile
dim tz[]
nT = 0
rest = tbZ
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nT = nT + 1
		tz[nT] = v / 1000
	endif
endwhile
dim tx[]
nX = 0
rest = tiX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nX = nX + 1
		tx[nX] = v / 1000
	endif
endwhile
dim ty[]
nY = 0
rest = tiY
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nY = nY + 1
		ty[nY] = v / 1000
	endif
endwhile
r = 0.0243
hA = A / 2
hB = B / 2
! 外端太の芯（面から）
yT = hB + plyT + sgH + r
xT = hA + plyT + sgH + r

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 柱の型枠 2D
pE = penEquip
if pE < 1 then pE = 1
pen pE
define style "cfT" "ＭＳ Ｐゴシック", texSiz, 1, 0
! 面ごとのせき板・桟木・外端太
rot2 0
for i = 1 to int(nPl1 / 2)
	rect2 pl1[2 * i - 1], hB, pl1[2 * i], hB + plyT
next i
for i = 1 to nSg1
	rect2 sg1a[i] - sgB / 2, hB + plyT, sg1a[i] + sgB / 2, hB + plyT + sgH
next i
if clampOn then
	rect2 -hA - plyT - sgH - 0.12, hB + plyT + sgH, hA + plyT + sgH + 0.12, hB + plyT + sgH + clT
endif
line_type "DASHED"
for i = 1 to int(nTb1 / 2)
	line2 tb1a[2 * i - 1], hB + plyT + sgH + r, tb1a[2 * i], hB + plyT + sgH + r
next i
line_type 1
del 1
rot2 90
for i = 1 to int(nPl2 / 2)
	rect2 pl2[2 * i - 1], hA, pl2[2 * i], hA + plyT
next i
for i = 1 to nSg2
	rect2 sg2a[i] - sgB / 2, hA + plyT, sg2a[i] + sgB / 2, hA + plyT + sgH
next i
if clampOn then
	rect2 -hB - plyT - sgH - 0.12, hA + plyT + sgH, hB + plyT + sgH + 0.12, hA + plyT + sgH + clT
endif
line_type "DASHED"
for i = 1 to int(nTb2 / 2)
	line2 tb2a[2 * i - 1], hA + plyT + sgH + r, tb2a[2 * i], hA + plyT + sgH + r
next i
line_type 1
del 1
rot2 180
for i = 1 to int(nPl3 / 2)
	rect2 pl3[2 * i - 1], hB, pl3[2 * i], hB + plyT
next i
for i = 1 to nSg3
	rect2 sg3a[i] - sgB / 2, hB + plyT, sg3a[i] + sgB / 2, hB + plyT + sgH
next i
if clampOn then
	rect2 -hA - plyT - sgH - 0.12, hB + plyT + sgH, hA + plyT + sgH + 0.12, hB + plyT + sgH + clT
endif
line_type "DASHED"
for i = 1 to int(nTb3 / 2)
	line2 tb3a[2 * i - 1], hB + plyT + sgH + r, tb3a[2 * i], hB + plyT + sgH + r
next i
line_type 1
del 1
rot2 270
for i = 1 to int(nPl4 / 2)
	rect2 pl4[2 * i - 1], hA, pl4[2 * i], hA + plyT
next i
for i = 1 to nSg4
	rect2 sg4a[i] - sgB / 2, hA + plyT, sg4a[i] + sgB / 2, hA + plyT + sgH
next i
if clampOn then
	rect2 -hB - plyT - sgH - 0.12, hA + plyT + sgH, hB + plyT + sgH + 0.12, hA + plyT + sgH + clT
endif
line_type "DASHED"
for i = 1 to int(nTb4 / 2)
	line2 tb4a[2 * i - 1], hA + plyT + sgH + r, tb4a[2 * i], hA + plyT + sgH + r
next i
line_type 1
del 1
! フォームタイ
for i = 1 to nX
	line2 tx[i], -yT - 0.05, tx[i], yT + 0.05
next i
for i = 1 to nY
	line2 -xT - 0.05, ty[i], xT + 0.05, ty[i]
next i
style "cfT"
text2 0, -yT - 0.15, cName + "  " + cNote

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 柱の型枠 3D（利用者の指定 2026-10-31: さんぎ そとばた フォームタイ）
! ============================================================
resol 12
define material "cf_ply" 2, 0.86, 0.66, 0.38
define material "cf_wood" 2, 0.74, 0.56, 0.36
define material "cf_steel" 2, 0.62, 0.62, 0.66
define material "cf_tie" 2, 0.35, 0.35, 0.38
define material "cf_pcon" 2, 0.85, 0.85, 0.80
define material "cf_bolt" 2, 0.30, 0.30, 0.32
H = ZZYZX
gap = 0.006
! ---- 面ごとのせき板・桟木・外端太（2本組） ----
rotz 0
material "cf_ply"
for i = 1 to int(nPl1 / 2)
	add pl1[2 * i - 1], hB, 0
	block pl1[2 * i] - pl1[2 * i - 1], plyT, H
	del 1
next i
material "cf_wood"
for i = 1 to nSg1
	add sg1a[i] - sgB / 2, hB + plyT, 0
	block sgB, sgH, H
	del 1
next i
material "cf_steel"
if clampOn then
	! コラムクランプの腕（角の先まで。角でくさび留め。±X の面の腕は腕のせいだけ上に重ねる）
	for j = 1 to nT
		add -hA - plyT - sgH - 0.12, hB + plyT + sgH, tz[j] - clH / 2 + 0
		block 2 * (hA + plyT + sgH + 0.12), clT, clH
		! くさび（両端）
		material "cf_bolt"
		add 0.03, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		add 2 * (hA + plyT + sgH + 0.12) - 0.05, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		material "cf_steel"
		del 1
	next j
endif
for i = 1 to int(nTb1 / 2) * (1 - clampOn)
	for j = 1 to nT
		for kk = -1 to 1 step 2
			add tb1a[2 * i - 1], hB + plyT + sgH + r, tz[j] + 0 + kk * (r + gap)
			roty 90
			cylind tb1a[2 * i] - tb1a[2 * i - 1], r
			del 2
		next kk
	next j
next i
del 1
rotz 90
material "cf_ply"
for i = 1 to int(nPl2 / 2)
	add pl2[2 * i - 1], hA, 0
	block pl2[2 * i] - pl2[2 * i - 1], plyT, H
	del 1
next i
material "cf_wood"
for i = 1 to nSg2
	add sg2a[i] - sgB / 2, hA + plyT, 0
	block sgB, sgH, H
	del 1
next i
material "cf_steel"
if clampOn then
	! コラムクランプの腕（角の先まで。角でくさび留め。±X の面の腕は腕のせいだけ上に重ねる）
	for j = 1 to nT
		add -hB - plyT - sgH - 0.12, hA + plyT + sgH, tz[j] - clH / 2 + clH
		block 2 * (hB + plyT + sgH + 0.12), clT, clH
		! くさび（両端）
		material "cf_bolt"
		add 0.03, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		add 2 * (hB + plyT + sgH + 0.12) - 0.05, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		material "cf_steel"
		del 1
	next j
endif
for i = 1 to int(nTb2 / 2) * (1 - clampOn)
	for j = 1 to nT
		for kk = -1 to 1 step 2
			add tb2a[2 * i - 1], hA + plyT + sgH + r, tz[j] + dzB + kk * (r + gap)
			roty 90
			cylind tb2a[2 * i] - tb2a[2 * i - 1], r
			del 2
		next kk
	next j
next i
del 1
rotz 180
material "cf_ply"
for i = 1 to int(nPl3 / 2)
	add pl3[2 * i - 1], hB, 0
	block pl3[2 * i] - pl3[2 * i - 1], plyT, H
	del 1
next i
material "cf_wood"
for i = 1 to nSg3
	add sg3a[i] - sgB / 2, hB + plyT, 0
	block sgB, sgH, H
	del 1
next i
material "cf_steel"
if clampOn then
	! コラムクランプの腕（角の先まで。角でくさび留め。±X の面の腕は腕のせいだけ上に重ねる）
	for j = 1 to nT
		add -hA - plyT - sgH - 0.12, hB + plyT + sgH, tz[j] - clH / 2 + 0
		block 2 * (hA + plyT + sgH + 0.12), clT, clH
		! くさび（両端）
		material "cf_bolt"
		add 0.03, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		add 2 * (hA + plyT + sgH + 0.12) - 0.05, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		material "cf_steel"
		del 1
	next j
endif
for i = 1 to int(nTb3 / 2) * (1 - clampOn)
	for j = 1 to nT
		for kk = -1 to 1 step 2
			add tb3a[2 * i - 1], hB + plyT + sgH + r, tz[j] + 0 + kk * (r + gap)
			roty 90
			cylind tb3a[2 * i] - tb3a[2 * i - 1], r
			del 2
		next kk
	next j
next i
del 1
rotz 270
material "cf_ply"
for i = 1 to int(nPl4 / 2)
	add pl4[2 * i - 1], hA, 0
	block pl4[2 * i] - pl4[2 * i - 1], plyT, H
	del 1
next i
material "cf_wood"
for i = 1 to nSg4
	add sg4a[i] - sgB / 2, hA + plyT, 0
	block sgB, sgH, H
	del 1
next i
material "cf_steel"
if clampOn then
	! コラムクランプの腕（角の先まで。角でくさび留め。±X の面の腕は腕のせいだけ上に重ねる）
	for j = 1 to nT
		add -hB - plyT - sgH - 0.12, hA + plyT + sgH, tz[j] - clH / 2 + clH
		block 2 * (hB + plyT + sgH + 0.12), clT, clH
		! くさび（両端）
		material "cf_bolt"
		add 0.03, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		add 2 * (hB + plyT + sgH + 0.12) - 0.05, clT, clH * 0.2
		block 0.02, 0.012, clH * 0.6
		del 1
		material "cf_steel"
		del 1
	next j
endif
for i = 1 to int(nTb4 / 2) * (1 - clampOn)
	for j = 1 to nT
		for kk = -1 to 1 step 2
			add tb4a[2 * i - 1], hA + plyT + sgH + r, tz[j] + dzB + kk * (r + gap)
			roty 90
			cylind tb4a[2 * i] - tb4a[2 * i - 1], r
			del 2
		next kk
	next j
next i
del 1
! ---- フォームタイ ----
for j = 1 to nT
	! Y の向き（±Y の面の外端太を締める）
	for i = 1 to nX
		add tx[i], 0, tz[j]
		material "cf_tie"
		add 0, -yT - r - 0.05, 0
		rotx -90
		cylind 2 * (yT + r + 0.05), 0.00395
		del 2
		for sd = -1 to 1 step 2
			add -0.035, sd * (yT + r) + (sd - 1) / 2 * 0.006, -(2 * r + gap)
			block 0.07, 0.006, 2 * (2 * r + gap)
			del 1
		next sd
		if i > 1 and i < nX then
			material "cf_pcon"
			add 0, -hB, 0
			rotx -90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
			add 0, hB, 0
			rotx 90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
		endif
		del 1
	next i
	! X の向き（±X の面の外端太を締める）
	for i = 1 to nY
		add 0, ty[i], tz[j] + dzB
		material "cf_tie"
		add -xT - r - 0.05, 0, 0
		roty 90
		cylind 2 * (xT + r + 0.05), 0.00395
		del 2
		for sd = -1 to 1 step 2
			add sd * (xT + r) + (sd - 1) / 2 * 0.006, -0.035, -(2 * r + gap)
			block 0.006, 0.07, 2 * (2 * r + gap)
			del 1
		next sd
		if i > 1 and i < nY then
			material "cf_pcon"
			add -hA, 0, 0
			roty 90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
			add hA, 0, 0
			roty -90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
		endif
		del 1
	next i
next j

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================


