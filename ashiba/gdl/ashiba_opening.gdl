! ==========================================================
! 床の開口の養生・床の縁の手すり（1つの開口か1本の縁に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_opening/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_opening.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 開発ループ（2026-11-01）: 他に必要な仮設材の5番。
! 原点＝開口の隅（床の上端）、+X＝長い辺。区分 opKind: 1・2 合板 12mm の蓋、3 合板 24mm、4 手すり 950・中桟 450・幅木 150（netOn で 0.3m 下に水平ネット）、5 床の縁の手すり（edSide で床の側）。区分と判定は opening_guard.py、置くのは scripts/opening_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   opW       長さ      開口の内法 長い辺（縁は長さ）                                              既定 2.5
!   opD       長さ      開口の内法 短い辺                                                          既定 2.0
!   opKind    整数      区分（1 小開口・2 中開口 12mm・3 中開口 24mm・4 大開口 手すり・5 床の縁）  既定 4
!   netOn     ブール    水平ネット（大開口）                                                       既定 1
!   slabT     長さ      床の厚さ                                                                   既定 0.2
!   edSide    整数      床の縁の床の側（1＝+Y・−1＝−Y）                                            既定 1
!   postK     整数      手すり柱（1＝スタンション NREG・2＝固定ベース PKB＋単管 1.0M）             既定 1
!   rlS       文字列    手すりの単管の辺（1 手前・2 奥・3 左・4 右）                               既定 "1,2,3,4"
!   rlL       文字列    手すりの単管の長さ（mm。辺の始めから並べる）                               既定 "3000,3000,2500,2500"
!   tbS       文字列    幅木の杉足場板の辺                                                         既定 "1,2,3,4"
!   tbL       文字列    幅木の杉足場板の長さ（mm）                                                 既定 "3000,3000,3000,3000"
!   opName    文字列    名前（注記）                                                               既定 "開口1"
!   texSiz    実数      文字の大きさ（mm）                                                         既定 2.5
!   penBold   PenColor  外形の線（太線。置くときに線のペンと同じ色の太いペン）                     既定 21
!   penThin   PenColor  細部の線（細線。同じ色の細いペン）                                         既定 1
!   penZone   PenColor  範囲の線（作業半径・後端旋回半径・立入禁止・旋回軌跡）                     既定 20
!   penMask   PenColor  上に載るものの背景の塗り（下の線を隠す。0＝隠さない）                      既定 19
!   drMode    整数      平面の描き分け（0 縮尺で自動・1 詳細 1/100・2 標準 1/200・3 簡略）         既定 0
!   penEquip  PenColor  線のペン                                                                   既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 開口養生: 区分ごとの寸法（opening_guard.py と同じ）と手すりの辺・単管・幅木の板（発注の規格の長さ）
kd = max(1, min(5, opKind))
lap = 0.1
lidT = 0.012
if kd = 3 then lidT = 0.024
rOff = 0.1
pSp = 1.8
! 手すりの囲い（大開口は開口の外 0.1 の長方形、縁は床の側に 0.1 入った1本）
rx0 = -rOff
ry0 = -rOff
rx1 = opW + rOff
ry1 = opD + rOff
eSd = 1
if edSide < 0 then eSd = -1
eY = eSd * rOff
! 辺ごとの始め・向き・長さ・開口（床の縁）の側（辺の +Y を 1）
dim sdX[4], sdY[4], sdA[4], sdL[4], sdI[4]
nSd = 4
sdX[1] = rx0
sdY[1] = ry0
sdA[1] = 0
sdL[1] = rx1 - rx0
sdI[1] = 1
sdX[2] = rx0
sdY[2] = ry1
sdA[2] = 0
sdL[2] = rx1 - rx0
sdI[2] = -1
sdX[3] = rx0
sdY[3] = ry0
sdA[3] = 90
sdL[3] = ry1 - ry0
sdI[3] = -1
sdX[4] = rx1
sdY[4] = ry0
sdA[4] = 90
sdL[4] = ry1 - ry0
sdI[4] = 1
if kd = 5 then
	nSd = 1
	sdX[1] = 0
	sdY[1] = eY
	sdL[1] = opW
	sdI[1] = -eSd
endif
if kd < 4 then nSd = 0
dim qrs[]
kRs = 0
rest = rlS
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		kRs = kRs + 1
		qrs[kRs] = v
	endif
endwhile
dim qrl[]
kRl = 0
rest = rlL
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		kRl = kRl + 1
		qrl[kRl] = v / 1000
	endif
endwhile
dim qbs[]
kBs = 0
rest = tbS
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		kBs = kBs + 1
		qbs[kBs] = v
	endif
endwhile
dim qbl[]
kBl = 0
rest = tbL
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		kBl = kBl + 1
		qbl[kBl] = v / 1000
	endif
endwhile

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 開口養生 2D（CAD の平面図の描き方: scripts/gdl_draft.py）: 開口は×の印。蓋は外形を太線で白く塗り、蓋の下の開口と×は隠れ線。
! 手すり・幅木で囲う開口と床の縁は、手すりを太線・幅木と支柱を細線。注記の後ろは背景の色で塗る。縮尺で 詳細（1/100: 支柱まで）・
! 標準（1/200）・簡略（外形と×と名前だけ）
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "opT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "opT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
tx = ""
if kd <= 3 then
	! 蓋（掛かり lap。上にあるので下の線を隠す）
	if mk then
		drawindex 20
		fill fiS
		poly2_b 5, 6, pM, pM,
			-lap, -lap, 1,
			opW + lap, -lap, 1,
			opW + lap, opD + lap, 1,
			-lap, opD + lap, 1,
			-lap, -lap, -1
	endif
	drawindex 30
	pen pO
	rect2 -lap, -lap, opW + lap, opD + lap
	! 蓋の下の開口の内法と×（隠れ線）
	drawindex 40
	pen pT
	line_type ltH
	rect2 0, 0, opW, opD
	line2 0, 0, opW, opD
	line2 0, opD, opW, 0
	line_type ltS
	tx = "蓋 12mm"
	if kd = 3 then tx = "蓋 24mm"
endif
if kd = 4 then
	drawindex 30
	pen pT
	rect2 0, 0, opW, opD
	line2 0, 0, opW, opD
	line2 0, opD, opW, 0
	! 手すり（太線）と幅木（細線）
	pen pO
	rect2 rx0, ry0, rx1, ry1
	if drLv < 3 then
		pen pT
		rect2 rx0 + 0.05, ry0 + 0.05, rx1 - 0.05, ry1 - 0.05
	endif
	if drLv = 1 then
		for sd = 1 to 4
			sL = rx1 - rx0
			if sd > 2 then sL = ry1 - ry0
			nP = max(1, ceil(sL / pSp - 0.0001))
			for i = 0 to nP
				px = rx0 + sL * i / nP
				py = ry0
				if sd = 2 then py = ry1
				if sd > 2 then
					px = rx0
					if sd = 4 then px = rx1
					py = ry0 + sL * i / nP
				endif
				circle2 px, py, 0.03
			next i
		next sd
	endif
	tx = "手すり・幅木"
	if netOn then tx = "手すり・幅木・ネット"
endif
if kd = 5 then
	drawindex 30
	pen pO
	line2 0, eY, opW, eY
	if drLv < 3 then
		pen pT
		line2 0, eY + eSd * 0.05, opW, eY + eSd * 0.05
	endif
	if drLv = 1 then
		nP = max(1, ceil(opW / pSp - 0.0001))
		for i = 0 to nP
			circle2 opW * i / nP, eY, 0.03
		next i
	endif
	tx = "床の縁 手すり"
endif
! 注記（後ろを背景の色で塗る。簡略は名前だけ）
pen penEquip
add2 opW / 2, opD / 2
if kd = 5 then add2 0, eY + eSd * (0.3 + dT)
rot2 -SYMB_ROTANGLE
t1 = opName
if drLv < 3 then t1 = opName + " " + tx
nTL = 1 + (kd <= 4 and drLv < 3)
tW = max(STW(t1), STW("開口注意") * (nTL > 1)) / 1000 * GLOB_SCALE / 2 + 0.05
tH = dT * (nTL / 2 + 0.1)
if mk then
	drawindex 45
	fill fiS
	poly2_b 5, 6, pM, pM, -tW, -tH, 1, tW, -tH, 1, tW, tH, 1, -tW, tH, 1, -tW, -tH, -1
endif
drawindex 50
if nTL > 1 then
	text2 0, dT / 2, t1
	text2 0, -dT / 2, "開口注意"
else
	text2 0, 0, t1
endif
del 2
if kd = 5 then del 1
hotspot2 0, 0
hotspot2 opW, 0
hotspot2 opW, opD
hotspot2 0, opD

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 開口養生 3D: 蓋・桟木・手すり・中桟・幅木・水平ネット
define material "op_ply" 2, 0.86, 0.72, 0.48
define material "op_cleat" 2, 0.70, 0.55, 0.35
define material "op_rail" 2, 0.90, 0.75, 0.10
define material "op_toe" 2, 0.80, 0.66, 0.45
define material "op_net" 2, 0.15, 0.40, 0.20
define material "op_post" 2, 0.62, 0.64, 0.66
define material "op_clamp" 2, 0.35, 0.36, 0.38
resol 8
if kd <= 3 then
	material "op_ply"
	add -lap, -lap, 0
	block opW + 2 * lap, opD + 2 * lap, lidT
	del 1
	! 裏のずれ止めの桟木（開口の内法に沿って一周）
	material "op_cleat"
	add 0.005, 0.005, -0.03
	block opW - 0.01, 0.03, 0.03
	del 1
	add 0.005, opD - 0.035, -0.03
	block opW - 0.01, 0.03, 0.03
	del 1
	add 0.005, 0.035, -0.03
	block 0.03, max(0.01, opD - 0.07), 0.03
	del 1
	add opW - 0.035, 0.035, -0.03
	block 0.03, max(0.01, opD - 0.07), 0.03
	del 1
endif
for sd = 1 to nSd
	sL = sdL[sd]
	sdIn = sdI[sd]
	zUp = 0
	if sd > 2 then zUp = 0.06
	add sdX[sd], sdY[sd], 0
	rotz sdA[sd]
	gosub "side"
	del 2
next sd
if kd = 4 and netOn then
	material "op_net"
	add -0.3, -0.3, -slabT - 0.3
	block opW + 0.6, opD + 0.6, 0.005
	del 1
endif
end

! 1辺: 今の座標で +X に長さ sL、開口（床の縁）は sdIn の側（+Y＝1）
"side":
	nP = max(1, ceil(sL / pSp - 0.000001))
	i0 = 0
	i1 = nP
	if sd > 2 then
		i0 = 1
		i1 = nP - 1
	endif
	! 手すり柱（スタンション NREG: 縁をくわえる顎、固定ベース PKB: 120 角の板＋単管 1.0M）
	for i = i0 to i1
		add sL * i / nP, 0, 0
		material "op_post"
		cylind 1.0, 0.0243
		if postK = 2 then
			add -0.06, -0.06, 0
			block 0.12, 0.12, 0.006
			del 1
		else
			jw = rOff + 0.03
			add -0.02, min(0, sdIn * jw), 0
			block 0.04, jw, 0.03
			del 1
			add -0.02, min(sdIn * jw, sdIn * (jw + 0.03)), -slabT - 0.05
			block 0.04, 0.03, slabT + 0.08
			del 1
			add -0.02, min(sdIn * (jw + 0.03), sdIn * (jw - 0.12)), -slabT - 0.05
			block 0.04, 0.15, 0.03
			del 1
		endif
		del 1
	next i
	! 手すり・中桟（単管の定尺を突き合わせ、継ぎ目に直線ジョイント）と直交クランプ
	tot = 0
	for k = 1 to min(kRs, kRl)
		if qrs[k] = sd then tot = tot + qrl[k]
	next k
	for r = 1 to 2
		hz = 0.95 + zUp
		if r = 2 then hz = 0.45 + zUp
		xs = -(tot - sL) / 2
		for k = 1 to min(kRs, kRl)
			if qrs[k] = sd then
				material "op_rail"
				add xs, -sdIn * 0.05, hz
				roty 90
				cylind qrl[k] - 0.003, 0.0243
				del 2
				if xs > -(tot - sL) / 2 + 0.01 then
					material "op_post"
					add xs - 0.05, -sdIn * 0.05, hz
					roty 90
					cylind 0.1, 0.027
					del 2
				endif
				xs = xs + qrl[k]
			endif
		next k
		material "op_clamp"
		for i = 0 to nP
			add sL * i / nP - 0.035, min(-sdIn * 0.06, -sdIn * 0.025), hz - 0.04
			block 0.07, 0.035, 0.08
			del 1
		next i
	next r
	! 幅木（杉足場板 35×210 を開口の側に）
	totB = 0
	for k = 1 to min(kBs, kBl)
		if qbs[k] = sd then totB = totB + qbl[k]
	next k
	material "op_toe"
	xs = -(totB - sL) / 2
	for k = 1 to min(kBs, kBl)
		if qbs[k] = sd then
			add xs + 0.003, min(sdIn * 0.035, sdIn * 0.07), 0.002
			block qbl[k] - 0.006, 0.035, 0.21
			del 1
			xs = xs + qbl[k]
		endif
	next k
return

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 開口養生: 区分の一覧
values{2} "opKind" 1, "小開口（蓋 12mm）", 2, "中開口（蓋 12mm）", 3, "中開口（蓋 24mm・鋼製）", 4, "大開口（手すり・幅木・ネット）", 5, "床の縁（手すり・幅木）"
values "edSide" -1, 1
values{2} "drMode" 0, "縮尺で自動", 1, "詳細（1/100）", 2, "標準（1/200）", 3, "簡略"

