! ==========================================================
! 隅のつなぎ（直角でない角の2本の足場のあいだの床・単管手すり・幅木。1か所に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_cfill/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_cfill.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-31）: 斜めの角もつながるようにしてちょ 無理な場合はかど合わせてアンチをし単管手すり作成か足場板と単管手すりにするか。
! 原点＝線の角。polyX・polyY で床の形、railE で手すりの辺、levList で段の高さ。各段に作業床（アンチ・足場板）・床の下に単管の受け・手すりの辺に単管の上桟（950）・中桟（450）・幅木（150）。
! ----------------------------------------------------------
! パラメータリスト:
!   polyX     文字列    床の形の x（原点からの mm、カンマ区切り。左回り）                                        既定 "0,0,800,0"
!   polyY     文字列    床の形の y（同上）                                                                       既定 "0,-914,-457,0"
!   railE     文字列    手すり・幅木を付ける辺の番号（辺 k は点 k→k+1。0 から。カンマ区切り）                    既定 "1"
!   levList   文字列    作業床の段の高さ（原点の高さから mm、カンマ区切り）                                      既定 "1780,3580,5380,7180"
!   deckKind  整数      作業床（1＝アンチ・2＝足場板）                                                           既定 1
!   antiOn    ブール    アンチを描く（足場板だけで渡すときは切る）                                               既定 1
!   deckT     長さ      作業床の厚み                                                                             既定 0.045
!   antiL     長さ      アンチの長さ（受けの単管の間。インチの系列は 914、メートルは 900）                       既定 0.914
!   antiW     長さ      アンチの幅                                                                               既定 0.24
!   plkX      文字列    アンチの外の辺側の始めの角の x（原点から mm。空なら外の辺の中点から並べる）              既定 ""
!   plkY      文字列    同 y                                                                                     既定 ""
!   plkAng    実数      アンチの向き（度。外の辺の向き）                                                         既定 0
!   plkL      文字列    アンチの長さ（列ごと mm。空なら antiL）                                                  既定 ""
!   fbX       文字列    残りのすき間をふさぐ足場板（列ごと）の始めの角の x（原点から mm）                        既定 ""
!   fbY       文字列    同 y                                                                                     既定 ""
!   fbL       文字列    同 長さ（mm）                                                                            既定 ""
!   fbAng     実数      足場板の向き（度。後の受けの線。空のときはアンチの向き）                                 既定 -999
!   pstX      文字列    手すりを受ける単管の支柱の x（原点から mm。手すりの曲がり角で長さが 1800 を超えるとき）  既定 ""
!   pstY      文字列    同 y                                                                                     既定 ""
!   supX0     文字列    受けの単管の始めの x（原点から mm）                                                      既定 ""
!   supY0     文字列    同 y                                                                                     既定 ""
!   supX1     文字列    受けの単管の終わりの x                                                                   既定 ""
!   supY1     文字列    同 y                                                                                     既定 ""
!   deckTop   長さ      本足場の布板の上面（段の高さから。アンチはこの上に載る）                                 既定 0.0664
!   railH1    長さ      上桟の高さ（床から）                                                                     既定 0.95
!   railH2    長さ      中桟の高さ（床から）                                                                     既定 0.45
!   toeH      長さ      幅木の高さ                                                                               既定 0.15
!   cName     文字列    名前（平面の注記）                                                                       既定 "隅のつなぎ"
!   texSiz    実数      文字の大きさ（mm）                                                                       既定 2.5
!   penEquip  PenColor  線のペン                                                                                 既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 隅のつなぎ: 床の形・手すりの辺・段の高さを読む（m）
dim px[]
nP = 0
rest = polyX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nP = nP + 1
		px[nP] = v / 1000
	endif
endwhile
dim py[]
nPy = 0
rest = polyY
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPy = nPy + 1
		py[nPy] = v / 1000
	endif
endwhile
dim re[]
nR = 0
rest = railE
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nR = nR + 1
		re[nR] = v / 1000
	endif
endwhile
dim lv[]
nL = 0
rest = levList
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		if v > 100 then
			nL = nL + 1
			lv[nL] = v / 1000
		endif
	endif
endwhile
if nPy < nP then nP = nPy
dim rl[]
for k = 1 to nP
	rl[k] = 0
next k
for k = 1 to nR
	ix = round_int(re[k] * 1000) + 1
	if ix >= 1 and ix <= nP then rl[ix] = 1
next k
if deckKind = 2 then
	dName = "足場板"
else
	dName = "アンチ"
endif
cx = 0
cy = 0
for k = 1 to nP
	cx = cx + px[k] / nP
	cy = cy + py[k] / nP
next k
! アンチを並べる基準: 最初の手すりの辺（外の辺）。辺の向き u・内向き（左）nI・中点・床の奥行き（辺から最も遠い点まで）
kR = 1
for k = nP to 1 step -1
	if rl[k] then kR = k
next k
kR2 = kR + 1
if kR2 > nP then kR2 = 1
eDx = px[kR2] - px[kR]
eDy = py[kR2] - py[kR]
eL = sqr(eDx * eDx + eDy * eDy)
if eL < 0.001 then eL = 0.001
ux = eDx / eL
uy = eDy / eL
mx = px[kR] + eDx / 2
my = py[kR] + eDy / 2
dep = 0
for k = 1 to nP
	dd = (px[k] - px[kR]) * (-uy) + (py[k] - py[kR]) * ux
	if dd > dep then dep = dd
next k
nPl = 1
if antiW > 0.01 then nPl = max(1, int(dep / antiW + 0.999))
if nPl > 8 then nPl = 8
if abs(eDx) < 0.000001 then
	eAng = 90 * sgn(eDy)
else
	eAng = atn(eDy / eDx)
	if eDx < 0 then eAng = eAng + 180
endif
pAng = eAng
dim qx[]
nQx = 0
rest = plkX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nQx = nQx + 1
		qx[nQx] = v / 1000
	endif
endwhile
dim qy[]
nQy = 0
rest = plkY
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nQy = nQy + 1
		qy[nQy] = v / 1000
	endif
endwhile
dim s0x[]
nS = 0
rest = supX0
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS = nS + 1
		s0x[nS] = v / 1000
	endif
endwhile
dim s0y[]
nS2 = 0
rest = supY0
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS2 = nS2 + 1
		s0y[nS2] = v / 1000
	endif
endwhile
dim s1x[]
nS3 = 0
rest = supX1
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS3 = nS3 + 1
		s1x[nS3] = v / 1000
	endif
endwhile
dim s1y[]
nS4 = 0
rest = supY1
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS4 = nS4 + 1
		s1y[nS4] = v / 1000
	endif
endwhile
dim qL[]
nQL = 0
rest = plkL
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nQL = nQL + 1
		qL[nQL] = v / 1000
	endif
endwhile
dim fx[]
nF = 0
rest = fbX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nF = nF + 1
		fx[nF] = v / 1000
	endif
endwhile
dim fy[]
nF2 = 0
rest = fbY
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nF2 = nF2 + 1
		fy[nF2] = v / 1000
	endif
endwhile
dim fL[]
nF3 = 0
rest = fbL
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nF3 = nF3 + 1
		fL[nF3] = v / 1000
	endif
endwhile
dim ptx[]
nPt = 0
rest = pstX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPt = nPt + 1
		ptx[nPt] = v / 1000
	endif
endwhile
dim pty[]
nPt2 = 0
rest = pstY
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPt2 = nPt2 + 1
		pty[nPt2] = v / 1000
	endif
endwhile
nF = min(nF, min(nF2, nF3))
nPt = min(nPt, nPt2)
for i = 1 to nPl
	if i > nQL then qL[i] = antiL
next i
if nQy < nQx then nQx = nQy
if nQx > 0 then
	nPl = nQx
	pAng = plkAng
	for i = 1 to nPl
		if i > nQL then qL[i] = antiL
	next i
else
	for i = 1 to nPl
		qx[i] = mx - ux * antiL / 2 + (-uy) * antiW * (i - 1)
		qy[i] = my - uy * antiL / 2 + ux * antiW * (i - 1)
	next i
endif
nS = min(nS, min(nS2, min(nS3, nS4)))
if antiOn = 0 then nPl = 0
fAng = fbAng
if fAng < -900 then fAng = pAng

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 隅のつなぎ 2D: 床の形、手すりの辺（二重線）、床の向きの斜線、名前
pE = penEquip
if pE < 1 then pE = 1
pen pE
define style "cfT" "ＭＳ Ｐゴシック", texSiz, 5, 0
for k = 1 to nP
	k2 = k + 1
	if k2 > nP then k2 = 1
	line2 px[k], py[k], px[k2], py[k2]
	if rl[k] then
		dx = px[k2] - px[k]
		dy = py[k2] - py[k]
		L = sqr(dx * dx + dy * dy)
		if L > 0.001 then
			ox = dy / L * 0.05
			oy = -dx / L * 0.05
			line2 px[k] + ox, py[k] + oy, px[k2] + ox, py[k2] + oy
		endif
	endif
	hotspot2 px[k], py[k]
next k
! 床の範囲の目印（重心から各点へ短い線）
for k = 1 to nP
	line2 cx, cy, cx + (px[k] - cx) * 0.3, cy + (py[k] - cy) * 0.3
next k
! アンチ（外の辺に平行に、辺の中点から両側へ antiL/2）
for i = 1 to nPl
	add2 qx[i], qy[i]
	rot2 pAng
	rect2 0, 0, qL[i], antiW
	del 2
next i
! 受けの単管（破線）
for i = 1 to nS
	line_type "DASHED"
	line2 s0x[i], s0y[i], s1x[i], s1y[i]
	line_type 1
next i
style "cfT"
text2 cx, cy, cName + "（" + dName + " " + str(nPl, 1, 0) + "列＋足場板＋単管手すり）"

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 隅のつなぎ 3D（利用者の指定 2026-10-31: 三角の板じゃなく 900アンチを乗せる クランプもつけてね／高さがずれている 本足場の
! アンチの上に乗せるようにして クランプの詳細どあげて）
! - アンチ（antiL×antiW×deckT）: 下面＝段の高さ＋deckTop（本足場の布板の上面）。両側の本足場のアンチの上に重ねて載る
! - 支柱を結ぶ単管（利用者の指定 2026-10-31: 支柱間を単管で結ぶ）: 前の足場の終わりの支柱と後の足場の始めの支柱を床の高さで
!   結ぶ（上面＝本足場のアンチの上面）。両端を支柱に自在クランプ
! - 足場板（黄。白のアンチは描かない antiOn）: 本足場のアンチの上に載せ、両端を番線で留める
! - 外の辺: 単管の上桟・中桟（支柱の外に 支柱半径＋単管半径 offR だけ出して添わせる。off は GDL の予約語で 3D が止まった）と幅木。両端の支柱に自在クランプ
! - 自在クランプ: 2つの抱き金具（単管を巻く帯・耳・T ボルトとナット）を回転軸のリベットでつないだ形
! ============================================================
resol 12
define material "cf_deck" 2, 0.72, 0.74, 0.78
define material "cf_steel" 2, 0.62, 0.62, 0.66
define material "cf_toe" 2, 0.55, 0.55, 0.58
define material "cf_clamp" 2, 0.50, 0.55, 0.66
define material "cf_bolt" 2, 0.30, 0.30, 0.32
define material "cf_wood" 2, 0.76, 0.60, 0.40
r = 0.0243
rP = 0.0243
offR = rP + r
zD = deckTop
for i = 1 to nL
	z = lv[i]
	! ---- アンチ（本足場のアンチの上に載る） ----
	material "cf_deck"
	for j = 1 to nPl
		add qx[j], qy[j], z + zD
		rotz pAng
		block qL[j], antiW - 0.005, deckT
		! 両端のつめ（受けの布材・単管に掛かる）
		add 0, 0.02, -0.02
		block 0.01, antiW - 0.045, 0.02
		del 1
		add qL[j] - 0.01, 0.02, -0.02
		block 0.01, antiW - 0.045, 0.02
		del 1
		del 2
	next j
	! ---- 残りのすき間をふさぐ足場板（斜めの受けとアンチの先の三角。アンチの先に 100 重ねて載せる） ----
	material "cf_wood"
	for j = 1 to nF
		add fx[j], fy[j], z + zD + deckT
		rotz fAng
		block fL[j], antiW - 0.01, 0.028
		! 番線（両端を2か所ずつ巻いて留める）
		material "cf_bolt"
		for e = 0 to 1
			for h = 0 to 1
				add 0.08 + e * (fL[j] - 0.16), 0.04 + h * (antiW - 0.09), 0.028
				block 0.006, 0.02, 0.003
				del 1
			next h
		next e
		material "cf_wood"
		del 2
	next j
	! ---- 受けの単管（すき間の中だけ）と、両端の自在クランプ（本足場の端の布材と交差） ----
	for j = 1 to nS
		dx = s1x[j] - s0x[j]
		dy = s1y[j] - s0y[j]
		L = sqr(dx * dx + dy * dy)
		if L > 0.05 then
			gosub "ang"
			material "cf_steel"
			add s0x[j], s0y[j], z + zD - r
			rotz ang
			roty 90
			addz -0.05
			cylind L + 0.1, r
			del 4
			for e = 0 to 1
				cX = s0x[j] + dx * e
				cY = s0y[j] + dy * e
				cZ = z + zD - r
				cA = ang
				cT = 1
				gosub "clamp"
			next e
		endif
	next j
	! ---- 外の辺: 単管の上桟・中桟（支柱に添わせて外へ offR）・幅木・両端の支柱に自在クランプ ----
	for k = 1 to nP
		if rl[k] then
			k2 = k + 1
			if k2 > nP then k2 = 1
			dx = px[k2] - px[k]
			dy = py[k2] - py[k]
			L = sqr(dx * dx + dy * dy)
			if L > 0.001 then
				gosub "ang"
				oX = dy / L * offR
				oY = -dx / L * offR
				for h = 1 to 2
					if h = 1 then
						zh = z + zD + deckT + railH1
					else
						zh = z + zD + deckT + railH2
					endif
					material "cf_steel"
					add px[k] + oX, py[k] + oY, zh
					rotz ang
					roty 90
					addz -0.3
					cylind L + 0.6, r
					del 4
					for e = 0 to 1
						cX = px[k] + dx * e + oX
						cY = py[k] + dy * e + oY
						cZ = zh
						cA = ang
						cT = 1
						gosub "clamp"
					next e
				next h
				material "cf_toe"
				add px[k], py[k], z + zD + deckT
				rotz ang
				addy -0.025
				block L, 0.025, toeH
				del 3
			endif
		endif
	next k
next i
! ---- 手すりの曲がり角の単管の支柱（地面から上の段の上桟まで。ジャッキ・敷板の上） ----
material "cf_steel"
for k = 1 to nPt
	add ptx[k], pty[k], 0
	cylind lv[nL] + zD + deckT + railH1 + 0.1, r
	del 1
next k
end

"ang":
	if abs(dx) < 0.000001 then
		ang = 90 * sgn(dy)
	else
		ang = atn(dy / dx)
		if dx < 0 then ang = ang + 180
	endif
return

"clamp":
	! 自在クランプ: (cX, cY, cZ) を芯とする単管（向き cA）の抱き金具と、相手の抱き金具（cT=1: 支柱＝鉛直、内側 offR の所。
	! cT=2: 本足場の布材＝水平で下に offR、向きは単管に直角）を回転軸のリベットでつなぐ
	material "cf_clamp"
	add cX, cY, cZ
	rotz cA
	! 単管の抱き金具（帯 幅 50・耳・T ボルト＋ナット）
	roty 90
	addz -0.025
	cylind 0.05, r + 0.004
	del 2
	add -0.02, -0.004, r
	block 0.04, 0.008, 0.022
	del 1
	material "cf_bolt"
	add 0, 0.012, r + 0.014
	rotx 90
	cylind 0.03, 0.006
	resol 6
	addz 0.024
	cylind 0.01, 0.0105
	del 1
	resol 12
	del 2
	material "cf_clamp"
	if cT = 1 then
		! 支柱の抱き金具（鉛直の帯）と、2つをつなぐリベット
		add 0, offR, -0.025
		cylind 0.05, rP + 0.004
		del 1
		! リベット（2つの帯が接する所の回転軸。長さ 0 の円柱は描けないので、接点に短い軸を置く）
		add 0, r - 0.006, 0
		rotx -90
		cylind 0.012, 0.010
		del 2
		add 0.006, offR + rP, -0.02
		block 0.022, 0.008, 0.04
		del 1
		material "cf_bolt"
		add 0.017, offR + rP + 0.004, 0
		roty 90
		cylind 0.03, 0.006
		resol 6
		addz 0.024
		cylind 0.01, 0.0105
		del 1
		resol 12
		del 2
	else
		! 下の布材（単管に直角）の抱き金具と、2つをつなぐリベット
		add 0, -0.025, -offR
		rotx -90
		cylind 0.05, r + 0.004
		del 2
		add 0, 0, -r + 0.006
		rotx 180
		cylind 0.012, 0.010
		del 2
		material "cf_bolt"
		add 0.012, 0, -offR - r - 0.014
		roty 90
		cylind 0.03, 0.006
		del 2
	endif
	del 2
return

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
values{2} "deckKind" 1, "アンチ", 2, "足場板"

