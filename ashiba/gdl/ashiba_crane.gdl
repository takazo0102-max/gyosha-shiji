!   plN       整数      敷鉄板の枚数（アウトリガ1脚に。2＝十字。フロートの高さに使う）                                                                                                              既定 1
!   plDraw    ブール    敷鉄板をこの部品で描く（外す＝別の部品 ashiba_plate を下に置く）                                                                                                            既定 1
!   wrR       文字列    吊荷の作業半径の円（mm。カンマ区切り）                                                                                                                                      既定 "12000,18000"
!   wrDir     角度      作業半径の扇の向き（平面のホットスポット）                                                                                                                                  既定 0.0
!   wrSpan    角度      作業半径の扇の角度の幅（360＝円）                                                                                                                                           既定 360.0
!   travel    ブール    走行姿勢（ブームを最短で前に倒し、アウトリガを畳む）                                                                                                                        既定 0
!   ldOn      ブール    吊り荷を描く                                                                                                                                                                既定 1
!   texSiz    実数      文字の大きさ（mm）                                                                                                                                                          既定 2.5
!   penEquip  PenColor  線のペン                                                                                                                                                                    既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 移動式クレーン: 姿勢（作業半径・ブーム）・定格総荷重表・車軸（m）
dim wr[]
nWr = 0
rest = wrR
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nWr = nWr + 1
		wr[nWr] = v / 1000
	endif
endwhile
dim rb[]
nRb = 0
rest = rtB
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nRb = nRb + 1
		rb[nRb] = v / 1000
	endif
endwhile
dim ss[]
nSs = 0
rest = rtS
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSs = nSs + 1
		ss[nSs] = v / 1000
	endif
endwhile
! ---- アウトリガ4脚（前左・前右・後左・後右。車体の芯からジャッキまで）と、定格を読む張出幅 ----
lFL = oFL
lFR = oFR
lRL = oRL
lRR = oRR
if travel then
	lFL = carW / 2 - 0.05
	lFR = lFL
	lRL = lFL
	lRR = lFL
endif
spE = 2 * min(min(lFL, lFR), min(lRL, lRR))
sI = 0
for i = nSs to 1 step -1
	if ss[i] <= spE + 0.001 then sI = i
next i
spT = 0
if sI > 0 then spT = ss[sI]
srr = ""
sc1 = ""
sc2 = ""
sc3 = ""
sc4 = ""
sc5 = ""
sc6 = ""
sc7 = ""
sc8 = ""
sc9 = ""
sc10 = ""
sc11 = ""
sc12 = ""
if sI = 1 then
	srr = rr1
	sc1 = rs1c1
	sc2 = rs1c2
	sc3 = rs1c3
	sc4 = rs1c4
	sc5 = rs1c5
	sc6 = rs1c6
	sc7 = rs1c7
