wiAq[5] = wiA5
wiBq[5] = wiB5
wiFq[5] = wiF5
for wq = 1 to 5
	wS0 = wiBq[wq] - wiAq[wq] + 720
	wS0 = wS0 - int(wS0 / 360) * 360
	if wS0 < 0.01 then wS0 = 360
	wiSq[wq] = wS0
	wiMq[wq] = wiAq[wq] + wS0 / 2
next wq
for wq = 1 to nWi
	vq = 0
	iQ = 0
	for k = nRr to 1 step -1
		if rr[k] >= wiRq[wq] - 0.001 then iQ = k
	next k
	if iQ > 0 then
		if jB = 1 and iQ <= nTc1 then vq = tc1[iQ] * 10
		if jB = 2 and iQ <= nTc2 then vq = tc2[iQ] * 10
		if jB = 3 and iQ <= nTc3 then vq = tc3[iQ] * 10
		if jB = 4 and iQ <= nTc4 then vq = tc4[iQ] * 10
		if jB = 5 and iQ <= nTc5 then vq = tc5[iQ] * 10
		if jB = 6 and iQ <= nTc6 then vq = tc6[iQ] * 10
		if jB = 7 and iQ <= nTc7 then vq = tc7[iQ] * 10
		if jB = 8 and iQ <= nTc8 then vq = tc8[iQ] * 10
		if jB = 9 and iQ <= nTc9 then vq = tc9[iQ] * 10
		if jB = 10 and iQ <= nTc10 then vq = tc10[iQ] * 10
		if jB = 11 and iQ <= nTc11 then vq = tc11[iQ] * 10
		if jB = 12 and iQ <= nTc12 then vq = tc12[iQ] * 10
	endif
	if jL > 0.01 or wiRq[wq] < rMin - 0.001 then vq = 0
	vq = vq * sfRate
	wiTq[wq] = vq
next wq

