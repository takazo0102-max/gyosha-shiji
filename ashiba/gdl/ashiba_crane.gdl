! ==========================================================
! 移動式クレーン（ラフテレーンクレーン 25t・50t・70t。1台に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_crane/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_crane.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-11-01）: クレーン リサーチして追加して。
! 原点＝旋回中心の地盤、+X＝車体の前。車体・アウトリガ（outF・outR・張出幅 outW）・敷鉄板（plN 枚）・上部旋回体（旋回 slew・後端旋回半径 tailR）・ブーム（boomL・起伏角 boomA）・フック・吊り荷、平面に立入禁止の円と作業半径の円（wrR）。性能表と寸法はタダノの仕様書（crane_data.py）、検定は crane.py、置くのは scripts/crane_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   crType    整数      機種（1＝25t GR-250N・2＝50t GR-500N・3＝70t GR-700N）  既定 1
!   crName    文字列    機種の名前（平面の注記）                                既定 "GR-250N（Ⅴ）25t"
!   carL      長さ      全長                                                    既定 11.53
!   carW      長さ      全幅                                                    既定 2.62
!   carH      長さ      全高                                                    既定 3.475
!   carF      長さ      旋回中心から前端                                        既定 5.4
!   outF      長さ      旋回中心から前のアウトリガ                              既定 3.265
!   outR      長さ      旋回中心から後ろのアウトリガ                            既定 3.415
!   outW      長さ      アウトリガの張出幅（ジャッキの芯々）                    既定 6.6
!   fltD      長さ      フロートの径                                            既定 0.4
!   tailR     長さ      後端旋回半径                                            既定 3.1
!   pivH      長さ      ブームの根元の高さ                                      既定 2.3
!   pivB      長さ      ブームの根元の旋回中心から後ろ                          既定 1.0
!   tipHk     長さ      ブームの先からフックの上まで                            既定 1.3
!   boomL     長さ      ブーム長さ                                              既定 23.45
!   boomA     角度      ブームの起伏角                                          既定 56.0
!   slew      角度      旋回角（車体の前から左回り）                            既定 30.0
!   hookZ     長さ      フックの高さ（地盤から。注記）                          既定 20.0
!   plN       整数      敷鉄板の枚数（アウトリガ1脚に。2＝十字）                既定 1
!   wrR       文字列    作業半径の円（mm。カンマ区切り）                        既定 "12000,18000"
!   ldOn      ブール    吊り荷を描く                                            既定 1
!   texSiz    実数      文字の大きさ（mm）                                      既定 2.5
!   penEquip  PenColor  線のペン                                                既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 移動式クレーン: 作業半径の円・車軸・ブームの先とフック（m）
dim wr[]
nWr = 0
rest = wrR
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nWr = nWr + 1
		wr[nWr] = v / 1000
	endif
endwhile
carRr = carL - carF
nAx = 2
dim ax[4]
ax[1] = 1.94
ax[2] = -1.94
whR = 0.68
whW = 0.39
if crType = 2 then
	ax[1] = 2.52
	ax[2] = -2.53
	whR = 0.78
	whW = 0.5
endif
if crType = 3 then
	nAx = 4
	ax[1] = 3.0
	ax[2] = 1.45
	ax[3] = -1.55
	ax[4] = -3.1
endif
! ブームの先（上部旋回体の座標）とフック
tipX = -pivB + boomL * cos(boomA)
tipZ = pivH + boomL * sin(boomA)
hkZ = max(0.6, tipZ - tipHk)
plT = 0.022
plA = 1.524
plB = 3.048

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 移動式クレーン 2D: 車体・アウトリガ・敷鉄板・後端旋回半径（立入禁止）・作業半径・ブームとフック
! 文字の数は str(数, 1, 0)（小数の桁を付けた str(x, 1, 1) は平面図でこの部品の 2D を丸ごと消した。プレビューでは描けていた）
pen penEquip
define style "crT" "ＭＳ Ｐゴシック", texSiz, 1, 0
style "crT"
! 車体
rect2 -carRr, -carW / 2, carF, carW / 2
for e = -1 to 1 step 2
	xo = outF
	if e < 0 then xo = -outR
	line2 xo, -outW / 2, xo, outW / 2
	for s = -1 to 1 step 2
		circle2 xo, s * outW / 2, fltD / 2
		rect2 xo - plB / 2, s * outW / 2 - plA / 2, xo + plB / 2, s * outW / 2 + plA / 2
		if plN >= 2 then rect2 xo - plA / 2, s * outW / 2 - plB / 2, xo + plA / 2, s * outW / 2 + plB / 2
	next s
next e
! 立入禁止（上部旋回体の後端旋回半径）と作業半径の円
circle2 0, 0, tailR
for i = 1 to nWr
	circle2 0, 0, wr[i]
	text2 wr[i] * 0.7071, wr[i] * 0.7071, "R" + str(round_int(wr[i] * 1000), 1, 0)
next i
! 上部旋回体とブーム（旋回角で回す）
rot2 slew
rect2 -tailR, -1.1, 1.2, 1.1
line2 -pivB, -0.35, tipX, -0.2
line2 -pivB, 0.35, tipX, 0.2
circle2 tipX, 0, 0.3
if ldOn then rect2 tipX - 0.75, -0.75, tipX + 0.75, 0.75
del 1
text2 0, -outW / 2 - 1.2, crName
text2 0, -outW / 2 - 1.2 - texSiz * GLOB_SCALE / 1000 * 1.6, "ブーム " + str(round_int(boomL * 1000), 1, 0) + "・作業半径 " + str(round_int(tipX * 1000), 1, 0)
hotspot2 0, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 移動式クレーン 3D（タダノ GR-250N・GR-500N・GR-700N の寸法の目安）
define material "cr_body" 2, 0.92, 0.93, 0.94
define material "cr_blue" 2, 0.15, 0.30, 0.60
define material "cr_boom" 2, 0.95, 0.95, 0.92
define material "cr_cw" 2, 0.30, 0.31, 0.33
define material "cr_steel" 2, 0.55, 0.57, 0.60
define material "cr_plate" 2, 0.35, 0.36, 0.38
define material "cr_tire" 2, 0.10, 0.10, 0.10
define material "cr_hook" 2, 0.95, 0.75, 0.10
define material "cr_load" 2, 0.70, 0.50, 0.30
resol 16
plH = plT * plN
! ---- 敷鉄板（アウトリガ1脚に plN 枚。2枚は十字）とフロート・ジャッキ・アウトリガのビーム ----
for e = -1 to 1 step 2
	xo = outF
	if e < 0 then xo = -outR
	material "cr_steel"
	add xo - 0.15, -outW / 2, 1.0
	block 0.3, outW, 0.25
	del 1
	for s = -1 to 1 step 2
		yo = s * outW / 2
		material "cr_plate"
		add xo - plB / 2, yo - plA / 2, 0
		block plB, plA, plT
		del 1
		if plN >= 2 then
			add xo - plA / 2, yo - plB / 2, plT
			block plA, plB, plT
			del 1
		endif
		material "cr_steel"
		add xo, yo, plH
		cylind 0.06, fltD / 2
		addz 0.06
		cylind 1.0 - plH - 0.06, 0.09
		del 2
	next s
next e
! ---- 車体（シャシ・タイヤ）----
material "cr_body"
add -carRr, -carW / 2 + 0.1, 0.75
block carL, carW - 0.2, 0.75
del 1
material "cr_blue"
add -carRr, -carW / 2 + 0.1, 0.75
block carL, 0.02, 0.3
del 1
add -carRr, carW / 2 - 0.12, 0.75
block carL, 0.02, 0.3
del 1
material "cr_tire"
for i = 1 to nAx
	for s = -1 to 1 step 2
		add ax[i], s * (carW / 2 - whW / 2 - 0.02), whR + 0.05
		rotx 90
		addz -whW / 2
		cylind whW, whR
		del 3
	next s
next i
! ---- 上部旋回体（旋回角 slew で回す）----
rotz slew
material "cr_steel"
add 0, 0, 1.5
cylind 0.2, 1.0
del 1
material "cr_body"
add -tailR + 0.7, -1.1, 1.7
block tailR - 0.7 + 1.0, 2.2, 0.9
del 1
material "cr_cw"
add -tailR, -1.1, 1.7
block 0.7, 2.2, 1.0
del 1
! 運転室（右前）
material "cr_body"
add 0.2, -1.25, 1.7
block 1.9, 0.85, 1.65
del 1
material "cr_cw"
add 1.0, -1.255, 2.4
block 1.05, 0.005, 0.8
del 1
! 起伏シリンダ（旋回体からブームの 0.35 の所）
material "cr_steel"
x0q = 0.9
y0q = 0
z0q = 1.9
x1q = -pivB + 0.35 * boomL * cos(boomA)
y1q = 0
z1q = pivH + 0.35 * boomL * sin(boomA)
rq = 0.11
gosub "seg3"
! ブーム（根元から段ごとに細く）
add -pivB, 0, pivH
roty -boomA
nS = 4
if crType >= 2 then nS = 6
sL = boomL / nS
for k = 1 to nS
	bw = 0.78 - (k - 1) * 0.06
	if crType = 1 then bw = 0.62 - (k - 1) * 0.06
	ov = 0
	if k > 1 then ov = 0.05
	material "cr_boom"
	add (k - 1) * sL - ov, -bw / 2, -bw * 0.55
	block sL + ov, bw, bw * 1.1
	del 1
next k
! ブームの先（シーブ）
material "cr_steel"
add boomL, 0, 0
rotx 90
addz -0.2
cylind 0.4, 0.35
del 3
del 2
! ワイヤ・フック・吊り荷（旋回体の座標でブームの先の真下）
material "cr_steel"
add tipX, 0, hkZ + 0.6
cylind tipZ - hkZ - 0.6, 0.012
del 1
material "cr_hook"
add tipX - 0.25, -0.18, hkZ
block 0.5, 0.36, 0.6
del 1
material "cr_steel"
add tipX, 0, hkZ - 0.35
cylind 0.35, 0.05
del 1
if ldOn then
	zl = max(0.0, hkZ - 2.6)
	material "cr_load"
	add tipX - 0.75, -0.75, zl
	block 1.5, 1.5, 1.0
	del 1
	! 玉掛けワイヤ（吊り荷の四隅からフックへ）
	material "cr_steel"
	for c = 0 to 3
		x0q = tipX - 0.7 + 1.4 * (c mod 2)
		y0q = -0.7 + 1.4 * int(c / 2)
		z0q = zl + 1.0
		x1q = tipX
		y1q = 0
		z1q = hkZ - 0.35
		rq = 0.008
		gosub "seg3"
	next c
endif
del 1
end

"seg3":
	! (x0q, y0q, z0q) から (x1q, y1q, z1q) の円柱（半径 rq。向きは問わない）
	dxq = x1q - x0q
	dyq = y1q - y0q
	dzq = z1q - z0q
	hq = sqr(dxq ^ 2 + dyq ^ 2)
	lq = sqr(hq ^ 2 + dzq ^ 2)
	if lq > 0.001 then
		az = 0
		if hq > 0.0001 then
			if abs(dxq) < 0.0001 then
				az = 90
				if dyq < 0 then az = -90
			else
				az = atn(dyq / dxq)
				if dxq < 0 then az = az + 180
			endif
		endif
		el = 90
		if dzq < 0 then el = -90
		if hq > 0.0001 then el = atn(dzq / hq)
		add x0q, y0q, z0q
		rotz az
		roty 90 - el
		cylind lq, rq
		del 3
	endif
	return

