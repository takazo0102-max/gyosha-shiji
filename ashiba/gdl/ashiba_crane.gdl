endif
if sI = 8 then
	srr = rr8
	sc1 = rs8c1
	sc2 = rs8c2
	sc3 = rs8c3
	sc4 = rs8c4
	sc5 = rs8c5
	sc6 = rs8c6
	sc7 = rs8c7
	sc8 = rs8c8
	sc9 = rs8c9
	sc10 = rs8c10
	sc11 = rs8c11
	sc12 = rs8c12
endif
dim rr[]
nRr = 0
rest = srr
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nRr = nRr + 1
		rr[nRr] = v / 1000
	endif
endwhile
dim tc1[]
nTc1 = 0
rest = sc1
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTc1 = nTc1 + 1
		tc1[nTc1] = v / 1000
	endif
endwhile
dim tc2[]
nTc2 = 0
rest = sc2
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
