! ==========================================================
! 移動式クレーン 2D: 車体・アウトリガ・敷鉄板・後端旋回半径（立入禁止）・作業半径の扇・ブームとフック・定格の注記・ホットスポット
! 文字の数は str(数, 1, 0)、小数は長さに余裕を（str(x, 1, 1) は平面図でこの部品の 2D を丸ごと消した。プレビューでは描けていた）
! CAD の平面図の描き方（scripts/gdl_draft.py）: 外形は太線・細部は細線、車体の下のタイヤと旋回輪は破線、作業半径は一点鎖線、
! 後端旋回半径（立入禁止）は二点鎖線。上部旋回体とブームは背景の色で塗って下の車体の線を隠す。縮尺で描き分ける
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
pen penEquip
define style "crT" "ＭＳ Ｐゴシック", texSiz, 1, 0
define style "crR" "ＭＳ Ｐゴシック", texSiz, 3, 0
define style "crC" "ＭＳ Ｐゴシック", texSiz, 2, 0
style "crT"
! 車体（キャリヤ）: 外形・前後のバンパー・タイヤ（車体の下なので破線）・旋回輪（上部の下なので破線）
drawindex 10
if mk then
	fill fiS
	poly2_b 5, 6, pM, pM,
		-carRr, -carW / 2, 1,
		carF, -carW / 2, 1,
		carF, carW / 2, 1,
		-carRr, carW / 2, 1,
		-carRr, -carW / 2, -1
endif
drawindex 12
pen pO
rect2 -carRr, -carW / 2, carF, carW / 2
pen pT
if drLv < 3 then
	rect2 carF - 0.25, -carW / 2 + 0.15, carF, carW / 2 - 0.15
	rect2 -carRr, -carW / 2 + 0.15, -carRr + 0.25, carW / 2 - 0.15
	drawindex 40
	line_type ltH
	for i = 1 to nAx
		for s = -1 to 1 step 2
			rect2 ax[i] - whR, s * (carW / 2 - 0.02), ax[i] + whR, s * (carW / 2 - 0.02 - whW)
		next s
		if drLv = 1 then line2 ax[i], -carW / 2 + 0.1 + whW, ax[i], carW / 2 - 0.1 - whW
	next i
	circle2 0, 0, 0.9
	line_type ltS
	drawindex 12
endif
for e = -1 to 1 step 2
	xo = outF
	if e < 0 then xo = -outR
	for s = -1 to 1 step 2
		lg = lFL
		if e > 0 and s < 0 then lg = lFR
		if e < 0 and s > 0 then lg = lRL
		if e < 0 and s < 0 then lg = lRR
		xs = xo - (s < 0) * outSh
		! アウトリガのビーム（箱 0.3 幅）・ジャッキ・フロート（太線）、敷鉄板（細線）
		drawindex 14
		pen pO
		rect2 xs - 0.15, s * (carW / 2 - 0.2), xs + 0.15, s * lg
		if fltA > 0.01 then
			rect2 xs - fltB / 2, s * lg - fltA / 2, xs + fltB / 2, s * lg + fltA / 2
		else
			circle2 xs, s * lg, fltD / 2
		endif
		pen pT
		if drLv < 3 then circle2 xs, s * lg, 0.12
		! 張出の寸法（車体の芯からジャッキまで mm）
		if drLv < 3 then
			drawindex 50
			pen penEquip
			add2 xs + max(fltB, fltD) / 2 + 0.15, s * lg
			rot2 -SYMB_ROTANGLE
			text2 0, 0, str(round_int(lg * 1000), 1, 0)
			del 2
			pen pT
		endif
		drawindex 8
		if plDraw then
			rect2 xs - plB / 2, s * lg - plA / 2, xs + plB / 2, s * lg + plA / 2
			if plN >= 2 then rect2 xs - plA / 2, s * lg - plB / 2, xs + plA / 2, s * lg + plB / 2
		endif
	next s
next e
! 立入禁止（上部旋回体の後端旋回半径）: 二点鎖線
drawindex 45
pen pZ
line_type ltZ
circle2 0, 0, tailR
line_type ltC
! 作業半径の扇（吊荷ごとの半径と、今のフックの半径。wrSpan 360 は円）
nC = (nWr + 1) * wrShow
for i = 1 to nC
	rC = tipX
	if i <= nWr then rC = wr[i]
	if wrSpan >= 359.9 then
		circle2 0, 0, rC
	else
		arc2 0, 0, rC, wrDir - wrSpan / 2, wrDir + wrSpan / 2
	endif
	aT = wrDir
	if wrSpan >= 359.9 then aT = wrDir + 45
	! 半径の文字がブームとフックの注記に重ならないよう、ブームの向きから 30° 以内なら 60° 戻す
	dA = aT - slD + 720
	dA = dA - int(dA / 360) * 360
	if dA > 180 then dA = dA - 360
	if abs(dA) < 30 then aT = slD - 60
	if i <= nWr then
		pen penEquip
		add2 rC * cos(aT), rC * sin(aT)
		rot2 -SYMB_ROTANGLE + 180 * wrFlip
		text2 0, 0, "R" + str(round_int(rC * 1000), 1, 0)
		del 2
		pen pZ
	endif
next i
! 作業の最小半径
if rMin > 0.1 and travel = 0 then
	line_type ltZ
	circle2 0, 0, rMin
	pen penEquip
	add2 rMin * cos(slD + 40), rMin * sin(slD + 40)
	rot2 -SYMB_ROTANGLE
	text2 0, 0, "最小 R" + str(round_int(rMin * 1000), 1, 0)
	del 2
	pen pZ
endif
line_type ltS
if wrSpan < 359.9 and wrShow then
	line_type ltC
	rM = tipX
	for i = 1 to nWr
		rM = max(rM, wr[i])
	next i
	line2 0, 0, rM * cos(wrDir - wrSpan / 2), rM * sin(wrDir - wrSpan / 2)
	line2 0, 0, rM * cos(wrDir + wrSpan / 2), rM * sin(wrDir + wrSpan / 2)
	line_type ltS
endif
! 上部旋回体とブーム（旋回角で回す）
rot2 slD
! 上部旋回体（後ろはカウンタウエイトの円弧＝後端旋回半径）・運転室（右前）
uw = min(upW / 2, tailR * 0.98)
xc = -sqr(tailR ^ 2 - uw ^ 2)
au = asn(uw / tailR)
if mk then
	drawindex 20
	fill fiS
	poly2_b 12, 6, pM, pM,
		1.6, -uw, 1,
		1.6, uw, 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 0 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 0 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 1 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 1 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 2 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 2 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 3 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 3 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 4 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 4 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 5 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 5 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 6 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 6 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 7 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 7 / 8), 1,
		tailR * cos(180 - au + (180 + au - (180 - au)) * 8 / 8), tailR * sin(180 - au + (180 + au - (180 - au)) * 8 / 8), 1,
		1.6, -uw, -1
endif
drawindex 30
pen pO
arc2 0, 0, tailR, 180 - au, 180 + au
line2 xc, uw, 1.6, uw
line2 xc, -uw, 1.6, -uw
line2 1.6, -uw, 1.6, uw
rect2 cbX0, -cbY1, cbX1, -cbY0
pen pT
if drLv < 3 then line2 xc + 0.9, -uw, xc + 0.9, uw
if drLv = 1 then line2 cbX1 - 0.25, -cbY1, cbX1 - 0.25, -cbY0
! ブーム（段ごとに細く、全段を重ねて描く）・ブームの先のシーブ・フック。段の根元は平面に写した長さで
! （ブームに沿った長さのままだと、起こしたブームの上の段がフックの先へはみ出した。2026-11-02 実機の平面図）
nb = max(1, min(6, nBs))
if mk then
	drawindex 32
	fill fiS
	poly2_b 5, 6, pM, pM,
		-pivB, -bmW / 2, 1,
		tipX + 0.25, -bmW / 2, 1,
		tipX + 0.25, bmW / 2, 1,
		-pivB, bmW / 2, 1,
		-pivB, -bmW / 2, -1
endif
drawindex 34
pen pO
rect2 -pivB, -bmW / 2, tbX, bmW / 2
pen pT
if drLv < 3 then
	for k = 2 to nb
		wk = bmW * (1 - 0.13 * (k - 1)) / 2
		xk = -pivB + (k - 1) * (bL - 1.2) * cos(bA) / nb
		rect2 xk, -wk, tbX, wk
	next k
	line_type ltC
	line2 -pivB - 0.5, 0, tbX + 0.8, 0
	line_type ltS
endif
pen pO
rect2 tbX - 0.35, -bmW / 2, tbX + 0.25, bmW / 2
if jL > 0.01 then
	! ジブ（先へ細くなる）
	line2 tbX, -bmW / 3, tipX, -bmW / 6
	line2 tbX, bmW / 3, tipX, bmW / 6
	line2 tipX, -bmW / 6, tipX, bmW / 6
endif
pen pT
circle2 tipX, 0, 0.3
if drLv = 1 then circle2 tipX, 0, 0.12
pen pO
if ldOn and travel = 0 then
	drawindex 36
	rect2 tipX - 0.75, -0.75, tipX + 0.75, 0.75
	if drLv < 3 then
		pen pT
		line2 tipX - 0.75, -0.75, tipX + 0.75, 0.75
		line2 tipX - 0.75, 0.75, tipX + 0.75, -0.75
	endif
endif
del 1
! フックのホットスポット（X と Y の組を同じ点に置いて、どの向きにも引ける。前後は作業半径、横は旋回）
if travel = 0 then
	xF = tipX * cos(slD)
	yF = tipX * sin(slD)
	hotspot2 0, yF, 1, hfX, 1 + 128
	hotspot2 xF, yF, 2, hfX, 2
	hotspot2 -1, yF, 3, hfX, 3
	hotspot2 xF, 0, 31, hfY, 1 + 128
	hotspot2 xF, yF, 32, hfY, 2
	hotspot2 xF, -1, 33, hfY, 3
! 吊り点の印（scripts/gdl_mark.py）
if slgOn and (1) then
	pen penEquip
	line_type 1
	mkR = texSiz * GLOB_SCALE / 1000 * 0.7
	circle2 xF, yF, mkR
	line2 xF - mkR, yF, xF + mkR, yF
	line2 xF, yF - mkR, xF, yF + mkR
endif
endif
! 旋回の中心（一点鎖線の十字）
drawindex 45
pen pT
line_type ltC
line2 -1.2, 0, 1.2, 0
line2 0, -1.2, 0, 1.2
line_type ltS
! 定格の注記（フックの所）と機種・姿勢の注記（車体の後ろ）
drawindex 50
pen penEquip
xT = tipX * cos(slD)
yT = tipX * sin(slD)
dT = texSiz * GLOB_SCALE / 1000 * 1.6
if travel = 0 then
	sOk = ""
	if okL = 0 then sOk = " 超過"
	add2 xT, yT
	rot2 -SYMB_ROTANGLE
	if jL > 0.01 then
		text2 0, 0.6 + dT, "ジブ " + str(round_int(jL * 1000), 1, 0) + " 定格は性能表で"
	else
		text2 0, 0.6 + dT, "定格 " + str(rated, 5, 2) + "t×" + str(sfRate, 4, 2) + "＝" + str(capT, 5, 2) + "t"
	endif
	text2 0, 0.6, "吊荷 " + str(needT, 5, 2) + "t" + sOk
	del 2
endif
! 車体の後ろの外に、車体から離れる側へ寄せて書く（車体の向きで文字の寄せと上下を変える。車体の線に重ならない）
add2 -carRr - 1.0, 0
rot2 -SYMB_ROTANGLE
cR = cos(SYMB_ROTANGLE)
yA = 0
if cR > 0.5 then
	style "crR"
else
	if cR > -0.5 then
		style "crC"
		if sin(SYMB_ROTANGLE) < 0 then yA = 3 * dT
	endif
endif
tS = "張出不足（性能表の最小の張出より狭い）"
if sI > 0 then tS = "性能表 張出 " + str(round_int(spT * 1000), 1, 0) + "（4脚の最小 " + str(round_int(spE * 500), 1, 0) + "×2）"
if drLv < 3 then text2 0, yA - 2 * dT, tS
text2 0, yA, crName
text2 0, yA - dT, "ブーム " + str(round_int(bL * 1000), 1, 0) + "・" + str(round_int(bA), 1, 0) + "°・R" + str(round_int(tipX * 1000), 1, 0)
style "crT"
del 2
! 旋回角のホットスポット（ブームの真ん中）と扇の向き
rH = max(2.0, tipX * 0.5)
hotspot2 0, 0, 4, slew, 6
hotspot2 rH, 0, 5, slew, 4
hotspot2 rH * cos(slD), rH * sin(slD), 6, slew, 5
rW = tipX * 1.1
! 作業半径の表示（弧と線と文字。scripts/gdl_radii.py）
if nWi > 0 then
	define style "wiS" "ＭＳ Ｐゴシック", texSiz, 8, 0
	drawindex 50
	line_type ltS
endif
for wq = 1 to nWi
	wRr = wiRq[wq]
	wAm = wiMq[wq]
	pen pZ
	if wiSq[wq] >= 359.9 then
		circle2 0, 0, wRr
	else
		arc2 0, 0, wRr, wiAq[wq], wiAq[wq] + wiSq[wq]
	endif
	line2 0, 0, wRr * cos(wAm), wRr * sin(wAm)
	wVr = wRr
	wVt = wiTq[wq]
	wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × 定格なし"
	if wVt > 0 then wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × " + str(wVt, 4 + (wVt >= 10) + (wVt >= 100), 2) + "ton"
	! 読める向き（図面の上で左へ倒れない）に向け、文字反転でさらに 180°
	wAt = wAm + SYMB_ROTANGLE + 1080
	wAt = wAt - int(wAt / 360) * 360
	wFl = (wAt > 90 and wAt <= 270)
	if wiFq[wq] then wFl = 1 - wFl
	pen penEquip
	if wiPen > 0 then pen wiPen
	style "wiS"
	add2 wRr * 0.5 * cos(wAm), wRr * 0.5 * sin(wAm)
	rot2 wAm + 180 * wFl
	text2 0, texSiz * GLOB_SCALE / 1000 * 0.3, wTx
	del 2
next wq
if nWi > 0 then
	style "crT"
	pen pZ
endif
if nWi >= 1 then
	wRr = wiRq[1]
	wAm = wiMq[1]
	hotspot2 0, 0, 900, wiR1, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 901, wiR1, 2
	hotspot2 -cos(wAm), -sin(wAm), 902, wiR1, 3
	hotspot2 0, 0, 903, wiA1, 6
	hotspot2 wRr, 0, 904, wiA1, 4
	hotspot2 wRr * cos(wiA1), wRr * sin(wiA1), 905, wiA1, 5
	hotspot2 0, 0, 906, wiB1, 6
	hotspot2 wRr, 0, 907, wiB1, 4
	hotspot2 wRr * cos(wiB1), wRr * sin(wiB1), 908, wiB1, 5
	hotspot2 0, 0, 909, wiM1, 6
	hotspot2 wRr * 0.75, 0, 910, wiM1, 4
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 911, wiM1, 5
endif
if nWi >= 2 then
	wRr = wiRq[2]
	wAm = wiMq[2]
	hotspot2 0, 0, 912, wiR2, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 913, wiR2, 2
	hotspot2 -cos(wAm), -sin(wAm), 914, wiR2, 3
	hotspot2 0, 0, 915, wiA2, 6
	hotspot2 wRr, 0, 916, wiA2, 4
	hotspot2 wRr * cos(wiA2), wRr * sin(wiA2), 917, wiA2, 5
	hotspot2 0, 0, 918, wiB2, 6
	hotspot2 wRr, 0, 919, wiB2, 4
	hotspot2 wRr * cos(wiB2), wRr * sin(wiB2), 920, wiB2, 5
	hotspot2 0, 0, 921, wiM2, 6
	hotspot2 wRr * 0.75, 0, 922, wiM2, 4
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 923, wiM2, 5
endif
if nWi >= 3 then
	wRr = wiRq[3]
	wAm = wiMq[3]
	hotspot2 0, 0, 924, wiR3, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 925, wiR3, 2
	hotspot2 -cos(wAm), -sin(wAm), 926, wiR3, 3
	hotspot2 0, 0, 927, wiA3, 6
	hotspot2 wRr, 0, 928, wiA3, 4
	hotspot2 wRr * cos(wiA3), wRr * sin(wiA3), 929, wiA3, 5
	hotspot2 0, 0, 930, wiB3, 6
	hotspot2 wRr, 0, 931, wiB3, 4
	hotspot2 wRr * cos(wiB3), wRr * sin(wiB3), 932, wiB3, 5
	hotspot2 0, 0, 933, wiM3, 6
	hotspot2 wRr * 0.75, 0, 934, wiM3, 4
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 935, wiM3, 5
endif
if nWi >= 4 then
	wRr = wiRq[4]
	wAm = wiMq[4]
	hotspot2 0, 0, 936, wiR4, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 937, wiR4, 2
	hotspot2 -cos(wAm), -sin(wAm), 938, wiR4, 3
	hotspot2 0, 0, 939, wiA4, 6
	hotspot2 wRr, 0, 940, wiA4, 4
	hotspot2 wRr * cos(wiA4), wRr * sin(wiA4), 941, wiA4, 5
	hotspot2 0, 0, 942, wiB4, 6
	hotspot2 wRr, 0, 943, wiB4, 4
	hotspot2 wRr * cos(wiB4), wRr * sin(wiB4), 944, wiB4, 5
	hotspot2 0, 0, 945, wiM4, 6
	hotspot2 wRr * 0.75, 0, 946, wiM4, 4
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 947, wiM4, 5
endif
if nWi >= 5 then
	wRr = wiRq[5]
	wAm = wiMq[5]
	hotspot2 0, 0, 948, wiR5, 1 + 128
	hotspot2 wRr * cos(wAm), wRr * sin(wAm), 949, wiR5, 2
	hotspot2 -cos(wAm), -sin(wAm), 950, wiR5, 3
	hotspot2 0, 0, 951, wiA5, 6
	hotspot2 wRr, 0, 952, wiA5, 4
	hotspot2 wRr * cos(wiA5), wRr * sin(wiA5), 953, wiA5, 5
	hotspot2 0, 0, 954, wiB5, 6
	hotspot2 wRr, 0, 955, wiB5, 4
	hotspot2 wRr * cos(wiB5), wRr * sin(wiB5), 956, wiB5, 5
	hotspot2 0, 0, 957, wiM5, 6
	hotspot2 wRr * 0.75, 0, 958, wiM5, 4
	hotspot2 wRr * 0.75 * cos(wAm), wRr * 0.75 * sin(wAm), 959, wiM5, 5
endif
hotspot2 0, 0, 7, wrDir, 6
hotspot2 rW, 0, 8, wrDir, 4
hotspot2 rW * cos(wrDir), rW * sin(wrDir), 9, wrDir, 5
! アウトリガ4脚のホットスポット（ジャッキの所を車体の横へ引く）
if travel = 0 then
	hid = 20
	for e = -1 to 1 step 2
		xo = outF
		if e < 0 then xo = -outR
		for s = -1 to 1 step 2
			hid = hid + 3
			xs = xo - (s < 0) * outSh
			if e > 0 and s > 0 then
				hotspot2 xs, 0, hid, oFL, 1 + 128
				hotspot2 xs, lFL, hid + 1, oFL, 2
				hotspot2 xs, -1, hid + 2, oFL, 3
			endif
			if e > 0 and s < 0 then
				hotspot2 xs, 0, hid, oFR, 1 + 128
				hotspot2 xs, -lFR, hid + 1, oFR, 2
				hotspot2 xs, 1, hid + 2, oFR, 3
			endif
			if e < 0 and s > 0 then
				hotspot2 xs, 0, hid, oRL, 1 + 128
				hotspot2 xs, lRL, hid + 1, oRL, 2
				hotspot2 xs, -1, hid + 2, oRL, 3
			endif
			if e < 0 and s < 0 then
				hotspot2 xs, 0, hid, oRR, 1 + 128
				hotspot2 xs, -lRR, hid + 1, oRR, 2
				hotspot2 xs, 1, hid + 2, oRR, 3
			endif
		next s
	next e
endif
hotspot2 0, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 移動式クレーン 3D（タダノ GR-250N・GR-500N・GR-700N の寸法の目安）
! ---- 色の組（1 タダノ 白と青・2 加藤 黄と濃灰・3 灰）。同じ名前の define material は 1回だけ ----
bR = 0.94
bG = 0.96
bBl = 0.97
fR = 0.03
fG = 0.34
fBl = 0.66
if clr = 2 then
	bR = 0.97
	bG = 0.78
	bBl = 0.03
	fR = 0.20
	fG = 0.22
	fBl = 0.22
endif
if clr = 3 then
	bR = 0.70
	bG = 0.72
	bBl = 0.74
	fR = 0.30
	fG = 0.31
	fBl = 0.33
endif
define material "cr_body" 2, bR, bG, bBl
define material "cr_blue" 2, fR, fG, fBl
define material "cr_boom" 2, bR, bG, bBl
define material "cr_cw" 2, 0.22, 0.23, 0.24
define material "cr_steel" 2, 0.55, 0.57, 0.60
define material "cr_plate" 2, 0.35, 0.36, 0.38
define material "cr_tire" 2, 0.10, 0.10, 0.10
define material "cr_hook" 2, 0.95, 0.75, 0.10
define material "cr_load" 2, 0.70, 0.50, 0.30
define material "cr_glass" 2, 0.30, 0.45, 0.60
define material "cr_rim" 2, 0.80, 0.80, 0.78
define material "cr_lamp" 2, 0.95, 0.60, 0.10
define material "cr_head" 2, 0.92, 0.93, 0.85
define material "cr_tail" 2, 0.75, 0.10, 0.10
resol 16
plH = plT * plN
! 高さの基準（加藤の DXF の上部原点。作業時はキャリヤが jkUp 上がってタイヤが浮く）
cUp = jkUp * (travel = 0)
cTop = pivH - ftZ - jkUp
uZ = cTop + cUp
sX = pivB / 2.6
sZ = ftZ / 1.71
xT = tailR / sX
hwU = min(carW / 2 - 0.05, 0.477 * carW)
yP = bmW / 2 + 0.05
zB = cTop + cUp - 0.48
! ---- 敷鉄板（アウトリガ1脚に plN 枚。2枚は十字）とフロート・ジャッキ・アウトリガの外箱と内箱 ----
for e = -1 to 1 step 2
	xo = outF
	if e < 0 then xo = -outR
	for s = -1 to 1 step 2
		lg = lFL
		if e > 0 and s < 0 then lg = lFR
		if e < 0 and s > 0 then lg = lRL
		if e < 0 and s < 0 then lg = lRR
		if travel then lg = carW / 2 - 0.05
		xs = xo - (s < 0) * outSh
		yo = s * lg
		if plDraw then
			material "cr_plate"
			add xs - plB / 2, yo - plA / 2, 0
			block plB, plA, plT
			del 1
			if plN >= 2 then
				add xs - plA / 2, yo - plB / 2, plT
				block plA, plB, plT
				del 1
			endif
		endif
		! 箱（H 型は真横、X 型は車体の芯の近くから斜めに出る）
		xb = xs
		if otKind = 2 then xb = xo * 0.62
		dxO = xs - xb
		lO = sqr(dxO * dxO + yo * yo)
		aO = 90 * s
		if abs(dxO) > 0.0001 then aO = atn(yo / dxO) + 180 * (dxO < 0)
		lOut = min(lO, (carW / 2) / max(0.2, abs(sin(aO))))
		add xb, 0, zB
		rotz aO
		material "cr_blue"
		add 0, -0.17, 0
		block lOut, 0.34, 0.44
		del 1
		! 内箱（伸ばした分が見える）と先の縦の箱
		material "cr_body"
		if lO > lOut then
			add lOut - 0.05, -0.12, 0.05
			block lO - lOut + 0.05, 0.24, 0.32
			del 1
		endif
		del 2
		material "cr_blue"
		add xs - 0.19, yo - 0.19, zB - 0.04
		block 0.38, 0.38, 0.54
		del 1
		! ジャッキ（チューブとロッド）とフロート
		zf = plH
		if travel then zf = zB - 0.5
		material "cr_steel"
		if fltA > 0.01 then
			add xs - fltB / 2, yo - fltA / 2, zf
			block fltB, fltA, 0.07
			del 1
		else
			add xs, yo, zf
			cylind 0.07, fltD / 2
			del 1
		endif
		add xs, yo, zf + 0.07
		cone 0.1, jkR * 1.5, jkR, 90, 90
		del 1
		add xs, yo, zf + 0.15
		cylind max(0.05, zB - zf - 0.15), jkR
		del 1
		material "cr_blue"
		zt = max(zf + 0.2, zB - 0.65)
		add xs, yo, zt
		cylind zB - zt, jkR * 1.4
		del 1
	next s
next e
! ---- キャリヤ（作業時は jkUp 上がる）----
add 0, 0, cUp
material "cr_blue"
add -carRr, -carW / 2 + 0.12, 0.62
block carLn, carW - 0.24, cTop - 0.62
del 1
! デッキ（上面の板）と前後の傾き
material "cr_cw"
add -carRr + 0.05, -carW / 2 + 0.1, cTop - 0.02
block carLn - 0.1, carW - 0.2, 0.02
del 1
material "cr_blue"
! 後ろのエンジン室（旋回体の後端より後ろだけ）と煙突・ガラリ
xH = -tailR - 0.12
if xH + carRr > 0.3 then
	material "cr_body"
	add -carRr + 0.03, -carW / 2 + 0.16, cTop
	block xH + carRr - 0.03, carW - 0.32, 0.5
	del 1
	material "cr_cw"
	for i = 0 to 5
		add -carRr + 0.08 + i * (xH + carRr - 0.1) / 6, carW / 2 - 0.5, cTop + 0.5
		block (xH + carRr - 0.1) / 9, 0.32, 0.012
		del 1
	next i
	material "cr_steel"
	add -carRr + 0.25, -carW / 2 + 0.4, cTop + 0.5
	cylind 0.55, 0.06
	del 1
endif
! 前の縞板のデッキの手すり
material "cr_cw"
xFd = max(tailR * 0, cbX1 + 0.35)
if carF - xFd > 0.4 then
	add xFd, -carW / 2 + 0.12, cTop
	block carF - xFd - 0.08, carW - 0.24, 0.18
	del 1
endif
for i = 1 to nAx
	for s = -1 to 1 step 2
		! タイヤ（作業時は地面から上がる）・ホイール・ハブ・ボルト
		material "cr_tire"
		add ax[i], s * (carW / 2 - whW / 2 - 0.02), whR + 0.05 - jkUp * 0
		rotx 90
		addz -whW / 2
		cylind whW, whR
		material "cr_blue"
		addz -0.012
		cylind whW + 0.024, whR * 0.52
		material "cr_rim"
		addz -0.012
		cylind whW + 0.048, whR * 0.22
		del 5
		! フェンダー（タイヤの上）
		material "cr_body"
		add ax[i] - whR - 0.1, s * (carW / 2 - 0.02) - (s + 1) * (whW + 0.06) / 2, 2 * whR + 0.08
		block 2 * whR + 0.2, whW + 0.06, 0.06
		del 1
	next s
next i
! バンパー（前後）・ランプ・ミラー
material "cr_cw"
add carF - 0.1, -carW / 2 + 0.15, 0.6
block 0.15, carW - 0.3, 0.35
del 1
add -carRr - 0.1, -carW / 2 + 0.15, 0.6
block 0.15, carW - 0.3, 0.35
del 1
for s = -1 to 1 step 2
	material "cr_head"
	add carF + 0.05, s * (carW / 2 - 0.4) - 0.1, 0.98
	block 0.01, 0.2, 0.12
	del 1
	material "cr_lamp"
	add carF + 0.05, s * (carW / 2 - 0.65) - 0.05, 0.98
	block 0.01, 0.1, 0.12
	del 1
	material "cr_tail"
	add -carRr - 0.11, s * (carW / 2 - 0.4) - 0.12, 0.98
	block 0.01, 0.24, 0.12
	del 1
	! 前のミラー（棒の先の丸い鏡）
	material "cr_cw"
	x0q = carF - 0.3
	y0q = s * (carW / 2 - 0.15)
	z0q = cTop + 0.05
	x1q = carF - 0.15
	y1q = s * (carW / 2 + 0.2)
	z1q = cTop + 0.75
	rq = 0.015
	gosub "seg3"
	add x1q, y1q, z1q
	roty 90
	cylind 0.03, 0.12
	del 2
next s
! 前のはしごと横の昇降ステップ
material "cr_steel"
for k = 0 to 3
	add carF + 0.03, -carW / 2 + 0.35, 0.55 + k * (cTop - 0.55) / 4
	block 0.04, 0.48, 0.025
	del 1
next k
for s = -1 to 1 step 2
	for k = 0 to 2
		add -0.45, s * (carW / 2 + 0.02) - 0.14, 0.45 + k * (cTop - 0.5) / 3
		block 0.9, 0.14, 0.025
		del 1
	next k
next s
del 1
! ブームの先を平面のどの向きにも引く（平面の 1〜3・31〜33 と同じ組）
if travel = 0 then
	xF = tipX * cos(slD)
	yF = tipX * sin(slD)
	zF = tipZ + 0.3
	hotspot 0, yF, zF, 41, hfX, 1 + 128
	hotspot xF, yF, zF, 42, hfX, 2
	hotspot -1, yF, zF, 43, hfX, 3
	hotspot xF, 0, zF, 44, hfY, 1 + 128
	hotspot xF, yF, zF, 45, hfY, 2
	hotspot xF, -1, zF, 46, hfY, 3
endif
! ---- 上部旋回体（旋回角 slew で回す。Z は上部原点から。外形は加藤 SR-250RfⅡ の DXF を機種の根元の位置で伸ばす）----
rotz slD
add 0, 0, uZ
material "cr_cw"
cylind 0.1 * sZ, 0.7 * sX
add -1.48 * sX, -hwU + 0.1, 0.1 * sZ
block 2.88 * sX, 2 * hwU - 0.2, 0.05 * sZ
del 1
mul sX, 1, sZ
! 運転室の反対の箱と、運転室の下の箱（後ろは斜めに下がる）
material "cr_body"
yA = 0.43 * bmW / 0.53
yB = hwU
put -1.48, 0.15, -1.68, 0.39, -2.34, 0.6, -2.68, 0.6, -2.68, 1.28, -2.24, 1.28, -1.73, 1.155, -1.73, 0.15
gosub "sideP"
yB = -yA
yA = -hwU
put -1.48, 0.15, -1.68, 0.39, -2.34, 0.6, -2.68, 0.6, -2.68, 1.28, -2.24, 1.28, -1.68, 1.155, -0.29, 0.825, -0.29, 0.15
gosub "sideP"
! フートの側板 2 枚（ブームの根元を受ける。上端はピンの上へ出る）
material "cr_blue"
for s = -1 to 1 step 2
	yA = s * yP - 0.05
	yB = s * yP + 0.05
	put -2.77, 1.865, -2.37, 1.865, -0.655, 1.3, -0.255, 1.065, -0.29, 0.15, -1.48, 0.15, -2.455, 1.28, -2.76, 1.64
	gosub "sideP"
next s
del 1
! カウンタウエイト（後ろの丸い面。半径 tailR）と段の目地
material "cr_cw"
aC = asn(min(0.98, hwU / tailR))
xC = 2.68 * sX
for k = 0 to 8
	aq = 180 + aC - k * aC / 4
	put tailR * cos(aq), tailR * sin(aq)
next k
put -xC, -hwU, -xC, hwU
add 0, 0, 0.6 * sZ
prism nsp / 2, 0.68 * sZ, get(nsp)
del 1
material "cr_steel"
for k = 1 to cwN - 1
	add -tailR + 0.01, -hwU - 0.005, 0.6 * sZ + k * 0.68 * sZ / cwN
	block tailR - xC, 2 * hwU + 0.01, 0.012
	del 1
next k
! 吊り金具（目）
material "cr_steel"
for k = -1 to 1 step 2
	add -2.05 * sX, k * yP, 1.56 * sZ
	rotx -90
	cylind 0.03, 0.09
	del 2
next k
! ウインチ（主巻・補巻のドラムとフランジ）
for k = 0 to 1
	xD = -pivB - 0.05 + k * 0.72 * sX
	zD = (1.28 - k * 0.42) * sZ
	material "cr_cw"
	add xD, -yP + 0.06, zD
	rotx -90
	cylind 2 * yP - 0.12, 0.2 * sZ
	del 2
	material "cr_steel"
	for s = -1 to 1 step 2
		add xD, s * (yP - 0.08) - 0.02, zD
		rotx -90
		cylind 0.04, 0.27 * sZ
		del 2
	next s
next k
! 後ろの案内シーブ 2 枚と腕
material "cr_steel"
xG = -2.91 * sX
zG = 1.785 * sZ
for s = -1 to 1 step 2
	add xG, s * 0.26 - 0.03, zG
	rotx -90
	cylind 0.06, 0.165 * sZ
	del 2
	x0q = -3.0 * sX
	y0q = s * 0.26
	z0q = zG
	x1q = -2.845 * sX
	y1q = s * 0.26
	z1q = 1.28 * sZ
	rq = 0.03
	gosub "seg3"
next s
! 運転室（側面の多角形。前は下へとがる）
mul 1, 1, sZ
material "cr_body"
yA = -cbY1
yB = -cbY0
xb = cbX0
xf = cbX1
put xb, 0.15, xb + 0.13, 1.64, xb + 0.2, 1.67, xf - 0.75, 1.67, xf, 0.54, xf - 0.35, 0.15
gosub "sideP"
! 窓: 両側のドアの窓、前の大きい窓、後ろの小窓、屋根のひさし
material "cr_glass"
for s = 0 to 1
	yA = -cbY1 - 0.004 + s * (cbY1 - cbY0)
	yB = yA + 0.008
	put xb + 0.28, 0.78, xb + 0.28, 1.52, xf - 0.72, 1.52, xf - 0.2, 0.78
	gosub "sideP"
next s
yA = -cbY1 + 0.06
yB = -cbY0 - 0.06
put xf - 0.74, 1.62, xf - 0.05, 0.6, xf - 0.02, 0.62, xf - 0.71, 1.65
gosub "sideP"
add xb - 0.004, -cbY1 + 0.15, 0.9
block 0.008, cbY1 - cbY0 - 0.3, 0.55
del 1
material "cr_cw"
add xb + 0.2, -cbY1 - 0.03, 1.67
block xf - xb - 0.9, cbY1 - cbY0 + 0.06, 0.03
del 1
add xb + 0.9 * (xf - xb) * 0.4, -cbY1 - 0.008, 0.78
block 0.05, 0.012, 0.74
del 1
! 運転室の前の足場と手すり（ブームの側）・ミラー・ワイパー
material "cr_steel"
add xf - 0.6, -cbY0 + 0.0, 0.4
block 0.55, cbY0 - 0.04, 0.03
del 1
rq = 0.015
for k = 0 to 1
	x0q = xf - 0.58 + k * 0.5
	y0q = -0.1
	z0q = 0.42
	x1q = x0q
	y1q = y0q
	z1q = 1.25
	gosub "seg3"
next k
x0q = xf - 0.58
x1q = xf - 0.08
y0q = -0.1
y1q = -0.1
z0q = 1.25
z1q = 1.25
gosub "seg3"
material "cr_cw"
add xf + 0.1, -cbY1 - 0.1, 1.05
block 0.03, 0.12, 0.3
del 1
del 1
! 後ろの斜面の階段のステップ
material "cr_steel"
for k = 0 to 3
	add -2.3 * sX + k * 0.17 * sX, hwU - 0.55, (1.27 - k * 0.04) * sZ + 0.012
	block 0.14 * sX, 0.5, 0.02
	del 1
next k
! フートピンのボスと軸・起伏シリンダの下ピンの軸
xL = -pivB + cyLf
zL = ftZ - cyLd
material "cr_steel"
add -pivB, -yP - 0.08, ftZ
rotx -90
cylind 2 * yP + 0.16, 0.06
del 2
for s = -1 to 1 step 2
	add -pivB, s * (yP + 0.05) - 0.035, ftZ
	rotx -90
	cylind 0.07, 0.125
	del 2
next s
add xL, -yP, zL
rotx -90
cylind 2 * yP, 0.05
del 2
! ---- ブーム（基本ブームは長さ一定、先の段が同じ量ずつ出る。主シーブがブーム長さの先に来るよう軸を少し上へ振る）----
h1 = bmW * 1.35
cZ = -0.30 * h1
sD = 0.82 * h1
xBt = sqr(max(1, bL * bL - sD * sD))
bB = bA + atn(sD / xBt)
nS = max(2, min(8, nBs))
Lb = bMin * 0.92
! 起伏シリンダ（下ピンは旋回体、上ピンは基本ブームに固定。ブームを伸ばしても長さは変わらない）
xU = -pivB + cyUa * cos(bB) + cyUb * sin(bB)
zU = ftZ + cyUa * sin(bB) - cyUb * cos(bB)
lC = sqr((xU - xL) ^ 2 + (zU - zL) ^ 2)
tC = min(cyT, lC - 0.15)
for k = 1 to cyN
	yC = 0
	if cyN = 2 then yC = (2 * k - 3) * 0.38 * bmW
	x0q = xL
	y0q = yC
	z0q = zL
	x1q = xL + (xU - xL) * tC / lC
	y1q = yC
	z1q = zL + (zU - zL) * tC / lC
	rq = cyD / 2
	material "cr_blue"
	gosub "seg3"
	x0q = x1q
	z0q = z1q
	x1q = xU
	z1q = zU
	rq = cyR / 2
	material "cr_rim"
	gosub "seg3"
next k
add -pivB, 0, ftZ
roty -bB
! フート（くさび形に絞る）と上面の補強
material "cr_boom"
yA = -bmW / 2 + 0.03
yB = bmW / 2 - 0.03
put -0.12, 0.1, -0.12, -0.1, 0.28, cZ - h1 / 2, 0.28, cZ + h1 / 2
gosub "sideP"
! 上ピンの金具
material "cr_blue"
zb = cZ - h1 / 2
for s = -1 to 1 step 2
	yC = 0
	if cyN = 2 then yC = 0.38 * bmW
	yA = s * (abs(yC) + 0.12) - 0.02
	yB = yA + 0.04
	put cyUa - 0.32, zb + 0.02, cyUa + 0.3, zb + 0.02, cyUa + 0.12, -cyUb - 0.1, cyUa - 0.12, -cyUb - 0.1
	gosub "sideP"
next s
add cyUa, -abs(yC) - 0.14, -cyUb
rotx -90
cylind 2 * abs(yC) + 0.28, 0.05
del 2
! 段
for k = 1 to nS
	wS = bmW * (1 - 0.075 * (k - 1))
	hS = h1 * (1 - 0.085 * (k - 1))
	eK = Lb + (k - 1) * (xBt - 0.25 - Lb) / (nS - 1)
	sK = 0.28
	if k > 1 then sK = Lb + (k - 2) * (xBt - 0.25 - Lb) / (nS - 1) - 0.05
	lS = eK - sK
	material "cr_boom"
	add sK, 0, cZ + 0.0
	roty 90
	gosub "sect"
	del 2
	if k < nS then
		! 段の先の帯
		material "cr_steel"
		wS = wS + 0.03
		hS = hS + 0.03
		lS = 0.07
		add eK - 0.07, 0, cZ
		roty 90
		gosub "sect"
		del 2
	endif
next k
! 上面の長さ検出のケーブル
material "cr_cw"
add 0.4, bmW * 0.25, cZ + h1 / 2 + 0.01
block Lb - 0.6, 0.03, 0.02
del 1
! ケーブルリール（タダノ。基本ブームの左）
if clr = 1 then
	material "cr_steel"
	add pivB * 0 + 0.75 * sX * 2.4, bmW / 2 + 0.01, cZ
	rotx -90
	cylind 0.05, 0.4 * sZ
	material "cr_cw"
	addz 0.05
	cylind 0.02, 0.24 * sZ
	del 3
endif
! 格納したジブ（基本ブームの右の下に抱える）
if jL < 0.01 and jbSt then
	material "cr_body"
	lJ = Lb * 0.78
	yJ = -bmW / 2 - 0.2
	zJ = cZ - h1 * 0.15
	rq = 0.03
	for sy = -1 to 1 step 2
		for sz = -1 to 1 step 2
			x0q = 0.9
			y0q = yJ + sy * 0.1
			z0q = zJ + sz * 0.17
			x1q = 0.9 + lJ
			y1q = y0q
			z1q = z0q
			gosub "seg3"
		next sz
	next sy
	rq = 0.014
	nJ = int(lJ / 0.45)
	for i = 0 to nJ - 1
		sg = 1 - 2 * (i mod 2)
		x0q = 0.9 + i * lJ / nJ
		x1q = x0q + lJ / nJ
		for sy = -1 to 1 step 2
			y0q = yJ + sy * 0.1
			y1q = y0q
			z0q = zJ - sg * 0.17
			z1q = zJ + sg * 0.17
			gosub "seg3"
		next sy
	next i
endif
! ブームの先（側板・主シーブ・シングルトップ・上の案内シーブ。形は加藤 SL-500RfⅢ の DXF）
hC = h1 / 0.89
wE = bmW * (1 - 0.075 * (nS - 1))
add xBt, 0, -sD
material "cr_blue"
mul hC, 1, hC
for s = -1 to 1 step 2
	yA = s * wE / 2 - 0.015
	yB = s * wE / 2 + 0.015
	put -0.19, 1.0, -0.19, 0.75, -0.155, 0.7, -0.155, 0.2, -0.2, -0.05, 0, -0.205, 0.21, -0.22, 0.33, 0, 0.22, 0.3, 0.21, 0.7, 0.35, 1.1, 0.38, 1.2, 0, 1.2
	gosub "sideP"
next s
del 1
material "cr_steel"
nSh = max(1, min(6, shN))
for k = 1 to nSh
	add 0, (k - (nSh + 1) / 2) * 0.07 * hC - 0.0275, 0
	rotx -90
	cylind 0.055, 0.186 * hC
	del 2
next k
add 0.44 * hC, -0.03, -0.185 * hC
rotx -90
cylind 0.06, 0.2 * hC
del 2
add 0, -0.03, 1.09 * hC
rotx -90
cylind 0.06, 0.175 * hC
del 2
for s = -1 to 1 step 2
	x0q = 0.1 * hC
	y0q = s * wE / 4
	z0q = 0
	x1q = 0.44 * hC
	y1q = s * 0.05
	z1q = -0.185 * hC
	rq = 0.025
	gosub "seg3"
next s
del 1
del 2
! ブーム長さのホットスポット（ブームに沿って引く）
add -pivB, 0, ftZ
roty -bA
hotspot 0, 0, 0, 11, boomL, 1 + 128
hotspot bL, 0, 0, 12, boomL, 2
hotspot -1, 0, 0, 13, boomL, 3
del 2
del 1
! ブームの先で起伏角を動かすホットスポット（長さはそのまま）
hotspot -pivB, 0, pivH, 21, boomA, 6
hotspot -pivB + 1, 0, pivH, 22, boomA, 4
hotspot tbX, 0, tbZ + 0.6, 23, boomA, 5
hotspot -pivB, -1, pivH, 24, boomA, 7
if jL > 0.01 then
	! ジブ（箱の弦材とラチス。先へ細くなる）とジブ長さのホットスポット
	add tbX, 0, tbZ
	roty -(bA - jbO)
	material "cr_boom"
	wJ = bmW * 0.6
	rq = 0.03
	for sy = -1 to 1 step 2
		for sz = -1 to 1 step 2
			x0q = 0
			y0q = sy * wJ / 2
			z0q = sz * wJ / 2
			x1q = jL
			y1q = sy * wJ / 4
			z1q = sz * wJ / 4
			gosub "seg3"
		next sz
	next sy
	nJ = max(2, int(jL / max(wJ, 0.5)))
	rq = 0.015
	for i = 0 to nJ - 1
		sg = 1 - 2 * (i mod 2)
		wa = wJ * (1 - 0.5 * i / nJ) / 2
		wb = wJ * (1 - 0.5 * (i + 1) / nJ) / 2
		x0q = i * jL / nJ
		x1q = (i + 1) * jL / nJ
		for sz = -1 to 1 step 2
			y0q = -sg * wa
			y1q = sg * wb
			z0q = sz * wa
			z1q = sz * wb
			gosub "seg3"
		next sz
	next i
	material "cr_steel"
	add jL - 0.1, -0.03, 0
	rotx -90
	add 0, 0, -0.03
	cylind 0.06, 0.18
	del 3
	hotspot 0, 0, 0, 25, jbL, 1 + 128
	hotspot jL, 0, 0, 26, jbL, 2
	hotspot -1, 0, 0, 27, jbL, 3
	del 2
endif
! ワイヤ（掛数の本数）・フックブロック・フック（旋回体の座標でブームの先の真下）
hkB = hkHt - hkDm / 2
material "cr_steel"
nW = max(2, min(12, fallN))
for i = 1 to nW
	add tipX, (i - (nW + 1) / 2) * 0.05, hkD + hkB
	cylind tipZ - hkD - hkB, 0.009
	del 1
next i
! 側板（丸）とシーブ
material "cr_hook"
for s = -1 to 1 step 2
	add tipX, s * (hkDm * 0.32) - 0.02, hkD + hkB
	rotx -90
	cylind 0.04, hkDm / 2
	del 2
next s
material "cr_steel"
add tipX, -hkDm * 0.3, hkD + hkB
rotx -90
cylind hkDm * 0.6, hkDm * 0.4
del 2
add tipX, 0, hkD + hkB - hkDm * 0.62
cylind hkDm * 0.2, hkDm * 0.16
del 1
add tipX, 0, hkD + hkHt * 0.42
cylind hkB - hkDm * 0.62 - hkHt * 0.42 + 0.02, 0.05
del 1
! フック（横から見た C の形）
material "cr_hook"
add tipX, 0, hkD
mul hkHt, 1, hkHt
yA = -0.035
yB = 0.035
put -0.04, 0.45, 0.04, 0.45, 0.05, 0.32, 0.17, 0.2, 0.19, 0.09, 0.12, 0.01, 0.0, 0.0, -0.13, 0.05, -0.19, 0.14, -0.13, 0.2, -0.1, 0.13, -0.03, 0.08, 0.07, 0.09, 0.1, 0.15, -0.03, 0.26
gosub "sideP"
del 2
! フックの高さのホットスポット
hotspot tipX, 0, 0, 14, hkZ, 1 + 128
hotspot tipX, 0, hkD, 15, hkZ, 2
hotspot tipX, 0, -1, 16, hkZ, 3
if ldOn and travel = 0 then
	! 揚重物（大きさ ldW×ldD×ldH。吊りしろ ldS。SCP の手引 p.5）
	zl = hkD - ldS - ldH
	material "cr_load"
	add tipX - ldW / 2, -ldD / 2, zl
	block ldW, ldD, ldH
	del 1
	! 玉掛けワイヤ（吊り荷の四隅からフックへ）
	material "cr_steel"
	for c = 0 to 3
		x0q = tipX - ldW / 2 + 0.05 + (ldW - 0.1) * (c mod 2)
		y0q = -ldD / 2 + 0.05 + (ldD - 0.1) * int(c / 2)
		z0q = zl + ldH
		x1q = tipX
		y1q = 0
		z1q = hkD + 0.05
		rq = 0.008
		gosub "seg3"
	next c
endif
del 1
if wrOn then
	! 作業半径の円（地盤の高さ）
	material "cr_tail"
	rotz slD * 0
	add 0, 0, 0.05
	circle tipX
	del 1
	del 1
endif
if infoOn then
	! クレーン情報（フックと車体の後ろ。視点の向きへ回す）
	define style "crI" "Arial", 900 * texZ, 1, 0
	style "crI"
	aV = 0
	dxV = GLOB_EYEPOS_X - SYMB_POS_X
	dyV = GLOB_EYEPOS_Y - SYMB_POS_Y
	if abs(dxV) > 0.01 then aV = atn(dyV / dxV) + 180 * (dxV < 0)
	aV = aV - SYMB_ROTANGLE + 90
	material "cr_tail"
	add tipX * cos(slD), tipX * sin(slD), hkD + hkHt + 0.6
	rotz aV
	rotx 90
	if slgOn = 0 then
		if rated > 0 then
			text 0.02, 0, "Max " + str(rated * sfRate, 5, 2) + "t (" + str(sfRate * 100, 3, 0) + "%)"
		else
			text 0.02, 0, "Max -"
		endif
	endif
	del 3
	add -carRr - 0.5, 0, carH + 0.5
	rotz aV
	rotx 90
	text 0.02, 0, crName
	add 0, -0.9 * texZ, 0
	text 0.02, 0, "Boom=" + str(bL, 4, 1) + "m R=" + str(tipX, 4, 1) + "m"
	del 4
endif
! 吊り点の印（丸十字）と Max（scripts/gdl_mark.py）
if slgOn and (travel = 0) then
	define material "mk_red" 2, 0.90, 0.10, 0.10
	define style "mkI" "Arial", 900 * texZ, 4, 0
	mkX = tipX * cos(slD)
	mkY = tipX * sin(slD)
	mkH = hkD
	mkQ = mkH - slgH
	mkR = texZ
	mkV = capT
	material "mk_red"
	lin_ mkX, mkY, mkH, mkX, mkY, mkQ
	aV = 0
	dxV = GLOB_EYEPOS_X - SYMB_POS_X
	dyV = GLOB_EYEPOS_Y - SYMB_POS_Y
	if abs(dxV) > 0.01 then aV = atn(dyV / dxV) + 180 * (dxV < 0)
	aV = aV - SYMB_ROTANGLE + 90
	add mkX, mkY, mkQ
	rotz aV
	rotx 90
	for k = 0 to 24
		put mkR * cos(15 * k), mkR * sin(15 * k), 15 - 16 * (k = 24)
	next k
	for k = 0 to 24
		put mkR * 0.82 * cos(15 * k), mkR * 0.82 * sin(15 * k), 15 - 16 * (k = 24)
	next k
	prism_ nsp / 3, 0.03, get(nsp)
	add -mkR, -mkR * 0.05, 0
	block mkR * 2, mkR * 0.1, 0.03
	del 1
	add -mkR * 0.05, -mkR, 0
	block mkR * 0.1, mkR * 2, 0.03
	del 1
	style "mkI"
	add mkR * 1.3, 0, 0
	if mkV > 0 then
		text 0.02, 0, "Max " + str(mkV, 4 + (mkV >= 10) + (mkV >= 100), 2) + "t" + " (" + str(sfRate * 100, 3, 0) + "%)"
	else
		text 0.02, 0, "Max -"
	endif
	del 4
	hotspot 0, mkY, mkQ, 960, hfX, 1 + 128
	hotspot mkX, mkY, mkQ, 961, hfX, 2
	hotspot -1, mkY, mkQ, 962, hfX, 3
	hotspot mkX, 0, mkQ, 963, hfY, 1 + 128
	hotspot mkX, mkY, mkQ, 964, hfY, 2
	hotspot mkX, -1, mkQ, 965, hfY, 3
	hotspot mkX, mkY, 0, 966, mkZ, 1 + 128
	hotspot mkX, mkY, mkQ, 967, mkZ, 2
	hotspot mkX, mkY, -1, 968, mkZ, 3
endif
end

"sideP":
	! put 済みの (x, z) の列を Y の yA〜yB に押し出す
	add 0, yB, 0
	rotx 90
	prism nsp / 2, yB - yA, get(nsp)
	del 2
return

"sect":
	! ブームの断面（幅 wS・高さ hS・長さ lS。roty 90 の中で x＝−高さ。1 ラウンド・2 六角・3 箱）
	if bmSec = 1 then
		put -0.5 * hS, -0.34 * wS, -0.5 * hS, 0.34 * wS, -0.38 * hS, 0.5 * wS, 0.02 * hS, 0.5 * wS, 0.22 * hS, 0.45 * wS, 0.4 * hS, 0.33 * wS, 0.5 * hS, 0.15 * wS
		put 0.5 * hS, -0.15 * wS, 0.4 * hS, -0.33 * wS, 0.22 * hS, -0.45 * wS, 0.02 * hS, -0.5 * wS, -0.38 * hS, -0.5 * wS
	endif
	if bmSec = 2 then
		put -0.5 * hS, -0.34 * wS, -0.5 * hS, 0.34 * wS, -0.38 * hS, 0.5 * wS, 0.02 * hS, 0.5 * wS, 0.5 * hS, 0.2 * wS, 0.5 * hS, -0.2 * wS, 0.02 * hS, -0.5 * wS, -0.38 * hS, -0.5 * wS
	endif
	if bmSec = 3 then
		put -0.5 * hS, -0.42 * wS, -0.5 * hS, 0.42 * wS, -0.42 * hS, 0.5 * wS, 0.42 * hS, 0.5 * wS, 0.5 * hS, 0.42 * wS, 0.5 * hS, -0.42 * wS, 0.42 * hS, -0.5 * wS, -0.42 * hS, -0.5 * wS
	endif
	prism nsp / 2, lS, get(nsp)
return

"seg3":
	! (x0q, y0q, z0q) から (x1q, y1q, z1q) の円柱（半径 rq。向きは問わない）
	dxq = x1q - x0q
	dyq = y1q - y0q
	dzq = z1q - z0q
	hq = sqr(dxq ^ 2 + dyq ^ 2)
	lq = sqr(hq ^ 2 + dzq ^ 2)
	if lq > 0.001 then
		az = 0
		if hq > 0.0001 then
			if abs(dxq) < 0.0001 then
				az = 90
				if dyq < 0 then az = -90
			else
				az = atn(dyq / dxq)
				if dxq < 0 then az = az + 180
			endif
		endif
		el = 90
		if dzq < 0 then el = -90
		if hq > 0.0001 then el = atn(dzq / hq)
		add x0q, y0q, z0q
		rotz az
		roty 90 - el
		cylind lq, rq
		del 3
	endif
	return

! ==========================================================
! ==== UIスクリプト ====
! ==========================================================
! クレーン設定: 作業半径の表示（scripts/gdl_radii.py）
ui_dialog "クレーン設定", 444, 266
if (1) then
ui_outfield "平面の作業半径の表示", 12, 8, 300, 18
ui_outfield "表示数", 12, 32, 60, 18
ui_infield "wiNum", 76, 30, 50, 20
ui_outfield "半径", 186, 32, 60, 18
ui_outfield "角度範囲", 250, 32, 120, 18
ui_outfield "文字反転", 376, 32, 60, 18
if nWi >= 1 then
wVr = wiRq[1]
wVt = wiTq[1]
wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × 定格なし"
if wVt > 0 then wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × " + str(wVt, 4 + (wVt >= 10) + (wVt >= 100), 2) + "ton"
ui_outfield "1. " + strsub(wTx, 6, 40), 12, 60, 170, 18
ui_infield "wiR1", 186, 58, 60, 20
ui_infield "wiA1", 250, 58, 60, 20
ui_infield "wiB1", 314, 58, 60, 20
ui_infield "wiF1", 392, 58, 20, 20
endif
if nWi >= 2 then
wVr = wiRq[2]
wVt = wiTq[2]
wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × 定格なし"
if wVt > 0 then wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × " + str(wVt, 4 + (wVt >= 10) + (wVt >= 100), 2) + "ton"
ui_outfield "2. " + strsub(wTx, 6, 40), 12, 88, 170, 18
ui_infield "wiR2", 186, 86, 60, 20
ui_infield "wiA2", 250, 86, 60, 20
ui_infield "wiB2", 314, 86, 60, 20
ui_infield "wiF2", 392, 86, 20, 20
endif
if nWi >= 3 then
wVr = wiRq[3]
wVt = wiTq[3]
wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × 定格なし"
if wVt > 0 then wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × " + str(wVt, 4 + (wVt >= 10) + (wVt >= 100), 2) + "ton"
ui_outfield "3. " + strsub(wTx, 6, 40), 12, 116, 170, 18
ui_infield "wiR3", 186, 114, 60, 20
ui_infield "wiA3", 250, 114, 60, 20
ui_infield "wiB3", 314, 114, 60, 20
ui_infield "wiF3", 392, 114, 20, 20
endif
if nWi >= 4 then
wVr = wiRq[4]
wVt = wiTq[4]
wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × 定格なし"
if wVt > 0 then wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × " + str(wVt, 4 + (wVt >= 10) + (wVt >= 100), 2) + "ton"
ui_outfield "4. " + strsub(wTx, 6, 40), 12, 144, 170, 18
ui_infield "wiR4", 186, 142, 60, 20
ui_infield "wiA4", 250, 142, 60, 20
ui_infield "wiB4", 314, 142, 60, 20
ui_infield "wiF4", 392, 142, 20, 20
endif
if nWi >= 5 then
wVr = wiRq[5]
wVt = wiTq[5]
wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × 定格なし"
if wVt > 0 then wTx = "作業半径 " + str(wVr, 3 + (wVr >= 10) + (wVr >= 100), 1) + "m × " + str(wVt, 4 + (wVt >= 10) + (wVt >= 100), 2) + "ton"
ui_outfield "5. " + strsub(wTx, 6, 40), 12, 172, 170, 18
ui_infield "wiR5", 186, 170, 60, 20
ui_infield "wiA5", 250, 170, 60, 20
ui_infield "wiB5", 314, 170, 60, 20
ui_infield "wiF5", 392, 170, 20, 20
endif
ui_outfield "文字色", 12, 206, 60, 18
ui_infield "wiPen", 76, 204, 60, 20
ui_outfield "吊りしろ", 186, 206, 60, 18
ui_infield "slgH", 250, 204, 60, 20
ui_outfield "吊り点の印と Max", 318, 206, 100, 18
ui_infield "slgOn", 420, 204, 20, 20
ui_outfield "0°は車体の前。平面の弧の中央で半径、両端で範囲、線の途中で範囲ごと回せます", 12, 234, 420, 18
else
ui_outfield "クローラクレーンのときに使います", 12, 8, 300, 18
endif

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 移動式クレーン: ホットスポットで引いた姿勢を書き戻す（長さ優先は起伏角、角度優先はブーム長さ。作業半径は届く所まで）
mq = GLOB_MODPAR_NAME
if travel = 0 and (mq = "hfX" or mq = "hfY") then
	! 平面のフックを引いた: 前後は作業半径、横は旋回（届かない半径は次の読み直しで最大に戻る）
	if abs(hfX) + abs(hfY) > 0.1 then
		if abs(hfX) < 0.0001 then
			aF = 90 + 180 * (hfY < 0)
		else
			aF = atn(hfY / hfX) + 180 * (hfX < 0)
			if aF < 0 then aF = aF + 360
		endif
		parameters hkR = sqr(hfX * hfX + hfY * hfY), slew = aF
	endif
endif
if bmStep and prio = 0 and mq = "boomL" then
	! 段階ブーム: 性能表のブーム長さのいちばん近い段へ
	bQ = rb[1]
	for k = 1 to nRb
		if abs(rb[k] - boomL) < abs(bQ - boomL) then bQ = rb[k]
	next k
	parameters boomL = bQ
endif
if travel = 0 and mq <> "hfX" and mq <> "hfY" then
	if prio = 0 then
		if GLOB_MODPAR_NAME = "boomA" then
			! ブームの先のホットスポット: 長さはそのままで起伏角を変え、作業半径を合わせる
			aQ = max(1, min(84, boomA))
			parameters hkR = -pivB + bL * cos(aQ) + jL * cos(aQ - jbO) * (jL > 0.01)
		else
			if abs(boomA - bA) > 0.01 then parameters boomA = bA
		endif
	else
		if abs(boomL - bL) > 0.001 then parameters boomL = bL
	endif
	if abs(hkR - tipX) > 0.001 and GLOB_MODPAR_NAME <> "boomA" then parameters hkR = tipX
	if abs(hfX - tipX * cos(slD)) + abs(hfY - tipX * sin(slD)) > 0.001 then parameters hfX = tipX * cos(slD), hfY = tipX * sin(slD)
endif
values "boomL" range [bMin, bMax]
values "prio" 0, 1
values "boomA" range [1, 84]
! アウトリガ: 引いた脚を性能表の張出の段（張出幅の半分）に吸い付ける。張出は車体の幅の半分から最大の段まで
mp = GLOB_MODPAR_NAME
if oSnap and nSs > 0 and (mp = "oFL" or mp = "oFR" or mp = "oRL" or mp = "oRR") then
	vq = oFL
	if mp = "oFR" then vq = oFR
	if mp = "oRL" then vq = oRL
	if mp = "oRR" then vq = oRR
	bq = ss[1] / 2
	for i = 1 to nSs
		if abs(ss[i] / 2 - vq) < abs(bq - vq) then bq = ss[i] / 2
	next i
	if mp = "oFL" then parameters oFL = bq
	if mp = "oFR" then parameters oFR = bq
	if mp = "oRL" then parameters oRL = bq
	if mp = "oRR" then parameters oRR = bq
endif
! outW から4脚へは書き戻さない（Tapir でまとめて入れると GLOB_MODPAR_NAME が outW のまま古い outW で脚を上書きした。2026-11-01）
! 作業半径の表示（scripts/gdl_radii.py）
values "wiNum" range [0, 5]
wMp = GLOB_MODPAR_NAME
values "wiR1" range [0.5, ]
if wMp = "wiM1" then
	parameters wiA1 = wiM1 - wiSq[1] / 2, wiB1 = wiM1 + wiSq[1] / 2
else
	if abs(wiM1 - wiMq[1]) > 0.001 then parameters wiM1 = wiMq[1]
endif
hideparameter "wiM1"
if nWi < 1 then
	hideparameter "wiR1", "wiA1", "wiB1", "wiF1"
endif
values "wiR2" range [0.5, ]
if wMp = "wiM2" then
	parameters wiA2 = wiM2 - wiSq[2] / 2, wiB2 = wiM2 + wiSq[2] / 2
else
	if abs(wiM2 - wiMq[2]) > 0.001 then parameters wiM2 = wiMq[2]
endif
hideparameter "wiM2"
if nWi < 2 then
	hideparameter "wiR2", "wiA2", "wiB2", "wiF2"
endif
values "wiR3" range [0.5, ]
if wMp = "wiM3" then
	parameters wiA3 = wiM3 - wiSq[3] / 2, wiB3 = wiM3 + wiSq[3] / 2
else
	if abs(wiM3 - wiMq[3]) > 0.001 then parameters wiM3 = wiMq[3]
endif
hideparameter "wiM3"
if nWi < 3 then
	hideparameter "wiR3", "wiA3", "wiB3", "wiF3"
endif
values "wiR4" range [0.5, ]
if wMp = "wiM4" then
	parameters wiA4 = wiM4 - wiSq[4] / 2, wiB4 = wiM4 + wiSq[4] / 2
else
	if abs(wiM4 - wiMq[4]) > 0.001 then parameters wiM4 = wiMq[4]
endif
hideparameter "wiM4"
if nWi < 4 then
	hideparameter "wiR4", "wiA4", "wiB4", "wiF4"
endif
values "wiR5" range [0.5, ]
if wMp = "wiM5" then
	parameters wiA5 = wiM5 - wiSq[5] / 2, wiB5 = wiM5 + wiSq[5] / 2
else
	if abs(wiM5 - wiMq[5]) > 0.001 then parameters wiM5 = wiMq[5]
endif
hideparameter "wiM5"
if nWi < 5 then
	hideparameter "wiR5", "wiA5", "wiB5", "wiF5"
endif
if (1) = 0 then
	hideparameter "wiNum", "wiPen"
endif
! 吊り点の印（scripts/gdl_mark.py）
hideparameter "mkZ"
if travel = 0 then
	if GLOB_MODPAR_NAME = "mkZ" then
		parameters hkZ = mkZ + slgH
	else
		if abs(mkZ - (hkD - slgH)) > 0.001 then parameters mkZ = hkD - slgH
	endif
else
	hideparameter "slgOn", "slgH"
endif
values "slgH" range [0, ]
values{2} "drMode" 0, "縮尺で自動", 1, "詳細（1/100）", 2, "標準（1/200）", 3, "簡略"

