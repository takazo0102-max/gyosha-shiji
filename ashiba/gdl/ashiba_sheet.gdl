! ==========================================================
! 養生シート（メッシュシート・防音シート。足場の外側の構面・1面に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_sheet/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_sheet.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 足場条件の「養生材」がなし以外なら、面ごとに置く。地面から支柱の天端まで、出隅は角の外まで回す。
! 3Dは透ける膜と1枚の幅（1.8m）ごとの継ぎ目、平面は外側の破線と目盛り。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng    角度    面の向き（度）                                                                              既定 0
!   zH         長さ    足場の立つ高さ（下の屋根から建てた上の部分）                                                既定 0
!   lineMode   ブール  3Dを線で（軽い）                                                                            既定 0
!   offY       長さ    シートの面（内側建地芯から外へ。外側建地列＋60）                                            既定 0.67
!   x0         長さ    始点（面に沿って）                                                                          既定 0
!   x1         長さ    終点（面に沿って）                                                                          既定 5.4
!   zB         長さ    下端                                                                                        既定 0
!   zT         長さ    上端                                                                                        既定 5.1
!   sheetW     長さ    シート1枚の幅（継ぎ目の線）                                                                 既定 1.8
!   sheetKind  文字列  養生材                                                                                      既定 "メッシュシート"
!   panelList  文字列  シートの割付「始点,終点,特殊(0/1)」の繰り返し mm（継ぎ目は足場の支柱。空なら 1枚の幅ごと）  既定 ""
!   clampList  文字列  シートクランプの高さ mm（カンマ区切り。継ぎ目と端の支柱に付ける。空なら付けない）           既定 ""
!   matSheet   表面材  表面材（0＝養生材の既定色）                                                                 既定 0
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 養生シート（メッシュシート・防音シート）。足場の外側の構面に、面ごとに1部品

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 養生シート 2D（平面）: 外側建地列の外の破線
! 利用者の指摘（2026-10-23）: 足場平面の下に変の線がある。線種 3 は縮尺で点にしか見えず、1枚ごとの目盛りが
! 足場の外に短い縦線で残っていた。破線は図面上で 3mm・間 1.5mm を自分で描き、目盛りはやめる
! ============================================================
pen 1
rot2 faceAng
dl = 0.003 * GLOB_SCALE
dg = 0.0015 * GLOB_SCALE
if dl < 0.05 then dl = 0.05
if dg < 0.025 then dg = 0.025
xs = x0
while xs < x1 - 0.001 do
	xe = xs + dl
	if xe > x1 then xe = x1
	line2 xs, -offY, xe, -offY
	xs = xs + dl + dg
endwhile
hotspot2 x0, -offY
hotspot2 x1, -offY
del 1

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 養生シート 3D: 外側建地列の外（offY）に、面に沿って x0〜x1、高さ zB〜zT の膜。
! メッシュシートは向こうが透ける。シート1枚の幅（sheetW）ごとに継ぎ目の線を引く
!   原点＝内側建地列の始点の支柱、+Y＝躯体側（シートは -offY）
! ============================================================
pen 1
! 断面図・立面図・展開図（GLOB_VIEW_TYPE 4・5・6）では描かない。足場立面図は断面図ビューポイントで作るので、
! 手前の外構面のシートが足場を隠して図にならない（利用者の指摘 2026-10-20: 外部のメッシュは立面図で見えないように）。
! 3Dウィンドウ・平面では描く
hideHere = 0
if GLOB_VIEW_TYPE = 4 or GLOB_VIEW_TYPE = 5 or GLOB_VIEW_TYPE = 6 then hideHere = 1
if GLOB_CONTEXT = 4 or GLOB_CONTEXT = 24 then hideHere = 1
if hideHere then end
rotz faceAng
addz zH
if lineMode then
	lin_ x0, -offY, zB, x1, -offY, zB
	lin_ x1, -offY, zB, x1, -offY, zT
	lin_ x1, -offY, zT, x0, -offY, zT
	lin_ x0, -offY, zT, x0, -offY, zB
else
	if matSheet > 0 then
		material matSheet
	else
		! 既定色: メッシュシートは灰（透過）、防音・密閉シートは白っぽい不透明に近い色
		if sheetKind = "メッシュシート" then
			! 汎用（type 0）で透過率を指定する。ガラス（type 4）は透けが弱く、中の足場が見えなかった（実機 2026-10-20）
			! 色 r,g,b・環境光・拡散・反射・透過 0.75・光沢・透過の減衰・反射色・発光色・発光の減衰
			define material "ashiba_mesh_sheet" 0, 0.55, 0.60, 0.66, 0.6, 0.6, 0.1, 0.75, 5, 0, 1, 1, 1, 0, 0, 0, 0
			material "ashiba_mesh_sheet"
		else
			define material "ashiba_solid_sheet" 1, 0.86, 0.88, 0.86
			material "ashiba_solid_sheet"
		endif
	endif
	! 割付（panelList）: 継ぎ目は足場の支柱の位置。特殊シート（スパンと幅の違う升目・隅・隙間に伸ばす分）は色を替える
	! （利用者の指定 2026-10-24: 外部シートの割り付けは足場と同じにして、間が開いてる部分は特殊シートとして伸ばす）
	dim pA[], pB[], pS[]
	nP = 0
	rest = panelList
	k3 = 0
	while strlen(rest) > 0 and nP < 200 do
		pc = strstr(rest, ",")
		if pc > 0 then
			item = strsub(rest, 1, pc - 1)
			rest = strsub(rest, pc + 1, strlen(rest) - pc)
		else
			item = rest
			rest = ""
		endif
		kk = split(item, "%n", vv)
		if kk > 0 then
			k3 = k3 + 1
			if k3 = 1 then pA[nP + 1] = vv / 1000
			if k3 = 2 then pB[nP + 1] = vv / 1000
			if k3 = 3 then
				nP = nP + 1
				pS[nP] = vv
				k3 = 0
			endif
		endif
	endwhile
	if nP = 0 then
		add x0, -offY - 0.001, zB
		block x1 - x0, 0.002, zT - zB
		del 1
		! 継ぎ目（1枚の幅ごと）
		nW = int((x1 - x0) / sheetW + 0.999)
		for iw = 1 to nW - 1
			xs = x0 + iw * sheetW
			lin_ xs, -offY - 0.002, zB, xs, -offY - 0.002, zT
		next iw
	else
		mStd = 0
		if matSheet > 0 then mStd = matSheet
		for ip = 1 to nP
			if pS[ip] = 1 and matSheet = 0 then
				! 特殊シート: 少し黄みの色（標準のシートと見分ける）
				define material "ashiba_sheet_special" 0, 0.78, 0.70, 0.45, 0.6, 0.6, 0.1, 0.55, 5, 0, 1, 1, 1, 0, 0, 0, 0
				material "ashiba_sheet_special"
			else
				if matSheet > 0 then
					material matSheet
				else
					if sheetKind = "メッシュシート" then
						material "ashiba_mesh_sheet"
					else
						material "ashiba_solid_sheet"
					endif
				endif
			endif
			add pA[ip], -offY - 0.001, zB
			block pB[ip] - pA[ip], 0.002, zT - zB
			del 1
			if ip > 1 then lin_ pA[ip], -offY - 0.002, zB, pA[ip], -offY - 0.002, zT
		next ip
		! シートクランプ（利用者の指定 2026-10-24: シートクランプGDLも作成してつけて）: シートの継ぎ目と端の支柱に、
		! 根がらみと各層の手すりの高さで。外側建地（シートの面からあき 60 の内）を抱く本体と、シートのハトメに掛ける爪
		dim cZ[]
		nC = 0
		rest = clampList
		while strlen(rest) > 0 and nC < 60 do
			pc = strstr(rest, ",")
			if pc > 0 then
				item = strsub(rest, 1, pc - 1)
				rest = strsub(rest, pc + 1, strlen(rest) - pc)
			else
				item = rest
				rest = ""
			endif
			kk = split(item, "%n", vv)
			if kk > 0 then
				nC = nC + 1
				cZ[nC] = vv / 1000
			endif
		endwhile
		if nC > 0 then
			define material "ashiba_sclamp_zinc" 2, 0.80, 0.81, 0.83
			material "ashiba_sclamp_zinc"
			resol 8
			for ic = 1 to nP + 1
				if ic = 1 then
					xc = pA[1] + 0.06
				else
					if ic = nP + 1 then
						xc = pB[nP] - 0.06
					else
						xc = pA[ic]
					endif
				endif
				for jz = 1 to nC
					zc = cZ[jz]
					if zc > zB and zc < zT then
						! 建地を抱く本体（φ48.6 の外に厚み）
						add xc, -offY + 0.06, zc - 0.025
						cylind 0.05, 0.033
						del 1
						! シートの面へ出る腕と爪
						add xc - 0.008, -offY - 0.004, zc - 0.006
						block 0.016, 0.034, 0.012
						del 1
						add xc - 0.008, -offY - 0.010, zc - 0.006
						block 0.016, 0.006, 0.030
						del 1
					endif
				next jz
			next ic
		endif
	endif
endif
hotspot x0, -offY, zB
hotspot x1, -offY, zB
hotspot x0, -offY, zT
hotspot x1, -offY, zT
del 2

