! ==========================================================
! 仮設建物（ユニットハウス・仮設トイレ。連棟・段積み・外階段と外廊下。1棟に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_house/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_house.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 開発ループ（2026-11-01）: 他に必要な仮設材の4番。
! 原点＝手前の左の隅、+X＝長手。型 hsType（スーパーハウス 1〜5坪・仮設トイレ・快適トイレハウス）、連棟 nUnit、段 nTier、段ごとの用途 use1〜3、2段以上は手前に外廊下 corrW と外階段 stW（stairSd で端）。判定は site_house.py、置くのは scripts/house_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   hsType    整数      型（一覧で選ぶ）                              既定 4
!   nUnit     整数      連棟の数（ハウスは奥へ、トイレは横へ）        既定 1
!   nTier     整数      段の数（1〜3）                                既定 1
!   use1      整数      1階の用途                                     既定 1
!   use2      整数      2階の用途                                     既定 1
!   use3      整数      3階の用途                                     既定 1
!   stairSd   整数      外階段の位置（0＝左の端の外・1＝右の端の外）  既定 0
!   stairW    長さ      外階段の幅                                    既定 1.0
!   corrW     長さ      2階の外廊下の幅                               既定 1.0
!   hsName    文字列    名前（注記）                                  既定 "仮設建物"
!   texSiz    実数      文字の大きさ（mm）                            既定 2.5
!   penEquip  PenColor  線のペン                                      既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 仮設建物: 型の寸法（site_house.HOUSES）と並べ方
dim hwT[7], hdT[7], hhT[7], hkT[7]
hwT[1] = 1.850
hdT[1] = 1.850
hhT[1] = 2.603
hkT[1] = 0
hwT[2] = 3.650
hdT[2] = 1.850
hhT[2] = 2.603
hkT[2] = 0
hwT[3] = 4.550
hdT[3] = 2.300
hhT[3] = 2.603
hkT[3] = 0
hwT[4] = 5.450
hdT[4] = 2.300
hhT[4] = 2.603
hkT[4] = 0
hwT[5] = 7.250
hdT[5] = 2.300
hhT[5] = 2.603
hkT[5] = 0
hwT[6] = 0.850
hdT[6] = 1.550
hhT[6] = 2.470
hkT[6] = 1
hwT[7] = 2.600
hdT[7] = 2.200
hhT[7] = 2.650
hkT[7] = 2
dim usN[8]
usN[1] = "事務所"
usN[2] = "詰所"
usN[3] = "休憩所"
usN[4] = "更衣室"
usN[5] = "会議室"
usN[6] = "倉庫"
usN[7] = "トイレ"
usN[8] = "シャワー"
kT = max(1, min(7, hsType))
uw = hwT[kT]
ud = hdT[kT]
uh = hhT[kT]
isT = hkT[kT] > 0
nU = max(1, nUnit)
nT = max(1, min(3, nTier))
if isT then nT = 1
lx = uw
ly = ud * nU
if isT then
	lx = uw * nU
	ly = ud
endif
dim tu[3]
tu[1] = max(1, min(8, use1))
tu[2] = max(1, min(8, use2))
tu[3] = max(1, min(8, use3))
! 2階より上: 手前の外廊下と2階への外階段（蹴上 0.2 以下・踏面 0.24）
upOn = nT >= 2
nRs = ceil(uh / 0.2 - 0.0001)
rsH = uh / nRs
stL = (nRs - 1) * 0.24
stX = -stL
if stairSd = 1 then stX = lx

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 仮設建物 2D: ユニットの外形・出入口・窓・2階の外廊下と外階段・名前と段ごとの用途
pen penEquip
define style "hsT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "hsT"
for u = 1 to nU
	x0 = 0
	y0 = (u - 1) * ud
	if isT then
		x0 = (u - 1) * uw
		y0 = 0
	endif
	rect2 x0, y0, x0 + uw, y0 + ud
	! 出入口（手前の面。トイレは各ユニット、ハウスは手前の1つ）
	if isT or u = 1 then
		dw = min(0.8, uw - 0.1)
		dx = x0 + 0.05
		if isT then dx = x0 + (uw - dw) / 2
		line2 dx, y0, dx, y0 - dw
		arc2 dx, y0, dw, 270, 360
	endif
	! 窓（手前の面、ハウスだけ）
	if isT = 0 and u = 1 and uw > 2.5 then
		nW = max(1, int((uw - 1.0) / 1.8))
		for i = 1 to nW
			wx = 1.0 + (uw - 1.0) * (i - 0.5) / nW - 0.6
			line2 wx, -0.03, wx + 1.2, -0.03
			line2 wx, 0.03, wx + 1.2, 0.03
		next i
	endif
next u
! 2階の外廊下と外階段（上る向きの矢）
if upOn and isT = 0 then
	rect2 0, -corrW, lx, 0
	rect2 stX, -stairW, stX + stL, 0
	for i = 1 to nRs - 2
		line2 stX + i * 0.24, -stairW, stX + i * 0.24, 0
	next i
	ax = stX + 0.2
	bx = stX + stL - 0.2
	if stairSd = 1 then
		ax = stX + stL - 0.2
		bx = stX + 0.2
	endif
	line2 ax, -stairW / 2, bx, -stairW / 2
	line2 bx, -stairW / 2, bx - 0.25 * sgn(bx - ax), -stairW / 2 + 0.15
	line2 bx, -stairW / 2, bx - 0.25 * sgn(bx - ax), -stairW / 2 - 0.15
endif
! 名前と段ごとの用途（図面の向きに関係なく水平）
add2 lx / 2, ly / 2
rot2 -SYMB_ROTANGLE
tx = usN[tu[1]]
if nT >= 2 then tx = "1F " + usN[tu[1]] + " / 2F " + usN[tu[2]]
if nT >= 3 then tx = tx + " / 3F " + usN[tu[3]]
text2 0, 0.25, hsName
text2 0, -0.25, tx
del 2
hotspot2 0, 0
hotspot2 lx, 0
hotspot2 lx, ly
hotspot2 0, ly

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 仮設建物 3D: ユニット・出入口・窓・2階の外廊下と手すり・外階段
define material "hs_body" 2, 0.88, 0.89, 0.87
define material "hs_toil" 2, 0.80, 0.88, 0.95
define material "hs_base" 2, 0.30, 0.30, 0.32
define material "hs_glass" 2, 0.35, 0.50, 0.65
define material "hs_door" 2, 0.55, 0.57, 0.60
define material "hs_rail" 2, 0.90, 0.75, 0.10
resol 8
for t = 1 to nT
	for u = 1 to nU
		x0 = 0
		y0 = (u - 1) * ud
		if isT then
			x0 = (u - 1) * uw
			y0 = 0
		endif
		z0 = (t - 1) * uh
		material "hs_base"
		add x0 + 0.005, y0 + 0.005, z0
		block uw - 0.01, ud - 0.01, 0.12
		del 1
		material "hs_body"
		if isT then material "hs_toil"
		add x0 + 0.005, y0 + 0.005, z0 + 0.12
		block uw - 0.01, ud - 0.01, uh - 0.12
		del 1
		if isT or u = 1 then
			material "hs_door"
			dw = min(0.8, uw - 0.1)
			dx = x0 + 0.05
			if isT then dx = x0 + (uw - dw) / 2
			add dx, -0.01, z0 + 0.15
			block dw, 0.02, min(1.9, uh - 0.4)
			del 1
		endif
		if isT = 0 and u = 1 and uw > 2.5 then
			material "hs_glass"
			nW = max(1, int((uw - 1.0) / 1.8))
			for i = 1 to nW
				wx = 1.0 + (uw - 1.0) * (i - 0.5) / nW - 0.6
				add wx, -0.01, z0 + 0.9
				block 1.2, 0.02, 1.0
				del 1
			next i
		endif
	next u
next t
if upOn and isT = 0 then
	for t = 2 to nT
		zf = (t - 1) * uh
		! 外廊下の床と手すり（手すり 1.1・中桟 0.55、柱は 1.8 以内）
		material "hs_base"
		add 0, -corrW, zf - 0.12
		block lx, corrW, 0.12
		del 1
		material "hs_rail"
		nPo = max(1, ceil(lx / 1.8 - 0.0001))
		for i = 0 to nPo
			add lx * i / nPo, -corrW + 0.03, zf
			cylind 1.1, 0.0243
			del 1
		next i
		for r = 1 to 2
			hz = 1.1
			if r = 2 then hz = 0.55
			add 0, -corrW + 0.03, zf + hz
			roty 90
			cylind lx, 0.0243
			del 2
		next r
		! 廊下の階段の無い側の端
		ex = lx
		if stairSd = 1 then ex = 0
		for r = 1 to 2
			hz = 1.1
			if r = 2 then hz = 0.55
			add ex, -corrW + 0.03, zf + hz
			rotx -90
			cylind corrW - 0.03, 0.0243
			del 2
		next r
	next t
	! 2階への外階段（段板と側桁）
	material "hs_base"
	for i = 1 to nRs - 1
		sx = stX + (i - 1) * 0.24
		if stairSd = 1 then sx = stX + stL - i * 0.24
		add sx, -stairW, i * rsH - 0.04
		block 0.24, stairW, 0.04
		del 1
	next i
	material "hs_rail"
	ang = atn(uh / max(0.3, stL))
	sl = sqr(stL * stL + uh * uh)
	for s = 0 to 1
		ys = -stairW + 0.03
		if s = 1 then ys = -0.03
		if stairSd = 0 then
			add stX, ys, 1.1
			roty 90 - ang
		else
			add stX + stL, ys, 1.1
			roty -90 + ang
		endif
		cylind sl, 0.0243
		del 2
	next s
endif

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 仮設建物: 型・用途の一覧
values{2} "hsType" 1, "スーパーハウス 1坪（SH-H1）", 2, "スーパーハウス 2坪（SH-H2）", 3, "スーパーハウス 3.1坪（SH-H3）", 4, "スーパーハウス 3.8坪（SH-H4）", 5, "スーパーハウス 5坪（SH-H6）", 6, "仮設トイレ（ハマネツ TU・洋式1）", 7, "快適トイレハウス（カナテック KⅢ）"
values{2} "use1" 1, "事務所", 2, "詰所", 3, "休憩所", 4, "更衣室", 5, "会議室", 6, "倉庫", 7, "トイレ", 8, "シャワー"
values{2} "use2" 1, "事務所", 2, "詰所", 3, "休憩所", 4, "更衣室", 5, "会議室", 6, "倉庫", 7, "トイレ", 8, "シャワー"
values{2} "use3" 1, "事務所", 2, "詰所", 3, "休憩所", 4, "更衣室", 5, "会議室", 6, "倉庫", 7, "トイレ", 8, "シャワー"
values "nTier" 1, 2, 3
values "stairSd" 0, 1
values "nUnit" range [1, 12]

