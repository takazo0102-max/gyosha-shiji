! ==========================================================
! 仮設建物（ユニットハウス・仮設トイレ。連棟・段積み・外階段と外廊下。1棟に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_house/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_house.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 開発ループ（2026-11-01）: 他に必要な仮設材の4番。
! 原点＝手前の左の隅、+X＝長手。型 hsType（スーパーハウス 1〜5坪・仮設トイレ・快適トイレハウス）、連棟 nUnit、段 nTier、段ごとの用途 use1〜3、2段以上は手前に外廊下 corrW と外階段 stW（stairSd で端）。判定は site_house.py、置くのは scripts/house_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   hsType    整数      型（一覧で選ぶ）                                                    既定 4
!   nUnit     整数      連棟の数（ハウスは奥へ、トイレは横へ）                              既定 1
!   nTier     整数      段の数（1〜3）                                                      既定 1
!   use1      整数      1階の用途                                                           既定 1
!   use2      整数      2階の用途                                                           既定 1
!   use3      整数      3階の用途                                                           既定 1
!   stairSd   整数      外階段の位置（0＝左の端の外・1＝右の端の外）                        既定 0
!   stairW    長さ      外階段の幅（製品の幅）                                              既定 0.9
!   stairL    長さ      外階段の長さ（製品の長さ。FE用 4.1・KD用 4.99）                     既定 4.1
!   stName    文字列    外階段の品名（注記）                                                既定 "ハウス用階段 FE用"
!   corrW     長さ      外廊下の出（階段踊場部ユニット SC の D 1.14）                       既定 1.14
!   hsName    文字列    名前（注記）                                                        既定 "仮設建物"
!   texSiz    実数      文字の大きさ（mm）                                                  既定 2.5
!   penBold   PenColor  外形の線（太線。置くときに線のペンと同じ色の太いペン）              既定 21
!   penThin   PenColor  細部の線（細線。同じ色の細いペン）                                  既定 1
!   penZone   PenColor  範囲の線（作業半径・後端旋回半径・立入禁止・旋回軌跡）              既定 20
!   penMask   PenColor  上に載るものの背景の塗り（下の線を隠す。0＝隠さない）               既定 19
!   drMode    整数      平面の描き分け（0 縮尺で自動・1 詳細 1/100・2 標準 1/200・3 簡略）  既定 0
!   penEquip  PenColor  線のペン                                                            既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 仮設建物: 型の寸法（site_house.HOUSES）と並べ方
dim hwT[12], hdT[12], hhT[12], hkT[12]
hwT[1] = 1.850
hdT[1] = 1.850
hhT[1] = 2.603
hkT[1] = 0
hwT[2] = 3.650
hdT[2] = 1.850
hhT[2] = 2.603
hkT[2] = 0
hwT[3] = 4.550
hdT[3] = 2.300
hhT[3] = 2.603
hkT[3] = 0
hwT[4] = 5.450
hdT[4] = 2.300
hhT[4] = 2.603
hkT[4] = 0
hwT[5] = 7.250
hdT[5] = 2.300
hhT[5] = 2.603
hkT[5] = 0
hwT[6] = 0.850
hdT[6] = 1.550
hhT[6] = 2.470
hkT[6] = 1
hwT[7] = 2.600
hdT[7] = 2.200
hhT[7] = 2.650
hkT[7] = 2
hwT[8] = 3.740
hdT[8] = 1.800
hhT[8] = 2.575
hkT[8] = 0
hwT[9] = 4.590
hdT[9] = 1.900
hhT[9] = 2.575
hkT[9] = 0
hwT[10] = 5.540
hdT[10] = 2.200
hhT[10] = 2.575
hkT[10] = 0
hwT[11] = 5.700
hdT[11] = 2.300
hhT[11] = 2.650
hkT[11] = 0
hwT[12] = 5.632
hdT[12] = 2.285
hhT[12] = 2.700
hkT[12] = 0
dim usN[8]
usN[1] = "事務所"
usN[2] = "詰所"
usN[3] = "休憩所"
usN[4] = "更衣室"
usN[5] = "会議室"
usN[6] = "倉庫"
usN[7] = "トイレ"
usN[8] = "シャワー"
kT = max(1, min(12, hsType))
uw = hwT[kT]
ud = hdT[kT]
uh = hhT[kT]
isT = hkT[kT] > 0
nU = max(1, nUnit)
nT = max(1, min(3, nTier))
if isT then nT = 1
lx = uw
ly = ud * nU
if isT then
	lx = uw * nU
	ly = ud
endif
dim tu[3]
tu[1] = max(1, min(8, use1))
tu[2] = max(1, min(8, use2))
tu[3] = max(1, min(8, use3))
! 2階より上: 手前の外廊下と2階への外階段（製品の長さ stairL を段に分ける。蹴上 0.2 以下）
upOn = nT >= 2
nRs = ceil(uh / 0.2 - 0.0001)
rsH = uh / nRs
stL = max(1, stairL)
gStp = stL / max(1, nRs - 1)
! 外廊下は妻側（X0 の面。ユニットの短い辺が並ぶ）に、ユニットごとの階段踊場部ユニット SC（出 corrW・幅 ud）。階段はその端の先へ
cL = ly
stX = -stL
if stairSd = 1 then stX = cL

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 仮設建物 2D（CAD の平面図の描き方: scripts/gdl_draft.py）: 1階で切った平面。外形は太線、ユニットの境・扉・窓は細線、2階の
! 外廊下（上にある）は破線、外階段は細線と上る向きの矢。建物の範囲と注記の後ろは背景の色で塗って下の線（敷鉄板・通路）を隠す。
! 縮尺で 詳細（1/100: 壁の厚みの2本線・扉は壁を切って開きの円弧・窓は壁の中のガラスの線）・標準（1/200: 外形の1本・扉の円弧・
! 窓の2本線）・簡略（外形と名前だけ）
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "hsT" "ＭＳ Ｐゴシック", texSiz, 5, 0
define style "hsR" "ＭＳ Ｐゴシック", texSiz, 3, 0
style "hsT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
wT = 0.06                                  ! 壁（外壁パネル）の厚み【目安】
if mk then
	drawindex 20
	fill fiS
	poly2_b 5, 6, pM, pM,
		0, 0, 1,
		lx, 0, 1,
		lx, ly, 1,
		0, ly, 1,
		0, 0, -1
endif
for u = 1 to nU
	x0 = 0
	y0 = (u - 1) * ud
	if isT then
		x0 = (u - 1) * uw
		y0 = 0
	endif
	drawindex 30
	pen pO
	line_type ltS
	rect2 x0, y0, x0 + uw, y0 + ud
	pen pT
	if drLv = 1 then
		rect2 x0 + wT, y0 + wT, x0 + uw - wT, y0 + ud - wT
	endif
	if drLv < 3 then
		! 出入口（トイレは各ユニットの手前、平屋のハウスは手前の1つ、2段以上は妻側 X0 にユニットごと）
		if isT or (u = 1 and upOn = 0) then
			dw = min(0.8, uw - 0.1)
			dx = x0 + 0.05
			if isT then dx = x0 + (uw - dw) / 2
			if drLv = 1 and mk then
				! 壁を切る（開口の所を背景の色で塗り、枠の線を引く）
				drawindex 35
				fill fiS
				poly2_b 5, 6, pM, pM, dx, y0 - 0.002, 1, dx + dw, y0 - 0.002, 1, dx + dw, y0 + wT + 0.002, 1, dx, y0 + wT + 0.002, 1, dx, y0 - 0.002, -1
				drawindex 40
				line2 dx, y0, dx, y0 + wT
				line2 dx + dw, y0, dx + dw, y0 + wT
			endif
			drawindex 40
			line2 dx, y0, dx, y0 - dw
			arc2 dx, y0, dw, 270, 360
		endif
		if upOn and isT = 0 then
			yd = y0 + 0.15
			if drLv = 1 and mk then
				drawindex 35
				fill fiS
				poly2_b 5, 6, pM, pM, -0.002, yd, 1, wT + 0.002, yd, 1, wT + 0.002, yd + 0.8, 1, -0.002, yd + 0.8, 1, -0.002, yd, -1
				drawindex 40
				line2 0, yd, wT, yd
				line2 0, yd + 0.8, wT, yd + 0.8
			endif
			drawindex 40
			line2 0, yd, -0.8, yd
			arc2 0, yd, 0.8, 90, 180
		endif
		! 窓（手前の面、ハウスだけ）
		if isT = 0 and u = 1 and uw > 2.5 then
			nW = max(1, int((uw - 1.0) / 1.8))
			for i = 1 to nW
				wx = 1.0 + (uw - 1.0) * (i - 0.5) / nW - 0.6
				if drLv = 1 then
					if mk then
						drawindex 35
						fill fiS
						poly2_b 5, 6, pM, pM, wx, -0.002, 1, wx + 1.2, -0.002, 1, wx + 1.2, wT + 0.002, 1, wx, wT + 0.002, 1, wx, -0.002, -1
					endif
					drawindex 40
					line2 wx, 0, wx, wT
					line2 wx + 1.2, 0, wx + 1.2, wT
					line2 wx, 0, wx + 1.2, 0
					line2 wx, wT, wx + 1.2, wT
					line2 wx, wT / 2, wx + 1.2, wT / 2
				else
					drawindex 40
					line2 wx, -0.03, wx + 1.2, -0.03
					line2 wx, 0.03, wx + 1.2, 0.03
				endif
			next i
		endif
	endif
next u
! 2階の外廊下（階段踊場部ユニット SC をユニットごと。1階の平面では上にあるので破線）と外階段（細線・上る向きの矢）。
! 廊下の座標（x＝妻側に沿って・y＝外へ負）を部品の X0 の面へ回す（x→Y、y→X）
if upOn and isT = 0 and drLv < 3 then
	drawindex 40
	pen pT
	rot2 90
	mul2 1, -1
	line_type ltH
	rect2 0, -corrW, cL, 0
	for u = 1 to nU - 1
		line2 u * ud, -corrW, u * ud, 0
	next u
	line_type ltS
	rect2 stX, -stairW, stX + stL, 0
	if drLv = 1 then
		for i = 1 to nRs - 2
			line2 stX + i * gStp, -stairW, stX + i * gStp, 0
		next i
	endif
	ax = stX + 0.2
	bx = stX + stL - 0.2
	if stairSd = 1 then
		ax = stX + stL - 0.2
		bx = stX + 0.2
	endif
	line2 ax, -stairW / 2, bx, -stairW / 2
	line2 bx, -stairW / 2, bx - 0.25 * sgn(bx - ax), -stairW / 2 + 0.15
	line2 bx, -stairW / 2, bx - 0.25 * sgn(bx - ax), -stairW / 2 - 0.15
	del 2
	drawindex 50
	pen penEquip
	add2 -corrW - 0.3, stX + stL / 2
	rot2 -SYMB_ROTANGLE
	style "hsR"
	text2 0, 0, stName
	text2 0, -dT, "外廊下（上部）SC×" + str(nU, 1, 0)
	style "hsT"
	del 2
endif
! 名前と段ごとの用途（図面の向きに関係なく水平。後ろを背景の色で塗る。簡略は名前だけ）
drawindex 50
pen penEquip
tx = usN[tu[1]]
if nT >= 2 then tx = "1F " + usN[tu[1]] + " / 2F " + usN[tu[2]]
if nT >= 3 then tx = tx + " / 3F " + usN[tu[3]]
nTL = 1 + (drLv < 3)
tW = max(STW(hsName), STW(tx) * (drLv < 3)) / 1000 * GLOB_SCALE / 2 + 0.08
tH = dT * (nTL / 2 + 0.1)
! 建物の中に収まらなければ（小さな縮尺・小さな建物）手前の外に書く（白塗りで建物の線を消さない）
cs = abs(cos(SYMB_ROTANGLE))
sn = abs(sin(SYMB_ROTANGLE))
if 2 * tW * cs + 2 * tH * sn < lx * 0.9 and 2 * tW * sn + 2 * tH * cs < ly * 0.9 then
	add2 lx / 2, ly / 2
else
	add2 max(lx / 2, tW * cs + tH * sn + 0.3), -(tW * sn + tH * cs) - 0.3          ! 妻側の外階段より右に
endif
rot2 -SYMB_ROTANGLE
if mk then
	drawindex 45
	fill fiS
	poly2_b 5, 6, pM, pM, -tW, -tH, 1, tW, -tH, 1, tW, tH, 1, -tW, tH, 1, -tW, -tH, -1
endif
drawindex 50
if drLv < 3 then
	text2 0, dT / 2, hsName
	text2 0, -dT / 2, tx
else
	text2 0, 0, hsName
endif
del 2
hotspot2 0, 0
hotspot2 lx, 0
hotspot2 lx, ly
hotspot2 0, ly

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 仮設建物 3D: ユニット・出入口・窓・2階の外廊下と手すり・外階段
define material "hs_body" 2, 0.88, 0.89, 0.87
define material "hs_toil" 2, 0.80, 0.88, 0.95
define material "hs_base" 2, 0.30, 0.30, 0.32
define material "hs_glass" 2, 0.35, 0.50, 0.65
define material "hs_door" 2, 0.55, 0.57, 0.60
define material "hs_rail" 2, 0.90, 0.75, 0.10
resol 8
for t = 1 to nT
	for u = 1 to nU
		x0 = 0
		y0 = (u - 1) * ud
		if isT then
			x0 = (u - 1) * uw
			y0 = 0
		endif
		z0 = (t - 1) * uh
		material "hs_base"
		add x0 + 0.005, y0 + 0.005, z0
		block uw - 0.01, ud - 0.01, 0.12
		del 1
		material "hs_body"
		if isT then material "hs_toil"
		add x0 + 0.005, y0 + 0.005, z0 + 0.12
		block uw - 0.01, ud - 0.01, uh - 0.12
		del 1
		if isT or (u = 1 and upOn = 0) then
			material "hs_door"
			dw = min(0.8, uw - 0.1)
			dx = x0 + 0.05
			if isT then dx = x0 + (uw - dw) / 2
			add dx, -0.01, z0 + 0.15
			block dw, 0.02, min(1.9, uh - 0.4)
			del 1
		endif
		if upOn and isT = 0 then
			material "hs_door"
			add -0.01, y0 + 0.15, z0 + 0.15
			block 0.02, 0.8, min(1.9, uh - 0.4)
			del 1
		endif
		if isT = 0 and u = 1 and uw > 2.5 then
			material "hs_glass"
			nW = max(1, int((uw - 1.0) / 1.8))
			for i = 1 to nW
				wx = 1.0 + (uw - 1.0) * (i - 0.5) / nW - 0.6
				add wx, -0.01, z0 + 0.9
				block 1.2, 0.02, 1.0
				del 1
			next i
		endif
	next u
next t
if upOn and isT = 0 then
	! 廊下の座標（x＝妻側に沿って・y＝外へ負）を部品の X0 の面へ回す
	rotz 90
	muly -1
	for t = 2 to nT
		zf = (t - 1) * uh
		for u = 1 to nU
			yU = (u - 1) * ud
			! 階段踊場部ユニット SC: 床・外側の鉄骨柱2本・手摺（手すり 1.1・中桟 0.55）
			material "hs_base"
			add yU + 0.005, -corrW, zf - 0.12
			block ud - 0.01, corrW, 0.12
			del 1
			for e = 0 to 1
				add yU + 0.05 + e * (ud - 0.15), -corrW + 0.01, 0
				block 0.1, 0.1, zf - 0.12
				del 1
			next e
			material "hs_rail"
			for e = 0 to 1
				add yU + 0.1 + e * (ud - 0.2), -corrW + 0.06, zf
				cylind 1.1, 0.0243
				del 1
			next e
			for r = 1 to 2
				hz = 1.1
				if r = 2 then hz = 0.55
				add yU + 0.05, -corrW + 0.06, zf + hz
				roty 90
				cylind ud - 0.1, 0.0243
				del 2
			next r
			material "hs_base"
		next u
		! 廊下の階段の無い側の端の手摺
		ex = cL
		if stairSd = 1 then ex = 0
		material "hs_rail"
		for r = 1 to 2
			hz = 1.1
			if r = 2 then hz = 0.55
			add ex, -corrW + 0.06, zf + hz
			rotx -90
			cylind corrW - 0.06, 0.0243
			del 2
		next r
	next t
	! 2階への外階段（段板と手摺）
	material "hs_base"
	for i = 1 to nRs - 1
		sx = stX + (i - 1) * gStp
		if stairSd = 1 then sx = stX + stL - i * gStp
		add sx, -stairW, i * rsH - 0.04
		block gStp, stairW, 0.04
		del 1
	next i
	material "hs_rail"
	ang = atn(uh / max(0.3, stL))
	sl = sqr(stL * stL + uh * uh)
	for s = 0 to 1
		ys = -stairW + 0.03
		if s = 1 then ys = -0.03
		if stairSd = 0 then
			add stX, ys, 1.1
			roty 90 - ang
		else
			add stX + stL, ys, 1.1
			roty -90 + ang
		endif
		cylind sl, 0.0243
		del 2
	next s
	del 2
endif

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 仮設建物: 型・用途の一覧
values{2} "hsType" 1, "SH 1坪", 2, "SH 2坪", 3, "SH 3.1坪", 4, "SH 3.8坪", 5, "SH 5坪", 6, "トイレ TU", 7, "快適トイレ", 8, "ユニバーサル 2坪", 9, "ユニバーサル 2.9坪", 10, "ユニバーサル 3.8坪", 11, "NOIA-410 4坪", 12, "プロハウス 4坪"
values{2} "use1" 1, "事務所", 2, "詰所", 3, "休憩所", 4, "更衣室", 5, "会議室", 6, "倉庫", 7, "トイレ", 8, "シャワー"
values{2} "use2" 1, "事務所", 2, "詰所", 3, "休憩所", 4, "更衣室", 5, "会議室", 6, "倉庫", 7, "トイレ", 8, "シャワー"
values{2} "use3" 1, "事務所", 2, "詰所", 3, "休憩所", 4, "更衣室", 5, "会議室", 6, "倉庫", 7, "トイレ", 8, "シャワー"
values "nTier" 1, 2, 3
values "stairSd" 0, 1
values "nUnit" range [1, 12]
values{2} "drMode" 0, "縮尺で自動", 1, "詳細（1/100）", 2, "標準（1/200）", 3, "簡略"

