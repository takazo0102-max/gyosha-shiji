! ==========================================================
! 山留め支保工（切梁・腹起し・火打ち・中間杭。部材1本に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_shiho/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_shiho.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-11-06）: 縦横の切梁と中間杭も足して 切張り・腹起こしは手動でできるようにして LOD高く。
! 原点＝部材の始めの芯の平面（GL）、+X＝部材の向き、高さは shZ（GL から下）。shKind 1 切梁（主材・補助ピース・キリンジャッキ・カバープレート・上段は交差部のアングルとボルト）、2 腹起し、3 火打ち、4 中間杭（切梁受けブラケット・U ボルト）。割付は shiho.py、置くのは scripts/ywall_run.py と scripts/shiho_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   shKind    整数      種類（1 切梁・2 腹起し・3 火打ち・4 中間杭）                          既定 1
!   shL       長さ      部材の長さ（芯。中間杭は杭頭から先端まで）                            既定 10
!   shZ       長さ      部材の芯の深さ（GL から下。正）。中間杭は杭頭                         既定 1
!   sH        長さ      H形鋼の高さ H                                                         既定 0.3
!   sB        長さ      H形鋼のフランジ幅 B                                                   既定 0.3
!   sT1       長さ      H形鋼のウェブの厚さ t1                                                既定 0.01
!   sT2       長さ      H形鋼のフランジの厚さ t2                                              既定 0.015
!   shName    文字列    名前                                                                  既定 "切梁1"
!   shInfo    文字列    平面の注記（種類・形・深さ）                                          既定 "切梁 H-300（30HA）GL-1,000"
!   texSiz    実数      文字の大きさ（mm）                                                    既定 2.5
!   sgL       文字列    始めからの並びの長さ（mm）                                            既定 "525,300,7000,2000"
!   sgT       文字列    並びの種類（1 主材・2 補助ピース・3 キリンジャッキ・4 火打受ピース）  既定 "3,2,1,1"
!   cvL       長さ      カバープレートの長さ                                                  既定 0.6
!   cvT       長さ      カバープレートの厚さ                                                  既定 0.012
!   endT      長さ      主材の端板の厚さ                                                      既定 0.016
!   jkW       長さ      キリンジャッキの端板の角                                              既定 0.298
!   jcL       長さ      ジャッキカバーの長さ                                                  既定 1.5
!   xcX       文字列    上段の切梁: 下段と交わる所（始めから mm）                             既定 ""
!   xcH       文字列    交わる下段の切梁の高さ（mm）                                          既定 ""
!   xaL       長さ      交差部のアングルピースの長さ                                          既定 0.55
!   xbO       長さ      交叉部直ボルトの芯から（孔の間の半分）                                既定 0.17
!   brX       文字列    腹起しのブラケットの位置（mm）                                        既定 ""
!   hpA       長さ      火打受ピースの底の長さ                                                既定 0.45
!   hpS       整数      火打受ピースの底の向き（始めから見て 1 左へ開く・-1 右へ開く）        既定 1
!   shBot     長さ      中間杭の先端の深さ（GL から下）                                       既定 9
!   pkZ       文字列    中間杭: 切梁受けブラケットの天端の深さ（mm。段ごと）                  既定 "1150,4150"
!   pkR       長さ      中間杭の芯から下段の切梁の芯まで                                      既定 0.35
!   bkL       長さ      切梁受けブラケットの腕の長さ                                          既定 0.65
!   bkH       長さ      切梁受けブラケットの高さ                                              既定 0.45
!   ubW       長さ      締付用 U ボルトの幅                                                   既定 0.34
!   ubH       長さ      締付用 U ボルトの高さ                                                 既定 0.35
!   penBold   PenColor  外形の線（太線。置くときに線のペンと同じ色の太いペン）                既定 21
!   penThin   PenColor  細部の線（細線。同じ色の細いペン）                                    既定 1
!   penZone   PenColor  範囲の線（作業半径・後端旋回半径・立入禁止・旋回軌跡）                既定 20
!   penMask   PenColor  上に載るものの背景の塗り（下の線を隠す。0＝隠さない）                 既定 19
!   drMode    整数      平面の描き分け（0 縮尺で自動・1 詳細 1/100・2 標準 1/200・3 簡略）    既定 0
!   penEquip  PenColor  線のペン                                                              既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 山留め支保工: 並びを読む（m）
dim sgv[]
nSg = 0
rest = sgL
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSg = nSg + 1
		sgv[nSg] = v / 1000
	endif
endwhile
dim sgk[]
nSgT = 0
rest = sgT
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSgT = nSgT + 1
		sgk[nSgT] = v / 1
	endif
endwhile
dim xcv[]
nXc = 0
rest = xcX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nXc = nXc + 1
		xcv[nXc] = v / 1000
	endif
endwhile
dim xchv[]
nXh = 0
rest = xcH
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nXh = nXh + 1
		xchv[nXh] = v / 1000
	endif
endwhile
dim brv[]
nBr = 0
rest = brX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nBr = nBr + 1
		brv[nBr] = v / 1000
	endif
endwhile
dim pkv[]
nPk = 0
rest = pkZ
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPk = nPk + 1
		pkv[nPk] = v / 1000
	endif
endwhile
if nSgT < nSg then nSg = nSgT
if nXh < nXc then nXc = nXh
zc = -shZ

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 山留め支保工 2D（GL の下なので部材は隠れ線。中間杭は GL で切った断面を塗り）。詳細（1/100 まで）は芯・継手・ジャッキと伸縮の範囲
! （二点鎖線）・交叉部直ボルト・ブラケット、簡略（1/250 より小さい縮尺）は外形だけ（scripts/gdl_draft.py）
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "shT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "shT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
! 重なり: 30 杭の断面（塗り）、40 隠れ線と細部、50 文字
if shKind = 4 then
	drawindex 30
	pen pO
	if drLv < 3 then
		fill fiS
		poly2_b 13, 7, pO, pO,
			-sH / 2, -sB / 2, 1,
			-sH / 2 + sT2, -sB / 2, 1,
			-sH / 2 + sT2, -sT1 / 2, 1,
			sH / 2 - sT2, -sT1 / 2, 1,
			sH / 2 - sT2, -sB / 2, 1,
			sH / 2, -sB / 2, 1,
			sH / 2, sB / 2, 1,
			sH / 2 - sT2, sB / 2, 1,
			sH / 2 - sT2, sT1 / 2, 1,
			-sH / 2 + sT2, sT1 / 2, 1,
			-sH / 2 + sT2, sB / 2, 1,
			-sH / 2, sB / 2, 1,
			-sH / 2, -sB / 2, -1
	else
		rect2 -sH / 2, -sB / 2, sH / 2, sB / 2
	endif
	if drLv = 1 then
		drawindex 40
		pen pT
		line_type ltH
		rect2 sH / 2, -0.0375, sH / 2 + bkL, 0.0375
		line_type ltC
		line2 pkR, -0.6, pkR, 0.6
		line_type ltS
	endif
	drawindex 50
	pen penEquip
	if drLv < 3 then text2 0, sB / 2 + 0.1 + dT / 2, shInfo
	hotspot2 0, 0
	end
endif
hw = sH / 2
if shKind = 1 then hw = sB / 2
drawindex 40
pen pO
line_type ltH
line2 0, -hw, shL, -hw
line2 0, hw, shL, hw
line2 0, -hw, 0, hw
line2 shL, -hw, shL, hw
pen pT
if drLv = 1 then
	line_type ltC
	line2 -0.2, 0, shL + 0.2, 0
	line_type ltH
	x = 0
	for i = 1 to nSg
		if i > 1 then line2 x, -hw, x, hw
		if sgk[i] = 3 then
			rect2 x, -jkW / 2, x + sgv[i], jkW / 2
			line2 x, -jkW / 2, x + sgv[i], jkW / 2
			line2 x, jkW / 2, x + sgv[i], -jkW / 2
			line_type ltZ
			rect2 x + sgv[i] / 2 - 0.3, -jkW / 2 - 0.02, x + sgv[i] / 2 + 0.3, jkW / 2 + 0.02
			line_type ltH
		endif
		x = x + sgv[i]
	next i
	for k = 1 to nXc
		for sx = -1 to 1 step 2
			for sy = -1 to 1 step 2
				circle2 xcv[k] + sx * xbO, sy * xbO, 0.011
			next sy
		next sx
	next k
	for k = 1 to nBr
		rect2 brv[k] - 0.075, -hw, brv[k] + 0.075, hw
	next k
	if shKind = 3 then
		hb = hpA / 2 * 0.7071
		line2 hb, -hpS * hb, -hb, hpS * hb
		line2 shL - hb, -hpS * hb, shL + hb, hpS * hb
	endif
endif
line_type ltS
drawindex 50
pen penEquip
if drLv < 3 then text2 shL / 2, hw + 0.1 + dT / 2, shInfo
if drLv = 1 then text2 shL / 2, -hw - 0.1 - dT / 2, shName
hotspot2 0, 0
hotspot2 shL, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 山留め支保工 3D（リース材 30HA・35HA・40HA の主材と端板、継手のカバープレート、補助ピース、キリンジャッキとジャッキカバー、交差部の
! アングルピースと交叉部直ボルト、中間杭の切梁受けブラケットと締付用 U ボルト。寸法は src/ashiba/shiho.py の出典）
define material "sh_main" 2, 0.72, 0.16, 0.12
define material "sh_aux" 2, 0.85, 0.45, 0.15
define material "sh_plate" 2, 0.52, 0.12, 0.10
define material "sh_jack" 2, 0.20, 0.38, 0.72
define material "sh_steel" 2, 0.48, 0.30, 0.22
define material "sh_bolt" 2, 0.78, 0.78, 0.74
resol 12
if shKind = 4 then
	! ---- 中間杭（フランジが +X を向く H形鋼）・段ごとの切梁受けブラケット・締付用 U ボルト ----
	material "sh_steel"
	add 0, 0, -shBot
	prism_ 12, shBot - shZ,
		-sH / 2, -sB / 2, 15,
		-sH / 2 + sT2, -sB / 2, 15,
		-sH / 2 + sT2, -sT1 / 2, 15,
		sH / 2 - sT2, -sT1 / 2, 15,
		sH / 2 - sT2, -sB / 2, 15,
		sH / 2, -sB / 2, 15,
		sH / 2, sB / 2, 15,
		sH / 2 - sT2, sB / 2, 15,
		sH / 2 - sT2, sT1 / 2, 15,
		-sH / 2 + sT2, sT1 / 2, 15,
		-sH / 2 + sT2, sB / 2, 15,
		-sH / 2, sB / 2, 15
	del 1
	dg = sqr(bkL * bkL + bkH * bkH)
	for k = 1 to nPk
		zb = -pkv[k]
		material "sh_steel"
		add sH / 2, -0.0375, zb - 0.009
		block bkL, 0.075, 0.009
		del 1
		add sH / 2, -0.0045, zb - 0.075
		block bkL, 0.009, 0.066
		del 1
		add sH / 2, -0.0375, zb - bkH
		block 0.009, 0.075, bkH
		del 1
		add sH / 2, -0.0045, zb - bkH
		roty -atn(bkH / bkL)
		block dg, 0.009, 0.06
		del 2
		material "sh_bolt"
		for sd = -1 to 1 step 2
			add pkR + sd * ubW / 2, 0, zb - 0.04
			cylind ubH + 0.04, 0.011
			del 1
		next sd
		add pkR - ubW / 2, 0, zb + ubH
		roty 90
		cylind ubW, 0.011
		del 2
	next k
	end
endif
if nSg = 0 then
	material "sh_main"
	add 0, 0, zc
	roty 90
	if shKind = 1 then
		prism_ 12, shL,
			-sH / 2, -sB / 2, 15,
			-sH / 2 + sT2, -sB / 2, 15,
			-sH / 2 + sT2, -sT1 / 2, 15,
			sH / 2 - sT2, -sT1 / 2, 15,
			sH / 2 - sT2, -sB / 2, 15,
			sH / 2, -sB / 2, 15,
			sH / 2, sB / 2, 15,
			sH / 2 - sT2, sB / 2, 15,
			sH / 2 - sT2, sT1 / 2, 15,
			-sH / 2 + sT2, sT1 / 2, 15,
			-sH / 2 + sT2, sB / 2, 15,
			-sH / 2, sB / 2, 15
	else
		prism_ 12, shL,
			-sB / 2, -sH / 2, 15,
			sB / 2, -sH / 2, 15,
			sB / 2, -sH / 2 + sT2, 15,
			sT1 / 2, -sH / 2 + sT2, 15,
			sT1 / 2, sH / 2 - sT2, 15,
			sB / 2, sH / 2 - sT2, 15,
			sB / 2, sH / 2, 15,
			-sB / 2, sH / 2, 15,
			-sB / 2, sH / 2 - sT2, 15,
			-sT1 / 2, sH / 2 - sT2, 15,
			-sT1 / 2, -sH / 2 + sT2, 15,
			-sB / 2, -sH / 2 + sT2, 15
	endif
	del 2
endif
x = 0
for i = 1 to nSg
	L = sgv[i]
	if sgk[i] = 3 then
		! ---- キリンジャッキ（端板 2枚・ねじ・ナット）とジャッキカバー（両側） ----
		material "sh_jack"
		add x, -jkW / 2, zc - jkW / 2
		block 0.028, jkW, jkW
		addx L - 0.028
		block 0.028, jkW, jkW
		del 2
		add x + 0.028, 0, zc
		roty 90
		cylind L - 0.056, 0.07
		del 2
		add x + L / 2 - 0.04, 0, zc
		roty 90
		cylind 0.08, 0.11
		del 2
		material "sh_steel"
		for sd = -1 to 1 step 2
			add x + L / 2 - jcL / 2, sd * (jkW / 2 + 0.026) - 0.006, zc - 0.1
			block jcL, 0.012, 0.2
			del 1
		next sd
	endif
	if sgk[i] < 3 then
		! ---- 主材・補助ピース（H形鋼）と主材の端板 ----
		if sgk[i] = 1 then
			material "sh_main"
		else
			material "sh_aux"
		endif
		add x, 0, zc
		roty 90
		if shKind = 1 then
			prism_ 12, L,
				-sH / 2, -sB / 2, 15,
				-sH / 2 + sT2, -sB / 2, 15,
				-sH / 2 + sT2, -sT1 / 2, 15,
				sH / 2 - sT2, -sT1 / 2, 15,
				sH / 2 - sT2, -sB / 2, 15,
				sH / 2, -sB / 2, 15,
				sH / 2, sB / 2, 15,
				sH / 2 - sT2, sB / 2, 15,
				sH / 2 - sT2, sT1 / 2, 15,
				-sH / 2 + sT2, sT1 / 2, 15,
				-sH / 2 + sT2, sB / 2, 15,
				-sH / 2, sB / 2, 15
		else
			prism_ 12, L,
				-sB / 2, -sH / 2, 15,
				sB / 2, -sH / 2, 15,
				sB / 2, -sH / 2 + sT2, 15,
				sT1 / 2, -sH / 2 + sT2, 15,
				sT1 / 2, sH / 2 - sT2, 15,
				sB / 2, sH / 2 - sT2, 15,
				sB / 2, sH / 2, 15,
				-sB / 2, sH / 2, 15,
				-sB / 2, sH / 2 - sT2, 15,
				-sT1 / 2, sH / 2 - sT2, 15,
				-sT1 / 2, -sH / 2 + sT2, 15,
				-sB / 2, -sH / 2 + sT2, 15
		endif
		del 2
		if sgk[i] = 1 then
			material "sh_plate"
			if shKind = 1 then
				add x, -sB / 2 - 0.005, zc - sH / 2 - 0.005
				block endT, sB + 0.01, sH + 0.01
				addx L - endT
				block endT, sB + 0.01, sH + 0.01
				del 2
			else
				add x, -sH / 2 - 0.005, zc - sB / 2 - 0.005
				block endT, sH + 0.01, sB + 0.01
				addx L - endT
				block endT, sH + 0.01, sB + 0.01
				del 2
			endif
		endif
		! 前の主材・補助ピースとの継手に両フランジのカバープレート
		if i > 1 then
			if sgk[i - 1] < 3 then
				material "sh_plate"
				if shKind = 1 then
					add x - cvL / 2, -sB / 2, zc + sH / 2
					block cvL, sB, cvT
					addz -sH - cvT
					block cvL, sB, cvT
					del 2
				else
					add x - cvL / 2, sH / 2, zc - sB / 2
					block cvL, cvT, sB
					addy -sH - cvT
					block cvL, cvT, sB
					del 2
				endif
			endif
		endif
	endif
	x = x + L
next i
if shKind = 1 then
	! ---- 交差部（上段の切梁）: 上のフランジにアングル2本（切梁に直角）・下段の下のフランジの下にアングル2本・交叉部直ボルト4本 ----
	for k = 1 to nXc
		xq = xcv[k]
		zt = zc + sH / 2
		zb = zc - sH / 2 - xchv[k]
		material "sh_steel"
		for sd = -1 to 1 step 2
			add xq + sd * xbO - 0.0375, -xaL / 2, zt
			block 0.075, xaL, 0.009
			addx 0.033
			block 0.009, xaL, 0.075
			del 2
			add xq - xaL / 2, sd * xbO - 0.0375, zb - 0.009
			block xaL, 0.075, 0.009
			addy 0.033
			addz -0.066
			block xaL, 0.009, 0.075
			del 3
		next sd
		material "sh_bolt"
		for sx = -1 to 1 step 2
			for sy = -1 to 1 step 2
				add xq + sx * xbO, sy * xbO, zb - 0.06
				cylind zt - zb + 0.12, 0.011
				del 1
			next sy
		next sx
	next k
endif
if shKind = 2 then
	! ---- 腹起しのブラケット（下のフランジの下に受けの板と縦のリブ） ----
	material "sh_steel"
	for k = 1 to nBr
		add brv[k] - 0.075, -sH / 2, zc - sB / 2 - 0.016
		block 0.15, sH, 0.016
		del 1
		add brv[k] - 0.006, -sH / 2, zc - sB / 2 - 0.2
		block 0.012, sH * 0.6, 0.184
		del 1
	next k
endif
if shKind = 3 then
	! ---- 火打受ピース（両端。底は腹起し・切梁の面に沿い 45°、当たり面は火打ちに直角。幅 260） ----
	material "sh_steel"
	hb = hpA / 2 * 0.7071
	for sd = 0 to 1
		add sd * shL, 0, zc - 0.13
		if sd = 1 then mul -1, 1, 1
		prism_ 4, 0.26,
			hb, -hpS * hb, 15,
			0.5, -hpS * sH / 2, 15,
			0.5, hpS * sH / 2, 15,
			-hb, hpS * hb, 15
		if sd = 1 then del 1
		del 1
	next sd
endif
end

