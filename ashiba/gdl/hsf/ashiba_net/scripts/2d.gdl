! ============================================================
! 水平ネット 2D（平面）: 範囲の枠と網目（0.5m の格子）。参考図の「落下防止養生ネット張り」の表記
! ============================================================
pen 1
rot2 faceAng
rect2 0, 0, netL, netW
nx = int(netL / 0.5)
for i = 1 to nx
	x1 = i * 0.5
	if x1 - netW >= 0 then
		line2 x1, 0, x1 - netW, netW
	else
		line2 x1, 0, 0, x1
	endif
next i
hotspot2 0, 0
hotspot2 netL, 0
hotspot2 netL, netW
hotspot2 0, netW
del 1
