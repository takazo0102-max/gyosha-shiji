! 単管のつなぎ 2D: 単管（突き出しまで）・両端の直交クランプ・注記
pen penEquip
define style "tbT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "tbT"
line2 -ov, rT, tbL + ov, rT
line2 -ov, -rT, tbL + ov, -rT
for e = 0 to 1
	xe = e * tbL
	rect2 xe - 0.05, -0.07, xe + 0.05, 0.07
	circle2 xe, 0, 0.0243
next e
add2 tbL / 2, 0
rot2 -SYMB_ROTANGLE
text2 0, 0.35, tbName + " " + tbNote
del 2
hotspot2 0, 0
hotspot2 tbL, 0
