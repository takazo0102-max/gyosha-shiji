! 単管のつなぎ 2D（CAD の平面図の描き方: scripts/gdl_draft.py）: 単管（突き出しまで）は太線、両端の直交クランプは細線（詳細だけ）。
! 簡略は単管の芯の1本線。注記の行送りは縮尺に合わせる
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "tbT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "tbT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
pen pO
if drLv < 3 then
	line2 -ov, rT, tbL + ov, rT
	line2 -ov, -rT, tbL + ov, -rT
else
	line2 -ov, 0, tbL + ov, 0
endif
if drLv = 1 then
	pen pT
	for e = 0 to 1
		xe = e * tbL
		rect2 xe - 0.05, -0.07, xe + 0.05, 0.07
		circle2 xe, 0, 0.0243
	next e
endif
pen penEquip
add2 tbL / 2, 0
rot2 -SYMB_ROTANGLE
text2 0, 0.15 + dT / 2, tbName + " " + tbNote
del 2
hotspot2 0, 0
hotspot2 tbL, 0
