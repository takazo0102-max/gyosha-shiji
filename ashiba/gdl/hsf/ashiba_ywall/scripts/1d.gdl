! 山留め壁: 並びを読む（m）
dim pileX[]
nPile = 0
rest = pX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPile = nPile + 1
		pileX[nPile] = v / 1000
	endif
endwhile
