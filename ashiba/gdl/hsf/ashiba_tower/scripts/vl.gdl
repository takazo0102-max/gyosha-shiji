! タワークレーン: 形式の一覧
values{2} "tcType" 1, "起伏ジブ", 2, "水平ジブ"
! 機種を選ぶと、src/ashiba/tower.py の寸法を書き込む（gen_tower_gdl.py が書き出す）
dim mdV[], mdS[]
mdV[1] = 0
mdS[1] = "手入力"
mdV[2] = 1
mdS[2] = "タワークレーン 27.5t"
mdV[3] = 2
mdS[3] = "タワークレーン 25t"
