	if tcModel = 4 then
		parameters tcName = "タワークレーン 14t（中型）", tcNote = "北川鉄工所 JCL280GK（4本掛け）・ジブ 24m"
		parameters rtR = "3000,20000,22000,24000"
		parameters rtT = "1400,1400,1280,1150"
		parameters tcClr = 1, tcType = 1, msW = 1.35, msH = 46.755, msSeg = 7.2, baseW = 4.118, baseD = 1.5, tailR = 5
