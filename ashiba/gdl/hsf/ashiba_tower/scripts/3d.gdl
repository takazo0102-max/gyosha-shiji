! タワークレーン 3D
! 色の組（1 黄・2 赤白。航空障害標識の塗り分け。同じ名前の define material は 1回だけ）
cR = 0.95
cG = 0.75
cB = 0.10
wR = cR
wG = cG
wB = cB
if tcClr = 2 then
	cR = 0.80
	cG = 0.12
	cB = 0.10
	wR = 0.94
	wG = 0.94
	wB = 0.94
endif
define material "tc_body" 2, cR, cG, cB
define material "tc_band" 2, wR, wG, wB
define material "tc_steel" 2, 0.55, 0.56, 0.58
define material "tc_dark" 2, 0.20, 0.20, 0.22
define material "tc_cw" 2, 0.62, 0.63, 0.64
define material "tc_conc" 2, 0.75, 0.74, 0.70
define material "tc_glass" 2, 0.30, 0.45, 0.60
define material "tc_hook" 2, 0.92, 0.40, 0.12
define material "tc_light" 2, 0.95, 0.10, 0.08
resol 8
! 基礎
material "tc_conc"
add -baseW * 0.55, -baseW * 0.55, -baseD
block baseW * 1.1, baseW * 1.1, baseD
del 1
if tcBase then
	! ベース（クロスベースの2本の梁）
	material "tc_steel"
	for s = -1 to 1 step 2
		add 0, 0, 0
		rotz 45 * s
		add -baseW * 0.7, -0.25, 0
		block baseW * 1.4, 0.5, 0.5
		del 3
	next s
	add -msW / 2 - 0.3, -msW / 2 - 0.3, 0.5
	block msW + 0.6, msW + 0.6, 0.15
	del 1
endif
gosub "mast"
gosub "ties"
gosub "climb"
add 0, 0, zR
rotz slew
gosub "slewing"
if tcType = 2 then
	gosub "flatjib"
else
	gosub "luffjib"
endif
if avN > 0 then gosub "lights"
del 2
gosub "hook"
! 吊り点の印（丸十字）と Max（scripts/gdl_mark.py）
if slgOn and (1) then
	define material "mk_red" 2, 0.90, 0.10, 0.10
	define style "mkI" "Arial", 900 * texZ, 4, 0
	mkX = hX * cos(slew)
	mkY = hX * sin(slew)
	mkH = hZ
	mkQ = mkH - slgH
	mkR = texZ
	mkV = capT
	material "mk_red"
	lin_ mkX, mkY, mkH, mkX, mkY, mkQ
	aV = 0
	dxV = GLOB_EYEPOS_X - SYMB_POS_X
	dyV = GLOB_EYEPOS_Y - SYMB_POS_Y
	if abs(dxV) > 0.01 then aV = atn(dyV / dxV) + 180 * (dxV < 0)
	aV = aV - SYMB_ROTANGLE + 90
	add mkX, mkY, mkQ
	! 丸十字は水平に寝かせる（利用者の指定 2026-11-07）。文字だけ視点へ向ける
	for k = 0 to 24
		put mkR * cos(15 * k), mkR * sin(15 * k), 15 - 16 * (k = 24)
	next k
	for k = 0 to 24
		put mkR * 0.82 * cos(15 * k), mkR * 0.82 * sin(15 * k), 15 - 16 * (k = 24)
	next k
	prism_ nsp / 3, 0.03, get(nsp)
	add -mkR, -mkR * 0.05, 0
	block mkR * 2, mkR * 0.1, 0.03
	del 1
	add -mkR * 0.05, -mkR, 0
	block mkR * 0.1, mkR * 2, 0.03
	del 1
	rotz aV
	rotx 90
	style "mkI"
	add mkR * 1.3, 0, 0
	if mkV > 0 then
		text 0.02, 0, "Max " + str(mkV, 4 + (mkV >= 10) + (mkV >= 100), 2) + "t"
	else
		text 0.02, 0, "Max -"
	endif
	del 4
	hotspot 0, mkY, mkQ, 960, hfX, 1 + 128
	hotspot mkX, mkY, mkQ, 961, hfX, 2
	hotspot -1, mkY, mkQ, 962, hfX, 3
	hotspot mkX, 0, mkQ, 963, hfY, 1 + 128
	hotspot mkX, mkY, mkQ, 964, hfY, 2
	hotspot mkX, -1, mkQ, 965, hfY, 3
	hotspot mkX, mkY, 0, 966, mkZ, 1 + 128
	hotspot mkX, mkY, mkQ, 967, mkZ, 2
	hotspot mkX, mkY, -1, 968, mkZ, 3
endif
end

"seg3":
	! (x0q, y0q, z0q) から (x1q, y1q, z1q) の円柱（半径 rq）
	dxq = x1q - x0q
	dyq = y1q - y0q
	dzq = z1q - z0q
	hq = sqr(dxq ^ 2 + dyq ^ 2)
	lq = sqr(hq ^ 2 + dzq ^ 2)
	if lq > 0.001 then
		az = 0
		if hq > 0.0001 then
			if abs(dxq) < 0.0001 then
				az = 90
				if dyq < 0 then az = -90
			else
				az = atn(dyq / dxq)
				if dxq < 0 then az = az + 180
			endif
		endif
		el = 90
		if dzq < 0 then el = -90
		if hq > 0.0001 then el = atn(dzq / hq)
		add x0q, y0q, z0q
		rotz az
		roty 90 - el
		cylind lq, rq
		del 3
	endif
	return

"mast":
	! マスト: 箱の主材 4 本・節ごとの X の斜材と水平材・継ぎの板・はしごと休憩台
	wC = msW * 0.13
	material "tc_body"
	for sx = -1 to 1 step 2
		for sy = -1 to 1 step 2
			add sx * msW / 2 - wC / 2, sy * msW / 2 - wC / 2, 0
			block wC, wC, msH
			del 1
		next sy
	next sx
	rq = msW * 0.028
	for k = 0 to nSg - 1
		za = k * sgL
		zb = min(msH, za + sgL)
		for f = 1 to 4
			ca = cos(f * 90)
			sa = sin(f * 90)
			cb = cos(f * 90 + 90)
			sb = sin(f * 90 + 90)
			x0q = msW / 2 * (ca - sa)
			y0q = msW / 2 * (sa + ca)
			x1q = msW / 2 * (cb - sb)
			y1q = msW / 2 * (sb + cb)
			z0q = za
			z1q = za
			gosub "seg3"
			z1q = zb
			gosub "seg3"
			xq = x0q
			yq = y0q
			x0q = x1q
			y0q = y1q
			x1q = xq
			y1q = yq
			z0q = za
			gosub "seg3"
			x1q = (x0q + xq) / 2
			y1q = (y0q + yq) / 2
		next f
		! 継ぎの板
		material "tc_dark"
		for sx = -1 to 1 step 2
			for sy = -1 to 1 step 2
				add sx * msW / 2 - wC * 0.7, sy * msW / 2 - wC * 0.7, za - 0.06
				block wC * 1.4, wC * 1.4, 0.12
				del 1
			next sy
		next sx
		! 休憩台
		material "tc_steel"
		add -msW * 0.42, -msW * 0.42, za + 0.04
		block msW * 0.84, msW * 0.84, 0.04
		del 1
		material "tc_body"
	next k
	! はしご（マストの中）
	material "tc_steel"
	rq = 0.02
	for s = -1 to 1 step 2
		add msW * 0.3, s * 0.2, 0
		cylind msH, 0.02
		del 1
	next s
	for k = 0 to int(msH / 0.9)
		add msW * 0.3 - 0.015, -0.2, k * 0.9
		block 0.03, 0.4, 0.03
		del 1
	next k
	return

"climb":
	! クライミング枠（マストを抱く四角の枠。上の 2 段。機種の外形は調査のメモ）
	if clOn then
		for k = 1 to 2
			zK = msH - k * 3.4
			if zK > 1 then
				material "tc_dark"
				hK = msW / 2 + 0.3
				for s = -1 to 1 step 2
					add -hK - 0.5, s * hK - 0.2, zK
					block 2 * hK + 1.0, 0.4, 0.6
					del 1
					add s * hK - 0.2, -hK - 0.5, zK
					block 0.4, 2 * hK + 1.0, 0.6
					del 1
				next s
				! 昇降のシリンダ
				material "tc_steel"
				for s = -1 to 1 step 2
					add s * (msW / 2 + 0.16), 0, zK + 0.6
					cylind 1.6, 0.09
					del 1
				next s
			endif
		next k
	endif
	return

"ties":
	! 壁つなぎ: 高さごとにマストを囲むカラーと、建物の側（tieA）へ2本の控え
	if nTz > 0 then
		for i = 1 to nTz
			material "tc_dark"
			add -msW / 2 - 0.15, -msW / 2 - 0.15, tz[i] - 0.15
			block msW + 0.3, msW + 0.3, 0.3
			del 1
			material "tc_steel"
			rq = 0.08
			for s = -1 to 1 step 2
				x0q = (msW / 2 + 0.15) * cos(tieA) - s * msW / 2 * sin(tieA)
				y0q = (msW / 2 + 0.15) * sin(tieA) + s * msW / 2 * cos(tieA)
				x1q = (msW / 2 + tieL) * cos(tieA) - s * (msW / 2 + 0.3) * sin(tieA)
				y1q = (msW / 2 + tieL) * sin(tieA) + s * (msW / 2 + 0.3) * cos(tieA)
				z0q = tz[i]
				z1q = tz[i]
				gosub "seg3"
			next s
		next i
	endif
	return

"slewing":
	! 旋回体: ポスト・旋回輪・機械台の梁・通路と手すり・機械室のドラム・カウンタウエイト・運転室
	material "tc_dark"
	cylind 0.25, msW * 0.68
	add 0, 0, 0.25
	cylind 0.35, msW * 0.6
	del 1
	xD0 = -tailR + cwL
	lD = tailR - cwL + upF
	material "tc_body"
	for s = -1 to 1 step 2
		add xD0, dkY + s * (dkW / 2 - 0.2) - 0.2, 0.6
		block lD, 0.4, 0.5
		del 1
	next s
	for k = 0 to 4
		add xD0 + k * (lD - 0.3) / 4, dkY - dkW / 2 + 0.2, 0.68
		block 0.3, dkW - 0.4, 0.34
		del 1
	next k
	! 通路の板と手すり
	material "tc_steel"
	add xD0, dkY - dkW / 2, 1.1
	block lD, dkW, 0.03
	del 1
	rq = 0.02
	for s = -1 to 1 step 2
		yH = dkY + s * dkW / 2
		for k = 0 to 4
			x0q = xD0 + k * lD / 4
			y0q = yH
			z0q = 1.13
			x1q = x0q
			y1q = yH
			z1q = 2.2
			gosub "seg3"
		next k
		for k = 0 to 1
			x0q = xD0
			x1q = xD0 + lD
			y0q = yH
			y1q = yH
			z0q = 1.65 + k * 0.55
			z1q = z0q
			gosub "seg3"
		next k
	next s
	! 機械室（箱）と巻上・起伏のドラム
	material "tc_band"
	add xD0 + 0.2, dkY - dkW * 0.3, 1.13
	block min(2.4, lD * 0.35), dkW * 0.6, 1.5
	del 1
	for k = 0 to 1
		xW = xD0 + min(2.4, lD * 0.35) + 0.7 + k * 1.1
		material "tc_dark"
		add xW, dkY - dkW * 0.28, 1.65
		rotx -90
		cylind dkW * 0.56, 0.42
		del 2
		material "tc_steel"
		for s = -1 to 1 step 2
			add xW, dkY + s * dkW * 0.3 - 0.03, 1.65
			rotx -90
			cylind 0.06, 0.55
			del 2
		next s
	next k
	! カウンタウエイト（塊を並べる）
	material "tc_cw"
	nCw = max(2, int(cwW / 0.8))
	for k = 0 to nCw - 1
		add -tailR, dkY - cwW / 2 + k * cwW / nCw + 0.01, 0.6
		block cwL, cwW / nCw - 0.02, cwH
		del 1
	next k
	! 運転室（旋回体の前の右。前面が斜めに傾く。前後 cbL・幅 cbW・上面 cbZ・高さ cbH）
	yR = dkY - dkW / 2
	zC = cbZ - cbH
	material "tc_band"
	add 0, yR + cbW, 0
	rotx 90
	prism 5, cbW, upF - cbL, zC, upF - 0.35, zC, upF, zC + cbH * 0.45, upF - 0.2, cbZ, upF - cbL, cbZ
	del 2
	material "tc_glass"
	add 0, yR + cbW - 0.06, 0
	rotx 90
	prism 4, cbW - 0.12, upF - 0.33, zC + 0.03, upF + 0.01, zC + cbH * 0.45, upF - 0.19, cbZ - 0.06, upF - 0.22, cbZ - 0.08
	del 2
	add 0, yR + 0.004, 0
	rotx 90
	prism 4, 0.008, upF - cbL + 0.12, zC + cbH * 0.35, upF - 0.22, zC + cbH * 0.35, upF - 0.26, cbZ - 0.12, upF - cbL + 0.12, cbZ - 0.12
	del 2
	return

"luffjib":
	! 起伏ジブ: Aフレーム（2 本の柱・後ろの控え・はしご・頂部のシーブ）・ラチスジブ（根元を絞る）・ペンダントと継ぎ金具
	material "tc_body"
	for s = -1 to 1 step 2
		rq = 0.14
		x0q = pvX - 0.6
		y0q = s * dkW * 0.4
		z0q = 1.1
		x1q = -frX
		y1q = s * 0.4
		z1q = frH
		gosub "seg3"
		rq = 0.09
		x0q = -tailR + cwL + 0.3
		gosub "seg3"
	next s
	! はしご
	material "tc_steel"
	nL = int((frH - 1.2) / 0.5)
	for k = 1 to nL
		tL = k / (nL + 1)
		add pvX - 0.6 + (-frX - pvX + 0.6) * tL, -0.3, 1.1 + (frH - 1.1) * tL
		block 0.03, 0.6, 0.03
		del 1
	next k
	add -frX, -0.3, frH
	rotx -90
	cylind 0.6, 0.35
	del 2
	add pvX, 0, pvH
	roty -jbA
	resol 6
	lRt = min(jbL * 0.35, 8.9)
	rcj = jbW * 0.045
	! 主弦材（根元は 2 本の耳へ絞る）
	material "tc_body"
	for sy = -1 to 1 step 2
		for sz = -1 to 1 step 2
			x0q = 0
			y0q = sy * jbW * 0.32
			z0q = sz * jbW * 0.12
			x1q = lRt
			y1q = sy * jbW / 2
			z1q = sz * jbW / 2
			rq = rcj
			gosub "seg3"
			x0q = lRt
			y0q = y1q
			z0q = z1q
			x1q = jbL
			gosub "seg3"
		next sz
	next sy
	nP = max(4, int(jbL / (jbW * 0.95)))
	pP = jbL / nP
	rq = rcj * 0.55
	for i = 0 to nP - 1
		sg = 1 - 2 * (i mod 2)
		! 3 節ごとの塗り分け
		if int(i / 3) mod 2 = 0 then
			material "tc_body"
		else
			material "tc_band"
		endif
		hA = jbW / 2
		zA = jbW / 2
		xq = i * pP
		if xq < lRt then
			hA = jbW * (0.32 + 0.18 * xq / lRt)
			zA = jbW * (0.12 + 0.38 * xq / lRt)
		endif
		hBq = jbW / 2
		zBq = jbW / 2
		xq = (i + 1) * pP
		if xq < lRt then
			hBq = jbW * (0.32 + 0.18 * xq / lRt)
			zBq = jbW * (0.12 + 0.38 * xq / lRt)
		endif
		x0q = i * pP
		x1q = x0q + pP
		y0q = -sg * hA
		y1q = sg * hBq
		z0q = zA
		z1q = zBq
		gosub "seg3"
		z0q = -zA
		z1q = -zBq
		gosub "seg3"
		y0q = hA
		y1q = hBq
		z0q = -sg * zA
		z1q = sg * zBq
		gosub "seg3"
		y0q = -hA
		y1q = -hBq
		gosub "seg3"
	next i
	resol 8
	! ジブの先（側板とシーブ）
	material "tc_steel"
	for s = -1 to 1 step 2
		add jbL - 0.3, s * jbW * 0.4 - 0.03, -jbW / 2
		block 1.0, 0.06, jbW
		del 1
	next s
	add jbL + 0.4, -0.2, 0
	rotx -90
	cylind 0.4, 0.45
	del 2
	del 2
	! ペンダント 2 本と継ぎ金具
	material "tc_steel"
	xM = -frX + (jX + frX) * 0.45
	zM = frH + (jZ - zR - frH) * 0.45
	add xM - 0.3, -0.45, zM - 0.1
	block 0.6, 0.9, 0.2
	del 1
	for s = -1 to 1 step 2
		rq = 0.025
		x0q = -frX
		y0q = s * 0.2
		z0q = frH
		x1q = xM
		y1q = s * 0.4
		z1q = zM
		gosub "seg3"
		x0q = xM
		y0q = s * 0.4
		z0q = zM
		x1q = jX
		y1q = s * jbW / 4
		z1q = jZ - zR
		gosub "seg3"
	next s
	return

"flatjib":
	! 水平ジブ: 塔頭・三角断面のジブ（下弦2本・上弦1本と斜材）・カウンタジブ・タイバー・トロリ
	jbHt = jbW * 0.9
	material "tc_body"
	for s = -1 to 1 step 2
		rq = 0.1
		x0q = s * msW / 2
		y0q = -msW / 2
		z0q = 0.6
		x1q = 0
		y1q = 0
		z1q = frH
		gosub "seg3"
		y0q = msW / 2
		gosub "seg3"
	next s
	resol 6
	rcj = 0.035 + 0.02 * jbW
	rq = rcj
	for s = -1 to 1 step 2
		x0q = pvX
		y0q = s * jbW / 2
		z0q = pvH
		x1q = jX
		y1q = y0q
		z1q = pvH
		gosub "seg3"
		x0q = -tailR + cwL
		x1q = 0
		gosub "seg3"
	next s
	x0q = pvX
	y0q = 0
	z0q = pvH + jbHt
	x1q = jX
	y1q = 0
	z1q = pvH + jbHt
	gosub "seg3"
	nP = max(2, int(jbL / jbW))
	pP = jbL / nP
	rq = rcj * 0.5
	for i = 0 to nP - 1
		for s = -1 to 1 step 2
			x0q = pvX + i * pP
			y0q = s * jbW / 2
			z0q = pvH
			x1q = x0q + pP / 2
			y1q = 0
			z1q = pvH + jbHt
			gosub "seg3"
			x0q = x1q + pP / 2
			gosub "seg3"
		next s
	next i
	resol 8
	material "tc_steel"
	for s = -1 to 1 step 2
		rq = 0.03
		x0q = 0
		y0q = 0
		z0q = frH
		x1q = pvX + jbL * 0.6
		y1q = 0
		z1q = pvH + jbHt
		gosub "seg3"
		x1q = -tailR + cwL + 0.5
		y1q = s * jbW / 2
		z1q = pvH
		gosub "seg3"
	next s
	material "tc_dark"
	add hX - 0.6, -jbW / 2 - 0.1, pvH - 0.5
	block 1.2, jbW + 0.2, 0.4
	del 1
	return

"lights":
	! 航空障害灯（60m 以上。塔頂＝Aフレーム頂部とジブ先端、ジブが長ければ途中にも）
	material "tc_light"
	add -frX, 0, frH + 0.3
	sphere 0.25
	del 1
	add jX, 0, jZ - zR + 0.4
	sphere 0.25
	del 1
	nMid = avN - 1
	for i = 1 to nMid
		fq = i / (nMid + 1)
		add pvX + (jX - pvX) * fq, 0, pvH + (jZ - zR - pvH) * fq + jbW / 2 + 0.25
		sphere 0.2
		del 1
	next i
	return

"hook":
	! ワイヤ（2本）とフック（旋回の向きに作業半径 hX）
	cS = cos(slew)
	sS = sin(slew)
	zT = jZ
	if tcType = 2 then zT = zR + pvH - 0.5
	material "tc_steel"
	for s = -1 to 1 step 2
		add hX * cS - s * 0.12 * sS, hX * sS + s * 0.12 * cS, hZ + 0.8
		cylind max(0.1, zT - hZ - 0.8), 0.015
		del 1
	next s
	add hX * cS, hX * sS, hZ
	rotz slew
	material "tc_hook"
	for s = -1 to 1 step 2
		add 0, s * 0.2 - 0.02, 0.5
		rotx -90
		cylind 0.04, 0.36
		del 2
	next s
	material "tc_steel"
	add 0, -0.18, 0.5
