! タワークレーン: マストの本数・ジブの先・フックの位置・壁つなぎの高さ（m・度）
nSg = max(1, int(msH / max(0.5, msSeg) + 0.5))
sgL = msH / nSg
zR = msH
! ジブの先（起伏ジブは起こした先、水平ジブはジブの先）と今の作業半径（フックの位置）
if tcType = 2 then
	jX = pvX + jbL
	jZ = zR + pvH
	hX = max(pvX + 2, min(jX - 0.5, trR))
else
	jX = pvX + jbL * cos(jbA)
	jZ = zR + pvH + jbL * sin(jbA)
	hX = jX
endif
hZ = max(0.5, jZ - hkD)
if hkLim and hkMax > 0.1 then hZ = min(hZ, hkMax)
dim qR[]
nQr = 0
rest = rtR
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nQr = nQr + 1
		qR[nQr] = v / 1000
	endif
endwhile
dim qT[]
nQt = 0
rest = rtT
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nQt = nQt + 1
		qT[nQt] = v / 1
	endif
endwhile
capT = 0
for i = nQr to 1 step -1
	if qR[i] >= hX - 0.001 and i <= nQt then capT = qT[i] / 100
next i
! 作業半径の表示（scripts/gdl_radii.py）
nWi = max(0, min(5, wiNum)) * (1)
dim wiRq[5], wiAq[5], wiBq[5], wiSq[5], wiMq[5], wiFq[5], wiTq[5]
wiRq[1] = wiR1
wiAq[1] = wiA1
wiBq[1] = wiB1
wiFq[1] = wiF1
wiRq[2] = wiR2
wiAq[2] = wiA2
wiBq[2] = wiB2
wiFq[2] = wiF2
wiRq[3] = wiR3
wiAq[3] = wiA3
wiBq[3] = wiB3
wiFq[3] = wiF3
wiRq[4] = wiR4
wiAq[4] = wiA4
wiBq[4] = wiB4
wiFq[4] = wiF4
wiRq[5] = wiR5
wiAq[5] = wiA5
wiBq[5] = wiB5
wiFq[5] = wiF5
for wq = 1 to 5
	wS0 = wiBq[wq] - wiAq[wq] + 720
	wS0 = wS0 - int(wS0 / 360) * 360
	if wS0 < 0.01 then wS0 = 360
	wiSq[wq] = wS0
	wiMq[wq] = wiAq[wq] + wS0 / 2
next wq
for wq = 1 to nWi
	vq = 0
	for k = nQr to 1 step -1
		if qR[k] >= wiRq[wq] - 0.001 and k <= nQt then vq = qT[k] / 100
	next k
	wiTq[wq] = vq
next wq
! 壁つなぎの高さ（mm の文字 → m）
dim tz[]
nTz = 0
rest = tieZ
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTz = nTz + 1
		tz[nTz] = v / 1000
	endif
endwhile
