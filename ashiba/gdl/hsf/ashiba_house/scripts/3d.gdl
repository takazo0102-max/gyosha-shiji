! 仮設建物 3D: ユニット・出入口・窓・2階の外廊下と手すり・外階段
define material "hs_body" 2, 0.88, 0.89, 0.87
define material "hs_toil" 2, 0.80, 0.88, 0.95
define material "hs_base" 2, 0.30, 0.30, 0.32
define material "hs_glass" 2, 0.35, 0.50, 0.65
define material "hs_door" 2, 0.55, 0.57, 0.60
define material "hs_rail" 2, 0.90, 0.75, 0.10
resol 8
for t = 1 to nT
	for u = 1 to nU
		x0 = 0
		y0 = (u - 1) * ud
		if isT then
			x0 = (u - 1) * uw
			y0 = 0
		endif
		z0 = (t - 1) * uh
		material "hs_base"
		add x0 + 0.005, y0 + 0.005, z0
		block uw - 0.01, ud - 0.01, 0.12
		del 1
		material "hs_body"
		if isT then material "hs_toil"
		add x0 + 0.005, y0 + 0.005, z0 + 0.12
		block uw - 0.01, ud - 0.01, uh - 0.12
		del 1
		if isT or (u = 1 and upOn = 0) then
			material "hs_door"
			dw = min(0.8, uw - 0.1)
			dx = x0 + 0.05
			if isT then dx = x0 + (uw - dw) / 2
			add dx, -0.01, z0 + 0.15
			block dw, 0.02, min(1.9, uh - 0.4)
			del 1
		endif
		if upOn and isT = 0 then
			material "hs_door"
			add -0.01, y0 + 0.15, z0 + 0.15
			block 0.02, 0.8, min(1.9, uh - 0.4)
			del 1
		endif
		if isT = 0 and u = 1 and uw > 2.5 then
			material "hs_glass"
			nW = max(1, int((uw - 1.0) / 1.8))
			for i = 1 to nW
				wx = 1.0 + (uw - 1.0) * (i - 0.5) / nW - 0.6
				add wx, -0.01, z0 + 0.9
				block 1.2, 0.02, 1.0
				del 1
			next i
		endif
	next u
next t
if upOn and isT = 0 then
	! 廊下の座標（x＝妻側に沿って・y＝外へ負）を部品の X0 の面へ回す
	rotz 90
	muly -1
	for t = 2 to nT
		zf = (t - 1) * uh
		for u = 1 to nU
			yU = (u - 1) * ud
			! 階段踊場部ユニット SC: 床・外側の鉄骨柱2本・手摺（手すり 1.1・中桟 0.55）
			material "hs_base"
			add yU + 0.005, -corrW, zf - 0.12
			block ud - 0.01, corrW, 0.12
			del 1
			for e = 0 to 1
				add yU + 0.05 + e * (ud - 0.15), -corrW + 0.01, 0
				block 0.1, 0.1, zf - 0.12
				del 1
			next e
			material "hs_rail"
			for e = 0 to 1
				add yU + 0.1 + e * (ud - 0.2), -corrW + 0.06, zf
				cylind 1.1, 0.0243
				del 1
			next e
			for r = 1 to 2
				hz = 1.1
				if r = 2 then hz = 0.55
				add yU + 0.05, -corrW + 0.06, zf + hz
				roty 90
				cylind ud - 0.1, 0.0243
				del 2
			next r
			material "hs_base"
		next u
		! 廊下の階段の無い側の端の手摺
		ex = cL
		if stairSd = 1 then ex = 0
		material "hs_rail"
		for r = 1 to 2
			hz = 1.1
			if r = 2 then hz = 0.55
			add ex, -corrW + 0.06, zf + hz
			rotx -90
			cylind corrW - 0.06, 0.0243
			del 2
		next r
	next t
	! 2階への外階段（段板と手摺）
	material "hs_base"
	for i = 1 to nRs - 1
		sx = stX + (i - 1) * gStp
		if stairSd = 1 then sx = stX + stL - i * gStp
		add sx, -stairW, i * rsH - 0.04
		block gStp, stairW, 0.04
		del 1
	next i
	material "hs_rail"
	ang = atn(uh / max(0.3, stL))
	sl = sqr(stL * stL + uh * uh)
	for s = 0 to 1
		ys = -stairW + 0.03
		if s = 1 then ys = -0.03
		if stairSd = 0 then
			add stX, ys, 1.1
			roty 90 - ang
		else
			add stX + stL, ys, 1.1
			roty -90 + ang
		endif
		cylind sl, 0.0243
		del 2
	next s
	del 2
endif
