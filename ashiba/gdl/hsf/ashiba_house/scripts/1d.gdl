usN[8] = "シャワー"
kT = max(1, min(12, hsType))
uw = hwT[kT]
ud = hdT[kT]
uh = hhT[kT]
isT = hkT[kT] > 0
nU = max(1, nUnit)
nT = max(1, min(3, nTier))
if isT then nT = 1
lx = uw
ly = ud * nU
if isT then
	lx = uw * nU
	ly = ud
endif
dim tu[3]
tu[1] = max(1, min(8, use1))
tu[2] = max(1, min(8, use2))
tu[3] = max(1, min(8, use3))
! 2階より上: 手前の外廊下と2階への外階段（製品の長さ stairL を段に分ける。蹴上 0.2 以下）
upOn = nT >= 2
nRs = ceil(uh / 0.2 - 0.0001)
rsH = uh / nRs
stL = max(1, stairL)
gStp = stL / max(1, nRs - 1)
! 外廊下は妻側（X0 の面。ユニットの短い辺が並ぶ）に、ユニットごとの階段踊場部ユニット SC（出 corrW・幅 ud）。階段はその端の先へ
cL = ly
stX = -stL
if stairSd = 1 then stX = cL
