! 仮設建物 2D: ユニットの外形・出入口・窓・2階の外廊下と外階段・名前と段ごとの用途
pen penEquip
define style "hsT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "hsT"
for u = 1 to nU
	x0 = 0
	y0 = (u - 1) * ud
	if isT then
		x0 = (u - 1) * uw
		y0 = 0
	endif
	rect2 x0, y0, x0 + uw, y0 + ud
	! 出入口（手前の面。トイレは各ユニット、ハウスは手前の1つ）
	if isT or u = 1 then
		dw = min(0.8, uw - 0.1)
		dx = x0 + 0.05
		if isT then dx = x0 + (uw - dw) / 2
		line2 dx, y0, dx, y0 - dw
		arc2 dx, y0, dw, 270, 360
	endif
	! 窓（手前の面、ハウスだけ）
	if isT = 0 and u = 1 and uw > 2.5 then
		nW = max(1, int((uw - 1.0) / 1.8))
		for i = 1 to nW
			wx = 1.0 + (uw - 1.0) * (i - 0.5) / nW - 0.6
			line2 wx, -0.03, wx + 1.2, -0.03
			line2 wx, 0.03, wx + 1.2, 0.03
		next i
	endif
next u
! 2階の外廊下と外階段（上る向きの矢）
if upOn and isT = 0 then
	rect2 0, -corrW, lx, 0
	rect2 stX, -stairW, stX + stL, 0
	for i = 1 to nRs - 2
		line2 stX + i * 0.24, -stairW, stX + i * 0.24, 0
	next i
	ax = stX + 0.2
	bx = stX + stL - 0.2
	if stairSd = 1 then
		ax = stX + stL - 0.2
		bx = stX + 0.2
	endif
	line2 ax, -stairW / 2, bx, -stairW / 2
	line2 bx, -stairW / 2, bx - 0.25 * sgn(bx - ax), -stairW / 2 + 0.15
	line2 bx, -stairW / 2, bx - 0.25 * sgn(bx - ax), -stairW / 2 - 0.15
endif
! 名前と段ごとの用途（図面の向きに関係なく水平）
add2 lx / 2, ly / 2
rot2 -SYMB_ROTANGLE
tx = usN[tu[1]]
if nT >= 2 then tx = "1F " + usN[tu[1]] + " / 2F " + usN[tu[2]]
if nT >= 3 then tx = tx + " / 3F " + usN[tu[3]]
text2 0, 0.25, hsName
text2 0, -0.25, tx
del 2
hotspot2 0, 0
hotspot2 lx, 0
hotspot2 lx, ly
hotspot2 0, ly
