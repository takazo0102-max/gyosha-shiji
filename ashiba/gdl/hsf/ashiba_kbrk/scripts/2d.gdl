! ============================================================
! 拡幅・張出ブラケット 2D（平面）: 腕（φ42.7 の二重線）・先端の管・方杖（破線）・品番
! 原点＝ブラケットを付ける支柱の芯、+X＝腕の先（3D と同じ）
! ============================================================
define style "kbTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
pE = penEquip
if pE < 1 then pE = 1
pen pE
rot2 faceAng
! 文字は北・西を向く面でも読める向きに（置いた角度＋面の向きを 0〜360 に直して、左へ傾けば返す。逆さに出ていた。
! 2026-10-26 のループ）
aTx = SYMB_ROTANGLE + faceAng
aTx = aTx - 360 * int(aTx / 360)
if aTx < 0 then aTx = aTx + 360
flipTx = (aTx > 90.001 and aTx < 270.001)
rP = postR
rA = 0.0427 / 2
xT = brW - rA
! 出隅の角の支柱（拡幅・縮幅）: 角の支柱と単管
if cnrMode > 0 then
	if cnrMode = 1 then
		circle2 0, 0, rP
		line2 0, 0.024, cnrL, 0.024
		line2 0, -0.024, cnrL, -0.024
		if showName then
			style "kbTx"
			add2 0, -0.15
			if flipTx then rot2 180
			text2 0, 0, "拡幅の角の支柱（地上から）"
			del 1 + flipTx
		endif
	else
		line2 0, 0.024, cnrL, 0.024
		line2 0, -0.024, cnrL, -0.024
		circle2 cnrAt, 0, rP
		if showName then
			style "kbTx"
			add2 cnrAt, -0.15
			if flipTx then rot2 180
			text2 0, 0, "縮幅の角の受け単管"
			del 1 + flipTx
		endif
	endif
	hotspot2 0, 0
	end
endif
line2 rP, -rA, xT - rA, -rA
line2 rP, rA, xT - rA, rA
circle2 xT, 0, rA
circle2 xT, 0, 0.0364 / 2
rect2 rP, -0.020, rP + 0.050, 0.020
if reinf > 0.1 then
	line2 rP + 0.03, -0.06, xT, -0.06
endif
hotspot2 0, 0
hotspot2 xT, 0
if showName then
	style "kbTx"
	add2 brW / 2, 0.08
	if flipTx then rot2 180
	text2 0, 0, brName
	del 1 + flipTx
endif
