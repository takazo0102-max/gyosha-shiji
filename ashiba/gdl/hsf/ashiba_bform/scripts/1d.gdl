! 梁の型枠: 位置を読む（m）
dim sx[]
nS = 0
rest = sgX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS = nS + 1
		sx[nS] = v / 1000
	endif
endwhile
