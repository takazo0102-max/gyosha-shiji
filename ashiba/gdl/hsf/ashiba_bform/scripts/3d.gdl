! ============================================================
! 梁の型枠 3D（利用者の指定 2026-10-31: さんぎ そとばた フォームタイ）
! 原点＝梁の芯の始めの下端（底板の上面）
! ============================================================
resol 12
define material "bf_ply" 2, 0.86, 0.66, 0.38
define material "bf_wood" 2, 0.74, 0.56, 0.36
define material "bf_steel" 2, 0.62, 0.62, 0.66
define material "bf_tie" 2, 0.35, 0.35, 0.38
define material "bf_pcon" 2, 0.85, 0.85, 0.80
gap = 0.006
L = x1 - x0
! ---- 底板と下の桟木 ----
material "bf_ply"
add x0, -hw, zb
block L, wB, plyT
del 1
material "bf_wood"
for i = 1 to nB
	add x0, by[i] - sgB / 2, zb - sgH
	block L, sgB, sgH
	del 1
next i
! ---- 受けの単管（梁に直角） ----
material "bf_steel"
for i = 1 to nU
	add ux[i], -yT - r - ukeOut, zb - sgH - r
	rotx -90
	cylind 2 * (yT + r + ukeOut), r
	del 2
next i
! ---- 側板・桟木・外端太 ----
for sd = -1 to 1 step 2
	if sd > 0 then
		hS = sideH2
	else
		hS = sideH
	endif
	material "bf_ply"
	if sd > 0 then
		add x0, hw, zb
	else
		add x0, -hw - plyT, zb
	endif
	block L, plyT, hS
	del 1
	material "bf_wood"
	for i = 1 to nS
		if sd > 0 then
			add sx[i] - sgB / 2, hw + plyT, zb
		else
			add sx[i] - sgB / 2, -yS, zb
		endif
		block sgB, sgH, hS
		del 1
	next i
	material "bf_steel"
	for j = 1 to nT
		if tz[j] < hS - 0.03 then
		for k = -1 to 1 step 2
			add tb0, sd * yT, zb + tz[j] + k * (r + gap)
			roty 90
			cylind tb1 - tb0, r
			del 2
		next k
		endif
	next j
next sd
! ---- フォームタイ（両側の側板がある段だけ） ----
for j = 1 to min(nT, nTie)
	for i = 1 to nX
		add tx[i], 0, zb + tz[j]
		material "bf_tie"
		add 0, -yT - r - 0.05, 0
		rotx -90
		cylind 2 * (yT + r + 0.05), 0.00395
		del 2
		for sd = -1 to 1 step 2
			add -0.035, sd * (yT + r) + (sd - 1) / 2 * 0.006, -(2 * r + gap)
			block 0.07, 0.006, 2 * (2 * r + gap)
			del 1
		next sd
		material "bf_pcon"
		add 0, -hw, 0
		rotx -90
		cone 0.025, 0.012, 0.0175, 90, 90
		del 2
		add 0, hw, 0
		rotx 90
		cone 0.025, 0.012, 0.0175, 90, 90
		del 2
		del 1
	next i
next j
! ---- 止め型枠 ----
material "bf_ply"
if endS then
	add x0 - plyT, -hw - plyT, zb
	block plyT, wB + 2 * plyT, max(sideH, sideH2)
	del 1
endif
if endE then
	add x1, -hw - plyT, zb
	block plyT, wB + 2 * plyT, max(sideH, sideH2)
	del 1
endif
