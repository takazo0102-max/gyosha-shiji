! 鉄骨のピース: ブラケットの並び（m・度）
dim qA[]
nB = 0
rest = brA
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nB = nB + 1
		qA[nB] = v / 1
	endif
endwhile
