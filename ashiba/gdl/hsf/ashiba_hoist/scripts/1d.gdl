if tieE < 1 then tieE = 3.6
! 乗り込む作業床の高さ（m）
dim landH[40]
nLand = 0
rest = landList
while strlen(rest) > 0 and nLand < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nLand = nLand + 1
		landH[nLand] = v
	endif
endwhile
! マスト控えを取る足場の建地（中心から m）
dim tieX[8]
nTX = 0
rest = tieList
while strlen(rest) > 0 and nTX < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTX = nTX + 1
		tieX[nTX] = v
	endif
endwhile
! マストの位置と太さ（ロングスパンは荷台の両端のラック付きポスト 150 角、工事用エレベーターは荷台の外側の格子マスト
! 450 角、荷揚げ機は荷台の外側のガイドレール 120 角）
yC0 = -gapOut
yC1 = -gapOut - cageD
mastW = 0.15
if cageH > 0 then mastW = 0.20
if hoKind = 2 and nMast = 1 then mastW = 0.45
! ロングスパンの1本構（三成研機 DECK・WO-7）: はしご形のガイドレールが足場と荷台の間に立ち、荷台はその外へ出る
if hoKind = 1 and nMast = 1 then
	mastW = 0.30
	yC0 = -gapOut - 0.25
	yC1 = yC0 - cageD
endif
if hoKind = 3 then mastW = 0.12
dim mx[2]
dim my[2]
if nMast = 2 then
	! ポストは荷台の端の外に立つ（芯々が荷台の長さと同じ機種もポストの半分＋50 は外へ）
	mx[2] = max(postSp / 2, cageL / 2 + mastW / 2 + 0.05)
	! 三成研機は図面のガイドレール芯どおり（低床型はレールが荷台の端の内側に入る）
	if cageH > 0 then mx[2] = postSp / 2
	mx[1] = -mx[2]
	my[1] = (yC0 + yC1) / 2
	my[2] = (yC0 + yC1) / 2
else
	mx[1] = 0
	my[1] = yC1 - mastW / 2 - 0.05
	if hoKind = 1 then my[1] = -gapOut - 0.125
endif
! フロアーゲートの幅（荷台の長さとゲートの有効開口の小さい方）
gW = cageL
if gateOpen > 0.01 then gW = min(cageL, gateOpen)
! 地上の昇降路の囲い（荷台から 0.3 離す。マストの外まで）
fX = cageL / 2 + 0.3
fY = yC1 - 0.3
for im = 1 to nMast
	fX = max(fX, abs(mx[im]) + 0.4)
	fY = min(fY, my[im] - mastW / 2 - 0.3)
next im
! 荷揚げ機は巻上げ機がマストの外側に出るので、囲いもその外まで
if hoKind = 3 then fY = fY - 0.6
! 乗り込み口（足場の手すりを外したスパン）。フロアーゲート・開閉式手すりはこの幅いっぱいに付けて開口を残さない
gA = -gW / 2
gB = gW / 2
if gateB - gateA > 0.1 then
	gA = gateA
	gB = gateB
endif
! フロアーゲートの面（外付けは足場の外側建地の列）
yG = -0.05
! 足場の幅の中に据える（利用者の指定 2026-10-28: 中に914幅で入れる）: 荷台を足場の幅の中央へ寄せ、ロングスパンの
! マストは昇降路の両横の足場の端の建地のすぐ内に立てる（枠組間隔の中）。乗り込み口は荷台の躯体側
if hoInside then
	dyI = rowSp / 2 + cageD / 2 - yC0
	yC0 = yC0 + dyI
	yC1 = yC1 + dyI
	for im = 1 to nMast
		my[im] = my[im] + dyI
	next im
	if hoKind = 1 and nMast = 2 then
		mx[1] = gA + mastW / 2 + 0.10
		mx[2] = gB - mastW / 2 - 0.10
		my[1] = rowSp / 2
		my[2] = rowSp / 2
	endif
	yG = yC0 + 0.03 + 0.05
	fY = min(yC1, 0) - 0.3
endif
