! 昇降機 3D: マスト（ベース・壁つなぎ）・荷台（床・手すり・頭上覆い）・各階のフロアーゲート
resol 8
if matCage > 0 then material matCage
add 0, 0, zH
rotz faceAng
mastH = max(hoReach + 1.5, 3)
for im = 1 to nMast
	! ベース
	add mx[im] - 0.40, my[im] - 0.40, 0
	block 0.80, 0.80, 0.12
	del 1
	! マスト（ラック付きの角形。150 角）
	add mx[im] - 0.075, my[im] - 0.075, 0.12
	block 0.15, 0.15, mastH - 0.12
	del 1
	! マストの壁つなぎ（足場の外側建地の列まで）。到達高さ（足場の天端）まで tieE ごと。数量（platforms: 到達高さ÷間隔）と
	! 同じ本数（マストの頂部まで描くと足場の天端より上に繋ぐ先の無い壁つなぎが1段出ていた）
	if showTie then
		! 控えの先はいちばん近い足場の建地（tieList。壁つなぎの一覧と同じ建地）。無ければマストの正面
		txm = mx[im]
		for it = 1 to nTX
			if it = 1 or abs(tieX[it] - mx[im]) < abs(txm - mx[im]) then txm = tieX[it]
		next it
		tdx = txm - mx[im]
		tdy = -(my[im] + 0.075)
		tLen = max(0.05, sqr(tdx ^ 2 + tdy ^ 2))
		if abs(tdx) < 0.0001 then
			tAng = 90
		else
			tAng = atn(tdy / tdx)
			if tdx < 0 then tAng = tAng + 180
		endif
		zt = tieE
		while zt < hoReach + 0.001 do
			add mx[im], my[im] + 0.075, zt
			rotz tAng
			roty 90
			cylind tLen, 0.0243
			del 3
			zt = zt + tieE
		endwhile
	endif
next im
! 荷台（いちばん下に止めた形）: 床・外側と両端の手すり（0.75・1.15）・頭上覆い
zF = 0.30
add -cageL / 2, yC1, zF
block cageL, cageD, 0.06
del 1
for hr = 1 to 2
	zr = zF + 0.35 + 0.40 * hr
	add -cageL / 2, yC1 + 0.03, zr
	roty 90
	cylind cageL, 0.0243
	del 2
	for se = 0 to 1
		add -cageL / 2 + se * cageL, yC1, zr
		rotx -90
		cylind cageD, 0.0243
		del 2
	next se
next hr
for cx = 0 to 1
	for cy = 0 to 1
		add -cageL / 2 + cx * cageL, yC1 + cy * cageD, zF
		cylind 2.1, 0.0243
		del 1
	next cy
next cx
add -cageL / 2, yC1, zF + 2.1
block cageL, cageD, 0.03
del 1
! フロアーゲート（各階の乗り込み口。単管 φ48.6 の扉: 手すり 0.9・中桟 0.45・両端の縦）。機種にフロアーゲートが
! 無ければ開閉式手すり（同じ高さの枠）。足場の線の部品は乗り込み口の固定の手すりを外すだけで、ここが防護を描く
if showGate then
	for il = 1 to nLand
		for hr = 1 to 2
			add gA, -0.04, landH[il] + 0.45 * hr
			roty 90
			cylind gB - gA, 0.0243
			del 2
		next hr
		for se = 0 to 1
			add gA + se * (gB - gA), -0.04, landH[il]
			cylind 1.0, 0.0243
			del 1
		next se
	next il
endif
! 地上の昇降路の囲い（足場側を除く3方。支柱・笠木・中桟・下桟。搬器の下への立入禁止）
if showFence then
	for ip = 1 to 3
		if ip = 1 then
			px0 = -fX
			py0 = yC0
			px1 = -fX
			py1 = fY
			fA = -90
		endif
		if ip = 2 then
			px0 = -fX
			py0 = fY
			px1 = fX
			py1 = fY
			fA = 0
		endif
		if ip = 3 then
			px0 = fX
			py0 = fY
			px1 = fX
			py1 = yC0
			fA = 90
		endif
		fLen = sqr((px1 - px0) ^ 2 + (py1 - py0) ^ 2)
		nP = max(1, int(fLen / 1.8 + 0.99))
		for k = 0 to nP
			add px0 + (px1 - px0) * k / nP, py0 + (py1 - py0) * k / nP, 0
			cylind 1.8, 0.0243
			del 1
		next k
		for hr = 1 to 3
			add px0, py0, 0.1 + 0.85 * (hr - 1)
			rotz fA
			roty 90
			cylind fLen, 0.0243
			del 3
		next hr
	next ip
endif
! 渡し板（各階の乗り込み口で足場の作業床から荷台までのすき間を塞ぐ。足場の外側建地の列から荷台の足場側の端の先 0.15 まで）
for il = 1 to nLand
	add -gW / 2, yC0 - 0.15, landH[il] + 0.02
	block gW, gapOut + 0.15, 0.03
	del 1
next il
del top
