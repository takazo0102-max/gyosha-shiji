! ============================================================
! 足場 詳細図 2Dシンボル（5枚を detailType で切替）
! 法規チェックを図面上に埋め込む（違反時は警告ペンで赤字表示）
! ============================================================
set style "anno"
pen 1

dim warnMsg[8]
nWarn = 0
ttl = ""
! 注記の最終行の高さ。図面名と警告はこれより下に置く（重ねない）。
! 固定位置に置いていたため、注記が長い図では赤字と注記が重なっていた
ny = -0.95

! detailType はASCIIキーで指定する。
! 日本語文字列をパラメータ値として外部から渡すと比較が一致しない（実機で確認済み）ため、
! 判定キーは必ずASCII、画面に出す名称だけ日本語にする。
if detailType = "base" then
	gosub 100
else
	if detailType = "tie" then
		gosub 200
	else
		if detailType = "asagao" then
			gosub 300
		else
			if detailType = "corner" then
				gosub 400
			else
				if detailType = "beam" then
					gosub 500
				else
					if detailType = "hoist" then
						gosub 600
					else
						! 未知キーで別の図を黙って描くと誤りが図面に紛れ込むので明示する
						pen warnPen
						text2 0, 0, "detailType 未知: " + detailType
						text2 0, -0.12, "base / tie / asagao / corner / beam / hoist を指定してください"
						pen 1
						end
					endif
				endif
			endif
		endif
	endif
endif

gosub 900		! 図面名と警告の表示
end

! ============================================================
100: ! ---- 脚部詳細（立面） ----
! 参照実装 kyakubu_detail_2d.gdl を系列パラメータ対応にしたもの
! 枠組にコマピッチは無いので、階高で書く（"コマピッチ 0" は意味を成さない）
if isFrame then
	ttl = "脚部詳細（タイプ" + serType + " 階高" + str(floorH * 1000, 4, 0) + "）"
else
	ttl = "脚部詳細（タイプ" + serType + " コマピッチ" + str(koma * 1000, 3, 0) + "）"
endif

y_base = 0.050						! ジャッキ台座上端（敷板35+ベース15）
y_sic0 = y_base + jackOut			! 支柱下端レベル

! GL・地盤ハッチ
line2 -0.60, 0, 0.65, 0
for gx = -0.55 to 0.60 step 0.05
	line2 gx, 0, gx - 0.03, -0.03
next gx

rect2 -0.45, 0, 0.45, 0.035			! 敷板 900x35
line2 -0.45, 0.010, 0.45, 0.010
rect2 -0.070, 0.035, 0.070, 0.050	! アンダーベース 140角

! ジャッキベース
rect2 -0.070, y_base, 0.070, y_base + 0.006
rect2 -r_jack, y_base, r_jack, y_sic0 + 0.100
for ty = y_base + 0.02 to y_sic0 - 0.01 step 0.02
	line2 -r_jack, ty, r_jack, ty
next ty
rect2 -0.045, y_sic0 - 0.035, 0.045, y_sic0 - 0.015	! 調整ハンドル

! 支柱
rect2 -r_sic, y_sic0, r_sic, 0.90
line2 -r_sic, y_sic0, r_sic, y_sic0

! 根がらみコマ＋根がらみ布材＋くさび
y_koma = y_sic0 + negaLv
rect2  r_sic, y_koma - 0.015,  r_sic + 0.020, y_koma + 0.015
rect2 -r_sic - 0.020, y_koma - 0.015, -r_sic, y_koma + 0.015
rect2  r_sic + 0.020, y_koma - r_nuno, 0.60, y_koma + r_nuno
poly2 4, 1,
	r_sic + 0.020, y_koma + 0.015,
	r_sic + 0.038, y_koma + 0.015,
	r_sic + 0.030, y_koma - 0.020,
	r_sic + 0.020, y_koma - 0.020

hotspot2 0, 0
hotspot2 0, y_sic0
hotspot2 0.60, y_koma

! 法規チェック: ジャッキ繰出し ≦270（実務基準）
if jackOut > LIM_JACK then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※ジャッキ繰出し " + str(jackOut * 1000, 4, 0) + "mm > 270mm 要是正"
endif
! 法規チェック: 第一の布（根がらみ）はできる限り低く・GLから2m以下
if y_koma > 2.0 then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※根がらみ高さ超過（安衛則571条 第一の布2m以下）"
endif

if not(showDim) then return

! 繰出し量の寸法
dimx = -0.52
line2 dimx, y_base, dimx, y_sic0
line2 dimx - 0.015, y_base, dimx + 0.015, y_base
line2 dimx - 0.015, y_sic0, dimx + 0.015, y_sic0
! 左詰めのままだと寸法線から右へ伸びて脚部の絵の上に重なる。
! 基準値（≦270）も足さない。違反時に「350≦270」と嘘の式になるうえ、
! 実測値だけなら文字が短く収まる（基準は注記と警告文に出る）
jackTxt = "繰出し " + str(jackOut * 1000, 4, 0)
text2 dimx - 0.02 - stw(jackTxt) * GLOB_SCALE / 1000,
	(y_base + y_sic0) / 2, jackTxt

! 引出し注記
! 引出し注記は文字高に追随させて行送りする（縮尺が変わっても重ならない）
tx = 0.68
ny = 0.90
line2 r_sic, ny, tx - 0.02, ny
text2 tx, ny, "支柱 φ48.6"
ny = ny - txtLine
line2 0.50, y_koma, tx - 0.02, ny
text2 tx, ny, "根がらみ φ42.7（最下コマ）"
ny = ny - txtLine
line2 0.03, y_sic0 - 0.025, tx - 0.02, ny
text2 tx, ny, "ジャッキベース φ38.1"
ny = ny - txtLine
line2 0.06, 0.043, tx - 0.02, ny
text2 tx, ny, "アンダーベース 140角"
ny = ny - txtLine
line2 0.40, 0.018, tx - 0.02, ny
text2 tx, ny, "敷板"
ny = ny - txtLine * 1.4
! 基準は寸法に混ぜず注記に置く（寸法は実測値だけ）
text2 tx, ny, "ジャッキ繰出しは " + str(LIM_JACK * 1000, 3, 0) + "mm以下"
return

! ============================================================
200: ! ---- 壁つなぎ部詳細（平面） ----
ttl = "壁つなぎ部詳細（平面 タイプ" + serType + "）"

xin  = -standoff				! 内側建地
xout = -standoff - rowW			! 外側建地

! 躯体（右側）
line2 0, -0.50, 0, 0.50
rect2 0, -0.50, 0.35, 0.50
for gy = -0.48 to 0.48 step 0.06
	line2 0, gy, 0.06, gy + 0.06
next gy

! 建地（内・外）と布材
circle2 xin, 0, r_sic
circle2 xout, 0, r_sic
circle2 xin, spanW, r_sic
circle2 xout, spanW, r_sic
rect2 xin - r_nuno, 0, xin + r_nuno, spanW
rect2 xout - r_nuno, 0, xout + r_nuno, spanW

! 踏板（内外建地間）
rect2 xout + 0.05, 0.10, xout + 0.05 + deckW1, spanW - 0.10
if deckW2 > 0 then
	rect2 xout + 0.07 + deckW1, 0.10, xout + 0.07 + deckW1 + deckW2, spanW - 0.10
endif

! 壁つなぎ材（躯体アンカー → 内側建地クランプ）
rect2 0, -r_tie, xin, r_tie
rect2 -0.030, -0.022, 0, 0.022			! アンカープレート
rect2 xin - 0.035, -0.030, xin + 0.035, 0.030	! 緊結クランプ
line2 xin - 0.035, -0.030, xin + 0.035, 0.030

hotspot2 0, 0
hotspot2 xin, 0
hotspot2 xout, 0

! 法規チェック: 壁つなぎ間隔（安衛則570条1項五号）。上限は足場の種類で違うので
! パラメータ tieVLim/tieHLim で受ける（くさび式 5m×5.5m／わく組 9m×8m）
if tieV > LIM_TIE_V then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※壁つなぎ垂直間隔 " + str(tieV * 1000, 5, 0) + \
		"mm > " + str(LIM_TIE_V * 1000, 5, 0) + "mm"
endif
if tieH > LIM_TIE_H then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※壁つなぎ水平間隔 " + str(tieH * 1000, 5, 0) + \
		"mm > " + str(LIM_TIE_H * 1000, 5, 0) + "mm"
endif

if not(showDim) then return

! 寸法（離れ・建地間隔）
dy = -0.30
line2 xin, dy, 0, dy
line2 xin, dy - 0.02, xin, dy + 0.02
line2 0, dy - 0.02, 0, dy + 0.02
! 「離れ 300」は離れ寸法（300mm）より文字の方が長く、隣の建地間隔の
! 数字と重なる。行を1つ下げて逃がす
set style "annoC"
text2 (xin + 0) / 2, dy - 0.05 - txtLine, "離れ " + str(standoff * 1000, 4, 0)
set style "anno"
line2 xout, dy, xin, dy
line2 xout, dy - 0.02, xout, dy + 0.02
set style "annoC"
text2 (xout + xin) / 2, dy - 0.05, str(rowW * 1000, 4, 0)
set style "anno"

tx = 0.45
ny = 0.42
line2 xin / 2, r_tie, tx - 0.02, ny
text2 tx, ny, "壁つなぎ φ27.2（伸縮式）"
ny = ny - txtLine
text2 tx, ny, "配置間隔 垂直" + str(tieV * 1000, 5, 0) + " × 水平" + str(tieH * 1000, 5, 0)
ny = ny - txtLine
text2 tx, ny, "（法定 垂直" + str(LIM_TIE_V * 1000, 5, 0) + \
	"以下×水平" + str(LIM_TIE_H * 1000, 5, 0) + "以下）"
ny = ny - txtLine
text2 tx, ny, "コーナーから1.8m以上離して左右均等に配置"
ny = ny - txtLine
text2 tx, ny, "躯体側はアンカー、建地側は緊結クランプ"
return

! ============================================================
300: ! ---- 朝顔（防護棚）取付部詳細（立面） ----
ttl = "朝顔取付部詳細（立面 タイプ" + serType + "）"

xout = 0						! 外側建地
xin  = rowW						! 内側建地
xwall = rowW + standoff			! 躯体面

! 躯体
line2 xwall, -0.30, xwall, 1.60
rect2 xwall, -0.30, xwall + 0.25, 1.60
for gy = -0.28 to 1.55 step 0.08
	line2 xwall, gy, xwall + 0.06, gy + 0.06
next gy

! 建地2本
rect2 xout - r_sic, -0.30, xout + r_sic, 1.60
rect2 xin - r_sic, -0.30, xin + r_sic, 1.60
! 布材（作業床レベル）
circle2 xout, 0, r_nuno
circle2 xin, 0, r_nuno
circle2 xout, koma, r_nuno
circle2 xout, 2 * koma, r_nuno

! 朝顔（外向き上がり勾配）
ax = -asagaoProj * cos(asagaoAngle)
ay =  asagaoProj * sin(asagaoAngle)
! 受けブラケット
line2 xout, 0, xout + ax, ay
line2 xout, 0.06, xout + ax, ay + 0.06
! 防護板
poly2 4, 1,
	xout, 0.06,
	xout + ax, ay + 0.06,
	xout + ax, ay + 0.085,
	xout, 0.085
! 方杖（支柱の1コマ上へ）
line2 xout + ax * 0.55, ay * 0.55, xout, 2 * koma
! 先端の返し
line2 xout + ax, ay + 0.06, xout + ax - 0.02, ay + 0.20

hotspot2 xout, 0
hotspot2 xout + ax, ay
hotspot2 xwall, 0

! 法規チェック: 突出2m以上・傾斜20度以上
if asagaoProj < LIM_ASA_P then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※朝顔突出 " + str(asagaoProj * 1000, 5, 0) + "mm < 2000mm"
endif
if asagaoAngle < LIM_ASA_A then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※朝顔傾斜 " + str(asagaoAngle, 3, 0) + "度 < 20度"
endif

if not(showDim) then return

! 突出寸法
dyy = -0.22
line2 xout + ax, dyy, xout, dyy
line2 xout + ax, dyy - 0.02, xout + ax, dyy + 0.02
line2 xout, dyy - 0.02, xout, dyy + 0.02
! 法定値（≧2000）は注記と警告に出る。寸法に足すと文字が長くなって
! 建地の上に重なり、かつ違反時は「1500≧2000」と嘘の式になる
set style "annoC"
text2 xout + ax / 2, dyy - 0.11, "突出 " + str(asagaoProj * 1000, 5, 0)
set style "anno"
! 角度
arc2 xout, 0, 0.30, 180 - asagaoAngle, 180
! 建地寄りは方杖と朝顔板に挟まれて置き場がない。先端寄りの板の上に出す
text2 xout + ax * 0.85, ay * 0.85 + 0.18, str(asagaoAngle, 3, 0) + "°"

tx = xwall + 0.35
ny = 1.45
text2 tx, ny, "朝顔（防護棚）"
ny = ny - txtLine
text2 tx, ny, "高さ10m以上で1段、20m以上で2段"
ny = ny - txtLine
text2 tx, ny, "取付部は2スパン毎に壁つなぎを設置"
ny = ny - txtLine
text2 tx, ny, "外周から水平突出2m以上・水平面と20度以上"
return

! ============================================================
400: ! ---- コーナー部詳細（平面・出隅の回し） ----
ttl = "コーナー部詳細（出隅 平面 タイプ" + serType + "）"

! 躯体は第1象限、足場は外側（-X / -Y 側）に回る
line2 0, 0, 0, 1.20
line2 0, 0, 1.20, 0
rect2 0, 0, 1.20, 1.20
for gg = 0.05 to 1.15 step 0.10
	line2 0, gg, 0.07, gg + 0.07
	line2 gg, 0, gg + 0.07, 0.07
next gg

yin  = -standoff
yout = -standoff - rowW
xin  = -standoff
xout = -standoff - rowW

! X方向の面（下側）: 建地ラインと踏板
rect2 xout, yin - r_nuno, 1.20, yin + r_nuno
rect2 xout, yout - r_nuno, 1.20, yout + r_nuno
rect2 xout + 0.05, yout + 0.05, 1.15, yout + 0.05 + deckW1
! Y方向の面（左側）
rect2 xin - r_nuno, yout, xin + r_nuno, 1.20
rect2 xout - r_nuno, yout, xout + r_nuno, 1.20
rect2 xout + 0.05, yout + 0.05 + deckW1 + 0.02, xout + 0.05 + deckW1, 1.15

! 支柱（コーナーは両面共有の1本）
circle2 xin, yin, r_sic
circle2 xout, yout, r_sic
circle2 xin, yout, r_sic
circle2 xout, yin, r_sic
circle2 xin + spanW, yin, r_sic
circle2 xout + spanW, yout, r_sic
circle2 xin, yin + spanW, r_sic
circle2 xout, yout + spanW, r_sic

hotspot2 0, 0
hotspot2 xin, yin
hotspot2 xout, yout

! 枠組は支柱を共有できず、コーナーに隙間が残る。干渉を避ける下限がある
if cornerGap > 0 and cornerGap < 0.070 then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※コーナー隙間 " + str(cornerGap * 1000, 4, 0) + \
		"mm < 70mm（建枠が干渉）"
endif

if not(showDim) then return

! 離れ寸法（両方向）。躯体（第1象限）の中に引くとハッチと数字が重なるので、
! 躯体の外（1.20の先）に寸法線を出す
line2 xin, 1.30, 0, 1.30
line2 xin, 1.28, xin, 1.32
line2 0, 1.28, 0, 1.32
set style "annoC"
text2 xin / 2, 1.35, str(standoff * 1000, 4, 0)
set style "anno"
line2 1.30, yin, 1.30, 0
line2 1.28, yin, 1.32, yin
line2 1.28, 0, 1.32, 0
text2 1.35, yin / 2, str(standoff * 1000, 4, 0)

if cornerGap > 0 then
	text2 xout, yout - 0.10, "コーナー隙間 " + str(cornerGap * 1000, 4, 0) + "mm"
endif

tx = 0.55
ny = yout - txtLine
text2 tx, ny, "出隅は「回し」: 優先面の足場を直交面の外面まで延長し"
ny = ny - txtLine
! 納まりの根拠が方式で違う。くさびの説明を枠組の図に載せない
if serType = "W" then
	text2 tx, ny, "直交面の起点とする。枠組は建枠の向きが固定で支柱を"
	ny = ny - txtLine
	text2 tx, ny, "共有できないため、コーナーに隙間を残して納める"
	ny = ny - txtLine
	text2 tx, ny, "隙間は建枠の干渉を避けて70mm以上・ステップ250mm以内"
else
	text2 tx, ny, "直交面の起点とする。くさび式はコマが4方向にあるため"
	ny = ny - txtLine
	text2 tx, ny, "コーナー支柱1本を両面で共有できる"
	ny = ny - txtLine
	text2 tx, ny, "端数はコーナーで受けず壁離れ（" + \
		str(SO_MIN * 1000, 4, 0) + "〜" + str(SO_MAX * 1000, 4, 0) + \
		"）で吸収する"
endif
ny = ny - txtLine
text2 tx, ny, "※コーナーで足場板の調整をしないこと"
ny = ny - txtLine
text2 tx, ny, "壁つなぎはコーナーから1.8m以上離す（1スパン除外）"
ny = ny - txtLine
text2 tx, ny, "踏板の余りを外側にはみ出させない"
return

! ============================================================
500: ! ---- 開口部 梁枠詳細（立面） ----
ttl = "開口部 梁枠詳細（立面 " + str(beamSpan * 1000, 5, 0) + " タイプ" + serType + "）"

! 開口高さ（梁枠下端）。実際に梁枠を載せる作業層の高さを使う
hOpen = 2 * floorH
if openH > 0 then hOpen = openH
ht = 0.45						! トラス梁枠せい

! 梁枠（上下弦材＋斜材）
rect2 0, hOpen, beamSpan, hOpen + 0.05
rect2 0, hOpen + ht - 0.05, beamSpan, hOpen + ht
nDiv = 6
for i = 0 to nDiv - 1
	x1 = beamSpan * i / nDiv
	x2 = beamSpan * (i + 1) / nDiv
	if i - 2 * int(i / 2) = 0 then
		line2 x1, hOpen + 0.05, x2, hOpen + ht - 0.05
	else
		line2 x1, hOpen + ht - 0.05, x2, hOpen + 0.05
	endif
	line2 x1, hOpen + 0.05, x1, hOpen + ht - 0.05
next i
line2 beamSpan, hOpen + 0.05, beamSpan, hOpen + ht - 0.05

! 梁枠を支持する両端の支柱（下まで通る）
rect2 -r_sic, 0, r_sic, hOpen + ht + 2 * floorH
rect2 beamSpan - r_sic, 0, beamSpan + r_sic, hOpen + ht + 2 * floorH
! 梁枠上に乗る中間支柱（開口部には建てない）。位置は割付の実測値を優先する
if nBp > 0 then
	nUp = nBp + 1
	for i = 1 to nBp
		xx = bpOff[i]
		rect2 xx - r_sic, hOpen + ht, xx + r_sic, hOpen + ht + 2 * floorH
	next i
else
	nUp = int(beamSpan / spanW + 0.001)
	for i = 1 to nUp - 1
		xx = spanW * i
		rect2 xx - r_sic, hOpen + ht, xx + r_sic, hOpen + ht + 2 * floorH
	next i
endif

! 梁枠上の作業床と手すり
for lv = 1 to 2
	yy = hOpen + ht + floorH * (lv - 1)
	rect2 0, yy, beamSpan, yy + 0.045
	line2 0, yy + koma, beamSpan, yy + koma
	line2 0, yy + 2 * koma, beamSpan, yy + 2 * koma
next lv

! GL
line2 -0.40, 0, beamSpan + 0.40, 0
for gx = -0.35 to beamSpan + 0.35 step 0.08
	line2 gx, 0, gx - 0.05, -0.05
next gx

hotspot2 0, 0
hotspot2 beamSpan, hOpen
hotspot2 0, hOpen + ht

! 梁枠は規格品しか飛ばせない。規格寸法は系列で違うので beamList で受ける
isStd = 0
for i = 1 to nBeam
	if abs(beamSpan - beamStd[i]) < 0.001 then isStd = 1
next i
if isStd = 0 then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※梁枠スパン " + str(beamSpan * 1000, 5, 0) + \
		"mm は規格外（" + beamStdTxt + "）"
endif

if not(showDim) then return

dyy = -0.25
line2 0, dyy, beamSpan, dyy
line2 0, dyy - 0.03, 0, dyy + 0.03
line2 beamSpan, dyy - 0.03, beamSpan, dyy + 0.03
set style "annoC"
text2 beamSpan / 2, dyy - 0.10, "梁枠 " + str(beamSpan * 1000, 5, 0)
set style "anno"

line2 -0.30, 0, -0.30, hOpen
line2 -0.33, 0, -0.27, 0
line2 -0.33, hOpen, -0.27, hOpen
! 左詰めのままだと寸法線を跨いで開口の中へ文字が入る
openTxt = "開口 " + str(hOpen * 1000, 5, 0)
text2 -0.36 - stw(openTxt) * GLOB_SCALE / 1000, hOpen / 2, openTxt

tx = beamSpan + 0.20
ny = hOpen + ht + 3 * txtLine
text2 tx, ny, "トラス梁枠（" + str(nUp, 1, 0) + "スパン分の支柱を受ける）"
ny = ny - txtLine
text2 tx, ny, "梁枠上は積載荷重を低減し、両端支柱は補強すること"
ny = ny - txtLine
text2 tx, ny, "梁枠取付部の直近に壁つなぎを設置"
return

! ============================================================
600: ! ---- ロングスパンエレベーター（工事用エレベーター）詳細（立面＋平面） ----
! 足場の外側にマストと搬器が立ち、各乗り込み口で足場の作業床へ渡る。
! 足場側の取合い（マスト控え・乗り込み口の開閉式手すり・渡し板）を示す。
! 本体の基礎・構造・定格はメーカー仕様（本ツールの対象外）
ttl = "ロングスパンエレベーター詳細（立面・平面 タイプ" + serType + "）"
hH = hoistH
if hH <= 0.001 then hH = 6 * floorH
hg = hoistGap
cx0 = -hg - hoistD                     ! 搬器の外側端（足場外側建地を x=0 とし、外側が -x）
mx = cx0 - 0.15                        ! マスト中心（搬器の外側に立つ）

! --- 立面（面に直交する方向から見る: 左が外、右が躯体側） ---
! 足場: 外側建地・内側建地（建地列間隔 rowW）と作業床
rect2 -r_sic, 0, r_sic, hH + koma
rect2 rowW - r_sic, 0, rowW + r_sic, hH + koma
! GL
line2 mx - 0.60, 0, rowW + 0.60, 0
for gx = mx - 0.55 to rowW + 0.55 step 0.08
	line2 gx, 0, gx - 0.05, -0.05
next gx
! マスト（ラック付きの角形マスト。継ぎ目を0.5mごとに示す）
rect2 mx - 0.15, 0, mx + 0.15, hH
nm = int(hH / 0.5)
for i = 1 to nm
	line2 mx - 0.15, i * 0.5, mx + 0.15, i * 0.5
next i
! 搬器（最下の乗り込み口の高さに置く。高さ2.2m）
cz = landH[1]
rect2 cx0, cz, cx0 + hoistD, cz + 2.2
line2 cx0, cz, cx0 + hoistD, cz + 2.2
line2 cx0, cz + 2.2, cx0 + hoistD, cz
! 各乗り込み口: 作業床・渡し板（隙間を塞ぐ）・開閉式手すり（遮断設備）
for i = 1 to nLand
	z = landH[i]
	rect2 -0.05, z, rowW + 0.05, z + 0.045
	rect2 -hg, z + 0.045, 0, z + 0.075
	if hoistGate = 1 then
		rect2 -0.02, z + 0.10, 0.02, z + 0.90
		line2 -0.06, z + 0.90, 0.06, z + 0.90
		line2 -0.06, z + 0.50, 0.06, z + 0.50
	endif
next i
! マスト控え（間隔 mastTie ごとに足場の外側建地へ。足場側は壁つなぎで躯体へ）
nt = int(hH / mastTie)
for i = 1 to nt
	z = i * mastTie
	rect2 mx + 0.15, z - r_tie, 0, z + r_tie
	rect2 -0.035, z - 0.03, 0.035, z + 0.03
next i

hotspot2 0, 0
hotspot2 mx, 0
hotspot2 mx, hH

! --- 平面（右側に並べる。搬器の平面が立面の建地に掛からないだけ右へ離す）---
px = rowW + 0.90 + hg + hoistD + 0.30
py = 0
! 足場の建地列2本と踏板（間口 spanW）
rect2 px - r_nuno, py, px + r_nuno, py + spanW
rect2 px + rowW - r_nuno, py, px + rowW + r_nuno, py + spanW
circle2 px, py, r_sic
circle2 px, py + spanW, r_sic
circle2 px + rowW, py, r_sic
circle2 px + rowW, py + spanW, r_sic
rect2 px + 0.05, py + 0.10, px + 0.05 + deckW1, py + spanW - 0.10
! 搬器（幅 hoistW × 奥行 hoistD）とマスト。乗り込み口は搬器の幅ぶん開く
cy0 = py + (spanW - hoistW) / 2
rect2 px - hg - hoistD, cy0, px - hg, cy0 + hoistW
line2 px - hg - hoistD, cy0, px - hg, cy0 + hoistW
line2 px - hg - hoistD, cy0 + hoistW, px - hg, cy0
rect2 px - hg - hoistD - 0.30, py + spanW / 2 - 0.15, px - hg - hoistD, py + spanW / 2 + 0.15
! 乗り込み口の開閉式手すり（搬器の幅、外側建地位置）
if hoistGate = 1 then
	line_type 3
	line2 px, cy0, px, cy0 + hoistW
	line_type 1
endif
hotspot2 px, py

! 法規チェック: 乗り込み口の遮断設備（安衛則563条: 作業床の開放端）
if hoistGate = 0 then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※乗り込み口に開閉式手すり（遮断設備）が必要（安衛則563条）"
endif
! 積載荷重未指定は届出区分が決まらない
if hoistLoad <= 0.001 then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※積載荷重が未指定。メーカー仕様で確認し設置届/設置報告の要否を決めること"
endif

if not(showDim) then return

! 寸法: 搬器奥行・隙間・到達高さ
dyy = -0.30
line2 cx0, dyy, 0, dyy
line2 cx0, dyy - 0.03, cx0, dyy + 0.03
line2 -hg, dyy - 0.03, -hg, dyy + 0.03
line2 0, dyy - 0.03, 0, dyy + 0.03
set style "annoC"
text2 (cx0 - hg) / 2, dyy - 0.10, "搬器 " + str(hoistD * 1000, 4, 0)
set style "annoC"
text2 -hg / 2, dyy - 0.10 - txtLine, "隙間 " + str(hg * 1000, 3, 0)
set style "anno"
line2 mx - 0.40, 0, mx - 0.40, hH
line2 mx - 0.43, 0, mx - 0.37, 0
line2 mx - 0.43, hH, mx - 0.37, hH
hTxt = "到達 " + str(hH * 1000, 5, 0)
text2 mx - 0.46 - stw(hTxt) * GLOB_SCALE / 1000, hH / 2, hTxt

! 注記
tx = px + rowW + 0.40
ny = hH
text2 tx, ny, "ロングスパンエレベーター（工事用エレベーター）"
ny = ny - txtLine
text2 tx, ny, "搬器 W" + str(hoistW * 1000, 4, 0) + "×D" + str(hoistD * 1000, 4, 0) + \
	"（図示用。機種の実寸で差し替え）"
ny = ny - txtLine
text2 tx, ny, "乗り込み口 " + str(nLand, 2, 0) + "箇所: 渡し板で隙間" + str(hg * 1000, 3, 0) + \
	"mmを塞ぎ、開閉式手すりで防護"
ny = ny - txtLine
text2 tx, ny, "マスト控え: " + str(mastTie * 1000, 5, 0) + "mm以内ごとに足場の建地へ（メーカー指定）"
ny = ny - txtLine
text2 tx, ny, "　控えを受ける建地には壁つなぎを増設（構造計算書のマスト控え）"
ny = ny - txtLine
if hoistLoad >= 9.8 then
	text2 tx, ny, "積載荷重 " + str(hoistLoad, 4, 1) + "kN（1t以上）→ 設置届（クレーン等安全規則140条・30日前）"
else
	if hoistLoad >= 2.45 then
		text2 tx, ny, "積載荷重 " + str(hoistLoad, 4, 1) + "kN（0.25t以上1t未満）→ 設置報告（クレーン等安全規則145条）"
	else
		if hoistLoad > 0.001 then
			text2 tx, ny, "積載荷重 " + str(hoistLoad, 4, 1) + "kN（0.25t未満）→ 届出区分外"
		else
			text2 tx, ny, "積載荷重: 未指定（メーカー仕様で確認）"
		endif
	endif
endif
ny = ny - txtLine
text2 tx, ny, "本体の基礎・据付・定格速度はメーカー施工要領による（本図は足場側の取合い）"
return

! ============================================================
900: ! ---- 図面名と法規警告の表示 ----
! 枠組で使うと納まりが違う。黙って提出図書に載せないよう最初に出す
if isFrame then
	nWarn = nWarn + 1
	warnMsg[nWarn] = "※本図はくさび緊結式の納まりです。枠組足場の詳細図は別途作成してください"
endif
pen 1
wy = min(-0.95, ny) - txtLine * 1.4
text2 0, wy, ttl
if nWarn = 0 then return
pen warnPen
wy = wy - txtLine * 1.4
text2 0, wy, "【法規チェック警告】"
for i = 1 to nWarn
	text2 0, wy - txtLine * i, warnMsg[i]
next i
pen 1
return
