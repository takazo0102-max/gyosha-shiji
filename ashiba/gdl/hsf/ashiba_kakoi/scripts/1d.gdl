! 仮囲い: 支柱・地盤・横地・パネルの範囲・ゲート・控えを読む（m）
dim px[]
nP = 0
rest = postX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nP = nP + 1
		px[nP] = v / 1000
	endif
endwhile
