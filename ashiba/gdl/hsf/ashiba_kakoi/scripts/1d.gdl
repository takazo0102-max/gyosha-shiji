r = 0.0243
ro = 0.0486
! パネルの裏（支柱の芯から外へ）: 安全鋼板は横地の外面＋フック、フラット・防音は縁の折り返し 28
po = 0.0749
if kkType = 2 or kkType = 3 then po = 0.1009
pt = 0.0012
if kkType = 3 then pt = 0.025
! 山留めから取るときは横地が親杭の外のフランジに付く
if kkFound = 5 then
	po = po + pileW / 2 + r - ro
	ro = pileW / 2 + r
endif
wtF = 0
wtR = 0
if nWt >= 2 then
	wtF = round_int(wt[1] * 1000)
	wtR = round_int(wt[2] * 1000)
