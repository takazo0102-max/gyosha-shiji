! ============================================================
! 壁つなぎ 3D: 支柱側のクランプ（自在クランプ相当の塊）、伸縮する本体パイプ φ27.2、
! 躯体側のアンカープレート（ボルトで躯体に固定する座）
! ============================================================
pen 1
if matTie > 0 then material matTie
resol 8
rotz faceAng
addz zH
if lineMode then
	lin_ 0, 0, 0, 0, tieL, 0
else
	rotx -90
	cylind tieL, 0.0273 / 2
	del 1
	add -0.035, -0.035, -0.035
	block 0.07, 0.07, 0.07
	del 1
	add -0.05, tieL - 0.012, -0.05
	block 0.10, 0.012, 0.10
	del 1
endif
hotspot 0, 0, 0
hotspot 0, tieL, 0
del 2
