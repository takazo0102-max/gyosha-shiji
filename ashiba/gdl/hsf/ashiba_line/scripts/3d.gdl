! ============================================================
! 足場ライン 3Dスクリプト
! 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体側 +Y
! ============================================================
pen 1

! ---- 支柱（各スパン境界に内外1対） ----
! 梁枠の内側は支柱を抜く（平面・立面と同じ）。3Dだけ建てたままだと、
! 実際には無い建地を干渉確認に使うことになる
x = 0
for ip = 1 to nSpan + 1
	bBase = 0
	for ib = 1 to nBm
		if x > bmS[ib] + 0.001 and x < bmS[ib] + bmL[ib] - 0.001 then bBase = bmH[ib]
	next ib
	! この支柱位置の地盤高とジャッキ（敷地高低差があれば脚ごと）
	gv = 0
	jo = jackOut
	if ip <= nGl then gv = gl[ip]
	if ip <= nJk then jo = jk[ip]
	for row = rowStart to 1
		if bBase = 0 then
			add x, -row * rowW, gv
			! ジャッキ
			cylind jo, 0.0381 / 2
			addz jo
			if nGl >= 2 then
				! 継ぎ足した脚は長さが脚ごとに違う。天端まで1本で描く
				cylind postTop - gv - jo, r_sic
				del 2
			else
				! 支柱積み上げ
				for j = 1 to nPost
					cylind posts[j], r_sic
					addz posts[j]
				next j
				del nPost + 2
			endif
		else
			! 梁枠上に乗る支柱（梁下から天端まで1本で描く）
			add x, -row * rowW, bBase
			cylind postTop - bBase, r_sic
			del 1
		endif
	next row
	if ip <= nSpan then x = x + spans[ip]
next ip

! ---- 水平材（根がらみ＋各作業層） ----
for il = 1 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		! 開口部（梁枠より下）は支柱を抜いた通路。布材も手すりも入らない。
		! 立面は空けているのに3Dだけ通していた（根がらみが足元を横切っていた）
		skipH = 0
		for ib6 = 1 to nBm
			if x >= bmS[ib6] - 0.001 and x + spans[ip] <= bmS[ib6] + bmL[ib6] + 0.001 and \
					z < bmH[ib6] - 0.001 then skipH = 1
		next ib6
		! 内外の布材（床レベル）
		if skipH = 0 then
			for row = rowStart to 1
				add x, -row * rowW, z
				roty 90
				cylind spans[ip], r_nuno
				del 2
			next row
		endif
		! 外側手すり・中桟（作業層のみ）
		if il > 1 and skipH = 0 then
			add x, -rowW, z + railTop
			roty 90
			cylind spans[ip], r_nuno
			del 2
			add x, -rowW, z + railMid
			roty 90
			cylind spans[ip], r_nuno
			del 2
		endif
		! 腕木（内外連結、-Y向き）。一側足場は内側建地が無いので入らない。
		! 開口部の内側は支柱を抜いてあるので、そこにも入らない
		noPost = 0
		for ib7 = 1 to nBm
			if x > bmS[ib7] + 0.001 and x < bmS[ib7] + bmL[ib7] - 0.001 and \
					z < bmH[ib7] - 0.001 then noPost = 1
		next ib7
		if noPost = 0 then
			if nRows >= 2 then
				add x, 0, z
				rotz -90
				roty 90
				cylind rowW, r_nuno
				del 3
			else
				gosub 800
			endif
		endif
		x = x + spans[ip]
	next ip
	! 終端の腕木（一側足場は床受けブラケット）
	if nRows >= 2 then
		add x, 0, z
		rotz -90
		roty 90
		cylind rowW, r_nuno
		del 3
	else
		gosub 800
	endif
next il

! ---- 踏板・幅木 ----
if showDeck then
	for il = 2 to nLv
		z = lv[il]
		x = 0
		for ip = 1 to nSpan
			! 階段室は段板で上がるので床を敷かない。ただし外構面の幅木は残る
			! （階段側の落下防止）。開口部（梁枠より下）は通路なので床も幅木も無い。
			! 数量もこの区別で拾っている（階段室は幅木を引かない）
			skipDeck = 0
			for it4 = 1 to nSt
				if x >= stS[it4] - 0.001 and x + spans[ip] <= stS[it4] + stL[it4] + 0.001 then skipDeck = 1
			next it4
			skipAll = 0
			for ib4 = 1 to nBm
				if x >= bmS[ib4] - 0.001 and x + spans[ip] <= bmS[ib4] + bmL[ib4] + 0.001 and \
						z < bmH[ib4] - 0.001 then skipAll = 1
			next ib4
			if skipAll = 0 then
				if skipDeck = 0 then
					add x, -rowW + 0.05, z
					block spans[ip], deckW1, 0.045
					del 1
					if deckW2 > 0 then
						add x, -rowW + 0.05 + deckW1 + 0.02, z
						block spans[ip], deckW2, 0.045
						del 1
					endif
				endif
				! 幅木（外側）
				add x, -rowW - 0.02, z + 0.045
				block spans[ip], 0.02, 0.157
				del 1
			endif
			x = x + spans[ip]
		next ip
	next il
endif

! ---- ブレス（外側構面、交さ2方向＝X） ----
! 設置間隔は bEvS スパン・bEvL 層ごと（1なら全構面）。数量拾いと
! 同じ間隔・同じ本数（1箇所2本）で描かないと、部材表と図面が食い違う
if showBrace then
	for il = 1 to nLv - 1
		if il - 1 - bEvL * int((il - 1) / bEvL) = 0 then
			z1 = lv[il]
			z2 = lv[il + 1]
			x = 0
			for ip = 1 to nSpan
				if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 then
					bl = sqr(spans[ip] ^ 2 + (z2 - z1) ^ 2)
					ang = atn((z2 - z1) / spans[ip])
					add x, -rowW - 0.05, z1
					roty 90 - ang
					cylind bl, 0.0213 / 2
					del 2
					add x + spans[ip], -rowW - 0.05, z1
					mulx -1
					roty 90 - ang
					cylind bl, 0.0213 / 2
					del 3
				endif
				x = x + spans[ip]
			next ip
		endif
	next il
endif

! ---- 朝顔（防護棚）: 外側へ突出する傾斜板と受けブラケット ----
! 突出2m・傾斜25度。数量にも法規チェックにも出るのに図面・3Dに
! 現れていなかった。突出2mの部材なので干渉確認のため実寸で出す
! 外側は -Y なので muly -1 でローカル+Yを外向きにしてから傾ける。
! そのまま block を置くと躯体側（+Y）へ張り出してしまう
for ia = 1 to nAsa
	za = asa[ia]
	! 板（外側へ張り出し、先端が上がる）
	add 0, -rowW, za
	muly -1
	rotx asagaoAngle
	block lineLen, asagaoProj, 0.02
	del 3
	! 受けブラケット（支柱位置ごと）
	x = 0
	for ip = 1 to nSpan + 1
		add x, -rowW, za
		muly -1
		rotx asagaoAngle - 90
		cylind asagaoProj, 0.0213 / 2
		del 3
		if ip <= nSpan then x = x + spans[ip]
	next ip
next ia

! ---- 壁つなぎ（内側建地から躯体側へ +Y 方向） ----
! 構造計算でも法規チェックでも見ているのに3Dに無く、躯体との
! 取り合いが確認できなかった
for it = 1 to nTiePair
	add ties[it], 0, tieH[it]
	rotx -90
	cylind standoff, r_tie
	del 2
next it

! ---- 荷受けステージ（外側へ張り出す床・手すり） ----
for ig = 1 to nSg
	add sgS[ig], -rowW, sgH[ig]
	muly -1
	block sgL[ig], sgP[ig], 0.05
	del 2
	! 手すり・中桟（張り出し先端）
	for ir = 1 to 2
		if ir = 1 then hgt = railH else hgt = midH
		add sgS[ig], -rowW - sgP[ig], sgH[ig] + hgt
		roty 90
		cylind sgL[ig], r_nuno
		del 2
	next ir
	! 妻側（左右）も開放端。前面だけ手すりを立てても横から落ちる
	for ie = 0 to 1
		xg = sgS[ig] + sgL[ig] * ie
		for ir = 1 to 2
			if ir = 1 then hgt = railH else hgt = midH
			add xg, -rowW, sgH[ig] + hgt
			rotx 90
			cylind sgP[ig], r_nuno
			del 2
		next ir
		! 妻側の幅木
		add xg, -rowW - sgP[ig], sgH[ig] + 0.05
		block 0.02, sgP[ig], 0.157
		del 1
	next ie
	! 先端の幅木
	add sgS[ig], -rowW - sgP[ig], sgH[ig] + 0.05
	block sgL[ig], 0.02, 0.157
	del 1
	! 張出ブラケットと方杖。床だけ描くとステージが宙に浮いて見えるうえ、
	! 数量では建地位置ぶん拾っている（張出ブラケット・方杖）
	xb = 0
	for ipb = 1 to nSpan + 1
		if xb >= sgS[ig] - 0.001 and xb <= sgS[ig] + sgL[ig] + 0.001 then
			add xb, -rowW, sgH[ig]
			rotz -90
			roty 90
			cylind sgP[ig], r_nuno
			del 3
			if sgZ[ig] > 0 then
				add xb, -rowW, sgH[ig] - sgP[ig]
				rotx 45
				cylind sgP[ig] * 1.4142, r_nuno
				del 2
			endif
		endif
		if ipb <= nSpan then xb = xb + spans[ipb]
	next ipb
next ig

! ---- 昇降機（マスト＋ケージの占有範囲） ----
! 実機は機種で寸法が違うので、図示用の見付け（HOIST_W×HOIST_D）で置く。
! 数量（乗り込み口の開閉式手すり）と構造（マストの局所荷重）には出ていたのに
! モデルに無く、搬入経路や庇との干渉を3Dで確認できなかった
for ih = 1 to nHo
	hx = hoP[ih]
	! 4隅の柱で枠として示す（塊で置くと足場が見えなくなる）
	for icx = 0 to 1
		for icy = 0 to 1
			add hx - HOIST_W / 2 + HOIST_W * icx, -rowW - HOIST_D * icy, 0
			cylind hoR[ih], 0.06 / 2
			del 1
		next icy
	next icx
	! 乗り込み口の高さに水平枠
	for il3 = 1 to nLa
		if abs(laP[il3] - hx) < 0.001 then
			add hx - HOIST_W / 2, -rowW - HOIST_D, laH[il3]
			block HOIST_W, HOIST_D, 0.04
			del 1
		endif
	next il3
next ih

! ---- 梁枠（開口部）: 上下弦材と斜材 ----
! 平面・立面には出ているのに3Dに無く、開口部の通り抜けを確認できなかった
for ib2 = 1 to nBm
	bs = bmS[ib2]
	bl = bmL[ib2]
	bh = bmH[ib2]
	for row2 = rowStart to 1
		add bs, -row2 * rowW - 0.02, bh - 0.45
		block bl, 0.04, 0.04
		del 1
		add bs, -row2 * rowW - 0.02, bh - 0.04
		block bl, 0.04, 0.04
		del 1
		! 斜材（4分割の折れ線をブロックで近似）
		nd2 = 4
		for id2 = 0 to nd2 - 1
			dlen = bl / nd2
			ang = atn(0.41 / dlen)
			add bs + dlen * id2, -row2 * rowW - 0.015, bh - 0.45
			if id2 - 2 * int(id2 / 2) = 0 then
				roty -ang
				block sqr(dlen * dlen + 0.41 * 0.41), 0.03, 0.03
				del 2
			else
				addz 0.41
				roty ang
				block sqr(dlen * dlen + 0.41 * 0.41), 0.03, 0.03
				del 3
			endif
		next id2
	next row2
next ib2

! ---- 階段室（段板を傾けて示す） ----
for it5 = 1 to nSt
	sx = stS[it5]
	sl = stL[it5]
	for il5 = 1 to nLv - 1
		rise = lv[il5 + 1] - lv[il5]
		ang5 = atn(rise / sl)
		add sx, -rowW + 0.05, lv[il5]
		roty -ang5
		block sqr(sl * sl + rise * rise), rowW - 0.10, 0.04
		del 2
	next il5
next it5

! ---- ブラケット区間（拡幅ぶんの作業床） ----
for ik = 1 to nBk
	if bkD[ik] > 0 then
		add bkS[ik], 0, bkH[ik]
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 1
	else
		add bkS[ik], -rowW, bkH[ik]
		muly -1
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 2
		! 張出すと作業床の外縁が建地より外に出る。その縁は開放端なので
		! 手すり・中桟・幅木が要る（数量にも計上している）
		bkLen = bkE[ik] - bkS[ik]
		add bkS[ik], -rowW - bkW[ik], bkH[ik] + 0.045
		block bkLen, 0.02, 0.157
		del 1
		add bkS[ik], -rowW - bkW[ik] - 0.02, bkH[ik] + railH
		block bkLen, 0.0427, 0.0427
		del 1
		add bkS[ik], -rowW - bkW[ik] - 0.02, bkH[ik] + midH
		block bkLen, 0.0427, 0.0427
		del 1
	endif
next ik

end

end

! ============================================================
800: ! ---- 一側足場の床受けブラケット（建地1列＋腕＋方杖） ----
! 作業床は建地から躯体側へ持ち出す。数量では「一側足場の床受けブラケット」
! として拾っているので、3Dにも出さないと図と部材表が食い違う
if il >= 2 then
	add x, -rowW, z
	rotz 90
	roty 90
	cylind rowW, r_nuno
	del 3
	add x, -rowW, z - rowW
	rotx -45
	cylind rowW * 1.4142, r_nuno
	del 2
endif
return
