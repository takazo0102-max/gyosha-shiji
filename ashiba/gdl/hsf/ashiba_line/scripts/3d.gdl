! ============================================================
! 足場ライン 3Dスクリプト
! 内側建地列 y=0 / 外側建地列 y=-rowW / 躯体側 +Y
! ============================================================
pen 1

! ---- 支柱（各スパン境界に内外1対） ----
x = 0
for ip = 1 to nSpan + 1
	for row = rowStart to 1
		add x, -row * rowW, 0
		! ジャッキ
		cylind jackOut, 0.0381 / 2
		addz jackOut
		! 支柱積み上げ
		for j = 1 to nPost
			cylind posts[j], r_sic
			addz posts[j]
		next j
		del nPost + 2
	next row
	if ip <= nSpan then x = x + spans[ip]
next ip

! ---- 水平材（根がらみ＋各作業層） ----
for il = 1 to nLv
	z = lv[il]
	x = 0
	for ip = 1 to nSpan
		! 内外の布材（床レベル）
		for row = rowStart to 1
			add x, -row * rowW, z
			roty 90
			cylind spans[ip], r_nuno
			del 2
		next row
		! 外側手すり・中桟（作業層のみ）
		if il > 1 then
			add x, -rowW, z + railTop
			roty 90
			cylind spans[ip], r_nuno
			del 2
			add x, -rowW, z + railMid
			roty 90
			cylind spans[ip], r_nuno
			del 2
		endif
		! 腕木（内外連結、-Y向き）。一側足場は内側建地が無いので入らない
		if nRows >= 2 then
			add x, 0, z
			rotz -90
			roty 90
			cylind rowW, r_nuno
			del 3
		endif
		x = x + spans[ip]
	next ip
	! 終端の腕木
	if nRows >= 2 then
		add x, 0, z
		rotz -90
		roty 90
		cylind rowW, r_nuno
		del 3
	endif
next il

! ---- 踏板・幅木 ----
if showDeck then
	for il = 2 to nLv
		z = lv[il]
		x = 0
		for ip = 1 to nSpan
			add x, -rowW + 0.05, z
			block spans[ip], deckW1, 0.045
			del 1
			if deckW2 > 0 then
				add x, -rowW + 0.05 + deckW1 + 0.02, z
				block spans[ip], deckW2, 0.045
				del 1
			endif
			! 幅木（外側）
			add x, -rowW - 0.02, z + 0.045
			block spans[ip], 0.02, 0.157
			del 1
			x = x + spans[ip]
		next ip
	next il
endif

! ---- ブレス（外側構面、スパンごとに交互方向） ----
! 設置間隔は bEvS スパン・bEvL 層ごと（1なら全構面）。数量拾いと
! 同じ間隔で描かないと、部材表と図面の本数が食い違う
if showBrace then
	for il = 1 to nLv - 1
		if il - 1 - bEvL * int((il - 1) / bEvL) = 0 then
			z1 = lv[il]
			z2 = lv[il + 1]
			x = 0
			for ip = 1 to nSpan
				if ip - 1 - bEvS * int((ip - 1) / bEvS) = 0 then
					bl = sqr(spans[ip] ^ 2 + (z2 - z1) ^ 2)
					ang = atn((z2 - z1) / spans[ip])
					if ip - 2 * int(ip / 2) = 0 then
						add x, -rowW - 0.05, z1
						roty 90 - ang
						cylind bl, 0.0213 / 2
						del 2
					else
						add x + spans[ip], -rowW - 0.05, z1
						mulx -1
						roty 90 - ang
						cylind bl, 0.0213 / 2
						del 3
					endif
				endif
				x = x + spans[ip]
			next ip
		endif
	next il
endif

! ---- 朝顔（防護棚）: 外側へ突出する傾斜板と受けブラケット ----
! 突出2m・傾斜25度。数量にも法規チェックにも出るのに図面・3Dに
! 現れていなかった。突出2mの部材なので干渉確認のため実寸で出す
! 外側は -Y なので muly -1 でローカル+Yを外向きにしてから傾ける。
! そのまま block を置くと躯体側（+Y）へ張り出してしまう
for ia = 1 to nAsa
	za = asa[ia]
	! 板（外側へ張り出し、先端が上がる）
	add 0, -rowW, za
	muly -1
	rotx asagaoAngle
	block lineLen, asagaoProj, 0.02
	del 3
	! 受けブラケット（支柱位置ごと）
	x = 0
	for ip = 1 to nSpan + 1
		add x, -rowW, za
		muly -1
		rotx asagaoAngle - 90
		cylind asagaoProj, 0.0213 / 2
		del 3
		if ip <= nSpan then x = x + spans[ip]
	next ip
next ia

! ---- 壁つなぎ（内側建地から躯体側へ +Y 方向） ----
! 構造計算でも法規チェックでも見ているのに3Dに無く、躯体との
! 取り合いが確認できなかった
for it = 1 to nTiePair
	add ties[it], 0, tieH[it]
	rotx -90
	cylind standoff, r_tie
	del 2
next it

! ---- 荷受けステージ（外側へ張り出す床・手すり） ----
for ig = 1 to nSg
	add sgS[ig], -rowW, sgH[ig]
	muly -1
	block sgL[ig], sgP[ig], 0.05
	del 2
	! 手すり（張り出し先端と両側）
	add sgS[ig], -rowW - sgP[ig], sgH[ig] + 0.9
	roty 90
	cylind sgL[ig], r_nuno
	del 2
next ig

! ---- ブラケット区間（拡幅ぶんの作業床） ----
for ik = 1 to nBk
	if bkD[ik] > 0 then
		add bkS[ik], 0, bkH[ik]
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 1
	else
		add bkS[ik], -rowW, bkH[ik]
		muly -1
		block bkE[ik] - bkS[ik], bkW[ik], 0.045
		del 2
	endif
next ik

end
