! ============================================================
! 足場ライン マスタースクリプト（くさび緊結式・1辺=1オブジェクト）
! 配置規約: 原点=始点コーナー支柱（内側建地列）、+X=辺方向、+Y=躯体側
! 2D表現は viewMode で切替: plan=平面 / elev=立面
!
! 文字列リストのパースは gosub にせずインラインで展開している。
! マスタースクリプトでの gosub は動作しない環境があり、失敗すると
! 2D/3Dとも一切描画されない（実機で確認済み）。
! ============================================================
dim spans[30]
dim posts[20]
dim ties[80]
dim tieH[80]
dim fls[20]
dim lv[42]
dim levIn[40]
dim asa[8]
dim stS[8]
dim stL[8]
dim bmS[8]
dim bmL[8]
dim bmH[8]
dim sgS[8]
dim sgL[8]
dim sgP[8]
dim sgH[8]
dim bkS[24]
dim bkE[24]
dim bkW[24]
dim bkD[24]
dim bkH[24]
dim bkDW[24]

! ---- spanList をパース (mm→m) ----
nSpan = 0
rest = spanList
while strlen(rest) > 0 and nSpan < 30 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSpan = nSpan + 1
		spans[nSpan] = v / 1000
	endif
endwhile
if nSpan = 0 then
	nSpan = 1
	spans[1] = 1.8
endif

! ---- postList をパース (mm→m) ----
nPost = 0
rest = postList
while strlen(rest) > 0 and nPost < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPost = nPost + 1
		posts[nPost] = v / 1000
	endif
endwhile
if nPost = 0 then
	nPost = 1
	posts[1] = 3.6
endif

! ---- tieList をパース (mm→m) ----
nTie = 0
rest = tieList
while strlen(rest) > 0 and nTie < 80 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTie = nTie + 1
		ties[nTie] = v / 1000
	endif
endwhile

! ---- tieHeightList をパース (mm→m) ----
nTieH = 0
rest = tieHeightList
while strlen(rest) > 0 and nTieH < 80 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTieH = nTieH + 1
		tieH[nTieH] = v / 1000
	endif
endwhile

! ---- flList をパース (mm→m) ----
nFL = 0
rest = flList
while strlen(rest) > 0 and nFL < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nFL = nFL + 1
		fls[nFL] = v / 1000
	endif
endwhile

! ---- levelList をパース (mm→m) ----
! 作業床の高さはPython側の立面ソルバが決めた値をそのまま受け取る。
! GDLで komaPitch から再計算すると、コマの概念が無い枠組（komaPitch=0）で
! 破綻するうえ、ソルバの結果と図面がずれる。
nLevIn = 0
rest = levelList
while strlen(rest) > 0 and nLevIn < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nLevIn = nLevIn + 1
		levIn[nLevIn] = v / 1000
	endif
endwhile

! ---- brktList をパース「開始,終了,幅,向き,高さ」の繰り返し (mm→m) ----
! ブラケット区間は作業床の幅を局所的に変える。図面に出ないと、
! 実際より狭い（または広い）床を描いたままになる
nBk = 0
bkIdx = 0
bkA = 0
bkB = 0
bkC = 0
bkE0 = 0
bkF = 0
rest = brktList
while strlen(rest) > 0 and nBk < 24 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		bkIdx = bkIdx + 1
		md = bkIdx - 6 * int(bkIdx / 6)   ! 1,2,3,4,5,0 の繰り返し
		if md = 1 then bkA = v / 1000
		if md = 2 then bkB = v / 1000
		if md = 3 then bkC = v / 1000
		if md = 4 then bkE0 = v
		if md = 5 then bkF = v / 1000
		if md = 0 then
			nBk = nBk + 1
			bkS[nBk] = bkA
			bkE[nBk] = bkB
			bkW[nBk] = bkC
			bkD[nBk] = bkE0
			bkH[nBk] = bkF
			bkDW[nBk] = v / 1000        ! 区間の床幅（0で変更なし）
		endif
	endif
endwhile

! ---- stageList をパース「開始,長さ,出,設置高さ」の繰り返し (mm→m) ----
! 荷受けステージは出1.5mの張り出し床。構造計算では直下の建地を個別に
! 検定しているのに、図面にも3Dにも出ていなかった
nSg = 0
sgIdx = 0
sgA = 0
sgB = 0
sgC = 0
rest = stageList
while strlen(rest) > 0 and nSg < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		sgIdx = sgIdx + 1
		md = sgIdx - 4 * int(sgIdx / 4)   ! 1,2,3,0 の繰り返し
		if md = 1 then sgA = v / 1000
		if md = 2 then sgB = v / 1000
		if md = 3 then sgC = v / 1000
		if md = 0 then
			nSg = nSg + 1
			sgS[nSg] = sgA
			sgL[nSg] = sgB
			sgP[nSg] = sgC
			sgH[nSg] = v / 1000
		endif
	endif
endwhile

! ---- beamList をパース「開始,スパン,梁下高さ」の繰り返し (mm→m) ----
! 梁枠は支柱を抜いて通路にする箇所。図面が抜いた支柱を描いたままだと、
! 実際には無い建地を図面が示すことになる
nBm = 0
bmIdx = 0
bmT1 = 0
bmT2 = 0
rest = beamList
while strlen(rest) > 0 and nBm < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		bmIdx = bmIdx + 1
		md = bmIdx - 3 * int(bmIdx / 3)   ! 1,2,0 の繰り返し
		if md = 1 then
			bmT1 = v / 1000
		endif
		if md = 2 then
			bmT2 = v / 1000
		endif
		if md = 0 then
			nBm = nBm + 1
			bmS[nBm] = bmT1
			bmL[nBm] = bmT2
			bmH[nBm] = v / 1000
		endif
	endif
endwhile

! ---- stairList をパース「開始,長さ」の繰り返し (mm→m) ----
! 階段室は数量（踏板の差引）にも帳票にも出るのに、図面に位置が
! 出ていなかった。昇降設備の位置は計画図の主要情報
nSt = 0
stTmp = 0
stIdx = 0
rest = stairList
while strlen(rest) > 0 and nSt < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		stIdx = stIdx + 1
		if stIdx - 2 * int(stIdx / 2) = 1 then
			stTmp = v / 1000
		else
			nSt = nSt + 1
			stS[nSt] = stTmp
			stL[nSt] = v / 1000
		endif
	endif
endwhile

! ---- asagaoList をパース (mm→m) ----
! 朝顔は数量にも法規チェックにも出るのに、図面にも3Dにも現れていなかった。
! 突出2mの部材なので、干渉確認のためにモデルへ出す
nAsa = 0
rest = asagaoList
while strlen(rest) > 0 and nAsa < 8 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nAsa = nAsa + 1
		asa[nAsa] = v / 1000
	endif
endwhile

! ---- 派生値 ----
lineLen = 0
for i = 1 to nSpan
	lineLen = lineLen + spans[i]
next i
postTop = jackOut
for i = 1 to nPost
	postTop = postTop + posts[i]
next i
! 根がらみ高さ。negaH が渡されていればそれを使う（枠組は建枠脚部が相当）
firstLedger = negaH
if firstLedger <= 0 then firstLedger = jackOut + komaPitch

! レベル列: lv[1]=根がらみ、lv[2..nLv]=作業床（下から昇順）
lv[1] = firstLedger
if nLevIn > 0 then
	! Python側の立面ソルバが決めた作業床高さをそのまま使う
	nLevels = nLevIn
	for il = 1 to nLevels
		lv[il + 1] = levIn[il]
	next il
	topFloor = levIn[nLevels]
else
	! 単体で置いた場合のフォールバック（くさび式の積み方から推定）
	topFloor = postTop - 2 * komaPitch
	nLevels = 0
	h = topFloor
	while h > firstLedger + komaPitch do
		nLevels = nLevels + 1
		h = h - floorH
	endwhile
	for il = 1 to nLevels
		lv[il + 1] = topFloor - (nLevels - il) * floorH
	next il
endif
nLv = nLevels + 1

! 手すり・中桟の高さ（作業床から）。komaPitch の倍数で決め打ちすると
! コマの概念が無い枠組で 0 になり、手すりが作業床に重なって消える
railTop = railH
if railTop <= 0 then railTop = 2 * komaPitch
railMid = midH
if railMid <= 0 then railMid = komaPitch

! 壁つなぎは位置と高さの対。短い方に合わせる
nTiePair = nTie
if nTieH < nTiePair then nTiePair = nTieH

! 斜材の設置間隔。数量は「6層6スパン以下毎に交さ2方向」で拾っているので、
! 図面を全構面に描くと部材表と食い違う（発注40本に対し図面896本）
bEvS = braceEveryS
if bEvS < 1 then bEvS = 1
bEvL = braceEveryL
if bEvL < 1 then bEvL = 1

! 建地列。一側足場は1列で、建地は外側1列だけ立ち、床は躯体側へ張り出す。
! 列数を見ないと、一側足場の計画でも図面は本足場（2列）で描かれる
rowStart = 0
if nRows < 2 then rowStart = 1

r_sic  = 0.0486 / 2	! 支柱 φ48.6
r_nuno = 0.0427 / 2	! 布材 φ42.7
r_tie  = 0.0273 / 2	! 壁つなぎ φ27.2

! ---- 注記のレイアウト用（文字高は縮尺依存なので実寸を求めて行送りに使う）----
! GLOB_SCALE = 縮尺の分母（1/20なら20）。texSiz は用紙上のmm
txtH = texSiz * GLOB_SCALE / 1000
txtLine = txtH * 1.8
