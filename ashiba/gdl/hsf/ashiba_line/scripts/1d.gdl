! ============================================================
! 足場ライン マスタースクリプト（くさび緊結式・1辺=1オブジェクト）
! 配置規約: 原点=始点コーナー支柱（内側建地列）、+X=辺方向、+Y=躯体側
! 2D表現は viewMode で切替: plan=平面 / elev=立面
!
! 文字列リストのパースは gosub にせずインラインで展開している。
! マスタースクリプトでの gosub は動作しない環境があり、失敗すると
! 2D/3Dとも一切描画されない（実機で確認済み）。
! ============================================================
dim spans[30]
dim posts[20]
dim ties[80]
dim tieH[80]
dim fls[20]
dim lv[42]
dim levIn[40]

! ---- spanList をパース (mm→m) ----
nSpan = 0
rest = spanList
while strlen(rest) > 0 and nSpan < 30 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSpan = nSpan + 1
		spans[nSpan] = v / 1000
	endif
endwhile
if nSpan = 0 then
	nSpan = 1
	spans[1] = 1.8
endif

! ---- postList をパース (mm→m) ----
nPost = 0
rest = postList
while strlen(rest) > 0 and nPost < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPost = nPost + 1
		posts[nPost] = v / 1000
	endif
endwhile
if nPost = 0 then
	nPost = 1
	posts[1] = 3.6
endif

! ---- tieList をパース (mm→m) ----
nTie = 0
rest = tieList
while strlen(rest) > 0 and nTie < 80 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTie = nTie + 1
		ties[nTie] = v / 1000
	endif
endwhile

! ---- tieHeightList をパース (mm→m) ----
nTieH = 0
rest = tieHeightList
while strlen(rest) > 0 and nTieH < 80 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nTieH = nTieH + 1
		tieH[nTieH] = v / 1000
	endif
endwhile

! ---- flList をパース (mm→m) ----
nFL = 0
rest = flList
while strlen(rest) > 0 and nFL < 20 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nFL = nFL + 1
		fls[nFL] = v / 1000
	endif
endwhile

! ---- levelList をパース (mm→m) ----
! 作業床の高さはPython側の立面ソルバが決めた値をそのまま受け取る。
! GDLで komaPitch から再計算すると、コマの概念が無い枠組（komaPitch=0）で
! 破綻するうえ、ソルバの結果と図面がずれる。
nLevIn = 0
rest = levelList
while strlen(rest) > 0 and nLevIn < 40 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nLevIn = nLevIn + 1
		levIn[nLevIn] = v / 1000
	endif
endwhile

! ---- 派生値 ----
lineLen = 0
for i = 1 to nSpan
	lineLen = lineLen + spans[i]
next i
postTop = jackOut
for i = 1 to nPost
	postTop = postTop + posts[i]
next i
! 根がらみ高さ。negaH が渡されていればそれを使う（枠組は建枠脚部が相当）
firstLedger = negaH
if firstLedger <= 0 then firstLedger = jackOut + komaPitch

! レベル列: lv[1]=根がらみ、lv[2..nLv]=作業床（下から昇順）
lv[1] = firstLedger
if nLevIn > 0 then
	! Python側の立面ソルバが決めた作業床高さをそのまま使う
	nLevels = nLevIn
	for il = 1 to nLevels
		lv[il + 1] = levIn[il]
	next il
	topFloor = levIn[nLevels]
else
	! 単体で置いた場合のフォールバック（くさび式の積み方から推定）
	topFloor = postTop - 2 * komaPitch
	nLevels = 0
	h = topFloor
	while h > firstLedger + komaPitch do
		nLevels = nLevels + 1
		h = h - floorH
	endwhile
	for il = 1 to nLevels
		lv[il + 1] = topFloor - (nLevels - il) * floorH
	next il
endif
nLv = nLevels + 1

! 手すり・中桟の高さ（作業床から）。komaPitch の倍数で決め打ちすると
! コマの概念が無い枠組で 0 になり、手すりが作業床に重なって消える
railTop = railH
if railTop <= 0 then railTop = 2 * komaPitch
railMid = midH
if railMid <= 0 then railMid = komaPitch

! 壁つなぎは位置と高さの対。短い方に合わせる
nTiePair = nTie
if nTieH < nTiePair then nTiePair = nTieH

! 建地列。一側足場は1列で、建地は外側1列だけ立ち、床は躯体側へ張り出す。
! 列数を見ないと、一側足場の計画でも図面は本足場（2列）で描かれる
rowStart = 0
if nRows < 2 then rowStart = 1

r_sic  = 0.0486 / 2	! 支柱 φ48.6
r_nuno = 0.0427 / 2	! 布材 φ42.7

! ---- 注記のレイアウト用（文字高は縮尺依存なので実寸を求めて行送りに使う）----
! GLOB_SCALE = 縮尺の分母（1/20なら20）。texSiz は用紙上のmm
txtH = texSiz * GLOB_SCALE / 1000
txtLine = txtH * 1.8
