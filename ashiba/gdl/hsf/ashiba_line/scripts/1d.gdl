! ============================================================
! 足場ライン マスタースクリプト（くさび緊結式・1辺=1オブジェクト）
! 配置規約: 原点=始点コーナー支柱（内側建地列）、+X=辺方向、+Y=躯体側
!           外側建地列は y=-rowW、躯体面は y=+standoff
! ============================================================
dim spans[30]
dim posts[20]
dim lv[42]

! ---- spanList をパース (mm→m) ----
nSpan = 0
rest = spanList
while strlen(rest) > 0 and nSpan < 30 do
	p = strstr(rest, ",")
	if p > 0 then
		item = strsub(rest, 1, p - 1)
		rest = strsub(rest, p + 1, strlen(rest) - p)
	else
		item = rest
		rest = ""
	endif
	nSpan = nSpan + 1
	k = split(item, "%n", v)
	spans[nSpan] = v / 1000
endwhile
if nSpan = 0 then
	nSpan = 1
	spans[1] = 1.8
endif

! ---- postList をパース (mm→m) ----
nPost = 0
rest = postList
while strlen(rest) > 0 and nPost < 20 do
	p = strstr(rest, ",")
	if p > 0 then
		item = strsub(rest, 1, p - 1)
		rest = strsub(rest, p + 1, strlen(rest) - p)
	else
		item = rest
		rest = ""
	endif
	nPost = nPost + 1
	k = split(item, "%n", v)
	posts[nPost] = v / 1000
endwhile
if nPost = 0 then
	nPost = 1
	posts[1] = 3.6
endif

! ---- 派生値 ----
lineLen = 0
for i = 1 to nSpan
	lineLen = lineLen + spans[i]
next i
postTop = jackOut
for i = 1 to nPost
	postTop = postTop + posts[i]
next i
firstLedger = jackOut + komaPitch
topFloor = postTop - 2 * komaPitch

! 作業層数
nLevels = 0
h = topFloor
while h > firstLedger + komaPitch do
	nLevels = nLevels + 1
	h = h - floorH
endwhile

! レベル列: lv[1]=根がらみ、lv[2..nLv]=作業床（下から昇順）
lv[1] = firstLedger
for il = 1 to nLevels
	lv[il + 1] = topFloor - (nLevels - il) * floorH
next il
nLv = nLevels + 1

r_sic  = 0.0486 / 2	! 支柱 φ48.6
r_nuno = 0.0427 / 2	! 布材 φ42.7
