! 場内通路: 文字のパラメータ（mm・度）を配列に読む
dim qcx[]
kC = 0
rest = cX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		kC = kC + 1
		qcx[kC] = v / 1000
	endif
endwhile
