dim jtR[]
nJr = 0
rest = jrR
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nJr = nJr + 1
		jtR[nJr] = v / 1000
	endif
endwhile
dim jtT[]
nJt = 0
rest = jrT
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nJt = nJt + 1
		jtT[nJt] = v / 1
	endif
endwhile
! クローラクレーンのブームの先・ジブの先・フック・定格総荷重（表の読み方は src/ashiba/machine.py の crane_rating と同じ）
if mcKind = 2 and lbGnd then
	lbA = -atn((pvH - 0.3) / lbL)
	hkD = 0.9
endif
lbX = pvX + lbL * cos(lbA)
lbZ = pvH + lbL * sin(lbA)
jbW = min(lbW, 1.0) * 0.7
jbX = lbX
jbZ = lbZ
if jbL > 0.01 then
	jbX = lbX + jbL * cos(lbA - jbO)
	jbZ = lbZ + jbL * sin(lbA - jbO)
endif
hkX = jbX + 0.4
tpZ = jbZ
rated = 0
rMin = 0
rMax = 0
if mcKind = 2 then
	iR = 0
	if jbL > 0.01 then
		rMin = jrN
		rMax = jrX
		for k = min(nJr, nJt) to 1 step -1
			if jtR[k] >= hkX - 0.001 then iR = k
		next k
		if iR > 0 then rated = jtT[iR] / 100
	else
		jB = nMb
		for k = nMb to 1 step -1
			if mtB[k] >= lbL - 0.001 then jB = k
		next k
		if jB > 0 and jB <= nMn and jB <= nMx then
			rMin = mtN[jB]
			rMax = mtX[jB]
		endif
		for k = nMr to 1 step -1
			if mtR[k] >= hkX - 0.001 then iR = k
		next k
		if iR > 0 then
			if jB = 1 and iR <= nC1 then rated = mtC1[iR] / 100
			if jB = 2 and iR <= nC2 then rated = mtC2[iR] / 100
			if jB = 3 and iR <= nC3 then rated = mtC3[iR] / 100
			if jB = 4 and iR <= nC4 then rated = mtC4[iR] / 100
			if jB = 5 and iR <= nC5 then rated = mtC5[iR] / 100
		endif
	endif
	if hkX < rMin - 0.001 or hkX > rMax + 0.001 then rated = 0
endif
capT = rated * sfRate
! 作業半径の表示（scripts/gdl_radii.py）
nWi = max(0, min(5, wiNum)) * (mcKind = 2)
dim wiRq[5], wiAq[5], wiBq[5], wiSq[5], wiMq[5], wiFq[5], wiTq[5]
wiRq[1] = wiR1
wiAq[1] = wiA1
wiBq[1] = wiB1
wiFq[1] = wiF1
wiRq[2] = wiR2
wiAq[2] = wiA2
wiBq[2] = wiB2
wiFq[2] = wiF2
wiRq[3] = wiR3
wiAq[3] = wiA3
wiBq[3] = wiB3
wiFq[3] = wiF3
wiRq[4] = wiR4
wiAq[4] = wiA4
wiBq[4] = wiB4
wiFq[4] = wiF4
wiRq[5] = wiR5
wiAq[5] = wiA5
wiBq[5] = wiB5
wiFq[5] = wiF5
for wq = 1 to 5
	wS0 = wiBq[wq] - wiAq[wq] + 720
	wS0 = wS0 - int(wS0 / 360) * 360
	if wS0 < 0.01 then wS0 = 360
	wiSq[wq] = wS0
	wiMq[wq] = wiAq[wq] + wS0 / 2
next wq
for wq = 1 to nWi
	vq = 0
	iQ = 0
	if jbL > 0.01 then
		for k = min(nJr, nJt) to 1 step -1
			if jtR[k] >= wiRq[wq] - 0.001 then iQ = k
		next k
		if iQ > 0 then vq = jtT[iQ] / 100
	else
		for k = nMr to 1 step -1
			if mtR[k] >= wiRq[wq] - 0.001 then iQ = k
		next k
		if iQ > 0 then
			if jB = 1 and iQ <= nC1 then vq = mtC1[iQ] / 100
			if jB = 2 and iQ <= nC2 then vq = mtC2[iQ] / 100
			if jB = 3 and iQ <= nC3 then vq = mtC3[iQ] / 100
			if jB = 4 and iQ <= nC4 then vq = mtC4[iQ] / 100
			if jB = 5 and iQ <= nC5 then vq = mtC5[iQ] / 100
		endif
	endif
	if wiRq[wq] < rMin - 0.001 or wiRq[wq] > rMax + 0.001 then vq = 0
	vq = vq * sfRate
	wiTq[wq] = vq
next wq
! アースドリルのテレスコブームの先
tbX = pvX + tbL * cos(tbA)
tbZ = pvH + tbL * sin(tbA)
! 解体機のフロント（3段の関節とアームの先）
dmX1 = pvX + dbL1 * cos(dA1)
dmZ1 = pvH + dbL1 * sin(dA1)
dmX2 = dmX1 + dbL2 * cos(dA2)
dmZ2 = dmZ1 + dbL2 * sin(dA2)
dmX3 = dmX2 + dbL3 * cos(dA3)
dmZ3 = dmZ2 + dbL3 * sin(dA3)
! 先の長さ（バケットかアタッチメント）
tpL = bkL
if atK > 0 then tpL = atL
! 杭打機のオーガ（本数と1本めの y）
nAu = max(1, min(3, auN))
yAu0 = -(nAu - 1) * auP / 2
! 搬入トラック・トレーラー: 後ろの軸群の中心・キングピン・クレーンの先・荷台の先
xAxR = axR1 - rearSp * (nRear >= 2) / 2
kpX = xAxR + kpC
ucTx = ucL * cos(abA)
ucTz = ucH + ucL * sin(abA)
nFa = max(1, min(2, nFr))
! 全周回転機のデッキの高さ（本体の高さから手すり 0.969 下）
zDk = max(0.5, rtH - 0.969)
