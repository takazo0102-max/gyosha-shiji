! ============================================================
! 屋上への渡り 3D: 足場の最上段の床から屋上へ。床は折れ点（pY・pZ。マスタスクリプト）のあいだを区間の形（pK）で:
! 0 平らな踏板（足場板 t40）、1 斜路、2 斜路＋踏桟（30cm ごと）、3 踏段（けあげ 200 以下・ささら桁）。
! 高低差は躯体の外面の手前か屋上の上で取り、段・側桁は屋上のスラブに食い込まない（Python の roof_bridges.bridge_profile。
! 安衛則552条: 勾配 30°以下、15°を超えるものは踏桟）。パラペットがあれば天端の上を越える。
! 両側に手すり（H950）・中桟（H450）・幅木（H150）と支柱。利用者の指摘 2026-10-26: 屋上の渡りが適当
! 原点＝足場の内側建地列（y=0）、+X＝面に沿う方向、+Y＝躯体側
! ============================================================
pen penEquip
resol 8
rotz faceAng
if matDeck > 0 then material matDeck
! ---- 床 ----
for ip = 1 to nP - 1
	y1 = pY[ip]
	z1 = pZ[ip]
	y2 = pY[ip + 1]
	z2 = pZ[ip + 1]
	if y2 > y1 + 0.01 then
		if pK[ip] = 3 then
			! 踏段: けあげ 200 以下で nS 段、踏面は (nS-1) 枚。上りも下りも y1 の側から並べ、最後の段で z2 に着く
			nS = int(abs(z2 - z1) / 0.20 - 0.001) + 1
			if nS < 2 then nS = 2
			tL = (y2 - y1) / (nS - 1)
			zLo = min(z1, z2)
			for iS2 = 1 to nS - 1
				zs = z1 + (z2 - z1) * iS2 / nS
				ya = y1 + (iS2 - 1) * tL
				add 0.025, ya, zs - 0.04
				block brW - 0.05, tL, 0.04
				del 1
				! ささら桁（両側。踏面の下から低い方の床まで。屋上・足場の床より下には出さない）
				zb = max(zLo, zs - 0.25)
				for sd = 0 to 1
					add sd * (brW - 0.012), ya, zb
					block 0.012, tL, zs - zb
					del 1
				next sd
			next iS2
		else
			ag = atn((z2 - z1) / (y2 - y1))
			add 0.025, y1, z1
			rotx ag
			addz -0.04
			block brW - 0.05, sqr((y2 - y1) ^ 2 + (z2 - z1) ^ 2), 0.04
			del 3
			if pK[ip] = 2 then
				! 踏桟（30cm ごと）
				yc = y1 + 0.15
				while yc < y2 - 0.1 do
					add 0.04, yc, z1 + (z2 - z1) * (yc - y1) / (y2 - y1)
					block brW - 0.08, 0.025, 0.02
					del 1
					yc = yc + 0.30
				endwhile
			endif
		endif
	endif
next ip
! ---- 手すり・中桟・幅木（両側。床の折れ点に沿って）と支柱（折れ点ごと、長い区間は 1.8 以下ごと） ----
for sd = 0 to 1
	xr = sd * brW
	for ip = 1 to nP
		add xr, pY[ip], pZ[ip]
		cylind 0.95, 0.0243
		del 1
	next ip
	for ip = 1 to nP - 1
		dy = pY[ip + 1] - pY[ip]
		dz = pZ[ip + 1] - pZ[ip]
		if dy > 0.01 then
			nM = int(dy / 1.8 - 0.001)
			for im = 1 to nM
				add xr, pY[ip] + dy * im / (nM + 1), pZ[ip] + dz * im / (nM + 1)
				cylind 0.95, 0.0243
				del 1
			next im
			ag = atn(dz / dy)
			for hk = 1 to 2
				hh = 0.95
				if hk = 2 then hh = 0.45
				add xr, pY[ip], pZ[ip] + hh
				rotx -(90 - ag)
				cylind sqr(dy * dy + dz * dz), 0.0243
				del 2
			next hk
			add xr - 0.006, pY[ip], pZ[ip]
			rotx ag
			block 0.012, sqr(dy * dy + dz * dz), 0.15
			del 2
		endif
	next ip
next sd
del top
