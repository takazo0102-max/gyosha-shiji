! 乗入れ構台: ホットスポットで引いた広さを切り上げ、自動の支柱の列・行と水平つなぎの段を書き込む。
! 支柱・水平つなぎのホットスポットを動かすと（GLOB_MODPAR_NAME）自動を外し、動かした位置のままにする
if abs(lenX - lx) > 0.0005 then parameters lenX = lx
if abs(lenY - ly) > 0.0005 then parameters lenY = ly
mp = GLOB_MODPAR_NAME
gA = gAuto
if strstr(mp, "gX") = 1 or strstr(mp, "gY") = 1 or mp = "nGX" or mp = "nGY" then
	gA = 0
	parameters gAuto = 0
endif
if gA then
	parameters nGX = nAX, nGY = nAY
	parameters gX1 = axp[1], gX2 = axp[2], gX3 = axp[3], gX4 = axp[4], gX5 = axp[5], gX6 = axp[6], gX7 = axp[7], gX8 = axp[8], gX9 = axp[9], gX10 = axp[10], gX11 = axp[11], gX12 = axp[12], gX13 = axp[13], gX14 = axp[14], gX15 = axp[15], gX16 = axp[16]
	parameters gY1 = ayp[1], gY2 = ayp[2], gY3 = ayp[3], gY4 = ayp[4], gY5 = ayp[5], gY6 = ayp[6], gY7 = ayp[7], gY8 = ayp[8]
endif
lA = lAuto
if strstr(mp, "lvD") = 1 or mp = "nLvP" then
	lA = 0
	parameters lAuto = 0
endif
if lA then
	parameters nLvP = nAL
	parameters lvD1 = alp[1], lvD2 = alp[2], lvD3 = alp[3], lvD4 = alp[4], lvD5 = alp[5], lvD6 = alp[6], lvD7 = alp[7], lvD8 = alp[8]
endif
values{2} "dk3" -1, "自動（幅が奇数 m なら 3m を1列）", 0, "2m だけ", 1, "3m を1列", 2, "3m を2列"
values "dk3At" range [1, 20]
values{2} "secJ" 1, "H-200×200", 2, "H-250×250", 3, "H-300×300", 4, "H-350×350", 5, "H-400×400", 6, "H-414×405", 7, "H-428×407", 8, "H-488×300", 9, "H-588×300", 10, "H-594×302"
values{2} "secG" 1, "H-200×200", 2, "H-250×250", 3, "H-300×300", 4, "H-350×350", 5, "H-400×400", 6, "H-414×405", 7, "H-428×407", 8, "H-488×300", 9, "H-588×300", 10, "H-594×302"
values{2} "secP" 1, "H-200×200", 2, "H-250×250", 3, "H-300×300", 4, "H-350×350", 5, "H-400×400", 6, "H-414×405", 7, "H-428×407", 8, "H-488×300", 9, "H-588×300", 10, "H-594×302"
values "nGX" range [2, 16]
values "nGY" range [2, 8]
values "nLvP" range [1, 8]
values "kdVeh" "T25", "R20", "R25", "R40", "R65", "C50"
values "spMax" range [1.0, 12.0]
values "slopeN" 0, range [6, 20]
