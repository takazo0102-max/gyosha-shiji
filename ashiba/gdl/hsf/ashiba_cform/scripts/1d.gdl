! 柱の型枠: 桟木・外端太・フォームタイの位置を読む（m）
dim sx[]
nSx = 0
rest = sgX
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSx = nSx + 1
		sx[nSx] = v / 1000
	endif
endwhile
