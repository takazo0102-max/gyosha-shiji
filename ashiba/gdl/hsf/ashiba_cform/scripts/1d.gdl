! 柱の型枠: 桟木・外端太・フォームタイの位置を読む（m）
dim pl1[]
nPl1 = 0
rest = ply1
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPl1 = nPl1 + 1
		pl1[nPl1] = v / 1000
	endif
endwhile
