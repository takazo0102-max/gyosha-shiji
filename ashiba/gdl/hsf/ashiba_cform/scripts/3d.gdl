! ============================================================
! 柱の型枠 3D（利用者の指定 2026-10-31: さんぎ そとばた フォームタイ）
! ============================================================
resol 12
define material "cf_ply" 2, 0.86, 0.66, 0.38
define material "cf_wood" 2, 0.74, 0.56, 0.36
define material "cf_steel" 2, 0.62, 0.62, 0.66
define material "cf_tie" 2, 0.35, 0.35, 0.38
define material "cf_pcon" 2, 0.85, 0.85, 0.80
H = ZZYZX
gap = 0.006
! ---- せき板 ----
material "cf_ply"
add -hA - plyT, hB, 0
block A + 2 * plyT, plyT, H
del 1
add -hA - plyT, -hB - plyT, 0
block A + 2 * plyT, plyT, H
del 1
add hA, -hB, 0
block plyT, B, H
del 1
add -hA - plyT, -hB, 0
block plyT, B, H
del 1
! ---- 桟木 ----
material "cf_wood"
for i = 1 to nSx
	add sx[i] - sgB / 2, hB + plyT, 0
	block sgB, sgH, H
	del 1
	add sx[i] - sgB / 2, -hB - plyT - sgH, 0
	block sgB, sgH, H
	del 1
next i
for i = 1 to nSy
	add hA + plyT, sy[i] - sgB / 2, 0
	block sgH, sgB, H
	del 1
	add -hA - plyT - sgH, sy[i] - sgB / 2, 0
	block sgH, sgB, H
	del 1
next i
! ---- 外端太（2本組） ----
material "cf_steel"
Lx = tx[nX] - tx[1] + 2 * tbOver
Ly = ty[nY] - ty[1] + 2 * tbOver
for j = 1 to nT
	for k = -1 to 1 step 2
		for sd = -1 to 1 step 2
			add tx[1] - tbOver, sd * yT, tz[j] + k * (r + gap)
			roty 90
			cylind Lx, r
			del 2
			add sd * xT, ty[1] - tbOver, tz[j] + dzB + k * (r + gap)
			rotx -90
			cylind Ly, r
			del 2
		next sd
	next k
next j
! ---- フォームタイ ----
for j = 1 to nT
	! Y の向き（±Y の面の外端太を締める）
	for i = 1 to nX
		add tx[i], 0, tz[j]
		material "cf_tie"
		add 0, -yT - r - 0.05, 0
		rotx -90
		cylind 2 * (yT + r + 0.05), 0.00395
		del 2
		for sd = -1 to 1 step 2
			add -0.035, sd * (yT + r) + (sd - 1) / 2 * 0.006, -(2 * r + gap)
			block 0.07, 0.006, 2 * (2 * r + gap)
			del 1
		next sd
		if i > 1 and i < nX then
			material "cf_pcon"
			add 0, -hB, 0
			rotx -90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
			add 0, hB, 0
			rotx 90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
		endif
		del 1
	next i
	! X の向き（±X の面の外端太を締める）
	for i = 1 to nY
		add 0, ty[i], tz[j] + dzB
		material "cf_tie"
		add -xT - r - 0.05, 0, 0
		roty 90
		cylind 2 * (xT + r + 0.05), 0.00395
		del 2
		for sd = -1 to 1 step 2
			add sd * (xT + r) + (sd - 1) / 2 * 0.006, -0.035, -(2 * r + gap)
			block 0.006, 0.07, 2 * (2 * r + gap)
			del 1
		next sd
		if i > 1 and i < nY then
			material "cf_pcon"
			add -hA, 0, 0
			roty 90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
			add hA, 0, 0
			roty -90
			cone 0.025, 0.012, 0.0175, 90, 90
			del 2
		endif
		del 1
	next i
next j
