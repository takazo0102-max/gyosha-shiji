! ============================================================
! 内部ステージ足場 3D: 支柱の格子・根がらみと各段の布材（両方向）・最上段の全面の作業床・外周の手すり・中桟・幅木・
! 外周の構面の筋かい（5スパンごと）・はしご。原点＝外周の支柱の始めの角、+X＝長手、+Y＝短手
! ============================================================
pen penPost
resol 8
rotz faceAng
if matScaf > 0 then material matScaf
! リストを読む（mm→m）
dim su[], sv[], lv[]
nU = 0
s = spanU
while strlen(s) > 0 and nU < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nU = nU + 1
		su[nU] = v / 1000
	endif
endwhile
nV = 0
s = spanV
while strlen(s) > 0 and nV < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nV = nV + 1
		sv[nV] = v / 1000
	endif
endwhile
nL = 0
s = lvList
while strlen(s) > 0 and nL < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nL = nL + 1
		lv[nL] = v / 1000
	endif
endwhile
! ほかの段の作業床（EVシャフトの各階など。利用者の指定 2026-10-28: 内部足場はステージとEV部分）
dim dk[]
nD = 0
s = deckList
while strlen(s) > 0 and nD < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nD = nD + 1
		dk[nD] = v / 1000
	endif
endwhile
nD = nD + 1
dk[nD] = deckH
dim xu[], yv[]
xu[1] = 0
for i = 1 to nU
	xu[i + 1] = xu[i] + su[i]
next i
yv[1] = 0
for j = 1 to nV
	yv[j + 1] = yv[j] + sv[j]
next j
stLU = xu[nU + 1]
stLV = yv[nV + 1]
! 階段の上（利用者の指定 2026-10-28: 内部足場は階段でよく使う）: 支柱の列ごとの足元の高さ。fu[i]＋fv[j] が支柱 (i, j) の足元
dim fu[], fv[]
for i = 1 to nU + 1
	fu[i] = 0
next i
for j = 1 to nV + 1
	fv[j] = 0
next j
nF = 0
s = footZ
while strlen(s) > 0 and nF < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nF = nF + 1
		if footAxis = 0 and nF <= nU + 1 then fu[nF] = v / 1000
		if footAxis = 1 and nF <= nV + 1 then fv[nF] = v / 1000
	endif
endwhile
! 列ごとの根がらみ（段の上の支柱の最初のコマ。0＝共通）
dim fn[]
for i = 1 to 60
	fn[i] = 0
next i
nN = 0
s = footNeg
while strlen(s) > 0 and nN < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nN = nN + 1
		fn[nN] = v / 1000
	endif
endwhile
rP = 0.0243
topZ = deckH + 0.95
if postTop > 0 then topZ = postTop
if lineMode then
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			lin_ xu[i], yv[j], zBase + fu[i] + fv[j], xu[i], yv[j], topZ
		next j
	next i
else
	! 支柱とジャッキ
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			zf = zBase + fu[i] + fv[j]
			add xu[i], yv[j], zf
			cylind topZ - zf, rP
			del 1
			add xu[i] - 0.07, yv[j] - 0.07, zf - 0.01
			block 0.14, 0.14, 0.01
			del 1
		next j
	next i
	! 根がらみと各段の布材（両方向）
	! スパンごとに描き、両端の支柱の足元より下の布材は描かない（階段の上は段ごとに根がらみが上がる）
	for il = 1 to nL
		z = lv[il]
		for j = 1 to nV + 1
			for i = 1 to nU
				if z > zBase + max(fu[i], fu[i + 1]) + fv[j] + 0.05 then
					add xu[i], yv[j], z
					roty 90
					cylind su[i], 0.0214
					del 2
				endif
			next i
		next j
		for i = 1 to nU + 1
			for j = 1 to nV
				if z > zBase + fu[i] + max(fv[j], fv[j + 1]) + 0.05 then
					add xu[i], yv[j], z
					rotx -90
					cylind sv[j], 0.0214
					del 2
				endif
			next j
		next i
	next il
	! 支保工の頂部（利用者の指定 2026-10-28: 型枠支保工で使う）: 支柱の天端に大引受けジャッキ（ねじ棒＋U字の受け）、
	! 長手の支柱の列ごとに大引（端太角 100 角）
	if postTop > 0 and uheadExt > 0 then
		for i = 1 to nU + 1
			for j = 1 to nV + 1
				add xu[i], yv[j], postTop
				cylind uheadExt, 0.017
				del 1
				add xu[i] - 0.06, yv[j] - 0.06, postTop + uheadExt
				block 0.12, 0.12, 0.008
				del 1
				for sd = 0 to 1
					add xu[i] - 0.06, yv[j] - 0.058 + sd * 0.11, postTop + uheadExt
					block 0.12, 0.006, 0.06
					del 1
				next sd
			next j
		next i
		if matDeck > 0 then material matDeck
		for j = 1 to nV + 1
			add -0.15, yv[j] - 0.05, postTop + uheadExt + 0.008
			block stLU + 0.30, 0.10, 0.10
			del 1
		next j
		if matScaf > 0 then material matScaf
	endif
	! 階段の上の列ごとの根がらみ: 列の中（直角方向）と、足元の低い隣の列へ1スパン
	for k = 1 to nN
		if fn[k] > 0 then
			z = fn[k]
			if footAxis = 0 and k <= nU + 1 then
				add xu[k], 0, z
				rotx -90
				cylind stLV, 0.0214
				del 2
				for j = 1 to nV + 1
					if k > 1 then
						if fu[k - 1] < fu[k] then
							add xu[k - 1], yv[j], z
							roty 90
							cylind su[k - 1], 0.0214
							del 2
						endif
					endif
					if k <= nU then
						if fu[k + 1] < fu[k] then
							add xu[k], yv[j], z
							roty 90
							cylind su[k], 0.0214
							del 2
						endif
					endif
				next j
			endif
			if footAxis = 1 and k <= nV + 1 then
				add 0, yv[k], z
				roty 90
				cylind stLU, 0.0214
				del 2
				for i = 1 to nU + 1
					if k > 1 then
						if fv[k - 1] < fv[k] then
							add xu[i], yv[k - 1], z
							rotx -90
							cylind sv[k - 1], 0.0214
							del 2
						endif
					endif
					if k <= nV then
						if fv[k + 1] < fv[k] then
							add xu[i], yv[k], z
							rotx -90
							cylind sv[k], 0.0214
							del 2
						endif
					endif
				next i
			endif
		endif
	next k
	! 全面の作業床（スパンごとの踏板。隙間 5mm）。最上段と deckList の段
	if matDeck > 0 then material matDeck
	for id = 1 to nD
		for i = 1 to nU
			for j = 1 to nV
				add xu[i] + 0.0025, yv[j] + 0.0025, dk[id] + 0.021
				block su[i] - 0.005, sv[j] - 0.005, 0.045
				del 1
			next j
		next i
	next id
	if matScaf > 0 then material matScaf
	! 外周の手すり・中桟と幅木
	if guardOn then
	for hk = 1 to 2
		hh = 0.95
		if hk = 2 then hh = 0.45
		for sd = 0 to 1
			add 0, sd * stLV, deckH + hh
			roty 90
			cylind stLU, 0.0214
			del 2
			add sd * stLU, 0, deckH + hh
			rotx -90
			cylind stLV, 0.0214
			del 2
		next sd
	next hk
	for sd = 0 to 1
		add 0, sd * stLV - 0.006, deckH + 0.066
		block stLU, 0.012, 0.15
		del 1
		add sd * stLU - 0.006, 0, deckH + 0.066
		block 0.012, stLV, 0.15
		del 1
	next sd
	endif
	! 外周の構面の筋かい（5スパンごと、各段のあいだ）
	for il = 1 to nL - 1
		z1 = lv[il] + 0.1
		z2 = lv[il + 1] - 0.1
		for i = 1 to nU
			if i - 1 - 5 * int((i - 1) / 5) = 0 and z1 > zBase + max(fu[i], fu[i + 1]) + max(fv[1], fv[nV + 1]) then
				for sd = 0 to 1
					ag = atn((z2 - z1) / su[i])
					add xu[i], sd * stLV, z1
					roty 90 - ag
					cylind sqr(su[i] ^ 2 + (z2 - z1) ^ 2), 0.0214
					del 2
				next sd
			endif
		next i
		for j = 1 to nV
			if j - 1 - 5 * int((j - 1) / 5) = 0 and z1 > zBase + max(fu[1], fu[nU + 1]) + max(fv[j], fv[j + 1]) then
				for sd = 0 to 1
					ag = atn((z2 - z1) / sv[j])
					add sd * stLU, yv[j], z1
					rotx -(90 - ag)
					cylind sqr(sv[j] ^ 2 + (z2 - z1) ^ 2), 0.0214
					del 2
				next sd
			endif
		next j
	next il
	! はしご（始めの角の外、作業床の上 0.9 まで）。外周の手すりが無いとき（EVシャフト）は壁が近いので内側に入れ、
	! 作業床ははしご口（ハッチ付きの踏板）で抜ける
	yLad = -0.25
	if not(guardOn) then yLad = 0.25
	for sd = 0 to 1
		add 0.20 + sd * 0.35, yLad, zBase + fu[1] + fv[1]
		cylind topZ - zBase - fu[1] - fv[1], 0.0175
		del 1
	next sd
	zr = zBase + fu[1] + fv[1] + 0.30
	while zr < topZ - 0.1 do
		add 0.20, yLad, zr
		roty 90
		cylind 0.35, 0.011
		del 2
		zr = zr + 0.30
	endwhile
endif
del top
