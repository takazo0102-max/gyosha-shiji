! ============================================================
! 内部ステージ足場 3D: 支柱の格子・根がらみと各段の布材（両方向）・最上段の全面の作業床・外周の手すり・中桟・幅木・
! 外周の構面の筋かい（5スパンごと）・はしご。原点＝外周の支柱の始めの角、+X＝長手、+Y＝短手
! ============================================================
! 工程の模型（scripts/gdl_step.py）: stepH より上はまだ組み上がっていない
if stepH > 0.001 then
	rotx 90
	cutpoly 4, -1000, stepH, 1000, stepH, 1000, 1000, -1000, 1000
	del 1
endif
pen penPost
resol 8
rotz faceAng
if matScaf > 0 then material matScaf
! リストを読む（mm→m）
dim su[], sv[], lv[]
nU = 0
s = spanU
while strlen(s) > 0 and nU < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nU = nU + 1
		su[nU] = v / 1000
	endif
endwhile
nV = 0
s = spanV
while strlen(s) > 0 and nV < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nV = nV + 1
		sv[nV] = v / 1000
	endif
endwhile
nL = 0
s = lvList
while strlen(s) > 0 and nL < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nL = nL + 1
		lv[nL] = v / 1000
	endif
endwhile
! ほかの段の作業床（EVシャフトの各階など。利用者の指定 2026-10-28: 内部足場はステージとEV部分）
dim dk[]
nD = 0
s = deckList
while strlen(s) > 0 and nD < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nD = nD + 1
		dk[nD] = v / 1000
	endif
endwhile
nD = nD + 1
dk[nD] = deckH
dim xu[], yv[]
xu[1] = 0
for i = 1 to nU
	xu[i + 1] = xu[i] + su[i]
next i
yv[1] = 0
for j = 1 to nV
	yv[j + 1] = yv[j] + sv[j]
next j
stLU = xu[nU + 1]
stLV = yv[nV + 1]
! 階段の上（利用者の指定 2026-10-28: 内部足場は階段でよく使う）: 支柱の列ごとの足元の高さ。fu[i]＋fv[j] が支柱 (i, j) の足元
dim fu[], fv[]
for i = 1 to nU + 1
	fu[i] = 0
next i
for j = 1 to nV + 1
	fv[j] = 0
next j
nF = 0
s = footZ
while strlen(s) > 0 and nF < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nF = nF + 1
		if footAxis = 0 and nF <= nU + 1 then fu[nF] = v / 1000
		if footAxis = 1 and nF <= nV + 1 then fv[nF] = v / 1000
	endif
endwhile
! 列ごとの根がらみ（段の上の支柱の最初のコマ。0＝共通）
dim fn[]
for i = 1 to 60
	fn[i] = 0
next i
nN = 0
s = footNeg
while strlen(s) > 0 and nN < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nN = nN + 1
		fn[nN] = v / 1000
	endif
endwhile
! 列ごとのジャッキの繰出し（階段の上）と布板の幅
dim fj[], dw[]
for i = 1 to 60
	fj[i] = jackExt
next i
nJ = 0
s = footJk
while strlen(s) > 0 and nJ < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nJ = nJ + 1
		fj[nJ] = v / 1000
	endif
endwhile
nW = 0
s = dkWs
while strlen(s) > 0 and nW < 6 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 and v > 50 then
		nW = nW + 1
		dw[nW] = v / 1000
	endif
endwhile
if nW = 0 then
	nW = 1
	dw[1] = 0.5
endif
! 昇降の階段（利用者の指定 2026-10-29: ハシゴじゃなくて階段を使う）: 下の段・上の段の組
dim sf[]
nS = 0
s = stFl
while strlen(s) > 0 and nS < 80 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nS = nS + 1
		sf[nS] = v / 1000
	endif
endwhile
stairOn = (nS >= 2)
! ハッチ付布板（梯子内蔵）の段（利用者の指定 2026-10-29: エレベーターシャフトは階段ではなくハッチつきアンチ）
dim hz[]
nHz = 0
s = hatchZ
while strlen(s) > 0 and nHz < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nHz = nHz + 1
		hz[nHz] = v / 1000
	endif
endwhile
dim htPx[], htPy[], htPz[], htLn[], htWd[]
nHtp = 0
! 階段の通る幅（階段枠 450 を2列で折り返し、升目が狭ければ1列）
! 本体の足場の部材と同じ作り（利用者の指定 2026-10-29: 支保工も今作っている足場部材でやる）。寸法は足場ラインの
! 830 布材・870 布板・820 ジャッキ（部品 ashiba_member と同じ）
r_sic = 0.0486 / 2
if postDia > 0.01 then r_sic = postDia / 2
r_nuno = 0.0427 / 2
isWedge = (sysKind = 0)
stLaneW = 0.55
if sv[1] >= 2 * 0.45 + 0.1 then stLaneW = 2 * 0.45 + 0.1
rP = r_sic
topZ = deckH + 0.95
if postTop > 0 then topZ = postTop
if lineMode then
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			lin_ xu[i], yv[j], zBase + fu[i] + fv[j], xu[i], yv[j], topZ
		next j
	next i
else
	! 支柱（コマ・上端の連結ホゾ）とジャッキベース
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			zf = zBase + fu[i] + fv[j]
			jE = jackExt
			if nJ > 0 then
				if footAxis = 0 then jE = fj[min(i, 60)]
				if footAxis = 1 then jE = fj[min(j, 60)]
			endif
			add xu[i], yv[j], zf
			gosub "jack"
			del 1
			pb = zf + jE
			add xu[i], yv[j], pb
			pLen = topZ - pb
			gosub "post"
			del 1
		next j
	next i
	! 根がらみと各段の布材（両方向）
	! スパンごとに描き、両端の支柱の足元より下の布材は描かない（階段の上は段ごとに根がらみが上がる）
	for il = 1 to nL
		z = lv[il]
		for j = 1 to nV + 1
			for i = 1 to nU
				if z > zBase + max(fu[i], fu[i + 1]) + fv[j] + 0.05 then
					add xu[i], yv[j], z
					nLd = su[i]
					gosub "ledger"
					del 1
				endif
			next i
		next j
		for i = 1 to nU + 1
			for j = 1 to nV
				if z > zBase + fu[i] + max(fv[j], fv[j + 1]) + 0.05 then
					add xu[i], yv[j], z
					rotz 90
					nLd = sv[j]
					gosub "ledger"
					del 2
				endif
			next j
		next i
	next il
	! 支保工の頂部（利用者の指定 2026-10-28: 型枠支保工で使う）: 支柱の天端に大引受けジャッキ（ねじ棒＋U字の受け）、
	! 長手の支柱の列ごとに大引（端太角 100 角）
	if postTop > 0 and uheadExt > 0 then
		for i = 1 to nU + 1
			for j = 1 to nV + 1
				add xu[i], yv[j], postTop
				cylind uheadExt, 0.017
				del 1
				add xu[i] - 0.06, yv[j] - 0.06, postTop + uheadExt
				block 0.12, 0.12, 0.008
				del 1
				for sd = 0 to 1
					add xu[i] - 0.06, yv[j] - 0.058 + sd * 0.11, postTop + uheadExt
					block 0.12, 0.006, 0.06
					del 1
				next sd
			next j
		next i
		if matDeck > 0 then material matDeck
		for j = 1 to nV + 1
			add -0.15, yv[j] - 0.05, postTop + uheadExt + 0.008
			block stLU + 0.30, 0.10, 0.10
			del 1
		next j
		if matScaf > 0 then material matScaf
	endif
	! 階段の上の列ごとの根がらみ: 列の中（直角方向）と、足元の低い隣の列へ1スパン
	for k = 1 to nN
		if fn[k] > 0 then
			z = fn[k]
			if footAxis = 0 and k <= nU + 1 then
				for j = 1 to nV
					add xu[k], yv[j], z
					rotz 90
					nLd = sv[j]
					gosub "ledger"
					del 2
				next j
				for j = 1 to nV + 1
					if k > 1 then
						if fu[k - 1] < fu[k] then
							add xu[k - 1], yv[j], z
							nLd = su[k - 1]
							gosub "ledger"
							del 1
						endif
					endif
					if k <= nU then
						if fu[k + 1] < fu[k] then
							add xu[k], yv[j], z
							nLd = su[k]
							gosub "ledger"
							del 1
						endif
					endif
				next j
			endif
			if footAxis = 1 and k <= nV + 1 then
				for i = 1 to nU
					add xu[i], yv[k], z
					nLd = su[i]
					gosub "ledger"
					del 1
				next i
				for i = 1 to nU + 1
					if k > 1 then
						if fv[k - 1] < fv[k] then
							add xu[i], yv[k - 1], z
							rotz 90
							nLd = sv[k - 1]
							gosub "ledger"
							del 2
						endif
					endif
					if k <= nV then
						if fv[k + 1] < fv[k] then
							add xu[i], yv[k], z
							rotz 90
							nLd = sv[k]
							gosub "ledger"
							del 2
						endif
					endif
				next i
			endif
		endif
	next k
	! 全面の作業床（スパンごとの踏板。隙間 5mm）。最上段と deckList の段
	if matDeck > 0 then material matDeck
	for id = 1 to nD
		for i = 1 to nU
			for j = 1 to nV
				! スパンを布板の幅（広い順）で埋める（すき間 3cm 以下）。階段の升目は階段の通る幅を抜く
				yp = yv[j] + 0.015
				rest = sv[j] - 0.03
				if stairOn and i = 1 and j = 1 then
					yp = yv[j] + stLaneW + 0.015
					rest = sv[j] - stLaneW - 0.03
				endif
				! この段にハッチがあれば、隅の升目の 1枚目（奇数番目のハッチ）か 2枚目（偶数番目）の幅500をハッチにする
				! （足場の幅は 1219 まで: 幅500 は2枚。利用者の指定 2026-10-29）
				hSlot = 0
				if i = 1 and j = 1 then
					for kh = 1 to nHz
						if abs(hz[kh] - dk[id]) < 0.005 and hz[kh] - zBase > 0.65 then
							hSlot = 1
							if kh mod 2 = 0 then hSlot = 2
						endif
					next kh
				endif
				nSl = 0
				for iw = 1 to nW
					while rest >= dw[iw] - 0.001 do
						nSl = nSl + 1
						add xu[i], yp, dk[id]
						pkL = su[i]
						pkW = dw[iw]
						if nSl = hSlot and dw[iw] >= 0.45 then
							! ハッチは色を変えるので、ほかの部材を描き終えてから最後にまとめて描く
							nHtp = nHtp + 1
							htPx[nHtp] = xu[i]
							htPy[nHtp] = yp
							htPz[nHtp] = dk[id]
							htLn[nHtp] = su[i]
							htWd[nHtp] = dw[iw]
						else
							gosub "plank"
						endif
						del 1
						yp = yp + dw[iw]
						rest = rest - dw[iw]
					endwhile
				next iw
				! 布板で埋めきれないすき間はすき間板（薄い鋼板）でふさぐ（ステージは全面。すき間 3cm 以下）
				if rest > 0.03 and not(stairOn and i = 1 and j = 1) then
					add xu[i] + 0.03, yp, dk[id] + r_nuno + 0.040
					block su[i] - 0.06, rest, 0.006
					del 1
				endif
			next j
		next i
	next id
	! 階段（隅の1スパンに折り返し。階段枠 幅450・ささら＋踏板＋両側の手すり）と、その升目の作業床の開口の手すり
	if stairOn then
		gosub "stairs"
	endif
	if matScaf > 0 then material matScaf
	! 外周の手すり・中桟と幅木
	if guardOn then
	for hk = 1 to 2
		hh = 0.95
		if hk = 2 then hh = 0.45
		for sd = 0 to 1
			for i = 1 to nU
				add xu[i], sd * stLV, deckH + hh
				nLd = su[i]
				gosub "ledger"
				del 1
			next i
			! 長手の終わりの短辺を出入口にするとき（gOpenE。仮設通路の島）はその辺に掛けない
			if not(sd = 1 and gOpenE) then
				for j = 1 to nV
					add sd * stLU, yv[j], deckH + hh
					rotz 90
					nLd = sv[j]
					gosub "ledger"
					del 2
				next j
			endif
		next sd
	next hk
	for sd = 0 to 1
		add 0, sd * stLV - 0.006, deckH + 0.066
		block stLU, 0.012, 0.15
		del 1
		if not(sd = 1 and gOpenE) then
			add sd * stLU - 0.006, 0, deckH + 0.066
			block 0.012, stLV, 0.15
			del 1
		endif
	next sd
	endif
	! 支保工の水平荷重を受ける交さ筋かい（各層・各方向 inBrN 組。数量と同じ）: 内側の通りから順に、足りなければ外周の
	! 通りの外周の筋かいの無い升目へ、1升目に1組ずつ配る
	if inBrN > 0 then
		for il = 1 to nL - 1
			z1 = lv[il] + 0.1
			z2 = lv[il + 1] - 0.1
			for dirB = 0 to 1
				nLine = nV + 1
				nBay = nU
				if dirB = 1 then
					nLine = nU + 1
					nBay = nV
				endif
				cnt = 0
				for pass = 0 to 1
					for ln = 1 to nLine
						isEdge = (ln = 1 or ln = nLine)
						if (pass = 0 and not(isEdge)) or (pass = 1 and isEdge) then
							for bb = 1 to nBay
								hasOuter = isEdge and (bb - 1 - 5 * int((bb - 1) / 5) = 0)
								! 階段の入口の升目（短手の始めの面の1つ目）とずらした外周の筋かいの升目は空ける
								if stairOn and dirB = 1 and ln = 1 and bb <= 2 then hasOuter = 1
								if cnt < inBrN and not(hasOuter) then
									cnt = cnt + 1
									for xd = 0 to 1
										if dirB = 0 then
											bx1 = xu[bb] + xd * su[bb]
											bx2 = xu[bb] + (1 - xd) * su[bb]
											by1 = yv[ln]
											by2 = yv[ln]
										else
											bx1 = xu[ln]
											bx2 = xu[ln]
											by1 = yv[bb] + xd * sv[bb]
											by2 = yv[bb] + (1 - xd) * sv[bb]
										endif
										bz1 = z1
										bz2 = z2
										gosub "rod"
									next xd
								endif
							next bb
						endif
					next ln
				next pass
			next dirB
		next il
	endif
	! 外周の構面の筋かい（5スパンごと、各段のあいだ）
	for il = 1 to nL - 1
		z1 = lv[il] + 0.1
		z2 = lv[il + 1] - 0.1
		for i = 1 to nU
			if i - 1 - 5 * int((i - 1) / 5) = 0 and z1 > zBase + max(fu[i], fu[i + 1]) + max(fv[1], fv[nV + 1]) then
				for sd = 0 to 1
					ag = atn((z2 - z1) / su[i])
					add xu[i], sd * stLV, z1
					roty 90 - ag
					cylind sqr(su[i] ^ 2 + (z2 - z1) ^ 2), 0.0427 / 2
					del 2
				next sd
			endif
		next i
		for j = 1 to nV
			if j - 1 - 5 * int((j - 1) / 5) = 0 and z1 > zBase + max(fu[1], fu[nU + 1]) + max(fv[j], fv[j + 1]) then
				for sd = 0 to 1
					! 階段の入口（始めの短手の面の1つ目の升目）は塞がない: 隣の升目へずらす
					jb = j
					if stairOn and sd = 0 and j = 1 and nV >= 2 then jb = 2
					ag = atn((z2 - z1) / sv[jb])
					add sd * stLU, yv[jb], z1
					rotx -(90 - ag)
					cylind sqr(sv[jb] ^ 2 + (z2 - z1) ^ 2), 0.0427 / 2
					del 2
				next sd
			endif
		next j
	next il
	! はしご（始めの角の外、作業床の上 0.9 まで）。外周の手すりが無いとき（EVシャフト）は壁が近いので内側に入れ、
	! 作業床ははしご口（ハッチ付きの踏板）で抜ける
	yLad = -0.25
	if not(guardOn) then yLad = 0.25
	if stairOn or not(ladOn) then goto 2102
	for sd = 0 to 1
		add 0.20 + sd * 0.35, yLad, zBase + fu[1] + fv[1]
		cylind topZ - zBase - fu[1] - fv[1], 0.0175
		del 1
	next sd
	zr = zBase + fu[1] + fv[1] + 0.30
	while zr < topZ - 0.1 do
		add 0.20, yLad, zr
		roty 90
		cylind 0.35, 0.011
		del 2
		zr = zr + 0.30
	endwhile
2102:
	! ハッチ付布板（最後に。色を変えるため）
	for kd = 1 to nHtp
		add htPx[kd], htPy[kd], htPz[kd]
		pkL = htLn[kd]
		pkW = htWd[kd]
		gosub "hatch"
		del 1
	next kd
endif
del top
end

"hatch":
	! ハッチ付布板（アルミ・梯子内蔵。日建 NDN6TA）: 布板の枠とふたの線、内蔵の梯子を1層下まで下ろす（原点＝布板と同じ）
	define material "ashiba_hatch" 2, 0.78, 0.80, 0.83
	material "ashiba_hatch"
	add 0.025, 0, r_nuno
	block pkL - 0.05, pkW, 0.045
	del 1
	! ふた（開口 約 0.6×0.4）の見切り
	add pkL * 0.25, 0.05, r_nuno + 0.046
	block 0.62, pkW - 0.10, 0.003
	del 1
	! 内蔵の梯子（ふたの下から 1層下の段まで。わずかに傾けて下ろす）
	lzTop = r_nuno
	lzBot = -1.8
	for sr = 0 to 1
		add pkL * 0.25 + 0.05, 0.08 + sr * (pkW - 0.16), lzTop
		roty 180 - 8
		cylind lzTop - lzBot, 0.012
		del 2
	next sr
	rg = 0.3
	while rg < lzTop - lzBot - 0.1 do
		add pkL * 0.25 + 0.05 + rg * sin(8), 0.08, lzTop - rg * cos(8)
		rotx -90
		cylind pkW - 0.16, 0.008
		del 2
		rg = rg + 0.3
	endwhile
	if matScaf > 0 then material matScaf
return

"rod":
	! 2点 (bx1,by1,bz1)〜(bx2,by2,bz2) を結ぶ筋かい φ42.7
	rdx = bx2 - bx1
	rdy = by2 - by1
	rdz = bz2 - bz1
	rdL = sqr(rdx ^ 2 + rdy ^ 2 + rdz ^ 2)
	if rdL > 0.01 then
		if abs(rdx) < 0.000001 then
			rAz = 90
			if rdy < 0 then rAz = -90
		else
			rAz = atn(rdy / rdx)
			if rdx < 0 then rAz = rAz + 180
		endif
		add bx1, by1, bz1
		rotz rAz
		roty acs(rdz / rdL)
		cylind rdL, 0.0427 / 2
		del 3
	endif
return

"stairs":
	sW = 0.45
	sx0 = xu[1] + 0.08
	sx1 = xu[2] - 0.08
	sRun = sx1 - sx0
	twoLane = (sv[1] >= 2 * sW + 0.1)
	for kf = 1 to int(nS / 2)
		zb = sf[2 * kf - 1]
		zt = sf[2 * kf]
		sRise = zt - zb
		if sRise > 0.2 then
			up = 1
			ys = yv[1] + 0.05
			if twoLane and kf mod 2 = 0 then
				up = -1
				ys = yv[1] + 0.10 + sW
			endif
			sA = atn(sRise / sRun)
			sLen = sqr(sRun ^ 2 + sRise ^ 2)
			xs = sx0
			if up < 0 then xs = sx1
			! ささら（両側）と手すり（踏面から 0.85）
			for sd = 0 to 1
				yy = ys + sd * sW
				add xs, yy, zb
				if up > 0 then
					roty 90 - sA
				else
					roty -(90 - sA)
				endif
				cylind sLen, 0.02
				del 2
				add xs, yy, zb + 0.85
				if up > 0 then
					roty 90 - sA
				else
					roty -(90 - sA)
				endif
				cylind sLen, 0.0136
				del 2
			next sd
			! 踏板（蹴上げ 0.2 前後）
			nT = max(1, int(sRise / 0.2 + 0.5))
			for kt = 1 to nT - 1
				px = xs + up * sRun * kt / nT
				add px - 0.12, ys, zb + sRise * kt / nT - 0.03
				block 0.24, sW, 0.03
				del 1
			next kt
		endif
	next kf
	! 階段の通る開口の脇（y＝yv[1]＋stLaneW）に手すり・中桟（開口部手摺。出入口の xu[2] の側は開ける）
	for id = 1 to nD
		for hk = 1 to 2
			hh = 0.95
			if hk = 2 then hh = 0.45
			add xu[1], yv[1] + stLaneW, dk[id] + hh
			roty 90
			cylind su[1], 0.0136
			del 2
		next hk
	next id
return

"post":
	! 支柱（本体の足場ライン・ashiba_member の支柱と同じ: 管・コマ・上端の連結ホゾ）。原点＝下端、長さ pLen
	cylind pLen, r_sic
	if isWedge then
		add 0, 0, pLen
		cylind 0.125, 0.0182
		del 1
		resol 6
		kz = lv[1] - komaP * int((lv[1] - pb) / komaP)
		while kz < pb + pLen - 0.05 do
			if kz > pb + 0.05 then
				add 0, 0, kz - pb - 0.003
				cylind 0.006, 0.053
				del 1
			endif
			kz = kz + komaP
		endwhile
		resol 8
	endif
return

"ledger":
	! 布材（緊結部がコマを上下に挟み、クサビが縦に通る。管は緊結部の間）。原点＝支柱芯、+X へ nLd
	if isWedge then
		hdL = 0.050
		add r_sic + hdL, 0, 0
		roty 90
		cylind nLd - 2 * (r_sic + hdL), r_nuno
		del 2
		for hd = 0 to 1
			if hd = 0 then
				add r_sic, 0, 0
			else
				add nLd - r_sic, 0, 0
				mulx -1
			endif
			add 0, -0.020, 0.003
			block hdL, 0.040, 0.042
			del 1
			add 0, -0.020, -0.040
			block hdL, 0.040, 0.037
			del 1
			add 0.010, -0.006, -0.075
			block 0.010, 0.012, 0.150
			del 1
			if hd = 0 then
				del 1
			else
				del 2
			endif
		next hd
	else
		roty 90
		cylind nLd, r_nuno
		del 1
	endif
return

"plank":
	! 布板（アップロック式鋼製布板）: 原点＝支柱芯の高さ・板の始めの端、+X へ pkL、+Y へ幅 pkW
	if matDeck > 0 then material matDeck
	add 0.025, 0, r_nuno
	block pkL - 0.05, pkW, 0.045
	del 1
	for hd = 0 to 1
		if hd = 0 then
			add 0, 0, 0
		else
			add pkL, 0, 0
			mulx -1
		endif
		add 0.002, 0.04, r_nuno + 0.040
		block 0.024, pkW - 0.08, 0.005
		del 1
		for hk = 0 to 1
			add 0.004, 0.015 + hk * (pkW - 0.065), -r_nuno - 0.012
			block 0.030, 0.035, 2 * r_nuno + 0.012
			del 1
		next hk
		if hd = 0 then
			del 1
		else
			del 2
		endif
	next hd
	if matScaf > 0 then material matScaf
return

"jack":
	! ジャッキベース（ベース板 140角・ねじ棒・ハンドル付きナット）。原点＝足元、繰出し jE
	add -0.07, -0.07, 0
	block 0.14, 0.14, 0.006
	del 1
	cylind max(jE, 0.02), 0.035 / 2
	add 0, 0, max(jE, 0.04) - 0.03
	resol 6
	cylind 0.03, 0.045
	resol 8
	addz 0.015
	roty 90
	add 0, 0, -0.09
	cylind 0.18, 0.006
	del 4
return
if stepH > 0.001 then cutend
