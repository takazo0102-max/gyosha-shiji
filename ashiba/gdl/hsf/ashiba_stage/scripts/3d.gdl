! ============================================================
! 内部ステージ足場 3D: 支柱の格子・根がらみと各段の布材（両方向）・最上段の全面の作業床・外周の手すり・中桟・幅木・
! 外周の構面の筋かい（5スパンごと）・はしご。原点＝外周の支柱の始めの角、+X＝長手、+Y＝短手
! ============================================================
pen penPost
resol 8
rotz faceAng
if matScaf > 0 then material matScaf
! リストを読む（mm→m）
dim su[], sv[], lv[]
nU = 0
s = spanU
while strlen(s) > 0 and nU < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nU = nU + 1
		su[nU] = v / 1000
	endif
endwhile
nV = 0
s = spanV
while strlen(s) > 0 and nV < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nV = nV + 1
		sv[nV] = v / 1000
	endif
endwhile
nL = 0
s = lvList
while strlen(s) > 0 and nL < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nL = nL + 1
		lv[nL] = v / 1000
	endif
endwhile
dim xu[], yv[]
xu[1] = 0
for i = 1 to nU
	xu[i + 1] = xu[i] + su[i]
next i
yv[1] = 0
for j = 1 to nV
	yv[j + 1] = yv[j] + sv[j]
next j
stLU = xu[nU + 1]
stLV = yv[nV + 1]
rP = 0.0243
topZ = deckH + 0.95
if lineMode then
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			lin_ xu[i], yv[j], zBase, xu[i], yv[j], topZ
		next j
	next i
else
	! 支柱とジャッキ
	for i = 1 to nU + 1
		for j = 1 to nV + 1
			add xu[i], yv[j], zBase
			cylind topZ - zBase, rP
			del 1
			add xu[i] - 0.07, yv[j] - 0.07, zBase - 0.01
			block 0.14, 0.14, 0.01
			del 1
		next j
	next i
	! 根がらみと各段の布材（両方向）
	for il = 1 to nL
		z = lv[il]
		for j = 1 to nV + 1
			add 0, yv[j], z
			roty 90
			cylind stLU, 0.0214
			del 2
		next j
		for i = 1 to nU + 1
			add xu[i], 0, z
			rotx -90
			cylind stLV, 0.0214
			del 2
		next i
	next il
	! 最上段の全面の作業床（スパンごとの踏板。隙間 5mm）
	if matDeck > 0 then material matDeck
	for i = 1 to nU
		for j = 1 to nV
			add xu[i] + 0.0025, yv[j] + 0.0025, deckH + 0.021
			block su[i] - 0.005, sv[j] - 0.005, 0.045
			del 1
		next j
	next i
	if matScaf > 0 then material matScaf
	! 外周の手すり・中桟と幅木
	for hk = 1 to 2
		hh = 0.95
		if hk = 2 then hh = 0.45
		for sd = 0 to 1
			add 0, sd * stLV, deckH + hh
			roty 90
			cylind stLU, 0.0214
			del 2
			add sd * stLU, 0, deckH + hh
			rotx -90
			cylind stLV, 0.0214
			del 2
		next sd
	next hk
	for sd = 0 to 1
		add 0, sd * stLV - 0.006, deckH + 0.066
		block stLU, 0.012, 0.15
		del 1
		add sd * stLU - 0.006, 0, deckH + 0.066
		block 0.012, stLV, 0.15
		del 1
	next sd
	! 外周の構面の筋かい（5スパンごと、各段のあいだ）
	for il = 1 to nL - 1
		z1 = lv[il] + 0.1
		z2 = lv[il + 1] - 0.1
		for i = 1 to nU
			if i - 1 - 5 * int((i - 1) / 5) = 0 then
				for sd = 0 to 1
					ag = atn((z2 - z1) / su[i])
					add xu[i], sd * stLV, z1
					roty 90 - ag
					cylind sqr(su[i] ^ 2 + (z2 - z1) ^ 2), 0.0214
					del 2
				next sd
			endif
		next i
		for j = 1 to nV
			if j - 1 - 5 * int((j - 1) / 5) = 0 then
				for sd = 0 to 1
					ag = atn((z2 - z1) / sv[j])
					add sd * stLU, yv[j], z1
					rotx -(90 - ag)
					cylind sqr(sv[j] ^ 2 + (z2 - z1) ^ 2), 0.0214
					del 2
				next sd
			endif
		next j
	next il
	! はしご（始めの角の外、作業床の上 0.9 まで）
	for sd = 0 to 1
		add 0.20 + sd * 0.35, -0.25, zBase
		cylind topZ - zBase, 0.0175
		del 1
	next sd
	zr = zBase + 0.30
	while zr < topZ - 0.1 do
		add 0.20, -0.25, zr
		roty 90
		cylind 0.35, 0.011
		del 2
		zr = zr + 0.30
	endwhile
endif
del top
