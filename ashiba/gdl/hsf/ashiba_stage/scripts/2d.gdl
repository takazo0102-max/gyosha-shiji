! ============================================================
! 内部ステージ足場 2D（平面）: 外形（太線）・支柱の格子（細線と小円）・全面の作業床の範囲・はしご・名前
! 利用者の指定（2026-10-24）: 内部足場の内部ステージ足場の機能追加して検証して
! 原点＝外周の支柱の始めの角、+X＝長手、+Y＝短手
! ============================================================
define style "stTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
rot2 faceAng
! リストを読む（mm→m）
dim su[], sv[], lv[]
nU = 0
s = spanU
while strlen(s) > 0 and nU < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nU = nU + 1
		su[nU] = v / 1000
	endif
endwhile
nV = 0
s = spanV
while strlen(s) > 0 and nV < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nV = nV + 1
		sv[nV] = v / 1000
	endif
endwhile
nL = 0
s = lvList
while strlen(s) > 0 and nL < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nL = nL + 1
		lv[nL] = v / 1000
	endif
endwhile
dim xu[], yv[]
xu[1] = 0
for i = 1 to nU
	xu[i + 1] = xu[i] + su[i]
next i
yv[1] = 0
for j = 1 to nV
	yv[j + 1] = yv[j] + sv[j]
next j
stLU = xu[nU + 1]
stLV = yv[nV + 1]
pen penLine
for i = 1 to nU + 1
	line2 xu[i], 0, xu[i], stLV
next i
for j = 1 to nV + 1
	line2 0, yv[j], stLU, yv[j]
next j
pen penDeck
! 全面の作業床（外周の手すりの内側）と斜めの網掛け
rect2 0.02, 0.02, stLU - 0.02, stLV - 0.02
xh = 0.6
while xh < stLU + stLV do
	x1 = max(0, xh - stLV)
	y1 = xh - x1
	x2 = min(stLU, xh)
	y2 = xh - x2
	if y1 > stLV then
		x1 = xh - stLV
		y1 = stLV
	endif
	line_type 3
	line2 x1, y1, x2, y2
	line_type 1
	xh = xh + 0.6
endwhile
pen penPost
for i = 1 to nU + 1
	for j = 1 to nV + 1
		circle2 xu[i], yv[j], 0.025
	next j
next i
! 外周の手すり（二重線。EVシャフトは壁が近いので無し）
if guardOn then rect2 -0.03, -0.03, stLU + 0.03, stLV + 0.03
! 昇降の階段（利用者の指定 2026-10-29: ハシゴじゃなくて階段を使う）: 隅の1スパンに階段枠 450 を2列（狭ければ1列）、
! 上り方向の矢印。階段が無いときだけはしご
if strlen(stFl) > 0 then
	sx0 = xu[1] + 0.08
	sx1 = xu[2] - 0.08
	nLane = 1
	if sv[1] >= 2 * 0.45 + 0.1 then nLane = 2
	for kl = 1 to nLane
		ys = yv[1] + 0.05 + (kl - 1) * 0.50
		rect2 sx0, ys, sx1, ys + 0.45
		! 踏面の線
		for kt = 1 to 7
			xt = sx0 + (sx1 - sx0) * kt / 8
			line2 xt, ys, xt, ys + 0.45
		next kt
		! 上り方向の矢印（1列目は +X、2列目は -X）
		ym = ys + 0.225
		if kl = 1 then
			line2 sx0 + 0.1, ym, sx1 - 0.1, ym
			line2 sx1 - 0.1, ym, sx1 - 0.25, ym + 0.08
			line2 sx1 - 0.1, ym, sx1 - 0.25, ym - 0.08
		else
			line2 sx1 - 0.1, ym, sx0 + 0.1, ym
			line2 sx0 + 0.1, ym, sx0 + 0.25, ym + 0.08
			line2 sx0 + 0.1, ym, sx0 + 0.25, ym - 0.08
		endif
	next kl
	goto 2201
endif
! ハッチ付布板（梯子内蔵。EVシャフト。利用者の指定 2026-10-29）: 隅の升目の1枚目と3枚目（上下で交互）に枠と×
if strlen(hatchZ) > 0 then
	for ks = 0 to 1
		yh = yv[1] + 0.015 + ks * 1.0
		if yh + 0.5 <= yv[2] + 0.01 then
			rect2 xu[1] + 0.025, yh, xu[2] - 0.025, yh + 0.5
			line2 xu[1] + 0.025, yh, xu[2] - 0.025, yh + 0.5
			line2 xu[1] + 0.025, yh + 0.5, xu[2] - 0.025, yh
		endif
	next ks
	goto 2201
endif
! はしご（始めの角の外。外周の手すりが無いとき＝EVシャフトは内側のはしご口）。はしごを選んだときだけ
if not(ladOn) then goto 2201
if guardOn then
	rect2 0.15, -0.45, 0.60, -0.10
	line2 0.15, -0.28, 0.60, -0.28
else
	rect2 0.15, 0.10, 0.60, 0.45
	line2 0.15, 0.10, 0.60, 0.45
	line2 0.15, 0.45, 0.60, 0.10
endif
2201:
hotspot2 0, 0
hotspot2 stLU, 0
hotspot2 stLU, stLV
hotspot2 0, stLV
set style "stTx"
add2 stLU / 2, stLV / 2
! 文字の向き（置いた角度＋面の向き）を 0〜360 に直して、左へ傾く（90〜270）なら返す
aTx = SYMB_ROTANGLE + faceAng
aTx = aTx - 360 * int(aTx / 360)
if aTx < 0 then aTx = aTx + 360
if aTx > 90.001 and aTx < 270.001 then rot2 180
text2 0, 0.15, stName
tDk = ""
if strlen(deckList) > 0 then tDk = "・ほかに床 " + deckList
text2 0, -0.25, "床高" + str((deckH - zBase) * 1000, 5, 0) + tDk + "（" + str(stLU * 1000, 5, 0) + "×" + str(stLV * 1000, 5, 0) + "）"
del top
