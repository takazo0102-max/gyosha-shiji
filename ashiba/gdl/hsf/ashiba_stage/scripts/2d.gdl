! ============================================================
! 内部ステージ足場 2D（平面）: 外形（太線）・支柱の格子（細線と小円）・全面の作業床の範囲・はしご・名前
! 利用者の指定（2026-10-24）: 内部足場の内部ステージ足場の機能追加して検証して
! 原点＝外周の支柱の始めの角、+X＝長手、+Y＝短手
! ============================================================
define style "stTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
rot2 faceAng
! リストを読む（mm→m）
dim su[], sv[], lv[]
nU = 0
s = spanU
while strlen(s) > 0 and nU < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nU = nU + 1
		su[nU] = v / 1000
	endif
endwhile
nV = 0
s = spanV
while strlen(s) > 0 and nV < 60 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nV = nV + 1
		sv[nV] = v / 1000
	endif
endwhile
nL = 0
s = lvList
while strlen(s) > 0 and nL < 40 do
	k = strstr(s, ",")
	if k > 0 then
		tk = strsub(s, 1, k - 1)
		s = strsub(s, k + 1, strlen(s) - k)
	else
		tk = s
		s = ""
	endif
	nn = split(tk, "%n", v)
	if nn > 0 then
		nL = nL + 1
		lv[nL] = v / 1000
	endif
endwhile
dim xu[], yv[]
xu[1] = 0
for i = 1 to nU
	xu[i + 1] = xu[i] + su[i]
next i
yv[1] = 0
for j = 1 to nV
	yv[j + 1] = yv[j] + sv[j]
next j
stLU = xu[nU + 1]
stLV = yv[nV + 1]
pen penLine
for i = 1 to nU + 1
	line2 xu[i], 0, xu[i], stLV
next i
for j = 1 to nV + 1
	line2 0, yv[j], stLU, yv[j]
next j
pen penDeck
! 全面の作業床（外周の手すりの内側）と斜めの網掛け
rect2 0.02, 0.02, stLU - 0.02, stLV - 0.02
xh = 0.6
while xh < stLU + stLV do
	x1 = max(0, xh - stLV)
	y1 = xh - x1
	x2 = min(stLU, xh)
	y2 = xh - x2
	if y1 > stLV then
		x1 = xh - stLV
		y1 = stLV
	endif
	line_type 3
	line2 x1, y1, x2, y2
	line_type 1
	xh = xh + 0.6
endwhile
pen penPost
for i = 1 to nU + 1
	for j = 1 to nV + 1
		circle2 xu[i], yv[j], 0.025
	next j
next i
! 外周の手すり（二重線）
rect2 -0.03, -0.03, stLU + 0.03, stLV + 0.03
! はしご（始めの角の外）
rect2 0.15, -0.45, 0.60, -0.10
line2 0.15, -0.28, 0.60, -0.28
hotspot2 0, 0
hotspot2 stLU, 0
hotspot2 stLU, stLV
hotspot2 0, stLV
set style "stTx"
add2 stLU / 2, stLV / 2
! 文字の向き（置いた角度＋面の向き）を 0〜360 に直して、左へ傾く（90〜270）なら返す
aTx = SYMB_ROTANGLE + faceAng
aTx = aTx - 360 * int(aTx / 360)
if aTx < 0 then aTx = aTx + 360
if aTx > 90.001 and aTx < 270.001 then rot2 180
text2 0, 0.15, stName
text2 0, -0.25, "床高" + str((deckH - zBase) * 1000, 5, 0) + "（" + str(stLU * 1000, 5, 0) + "×" + str(stLV * 1000, 5, 0) + "）"
del top
