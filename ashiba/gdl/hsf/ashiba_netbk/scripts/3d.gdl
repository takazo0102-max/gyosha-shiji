! ============================================================
! ネットブラケット 3D（くさび緊結式の内側建地に付ける水平ネット受け）
!   上の金具: 建地の緊結部（コマ）にくさびで留める受け金具。ここから躯体側へ腕（φ34）を出す
!   下の金具: 1コマ下（450mm）の緊結部に留め、方杖（φ27.2）で腕の先寄りを支える
!   腕の上にネットの縁を掛けるフック、先端は立ち上げてネットが躯体側へ抜けないようにする
!   原点＝内側建地の芯、+Y＝躯体側、zH＝ネットの高さ（腕の上端）
! ============================================================
pen 1
if matBk > 0 then material matBk
resol 8
rotz faceAng
addz zH
rP = 0.0486 / 2
yH = rP + 0.036
if lineMode then
	lin_ 0, rP, 0, 0, armL, 0
	lin_ 0, yH, -0.45, 0, armL * 0.75, -0.02
else
	! 上の受け金具とくさび（建地の躯体側の面に当てる）
	add -0.03, rP, -0.08
	block 0.06, yH - rP, 0.10
	del 1
	add -0.006, rP + 0.004, -0.13
	block 0.012, 0.028, 0.20
	del 1
	! 腕（上端をネットの高さに）
	add 0, yH, -0.017
	rotx -90
	cylind armL - yH, 0.034 / 2
	del 2
	! ネットを掛けるフック（腕の中ほどと先端寄り）と、先端の立ち上がり
	for ih = 1 to 2
		add 0, yH + (armL - yH) * ih / 3, 0
		cylind 0.04, 0.005
		del 1
	next ih
	add 0, armL - 0.017, -0.017
	cylind 0.10, 0.034 / 2
	del 1
	! 下の受け金具とくさび（1コマ下）
	add -0.03, rP, -0.50
	block 0.06, yH - rP, 0.10
	del 1
	add -0.006, rP + 0.004, -0.55
	block 0.012, 0.028, 0.20
	del 1
	! 方杖（下の金具 → 腕の先寄り）
	by1 = yH
	bz1 = -0.45
	by2 = max(yH + 0.05, armL * 0.75)
	bz2 = -0.025
	bL = sqr((by2 - by1) * (by2 - by1) + (bz2 - bz1) * (bz2 - bz1))
	add 0, by1, bz1
	rotx -atn((by2 - by1) / (bz2 - bz1))
	cylind bL, 0.0272 / 2
	del 2
endif
hotspot 0, 0, 0
hotspot 0, armL, 0
del 2
