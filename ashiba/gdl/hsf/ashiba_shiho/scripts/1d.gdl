! 山留め支保工: 並びを読む（m）
dim sgv[]
nSg = 0
rest = sgL
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nSg = nSg + 1
		sgv[nSg] = v / 1000
	endif
endwhile
