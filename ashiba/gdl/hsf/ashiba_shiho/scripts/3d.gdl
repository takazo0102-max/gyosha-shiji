! 山留め支保工 3D（リース材 30HA・35HA・40HA の主材と端板、継手のカバープレート、補助ピース、キリンジャッキとジャッキカバー、交差部の
! アングルピースと交叉部直ボルト、中間杭の切梁受けブラケットと締付用 U ボルト。寸法は src/ashiba/shiho.py の出典）
define material "sh_main" 2, 0.72, 0.16, 0.12
define material "sh_aux" 2, 0.85, 0.45, 0.15
define material "sh_plate" 2, 0.52, 0.12, 0.10
define material "sh_jack" 2, 0.20, 0.38, 0.72
define material "sh_steel" 2, 0.48, 0.30, 0.22
define material "sh_bolt" 2, 0.78, 0.78, 0.74
resol 12
if shKind = 4 then
	! ---- 中間杭（フランジが +X を向く H形鋼）・段ごとの切梁受けブラケット・締付用 U ボルト ----
	material "sh_steel"
	add 0, 0, -shBot
	prism_ 12, shBot - shZ,
		-sH / 2, -sB / 2, 15,
		-sH / 2 + sT2, -sB / 2, 15,
		-sH / 2 + sT2, -sT1 / 2, 15,
		sH / 2 - sT2, -sT1 / 2, 15,
		sH / 2 - sT2, -sB / 2, 15,
		sH / 2, -sB / 2, 15,
		sH / 2, sB / 2, 15,
		sH / 2 - sT2, sB / 2, 15,
		sH / 2 - sT2, sT1 / 2, 15,
		-sH / 2 + sT2, sT1 / 2, 15,
		-sH / 2 + sT2, sB / 2, 15,
		-sH / 2, sB / 2, 15
	del 1
	dg = sqr(bkL * bkL + bkH * bkH)
	for k = 1 to nPk
		zb = -pkv[k]
		material "sh_steel"
		add sH / 2, -0.0375, zb - 0.009
		block bkL, 0.075, 0.009
		del 1
		add sH / 2, -0.0045, zb - 0.075
		block bkL, 0.009, 0.066
		del 1
		add sH / 2, -0.0375, zb - bkH
		block 0.009, 0.075, bkH
		del 1
		add sH / 2, -0.0045, zb - bkH
		roty -atn(bkH / bkL)
		block dg, 0.009, 0.06
		del 2
		material "sh_bolt"
		for sd = -1 to 1 step 2
			add pkR + sd * ubW / 2, 0, zb - 0.04
			cylind ubH + 0.04, 0.011
			del 1
		next sd
		add pkR - ubW / 2, 0, zb + ubH
		roty 90
		cylind ubW, 0.011
		del 2
	next k
	end
endif
if nSg = 0 then
	material "sh_main"
	add 0, 0, zc
	roty 90
	if shKind = 1 then
		prism_ 12, shL,
			-sH / 2, -sB / 2, 15,
			-sH / 2 + sT2, -sB / 2, 15,
			-sH / 2 + sT2, -sT1 / 2, 15,
			sH / 2 - sT2, -sT1 / 2, 15,
			sH / 2 - sT2, -sB / 2, 15,
			sH / 2, -sB / 2, 15,
			sH / 2, sB / 2, 15,
			sH / 2 - sT2, sB / 2, 15,
			sH / 2 - sT2, sT1 / 2, 15,
			-sH / 2 + sT2, sT1 / 2, 15,
			-sH / 2 + sT2, sB / 2, 15,
			-sH / 2, sB / 2, 15
	else
		prism_ 12, shL,
			-sB / 2, -sH / 2, 15,
			sB / 2, -sH / 2, 15,
			sB / 2, -sH / 2 + sT2, 15,
			sT1 / 2, -sH / 2 + sT2, 15,
			sT1 / 2, sH / 2 - sT2, 15,
			sB / 2, sH / 2 - sT2, 15,
			sB / 2, sH / 2, 15,
			-sB / 2, sH / 2, 15,
			-sB / 2, sH / 2 - sT2, 15,
			-sT1 / 2, sH / 2 - sT2, 15,
			-sT1 / 2, -sH / 2 + sT2, 15,
			-sB / 2, -sH / 2 + sT2, 15
	endif
	del 2
endif
x = 0
for i = 1 to nSg
	L = sgv[i]
	if sgk[i] = 3 then
		! ---- キリンジャッキ（端板 2枚・ねじ・ナット）とジャッキカバー（両側） ----
		material "sh_jack"
		add x, -jkW / 2, zc - jkW / 2
		block 0.028, jkW, jkW
		addx L - 0.028
		block 0.028, jkW, jkW
		del 2
		add x + 0.028, 0, zc
		roty 90
		cylind L - 0.056, 0.07
		del 2
		add x + L / 2 - 0.04, 0, zc
		roty 90
		cylind 0.08, 0.11
		del 2
		material "sh_steel"
		for sd = -1 to 1 step 2
			add x + L / 2 - jcL / 2, sd * (jkW / 2 + 0.026) - 0.006, zc - 0.1
			block jcL, 0.012, 0.2
			del 1
		next sd
	endif
	if sgk[i] < 3 then
		! ---- 主材・補助ピース（H形鋼）と主材の端板 ----
		if sgk[i] = 1 then
			material "sh_main"
		else
			material "sh_aux"
		endif
		add x, 0, zc
		roty 90
		if shKind = 1 then
			prism_ 12, L,
				-sH / 2, -sB / 2, 15,
				-sH / 2 + sT2, -sB / 2, 15,
				-sH / 2 + sT2, -sT1 / 2, 15,
				sH / 2 - sT2, -sT1 / 2, 15,
				sH / 2 - sT2, -sB / 2, 15,
				sH / 2, -sB / 2, 15,
				sH / 2, sB / 2, 15,
				sH / 2 - sT2, sB / 2, 15,
				sH / 2 - sT2, sT1 / 2, 15,
				-sH / 2 + sT2, sT1 / 2, 15,
				-sH / 2 + sT2, sB / 2, 15,
				-sH / 2, sB / 2, 15
		else
			prism_ 12, L,
				-sB / 2, -sH / 2, 15,
				sB / 2, -sH / 2, 15,
				sB / 2, -sH / 2 + sT2, 15,
				sT1 / 2, -sH / 2 + sT2, 15,
				sT1 / 2, sH / 2 - sT2, 15,
				sB / 2, sH / 2 - sT2, 15,
				sB / 2, sH / 2, 15,
				-sB / 2, sH / 2, 15,
				-sB / 2, sH / 2 - sT2, 15,
				-sT1 / 2, sH / 2 - sT2, 15,
				-sT1 / 2, -sH / 2 + sT2, 15,
				-sB / 2, -sH / 2 + sT2, 15
		endif
		del 2
		if sgk[i] = 1 then
			material "sh_plate"
			if shKind = 1 then
				add x, -sB / 2 - 0.005, zc - sH / 2 - 0.005
				block endT, sB + 0.01, sH + 0.01
				addx L - endT
				block endT, sB + 0.01, sH + 0.01
				del 2
			else
				add x, -sH / 2 - 0.005, zc - sB / 2 - 0.005
				block endT, sH + 0.01, sB + 0.01
				addx L - endT
				block endT, sH + 0.01, sB + 0.01
				del 2
			endif
		endif
		! 前の主材・補助ピースとの継手に両フランジのカバープレート
		if i > 1 then
			if sgk[i - 1] < 3 then
				material "sh_plate"
				if shKind = 1 then
					add x - cvL / 2, -sB / 2, zc + sH / 2
					block cvL, sB, cvT
					addz -sH - cvT
					block cvL, sB, cvT
					del 2
				else
					add x - cvL / 2, sH / 2, zc - sB / 2
					block cvL, cvT, sB
					addy -sH - cvT
					block cvL, cvT, sB
					del 2
				endif
			endif
		endif
	endif
	x = x + L
next i
if shKind = 1 then
	! ---- 交差部（上段の切梁）: 上のフランジにアングル2本（切梁に直角）・下段の下のフランジの下にアングル2本・交叉部直ボルト4本 ----
	for k = 1 to nXc
		xq = xcv[k]
		zt = zc + sH / 2
		zb = zc - sH / 2 - xchv[k]
		material "sh_steel"
		for sd = -1 to 1 step 2
			add xq + sd * xbO - 0.0375, -xaL / 2, zt
			block 0.075, xaL, 0.009
			addx 0.033
			block 0.009, xaL, 0.075
			del 2
			add xq - xaL / 2, sd * xbO - 0.0375, zb - 0.009
			block xaL, 0.075, 0.009
			addy 0.033
			addz -0.066
			block xaL, 0.009, 0.075
			del 3
		next sd
		material "sh_bolt"
		for sx = -1 to 1 step 2
			for sy = -1 to 1 step 2
				add xq + sx * xbO, sy * xbO, zb - 0.06
				cylind zt - zb + 0.12, 0.011
				del 1
			next sy
		next sx
	next k
endif
if shKind = 2 then
	! ---- 腹起しのブラケット（下のフランジの下に受けの板と縦のリブ） ----
	material "sh_steel"
	for k = 1 to nBr
		add brv[k] - 0.075, -sH / 2, zc - sB / 2 - 0.016
		block 0.15, sH, 0.016
		del 1
		add brv[k] - 0.006, -sH / 2, zc - sB / 2 - 0.2
		block 0.012, sH * 0.6, 0.184
		del 1
	next k
endif
if shKind = 3 then
	! ---- 火打受ピース（両端。底は腹起し・切梁の面に沿い 45°、当たり面は火打ちに直角。幅 260） ----
	material "sh_steel"
	hb = hpA / 2 * 0.7071
	for sd = 0 to 1
		add sd * shL, 0, zc - 0.13
		if sd = 1 then mul -1, 1, 1
		prism_ 4, 0.26,
			hb, -hpS * hb, 15,
			0.5, -hpS * sH / 2, 15,
			0.5, hpS * sH / 2, 15,
			-hb, hpS * hb, 15
		if sd = 1 then del 1
		del 1
	next sd
endif
end
