! スラブの型枠と支保工: 位置を読む（m）
dim pu[]
nPu = 0
rest = polyU
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nPu = nPu + 1
		pu[nPu] = v / 1000
	endif
endwhile
