r = 0.0243
! 根太 角パイプ □50×50、大引 杉 90×90（スラブ・梁下の詳細図。利用者の指定 2026-10-31）
nH = 0.05
zN = -plyT - nH
zO = -plyT - nH
oH = 0.09
oB = 0.09
zF = zO - oH - postH
zS = zF - sillH
