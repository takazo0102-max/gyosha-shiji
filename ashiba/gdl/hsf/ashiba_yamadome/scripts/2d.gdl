! 根切りの山留めまわり 2D（CAD の平面図の描き方: scripts/gdl_draft.py）: 作業床（足場板）の外形は太線、手すりは細線、床の下のブラケットは
! 隠れ線（詳細だけ）、手すり柱は細線の丸。簡略は床の外形と手すりの線だけ。名前は中央寄せ・行送りは縮尺に合わせる
! 描き方の決め（scripts/gdl_draft.py）
drLv = drMode
if drLv < 1 or drLv > 3 then
	drLv = 1
	if GLOB_SCALE > 150 then drLv = 2
	if GLOB_SCALE > 250 then drLv = 3
endif
pO = penBold
if pO < 1 then pO = penEquip
pT = penThin
if pT < 1 then pT = penEquip
pZ = penZone
if pZ < 1 then pZ = pT
pM = penMask
ltS = 1
ltH = IND(LINE_TYPE, "破線")
if ltH < 1 then ltH = IND(LINE_TYPE, "Dashed")
if ltH < 1 then ltH = 1
ltC = IND(LINE_TYPE, "一点鎖線")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dotted")
if ltC < 1 then ltC = IND(LINE_TYPE, "Dash-dot")
if ltC < 1 then ltC = 1
ltZ = IND(LINE_TYPE, "二点鎖線")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-double-dotted")
if ltZ < 1 then ltZ = IND(LINE_TYPE, "Dash-dot-dot")
if ltZ < 1 then ltZ = 1
fiS = IND(FILL, "100 %")
if fiS < 1 then fiS = IND(FILL, "Solid Fill")
mk = (pM > 0 and fiS > 0)
define style "ymT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "ymT"
dT = texSiz * GLOB_SCALE / 1000 * 1.6
if ymKind = 1 then
	! 切梁上の足場: 床の外形・手すり・手すり柱・床の下のブラケット
	pen pO
	rect2 rx0, -deckW / 2, rx1, deckW / 2
	pen pT
	line2 rx0, -hp, rx1, -hp
	line2 rx0, hp, rx1, hp
	if drLv < 3 then
		for i = 1 to nB
			if drLv = 1 then
				line_type ltH
				line2 bx[i], -hp - 0.05, bx[i], hp + 0.05
				line_type ltS
			endif
			circle2 bx[i], -hp, r
			circle2 bx[i], hp, r
		next i
	endif
	pen penEquip
	text2 ymL / 2, hp + 0.15 + dT / 2, ymName
endif
if ymKind = 3 then
	! 外周の腹起し上の足場: 山留めの面（y＝0）から根切りの側（−y）へ armL。手すりは根切りの側だけ
	pen pO
	rect2 0, 0, ymL, -armL
	pen pT
	line2 0, -armL + 0.03, ymL, -armL + 0.03
	if drLv < 3 then
		for i = 1 to nB
			if drLv = 1 then
				line_type ltH
				line2 bx[i], 0, bx[i], -armL
				line_type ltS
			endif
			circle2 bx[i], -armL, r
		next i
	endif
	pen penEquip
	text2 ymL / 2, -armL - 0.15 - dT / 2, ymName
endif
if ymKind = 2 then
	! 山留め上の手すり: 手すりの線（太線）と柱
	pen pO
	line2 0, 0.06, ymL, 0.06
	if drLv < 3 then
		pen pT
		for i = 1 to nB
			circle2 bx[i], 0, r
		next i
	endif
	pen penEquip
	text2 ymL / 2, 0.15 + dT / 2, ymName
endif
hotspot2 0, 0
hotspot2 ymL, 0
