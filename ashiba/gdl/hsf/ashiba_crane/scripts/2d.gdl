! 移動式クレーン 2D: 車体・アウトリガ・敷鉄板・後端旋回半径（立入禁止）・作業半径の扇・ブームとフック・定格の注記・ホットスポット
! 文字の数は str(数, 1, 0)、小数は長さに余裕を（str(x, 1, 1) は平面図でこの部品の 2D を丸ごと消した。プレビューでは描けていた）
pen penEquip
define style "crT" "ＭＳ Ｐゴシック", texSiz, 1, 0
style "crT"
! 車体（キャリヤ）: 外形・前後のバンパー・タイヤ・旋回輪
rect2 -carRr, -carW / 2, carF, carW / 2
rect2 carF - 0.25, -carW / 2 + 0.15, carF, carW / 2 - 0.15
rect2 -carRr, -carW / 2 + 0.15, -carRr + 0.25, carW / 2 - 0.15
for i = 1 to nAx
	for s = -1 to 1 step 2
		rect2 ax[i] - whR, s * (carW / 2 - 0.02), ax[i] + whR, s * (carW / 2 - 0.02 - whW)
	next s
next i
circle2 0, 0, 0.9
for e = -1 to 1 step 2
	xo = outF
	if e < 0 then xo = -outR
	for s = -1 to 1 step 2
		lg = lFL
		if e > 0 and s < 0 then lg = lFR
		if e < 0 and s > 0 then lg = lRL
		if e < 0 and s < 0 then lg = lRR
		! アウトリガのビーム（箱 0.3 幅）・ジャッキ・フロート
		rect2 xo - 0.15, s * (carW / 2 - 0.2), xo + 0.15, s * lg
		circle2 xo, s * lg, 0.12
		rect2 xo - fltD / 2, s * lg - fltD / 2, xo + fltD / 2, s * lg + fltD / 2
		! 張出の寸法（車体の芯からジャッキまで mm）
		add2 xo + fltD / 2 + 0.15, s * lg
		rot2 -SYMB_ROTANGLE
		text2 0, 0, str(round_int(lg * 1000), 1, 0)
		del 2
		if plDraw then
			rect2 xo - plB / 2, s * lg - plA / 2, xo + plB / 2, s * lg + plA / 2
			if plN >= 2 then rect2 xo - plA / 2, s * lg - plB / 2, xo + plA / 2, s * lg + plB / 2
		endif
	next s
next e
! 立入禁止（上部旋回体の後端旋回半径）
circle2 0, 0, tailR
! 作業半径の扇（吊荷ごとの半径と、今のフックの半径。wrSpan 360 は円）
nC = nWr + 1
for i = 1 to nC
	rC = tipX
	if i <= nWr then rC = wr[i]
	if wrSpan >= 359.9 then
		circle2 0, 0, rC
	else
		arc2 0, 0, rC, wrDir - wrSpan / 2, wrDir + wrSpan / 2
	endif
	aT = wrDir
	if wrSpan >= 359.9 then aT = wrDir + 45
	if i <= nWr then
		add2 rC * cos(aT), rC * sin(aT)
		rot2 -SYMB_ROTANGLE
		text2 0, 0, "R" + str(round_int(rC * 1000), 1, 0)
		del 2
	endif
next i
if wrSpan < 359.9 then
	rM = tipX
	for i = 1 to nWr
		rM = max(rM, wr[i])
	next i
	line2 0, 0, rM * cos(wrDir - wrSpan / 2), rM * sin(wrDir - wrSpan / 2)
	line2 0, 0, rM * cos(wrDir + wrSpan / 2), rM * sin(wrDir + wrSpan / 2)
endif
! 上部旋回体とブーム（旋回角で回す）
rot2 slD
! 上部旋回体（後ろはカウンタウエイトの円弧＝後端旋回半径）・運転室（右前）
uw = min(upW / 2, tailR * 0.98)
xc = -sqr(tailR ^ 2 - uw ^ 2)
arc2 0, 0, tailR, 180 - asn(uw / tailR), 180 + asn(uw / tailR)
line2 xc, uw, 1.6, uw
line2 xc, -uw, 1.6, -uw
line2 1.6, -uw, 1.6, uw
line2 xc + 0.9, -uw, xc + 0.9, uw
rect2 0.1, -uw - 0.95, 2.0, -uw
line2 1.75, -uw - 0.95, 1.75, -uw
! ブーム（段ごとに細く、全段を重ねて描く）・ブームの先のシーブ・フック
nb = max(1, min(6, nBs))
for k = 1 to nb
	wk = bmW * (1 - 0.13 * (k - 1)) / 2
	xk = -pivB + (k - 1) * (bL - 1.2) / nb
	rect2 xk, -wk, tipX, wk
next k
rect2 tipX - 0.35, -bmW / 2, tipX + 0.25, bmW / 2
circle2 tipX, 0, 0.3
circle2 tipX, 0, 0.12
if ldOn and travel = 0 then rect2 tipX - 0.75, -0.75, tipX + 0.75, 0.75
! 作業半径のホットスポット（ブームの向きに引く）
hotspot2 0, 0, 1, hkR, 1 + 128
hotspot2 tipX, 0, 2, hkR, 2
hotspot2 -1, 0, 3, hkR, 3
del 1
! 定格の注記（フックの所）と機種・姿勢の注記（車体の後ろ）
xT = tipX * cos(slD)
yT = tipX * sin(slD)
dT = texSiz * GLOB_SCALE / 1000 * 1.6
if travel = 0 then
	sOk = ""
	if okL = 0 then sOk = " 超過"
	add2 xT, yT
	rot2 -SYMB_ROTANGLE
	text2 0, 0.6 + dT, "定格 " + str(rated, 5, 2) + "t×" + str(sfRate, 4, 2) + "＝" + str(capT, 5, 2) + "t"
	text2 0, 0.6, "吊荷 " + str(needT, 5, 2) + "t" + sOk
	del 2
endif
add2 -carRr - 1.0, 0
rot2 -SYMB_ROTANGLE
tS = "張出不足（性能表の最小の張出より狭い）"
if sI > 0 then tS = "性能表 張出 " + str(round_int(spT * 1000), 1, 0) + "（4脚の最小 " + str(round_int(spE * 500), 1, 0) + "×2）"
text2 0, -2 * dT, tS
text2 0, 0, crName
text2 0, -dT, "ブーム " + str(round_int(bL * 1000), 1, 0) + "・" + str(round_int(bA), 1, 0) + "°・R" + str(round_int(tipX * 1000), 1, 0)
del 2
! 旋回角のホットスポット（ブームの真ん中）と扇の向き
rH = max(2.0, tipX * 0.5)
hotspot2 0, 0, 4, slew, 6
hotspot2 rH, 0, 5, slew, 4
hotspot2 rH * cos(slD), rH * sin(slD), 6, slew, 5
rW = tipX * 1.1
hotspot2 0, 0, 7, wrDir, 6
hotspot2 rW, 0, 8, wrDir, 4
hotspot2 rW * cos(wrDir), rW * sin(wrDir), 9, wrDir, 5
! アウトリガ4脚のホットスポット（ジャッキの所を車体の横へ引く）
if travel = 0 then
	hid = 20
	for e = -1 to 1 step 2
		xo = outF
		if e < 0 then xo = -outR
		for s = -1 to 1 step 2
			hid = hid + 3
			if e > 0 and s > 0 then
				hotspot2 xo, 0, hid, oFL, 1 + 128
				hotspot2 xo, lFL, hid + 1, oFL, 2
				hotspot2 xo, -1, hid + 2, oFL, 3
			endif
			if e > 0 and s < 0 then
				hotspot2 xo, 0, hid, oFR, 1 + 128
				hotspot2 xo, -lFR, hid + 1, oFR, 2
				hotspot2 xo, 1, hid + 2, oFR, 3
			endif
			if e < 0 and s > 0 then
				hotspot2 xo, 0, hid, oRL, 1 + 128
				hotspot2 xo, lRL, hid + 1, oRL, 2
				hotspot2 xo, -1, hid + 2, oRL, 3
			endif
			if e < 0 and s < 0 then
				hotspot2 xo, 0, hid, oRR, 1 + 128
				hotspot2 xo, -lRR, hid + 1, oRR, 2
				hotspot2 xo, 1, hid + 2, oRR, 3
			endif
		next s
	next e
endif
hotspot2 0, 0
