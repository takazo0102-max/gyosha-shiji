! 移動式クレーン 3D（タダノ GR-250N・GR-500N・GR-700N の寸法の目安）
define material "cr_body" 2, 0.92, 0.93, 0.94
define material "cr_blue" 2, 0.15, 0.30, 0.60
define material "cr_boom" 2, 0.95, 0.95, 0.92
define material "cr_cw" 2, 0.30, 0.31, 0.33
define material "cr_steel" 2, 0.55, 0.57, 0.60
define material "cr_plate" 2, 0.35, 0.36, 0.38
define material "cr_tire" 2, 0.10, 0.10, 0.10
define material "cr_hook" 2, 0.95, 0.75, 0.10
define material "cr_load" 2, 0.70, 0.50, 0.30
define material "cr_glass" 2, 0.30, 0.45, 0.60
define material "cr_rim" 2, 0.80, 0.80, 0.78
resol 16
plH = plT * plN
! ---- 敷鉄板（アウトリガ1脚に plN 枚。2枚は十字）とフロート・ジャッキ・アウトリガのビーム ----
for e = -1 to 1 step 2
	xo = outF
	if e < 0 then xo = -outR
	for s = -1 to 1 step 2
		lg = lFL
		if e > 0 and s < 0 then lg = lFR
		if e < 0 and s > 0 then lg = lRL
		if e < 0 and s < 0 then lg = lRR
		xs = xo - (s < 0) * outSh
		yo = s * lg
		yp = s * lg
		material "cr_steel"
		add xs - 0.15, min(0, yo), 1.0
		block 0.3, abs(yo), 0.25
		del 1
		if plDraw then
			material "cr_plate"
			add xs - plB / 2, yp - plA / 2, 0
			block plB, plA, plT
			del 1
			if plN >= 2 then
				add xs - plA / 2, yp - plB / 2, plT
				block plA, plB, plT
				del 1
			endif
		endif
		material "cr_steel"
		zf = plH
		if travel then zf = 0.6
		if fltA > 0.01 then
			add xs - fltB / 2, yo - fltA / 2, zf
			block fltB, fltA, 0.06
			del 1
		else
			add xs, yo, zf
			cylind 0.06, fltD / 2
			del 1
		endif
		add xs, yo, zf + 0.06
		cylind 1.0 - zf - 0.06, 0.09
		del 1
	next s
next e
! ---- 車体（シャシ・タイヤ）----
material "cr_body"
add -carRr, -carW / 2 + 0.1, 0.75
block carL, carW - 0.2, 0.75
del 1
material "cr_blue"
add -carRr, -carW / 2 + 0.1, 0.75
block carL, 0.02, 0.3
del 1
add -carRr, carW / 2 - 0.12, 0.75
block carL, 0.02, 0.3
del 1
for i = 1 to nAx
	for s = -1 to 1 step 2
		! タイヤとホイール（リム）
		material "cr_tire"
		add ax[i], s * (carW / 2 - whW / 2 - 0.02), whR + 0.05
		rotx 90
		addz -whW / 2
		cylind whW, whR
		material "cr_rim"
		addz -0.01
		cylind whW + 0.02, whR * 0.55
		del 4
		! フェンダー（タイヤの上）
		material "cr_body"
		add ax[i] - whR - 0.1, s * (carW / 2 - 0.02) - (s + 1) * (whW + 0.06) / 2, 2 * whR + 0.08
		block 2 * whR + 0.2, whW + 0.06, 0.06
		del 1
	next s
next i
! バンパー（前後）
material "cr_cw"
add carL - carRr - 0.05, -carW / 2 + 0.15, 0.6
block 0.15, carW - 0.3, 0.35
del 1
add -carRr - 0.1, -carW / 2 + 0.15, 0.6
block 0.15, carW - 0.3, 0.35
del 1
! ---- 上部旋回体（旋回角 slew で回す）----
rotz slD
material "cr_steel"
add 0, 0, 1.5
cylind 0.2, 1.0
del 1
material "cr_body"
add -tailR + 0.7, -1.1, 1.7
block tailR - 0.7 + 1.0, 2.2, 0.9
del 1
! カウンタウエイト（段付き）とエンジンカバー
material "cr_cw"
add -tailR, -1.1, 1.7
block 0.7, 2.2, 0.75
del 1
add -tailR + 0.1, -1.0, 2.45
block 0.6, 2.0, 0.3
del 1
material "cr_body"
add -tailR + 0.75, 0.15, 2.6
block 1.3, 0.9, 0.35
del 1
material "cr_cw"
for i = 0 to 4
	add -tailR + 0.85 + i * 0.22, 0.16, 2.95
	block 0.12, 0.88, 0.02
	del 1
next i
! 運転室（右前。cbX0〜cbX1・ブームの右 cbY0〜cbY1）と窓
material "cr_body"
add cbX0, -cbY1, 1.7
block cbX1 - cbX0, cbY1 - cbY0, 1.65
del 1
material "cr_glass"
add cbX0 + 0.4 * (cbX1 - cbX0), -cbY1 - 0.005, 2.35
block 0.5 * (cbX1 - cbX0), 0.005, 0.85
del 1
add cbX1, -cbY1 + 0.05, 2.2
block 0.005, cbY1 - cbY0 - 0.1, 1.0
del 1
add cbX0 + 0.1, -cbY0, 2.4
block 0.3 * (cbX1 - cbX0), 0.005, 0.75
del 1
! 起伏シリンダ（旋回体からブームの 0.35 の所。太いシリンダと細いロッド）
material "cr_steel"
xe = -pivB + 0.35 * bL * cos(bA)
ze = pivH + 0.35 * bL * sin(bA)
x0q = 0.9
y0q = 0
z0q = 1.9
x1q = 0.9 + 0.6 * (xe - 0.9)
y1q = 0
z1q = 1.9 + 0.6 * (ze - 1.9)
rq = 0.13
gosub "seg3"
material "cr_rim"
x0q = x1q
z0q = z1q
x1q = xe
z1q = ze
rq = 0.07
gosub "seg3"
material "cr_steel"
! ブーム（根元から段ごとに細く）
add -pivB, 0, pivH
roty -bA
nS = max(1, min(8, nBs))
sL = bL / nS
for k = 1 to nS
	bw = bmW - (k - 1) * 0.06
	ov = 0
	if k > 1 then ov = 0.05
	! 箱形の段（角を落とした八角形の断面）
	material "cr_boom"
	bh = bw * 1.1
	cc = bw * 0.12
	add (k - 1) * sL - ov, 0, 0
	roty 90
	prism 8, sL + ov, 		-bh / 2, -bw / 2 + cc, -bh / 2 + cc, -bw / 2, bh / 2 - cc, -bw / 2, bh / 2, -bw / 2 + cc, 		bh / 2, bw / 2 - cc, bh / 2 - cc, bw / 2, -bh / 2 + cc, bw / 2, -bh / 2, bw / 2 - cc
	del 2
	! 段の先の継ぎ目の帯
	if k < nS then
		material "cr_steel"
		add k * sL - 0.08, -bw / 2 - 0.01, -bh / 2 - 0.01
		block 0.08, bw + 0.02, bh + 0.02
		del 1
	endif
next k
! ブームの先（ブームヘッドと3枚のシーブ）
material "cr_steel"
add bL - 0.3, -0.3, -0.35
block 0.45, 0.6, 0.7
del 1
for i = -1 to 1
	add bL + 0.1, i * 0.14 - 0.04, 0
	rotx -90
	cylind 0.08, 0.32
	del 2
next i
! ブーム長さのホットスポット（ブームに沿って引く）
hotspot 0, 0, 0, 11, boomL, 1 + 128
hotspot bL, 0, 0, 12, boomL, 2
hotspot -1, 0, 0, 13, boomL, 3
del 2
! ワイヤ・フック・吊り荷（旋回体の座標でブームの先の真下）
material "cr_steel"
for i = -1 to 1 step 2
	add tipX + i * 0.1, 0, hkD + 0.6
	cylind tipZ - hkD - 0.6, 0.012
	del 1
next i
! フックブロック（側板とシーブ）とフック
material "cr_hook"
add tipX - 0.25, -0.18, hkD
block 0.5, 0.04, 0.6
del 1
add tipX - 0.25, 0.14, hkD
block 0.5, 0.04, 0.6
del 1
material "cr_steel"
add tipX, -0.14, hkD + 0.42
rotx -90
cylind 0.28, 0.2
del 2
add tipX, 0, hkD - 0.2
cylind 0.2, 0.06
del 1
material "cr_hook"
add tipX, 0, hkD - 0.55
cone 0.35, 0.03, 0.08, 90, 90
del 1
! フックの高さのホットスポット
hotspot tipX, 0, 0, 14, hkZ, 1 + 128
hotspot tipX, 0, hkD, 15, hkZ, 2
hotspot tipX, 0, -1, 16, hkZ, 3
if ldOn and travel = 0 then
	zl = max(0.0, hkD - 2.6)
	material "cr_load"
	add tipX - 0.75, -0.75, zl
	block 1.5, 1.5, 1.0
	del 1
	! 玉掛けワイヤ（吊り荷の四隅からフックへ）
	material "cr_steel"
	for c = 0 to 3
		x0q = tipX - 0.7 + 1.4 * (c mod 2)
		y0q = -0.7 + 1.4 * int(c / 2)
		z0q = zl + 1.0
		x1q = tipX
		y1q = 0
		z1q = hkD - 0.35
		rq = 0.008
		gosub "seg3"
	next c
endif
del 1
end

"seg3":
	! (x0q, y0q, z0q) から (x1q, y1q, z1q) の円柱（半径 rq。向きは問わない）
	dxq = x1q - x0q
	dyq = y1q - y0q
	dzq = z1q - z0q
	hq = sqr(dxq ^ 2 + dyq ^ 2)
	lq = sqr(hq ^ 2 + dzq ^ 2)
	if lq > 0.001 then
		az = 0
		if hq > 0.0001 then
			if abs(dxq) < 0.0001 then
				az = 90
				if dyq < 0 then az = -90
			else
				az = atn(dyq / dxq)
				if dxq < 0 then az = az + 180
			endif
		endif
		el = 90
		if dzq < 0 then el = -90
		if hq > 0.0001 then el = atn(dzq / hq)
		add x0q, y0q, z0q
		rotz az
		roty 90 - el
		cylind lq, rq
		del 3
	endif
	return
