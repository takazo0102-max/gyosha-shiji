! 移動式クレーン 3D（タダノ GR-250N・GR-500N・GR-700N の寸法の目安）
define material "cr_body" 2, 0.92, 0.93, 0.94
define material "cr_blue" 2, 0.15, 0.30, 0.60
define material "cr_boom" 2, 0.95, 0.95, 0.92
define material "cr_cw" 2, 0.30, 0.31, 0.33
define material "cr_steel" 2, 0.55, 0.57, 0.60
define material "cr_plate" 2, 0.35, 0.36, 0.38
define material "cr_tire" 2, 0.10, 0.10, 0.10
define material "cr_hook" 2, 0.95, 0.75, 0.10
define material "cr_load" 2, 0.70, 0.50, 0.30
resol 16
plH = plT * plN
! ---- 敷鉄板（アウトリガ1脚に plN 枚。2枚は十字）とフロート・ジャッキ・アウトリガのビーム ----
for e = -1 to 1 step 2
	xo = outF
	if e < 0 then xo = -outR
	material "cr_steel"
	add xo - 0.15, -outW / 2, 1.0
	block 0.3, outW, 0.25
	del 1
	for s = -1 to 1 step 2
		yo = s * outW / 2
		material "cr_plate"
		add xo - plB / 2, yo - plA / 2, 0
		block plB, plA, plT
		del 1
		if plN >= 2 then
			add xo - plA / 2, yo - plB / 2, plT
			block plA, plB, plT
			del 1
		endif
		material "cr_steel"
		add xo, yo, plH
		cylind 0.06, fltD / 2
		addz 0.06
		cylind 1.0 - plH - 0.06, 0.09
		del 2
	next s
next e
! ---- 車体（シャシ・タイヤ）----
material "cr_body"
add -carRr, -carW / 2 + 0.1, 0.75
block carL, carW - 0.2, 0.75
del 1
material "cr_blue"
add -carRr, -carW / 2 + 0.1, 0.75
block carL, 0.02, 0.3
del 1
add -carRr, carW / 2 - 0.12, 0.75
block carL, 0.02, 0.3
del 1
material "cr_tire"
for i = 1 to nAx
	for s = -1 to 1 step 2
		add ax[i], s * (carW / 2 - whW / 2 - 0.02), whR + 0.05
		rotx 90
		addz -whW / 2
		cylind whW, whR
		del 3
	next s
next i
! ---- 上部旋回体（旋回角 slew で回す）----
rotz slew
material "cr_steel"
add 0, 0, 1.5
cylind 0.2, 1.0
del 1
material "cr_body"
add -tailR + 0.7, -1.1, 1.7
block tailR - 0.7 + 1.0, 2.2, 0.9
del 1
material "cr_cw"
add -tailR, -1.1, 1.7
block 0.7, 2.2, 1.0
del 1
! 運転室（右前）
material "cr_body"
add 0.2, -1.25, 1.7
block 1.9, 0.85, 1.65
del 1
material "cr_cw"
add 1.0, -1.255, 2.4
block 1.05, 0.005, 0.8
del 1
! 起伏シリンダ（旋回体からブームの 0.35 の所）
material "cr_steel"
x0q = 0.9
y0q = 0
z0q = 1.9
x1q = -pivB + 0.35 * boomL * cos(boomA)
y1q = 0
z1q = pivH + 0.35 * boomL * sin(boomA)
rq = 0.11
gosub "seg3"
! ブーム（根元から段ごとに細く）
add -pivB, 0, pivH
roty -boomA
nS = 4
if crType >= 2 then nS = 6
sL = boomL / nS
for k = 1 to nS
	bw = 0.78 - (k - 1) * 0.06
	if crType = 1 then bw = 0.62 - (k - 1) * 0.06
	ov = 0
	if k > 1 then ov = 0.05
	material "cr_boom"
	add (k - 1) * sL - ov, -bw / 2, -bw * 0.55
	block sL + ov, bw, bw * 1.1
	del 1
next k
! ブームの先（シーブ）
material "cr_steel"
add boomL, 0, 0
rotx 90
addz -0.2
cylind 0.4, 0.35
del 3
del 2
! ワイヤ・フック・吊り荷（旋回体の座標でブームの先の真下）
material "cr_steel"
add tipX, 0, hkZ + 0.6
cylind tipZ - hkZ - 0.6, 0.012
del 1
material "cr_hook"
add tipX - 0.25, -0.18, hkZ
block 0.5, 0.36, 0.6
del 1
material "cr_steel"
add tipX, 0, hkZ - 0.35
cylind 0.35, 0.05
del 1
if ldOn then
	zl = max(0.0, hkZ - 2.6)
	material "cr_load"
	add tipX - 0.75, -0.75, zl
	block 1.5, 1.5, 1.0
	del 1
	! 玉掛けワイヤ（吊り荷の四隅からフックへ）
	material "cr_steel"
	for c = 0 to 3
		x0q = tipX - 0.7 + 1.4 * (c mod 2)
		y0q = -0.7 + 1.4 * int(c / 2)
		z0q = zl + 1.0
		x1q = tipX
		y1q = 0
		z1q = hkZ - 0.35
		rq = 0.008
		gosub "seg3"
	next c
endif
del 1
end

"seg3":
	! (x0q, y0q, z0q) から (x1q, y1q, z1q) の円柱（半径 rq。向きは問わない）
	dxq = x1q - x0q
	dyq = y1q - y0q
	dzq = z1q - z0q
	hq = sqr(dxq ^ 2 + dyq ^ 2)
	lq = sqr(hq ^ 2 + dzq ^ 2)
	if lq > 0.001 then
		az = 0
		if hq > 0.0001 then
			if abs(dxq) < 0.0001 then
				az = 90
				if dyq < 0 then az = -90
			else
				az = atn(dyq / dxq)
				if dxq < 0 then az = az + 180
			endif
		endif
		el = 90
		if dzq < 0 then el = -90
		if hq > 0.0001 then el = atn(dzq / hq)
		add x0q, y0q, z0q
		rotz az
		roty 90 - el
		cylind lq, rq
		del 3
	endif
	return
