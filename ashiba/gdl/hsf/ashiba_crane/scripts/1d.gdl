! 移動式クレーン: 姿勢（作業半径・ブーム）・定格総荷重表・車軸（m）
dim wr[]
nWr = 0
rest = wrR
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nWr = nWr + 1
		wr[nWr] = v / 1000
	endif
endwhile
