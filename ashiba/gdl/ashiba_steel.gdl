nD = min(nD, nDT)

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 鉄骨のピース 2D: 断面の外形、ブラケットと継手の添え板、名前
pen penEquip
define style "spT" "ＭＳ Ｐゴシック", texSiz, 1, 0
style "spT"
if spK = 1 then
	rot2 spAng
	if spT = 3 then
		circle2 0, 0, spH / 2
	else
		rect2 -spH / 2, -spB / 2, spH / 2, spB / 2
	endif
	if bpOn then rect2 -spH / 2 - bpO, -spB / 2 - bpO, spH / 2 + bpO, spB / 2 + bpO
	if capOn then
		if spT = 3 then
			circle2 0, 0, spH / 2 + capO
		else
			rect2 -spH / 2 - capO, -spB / 2 - capO, spH / 2 + capO, spB / 2 + capO
		endif
	endif
	if dpK = 1 and nD > 0 then
		if spT = 3 then
			circle2 0, 0, spH / 2 + dpO
		else
			rect2 -spH / 2 - dpO, -spB / 2 - dpO, spH / 2 + dpO, spB / 2 + dpO
		endif
	endif
	del 1
	for i = 1 to nB
		rot2 qA[i]
		rect2 qS[i], -qB[i] / 2, qE[i], qB[i] / 2
		if uL[i] > 0 then rect2 qE[i] - uL[i] / 2, -uW[i] / 2, qE[i] + uL[i] / 2, uW[i] / 2
		del 1
	next i
	add2 -spH / 2, spB / 2 + bpO * bpOn + 0.3
	rot2 -SYMB_ROTANGLE
	text2 0, 0, pcName
	del 2
else
	rot2 spAng
	rect2 0, -spB / 2, spL, spB / 2
	add2 spL / 2, spB / 2 + 0.05
	text2 0, 0, pcName
	del 2
endif
hotspot2 0, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 鉄骨のピース 3D: 柱の節にブラケット・継手の添え板・ベースプレートが一体。梁は真ん中のピース
define material "sp_steel" 2, 0.62, 0.30, 0.16
define material "sp_plate" 2, 0.30, 0.55, 0.75
resol 16
sT = spT
sH = spH
sB = spB
sW = spW
sF = spF
rL = spL
material "sp_steel"
if spK = 1 then
	rotz spAng
	if bpOn then
		material "sp_plate"
		add -spH / 2 - bpO, -spB / 2 - bpO, -bpT
		block spH + 2 * bpO, spB + 2 * bpO, bpT
		del 1
		material "sp_steel"
	endif
	if capOn then
		! 柱頭の板: 管はこの板の下で止める
		material "sp_plate"
		if spT = 3 then
			addz capZ - capT
			cylind capT, spH / 2 + capO
			del 1
		else
			add -spH / 2 - capO, -spB / 2 - capO, capZ - capT
			block spH + 2 * capO, spB + 2 * capO, capT
			del 1
		endif
		material "sp_steel"
		rL = capZ - capT
	endif
	material "sp_plate"
	for j = 1 to nD
		zb = dZ[j] - dT[j] / 2
		if dpK = 1 then
			! 通しダイアフラム: 柱の外へ dpO 出す
			if spT = 3 then
				addz zb
				cylind dT[j], spH / 2 + dpO
				del 1
			else
				add -spH / 2 - dpO, -spB / 2 - dpO, zb
				block spH + 2 * dpO, spB + 2 * dpO, dT[j]
				del 1
			endif
		endif
		if dpK = 2 then
			! 内ダイアフラム: 柱の内側いっぱい
			if spT = 3 then
				addz zb
				cylind dT[j], spH / 2 - spF
				del 1
			else
				add -spH / 2 + spF, -spB / 2 + spF, zb
				block spH - 2 * spF, spB - 2 * spF, dT[j]
				del 1
			endif
		endif
		if dpK = 3 then
			! 水平スチフナ: H 形の柱のウェブの両側、フランジからフランジへ
			add -spH / 2 + spF, spW / 2, zb
			block spH - 2 * spF, spB / 2 - spW / 2, dT[j]
			del 1
			add -spH / 2 + spF, -spB / 2, zb
			block spH - 2 * spF, spB / 2 - spW / 2, dT[j]
			del 1
		endif
	next j
	material "sp_steel"
	roty -90
	gosub "run"
	del 2
	for i = 1 to nB
		add 0, 0, qZ[i]
		rotz qA[i]
		add qS[i], 0, 0
		sT = qT[i]
		sH = qH[i]
		sB = qB[i]
		sW = qW[i]
		sF = qF[i]
		rL = qE[i] - qS[i]
		material "sp_steel"
		gosub "run"
		if uL[i] > 0 then
			! 継手の添え板（ウェブ両面、フランジの外と内。ブラケットの先をまたぐ）
			material "sp_plate"
			for s = -1 to 1 step 2
				add rL - wW[i] / 2, s * (sW + wT[i]) / 2 - wT[i] / 2, -wH[i] / 2
				block wW[i], wT[i], wH[i]
				del 1
				add rL - uL[i] / 2, -uW[i] / 2, s * (sH + uT[i]) / 2 - uT[i] / 2
				block uL[i], uW[i], uT[i]
				del 1
				for y = -1 to 1 step 2
					add rL - uL[i] / 2, y * (sW / 2 + 0.005 + vW[i] / 2) - vW[i] / 2, s * (sH / 2 - sF - vT[i] / 2) - vT[i] / 2
					block uL[i], vW[i], vT[i]
					del 1
				next y
			next s
		endif
		del 3
	next i
else
	rotz spAng
	gosub "run"
	del 1
endif
end

"run":
	! 断面 sT を +X へ長さ rL 押し出す（z＝せい、y＝幅）
	if sT = 1 then
		add 0, -sB / 2, sH / 2 - sF
		block rL, sB, sF
		del 1
		add 0, -sB / 2, -sH / 2
		block rL, sB, sF
		del 1
		add 0, -sW / 2, -sH / 2 + sF
		block rL, sW, sH - 2 * sF
		del 1
	endif
	if sT = 2 then
		add 0, -sB / 2, sH / 2 - sF
		block rL, sB, sF
		del 1
		add 0, -sB / 2, -sH / 2
		block rL, sB, sF
		del 1
		add 0, -sB / 2, -sH / 2 + sF
		block rL, sW, sH - 2 * sF
		del 1
		add 0, sB / 2 - sW, -sH / 2 + sF
		block rL, sW, sH - 2 * sF
		del 1
	endif
	if sT = 3 then
		roty 90
		cylind rL, sH / 2
		del 1
	endif
	if sT = 0 then
		add 0, -sB / 2, -sH / 2
		block rL, sB, sH
		del 1
	endif
return

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 鉄骨のピース: 値の一覧は無い

