endwhile
nB = min(nB, min(nZ, min(nS, min(nE, min(nT, min(nH, min(nW, min(nX, nF))))))))
nB = min(nB, min(n1, min(n2, min(n3, min(n4, min(n5, min(n6, min(n7, n8))))))))
dim dZ[]
nD = 0
rest = dpZ
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
