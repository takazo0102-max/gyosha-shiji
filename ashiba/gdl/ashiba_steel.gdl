! ==========================================================
! 鉄骨の建て方のピース（柱の節にブラケット・ガセット・ベースプレートが一体、または梁の真ん中） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_steel/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_steel.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定 2026-11-07。柱は階の高さ＋1m で切り、梁は柱の中心からの距離で切る。割り方と重量は steel_erection.py、置くのは scripts/steel_run.py。
! 原点: 柱のピースは下端の芯、梁のピースは始めの中心。spK 1 柱・2 梁、spT 0 外形・1 H・2 角形・3 丸、ブラケットは brA・brZ・brS・brE ほか。重量 pcW は揚重判定が読む。
! ----------------------------------------------------------
! パラメータリスト:
!   spK       整数      ピース（1 柱・2 梁）                      既定 1
!   spT       整数      断面（0 外形・1 H・2 角形・3 丸）         既定 2
!   spH       長さ      せい                                      既定 0.5
!   spB       長さ      幅                                        既定 0.5
!   spW       長さ      ウェブの厚さ                              既定 0.022
!   spF       長さ      フランジの厚さ                            既定 0.022
!   spL       長さ      長さ                                      既定 4.0
!   spAng     角度      向き                                      既定 0.0
!   bpOn      ブール    ベースプレート                            既定 0
!   bpO       長さ      ベースプレートのはみ出し                  既定 0.1
!   bpT       長さ      ベースプレートの厚さ                      既定 0.036
!   gpW       長さ      ガセットプレートの幅                      既定 0.3
!   gpT       長さ      ガセットプレートの厚さ                    既定 0.012
!   brA       文字列    ブラケットの向き（度。カンマ区切り）      既定 ""
!   brZ       文字列    ブラケットの高さ（mm。ピースの下端から）  既定 ""
!   brS       文字列    柱の中心から根元（mm）                    既定 ""
!   brE       文字列    柱の中心から先（mm）                      既定 ""
!   brT       文字列    ブラケットの断面の種類                    既定 ""
!   brH       文字列    ブラケットのせい（mm）                    既定 ""
!   brB       文字列    ブラケットの幅（mm）                      既定 ""
!   brW       文字列    ブラケットのウェブ（mm）                  既定 ""
!   brF       文字列    ブラケットのフランジ（mm）                既定 ""
!   pcW       実数      ピースの重量（t）                         既定 0.0
!   pcName    文字列    ピースの名前（注記）                      既定 ""
!   texSiz    実数      文字の大きさ（mm）                        既定 2.5
!   penEquip  PenColor  線のペン                                  既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 鉄骨のピース: ブラケットの並び（m・度）
dim qA[]
nB = 0
rest = brA
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nB = nB + 1
		qA[nB] = v / 1
	endif
endwhile
dim qZ[]
nZ = 0
rest = brZ
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nZ = nZ + 1
		qZ[nZ] = v / 1000
	endif
endwhile
dim qS[]
nS = 0
rest = brS
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nS = nS + 1
		qS[nS] = v / 1000
	endif
endwhile
dim qE[]
nE = 0
rest = brE
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nE = nE + 1
		qE[nE] = v / 1000
	endif
endwhile
dim qT[]
nT = 0
rest = brT
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nT = nT + 1
		qT[nT] = v / 1
	endif
endwhile
dim qH[]
nH = 0
rest = brH
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nH = nH + 1
		qH[nH] = v / 1000
	endif
endwhile
dim qB[]
nW = 0
rest = brB
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nW = nW + 1
		qB[nW] = v / 1000
	endif
endwhile
dim qW[]
nX = 0
rest = brW
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nX = nX + 1
		qW[nX] = v / 1000
	endif
endwhile
dim qF[]
nF = 0
rest = brF
while strlen(rest) > 0 do
	pc = strstr(rest, ",")
	if pc > 0 then
		item = strsub(rest, 1, pc - 1)
		rest = strsub(rest, pc + 1, strlen(rest) - pc)
	else
		item = rest
		rest = ""
	endif
	k = split(item, "%n", v)
	if k > 0 then
		nF = nF + 1
		qF[nF] = v / 1000
	endif
endwhile
nB = min(nB, min(nZ, min(nS, min(nE, min(nT, min(nH, min(nW, min(nX, nF))))))))

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 鉄骨のピース 2D: 断面の外形、ブラケットとガセット、名前
pen penEquip
define style "spT" "ＭＳ Ｐゴシック", texSiz, 1, 0
style "spT"
if spK = 1 then
	rot2 spAng
	if spT = 3 then
		circle2 0, 0, spH / 2
	else
		rect2 -spH / 2, -spB / 2, spH / 2, spB / 2
	endif
	if bpOn then rect2 -spH / 2 - bpO, -spB / 2 - bpO, spH / 2 + bpO, spB / 2 + bpO
	del 1
	for i = 1 to nB
		rot2 qA[i]
		rect2 qS[i], -qB[i] / 2, qE[i], qB[i] / 2
		line2 qE[i] - gpW / 2, -gpT / 2, qE[i] + gpW / 2, -gpT / 2
		line2 qE[i] - gpW / 2, gpT / 2, qE[i] + gpW / 2, gpT / 2
		line2 qE[i] + gpW / 2, -gpT / 2, qE[i] + gpW / 2, gpT / 2
		del 1
	next i
	add2 -spH / 2, spB / 2 + bpO * bpOn + 0.3
	rot2 -SYMB_ROTANGLE
	text2 0, 0, pcName
	del 2
else
	rot2 spAng
	rect2 0, -spB / 2, spL, spB / 2
	add2 spL / 2, spB / 2 + 0.05
	text2 0, 0, pcName
	del 2
endif
hotspot2 0, 0

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 鉄骨のピース 3D: 柱の節にブラケット・ガセット・ベースプレートが一体。梁は真ん中のピース
define material "sp_steel" 2, 0.62, 0.30, 0.16
define material "sp_plate" 2, 0.30, 0.55, 0.75
resol 16
sT = spT
sH = spH
sB = spB
sW = spW
sF = spF
rL = spL
material "sp_steel"
if spK = 1 then
	rotz spAng
	if bpOn then
		material "sp_plate"
		add -spH / 2 - bpO, -spB / 2 - bpO, -bpT
		block spH + 2 * bpO, spB + 2 * bpO, bpT
		del 1
		material "sp_steel"
	endif
	roty -90
	gosub "run"
	del 2
	for i = 1 to nB
		add 0, 0, qZ[i]
		rotz qA[i]
		add qS[i], 0, 0
		sT = qT[i]
		sH = qH[i]
		sB = qB[i]
		sW = qW[i]
		sF = qF[i]
		rL = qE[i] - qS[i]
		material "sp_steel"
		gosub "run"
		material "sp_plate"
		gH = max(0.05, sH - 2 * sF - 0.04)
		add rL - gpW / 2, -gpT / 2, -gH / 2
		block gpW, gpT, gH
		del 1
		del 3
	next i
else
	rotz spAng
	gosub "run"
	del 1
endif
end

"run":
	! 断面 sT を +X へ長さ rL 押し出す（z＝せい、y＝幅）
	if sT = 1 then
		add 0, -sB / 2, sH / 2 - sF
		block rL, sB, sF
		del 1
		add 0, -sB / 2, -sH / 2
		block rL, sB, sF
		del 1
		add 0, -sW / 2, -sH / 2 + sF
		block rL, sW, sH - 2 * sF
		del 1
	endif
	if sT = 2 then
		add 0, -sB / 2, sH / 2 - sF
		block rL, sB, sF
		del 1
		add 0, -sB / 2, -sH / 2
		block rL, sB, sF
		del 1
		add 0, -sB / 2, -sH / 2 + sF
		block rL, sW, sH - 2 * sF
		del 1
		add 0, sB / 2 - sW, -sH / 2 + sF
		block rL, sW, sH - 2 * sF
		del 1
	endif
	if sT = 3 then
		roty 90
		cylind rL, sH / 2
		del 1
	endif
	if sT = 0 then
		add 0, -sB / 2, -sH / 2
		block rL, sB, sH
		del 1
	endif
return

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 鉄骨のピース: 値の一覧は無い

