! ==========================================================
! 水平ネット（躯体と足場の隙間・1面1層に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_net/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_net.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 足場条件の「水平ネットの層」で指定した層に、面ごとに置く。平面は網目の格子、3Dは面とロープ。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度      面の向き（度。配置時に Python が入れる。+X=面に沿う方向、+Y=躯体側）  既定 0
!   zH        長さ      高さ（GLから）                                                        既定 3.6
!   lineMode  ブール    3Dを線で（軽い）                                                      既定 0
!   netL      長さ      長さ（面に沿う方向）                                                  既定 1.8
!   netW      長さ      幅（建地から躯体側へ）                                                既定 0.25
!   matNet    表面材    表面材（0＝既定）                                                     既定 0
!   netName   文字列    名称                                                                  既定 "水平ネット"
!   penNet    PenColor  ペン: 層間ネット                                                      既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 水平ネット（躯体と足場の隙間に水平に張る落下防止ネット）。1つの面・1つの層に1部品

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! ============================================================
! 水平ネット 2D（平面）: 範囲の枠と網目（塗りつぶし「タイル-クロス」）。参考図の「落下防止養生ネット張り」の表記
! ============================================================
pN = penNet
if pN < 1 then pN = 1
pen pN
rot2 faceAng
! 網は塗りつぶし「タイル-クロス」で表す（利用者の指定 2026-10-24: ネットの塗りつぶし平面表記はタイルクロスにして）。
! 塗りつぶしがプロジェクトに無いときは、以前の斜めの網目の線で描く
fiNet = IND(FILL, "タイル-クロス")
if fiNet > 0 then
	fill fiNet
	poly2_b 5, 7, pN, 0,
		0, 0, 1,
		netL, 0, 1,
		netL, netW, 1,
		0, netW, 1,
		0, 0, -1
else
	rect2 0, 0, netL, netW
	nx = int(netL / 0.5)
	for i = 1 to nx
		x1 = i * 0.5
		if x1 - netW >= 0 then
			line2 x1, 0, x1 - netW, netW
		else
			line2 x1, 0, 0, x1
		endif
	next i
endif
hotspot2 0, 0
hotspot2 netL, 0
hotspot2 netL, netW
hotspot2 0, netW
del 1

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 水平ネット 3D: 網（網糸を両方向に格子で）と周囲のロープ φ12。面材（板）にすると
! 踏板（アンチ）と見分けが付かない（利用者の指摘 2026-10-20）ので、面は張らず網目で見せる。
! 実物の目合いは 15〜25mm。図では 100mm 目に粗くして軽くする（長い面は本数の上限で目を広げる）
! ============================================================
pen 1
resol 6
rotz faceAng
addz zH
if lineMode then
	lin_ 0, 0, 0, netL, 0, 0
	lin_ netL, 0, 0, netL, netW, 0
	lin_ netL, netW, 0, 0, netW, 0
	lin_ 0, netW, 0, 0, 0, 0
	lin_ 0, 0, 0, netL, netW, 0
else
	if matNet > 0 then
		material matNet
	else
		! 表面材の指定が無ければ、養生ネットらしい緑
		define material "ashiba_net_green" 1, 0.12, 0.52, 0.24
		material "ashiba_net_green"
	endif
	! 周囲のロープ（四辺）
	for k = 0 to 1
		add 0, k * netW, 0
		roty 90
		cylind netL, 0.006
		del 2
		add k * netL, 0, 0
		rotx -90
		cylind netW, 0.006
		del 2
	next k
	! 網糸（4mm 角）
	pm = 0.10
	if netL / pm > 150 then pm = netL / 150
	ni = max(2, int(netL / pm + 0.5))
	for i = 1 to ni - 1
		add i * netL / ni - 0.002, 0, -0.002
		block 0.004, netW, 0.004
		del 1
	next i
	nj = max(2, int(netW / pm + 0.5))
	for j = 1 to nj - 1
		add 0, j * netW / nj - 0.002, -0.002
		block netL, 0.004, 0.004
		del 1
	next j
endif
hotspot 0, 0, 0
hotspot netL, netW, 0
del 2

