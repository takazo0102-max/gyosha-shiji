! ==========================================================
! 仮設通路（アルミ製の伸縮通路 日工セック ライトブリッジ・1本に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_walkway/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_walkway.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 利用者の指定（2026-10-29）: https://www.nikkosec.co.jp/page-73/ 次足場はこういうのにも対応できるようにしたい。
! 原点＝始めの島の布材の上の通路の芯、faceAng で通路の向き、wkL で長さ、zDeck・zEnd で両端の床の高さ（差があれば傾ける）。床幅 660・外枠 766・全幅 915、手すり 966・中桟 484・幅木 125、2段の伸縮と両端のフック。両端の島は部品 ashiba_stage。
! ----------------------------------------------------------
! パラメータリスト:
!   faceAng   角度      通路の向き（度。+X＝始めの島から終わりの島へ）  既定 0
!   wkL       長さ      長さ（島の布材の間・平面）                      既定 5
!   zDeck     長さ      始めの床の高さ（階の高さから）                  既定 1.8
!   zEnd      長さ      終わりの床の高さ（同上。差があれば傾けて渡す）  既定 1.8
!   wkModel   文字列    機種（data/walkway_models.csv）                 既定 "LB-4556"
!   deckW     長さ      床幅（縞板）                                    既定 0.66
!   frW       長さ      外枠の幅                                        既定 0.766
!   ovW       長さ      全幅（手すりの外まで）                          既定 0.915
!   railSp    長さ      手すりの間（芯々）                              既定 0.854
!   railH     長さ      手すりの高さ（床から）                          既定 0.966
!   midH      長さ      中桟の高さ（床から）                            既定 0.484
!   toeH      長さ      幅木の高さ                                      既定 0.125
!   stName    文字列    通路の名前                                      既定 "仮設通路"
!   showText  ブール    平面に機種と長さを書く                          既定 1
!   matAl     表面材    アルミの材質（0＝アルミの色）                   既定 0
!   texSiz    実数      文字の大きさ（mm）                              既定 2.5
!   penEquip  PenColor  線のペン                                        既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 仮設通路: 伸縮の継ぎ目（外の枠の終わり・内の枠の始め。長さの比で描く）
L = max(0.5, wkL)
xJ0 = L * 0.45
xJ1 = L * 0.55

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 仮設通路 2D（平面）: 全幅の外形・床幅・手すり・伸縮の継ぎ目・両端のフック・機種と長さ
define style "wkTx" "ＭＳ Ｐゴシック", texSiz, 5, 0
pE = penEquip
if pE < 1 then pE = 1
pen pE
rot2 faceAng
hotspot2 0, 0
hotspot2 L, 0
line_type 1
rect2 0, -ovW / 2, L, ovW / 2
line2 0, -deckW / 2, L, -deckW / 2
line2 0, deckW / 2, L, deckW / 2
line2 0, -railSp / 2, L, -railSp / 2
line2 0, railSp / 2, L, railSp / 2
line2 xJ0, -frW / 2, xJ0, frW / 2
line2 xJ1, -frW / 2, xJ1, frW / 2
! 両端のフック（布材に掛ける所）
for sd = -1 to 1 step 2
	rect2 -0.08, sd * frW / 2 - 0.05, 0, sd * frW / 2 - 0.03
	rect2 L, sd * frW / 2 - 0.05, L + 0.08, sd * frW / 2 - 0.03
next sd
! 向き（始め→終わり）
line2 L / 2 - 0.25, 0, L / 2 + 0.25, 0
line2 L / 2 + 0.25, 0, L / 2 + 0.15, 0.06
line2 L / 2 + 0.25, 0, L / 2 + 0.15, -0.06
if showText then
	style "wkTx"
	text2 L / 2, ovW / 2 + 0.15, "仮設通路 " + wkModel + " L=" + str(L * 1000, 4, 0)
endif

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! ============================================================
! 仮設通路 3D（日工セック ライトブリッジ）。利用者の指定 2026-10-29: 次足場はこういうのにも対応できるようにしたい
! 外の枠（始め側）の中を内の枠（終わり側）が滑る2段の伸縮。両端のフックを島の布材に掛ける
! ============================================================
resol 10
define material "wk_al" 2, 0.80, 0.82, 0.85
define material "wk_toe" 2, 0.95, 0.80, 0.15
mAl = IND(MATERIAL, "wk_al")
if matAl > 0 then mAl = matAl
mTo = IND(MATERIAL, "wk_toe")
dz = zEnd - zDeck
Ls = sqr(L * L + dz * dz)
sl = atn(dz / L)
x0 = Ls * 0.45
x1 = Ls * 0.55
gW = 0.05            ! 桁の幅
gH = 0.12            ! 桁の高さ（床の上端から下へ）
hw = frW / 2
rotz faceAng
add 0, 0, zDeck
roty -sl
material mAl
! ---- 桁（外の枠は 0〜x1、内の枠は x0〜Ls で外の枠の内側） ----
for sd = -1 to 1 step 2
	add 0, sd * (hw - gW / 2) - gW / 2, -gH
	block x1, gW, gH
	del 1
	add x0, sd * (hw - gW * 1.5) - gW / 2, -gH + 0.01
	block Ls - x0, gW, gH - 0.02
	del 1
next sd
! ---- 床（縞板）と横の桟 ----
add 0, -deckW / 2, -0.004
block x1, deckW, 0.004
del 1
add x1, -deckW / 2 + gW, -0.010
block Ls - x1, deckW - 2 * gW, 0.006
del 1
nC = max(2, int(Ls / 0.6) + 1)
for k = 0 to nC
	xc = min(Ls - 0.03, k * Ls / nC)
	add xc, -hw + gW, -gH + 0.02
	block 0.03, frW - 2 * gW, 0.04
	del 1
next k
! ---- フック（両端。布材の上に掛けて下へ曲がる） ----
for sd = -1 to 1 step 2
	for en = 0 to 1
		if en = 0 then
			xh = -0.08
		else
			xh = Ls
		endif
		add xh, sd * (hw - 0.04) - 0.006, -0.012
		block 0.08, 0.012, 0.012
		del 1
		if en = 0 then
			add xh, sd * (hw - 0.04) - 0.006, -0.10
		else
			add xh + 0.068, sd * (hw - 0.04) - 0.006, -0.10
		endif
		block 0.012, 0.012, 0.09
		del 1
	next en
next sd
! ---- 手すり（両側。支柱は 1.2m 以内ごと、手すり・中桟・幅木） ----
nP = max(1, int(Ls / 1.2 + 0.99))
for sd = -1 to 1 step 2
	yR = sd * railSp / 2
	for k = 0 to nP
		add min(Ls - 0.02, max(0.02, k * Ls / nP)), yR, 0
		cylind railH, 0.017
		del 1
	next k
	for hh = 1 to 2
		if hh = 1 then
			zr = railH
		else
			zr = midH
		endif
		add 0.02, yR, zr
		roty 90
		cylind Ls - 0.04, 0.0175
		del 2
	next hh
	material mTo
	add 0.02, yR - sd * 0.03 - 0.014, 0
	block Ls - 0.04, 0.028, toeH
	del 1
	material mAl
next sd
del 3
end

