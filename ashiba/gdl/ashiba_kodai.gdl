! ==========================================================
! 乗入れ構台・荷取り構台（覆工板・根太・大引・支柱・水平つなぎ・垂直ブレース・手すり・スロープ。1つの構台に1部品） 単一ファイル参照版
! ----------------------------------------------------------
! このファイルは gdl/hsf/ashiba_kodai/ から自動生成しています。
! 直接編集しないでください。HSF側を直してから再生成します:
!   python3 scripts/build_flat_gdl.py
!
! 通しで読む・差分を見るための参照用で、そのままでは動きません
! （実際に読み込むのは gdl/ashiba_kodai.gsm）。各セクションはArchicadの
! 対応するスクリプト欄にそのまま貼れます。
! ----------------------------------------------------------
! 開発ループ（2026-11-01）: 他に必要な仮設材の2番。
! 原点＝床の隅の地盤、+X＝進行方向。覆工板 1m×dkLen を並べ、根太（secJ）は dkLen ごとに X へ、大引（secG）・支柱（secP）は縁から ovh の内側を spMax 以内で等分した格子。支柱は根切り底（dig）から根入れ emb、水平つなぎは tieP 以内、垂直ブレースは外周の構面に X 形、手すりは railS・railN・railE・railW、入口にスロープ 1/slopeN。広さ lenX・lenY は平面のホットスポットで引き、1m・覆工板の長さの倍数に切り上げる。検定は kodai.py、置くのは scripts/kodai_run.py。
! ----------------------------------------------------------
! パラメータリスト:
!   dk3       整数      3m の覆工板の列の数（−1＝自動: 幅が奇数 m なら1列。残りは 2m）   既定 -1
!   dk3At     整数      3m の列の位置（手前から何列目）                                  既定 1
!   spMax     長さ      支柱の間隔の上限                                                 既定 6.0
!   ovh       長さ      張出し（縁から支柱まで）                                         既定 1.0
!   lenX      長さ      長さ X（進行方向。ホットスポットで引く。1m の倍数に切り上げる）  既定 30.0
!   lenY      長さ      幅 Y（同上。覆工板の長さの倍数に）                               既定 8.0
!   zTop      長さ      床の上端（地盤から）                                             既定 0.5
!   dig       長さ      根切り底（地盤から下へ）                                         既定 6.3
!   emb       長さ      支柱の根入れ（根切り底から下へ）                                 既定 4.7
!   secJ      整数      根太の H形鋼（一覧で選ぶ）                                       既定 5
!   secG      整数      大引の H形鋼（一覧で選ぶ）                                       既定 5
!   secP      整数      支柱（構台杭）の H形鋼（一覧で選ぶ）                             既定 4
!   tieP      長さ      水平つなぎの段の間隔の上限                                       既定 3.0
!   slopeN    実数      スロープの勾配 1/n（0＝なし。入口 X0 の側）                      既定 8.0
!   railS     ブール    手すり 手前（Y0）                                                既定 1
!   railN     ブール    手すり 奥（Y 最大）                                              既定 1
!   railE     ブール    手すり 先（X 最大）                                              既定 1
!   railW     ブール    手すり 入口（X0）                                                既定 0
!   showDeck  ブール    覆工板を 3D に描く                                               既定 1
!   gAuto     ブール    支柱の列・行を自動で等分（ホットスポットで動かすと外れる）       既定 1
!   nGX       整数      支柱の列の数（X。2〜16）                                         既定 4
!   gX1       長さ      支柱の列 1 の X（大引も）                                        既定 0.0
!   gX2       長さ      支柱の列 2 の X（大引も）                                        既定 0.0
!   gX3       長さ      支柱の列 3 の X（大引も）                                        既定 0.0
!   gX4       長さ      支柱の列 4 の X（大引も）                                        既定 0.0
!   gX5       長さ      支柱の列 5 の X（大引も）                                        既定 0.0
!   gX6       長さ      支柱の列 6 の X（大引も）                                        既定 0.0
!   gX7       長さ      支柱の列 7 の X（大引も）                                        既定 0.0
!   gX8       長さ      支柱の列 8 の X（大引も）                                        既定 0.0
!   gX9       長さ      支柱の列 9 の X（大引も）                                        既定 0.0
!   gX10      長さ      支柱の列 10 の X（大引も）                                       既定 0.0
!   gX11      長さ      支柱の列 11 の X（大引も）                                       既定 0.0
!   gX12      長さ      支柱の列 12 の X（大引も）                                       既定 0.0
!   gX13      長さ      支柱の列 13 の X（大引も）                                       既定 0.0
!   gX14      長さ      支柱の列 14 の X（大引も）                                       既定 0.0
!   gX15      長さ      支柱の列 15 の X（大引も）                                       既定 0.0
!   gX16      長さ      支柱の列 16 の X（大引も）                                       既定 0.0
!   nGY       整数      支柱の行の数（Y。2〜8）                                          既定 2
!   gY1       長さ      支柱の行 1 の Y                                                  既定 0.0
!   gY2       長さ      支柱の行 2 の Y                                                  既定 0.0
!   gY3       長さ      支柱の行 3 の Y                                                  既定 0.0
!   gY4       長さ      支柱の行 4 の Y                                                  既定 0.0
!   gY5       長さ      支柱の行 5 の Y                                                  既定 0.0
!   gY6       長さ      支柱の行 6 の Y                                                  既定 0.0
!   gY7       長さ      支柱の行 7 の Y                                                  既定 0.0
!   gY8       長さ      支柱の行 8 の Y                                                  既定 0.0
!   lAuto     ブール    水平つなぎの段を自動で（3D のホットスポットで動かすと外れる）    既定 1
!   nLvP      整数      水平つなぎの段の数（1〜8）                                       既定 3
!   lvD1      長さ      水平つなぎ 1 段目（床の上端から下へ）                            既定 0.0
!   lvD2      長さ      水平つなぎ 2 段目（床の上端から下へ）                            既定 0.0
!   lvD3      長さ      水平つなぎ 3 段目（床の上端から下へ）                            既定 0.0
!   lvD4      長さ      水平つなぎ 4 段目（床の上端から下へ）                            既定 0.0
!   lvD5      長さ      水平つなぎ 5 段目（床の上端から下へ）                            既定 0.0
!   lvD6      長さ      水平つなぎ 6 段目（床の上端から下へ）                            既定 0.0
!   lvD7      長さ      水平つなぎ 7 段目（床の上端から下へ）                            既定 0.0
!   lvD8      長さ      水平つなぎ 8 段目（床の上端から下へ）                            既定 0.0
!   kdVeh     文字列    重機（検定用。T25・R20・R25・R40・R65・C50）                     既定 "R25"
!   kdLoad    実数      吊荷 t（検定用）                                                 既定 3.0
!   kdN       実数      支柱の先の N 値（検定用）                                        既定 20.0
!   kdName    文字列    名前（注記）                                                     既定 "構台"
!   maxLd     文字列    最大積載荷重の注記                                               既定 "最大積載荷重 28.6t"
!   texSiz    実数      文字の大きさ（mm）                                               既定 2.5
!   penEquip  PenColor  線のペン                                                         既定 1
! ==========================================================

! ==========================================================
! ==== マスタースクリプト ====
! ==========================================================
! 乗入れ構台: 割付（src/ashiba/kodai.py の layout と同じ）。H形鋼は kodai.H_SECTIONS の並び
dim secH[10], secB[10], secW[10], secF[10]
secH[1] = 0.200
secB[1] = 0.200
secW[1] = 0.008
secF[1] = 0.0120
secH[2] = 0.250
secB[2] = 0.250
secW[2] = 0.009
secF[2] = 0.0140
secH[3] = 0.300
secB[3] = 0.300
secW[3] = 0.010
secF[3] = 0.0150
secH[4] = 0.350
secB[4] = 0.350
secW[4] = 0.012
secF[4] = 0.0190
secH[5] = 0.400
secB[5] = 0.400
secW[5] = 0.013
secF[5] = 0.0210
secH[6] = 0.414
secB[6] = 0.405
secW[6] = 0.018
secF[6] = 0.0280
secH[7] = 0.428
secB[7] = 0.407
secW[7] = 0.020
secF[7] = 0.0350
secH[8] = 0.488
secB[8] = 0.300
secW[8] = 0.011
secF[8] = 0.0180
secH[9] = 0.588
secB[9] = 0.300
secW[9] = 0.012
secF[9] = 0.0200
secH[10] = 0.594
secB[10] = 0.302
secW[10] = 0.014
secF[10] = 0.0230
kJ = max(1, min(10, secJ))
kG = max(1, min(10, secG))
kP = max(1, min(10, secP))
dkH = 0.208
! 広さ（X は 1m、Y は覆工板の長さの倍数）
nDX = max(1, ceil(lenX - 0.02))
lx = nDX
! 覆工板の列（Y の手前から。2m が基本、幅の端数に 3m。kodai.deck_rows と同じ）
if dk3 < 0 then
	wm = max(2, ceil(lenY - 0.02))
	n3 = wm - 2 * int(wm / 2)
	n2 = (wm - 3 * n3) / 2
else
	n3 = dk3
	n2 = max(0, ceil((lenY - 3 * n3) / 2 - 0.01))
	if n2 + n3 = 0 then n2 = 1
endif
nDY = n2 + n3
k3 = max(1, min(dk3At, n2 + 1))
dim rw[], ry[]
ry[1] = 0
for j = 1 to nDY
	rw[j] = 2
	if j >= k3 and j < k3 + n3 then rw[j] = 3
	ry[j + 1] = ry[j] + rw[j]
next j
ly = ry[nDY + 1]
! 支柱の格子の自動（縁から ovh の内側を spMax 以内で等分）
spM = max(1, spMax)
inX = max(lx - 2 * ovh, 0)
inY = max(ly - 2 * ovh, 0)
nBX = min(15, max(1, ceil(inX / spM - 0.000001)))
nBY = min(7, max(1, ceil(inY / spM - 0.000001)))
nAX = nBX + 1
nAY = nBY + 1
dim axp[16], ayp[8]
for i = 1 to nAX
	axp[i] = ovh + inX * (i - 1) / nBX
next i
for j = 1 to nAY
	ayp[j] = ovh + inY * (j - 1) / nBY
next j
! 使う列・行（自動か、ホットスポットで動かした gX・gY）。並べ替えて gx・gy に
dim px0[16], py0[8]
px0[1] = gX1
px0[2] = gX2
px0[3] = gX3
px0[4] = gX4
px0[5] = gX5
px0[6] = gX6
px0[7] = gX7
px0[8] = gX8
px0[9] = gX9
px0[10] = gX10
px0[11] = gX11
px0[12] = gX12
px0[13] = gX13
px0[14] = gX14
px0[15] = gX15
px0[16] = gX16
py0[1] = gY1
py0[2] = gY2
py0[3] = gY3
py0[4] = gY4
py0[5] = gY5
py0[6] = gY6
py0[7] = gY7
py0[8] = gY8
dim gx[], gy[]
if gAuto then
	nPX = nAX
	nPY = nAY
	for i = 1 to nPX
		gx[i] = axp[i]
	next i
	for j = 1 to nPY
		gy[j] = ayp[j]
	next j
else
	nPX = max(2, min(16, nGX))
	nPY = max(2, min(8, nGY))
	for i = 1 to nPX
		gx[i] = max(0, min(lx, px0[i]))
	next i
	for j = 1 to nPY
		gy[j] = max(0, min(ly, py0[j]))
	next j
endif
for i = 2 to nPX
	for m = i to 2 step -1
		if gx[m] < gx[m - 1] then
			tq = gx[m]
			gx[m] = gx[m - 1]
			gx[m - 1] = tq
		endif
	next m
next i
for j = 2 to nPY
	for m = j to 2 step -1
		if gy[m] < gy[m - 1] then
			tq = gy[m]
			gy[m] = gy[m - 1]
			gy[m - 1] = tq
		endif
	next m
next j
nBX = nPX - 1
nBY = nPY - 1
! 高さ: 床の上端 zTop → 覆工板 → 根太 → 大引 → 支柱の天端
zJt = zTop - dkH
zGt = zJt - secH[kJ]
zPt = zGt - secH[kG]
zPb = -dig - emb
! 水平つなぎの段の自動（大引のすぐ下から tieP 以内で等分、一番下は根切り底の 300 上。床の上端から下へ m）
dim alp[8]
zLast = -dig + 0.3
nAL = 1
alp[1] = zTop - zPt
if zPt - zLast > 0.3 then
	nTier = min(7, max(1, ceil((zPt - zLast) / max(0.5, tieP) - 0.000001)))
	for k = 1 to nTier + 1
		alp[k] = zTop - (zPt - (zPt - zLast) * (k - 1) / nTier)
	next k
	nAL = nTier + 1
endif
dim lz0[8]
lz0[1] = lvD1
lz0[2] = lvD2
lz0[3] = lvD3
lz0[4] = lvD4
lz0[5] = lvD5
lz0[6] = lvD6
lz0[7] = lvD7
lz0[8] = lvD8
dim lv[]
nLv = nAL
if lAuto = 0 then nLv = max(1, min(8, nLvP))
for k = 1 to nLv
	if lAuto then
		lv[k] = zTop - alp[k]
	else
		lv[k] = zTop - max(0, lz0[k])
	endif
next k
for k = 2 to nLv
	for m = k to 2 step -1
		if lv[m] > lv[m - 1] then
			tq = lv[m]
			lv[m] = lv[m - 1]
			lv[m - 1] = tq
		endif
	next m
next k
! スロープ（入口 X0 の側）
slL = 0
if slopeN > 0.5 and zTop > 0.05 then slL = zTop * slopeN

! ==========================================================
! ==== 2Dスクリプト ====
! ==========================================================
! 乗入れ構台 2D: 床の外形・覆工板の目地・支柱・手すり・スロープ・注記・広げるホットスポット
pen penEquip
define style "kdT" "ＭＳ Ｐゴシック", texSiz, 5, 0
style "kdT"
! 覆工板の目地（X に 1m・Y に覆工板の長さ）
for i = 1 to nDX - 1
	line2 i, 0, i, ly
next i
for j = 1 to nDY - 1
	line2 0, ry[j + 1], lx, ry[j + 1]
next j
rect2 0, 0, lx, ly
! 支柱（H 形。フランジは X の両側に、幅は Y に。3D と同じ）
hp = secH[kP] / 2
bp = secB[kP] / 2
fp = secF[kP]
wp = secW[kP] / 2
for i = 1 to nPX
	for j = 1 to nPY
		rect2 gx[i] + hp - fp, gy[j] - bp, gx[i] + hp, gy[j] + bp
		rect2 gx[i] - hp, gy[j] - bp, gx[i] - hp + fp, gy[j] + bp
		rect2 gx[i] - hp + fp, gy[j] - wp, gx[i] + hp - fp, gy[j] + wp
	next j
next i
! 手すり（縁の内側 50）
if railS then line2 0, 0.05, lx, 0.05
if railN then line2 0, ly - 0.05, lx, ly - 0.05
if railE then line2 lx - 0.05, 0, lx - 0.05, ly
if railW then line2 0.05, 0, 0.05, ly
! スロープ（入口の側）と上る向きの矢
if slL > 0 then
	rect2 -slL, 0, 0, ly
	line2 -slL * 0.8, ly / 2, -slL * 0.2, ly / 2
	line2 -slL * 0.2, ly / 2, -slL * 0.2 - 0.4, ly / 2 + 0.25
	line2 -slL * 0.2, ly / 2, -slL * 0.2 - 0.4, ly / 2 - 0.25
	add2 -slL / 2, ly / 2 + 0.6
	rot2 -SYMB_ROTANGLE
	text2 0, 0, "スロープ 1/" + str(slopeN, 1, 0)
	del 2
endif
! 注記（名前・広さ・最大積載荷重。図面の向きに関係なく水平に）
add2 lx / 2, ly / 2
rot2 -SYMB_ROTANGLE
text2 0, 0.6, kdName + " " + str(lx, 1, 0) + "×" + str(ly, 1, 0) + "m"
t3 = ""
if n3 > 0 then t3 = "・1×3m " + str(nDX * n3, 1, 0) + "枚"
text2 0, 0, "覆工板 1×2m " + str(nDX * n2, 1, 0) + "枚" + t3
text2 0, -0.6, maxLd
del 2
! 広げるホットスポット（X は右の辺の真ん中、Y は上の辺の真ん中）
hotspot2 0, 0
hotspot2 lx, 0
hotspot2 lx, ly
hotspot2 0, ly
hotspot2 0, ly / 2, 101, lenX, 1 + 128
hotspot2 lenX, ly / 2, 102, lenX, 2
hotspot2 -1, ly / 2, 103, lenX, 3
hotspot2 lx / 2, 0, 104, lenY, 1 + 128
hotspot2 lx / 2, lenY, 105, lenY, 2
hotspot2 lx / 2, -1, 106, lenY, 3
! 支柱の列・行を動かすホットスポット（列は手前の外、行は先の外の丸い印）
if nPX >= 1 then
	circle2 max(0, min(lx, gX1)), -0.6, 0.12
	line2 max(0, min(lx, gX1)), -0.48, max(0, min(lx, gX1)), 0
	hotspot2 0, -0.6, 203, gX1, 1 + 128
	hotspot2 gX1, -0.6, 204, gX1, 2
	hotspot2 -1, -0.6, 205, gX1, 3
endif
if nPX >= 2 then
	circle2 max(0, min(lx, gX2)), -0.6, 0.12
	line2 max(0, min(lx, gX2)), -0.48, max(0, min(lx, gX2)), 0
	hotspot2 0, -0.6, 206, gX2, 1 + 128
	hotspot2 gX2, -0.6, 207, gX2, 2
	hotspot2 -1, -0.6, 208, gX2, 3
endif
if nPX >= 3 then
	circle2 max(0, min(lx, gX3)), -0.6, 0.12
	line2 max(0, min(lx, gX3)), -0.48, max(0, min(lx, gX3)), 0
	hotspot2 0, -0.6, 209, gX3, 1 + 128
	hotspot2 gX3, -0.6, 210, gX3, 2
	hotspot2 -1, -0.6, 211, gX3, 3
endif
if nPX >= 4 then
	circle2 max(0, min(lx, gX4)), -0.6, 0.12
	line2 max(0, min(lx, gX4)), -0.48, max(0, min(lx, gX4)), 0
	hotspot2 0, -0.6, 212, gX4, 1 + 128
	hotspot2 gX4, -0.6, 213, gX4, 2
	hotspot2 -1, -0.6, 214, gX4, 3
endif
if nPX >= 5 then
	circle2 max(0, min(lx, gX5)), -0.6, 0.12
	line2 max(0, min(lx, gX5)), -0.48, max(0, min(lx, gX5)), 0
	hotspot2 0, -0.6, 215, gX5, 1 + 128
	hotspot2 gX5, -0.6, 216, gX5, 2
	hotspot2 -1, -0.6, 217, gX5, 3
endif
if nPX >= 6 then
	circle2 max(0, min(lx, gX6)), -0.6, 0.12
	line2 max(0, min(lx, gX6)), -0.48, max(0, min(lx, gX6)), 0
	hotspot2 0, -0.6, 218, gX6, 1 + 128
	hotspot2 gX6, -0.6, 219, gX6, 2
	hotspot2 -1, -0.6, 220, gX6, 3
endif
if nPX >= 7 then
	circle2 max(0, min(lx, gX7)), -0.6, 0.12
	line2 max(0, min(lx, gX7)), -0.48, max(0, min(lx, gX7)), 0
	hotspot2 0, -0.6, 221, gX7, 1 + 128
	hotspot2 gX7, -0.6, 222, gX7, 2
	hotspot2 -1, -0.6, 223, gX7, 3
endif
if nPX >= 8 then
	circle2 max(0, min(lx, gX8)), -0.6, 0.12
	line2 max(0, min(lx, gX8)), -0.48, max(0, min(lx, gX8)), 0
	hotspot2 0, -0.6, 224, gX8, 1 + 128
	hotspot2 gX8, -0.6, 225, gX8, 2
	hotspot2 -1, -0.6, 226, gX8, 3
endif
if nPX >= 9 then
	circle2 max(0, min(lx, gX9)), -0.6, 0.12
	line2 max(0, min(lx, gX9)), -0.48, max(0, min(lx, gX9)), 0
	hotspot2 0, -0.6, 227, gX9, 1 + 128
	hotspot2 gX9, -0.6, 228, gX9, 2
	hotspot2 -1, -0.6, 229, gX9, 3
endif
if nPX >= 10 then
	circle2 max(0, min(lx, gX10)), -0.6, 0.12
	line2 max(0, min(lx, gX10)), -0.48, max(0, min(lx, gX10)), 0
	hotspot2 0, -0.6, 230, gX10, 1 + 128
	hotspot2 gX10, -0.6, 231, gX10, 2
	hotspot2 -1, -0.6, 232, gX10, 3
endif
if nPX >= 11 then
	circle2 max(0, min(lx, gX11)), -0.6, 0.12
	line2 max(0, min(lx, gX11)), -0.48, max(0, min(lx, gX11)), 0
	hotspot2 0, -0.6, 233, gX11, 1 + 128
	hotspot2 gX11, -0.6, 234, gX11, 2
	hotspot2 -1, -0.6, 235, gX11, 3
endif
if nPX >= 12 then
	circle2 max(0, min(lx, gX12)), -0.6, 0.12
	line2 max(0, min(lx, gX12)), -0.48, max(0, min(lx, gX12)), 0
	hotspot2 0, -0.6, 236, gX12, 1 + 128
	hotspot2 gX12, -0.6, 237, gX12, 2
	hotspot2 -1, -0.6, 238, gX12, 3
endif
if nPX >= 13 then
	circle2 max(0, min(lx, gX13)), -0.6, 0.12
	line2 max(0, min(lx, gX13)), -0.48, max(0, min(lx, gX13)), 0
	hotspot2 0, -0.6, 239, gX13, 1 + 128
	hotspot2 gX13, -0.6, 240, gX13, 2
	hotspot2 -1, -0.6, 241, gX13, 3
endif
if nPX >= 14 then
	circle2 max(0, min(lx, gX14)), -0.6, 0.12
	line2 max(0, min(lx, gX14)), -0.48, max(0, min(lx, gX14)), 0
	hotspot2 0, -0.6, 242, gX14, 1 + 128
	hotspot2 gX14, -0.6, 243, gX14, 2
	hotspot2 -1, -0.6, 244, gX14, 3
endif
if nPX >= 15 then
	circle2 max(0, min(lx, gX15)), -0.6, 0.12
	line2 max(0, min(lx, gX15)), -0.48, max(0, min(lx, gX15)), 0
	hotspot2 0, -0.6, 245, gX15, 1 + 128
	hotspot2 gX15, -0.6, 246, gX15, 2
	hotspot2 -1, -0.6, 247, gX15, 3
endif
if nPX >= 16 then
	circle2 max(0, min(lx, gX16)), -0.6, 0.12
	line2 max(0, min(lx, gX16)), -0.48, max(0, min(lx, gX16)), 0
	hotspot2 0, -0.6, 248, gX16, 1 + 128
	hotspot2 gX16, -0.6, 249, gX16, 2
	hotspot2 -1, -0.6, 250, gX16, 3
endif
if nPY >= 1 then
	circle2 lx + 0.6, max(0, min(ly, gY1)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY1)), lx, max(0, min(ly, gY1))
	hotspot2 lx + 0.6, 0, 303, gY1, 1 + 128
	hotspot2 lx + 0.6, gY1, 304, gY1, 2
	hotspot2 lx + 0.6, -1, 305, gY1, 3
endif
if nPY >= 2 then
	circle2 lx + 0.6, max(0, min(ly, gY2)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY2)), lx, max(0, min(ly, gY2))
	hotspot2 lx + 0.6, 0, 306, gY2, 1 + 128
	hotspot2 lx + 0.6, gY2, 307, gY2, 2
	hotspot2 lx + 0.6, -1, 308, gY2, 3
endif
if nPY >= 3 then
	circle2 lx + 0.6, max(0, min(ly, gY3)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY3)), lx, max(0, min(ly, gY3))
	hotspot2 lx + 0.6, 0, 309, gY3, 1 + 128
	hotspot2 lx + 0.6, gY3, 310, gY3, 2
	hotspot2 lx + 0.6, -1, 311, gY3, 3
endif
if nPY >= 4 then
	circle2 lx + 0.6, max(0, min(ly, gY4)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY4)), lx, max(0, min(ly, gY4))
	hotspot2 lx + 0.6, 0, 312, gY4, 1 + 128
	hotspot2 lx + 0.6, gY4, 313, gY4, 2
	hotspot2 lx + 0.6, -1, 314, gY4, 3
endif
if nPY >= 5 then
	circle2 lx + 0.6, max(0, min(ly, gY5)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY5)), lx, max(0, min(ly, gY5))
	hotspot2 lx + 0.6, 0, 315, gY5, 1 + 128
	hotspot2 lx + 0.6, gY5, 316, gY5, 2
	hotspot2 lx + 0.6, -1, 317, gY5, 3
endif
if nPY >= 6 then
	circle2 lx + 0.6, max(0, min(ly, gY6)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY6)), lx, max(0, min(ly, gY6))
	hotspot2 lx + 0.6, 0, 318, gY6, 1 + 128
	hotspot2 lx + 0.6, gY6, 319, gY6, 2
	hotspot2 lx + 0.6, -1, 320, gY6, 3
endif
if nPY >= 7 then
	circle2 lx + 0.6, max(0, min(ly, gY7)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY7)), lx, max(0, min(ly, gY7))
	hotspot2 lx + 0.6, 0, 321, gY7, 1 + 128
	hotspot2 lx + 0.6, gY7, 322, gY7, 2
	hotspot2 lx + 0.6, -1, 323, gY7, 3
endif
if nPY >= 8 then
	circle2 lx + 0.6, max(0, min(ly, gY8)), 0.12
	line2 lx + 0.48, max(0, min(ly, gY8)), lx, max(0, min(ly, gY8))
	hotspot2 lx + 0.6, 0, 324, gY8, 1 + 128
	hotspot2 lx + 0.6, gY8, 325, gY8, 2
	hotspot2 lx + 0.6, -1, 326, gY8, 3
endif

! ==========================================================
! ==== 3Dスクリプト ====
! ==========================================================
! 乗入れ構台 3D
define material "kd_deck" 2, 0.36, 0.37, 0.38
define material "kd_steel" 2, 0.55, 0.42, 0.30
define material "kd_brace" 2, 0.45, 0.47, 0.50
define material "kd_rail" 2, 0.90, 0.75, 0.10
define material "kd_toe" 2, 0.85, 0.85, 0.85
define material "kd_slope" 2, 0.62, 0.60, 0.56
resol 8
! ---- 覆工板 ----
if showDeck then
	material "kd_deck"
	for i = 1 to nDX
		for j = 1 to nDY
			add (i - 1) + 0.003, ry[j] + 0.003, zJt
			block 1 - 0.006, rw[j] - 0.006, dkH
			del 1
		next j
	next i
endif
material "kd_steel"
! ---- 根太（X に通す。覆工板の長さごと）----
hh = secH[kJ]
hb = secB[kJ]
htw = secW[kJ]
htf = secF[kJ]
for j = 1 to nDY + 1
	yj = max(hb / 2, min(ly - hb / 2, ry[j]))
	add 0, yj, zGt
	hL = lx
	gosub "hbeam"
	del 1
next j
! ---- 大引（支柱の列ごとに Y へ）----
hh = secH[kG]
hb = secB[kG]
htw = secW[kG]
htf = secF[kG]
for i = 1 to nPX
	add gx[i], 0, zPt
	rotz 90
	hL = ly
	gosub "hbeam"
	del 2
next i
! ---- 支柱 ----
hh = secH[kP]
hb = secB[kP]
htw = secW[kP]
htf = secF[kP]
for i = 1 to nPX
	for j = 1 to nPY
		add gx[i], gy[j], zPb
		roty -90
		add 0, 0, -hh / 2
		hL = zPt - zPb
		gosub "hbeam"
		del 3
	next j
next i
! ---- 水平つなぎ（[-200×90。支柱の外の面に）----
material "kd_brace"
pY = secB[kP] / 2
pX = secH[kP] / 2
for k = 1 to nLv
	for j = 1 to nPY
		add gx[1], gy[j] + pY, lv[k] - 0.2
		block gx[nPX] - gx[1], 0.09, 0.2
		del 1
	next j
	for i = 1 to nPX
		add gx[i] + pX, gy[1], lv[k] - 0.2
		block 0.09, gy[nPY] - gy[1], 0.2
		del 1
	next i
next k
! ---- 垂直ブレース（L-75。外周の構面に X 形）----
if nLv > 1 then
	for k = 1 to nLv - 1
		zH = lv[k] - 0.2
		zL = lv[k + 1]
		dz = max(0.05, zH - zL)
		for i = 1 to nBX
			dx = max(0.05, gx[i + 1] - gx[i])
			bl = sqr(dx * dx + dz * dz)
			ang = atn(dz / dx)
			for s = 0 to 1
				yb = gy[1] - pY - 0.08
				if s = 1 then yb = gy[nPY] + pY + 0.09
				add gx[i], yb, zL
				roty -ang
				block bl, 0.075, 0.075
				del 2
				add gx[i], yb, zH
				roty ang
				block bl, 0.075, 0.075
				del 2
			next s
		next i
		for j = 1 to nBY
			dy = max(0.05, gy[j + 1] - gy[j])
			bl = sqr(dy * dy + dz * dz)
			ang = atn(dz / dy)
			for s = 0 to 1
				xb = gx[1] - pX - 0.08
				if s = 1 then xb = gx[nPX] + pX + 0.09
				add xb, gy[j], zL
				rotz 90
				roty -ang
				block bl, 0.075, 0.075
				del 3
				add xb, gy[j], zH
				rotz 90
				roty ang
				block bl, 0.075, 0.075
				del 3
			next s
		next j
	next k
endif
! ---- 手すり・中さん・幅木（縁の内側 50）----
for e = 1 to 4
	onE = 0
	if e = 1 and railS then onE = 1
	if e = 2 and railN then onE = 1
	if e = 3 and railE then onE = 1
	if e = 4 and railW then onE = 1
	if onE then
		eL = lx
		ex = 0
		ey = 0.05
		er = 0
		if e = 2 then ey = ly - 0.05
		if e > 2 then
			eL = ly
			ey = 0
			er = 90
			ex = 0.05
			if e = 3 then ex = lx - 0.05
		endif
		add ex, ey, zTop
		rotz er
		nRp = max(1, ceil(eL / 1.8 - 0.000001))
		material "kd_rail"
		for r = 0 to nRp
			add eL * r / nRp, 0, 0
			cylind 1.0, 0.0243
			del 1
		next r
		for t = 1 to 2
			hz = 0.95
			if t = 2 then hz = 0.45
			add 0, 0, hz
			roty 90
			cylind eL, 0.0243
			del 2
		next t
		material "kd_toe"
		add 0, -0.0125, 0
		block eL, 0.025, 0.15
		del 1
		del 2
	endif
next e
! ---- スロープ（入口 X0 の側。下は盛土かコンクリート）----
if slL > 0 then
	material "kd_slope"
	add -slL, ly, 0
	rotx 90
	prism 3, ly, 0, 0, slL, zTop, slL, 0
	del 2
endif
! 水平つなぎの段を上下に動かすホットスポット（手前の隅の支柱の外）
hx = gx[1]
hy = gy[1] - secB[kP] / 2 - 0.3
if nLv >= 1 then
	hotspot hx, hy, zTop, 403, lvD1, 1 + 128
	hotspot hx, hy, zTop - lvD1, 404, lvD1, 2
	hotspot hx, hy, zTop + 1, 405, lvD1, 3
endif
if nLv >= 2 then
	hotspot hx, hy, zTop, 406, lvD2, 1 + 128
	hotspot hx, hy, zTop - lvD2, 407, lvD2, 2
	hotspot hx, hy, zTop + 1, 408, lvD2, 3
endif
if nLv >= 3 then
	hotspot hx, hy, zTop, 409, lvD3, 1 + 128
	hotspot hx, hy, zTop - lvD3, 410, lvD3, 2
	hotspot hx, hy, zTop + 1, 411, lvD3, 3
endif
if nLv >= 4 then
	hotspot hx, hy, zTop, 412, lvD4, 1 + 128
	hotspot hx, hy, zTop - lvD4, 413, lvD4, 2
	hotspot hx, hy, zTop + 1, 414, lvD4, 3
endif
if nLv >= 5 then
	hotspot hx, hy, zTop, 415, lvD5, 1 + 128
	hotspot hx, hy, zTop - lvD5, 416, lvD5, 2
	hotspot hx, hy, zTop + 1, 417, lvD5, 3
endif
if nLv >= 6 then
	hotspot hx, hy, zTop, 418, lvD6, 1 + 128
	hotspot hx, hy, zTop - lvD6, 419, lvD6, 2
	hotspot hx, hy, zTop + 1, 420, lvD6, 3
endif
if nLv >= 7 then
	hotspot hx, hy, zTop, 421, lvD7, 1 + 128
	hotspot hx, hy, zTop - lvD7, 422, lvD7, 2
	hotspot hx, hy, zTop + 1, 423, lvD7, 3
endif
if nLv >= 8 then
	hotspot hx, hy, zTop, 424, lvD8, 1 + 128
	hotspot hx, hy, zTop - lvD8, 425, lvD8, 2
	hotspot hx, hy, zTop + 1, 426, lvD8, 3
endif
end

! H 形鋼: 今の座標で +X に長さ hL、Y の真ん中、下端 z＝0（hh・hb・htw・htf）
"hbeam":
	add 0, -hb / 2, 0
	block hL, hb, htf
	add 0, (hb - htw) / 2, htf
	block hL, htw, hh - 2 * htf
	del 1
	add 0, 0, hh - htf
	block hL, hb, htf
	del 2
return

! ==========================================================
! ==== パラメータスクリプト ====
! ==========================================================
! 乗入れ構台: ホットスポットで引いた広さを切り上げ、自動の支柱の列・行と水平つなぎの段を書き込む。
! 支柱・水平つなぎのホットスポットを動かすと（GLOB_MODPAR_NAME）自動を外し、動かした位置のままにする
if abs(lenX - lx) > 0.0005 then parameters lenX = lx
if abs(lenY - ly) > 0.0005 then parameters lenY = ly
mp = GLOB_MODPAR_NAME
gA = gAuto
if strstr(mp, "gX") = 1 or strstr(mp, "gY") = 1 or mp = "nGX" or mp = "nGY" then
	gA = 0
	parameters gAuto = 0
endif
if gA then
	parameters nGX = nAX, nGY = nAY
	parameters gX1 = axp[1], gX2 = axp[2], gX3 = axp[3], gX4 = axp[4], gX5 = axp[5], gX6 = axp[6], gX7 = axp[7], gX8 = axp[8], gX9 = axp[9], gX10 = axp[10], gX11 = axp[11], gX12 = axp[12], gX13 = axp[13], gX14 = axp[14], gX15 = axp[15], gX16 = axp[16]
	parameters gY1 = ayp[1], gY2 = ayp[2], gY3 = ayp[3], gY4 = ayp[4], gY5 = ayp[5], gY6 = ayp[6], gY7 = ayp[7], gY8 = ayp[8]
endif
lA = lAuto
if strstr(mp, "lvD") = 1 or mp = "nLvP" then
	lA = 0
	parameters lAuto = 0
endif
if lA then
	parameters nLvP = nAL
	parameters lvD1 = alp[1], lvD2 = alp[2], lvD3 = alp[3], lvD4 = alp[4], lvD5 = alp[5], lvD6 = alp[6], lvD7 = alp[7], lvD8 = alp[8]
endif
values{2} "dk3" -1, "自動（幅が奇数 m なら 3m を1列）", 0, "2m だけ", 1, "3m を1列", 2, "3m を2列"
values "dk3At" range [1, 20]
values{2} "secJ" 1, "H-200×200", 2, "H-250×250", 3, "H-300×300", 4, "H-350×350", 5, "H-400×400", 6, "H-414×405", 7, "H-428×407", 8, "H-488×300", 9, "H-588×300", 10, "H-594×302"
values{2} "secG" 1, "H-200×200", 2, "H-250×250", 3, "H-300×300", 4, "H-350×350", 5, "H-400×400", 6, "H-414×405", 7, "H-428×407", 8, "H-488×300", 9, "H-588×300", 10, "H-594×302"
values{2} "secP" 1, "H-200×200", 2, "H-250×250", 3, "H-300×300", 4, "H-350×350", 5, "H-400×400", 6, "H-414×405", 7, "H-428×407", 8, "H-488×300", 9, "H-588×300", 10, "H-594×302"
values "nGX" range [2, 16]
values "nGY" range [2, 8]
values "nLvP" range [1, 8]
values "kdVeh" "T25", "R20", "R25", "R40", "R65", "C50"
values "spMax" range [1.0, 12.0]
values "slopeN" 0, range [6, 20]

